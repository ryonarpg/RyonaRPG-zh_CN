#. ID 21, Page 1, Line 3, Pos (51,6)
msgid "ココはツーコー止めだよ、ワルいけどね"
msgstr "这里禁止通行哦，虽然抱歉呢"

#. ID 21, Page 2, Line 3, Pos (51,6)
msgid ""
"ワルいけど…\\.\\.ット\n"
"そういえばシッショーが呼んでたっけ、通ってエエよ"
msgstr ""
"虽然抱歉……\\.\\.对了，说起来执事好像叫过你，\n"
"可以过去哦"

#. ID 21, Page 3, Line 3, Pos (51,6)
msgid ""
"ココはツーコー止めだよ\n"
"シッショーは今日も仕事浸けネー"
msgstr "这里禁止通行哦，执事今天也一直在忙工作呢"

#. ID 21, Page 4, Line 3, Pos (51,6)
msgid ""
"アンタは確か…ええット\n"
"シッショーが呼んでたっけ、通ってエエよ"
msgstr "你好像是……嗯，执事叫过你吧，可以过去哦"

#. ID 21, Page 5, Line 3, Pos (51,6)
msgid "ちょいマエにシッショーがアンタのコト、ホメてたわよ"
msgstr "刚才执事还夸你来着哦"

#. ID 21, Page 5, Line 4, Pos (51,6)
msgid "アト、ココツーコー止めだよ"
msgstr "还有，这里禁止通行哦"

#. ID 21, Page 6, Line 3, Pos (51,6)
msgid "シッショーもよくアンタに声かけるわね、通ってエエよ"
msgstr "执事也经常跟你打招呼呢，可以过去哦"

#. ID 22, Page 1, Line 3, Pos (31,19)
msgid ""
"こらこら、勝手に内側に入ってこないの\n"
"いいコト？重要な書類とか秘密事項沢山あるのよ？"
msgstr ""
"喂喂，不要随便进到里面来，明白吗？\n"
"这里有很多重要文件和机密事项哦？"

#. ID 23, Page 1, Line 3, Pos (24,25)
msgid ""
"\n"
"すさまじい覇気を感じる…"
msgstr "感受到惊人的霸气……"

#. ID 24, Page 1, Line 3, Pos (14,6)
msgid ""
"\n"
"ここは通さない…\\.\\.という強い意志を感じる"
msgstr "感受到这里不会让你通过…\\.\\.的强烈意志"

#. ID 24, Page 2, Line 3, Pos (14,6)
#. ID 24, Page 3, Line 3, Pos (14,6)
#. ID 24, Page 4, Line 3, Pos (14,6)
#. ID 24, Page 5, Line 3, Pos (14,6)
#. ID 24, Page 6, Line 3, Pos (14,6)
msgid "………"
msgstr "………"

#. ID 25, Page 1, Line 3, Pos (43,24)
msgid ""
"\n"
"黒い外套を着た冒険者だ"
msgstr "是穿着黑色外套的冒险者"

#. ID 26, Page 1, Line 3, Pos (44,24)
msgid ""
"\n"
"どう見ても魔物のようだが\n"
"不思議な事に暴れたりする気配は微塵も感じない…"
msgstr ""
"怎么看都像是魔物，\n"
"但不可思议的是完全感觉不到它会闹腾的迹象……"

#. ID 27, Page 1, Line 4, Pos (20,21)
#. ID 35, Page 1, Line 4, Pos (19,21)
