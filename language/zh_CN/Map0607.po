#. ID 34, Page 2, Line 3, Pos (33,8)
#. Contains choice at line 3 (2 options)
msgid ""
"＊緊急脱出路のようだ\n"
"　移動しますか？"
msgstr "＊似乎是紧急逃生通道　要移动吗？"

#. ID 34, Page 2, Line 5, Pos (33,8)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 41, Page 2, Line 3, Pos (15,6)
msgid "＊自動人形の部品のようだ"
msgstr "＊似乎是自动人偶的零件"

#. ID 41, Page 2, Line 11, Pos (15,6)
#. ID 61, Page 4, Line 8, Pos (29,2)
msgid "＊[シリンダーの心臓]を手に入れた"
msgstr "＊获得了[气缸之心]"

#. ID 41, Page 2, Line 17, Pos (15,6)
#. ID 61, Page 4, Line 14, Pos (29,2)
msgid ""
"＊魔法ギルドの人形遣いに頼まれたのはコレだ\n"
"　急いで持って帰ろう。"
msgstr ""
"＊魔法公会的操偶师委托的就是这个　赶紧带回去吧\n"
"　。"

#. ID 42, Page 2, Line 3, Pos (23,15)
#. ID 45, Page 3, Line 3, Pos (25,15)
#. ID 49, Page 3, Line 3, Pos (27,15)
msgid "＊何かが入っていたらしい機械だ"
msgstr "＊似乎放过什么东西的机器"

#. ID 45, Page 2, Line 4, Pos (25,15)
#. ID 49, Page 2, Line 4, Pos (27,15)
msgid "………"
msgstr "………"

#. ID 45, Page 2, Line 8, Pos (25,15)
#. ID 49, Page 2, Line 8, Pos (27,15)
msgid ""
"＊自動人形のようだが\n"
"　眠っているようにピクりとも動かない"
msgstr "＊像是自动人偶　但像睡着了一样一动不动"

#. ID 61, Page 4, Line 3, Pos (29,2)
msgid ""
"＊大破しているようだ。\n"
"　ピクリとも動かない。"
msgstr "＊似乎严重破损了。　一动也不动。"
