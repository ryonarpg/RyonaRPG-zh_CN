#. ID 2, Page 1, Line 3, Pos (5,7)
msgid "あなたも買われてきちゃったの？"
msgstr "你也是被买来的吗？"

#. ID 3, Page 1, Line 3, Pos (5,13)
msgid "このご主人様は…悪魔よ…"
msgstr "这个主人…是恶魔啊…"

#. ID 4, Page 1, Line 3, Pos (14,5)
msgid ""
"もう出られなんかしないわ\n"
"\\!あきらめましょう…"
msgstr "已经逃不出去了\\!死心吧…"

#. ID 5, Page 1, Line 3, Pos (14,6)
msgid "もうやだあ…\\!だれか助けて…"
msgstr "已经受够了…\\!谁来救救我…"

#. ID 5, Page 2, Line 3, Pos (14,6)
#. Contains choice at line 2 (2 options)
msgid "食事を与えますか？"
msgstr "要喂食吗？"

#. ID 5, Page 2, Line 4, Pos (14,6)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 5, Page 2, Line 6, Pos (14,6)
msgid ""
"食事をスプーンで差し出してあげると\n"
"生気のない目をしながら\n"
"首だけを伸ばして食べようとしている。"
msgstr ""
"用勺子把食物递过去，她眼神毫无生气，\n"
"只把脖子伸过来想要吃。"

#. ID 5, Page 2, Line 9, Pos (14,6)
msgid "あ…う…"
msgstr "啊…唔…"

#. ID 5, Page 2, Line 10, Pos (14,6)
msgid ""
"一口食べただけで直ぐに止めてしまった…\n"
"そしてまた俯いてしまった…"
msgstr "只吃了一口就立刻停下了…然后又低下了头…"

#. ID 6, Page 1, Line 3, Pos (4,15)
msgid "元のご主人様の所に帰りたい…"
msgstr "想回到原来主人那里…"

#. ID 7, Page 1, Line 3, Pos (4,11)
msgid ""
"ここの主人は自分で楽しむ以外でも\n"
"異種間同士を見て楽しんだりもするのよ…\n"
"悪趣味よね…"
msgstr ""
"这里的主人除了自己享乐之外，\n"
"还会看着异种之间取乐哦…真是恶趣味呢…"

#. ID 8, Page 1, Line 18, Pos (13,10)
#. ID 9, Page 1, Line 9, Pos (5,17)
#. ID 10, Page 1, Line 20, Pos (11,5)
#. ID 11, Page 1, Line 28, Pos (19,12)
msgid "おら、しっかりしろ\\|\\.\\^"
msgstr "喂，振作点\\|\\.\\^"

#. ID 11, Page 1, Line 13, Pos (19,12)
msgid "フヘ…\\|フヘへへ…\\|\\.\\^"
msgstr "嘿嘿…\\|嘿嘿嘿嘿…\\|\\.\\^"

#. ID 12, Page 2, Line 6, Pos (0,1)
msgid ""
"おや、どうやら妊娠してるみたいだな\n"
"こりゃいいものが見れそうだ。"
msgstr "哎呀，看来怀孕了呢。这下似乎能看到好东西了。"

#. ID 12, Page 2, Line 20, Pos (0,1)
#. ID 12, Page 2, Line 150, Pos (0,1)
#. ID 12, Page 2, Line 416, Pos (0,1)
#. ID 12, Page 2, Line 654, Pos (0,1)
#. ID 12, Page 2, Line 863, Pos (0,1)
msgid "………\\|\\.\\^"
msgstr "………\\|\\.\\^"

#. ID 12, Page 2, Line 27, Pos (0,1)
#. ID 12, Page 2, Line 120, Pos (0,1)
#. ID 12, Page 2, Line 189, Pos (0,1)
#. ID 12, Page 2, Line 340, Pos (0,1)
#. ID 12, Page 2, Line 451, Pos (0,1)
#. ID 12, Page 2, Line 580, Pos (0,1)
#. ID 12, Page 2, Line 686, Pos (0,1)
#. ID 12, Page 2, Line 801, Pos (0,1)
msgid "………！！"
msgstr "………！！"

#. ID 12, Page 2, Line 28, Pos (0,1)
msgid ""
"人間の子供を宿した\\n[\\v[6]]の腹は、\n"
"すでに大きく膨らみ出産を目前に控えていた。\\|\\.\\^"
msgstr ""
"怀上人类孩子的\\n[\\v[6]]的肚子已经大大鼓起，\n"
"临产在即。\\|\\.\\^"

#. ID 12, Page 2, Line 41, Pos (0,1)
msgid ""
"\\n[\\v[6]]は体を横たえ、\n"
"股を開き準備に取り掛かった。"
msgstr "\\n[\\v[6]]躺下身体，张开双腿，开始准备。"

#. ID 12, Page 2, Line 45, Pos (0,1)
msgid ""
"\\n[\\v[6]]は静かに下着を脱ぎ、体を\n"
"横たえ、股を開き準備に取り掛かった。"
msgstr ""
"\\n[\\v[6]]静静地脱下内裤，躺下身体，张开双腿，\n"
"开始准备。"

#. ID 12, Page 2, Line 50, Pos (0,1)
#. ID 12, Page 2, Line 223, Pos (0,1)
#. ID 12, Page 2, Line 493, Pos (0,1)
#. ID 12, Page 2, Line 712, Pos (0,1)
msgid ""
"\\S[2]苦しそうに息を吐きながら、\\n[\\v[6]]は\n"
"両手を秘部にそえて、そのまま掻き分ける様に開く。"
msgstr ""
"\\S[2]一边痛苦地吐着气，\n"
"\\n[\\v[6]]一边用双手扶住私处，\n"
"就那样像拨开一样将其打开。"

#. ID 12, Page 2, Line 60, Pos (0,1)
#. ID 12, Page 2, Line 240, Pos (0,1)
#. ID 12, Page 2, Line 274, Pos (0,1)
#. ID 12, Page 2, Line 510, Pos (0,1)
#. ID 12, Page 2, Line 729, Pos (0,1)
msgid ""
"\\S[2]苦しそうな表情を浮かべた\\n[\\v[6]]は、\n"
"下腹部に力を入れる"
msgstr "\\S[2]露出痛苦表情的\\n[\\v[6]]，向下腹部用力"

#. ID 12, Page 2, Line 68, Pos (0,1)
msgid ""
"\\S[2]下腹部から秘部にかけておなかを圧迫し、\n"
"少しずつ出てくるのを感じる。"
msgstr ""
"\\S[2]从下腹部到私处压迫着肚子，\n"
"感觉到它一点点地出来。"

#. ID 12, Page 2, Line 79, Pos (0,1)
#. ID 12, Page 2, Line 292, Pos (0,1)
#. ID 12, Page 2, Line 537, Pos (0,1)
#. ID 12, Page 2, Line 749, Pos (0,1)
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]んんっ！……中で擦れて……\n"
"で、出てきてますわ……"
msgstr ""
"\\>【\\n[\\v[6]]】\\S[2]嗯嗯！……在里面摩擦着……出、\n"
"出来了呢……"

#. ID 12, Page 2, Line 84, Pos (0,1)
#. ID 12, Page 2, Line 297, Pos (0,1)
#. ID 12, Page 2, Line 542, Pos (0,1)
#. ID 12, Page 2, Line 754, Pos (0,1)
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]んんっ！……で、出てきてる……\n"
"中で擦れちゃうよぉ……"
msgstr ""
"\\>【\\n[\\v[6]]】\\S[2]嗯嗯！……出、出来了……\n"
"在里面摩擦得好厉害呀……"

#. ID 12, Page 2, Line 91, Pos (0,1)
#. ID 12, Page 2, Line 302, Pos (0,1)
#. ID 12, Page 2, Line 547, Pos (0,1)
#. ID 12, Page 2, Line 759, Pos (0,1)
msgid "\\S[2]\\n[\\v[6]]は、さらに下腹部に力を入れる"
msgstr "\\S[2]\\n[\\v[6]]更加向下腹部用力"

#. ID 12, Page 2, Line 108, Pos (0,1)
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]く、くるしい！…う、産まれる……も、もう少し……"
msgstr ""
"\\>【\\n[\\v[6]]】\\S[2]好、好难受！…呜、要生了……\n"
"再、再一点点……"

#. ID 12, Page 2, Line 123, Pos (0,1)
msgid "ひぎぃぃぃぃぃぃぃ！！！！！！"
msgstr "咿呀啊啊啊啊啊啊啊啊！！！！！！"

#. ID 12, Page 2, Line 141, Pos (0,1)
msgid "\\S[2]…ぜぇ…ぜぇ…"
msgstr "\\S[2]…呼…呼…"

#. ID 12, Page 2, Line 151, Pos (0,1)
#. ID 12, Page 2, Line 417, Pos (0,1)
#. ID 12, Page 2, Line 655, Pos (0,1)
#. ID 12, Page 2, Line 864, Pos (0,1)
msgid ""
"\n"
"\\n[\\v[6]]は、出産がもたらす快楽の\n"
"虜となってしまった！\\|\\.\\^"
msgstr "\\n[\\v[6]]成了分娩带来的快感的俘虏！\\|\\.\\^"

#. ID 12, Page 2, Line 182, Pos (0,1)
#. ID 12, Page 2, Line 444, Pos (0,1)
#. ID 12, Page 2, Line 679, Pos (0,1)
msgid "………"
msgstr "………"

#. ID 12, Page 2, Line 191, Pos (0,1)
msgid ""
"見ると\\n[\\v[6]]の腹は、大きく膨らんでいて\n"
"違和感の元凶であるスライム達が暴れる度に\n"
"その形を激しく歪ませている。"
msgstr ""
"一看，\\n[\\v[6]]的肚子大大鼓起，\n"
"每当造成不适感的元凶史莱姆们乱动时，\n"
"它的形状就剧烈扭曲。"

#. ID 12, Page 2, Line 196, Pos (0,1)
msgid ""
"よく見ると\\n[\\v[6]]の腹は、少し膨らんでいて\n"
"違和感の元凶であるスライム達が暴れる度に\n"
"その形をいびつに歪ませている。"
msgstr ""
"仔细一看，\\n[\\v[6]]的肚子有些鼓起，\n"
"每当造成不适感的元凶史莱姆们乱动时，\n"
"它的形状就歪曲变形。"

#. ID 12, Page 2, Line 211, Pos (0,1)
msgid ""
"そして、スライム達が暴れる度に\\n[\\v[6]]は、\n"
"耐えようのない痛みと快楽に身を震わせる。"
msgstr ""
"然后，每当史莱姆们乱动，\n"
"\\n[\\v[6]]就会因为无法忍受的痛苦与快感而颤抖身\n"
"体。"

#. ID 12, Page 2, Line 230, Pos (0,1)
#. ID 12, Page 2, Line 500, Pos (0,1)
#. ID 12, Page 2, Line 719, Pos (0,1)
msgid ""
"\\S[2]くちゅ、と粘っこい音がして\n"
"淫蜜がそこからどろり、と零れる。"
msgstr ""
"\\S[2]发出「咕啾」一声黏腻的声响，\n"
"淫蜜从那里浓稠地滴落。"

#. ID 12, Page 2, Line 238, Pos (0,1)
#. ID 12, Page 2, Line 508, Pos (0,1)
#. ID 12, Page 2, Line 727, Pos (0,1)
msgid ""
"\\>\\S[2]\\n[\\v[6]]\n"
"やあっ…す、すごい…濡れてる……んぅっ"
msgstr "\\>\\S[2]\\n[\\v[6]]呀啊…好、好厉害…湿了……嗯唔"

#. ID 12, Page 2, Line 248, Pos (0,1)
#. ID 12, Page 2, Line 737, Pos (0,1)
msgid ""
"\\S[2]下腹部から秘部に向かって何かがズルズルと\n"
"這い出てくるのを感じる。"
msgstr ""
"\\S[2]感觉到有什么东西从下腹部朝着私处滑溜溜地\n"
"爬出来。"

#. ID 12, Page 2, Line 261, Pos (0,1)
msgid ""
"\\S[2]苦しそうに息を吐きながら\\n[\\v[6]]は、\n"
"スライムを排出しようとして、思いきりいきんだ。"
msgstr ""
"\\S[2]一边痛苦地吐着气，\n"
"\\n[\\v[6]]为了排出史莱姆，拼命用力。"

#. ID 12, Page 2, Line 265, Pos (0,1)
msgid ""
"\\S[2]ぐちゅ、と粘っこい音がして肛門から\n"
"粘度の高い何かがどろり、と零れる。"
msgstr ""
"\\S[2]发出「咕啾」一声黏腻的声响，\n"
"某种黏度很高的东西从肛门浓稠地滴落。"

#. ID 12, Page 2, Line 272, Pos (0,1)
msgid ""
"\\>\\S[2]\\n[\\v[6]]\n"
"やあっ…もう…始まってる……んぅっ"
msgstr "\\>\\S[2]\\n[\\v[6]]呀啊…已经…开始了……嗯唔"

#. ID 12, Page 2, Line 279, Pos (0,1)
msgid ""
"\\S[2]スライムの粘液で濡れた菊穴に向かって\n"
"何かがズルズルと這い出てくるのを感じる。"
msgstr ""
"\\S[2]感觉到有什么东西正朝着被史莱姆黏液濡湿的\n"
"菊穴，滑溜溜地爬出来。"

#. ID 12, Page 2, Line 316, Pos (0,1)
#. ID 12, Page 2, Line 561, Pos (0,1)
#. ID 12, Page 2, Line 773, Pos (0,1)
msgid ""
"\\>\\S[2]\\n[\\v[6]]\n"
"あぁっ！…で、でるっ……も、もう少し……"
msgstr ""
"\\>\\S[2]\\n[\\v[6]]啊！…要、要出来了……再、再一点…\n"
"…"

#. ID 12, Page 2, Line 341, Pos (0,1)
#. ID 12, Page 2, Line 581, Pos (0,1)
#. ID 12, Page 2, Line 802, Pos (0,1)
msgid "！！！！！！！！！！！！！！！"
msgstr "！！！！！！！！！！！！！！！"

#. ID 12, Page 2, Line 393, Pos (0,1)
#. ID 12, Page 2, Line 632, Pos (0,1)
#. ID 12, Page 2, Line 851, Pos (0,1)
msgid "\\S[2]………"
msgstr "\\S[2]………"

#. ID 12, Page 2, Line 394, Pos (0,1)
#. ID 12, Page 2, Line 633, Pos (0,1)
#. ID 12, Page 2, Line 852, Pos (0,1)
msgid "\\S[2]………ッ！"
msgstr "\\S[2]………唔！"

#. ID 12, Page 2, Line 396, Pos (0,1)
msgid ""
"計\\v[489]匹のスライム達を産んだ\\n[\\v[6]]は\n"
"息も絶え絶えでその場に崩れ落ちる。"
msgstr ""
"共产下\\v[489]只史莱姆的\\n[\\v[6]]气息奄奄地当场\n"
"瘫倒。"

#. ID 12, Page 2, Line 453, Pos (0,1)
msgid ""
"ランドレイの子を孕んだ\\n[\\v[6]]の腹は、\n"
"その子が成長したことを知らせるかのように\n"
"パンパンに膨らんでいる。"
msgstr ""
"怀上兰德雷之子的\\n[\\v[6]]的肚子，\n"
"仿佛在告知那个孩子已经成长一般鼓得圆滚滚的。"

#. ID 12, Page 2, Line 458, Pos (0,1)
msgid ""
"凌辱の末、異形の仔を孕んだ\\n[\\v[6]]の腹は、\n"
"その仔が成長したことを知らせるかのように\n"
"パンパンに膨らんでいる。"
msgstr ""
"在凌辱之后怀上异形之子的\\n[\\v[6]]的肚子，\n"
"仿佛在告知那个孩子已经成长一般鼓得圆滚滚的。"

#. ID 12, Page 2, Line 474, Pos (0,1)
msgid ""
"苦しさで身をよじる度に、子宮の内壁は\n"
"ゴリゴリとえぐられ、耐えようのない痛みと快楽に\n"
"思わず身を震わせてしまう。"
msgstr ""
"每当因痛苦而扭动身体，子宫内壁就被粗鲁地剜刮，\n"
"难以忍受的疼痛与快感令身体不由得颤抖。"

#. ID 12, Page 2, Line 479, Pos (0,1)
#. ID 12, Page 2, Line 700, Pos (0,1)
msgid ""
"苦しさで身をよじる度に、苗床と化した子宮の内壁は\n"
"ゴリゴリとえぐられ、耐えようのない痛みと快楽に\n"
"思わず身を震わせてしまう。"
msgstr ""
"每当因痛苦而扭动身体，\n"
"化作苗床的子宫内壁就被粗鲁地剜刮，\n"
"难以忍受的疼痛与快感令身体不由得颤抖。"

#. ID 12, Page 2, Line 519, Pos (0,1)
msgid ""
"\\S[2]下腹部から秘部に向かって子供たちがズルズルと\n"
"這い出てくるのを感じる。"
msgstr ""
"\\S[2]感觉到孩子们正从下腹部朝着私处滑溜溜地爬\n"
"出来。"

#. ID 12, Page 2, Line 523, Pos (0,1)
msgid ""
"\\S[2]下腹部から秘部に向かって仔がズルズルと\n"
"這い出てくるのを感じる。"
msgstr ""
"\\S[2]感觉到幼崽正从下腹部朝着私处滑溜溜地爬出\n"
"来。"

#. ID 12, Page 2, Line 635, Pos (0,1)
msgid ""
"計\\v[489]匹のランドレイの子を産んだ\n"
"\\n[\\v[6]]は息も絶え絶えでその場に崩れ落ちる。"
msgstr ""
"共产下\\v[489]只兰德雷之子的\\n[\\v[6]]气息奄奄地\n"
"当场瘫倒。"

#. ID 12, Page 2, Line 641, Pos (0,1)
msgid ""
"計\\v[489]匹のランドレイの仔を産んだ\n"
"\\n[\\v[6]]は息も絶え絶えでその場に崩れ落ちる。"
msgstr ""
"共产下\\v[489]只兰德雷幼崽的\\n[\\v[6]]气息奄奄地\n"
"当场瘫倒。"

#. ID 12, Page 2, Line 687, Pos (0,1)
msgid ""
"凌辱の末、卵を産みつけられた\\n[\\v[6]]の腹は、\n"
"その卵が成長したことを知らせるかのように\n"
"パンパンに膨らんでいる。"
msgstr ""
"在凌辱之后被产下卵的\\n[\\v[6]]的肚子，\n"
"仿佛在告知那些卵已经成长一般鼓得圆滚滚的。"

#. ID 12, Page 2, Line 854, Pos (0,1)
msgid ""
"計\\v[489]匹の卵を産んだ\\n[\\v[6]]は\n"
"息も絶え絶えでその場に崩れ落ちる。"
msgstr ""
"共产下\\v[489]颗卵的\\n[\\v[6]]气息奄奄地当场瘫倒\n"
"。"

#. ID 12, Page 2, Line 891, Pos (0,1)
msgid ""
"ふふん、いい物をみせてもらったぜ\n"
"子どもは俺が責任を持って面倒見てやるさ\n"
"次の妊娠が楽しみだ。"
msgstr ""
"哼，让我看了好东西啊。孩子我会负起责任照顾的，\n"
"期待下一次怀孕。"

#. ID 13, Page 1, Line 3, Pos (12,8)
msgid ""
"よおし、捕まえたぞ。\n"
"いっぱい可愛がってやるからな…\\|\\.\\^"
msgstr "好，抓到了。我会好好疼爱你的……\\|\\.\\^"

#. ID 13, Page 1, Line 11, Pos (12,8)
msgid "だ、出すぞ！！\\.受け取れ！！\\|\\.\\^"
msgstr "我、我要放出来了！！\\.接住！！\\|\\.\\^"

#. ID 13, Page 1, Line 22, Pos (12,8)
msgid "フフフ…\\|また可愛がってやるからな…\\|\\.\\^"
msgstr "呵呵呵……\\|我还会再疼爱你的……\\|\\.\\^"

#. ID 15, Page 2, Line 3, Pos (14,8)
msgid ""
"父さんにねだって買ってもらったドラゴン\n"
"すごくいい具合だよ。"
msgstr "我缠着父亲买给我的龙，感觉非常不错哦。"

#. ID 15, Page 2, Line 9, Pos (14,8)
msgid "……\\!う…あ…"
msgstr "……\\!呜…啊…"
