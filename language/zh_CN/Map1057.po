msgid ""
"\\>[\\N[101]]\n"
"\\>必要開発数:\\V[1]\n"
"\\>\\C[2][\\N[102]]\\C[0]"
msgstr "\\>[\\N[101]]\\>必要开发数:\\V[1]\\>\\C[2][\\N[102]]\\C[0]"
