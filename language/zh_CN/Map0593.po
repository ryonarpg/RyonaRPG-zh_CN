#. ID 10, Page 1, Line 3, Pos (9,21)
msgid "よし、席に着こう。"
msgstr "好，就座吧。"

#. ID 12, Page 1, Line 6, Pos (0,4)
msgid ""
"○リーパー\n"
"「よく今まで勉学に励んでくれたんだな。\n"
"　卒業後はボ…いや、メルベルに忠誠を尽くすんだな」"
msgstr ""
"○梦貘人「你们至今都很努力学习呢。\n"
"　毕业后要对我…不，对梅尔贝尔尽忠呢」"

#. ID 12, Page 1, Line 13, Pos (0,4)
msgid "あいつが○リーパーか……"
msgstr "那家伙就是○梦貘人吗……"

#. ID 12, Page 1, Line 18, Pos (0,4)
msgid ""
"\n"
"「……フヒッ」"
msgstr "「……嘻」"

#. ID 12, Page 1, Line 24, Pos (0,4)
msgid ""
"以前どこかで会ったような……\n"
"……既視感？"
msgstr "以前好像在哪里见过…………既视感？"

#. ID 13, Page 1, Line 3, Pos (0,6)
#. Contains choice at line 2 (2 options)
#. ID 19, Page 1, Line 3, Pos (0,7)
#. Contains choice at line 2 (2 options)
#. ID 20, Page 1, Line 4, Pos (0,8)
#. Contains choice at line 2 (2 options)
msgid "斬りかかりますか？"
msgstr "要砍上去吗？"

#. ID 13, Page 1, Line 4, Pos (0,6)
#. Choice (2 options, embedded in a message)
#. ID 19, Page 1, Line 4, Pos (0,7)
#. Choice (2 options, embedded in a message)
#. ID 20, Page 1, Line 5, Pos (0,8)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 13, Page 1, Line 12, Pos (0,6)
#. ID 19, Page 1, Line 11, Pos (0,7)
msgid "フヒ…！？"
msgstr "嘻…！？"

#. ID 13, Page 1, Line 22, Pos (0,6)
#. ID 19, Page 1, Line 21, Pos (0,7)
msgid "身体がどうしても前に出せない！"
msgstr "身体怎么也无法向前迈出！"

#. ID 13, Page 1, Line 27, Pos (0,6)
msgid "フ…フヒヒ。あ…焦ったんだな……"
msgstr "嘻…嘻嘻嘻。啊…你着急了呢……"

#. ID 13, Page 1, Line 28, Pos (0,6)
#. ID 19, Page 1, Line 27, Pos (0,7)
msgid ""
"お前はボクに攻撃することができないんだな。\n"
"\n"
"性奴隷がご主人様に絶対服従なのは当然なんだな。"
msgstr ""
"你无法攻击我呢。\n"
"性奴隶对主人绝对服从是理所当然的呢。"

#. ID 13, Page 1, Line 38, Pos (0,6)
msgid ""
"○リーパー先生……\n"
"それはどういう意味ですか？"
msgstr "○梦貘人老师……那是什么意思？"

#. ID 13, Page 1, Line 45, Pos (0,6)
msgid ""
"言ったまんまなんだな。\n"
"お前も着飾れば見栄えするかも……\n"
"いや、むしろ脱いだらすごいとか…楽しみなんだな。"
msgstr ""
"就是字面意思呢。你打扮起来或许也挺好看……不，\n"
"倒不如说脱了会很厉害之类的…真让人期待呢。"

#. ID 13, Page 1, Line 52, Pos (0,6)
msgid ""
"○リーパー先生……\n"
"お……おっしゃられていることの意味が\n"
"よく…わ…わからないのですが……"
msgstr "○梦貘人老师……我……我不太明白您……您说的意思……"

#. ID 13, Page 1, Line 60, Pos (0,6)
msgid ""
"なんだウブなのかな……？\n"
"これはカリキュラムを見直さないといけないな\n"
"いや、これはこれでむしろアリかもしれんが……"
msgstr ""
"什么啊，是纯情吗……？这课程安排得重新审视了，\n"
"不过这样倒也许反而可行……"

#. ID 13, Page 1, Line 67, Pos (0,6)
msgid "フヒヒ…いいよ。ここで明言してやろう…"
msgstr "嘻嘻嘻…好啊。我就在这里明言吧…"

#. ID 13, Page 1, Line 72, Pos (0,6)
msgid ""
"この学院の女はみんなみんなボクのものなんだな！\n"
"\n"
"犯すも！嬲るも！ボクの思うがままなんだな！"
msgstr ""
"这个学院的女生全都是我的东西呢！侵犯也好！\n"
"玩弄也好！都随我心意呢！"

#. ID 13, Page 1, Line 75, Pos (0,6)
msgid ""
"フヒッ！\n"
"　　　フヒヒッ！\n"
"フヒヒヒヒヒヒヒヒヒヒヒ！！"
msgstr "嘻！　　　嘻嘻！嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻！！"

#. ID 13, Page 1, Line 81, Pos (0,6)
msgid "寝言を抜かせこの化け物がっ！"
msgstr "别说梦话，你这怪物！"

#. ID 13, Page 1, Line 100, Pos (0,6)
msgid "くっ……！？"
msgstr "唔……！？"

#. ID 13, Page 1, Line 106, Pos (0,6)
msgid ""
"ひゅ～♪\n"
"あぶないあぶない。"
msgstr "咻～♪危险危险。"

#. ID 13, Page 1, Line 113, Pos (0,6)
msgid "お前たちは念入りに催眠をかけてやるんだな…"
msgstr "你们要仔细地施加催眠呢…"

#. ID 13, Page 1, Line 138, Pos (0,6)
msgid "ほら、お前もこっちに来るんだな！"
msgstr "来吧，你也到这边来呢！"

#. ID 13, Page 1, Line 151, Pos (0,6)
msgid ""
"\\n[\\v[6]]はまるで鎖で拘束されたかのように\n"
"身動きがとれなくなってしまった！"
msgstr ""
"\\n[\\v[6]]仿佛被锁链束缚住一般，\n"
"变得无法动弹了！"

#. ID 13, Page 1, Line 165, Pos (0,6)
msgid "○リーパーの方へと引き寄せられる！"
msgstr "被拉向○梦貘人那边！"

#. ID 13, Page 1, Line 179, Pos (0,6)
msgid "フヒ……ほうら、もうちょっとなんだな……"
msgstr "嘻……看吧，还差一点了呢……"

#. ID 13, Page 1, Line 196, Pos (0,6)
msgid ""
"フヒヒ……\n"
"言っておくけど、ボクは鎖なんか投げてないんだな……"
msgstr "嘻嘻嘻……我先说好，我并没有扔什么锁链呢……"

#. ID 13, Page 1, Line 198, Pos (0,6)
msgid ""
"お前は自分の足でボクの方へやってきたんだよな？\n"
"それはお前がボクに……フヒ…\n"
"服従させられたいと思ってるってことなんだな…"
msgstr ""
"你是用自己的脚走到我这边来的吧？\n"
"那就是说你想被我……嘻…被我强迫服从呢…"

#. ID 13, Page 1, Line 201, Pos (0,6)
msgid ""
"いくらボクが天才でも、全く思っていないことを\n"
"させることはできないんだな……お前は心のどこかで\n"
"ボクの性奴隷になることを望んでいたんだな。"
msgstr ""
"就算我再怎么天才，\n"
"也无法让你做完全不想做的事呢……\n"
"你在内心的某处希望成为我的性奴隶呢。"

#. ID 13, Page 1, Line 204, Pos (0,6)
msgid ""
"お前は心の奥ですでに屈していたんだな……\n"
"心はとっくに卑しい卑しい雌豚だった。\n"
"ボクに苛められたくてたまらない痴豚だったんだな。"
msgstr ""
"你内心深处早已屈服了吧……\n"
"内心早就已经是卑贱卑贱的母猪了。\n"
"是恨不得被我欺负得不得了的痴母猪啊。"

#. ID 13, Page 1, Line 211, Pos (0,6)
msgid ""
"お望み通りたっぷりと可愛がってやるんだな。\n"
"早く卒業して……\n"
"ボクの卑しくていやらしい性奴になるんだな……"
msgstr ""
"就按你期望的那样，好好尽情疼爱你吧。快点毕业……\n"
"成为我卑贱又淫荡的性奴吧……"

#. ID 13, Page 1, Line 241, Pos (0,6)
#. ID 19, Page 1, Line 176, Pos (0,7)
msgid "待て、まだ慌てるような時間じゃない……"
msgstr "等等，还不是该慌张的时候……"

#. ID 13, Page 1, Line 246, Pos (0,6)
#. ID 19, Page 1, Line 181, Pos (0,7)
msgid ""
"○リーパー\n"
"「それじゃあ、さっそくいくんだな……」"
msgstr "○梦貘人「那么，这就马上开始吧……」"

#. ID 13, Page 1, Line 252, Pos (0,6)
#. ID 19, Page 1, Line 187, Pos (0,7)
msgid "えっ？まっ………"
msgstr "诶？等、………"

#. ID 19, Page 1, Line 26, Pos (0,7)
msgid "フ…フヒヒ。焦ったんだな……"
msgstr "呵…呵呵呵。着急了吧……"

#. ID 19, Page 1, Line 42, Pos (0,7)
msgid ""
"ダメですよお～先輩？\n"
"先生に悪いことしちゃ……"
msgstr "不行哦～前辈？对老师做坏事的话……"

#. ID 19, Page 1, Line 51, Pos (0,7)
msgid ""
"\n"
"…………………………"
msgstr ""
"\n"
"…………………………"

#. ID 19, Page 1, Line 58, Pos (0,7)
msgid ""
"\n"
"　　　　　　　　ん？"
msgstr ""
"\n"
"　　　　　　　　嗯？"

#. ID 19, Page 1, Line 65, Pos (0,7)
msgid ""
"！\n"
"\n"
"いけない！！！"
msgstr "！糟了！！！"

#. ID 19, Page 1, Line 83, Pos (0,7)
msgid "……ぷぎゃあああああああああああああああ！！！！"
msgstr "……噗嘎啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！！！"

#. ID 19, Page 1, Line 93, Pos (0,7)
msgid "え……あれ……？"
msgstr "诶……咦……？"

#. ID 19, Page 1, Line 99, Pos (0,7)
msgid "やったよ。"
msgstr "成功了。"

#. ID 19, Page 1, Line 103, Pos (0,7)
msgid "……………うん。"
msgstr "……………嗯。"

#. ID 19, Page 1, Line 109, Pos (0,7)
msgid "どうした？浮かない顔をして……"
msgstr "怎么了？一脸闷闷不乐的样子……"

#. ID 19, Page 1, Line 115, Pos (0,7)
msgid "ちょっと気になることがあって……"
msgstr "有点在意的事情……"

#. ID 19, Page 1, Line 120, Pos (0,7)
msgid "ねえ、メルベルに帰ってみよう？"
msgstr "呐，我们回梅尔贝尔看看吧？"

#. ID 19, Page 1, Line 126, Pos (0,7)
msgid "ああ、そうだな。でもまずは学長に……"
msgstr "嗯，是啊。不过首先得跟校长……"

#. ID 19, Page 1, Line 130, Pos (0,7)
msgid "今すぐ。"
msgstr "现在立刻。"

#. ID 19, Page 1, Line 134, Pos (0,7)
msgid ""
"\n"
"　　　　　　　　　！"
msgstr ""
"\n"
"　　　　　　　　　！"

#. ID 19, Page 1, Line 141, Pos (0,7)
msgid "わかった。行こう。"
msgstr "明白了。走吧。"

#. ID 19, Page 1, Line 157, Pos (0,7)
msgid ""
"と……とりあえず\n"
"……私たちはクラスに戻りませんか？"
msgstr "总……总之……我们先回教室好不好？"

#. ID 19, Page 1, Line 163, Pos (0,7)
msgid ""
"うん。\n"
"きっとそれがいい。そうしましょう。"
msgstr "嗯。那样一定好。就这么办吧。"

#. ID 20, Page 1, Line 10, Pos (0,8)
msgid "（ふうん？なにかやろうとしてるわね？）"
msgstr "（哼嗯？好像想做什么呢？）"

#. ID 20, Page 1, Line 16, Pos (0,8)
msgid "（えいっ！）"
msgstr "（嘿！）"

#. ID 20, Page 1, Line 26, Pos (0,8)
msgid "身動きがとれない！"
msgstr "动弹不得！"

#. ID 20, Page 1, Line 32, Pos (0,8)
msgid "♪"
msgstr "♪"

#. ID 20, Page 1, Line 37, Pos (0,8)
msgid "ちょっと様子をみてみよう。"
msgstr "稍微观察一下情况吧。"

#. ID 20, Page 1, Line 45, Pos (0,8)
#. ID 21, Page 1, Line 4, Pos (0,9)
msgid "フヒヒ…今回は特別に一人ひとり教授してやるんだな。"
msgstr "呼嘻嘻…这次就特别地一个个亲自教授你们吧。"

#. ID 20, Page 1, Line 50, Pos (0,8)
#. ID 21, Page 1, Line 9, Pos (0,9)
msgid "じゃあ、端の奴から順にボクのところへ来るんだな。"
msgstr "那么，就从边上的家伙开始，按顺序到我这儿来。"

#. ID 20, Page 1, Line 76, Pos (0,8)
msgid "待って！"
msgstr "等等！"

#. ID 20, Page 1, Line 87, Pos (0,8)
msgid ""
"フヒ……なんなんだな？\n"
"お前の番はまだ先なんだな？"
msgstr "呼嘻……怎么了？还没轮到你呢？"

#. ID 20, Page 1, Line 94, Pos (0,8)
msgid ""
"お願いです……\n"
"彼女の催眠を解いてください。"
msgstr "求求您……请解除她的催眠。"

#. ID 20, Page 1, Line 103, Pos (0,8)
msgid ""
"フヒ……催眠を解けとな？\n"
"ここまで洗脳の薄い者がいるとは驚いたけど…\n"
"それは愚かな嘆願なんだな\n"
"そんな願い聞き入れると思っているのか？"
msgstr ""
"呼嘻……要我解除催眠？居然有洗脑程度这么浅的人，\n"
"真是让我吃惊……但那是愚蠢的恳求啊。\n"
"你以为我会听从这种愿望吗？"

#. ID 20, Page 1, Line 107, Pos (0,8)
msgid ""
"わざわざかかっているのを解くバカはいないんだな。\n"
"お前は解かないとどうするっていうのかな？"
msgstr ""
"可没有谁会特意去解除已经中的催眠啊。\n"
"你倒是说说，不解除的话你要怎么办？"

#. ID 20, Page 1, Line 114, Pos (0,8)
msgid "………………"
msgstr "………………"

#. ID 20, Page 1, Line 118, Pos (0,8)
msgid ""
"フヒヒ……フヒヒヒ！\n"
"わかっているが策は思いつかないといったところか。\n"
"お察しの通り、例えボクを殺したとしてもこの娘……\n"
"いや、この国の人間にかけた催眠が解けることはない。"
msgstr ""
"呼嘻嘻……呼嘻嘻嘻！看来是明白，却想不出对策吧。\n"
"正如你所料，就算杀了我，施加在这个女孩……不，\n"
"施加在这个国家的人身上的催眠也不会解开。"

#. ID 20, Page 1, Line 122, Pos (0,8)
msgid ""
"かといってボクを生きたままどうにかするだけの\n"
"力はお前には無いんだな！実力も足りなければ、\n"
"仲間もいないんだな！！"
msgstr ""
"不过你也没有能把我活着怎么样的力量啊！\n"
"既没有实力，也没有同伴！！"

#. ID 20, Page 1, Line 125, Pos (0,8)
msgid ""
"この学院全てが！お前の敵！！\n"
"この国の全てが！お前の敵！！\n"
"……………………………なんだな！！"
msgstr ""
"整个学院！都是你的敌人！！整个国家！\n"
"都是你的敌人！！……………………………就是这样啊！！"

#. ID 20, Page 1, Line 133, Pos (0,8)
msgid "そんなこと……わかってるよ。"
msgstr "那种事……我知道啊。"

#. ID 20, Page 1, Line 138, Pos (0,8)
msgid ""
"だけど……お願い。\n"
"せめてその娘だけは……助けてあげて。"
msgstr "但是……求你了。至少那个女孩……救救她吧。"

#. ID 20, Page 1, Line 145, Pos (0,8)
msgid "フヒ……？お前ひょっとして……？"
msgstr "呼嘻……？你该不会……？"

#. ID 20, Page 1, Line 150, Pos (0,8)
msgid ""
"…………！！\n"
"……………フヒ……フヒヒヒ……"
msgstr "…………！！……………呼嘻……呼嘻嘻嘻……"

#. ID 20, Page 1, Line 156, Pos (0,8)
msgid ""
"いいだろう。お前次第では、こいつの催眠だけは特別に\n"
"解いてやってもいいんだな。"
msgstr ""
"好啊。就看你的表现，只解除这家伙的催眠，\n"
"我可以特别为你办到。"

#. ID 20, Page 1, Line 163, Pos (0,8)
msgid "本当！？"
msgstr "真的！？"

#. ID 20, Page 1, Line 169, Pos (0,8)
msgid ""
"ああ、嘘じゃないんだな。\n"
"正直、軍事国家メルベルを手中に収めて筋肉質な女は\n"
"足りているんだな。こういう催しも一興、悪くない対価\n"
"なんだな……"
msgstr ""
"嗯，不是骗你的。老实说，\n"
"把军事国家梅尔贝尔弄到手后，\n"
"肌肉发达的女人已经够多了。这种余兴也不错，\n"
"是不错的代价啊……"

#. ID 20, Page 1, Line 178, Pos (0,8)
msgid ""
"……で、私次第というのは？\n"
"私があなたに洗脳されればいいのかしら？"
msgstr ""
"……那么，看我的表现是指？\n"
"难道我只要被你洗脑就好了吗？"

#. ID 20, Page 1, Line 185, Pos (0,8)
msgid ""
"そんなのは前提条件なんだな。\n"
"どっちみちお前はボクの肉奴隷になるんだな。"
msgstr "那是前提条件。反正你都会成为我的肉奴隶。"

#. ID 20, Page 1, Line 190, Pos (0,8)
msgid ""
"………！！\n"
"\n"
msgstr ""
"………！！\n"
"\n"
""

#. ID 20, Page 1, Line 198, Pos (0,8)
msgid "…………条件は何？"
msgstr "…………条件是什么？"

#. ID 20, Page 1, Line 204, Pos (0,8)
msgid "この部屋の、この娘以外の者を殺すことなんだな！！"
msgstr ""
"就是杀掉这个房间里，除这个女孩以外的所有人啊！\n"
"！"

#. ID 20, Page 1, Line 208, Pos (0,8)
msgid "はあ！！？"
msgstr "哈啊！！？"

#. ID 20, Page 1, Line 214, Pos (0,8)
msgid "……………は？"
msgstr "……………哈？"

#. ID 20, Page 1, Line 220, Pos (0,8)
msgid ""
"とは言っても、お前の細腕じゃ人を殺すのも容易じゃ\n"
"なさそうだな？それで全滅というのも意地の悪い条件\n"
"だと思うんだな。"
msgstr ""
"话虽这么说，凭你那纤细的手臂，\n"
"杀人看起来也不容易吧？\n"
"所以全灭也确实是个坏心眼的条件下啊。"

#. ID 20, Page 1, Line 223, Pos (0,8)
msgid ""
"だから、減点方式でいくんだな……\n"
"殺せなかった分だけペナルティを負うんだな。\n"
"そのペナルティは…この娘に背負って貰うんだな！"
msgstr ""
"所以，就按扣分制来……没杀掉多少就承担多少惩罚。\n"
"而那些惩罚……就由这个女孩来背负吧！"

#. ID 20, Page 1, Line 231, Pos (0,8)
msgid "そんな…私に…友達を殺せって言うの？"
msgstr "怎么能……你是说让我……杀掉朋友吗？"

#. ID 20, Page 1, Line 233, Pos (0,8)
msgid ""
"そんな条件呑めるわけないじゃない！\n"
"私はどうなってもいい！！でも……\n"
"みんなの命を条件になんてできないよ！！"
msgstr ""
"我怎么可能接受那种条件！我怎么样都行！！但是……\n"
"不能拿大家的命当条件啊！！"

#. ID 20, Page 1, Line 241, Pos (0,8)
msgid ""
"○リーパー様……残念ですが私も死ぬのは\n"
"嫌なんで逃げさせてもらいます。"
msgstr ""
"○梦貘人大人……很遗憾，我也不想死，\n"
"所以请让我逃走吧。"

#. ID 20, Page 1, Line 251, Pos (0,8)
msgid "おおっと、さっそく逃がしちゃったんだな！"
msgstr "哦哟，这么快就放跑了一个啊！"

#. ID 20, Page 1, Line 260, Pos (0,8)
msgid "ひゃっ！？"
msgstr "呀！？"

#. ID 20, Page 1, Line 268, Pos (0,8)
msgid "やめてっ！"
msgstr "住手！"

#. ID 20, Page 1, Line 274, Pos (0,8)
msgid ""
"フヒヒ……お前がその調子じゃ、\n"
"こいつはどうなっちまうのかねえ……フヒヒヒ……"
msgstr ""
"呼嘻嘻……你那个样子的话，这家伙会变成怎样呢……\n"
"呼嘻嘻嘻……"

#. ID 20, Page 1, Line 281, Pos (0,8)
msgid "……………………………"
msgstr "……………………………"

#. ID 20, Page 1, Line 287, Pos (0,8)
msgid "………………みんな…………ごめん………"
msgstr "………………大家…………对不起………"

#. ID 20, Page 1, Line 341, Pos (0,8)
msgid "ふふ………ふふふふふふ…………"
msgstr "呵呵………呵呵呵呵呵…………"

#. ID 20, Page 1, Line 347, Pos (0,8)
msgid "なんだ…催眠をかけるまでもなく壊れちゃったんだな…"
msgstr "什么啊……还没等施加催眠就已经坏掉了啊……"

#. ID 20, Page 1, Line 352, Pos (0,8)
msgid ""
"でもまぁ、あいつが壊れていく様は楽しめたんだな。\n"
"一命を取り留めた奴もいるみたいだけど……\n"
"約束通り、こいつの自我は正常に戻してやるんだな……"
msgstr ""
"不过嘛，那家伙逐渐崩坏的样子也让我看得很开心。\n"
"虽然好像也有保住性命的家伙……但按照约定，\n"
"我会把这家伙的自我恢复正常……"

#. ID 20, Page 1, Line 359, Pos (0,8)
msgid ""
"これはサービスなんだな。\n"
"催眠にかかっている間の記憶も残しておいてやるんだな\n"
"もちろん今ここで起こったお前の献身的な振る舞いも…"
msgstr ""
"这是特别服务。\n"
"我会把你在被催眠期间的记忆也保留下来。当然，\n"
"也包括你现在在这里展现的献身行为……"

#. ID 20, Page 1, Line 366, Pos (0,8)
msgid ""
"………フヒヒ\n"
"……………………フヒヒヒヒヒ……\n"
"\n"
"お前らのこれからが見られないのが残念なんだな……"
msgstr ""
"………呼嘻嘻……………………呼嘻嘻嘻嘻嘻……\n"
"看不到你们接下来的样子真是遗憾啊……"

#. ID 20, Page 1, Line 395, Pos (0,8)
msgid "……………なんとか生きてる…………"
msgstr "……………总算还活着…………"

#. ID 21, Page 1, Line 36, Pos (0,9)
msgid "待て！"
msgstr "站住！"

#. ID 21, Page 1, Line 49, Pos (0,9)
msgid "な………なんなんだな？"
msgstr "什………什么事啊？"

#. ID 21, Page 1, Line 55, Pos (0,9)
msgid "あれ？委員長？"
msgstr "咦？委员长？"

#. ID 21, Page 1, Line 61, Pos (0,9)
msgid ""
"○リーパー！\n"
"今すぐその娘の……\n"
"いや、みんなにかけた催眠を解きなさい！"
msgstr ""
"○梦貘人！现在立刻把那个女孩的……不，\n"
"把给大家施加的催眠解除掉！"

#. ID 21, Page 1, Line 71, Pos (0,9)
msgid ""
"フヒヒ……驚いたんだな！ここまで洗脳の進んでいない\n"
"奴がいただなんて！し……しかも、このボクに楯突こう\n"
"っていうんだな！"
msgstr ""
"呼嘻嘻……真是吃惊啊！\n"
"居然还有洗脑程度这么浅的家伙！而……而且，\n"
"居然还想反抗我！"

#. ID 21, Page 1, Line 78, Pos (0,9)
msgid "ボソ……（あいつら、後でおしおきなんだな……）"
msgstr "低声……（那些家伙，之后要惩罚的啊……）"

#. ID 21, Page 1, Line 84, Pos (0,9)
msgid "……ピクッ"
msgstr "……抽动了一下"

#. ID 21, Page 1, Line 90, Pos (0,9)
msgid ""
"フヒヒ……そんなこと聞くとでも思っているのかな？\n"
"\n"
"お前なんかにいったい何ができるっていうんだな？"
msgstr ""
"呼嘻嘻……你以为我会听那种话吗？\n"
"你这种家伙到底能做什么啊？"

#. ID 21, Page 1, Line 93, Pos (0,9)
msgid ""
"この娘はもちろん、この国はもうボクのものなんだな！\n"
"お前も、すぐにボクのものになるんだな！！"
msgstr ""
"这个女孩当然不用说，这个国家已经是我的东西了！\n"
"你也会立刻成为我的东西！！"

#. ID 21, Page 1, Line 95, Pos (0,9)
msgid ""
"ボクに忠誠を誓い！身体を捧げ！淫らによがり続ける一\n"
"生を送ることになるんだな！！\n"
"ボクは懐が深い。楯突いたお前も\n"
"すぐに服従することの喜びで支配してやるんだな！！"
msgstr ""
"向我宣誓忠诚！献上身体！度过淫荡地不断浪叫、\n"
"持续高潮的一生！！我胸怀宽广。\n"
"即使是你这种反抗我的家伙，\n"
"我也会很快用服从的快乐支配你！！"

#. ID 21, Page 1, Line 103, Pos (0,9)
msgid ""
"フヒッ！\n"
"　　　フヒヒッ！\n"
"フヒヒヒヒヒヒヒヒヒヒヒヒヒヒヒ！！"
msgstr ""
"呼嘻！　　　呼嘻嘻！\n"
"　　　呼嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻嘻！！"

#. ID 21, Page 1, Line 111, Pos (0,9)
msgid "一応、最終通告だったんだけどね……"
msgstr "算是，最后的通告来着……"

#. ID 21, Page 1, Line 117, Pos (0,9)
#. Contains choice at line 2 (2 options)
msgid "委員長を押さえつけますか？"
msgstr "要把委员长按住吗？"

#. ID 21, Page 1, Line 118, Pos (0,9)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"傍観する"
msgstr ""
"是\n"
"旁观"

#. ID 21, Page 1, Line 128, Pos (0,9)
msgid ""
"きゃっ！\n"
"ちょっと！？は……放して！！"
msgstr "呀！等等！？快……放开我！！"

#. ID 21, Page 1, Line 140, Pos (0,9)
msgid ""
"ダメだよぉ…委員長……\n"
"○リーパー様に酷いことしちゃあ……"
msgstr ""
"不行啊……委员长……不能对○梦貘人大人做过分的事啊…\n"
"…"

#. ID 21, Page 1, Line 147, Pos (0,9)
msgid "そんな……あなたまで……"
msgstr "怎么会……连你也……"

#. ID 21, Page 1, Line 165, Pos (0,9)
msgid ""
"フヒヒ……何をやろうとしていたか知らないが……\n"
"こんな敵だらけの中単身突っ込んでくるなんて\n"
"バカな女なんだな……"
msgstr ""
"呼嘻嘻……虽然不知道你想干什么……\n"
"居然单枪匹马冲进这么多敌人当中，\n"
"真是个愚蠢的女人啊……"

#. ID 21, Page 1, Line 173, Pos (0,9)
msgid "みんなは……敵なんかじゃない……"
msgstr "大家……才不是什么敌人……"

#. ID 21, Page 1, Line 179, Pos (0,9)
msgid ""
"フヒ……フヒヒヒ！！\n"
"\n"
"笑いが止まらないんだな！！"
msgstr "呼嘻……呼嘻嘻嘻！！笑根本停不下来啊！！"

#. ID 21, Page 1, Line 186, Pos (0,9)
msgid ""
"その幻想めいた仲間意識がお前の敗因なんだな！\n"
"でも安心するんだな……すぐにお仲間といっしょに\n"
"ボクに服従することになるんだな！！"
msgstr ""
"那种幻想般的同伴意识就是你的败因啊！\n"
"不过放心吧……你马上就会和伙伴一起服从我了啊！！"

#. ID 21, Page 1, Line 194, Pos (0,9)
msgid "くっ…………"
msgstr "唔…………"

#. ID 21, Page 1, Line 198, Pos (0,9)
#. Contains choice at line 2 (2 options)
msgid "どうしますか？"
msgstr "要怎么做？"

#. ID 21, Page 1, Line 199, Pos (0,9)
#. Choice (2 options, embedded in a message)
msgid ""
"このまま委員長を押さえる\n"
"兵士を押さえる"
msgstr ""
"就这样制住委员长\n"
"制住士兵"

#. ID 21, Page 1, Line 201, Pos (0,9)
msgid ""
"フヒ！……そうだ、いいことを思いついた。\n"
"お前のその薄っぺらい仲間意識を粉砕してやることに\n"
"したんだな！！"
msgstr ""
"呼嘻！……对了，我想到一个好主意。\n"
"我决定粉碎你那种浅薄的同伴意识啊！！"

#. ID 21, Page 1, Line 209, Pos (0,9)
msgid "な……に……？"
msgstr "什……么……？"

#. ID 21, Page 1, Line 215, Pos (0,9)
#. ID 21, Page 1, Line 456, Pos (0,9)
msgid "お前たち、みんなこっちに来るんだな！！"
msgstr "你们，全都到这边来啊！！"

#. ID 21, Page 1, Line 243, Pos (0,9)
msgid ""
"フヒッ……！？\n"
"\n"
"な……なにをやっているんだな！？"
msgstr "呼嘻……！？你……你们在干什么啊！？"

#. ID 21, Page 1, Line 249, Pos (0,9)
msgid "（チャンス！）"
msgstr "（机会！）"

#. ID 21, Page 1, Line 256, Pos (0,9)
msgid "○リーパー！！！"
msgstr "○梦貘人！！！"

#. ID 21, Page 1, Line 262, Pos (0,9)
msgid "フ……フヒッ……！？"
msgstr "呼……呼嘻……！？"

#. ID 21, Page 1, Line 268, Pos (0,9)
msgid "服従するのはあんたの方だ！！！"
msgstr "该服从的是你才对！！！"

#. ID 21, Page 1, Line 276, Pos (0,9)
#. ID 21, Page 1, Line 397, Pos (0,9)
msgid ""
"フヒッ……！？\n"
"\n"
"そ……それはまさか…………！？"
msgstr "呼嘻……！？那……那难道是…………！？"

#. ID 21, Page 1, Line 284, Pos (0,9)
#. ID 21, Page 1, Line 405, Pos (0,9)
msgid ""
"化物を捕獲するのを目的に作られた球よ。\n"
"神獣すら捕らえ手駒にすることができると\n"
"言われているわ……"
msgstr ""
"那是为了捕获怪物而制造出来的球哦。\n"
"据说连神兽都能捕获并当作棋子使唤呢……"

#. ID 21, Page 1, Line 287, Pos (0,9)
msgid "まして、あんたごとき小悪党なら……！！"
msgstr "更何况，像你这种小恶棍的话……！！"

#. ID 21, Page 1, Line 293, Pos (0,9)
msgid "や……やばいんだな……！！"
msgstr "糟……糟了啊……！！"

#. ID 21, Page 1, Line 299, Pos (0,9)
msgid "いっけええええええええええええええ！！"
msgstr "上啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！"

#. ID 21, Page 1, Line 307, Pos (0,9)
msgid "ぎゃあああああああああああああああ！！"
msgstr "呀啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！"

#. ID 21, Page 1, Line 323, Pos (0,9)
msgid "出てきなさい、○リーパー。"
msgstr "出来吧，○梦貘人。"

#. ID 21, Page 1, Line 334, Pos (0,9)
msgid "○リーパー…"
msgstr "○梦貘人…"

#. ID 21, Page 1, Line 340, Pos (0,9)
msgid "わかってるんだな。みんなの催眠を……"
msgstr "你明白的吧。把大家的催眠……"

#. ID 21, Page 1, Line 346, Pos (0,9)
msgid "いいえ。"
msgstr "不。"

#. ID 21, Page 1, Line 352, Pos (0,9)
msgid "フヒ……？"
msgstr "呼嘻……？"

#. ID 21, Page 1, Line 359, Pos (0,9)
msgid "ちょっと……お願いがあるの……"
msgstr "等一下……我有个请求……"

#. ID 21, Page 1, Line 365, Pos (0,9)
msgid "………フヒ？"
msgstr "………呼嘻？"

#. ID 21, Page 1, Line 382, Pos (0,9)
msgid ""
"○リーパー……\n"
"服従するのはあなたの方よ。"
msgstr "○梦貘人……该服从的是你哦。"

#. ID 21, Page 1, Line 389, Pos (0,9)
msgid "フヒ……？言ってる意味がわからないんだな？"
msgstr "呼嘻……？我不明白你什么意思啊？"

#. ID 21, Page 1, Line 412, Pos (0,9)
msgid ""
"これであんたを捕まえて……\n"
"みんなの催眠を解かせるわ。"
msgstr "用这个抓住你……然后让你解开大家的催眠哦。"

#. ID 21, Page 1, Line 419, Pos (0,9)
msgid ""
"こ……これはやばいんだな！！\n"
"誰か！！そいつを止めるんだな！！"
msgstr ""
"这……这可不妙啊！！来人啊！！快把那家伙拦住啊！\n"
"！"

#. ID 21, Page 1, Line 440, Pos (0,9)
msgid "ちょっと二人とも……！？"
msgstr "等一下，你们两个……！？"

#. ID 21, Page 1, Line 448, Pos (0,9)
msgid ""
"あ………あぶなかったんだな…………\n"
"魔王に攻められた時だって……\n"
"こんなに恐くはなかったんだな……"
msgstr ""
"啊………好险啊…………就算是遭到魔王攻击的时候……\n"
"也没这么害怕过啊……"

#. ID 21, Page 1, Line 451, Pos (0,9)
msgid "この……このアマ……ただじゃおかないんだな……"
msgstr "你这……这个女人……我不会放过你的啊……"
