#. ID 12, Page 2, Line 3, Pos (9,20)
#. Contains choice at line 2 (2 options)
msgid "このダンジョンから出ますか？"
msgstr "要离开这个地下城吗？"

#. ID 12, Page 2, Line 4, Pos (9,20)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 29, Page 3, Line 10, Pos (0,4)
msgid "………？"
msgstr "………？"

#. ID 29, Page 3, Line 11, Pos (0,4)
#. ID 29, Page 3, Line 36, Pos (0,4)
msgid ""
"………\n"
"\\.\\.………！！"
msgstr ""
"………\n"
"\\.\\.………！！"

#. ID 29, Page 3, Line 22, Pos (0,4)
msgid ""
"汚水の中の何かが\\n[\\v[6]]の肛門に張り付き、\n"
"腸内に侵入した！"
msgstr ""
"污水中的某个东西贴上了\\n[\\v[6]]的肛门，\n"
"侵入了肠道！"

#. ID 29, Page 3, Line 30, Pos (0,4)
#. ID 29, Page 3, Line 55, Pos (0,4)
msgid "\\n[\\v[6]]は寄生されてしまった！"
msgstr "\\n[\\v[6]]被寄生了！"

#. ID 29, Page 3, Line 47, Pos (0,4)
msgid ""
"汚水の中から新たな寄生虫が\\n[\\v[6]]の\n"
"腸内へ潜り込む！"
msgstr "新的寄生虫从污水中\\n[\\v[6]]的肠道内钻入！"

#. ID 29, Page 3, Line 78, Pos (0,4)
#. ID 29, Page 3, Line 99, Pos (0,4)
msgid "………"
msgstr "………"

#. ID 29, Page 3, Line 79, Pos (0,4)
msgid ""
"…気分がすぐれない。\\!\n"
"どうやらウィルスが傷口から感染してしまったようだ。"
msgstr "…感觉不舒服。\\!看来病毒从伤口感染了。"

#. ID 29, Page 3, Line 100, Pos (0,4)
msgid ""
"…体が熱い。\\!\n"
"どうやらウィルスが傷口から感染してしまったようだ。"
msgstr "…身体发热。\\!看来病毒从伤口感染了。"
