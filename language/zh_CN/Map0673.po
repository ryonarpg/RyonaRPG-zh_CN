#. ID 37, Page 2, Line 4, Pos (6,24)
#. Contains choice at line 2 (2 options)
#. ID 63, Page 2, Line 4, Pos (7,18)
#. Contains choice at line 2 (2 options)
msgid "＊[地下牢獄の鍵]を使いますか？"
msgstr "＊要使用[地下牢狱钥匙]吗？"

#. ID 37, Page 2, Line 5, Pos (6,24)
#. Choice (2 options, embedded in a message)
#. ID 39, Page 2, Line 9, Pos (14,16)
#. Choice (2 options, embedded in a message)
#. ID 63, Page 2, Line 5, Pos (7,18)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 37, Page 2, Line 34, Pos (6,24)
#. ID 63, Page 2, Line 34, Pos (7,18)
msgid "＊鍵が掛かっている"
msgstr "＊上锁了"

#. ID 39, Page 2, Line 3, Pos (14,16)
msgid "＊……返事がない、既に息絶えているようだ"
msgstr "＊……没有回应，似乎已经断气了"

#. ID 39, Page 2, Line 5, Pos (14,16)
msgid "＊身なりからしてここの看守のようだが……"
msgstr "＊从穿着来看像是这里的看守……"

#. ID 39, Page 2, Line 7, Pos (14,16)
msgid "＊……腰に鍵の束を下げている"
msgstr "＊……腰上挂着一串钥匙"

#. ID 39, Page 2, Line 8, Pos (14,16)
#. Contains choice at line 2 (2 options)
msgid "＊死体から剥ぎ取りますか？"
msgstr "＊要从尸体上剥取吗？"

#. ID 39, Page 2, Line 13, Pos (14,16)
msgid "＊[地下牢獄看守の鍵]を手に入れた"
msgstr "＊获得了[地下牢狱看守钥匙]"

#. ID 42, Page 2, Line 3, Pos (29,14)
msgid ""
"＊……腐敗した死体だ\n"
"　随分前に息絶えたのだろう"
msgstr "＊……是具腐败的尸体　应该很久以前就断气了"

#. ID 60, Page 2, Line 3, Pos (8,24)
msgid "＊処罰房"
msgstr "＊处罚房"

#. ID 60, Page 2, Line 4, Pos (8,24)
msgid "＊脱獄幇助の罪にて死刑を執行するものとする"
msgstr "＊以协助越狱之罪，执行死刑"

#. ID 64, Page 2, Line 3, Pos (19,46)
#. ID 65, Page 2, Line 3, Pos (27,46)
msgid "＊返事がない、ただの屍のようだ"
msgstr "＊没有回应，就好像只是一具尸体"

#. ID 66, Page 2, Line 3, Pos (28,17)
msgid "＊血塗れのレンチやニッパーといった工具類だ"
msgstr "＊是沾满血的扳手和钳子之类的工具"

#. ID 74, Page 2, Line 3, Pos (15,18)
msgid "＊注射器や粉薬などが入っている"
msgstr "＊里面有注射器和药粉等"
