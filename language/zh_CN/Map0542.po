#. ID 2, Page 1, Line 3, Pos (8,6)
msgid ""
"ううん…\\!最近目じりに小じわが\n"
"できちゃったわあ…"
msgstr "唔嗯…\\!最近眼角都长出小皱纹了呀…"

#. ID 3, Page 1, Line 3, Pos (12,6)
msgid "さあて、しっかりと化粧しないとね"
msgstr "好了，得好好化个妆才行呢"

#. ID 4, Page 1, Line 3, Pos (4,6)
msgid "夜の仕事はあまりお肌によくないよねえ"
msgstr "晚上的工作对皮肤不太好啊"

#. ID 5, Page 1, Line 3, Pos (9,4)
msgid "われながらバチあたりな格好よねえ。"
msgstr "连我自己都觉得这是会遭报应的打扮呢。"

#. ID 6, Page 1, Line 3, Pos (16,6)
msgid "これは…\\!やりすぎちゃったかしら…"
msgstr "这是…\\!是不是做得太过火了点呢…"

#. ID 7, Page 1, Line 3, Pos (13,4)
msgid "ここではコスプレすると受けがいいのよ。"
msgstr "在这里玩cosplay很受欢迎哦。"

#. ID 8, Page 1, Line 3, Pos (12,12)
msgid ""
"メイド服も食傷気味よねえ…\n"
"なんか男心をグっと掴める衣装ってないか\n"
"しら？"
msgstr ""
"女仆装也有点腻了呢…\n"
"有没有什么能一下子抓住男人心的服装呢？"

#. ID 9, Page 1, Line 3, Pos (4,12)
msgid ""
"意外とこういう格好が好みの人っているの\n"
"だいたいMだけど"
msgstr "意外的是，喜欢这种打扮的人大多都是M呢"

#. ID 10, Page 1, Line 3, Pos (5,8)
msgid ""
"そろそろ、いつもの人が来るかな\n"
"\\!出来ればお金持ちのお相手をしたいけど\n"
"ああいう少ない給料で来てくれる人も\n"
"グッと来ちゃうのよねえ…"
msgstr ""
"差不多，老主顾该来了吧\\!虽然想接待有钱人，\n"
"但那种拿着微薄薪水还愿意来的人也挺让人心动的呢\n"
"…"

#. ID 11, Page 1, Line 3, Pos (5,4)
msgid "こういう新機軸も悪くないでしょ。"
msgstr "这种新尝试也不错吧。"

#. ID 12, Page 1, Line 3, Pos (10,6)
msgid ""
"そこの箪笥にはいろんな衣装が入ってる\n"
"わよ"
msgstr "那边的衣柜里放着各种各样的服装哦"

#. ID 13, Page 1, Line 3, Pos (11,3)
#. Contains choice at line 2 (2 options)
#. ID 13, Page 2, Line 3, Pos (11,3)
#. Contains choice at line 2 (2 options)
msgid "着替えますか？"
msgstr "要换衣服吗？"

#. ID 13, Page 1, Line 4, Pos (11,3)
#. Choice (2 options, embedded in a message)
#. ID 13, Page 2, Line 4, Pos (11,3)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 13, Page 1, Line 9, Pos (11,3)
#. ID 13, Page 2, Line 9, Pos (11,3)
msgid ""
"\\n[\\v[6]]\n"
"「はあ…、これじゃ…無理か"
msgstr "\\n[\\v[6]]「唉…，这样的话…不行吗"

#. ID 13, Page 1, Line 15, Pos (11,3)
#. ID 13, Page 2, Line 15, Pos (11,3)
msgid ""
"\\n[\\v[6]]の身体は生体ラバースーツに\n"
"閉じ込められていて着替えられない！"
msgstr ""
"\\n[\\v[6]]的身体被关在生物橡胶服里，\n"
"无法换衣服！"

#. ID 13, Page 1, Line 23, Pos (11,3)
#. ID 13, Page 2, Line 23, Pos (11,3)
msgid "\\C[2]\\N[101]\\C[0]は呪われていて着替えられない！"
msgstr "\\C[2]\\N[101]\\C[0]被诅咒了，无法换衣服！"

#. ID 13, Page 1, Line 28, Pos (11,3)
#. ID 13, Page 2, Line 28, Pos (11,3)
msgid "何に着替えますか？"
msgstr "要换成什么？"

