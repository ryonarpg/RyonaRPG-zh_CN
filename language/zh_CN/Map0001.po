#. ID 1, Page 1, Line 6, Pos (18,0)
msgid ""
"\\c[11]\n"
"　　　　　　　　 このゲームの動画を\n"
"　　　　　　　　　　投稿する事は\n"
"　　　　　　　　　 禁止しています\\|"
msgstr ""
"\\c[11]\n"
"　　　　　　　　 本游戏的视频\n"
"　　　　　　　　　　投稿\n"
"　　　　　　　　　 是被禁止的\\|"

#. ID 1, Page 1, Line 15, Pos (18,0)
msgid ""
"\\c[11]\n"
"　　　　　　このゲームには暴力シーンや\n"
"　　　　　　　　グロテスクな表現が\n"
"　　　　　　　　　含まれています\\|"
msgstr ""
"\\c[11]\n"
"　　　　　　本游戏中存在暴力场景以及\n"
"　　　　　　　　怪诞血腥的表现\n"
"　　　　　　　　　包含在内\\|"

#. ID 1, Page 1, Line 22, Pos (18,0)
#. Contains choice at line 3 (2 options)
msgid ""
"\\c[3]　　　　このゲームには性的な表現が含まれます。\n"
"　　　　　　　あなたは18歳以上ですか？"
msgstr ""
"\\c[3]　　　　本游戏包含性表现。\n"
"　　　　　　　你是18岁以上吗？"

#. ID 1, Page 1, Line 24, Pos (18,0)
#. Choice (2 options, embedded in a message)
msgid ""
"　　　　　　　　　　　はい\n"
"　　　　　　　　　　 いいえ"
msgstr ""
"　　　　　　　　　　　是\n"
"　　　　　　　　　　 否"

#. ID 1, Page 1, Line 52, Pos (18,0)
