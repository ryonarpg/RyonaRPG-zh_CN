#. Choice (2 options)
msgid ""
"起きる\n"
"起きない"
msgstr ""
"起来\n"
"不起来"

#. ID 5, Page 7, Line 36, Pos (18,7)
#. ID 5, Page 8, Line 25, Pos (18,7)
msgid "………行こう…"
msgstr "………走吧…"

#. ID 5, Page 7, Line 54, Pos (18,7)
#. ID 5, Page 8, Line 77, Pos (18,7)
msgid ""
"おはようございます。\n"
"今日もいい天気ですよ。"
msgstr "早上好。今天也是好天气哦。"

#. ID 5, Page 7, Line 59, Pos (18,7)
msgid "これでいいんだ…これで…"
msgstr "这样就好…这样…"

