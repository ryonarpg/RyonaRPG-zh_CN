#. ID 2, Page 2, Line 4, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"ここ、人も来なくて退屈だったのよ。\n"
"今はあなたがいるから、\n"
"当分退屈しなさそうだけど。"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]这里没人来，\n"
"一直很无聊哦。现在有你在，暂时应该不会无聊了。"

#. ID 2, Page 4, Line 7, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"あら……やっぱり私がいいのね？"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]哎呀……\n"
"果然还是我比较好呢？"

#. ID 2, Page 4, Line 12, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"その目は何かを期待してる目ね……。\n"
"……大丈夫、ちゃんとわかってるわ……"
msgstr ""
"\\>\\c[6]【拉米亚长女】\n"
"\\c[0]那眼神是在期待着什么的眼神呢……。……\n"
"没关系，我很清楚哦……"

#. ID 2, Page 4, Line 17, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"ふふふ……捕まえた"
msgstr "\\>\\c[6]【拉米亚长女】\\c[0]呵呵呵……抓到你了"

#. ID 2, Page 4, Line 33, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"さあ……たっぷりかわいがってあげる"
msgstr "\\>\\c[6]【拉米亚长女】\\c[0]来吧……我会好好疼爱你"

#. ID 2, Page 4, Line 47, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"かわいい胸……いじめたくなるわ"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]可爱的胸部……\n"
"让人想欺负呢"

#. ID 2, Page 4, Line 52, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"もうこんなに……本当は期待してたんでしょう？"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]已经这么……\n"
"其实你是在期待吧？"

#. ID 2, Page 4, Line 57, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"今日はこの尻尾で啼かせてあげるわね……"
msgstr ""
"\\>\\c[6]【拉米亚长女】\n"
"\\c[0]今天就让你被这条尾巴弄到呻吟吧……"

#. ID 2, Page 4, Line 62, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"今日は気分がいいの……\n"
"壊れるまでかわいがってあげる"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]今天心情很好……\n"
"我会疼爱你到坏掉为止"

#. ID 2, Page 4, Line 69, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"……もちろん、みんなで、ね？"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]……当然，是大家一起，\n"
"对吧？"

#. ID 2, Page 4, Line 73, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"そうね……。\n"
"今日は趣向を変えて、\n"
"みんなで楽しみましょうか？"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]是啊……今天换个花样，\n"
"大家一起享受吧？"

#. ID 2, Page 4, Line 234, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"もうイッちゃったの？\n"
"でも、まだまだ終わりじゃないわよ……"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]已经高潮了吗？但是，\n"
"还远远没有结束哦……"

#. ID 2, Page 4, Line 258, Pos (5,6)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"……ふう、楽しかったわ\n"
"また明日ね、かわいい子猫ちゃん"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]……呼，玩得很开心，\n"
"明天见哦，可爱的小猫"

#. ID 3, Page 2, Line 5, Pos (8,9)
#. Contains choice at line 3 (2 options)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"ん、もう限界かしら？"
msgstr "\\>\\c[8]【拉米亚次女】\\c[0]嗯，已经到极限了吗？"

#. ID 3, Page 2, Line 7, Pos (8,9)
#. Choice (2 options, embedded in a message)
#. ID 3, Page 2, Line 53, Pos (8,9)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"不"

#. ID 3, Page 2, Line 9, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"そう、残念ね。"
msgstr "\\>\\c[8]【拉米亚次女】\\c[0]是啊，真遗憾呢。"

#. ID 3, Page 2, Line 21, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"ふふふ、それじゃ、まだ楽しみましょ。"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]呵呵呵，\n"
"那就再好好享受吧。"

#. ID 3, Page 2, Line 30, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"あたしのプレゼントは気にいったか？\n"
"……よく似合ってるよ、それ。\n"
"ついついこんなことしたくなるくらい、さ"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]我的礼物还喜欢吗？……\n"
"很合适哦，那个。合适到让人忍不住想这么做呢。"

#. ID 3, Page 2, Line 48, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"服？　あんなのとっくに処分したよ。\n"
"ペットに服は必要ないだろ？"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]衣服？\n"
"那种东西早就处理掉了。宠物不需要衣服吧？"

#. ID 3, Page 2, Line 51, Pos (8,9)
#. Contains choice at line 3 (2 options)
msgid ""
"……ま、どうしても裸が嫌なら、\n"
"あたしが何かプレゼントしてやろうか？"
msgstr ""
"……嘛，如果你无论如何都不喜欢裸着，\n"
"要我送你点什么吗？"

#. ID 3, Page 2, Line 55, Pos (8,9)
msgid ""
"よし。\n"
"それじゃ、ちょっとじっとしてろよ？"
msgstr "好。那就稍微别动哦？"

#. ID 3, Page 2, Line 59, Pos (8,9)
msgid ""
"あたしの好意を無にするのか？\n"
"いいからちょっとじっとしてろって。"
msgstr "要辜负我的好意吗？好啦，稍微别动。"

#. ID 3, Page 2, Line 76, Pos (8,9)
msgid ""
"\\N[\\V[6]]は、\n"
"肉の縄で縛りあげられてしまった！"
msgstr "\\N[\\V[6]]被肉绳紧紧绑住了！"

#. ID 3, Page 2, Line 80, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"思ったとおり……よく似合ってるよ。\n"
"ますますいじめたくなるくらいに、さ"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]果然……很适合你哦。\n"
"适合到让人越来越想欺负你呢。"

#. ID 3, Page 2, Line 87, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"こんな機会、滅多に無いんだ。\n"
"……限界だなんて言うなよ？"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]这种机会可不多见。……\n"
"别说已经到极限了哦？"

#. ID 3, Page 4, Line 7, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"そっか……あたしがいいんだな？"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]这样啊……\n"
"选我也可以吧？"

#. ID 3, Page 4, Line 11, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"ん……今日はあたしに遊んでほしいのか？"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]嗯……\n"
"今天想让我陪你玩吗？"

#. ID 3, Page 4, Line 25, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"それじゃ、早速楽しもうか……"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]那么，\n"
"我们赶紧开始享受吧……"

#. ID 3, Page 4, Line 33, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"胸……好きなんだろ？"
msgstr "\\>\\c[8]【拉米亚次女】\\c[0]胸……你喜欢吧？"

#. ID 3, Page 4, Line 38, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"素直になりなよ……身体はこんなになってるんだから"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]坦率一点吧……\n"
"身体都变成这样了。"

#. ID 3, Page 4, Line 43, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"今日はあたしの尻尾で……ね"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]今天就用我的尾巴……\n"
"嗯。"

#. ID 3, Page 4, Line 48, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"今日はあたしもそういう気分なんだ……\n"
"頭の中、真っ白になるまで犯しつくしてやるよ……"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]今天我也兴致上来了……\n"
"会把你侵犯到脑中一片空白哦……"

#. ID 3, Page 4, Line 54, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"本当は、ちょっと乱暴にされるのも好きなんだろ？\n"
"……大丈夫、わかってる"
msgstr ""
"\\>\\c[8]【拉米亚次女】\n"
"\\c[0]其实你也喜欢被稍微粗暴对待吧？……没关系，\n"
"我明白。"

#. ID 3, Page 4, Line 237, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"なんだ、もう限界？\n"
"悪いけど、あたしはまだ満足してないよ……"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]什么啊，\n"
"已经到极限了？抱歉，我还没满足呢……"

#. ID 3, Page 4, Line 261, Pos (8,9)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"……よかったろ？\n"
"またいつでもかわいがってやるよ"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]……感觉不错吧？\n"
"以后随时都会疼爱你哦。"

#. ID 4, Page 2, Line 4, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"もともと私たちは四姉妹だったんだけど、\n"
"妹はビッグになるって山を出ちゃったの。\n"
"今はどこでどうしてるのかな？"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]我们原本是四姐妹，\n"
"但妹妹说要出人头地就离开山里了。\n"
"现在在哪里做些什么呢？"

#. ID 4, Page 4, Line 7, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"あ……また私と遊びたいの？"
msgstr "\\>\\c[7]【拉米亚三女】\\c[0]啊……又想和我玩吗？"

#. ID 4, Page 4, Line 11, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"ふふふ……今日は私の番だね？"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]呵呵呵……\n"
"今天轮到我了吧？"

#. ID 4, Page 4, Line 25, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"さ、いっぱい気持ちよくしてあげるね……"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]来吧，\n"
"我会让你舒服很多次的……"

#. ID 4, Page 4, Line 33, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"それじゃ、今日は胸で気持ちよくしてあげる……"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]那么，\n"
"今天就用胸让你舒服……"

#. ID 4, Page 4, Line 38, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"いっぱい、いっぱいキスしてあげるね……"
msgstr ""
"\\>\\c[7]【拉米亚三女】\n"
"\\c[0]我会给你很多很多亲吻哦……"

#. ID 4, Page 4, Line 43, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"尻尾のウロコのザラザラ……きっと気に入るよ"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]尾巴上鳞片的粗糙感……\n"
"你一定会喜欢的哦。"

#. ID 4, Page 4, Line 48, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"お姉ちゃんたちほど上手くないけど……\n"
"今日はなんだかいっぱい愛してあげたい気分なんだ……"
msgstr ""
"\\>\\c[7]【拉米亚三女】\n"
"\\c[0]虽然不如姐姐们做得好……\n"
"今天莫名想好好疼爱一番……"

#. ID 4, Page 4, Line 54, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"実はね、このまえ面白いもの拾っちゃった……\n"
"気に入ってくれるかな？"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]其实呢，\n"
"我之前捡到了一个有趣的东西……你会喜欢吗？"

#. ID 4, Page 4, Line 243, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"ね、よかった？\n"
"それじゃ、もっとしたげるね……"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]怎么样，感觉不错吧？\n"
"那我就再多给你一点哦……"

#. ID 4, Page 4, Line 267, Pos (13,6)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"……気持ちよかったでしょ？\n"
"明日もいっぱいしてあげるからね……"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]……很舒服吧？\n"
"明天也会给你做很多哦……"

#. ID 12, Page 2, Line 1, Pos (19,8)
#. ChangeHeroName (Actor 115)
msgctxt "actors.name"
msgid "end:無し"
msgstr "end:无"

#. ID 17, Page 1, Line 14, Pos (1,0)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"今日はいっぱいいっぱいかわいがってあげるね？"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]今天会狠狠地、\n"
"好好地疼爱你哦？"

#. ID 17, Page 1, Line 16, Pos (1,0)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"何も考えられなくなるくらい、感じさせてやるよ"
msgstr ""
"\\>\\c[8]【拉米亚次女】\n"
"\\c[0]会让你舒服到什么都无法思考。"

#. ID 17, Page 1, Line 18, Pos (1,0)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"それじゃ、さっそく始めましょうか？"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]那么，\n"
"我们赶紧开始吧？"

#. ID 17, Page 1, Line 164, Pos (1,0)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"楽しんでくれてるみたいね……？\n"
"でも、本番はまだまだこれからよ……？"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]看来你挺享受的呢……？\n"
"不过，正戏才刚刚开始哦……？"

#. ID 17, Page 1, Line 171, Pos (1,0)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"せっかく全員で相手してやってるんだ。\n"
"まさか、これくらいで\n"
"終わりだなんて思ってないよな？"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]难得大家一起来陪你。\n"
"你不会以为就这么点就结束了吧？"

#. ID 17, Page 1, Line 178, Pos (1,0)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"ふふふ、気持ちよかった？\n"
"もちろん、もっといっぱいしてほしいよね？"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]呵呵呵，舒服吗？\n"
"当然，还想让我做得更多吧？"

#. ID 17, Page 1, Line 201, Pos (1,0)
msgid ""
"\\>\\c[6]【らみあ長女】\\c[0]\n"
"……どう？\n"
"満足してもらえたかしら？"
msgstr ""
"\\>\\c[6]【拉米亚长女】\\c[0]……怎么样？\n"
"让你满足了吗？"

#. ID 17, Page 1, Line 204, Pos (1,0)
msgid ""
"\\>\\c[8]【らみあ次女】\\c[0]\n"
"気が向いたら、またみんなでシてやるよ……"
msgstr ""
"\\>\\c[8]【拉米亚次女】\\c[0]要是心情来了，\n"
"再大家一起陪你玩……"

#. ID 17, Page 1, Line 206, Pos (1,0)
msgid ""
"\\>\\c[7]【らみあ三女】\\c[0]\n"
"それじゃ、今日はこれくらいにしといてあげるね。\n"
"また明日も遊ぼうね……？"
msgstr ""
"\\>\\c[7]【拉米亚三女】\\c[0]那今天就先到这里吧。\n"
"明天再一起玩哦……？"
