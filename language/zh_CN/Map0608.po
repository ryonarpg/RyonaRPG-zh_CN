#. ID 29, Page 2, Line 9, Pos (71,10)
#. ID 29, Page 4, Line 2, Pos (71,10)
#. ID 30, Page 2, Line 9, Pos (72,10)
#. ID 30, Page 5, Line 2, Pos (72,10)
msgid "鍵がかかっている。"
msgstr "上锁了。"

#. ID 29, Page 3, Line 3, Pos (71,10)
#. ID 30, Page 3, Line 3, Pos (72,10)
msgid "開けないぞ…ここは絶対に死守する…！"
msgstr "不会打开的…这里绝对要死守…！"

#. ID 51, Page 2, Line 1, Pos (62,10)
msgid "アジトに急ごう"
msgstr "赶紧去据点吧"

#. ID 53, Page 1, Line 2, Pos (92,26)
msgid ""
"おや、傭兵かい珍しい。\n"
"別に必要ないから他いったら？"
msgstr ""
"哦呀，是佣兵吗，真少见。反正也不需要，\n"
"去别处吧？"

#. ID 53, Page 2, Line 2, Pos (92,26)
msgid ""
"金庫の金が盗まれたんだってよ。\n"
"情けないねえ、誰だい見張りは……"
msgstr "听说金库里的钱被盗了。真丢脸啊，看守是谁……"

#. ID 53, Page 3, Line 2, Pos (92,26)
msgid ""
"立て続けの金庫破り。\n"
"これは私らへの挑戦かなんかかね？"
msgstr ""
"接连不断发生金库被撬。\n"
"这是对我们的挑战还是什么吗？"

#. ID 53, Page 3, Line 4, Pos (92,26)
msgid "まあ……犯人自体はわかってるけどね。"
msgstr "嘛……不过犯人本身已经知道了。"

#. ID 53, Page 4, Line 2, Pos (92,26)
msgid ""
"あいつ、まだウェイトレスやってんのか。\n"
"自分の置かれてる立場をわからせる必要が\n"
"ありそうだねえ……"
msgstr ""
"那家伙还在当女服务员吗。\n"
"看来有必要让她明白自己的处境啊……"

#. ID 53, Page 5, Line 2, Pos (92,26)
msgid "ひっ……！？"
msgstr "咿……！？"

#. ID 53, Page 5, Line 4, Pos (92,26)
msgid ""
"あ……あんたか……\n"
"頼む………私が……あんたらを襲おうと\n"
"したこと、誰にも言わないでくれよ……"
msgstr ""
"啊……是你啊……求你了………我……曾想袭击你们的事，\n"
"别告诉任何人啊……"

#. ID 53, Page 5, Line 8, Pos (92,26)
msgid ""
"一門の名前を汚すわけにはいかねえし、\n"
"そんなことになったら仲間にリンチに\n"
"されちまう……生きていけないよ…………"
msgstr ""
"不能玷污一门的名字，\n"
"要是变成那样会被同伴私刑处死……活不下去啊…………"

#. ID 53, Page 5, Line 12, Pos (92,26)
msgid ""
"な…なんでも言うこときく！\n"
"あ……あんたの奴隷でも構わない。\n"
"後生さ、頼むよ、黙ってて…………"
msgstr ""
"什…什么都听你的！啊……当你的奴隶也行。\n"
"求求你了，拜托了，闭嘴别说吧…………"

#. ID 53, Page 6, Line 2, Pos (92,26)
msgid ""
"い……いやあ……コックが……\n"
"コックがやってくる……"
msgstr "不……不好……厨师……厨师来了……"

#. ID 53, Page 6, Line 4, Pos (92,26)
msgid ""
"減給されて……仕事は増えて……\n"
"みんな……怨んでる……"
msgstr "被降薪……工作却增加……大家……都在怨恨……"

#. ID 53, Page 6, Line 6, Pos (92,26)
msgid ""
"まだバレてない……\n"
"でも……みんな私を怨んでる……"
msgstr "还没暴露……但是……大家都在怨恨我……"

#. ID 53, Page 6, Line 8, Pos (92,26)
msgid ""
"いつかはバレる………\n"
"わ……私……を……………"
msgstr "迟早会暴露的………我……把……我……………"

#. ID 53, Page 6, Line 11, Pos (92,26)
msgid "ごめんなさい……ごめんなさい…………"
msgstr "对不起……对不起…………"

#. ID 53, Page 7, Line 3, Pos (92,26)
#. Contains choice at line 2 (2 options)
msgid "ひっ……な………なんだい……！？"
msgstr "咿……什………什么啊……！？"

#. ID 53, Page 7, Line 5, Pos (92,26)
#. Choice (2 options, embedded in a message)
msgid ""
"ばらしちゃおっかな～\n"
"なにビクビクしてるのかな～"
msgstr ""
"要不要揭发呢～\n"
"在紧张些什么呢～"

#. ID 53, Page 7, Line 8, Pos (92,26)
msgid ""
"ひっ……！？\n"
"そ……それだけは…………"
msgstr "咿……！？那……那件事唯有…………"

#. ID 53, Page 7, Line 13, Pos (92,26)
#. Contains choice at line 3 (2 options)
msgid ""
"お願い……なんでもするから……\n"
"それだけはやめて……！！"
msgstr "求你了……我什么都愿意做……唯独那件事别做……！！"

#. ID 53, Page 7, Line 16, Pos (92,26)
#. Choice (2 options, embedded in a message)
msgid ""
"そう？それじゃあ……\n"
"今月、厳しいんだよね～"
msgstr ""
"是吗？那么……\n"
"这个月，手头很紧呢～"

#. ID 53, Page 7, Line 19, Pos (92,26)
msgid "私に……やってもらうことがある……？"
msgstr "有……要我去做的事……？"

#. ID 53, Page 7, Line 21, Pos (92,26)
msgid ""
"この封書を……じいさんに……？\n"
"なんなんだいこれ？"
msgstr "这封书信……交给老头子……？这到底是什么啊？"

#. ID 53, Page 7, Line 24, Pos (92,26)
msgid ""
"わ……わかった、聞かないよ。\n"
"聞かない方がよさそうだ。"
msgstr "我……我知道了，我不问。还是不问比较好。"

#. ID 53, Page 7, Line 26, Pos (92,26)
msgid ""
"これを渡してくればいいんだろ？\\!\n"
"えっ？ただ渡せばいいんじゃないの？"
msgstr ""
"把这个交过去就行了吧？\\!诶？\n"
"只要交过去不就好了吗？"

#. ID 53, Page 7, Line 29, Pos (92,26)
msgid ""
"な……なんだいそれ！？\n"
"それってまるで……\n"
"……じゃあ……この封書って……"
msgstr ""
"什……什么啊那！？那简直就像…………那么……\n"
"这封书信是……"

#. ID 53, Page 7, Line 33, Pos (92,26)
msgid ""
"わ……わかったよ……\n"
"誰にも言わないって……"
msgstr "我……我知道了……不会告诉任何人……"

#. ID 53, Page 7, Line 35, Pos (92,26)
msgid ""
"断っても断らなくても……\n"
"私は……破滅する運命なんだね……\n"
"とんでもない奴に弱みを握られちまった…"
msgstr ""
"不管拒绝还是不拒绝……我……都注定要毁灭啊……\n"
"被个不得了的家伙抓住了把柄…"

#. ID 53, Page 7, Line 40, Pos (92,26)
msgid ""
"じゃあ……\n"
"……さっそく今夜にでもやってみるよ……"
msgstr "那么…………今晚就马上试试吧……"

#. ID 53, Page 7, Line 46, Pos (92,26)
msgid ""
"う……わ……わかったよ……\n"
"手持ちこれしかないけど……"
msgstr "呜……我……我知道了……虽然手头只有这些……"

#. ID 53, Page 7, Line 50, Pos (92,26)
msgid "5000G巻き上げた。"
msgstr "勒索了5000G。"

#. ID 53, Page 7, Line 54, Pos (92,26)
msgid "お願い……これで堪忍して……"
msgstr "求你了……就拿这些饶了我吧……"

#. ID 53, Page 7, Line 61, Pos (92,26)
msgid ""
"な……なんでもないよ……！！\n"
"ほら、じ……自分の持ち場に戻んな！！！"
msgstr "没……没什么哦……！！喂，回……回自己的岗位去！！！"

#. ID 53, Page 7, Line 64, Pos (92,26)
msgid "おねがい……そっとしておいて……"
msgstr "求你了……别管我……"

#. ID 53, Page 7, Line 70, Pos (92,26)
msgid ""
"これが終わったら……\n"
"私はもうブライじゃない……\n"
msgstr "等这件事结束后……我就不再是布莱了……"

#. ID 53, Page 7, Line 73, Pos (92,26)
msgid ""
"いや……私はもう……\n"
"とっくにブライじゃなかったんだ……"
msgstr "不……我早已……早就不是布莱了……"

#. ID 55, Page 1, Line 1, Pos (48,24)
msgid ""
"………………\n"
"疲れ果てて眠っている。"
msgstr "………………疲惫不堪地睡着了。"

#. ID 55, Page 3, Line 3, Pos (48,24)
msgid "あれ？君……"
msgstr "咦？你……"

#. ID 55, Page 3, Line 6, Pos (48,24)
msgid ""
"君の組織は壊滅したはずだけど……\n"
"まだここを狙っているのかな？\n"
"それとも…私に会いに来てくれたの？"
msgstr ""
"你的组织应该已经毁灭了……你还在盯上这里吗？\n"
"还是说…你是来见我的？"

#. ID 55, Page 3, Line 11, Pos (48,24)
msgid ""
"だいたい察しがついていると思うけど……\n"
"今回の事件は\n"
"「無かった」ことにされたの。"
msgstr ""
"我想你大概已经察觉到了……这次的事件被当作\n"
"「没有发生过」了。"

#. ID 55, Page 3, Line 14, Pos (48,24)
msgid ""
"事件の原因となった魔神の存在自体が\n"
"トップシークレットだからね……\n"
"公になんかできないんだよ……"
msgstr ""
"因为成为事件原因的魔神的存在本身就是最高机密……\n"
"不可能公开的啊……"

#. ID 55, Page 3, Line 18, Pos (48,24)
msgid ""
"裏切りはなかった。\n"
"砦は襲われなかった。\n"
"そして所長…いえ、王子は死ななかった。"
msgstr ""
"没有背叛。要塞没有被袭击。而且所长…不，\n"
"王子没有死。"

#. ID 55, Page 3, Line 23, Pos (48,24)
msgid ""
"最期まで戦ってくれた兵士たちは……\n"
"初めからここにいなかったことになった。"
msgstr ""
"战斗到最后的士兵们……\n"
"被算作从一开始就不在这里了。"

#. ID 55, Page 3, Line 25, Pos (48,24)
msgid ""
"正確には、全く別の場所の所属で、\n"
"今もそこで変わらず任務に当たっている\n"
"ことになってる。"
msgstr ""
"准确地说，他们被算作隶属于完全不同的地方，\n"
"现在也在那里照常执行任务。"

#. ID 55, Page 3, Line 28, Pos (48,24)
msgid ""
"軍曹はその措置に大層憤慨して、都に\n"
"抗議という名の殴り込みに行ってるけど…"
msgstr ""
"军曹对那个处置非常愤慨，\n"
"正以抗议为名跑去都城打上门去，不过……"

#. ID 55, Page 3, Line 31, Pos (48,24)
msgid ""
"事件なんてなかった。\n"
"だから、君を捕まえることもできない。\n"
"ていうか、誰も口を割らなければ、\n"
"上層部ですら君の存在を把握してないよ。"
msgstr ""
"根本没有什么事件。所以，也无法抓你。话说回来，\n"
"只要没人开口，就连上层部都不掌握你的存在哦。"

#. ID 55, Page 3, Line 37, Pos (48,24)
msgid "だから……どこへなりと行きな。"
msgstr "所以……你爱去哪就去哪吧。"

#. ID 55, Page 3, Line 40, Pos (48,24)
msgid ""
"そして私は……\n"
"墓場まで王子やみんなのことを\n"
"持っていくってわけ。"
msgstr "而我会……把王子还有大家的事带进坟墓里。"

#. ID 55, Page 3, Line 44, Pos (48,24)
msgid ""
"ごめん……ちょっと疲れちゃった。\n"
"もう……寝るね。"
msgstr "抱歉……我有点累了。我……先睡了。"

#. ID 55, Page 3, Line 50, Pos (48,24)
msgid "所長……みんな……ごめんなさい………"
msgstr "所长……大家……对不起………"

#. ID 56, Page 1, Line 3, Pos (53,24)
msgid "軍服の替えがある。かっぱらっておこう。"
msgstr "有备用的军服。偷走吧。"

#. ID 56, Page 1, Line 7, Pos (53,24)
msgid "もう何もない。"
msgstr "已经什么都没有了。"

#. ID 57, Page 1, Line 2, Pos (50,29)
msgid "まだやれることはある。"
msgstr "还有能做的事。"

#. ID 58, Page 1, Line 1, Pos (109,5)
msgid ""
"えぐっ………\n"
"……いや………こんなのって…………"
msgstr "呜咕……………不………这种事…………"

#. ID 58, Page 1, Line 3, Pos (109,5)
msgid "最初は……事務だって聞いて………"
msgstr "一开始……说是事务工作………"

#. ID 58, Page 2, Line 1, Pos (109,5)
msgid ""
"えぐっ………\n"
"こんな汎用面に助けられるなんて………"
msgstr "呜咕………竟然被这种泛用面给救了………"

#. ID 58, Page 2, Line 3, Pos (109,5)
msgid ""
"決めた……私転職する……ジョブチェンジする……！！\n"
"ナイトとか竜騎士とか……\n"
"……聖騎士とか剣聖とかそっち方面に行って仕返しして\n"
"やる！！"
msgstr ""
"决定了……我要转职……要转职……！！骑士、龙骑士…………\n"
"圣骑士、剑圣之类的，我要转到那方面去报复！！"

#. ID 61, Page 2, Line 1, Pos (51,44)
msgid ""
"ここは事務室だ。\n"
"ほとんど攻め込まれることのないこの砦では\n"
"ある意味メインの仕事場ではある。"
msgstr ""
"这里是事务室。在这座几乎不会被攻进来的要塞里，\n"
"某种意义上算是主要的工作场所。"

#. ID 61, Page 3, Line 1, Pos (51,44)
msgid ""
"事務から脱走者を出してしまった………\n"
"これから、警備が更に厳しくなるな。"
msgstr ""
"事务部门竟然出了逃亡者………\n"
"今后警备会更加严格吧。"

#. ID 61, Page 4, Line 1, Pos (51,44)
msgid ""
"敵襲か……\n"
"久々に実戦に参加することができそうだ……"
msgstr "敌袭吗……看来能久违地参加实战了……"

#. ID 62, Page 1, Line 1, Pos (46,44)
msgid "私は見習いだからか、事務もなかなか楽しいです。"
msgstr "也许因为我是见习生，事务工作也相当有趣。"

#. ID 62, Page 2, Line 1, Pos (46,44)
msgid ""
"経費がかさんでる……？\n"
"こりゃ、酒代ね。"
msgstr "经费在增加……？这是酒钱吧。"

#. ID 62, Page 3, Line 1, Pos (46,44)
msgid ""
"料理長、謹慎らしいわね。\n"
"詳細がよくわからないのだけど………なんでも隊長自ら\n"
"処理するらしいわ。"
msgstr ""
"厨师长似乎被勒令闭门反省了呢。\n"
"详细情况不太清楚………听说好像由队长亲自处理。"

#. ID 62, Page 3, Line 4, Pos (46,44)
msgid ""
"かなりきな臭いわね……\n"
"一体何をやったのかしら……"
msgstr "相当有火药味呢……到底做了什么呀……"

#. ID 62, Page 4, Line 1, Pos (46,44)
msgid "事務も地味に人手が足りてないのよね……"
msgstr "事务部门也悄悄缺人手呢……"

#. ID 63, Page 1, Line 1, Pos (46,47)
msgid "………………………単純作業めんどい…………"
msgstr "………………………单纯作业好麻烦…………"

#. ID 63, Page 1, Line 5, Pos (46,47)
msgid ""
"だから、ものまねで前の女の動きをトレースしてる。\n"
"自動書記。"
msgstr ""
"所以，用模仿来追踪之前那个女人的动作。\n"
"自动书记。"

#. ID 63, Page 2, Line 1, Pos (46,47)
msgid ""
"自動書記のレベルが上がった。\n"
"最近じゃ彼女が書く前に動くことができる。"
msgstr ""
"自动书记的等级提升了。\n"
"最近已经能在她动笔之前行动。"

#. ID 64, Page 1, Line 1, Pos (55,44)
msgid "事務だって聞いて来ました。"
msgstr "我听说有事务工作就来了。"

#. ID 65, Page 1, Line 1, Pos (55,47)
msgid ""
"時魔法と雑務作業。これほど相性のよい組み合わせが\n"
"あるだろうか！"
msgstr "时魔法和杂务作业。还有比这更相配的组合吗！"

#. ID 65, Page 2, Line 1, Pos (55,47)
msgid ""
"世界のどこかに、その空間にいた人物のやったことを\n"
"一時的に巻き戻して観察することができる能力が\n"
"あるらしいわ。"
msgstr ""
"据说世界上某处，\n"
"有一种能力可以暂时倒回并观察在那个空间里的人物\n"
"所做过的事呢。"

#. ID 65, Page 2, Line 4, Pos (55,47)
msgid ""
"そんなことができるなら、\n"
"今回の犯人もすぐにわかっちゃうわね。"
msgstr ""
"如果真能做到那种事，\n"
"这次的犯人也马上就能知道了呢。"

#. ID 65, Page 2, Line 6, Pos (55,47)
msgid "時魔法を司る者としては非常に興味深い。"
msgstr "作为掌管时魔法的人，非常感兴趣。"

#. ID 65, Page 3, Line 1, Pos (55,47)
msgid ""
"自分にスロウをかけても\n"
"徹夜が平気になるわけじゃない。\n"
"生態リズムは変わらない。"
msgstr ""
"即使给自己施加迟缓，也不会变得能轻松熬夜。\n"
"生理节律不会改变。"

#. ID 65, Page 3, Line 4, Pos (55,47)
msgid ""
"でも……\n"
"ヘイストをかけて倍の仕事をこなすと疲れは２倍。"
msgstr "但是……施加加速来干双倍的工作，疲劳也是双倍。"

#. ID 65, Page 3, Line 7, Pos (55,47)
msgid ""
"やっと気づいた。ノルマがない仕事だと\n"
"わりに合わないな、時魔法。"
msgstr ""
"终于注意到了。没有定额的工作的话，\n"
"时魔法不划算啊。"

#. ID 66, Page 2, Line 2, Pos (109,11)
msgid ""
"ここは倉庫よ。\n"
"武器防具以外にもやくそうや道具なんかも\n"
"ここに備蓄してあるわ。"
msgstr ""
"这里是仓库哦。除了武器防具，\n"
"药草和道具之类的东西也储备在这里呢。"

#. ID 66, Page 3, Line 2, Pos (109,11)
#. ID 66, Page 4, Line 2, Pos (109,11)
#. ID 66, Page 5, Line 2, Pos (109,11)
#. ID 66, Page 6, Line 2, Pos (109,11)
#. ID 66, Page 7, Line 2, Pos (109,11)
#. ID 66, Page 8, Line 2, Pos (109,11)
#. ID 66, Page 9, Line 2, Pos (109,11)
#. ID 66, Page 12, Line 2, Pos (109,11)
msgid "ちょっと聞きました？"
msgstr "你听说了吗？"

#. ID 66, Page 3, Line 4, Pos (109,11)
msgid ""
"砦の金庫に賊が入ったらしいですわ。\n"
"なんでも食堂にいたエルフが犯人だとか…"
msgstr ""
"听说有贼闯进了要塞的金库呢。\n"
"据说犯人是之前在食堂的那个精灵……"

#. ID 66, Page 3, Line 6, Pos (109,11)
msgid ""
"こんな近くに凶悪犯がいただなんて……\n"
"世の中恐いわねえ……"
msgstr "这么近的地方竟然有凶恶犯……世上真可怕呢……"

#. ID 66, Page 4, Line 4, Pos (109,11)
msgid "砦の金庫にまた賊が入ったらしいですわ。"
msgstr "听说又有贼闯进了要塞的金库呢。"

#. ID 66, Page 4, Line 5, Pos (109,11)
msgid ""
"今度の犯人はエルフの妹、\n"
"なんでも凶悪強盗団の一員だったとか……"
msgstr ""
"这次的犯人是精灵妹妹，\n"
"据说她是凶恶强盗团的一员……"

#. ID 66, Page 4, Line 7, Pos (109,11)
msgid ""
"もう1人残ってますけど……\n"
"彼女こそ真の大物だとか……自ら手を下す\n"
"ため機会を窺っているらしいですわ……"
msgstr ""
"还剩一个人呢……据说她才是真正的大人物……\n"
"好像为了亲自动手而在伺机而动呢……"

#. ID 66, Page 4, Line 10, Pos (109,11)
msgid "恐いですわねぇ……"
msgstr "真可怕呢……"

#. ID 66, Page 5, Line 4, Pos (109,11)
msgid ""
"あの教会の修道女も強盗団の仲間だとか。\n"
"例の大ボスのエルフと親密な関係で、\n"
"国家転覆を狙っているらしいですわ。"
msgstr ""
"听说那个教会的修女也是强盗团的同伙。\n"
"和那个大首领的精灵关系亲密，\n"
"似乎企图颠覆国家呢。"

#. ID 66, Page 5, Line 7, Pos (109,11)
#. ID 66, Page 6, Line 11, Pos (109,11)
#. ID 66, Page 7, Line 13, Pos (109,11)
#. ID 66, Page 9, Line 11, Pos (109,11)
msgid "恐いですわねえ……"
msgstr "真可怕呢……"

#. ID 66, Page 6, Line 4, Pos (109,11)
msgid ""
"恐ろしい魔物が現れたらしいですわ。\n"
"一体でテロリストを壊滅させ、\n"
"要塞を潰し、ギャングを壊滅させるような\n"
"化け物らしいですわ。"
msgstr ""
"好像出现了可怕的魔物呢。\n"
"据说那是能凭一己之力歼灭恐怖分子、摧毁要塞、\n"
"消灭黑帮的怪物呢。"

#. ID 66, Page 6, Line 8, Pos (109,11)
msgid ""
"なんとか、今回は重症を負いながらも\n"
"うちの一門の者が撃退したらしいですわ。"
msgstr ""
"不过总算，这次虽然身负重伤，\n"
"好像是我们一门的人击退了它呢。"

#. ID 66, Page 7, Line 4, Pos (109,11)
msgid ""
"あのいなくなったコックさん、\n"
"とんだヤクザだったらしいですわ。"
msgstr "那个消失的厨师，好像是个不得了的流氓呢。"

#. ID 66, Page 7, Line 6, Pos (109,11)
msgid ""
"口より早く手が出る乱暴者で、\n"
"歯向かえば手首を捻られ、機嫌が悪ければ\n"
"首をへし折るんだそうよ。"
msgstr ""
"是个手比嘴快的粗暴家伙，\n"
"要是反抗就会被扭断手腕，\n"
"心情不好就会被折断脖子哦。"

#. ID 66, Page 7, Line 9, Pos (109,11)
msgid ""
"武器を持っても奪われ殺され、\n"
"毒を盛っても\n"
"謎のお茶により解毒されるとか……"
msgstr ""
"就算拿武器也会被夺走并杀掉，\n"
"就算下毒也会被谜之茶解毒什么的……"

#. ID 66, Page 8, Line 4, Pos (109,11)
msgid ""
"教官の遠征って、表だっては出稽古って\n"
"ことになってますけど、実際は各所の道場\n"
"潰しらしいですわ。"
msgstr ""
"教官的远征，表面上说是外出指导，\n"
"但实际上好像是在各地踢馆呢。"

#. ID 66, Page 8, Line 7, Pos (109,11)
msgid ""
"軍の力を誇示するために時々やってるんだ\n"
"そうですわ。野蛮ですわねえ……"
msgstr ""
"据说为了炫耀军队的力量，时不时就会这么做呢。\n"
"真野蛮呢……"

#. ID 66, Page 8, Line 10, Pos (109,11)
msgid ""
"そういえば、ブライ道場には来たことが\n"
"ありませんわね。その伸びた鼻へし折って\n"
"やりますのに！"
msgstr ""
"说起来，还没来过布莱道场呢。\n"
"真想把她那得意洋洋的鼻子给折断！"

#. ID 66, Page 9, Line 4, Pos (109,11)
msgid ""
"都では、次の王位を巡って派閥争いが\n"
"本格化しているらしいですわ。"
msgstr ""
"在都城，\n"
"围绕下一任王位的派系斗争好像正在正式化呢。"

#. ID 66, Page 9, Line 6, Pos (109,11)
msgid ""
"うちの王子様もさり気に三男ですからね…\n"
"こんなところにいていいんでしょうか……"
msgstr ""
"我们的王子殿下也意外地是第三子呢……\n"
"待在这种地方真的好吗……"

#. ID 66, Page 9, Line 8, Pos (109,11)
msgid ""
"兄弟の間で腹の探り合い、骨肉の争いが\n"
"繰り広げられているらしいですわ。"
msgstr "兄弟之间好像正在展开互相试探、骨肉相争呢。"

#. ID 66, Page 12, Line 4, Pos (109,11)
msgid ""
"この砦には、何やらとてつもない秘密が\n"
"隠されているんですって。"
msgstr "听说这座要塞里隐藏着某种不得了的秘密。"

#. ID 66, Page 12, Line 6, Pos (109,11)
msgid ""
"その秘密に迫った者は命すら危ないとか。\n"
"今回、私たちがいない間にその処刑が\n"
"ここで執行されたんだそうですわ。"
msgstr ""
"据说接近那个秘密的人连性命都危险。这次，\n"
"在我们不在的时候，\n"
"那场处刑好像就是在这里执行的。"

#. ID 66, Page 12, Line 10, Pos (109,11)
msgid "恐いですわねえ…"
msgstr "真可怕呢…"

#. ID 67, Page 2, Line 2, Pos (80,11)
msgid ""
"新入りか……\n"
"\n"
"………………よろしく。"
msgstr "新人吗……………………请多关照。"

#. ID 67, Page 3, Line 2, Pos (80,11)
msgid ""
"金庫の金が消えたらしい。\n"
"何か知らないか？"
msgstr "金库里的钱好像消失了。你知道些什么吗？"

#. ID 67, Page 4, Line 2, Pos (80,11)
msgid ""
"我々の目をかいくぐり…\n"
"次はないぞ…"
msgstr "竟从我们眼皮底下溜过去……没有下次了……"

#. ID 67, Page 5, Line 2, Pos (80,11)
msgid ""
"謎の敵襲……\n"
"うちのエロおやじがやられた……"
msgstr "神秘的敌袭……我们家的色老头被干掉了……"

#. ID 67, Page 5, Line 5, Pos (80,11)
msgid "一族の仇は一族が討つ……"
msgstr "一族的仇由一族来报……"

#. ID 67, Page 6, Line 2, Pos (80,11)
msgid ""
"教官が遠征に出た……\n"
"\n"
"敵が狙うならここだろう。"
msgstr "教官出征了……敌人若要下手，应该是这里吧。"

#. ID 67, Page 6, Line 6, Pos (80,11)
msgid ""
"飛んで火に入る夏の虫。\n"
"敵は、我らブライが片付ける。"
msgstr "飞蛾扑火自取灭亡。敌人就由我们布莱来收拾。"

#. ID 67, Page 7, Line 1, Pos (80,11)
msgid ""
"ブライ一門が軒並み罷免……！？\n"
"高給取りだったけど……\n"
"そんなに砦の財政厳しかったかしら？"
msgstr ""
"布莱一门全都被免职了……！？他们虽然薪水很高……\n"
"但要塞的财政有那么吃紧吗？"

#. ID 67, Page 9, Line 1, Pos (80,11)
msgid ""
"もうダメ……身体が疼いて……\n"
"魔力も………"
msgstr "已经不行了……身体发疼……魔力也………"

#. ID 67, Page 10, Line 1, Pos (80,11)
msgid "あは……あはははははははは…………"
msgstr "啊哈……啊哈哈哈哈哈哈哈哈…………"

#. ID 68, Page 1, Line 1, Pos (70,25)
msgid "むにゃむにゃ……"
msgstr "唔喵唔喵……"

#. ID 68, Page 3, Line 1, Pos (70,25)
msgid ""
"むにゃむにゃ……\n"
"やっと戻ってこれた……"
msgstr "唔喵唔喵……终于回到这里来了……"

#. ID 69, Page 1, Line 1, Pos (55,50)
msgid ""
"ふうむ……予算がいやに多いのよねぇ……\\!\n"
"こんな重要とも思えない砦なのに\n"
"この充実っぷりはなんなのかしら……"
msgstr ""
"唔姆……预算异常地多呢……\n"
"\\!明明是个不觉得有多重要的堡垒，\n"
"这种充实程度到底是怎么回事呢……"

#. ID 69, Page 2, Line 1, Pos (55,50)
msgid ""
"砦に泥棒が入ったらしいわ。\n"
"この警備をかいくぐって…凄腕ねぇ……"
msgstr ""
"好像有小偷进了堡垒。能钻过这样的警备……\n"
"真厉害呢……"

#. ID 69, Page 2, Line 4, Pos (55,50)
msgid ""
"盗まれた分の会計はどうしましょ……\n"
"今まで合わなかった分もその泥棒さんになすりつけて\n"
"帳尻合わせちゃいましょうか……"
msgstr ""
"被盗部分的账目怎么办呢……\n"
"至今为止对不上的部分也推给那个小偷，\n"
"把账目凑平吧……"

#. ID 69, Page 3, Line 1, Pos (55,50)
msgid ""
"また金庫荒らしよ。しかも、どうやら内部犯だった\n"
"らしいわ。"
msgstr ""
"又是金库被撬了。而且，\n"
"看来好像是内部人员作案呢。"

#. ID 69, Page 3, Line 3, Pos (55,50)
msgid ""
"いなくなったエルフ……\n"
"確かにちょっと悪人面だったわ。\n"
"あいつなら内部にも詳しいし……\n"
"最近は夜な夜なコソコソやっていたみたい。"
msgstr ""
"消失的精灵……确实有点坏人脸呢。\n"
"那家伙对内部也很熟悉……\n"
"最近好像每晚都偷偷摸摸的。"

#. ID 70, Page 1, Line 2, Pos (46,50)
msgid ""
"こんな狭い部屋に\n"
"俺のような兵士を押し込めるとは、\n"
"適材適所とは言えないな……"
msgstr ""
"把像我这样的士兵塞进这么窄的房间里，\n"
"可不能说适材适所啊……"

#. ID 70, Page 1, Line 7, Pos (46,50)
msgid ""
"だが、まぁ不満はないぞ。\n"
"ここからの眺めは最高だ。"
msgstr ""
"不过，嘛，我没什么不满。\n"
"从这里望出去的景色最棒了。"

#. ID 70, Page 1, Line 16, Pos (46,50)
msgid "いやらしい！"
msgstr "下流！"

#. ID 70, Page 1, Line 22, Pos (46,50)
msgid "あいたっ！？"
msgstr "好痛！？"

#. ID 70, Page 1, Line 28, Pos (46,50)
msgid "イヤラシイ！"
msgstr "下流！"

#. ID 70, Page 1, Line 34, Pos (46,50)
msgid "ぎゃあっ！！"
msgstr "呀啊！！"

#. ID 70, Page 1, Line 37, Pos (46,50)
msgid ""
"ううん……\n"
"なんて遠慮のないお嬢さん方だ…………\n"
"実にいい。"
msgstr "唔嗯……真是毫不客气的小姐们啊…………实在不错。"

#. ID 70, Page 2, Line 2, Pos (46,50)
msgid ""
"よう……ちょっと忙しくなってきたな……\n"
"俺をいつまでベンチウォーマーにしている\n"
"のか。"
msgstr ""
"哟……开始有点忙起来了呢……\n"
"要让我当替补到什么时候啊。"

#. ID 70, Page 3, Line 2, Pos (46,50)
msgid ""
"ここ独りじゃ無理だ！\n"
"忙しい！寂しい！見晴らしが悪い！"
msgstr "这里一个人不行！忙！寂寞！视野不好！"

#. ID 70, Page 3, Line 6, Pos (46,50)
msgid ""
"……てか、おかしくね？\n"
"なんで俺ほどの男が１人で事務室籠もって\n"
"るんだ？"
msgstr ""
"……话说，不奇怪吗？\n"
"为什么像我这样的男人一个人关在办公室里？"

#. ID 71, Page 1, Line 1, Pos (18,11)
msgid ""
"ここはブライ家の者が多く配属になっていることもあり\n"
"難攻不落の要塞と化している。"
msgstr ""
"这里因为有很多布莱家的人被配属，\n"
"已经化为难攻不落的要塞。"

#. ID 71, Page 1, Line 3, Pos (18,11)
msgid ""
"だが、例え彼らがいなかったとしても！\n"
"我々は優秀な兵士である。\n"
"彼らの力を借りなくとも俺たちは十分にその任務を\n"
"果たすことができるはずなんだ！"
msgstr ""
"但是，就算他们不在！我们是优秀的士兵。\n"
"即使不借助他们的力量，\n"
"我们也应该能够充分完成任务！"

#. ID 71, Page 1, Line 8, Pos (18,11)
msgid ""
"彼らさえいなければ……\n"
"\n"
"ふとそう考えることもある。"
msgstr "只要没有他们……我有时也会突然这样想。"

#. ID 71, Page 1, Line 12, Pos (18,11)
msgid ""
"自分の力を示したい……\n"
"同僚であるブライ家が疎ましいと感じることがないとは\n"
"言えないな……"
msgstr ""
"我想展示自己的力量……\n"
"不能说我没有觉得同为同事的布莱家碍眼……"

#. ID 71, Page 2, Line 1, Pos (18,11)
msgid "また金庫がやられた。"
msgstr "金库又被盗了。"

#. ID 71, Page 2, Line 2, Pos (18,11)
msgid ""
"立て続けの失態に、ブライ一門の苛立ちが募っている。\n"
"他の兵士たちの失態を罵ることも度々だ。"
msgstr ""
"接连不断的失态让布莱一门的焦躁不断积聚。\n"
"他们也屡次责骂其他士兵的失态。"

#. ID 71, Page 2, Line 5, Pos (18,11)
msgid "……自分たちのことは棚に上げてな。"
msgstr "……对自己人的事倒是搁在一边呢。"

#. ID 71, Page 3, Line 1, Pos (18,11)
msgid ""
"敵襲があったらしい。俺は初めてなんだが、\n"
"襲われても思いの外砦は大人しいものなんだな。\n"
"それで大丈夫なのか……？"
msgstr ""
"好像有敌军来袭。我虽然是第一次遇到，\n"
"但就算被袭击，堡垒也意外地安静呢。\n"
"这样没问题吗……？"

#. ID 71, Page 4, Line 1, Pos (18,11)
msgid ""
"いったい何が起こっているんだ……\n"
"いっぺんにいろんなことが起こりすぎる……！！"
msgstr ""
"到底发生了什么……各种事情一下子发生得太多了……！\n"
"！"

#. ID 71, Page 5, Line 1, Pos (18,11)
msgid ""
"遠征か。\n"
"あいつら喜々として出掛けていったな……"
msgstr "远征吗。那些家伙兴高采烈地出发了呢……"

#. ID 71, Page 5, Line 3, Pos (18,11)
msgid ""
"そんなに戦うのが好きなのか……\\!\n"
"いや……多分遠征中は軍曹のしごきがない\n"
"からだな。"
msgstr ""
"就那么喜欢战斗吗……\\!不……\n"
"大概是因为远征期间没有军曹的严厉操练吧。"

#. ID 71, Page 5, Line 6, Pos (18,11)
msgid "……ったく、残った者は大変だってのに……"
msgstr "……真是的，留下来的人可辛苦了……"

#. ID 71, Page 6, Line 1, Pos (18,11)
msgid ""
"おいおい、どうなってやがる。\n"
"事務の奴らまでほぼ総動員じゃねえか…\n"
"ここってブライが多数を占めてたんだな……"
msgstr ""
"喂喂，到底怎么回事。\n"
"连做事务的家伙都几乎全员出动了……\n"
"这里原来是布莱占多数啊……"

#. ID 71, Page 8, Line 1, Pos (18,11)
msgid ""
"くそ……突然……大軍が………\n"
"全く太刀打ちできなかった…………"
msgstr "可恶……突然……大军………完全无法招架…………"

#. ID 71, Page 8, Line 3, Pos (18,11)
msgid ""
"俺たちは……こんなにも…無力だったのか………\n"
"あ……あいつらの………威を………借りて…………\n"
"つ………強い気に………なって……いた……だけ………"
msgstr ""
"我们……竟然如此…无力吗………啊……只是……借着……\n"
"他们的……威势…………变……自以为了不起……而已………"

#. ID 71, Page 8, Line 7, Pos (18,11)
msgid "う……うぅ……………"
msgstr "唔……唔唔……………"

#. ID 71, Page 9, Line 1, Pos (18,11)
msgid "返事がない。すでに息絶えているようだ。"
msgstr "没有回应。看来已经断气了。"

#. ID 72, Page 1, Line 3, Pos (8,46)
msgid ""
"………？\\!\n"
"\n"
"どうかしたか？どこかであったかな？"
msgstr "………？\\!怎么了？我们哪里见过吗？"

#. ID 72, Page 1, Line 7, Pos (8,46)
msgid ""
"私に姉妹とかいないかって？\n"
"確かに姉がいるが……"
msgstr "问我有没有姐妹吗？确实有个姐姐……"

#. ID 72, Page 1, Line 11, Pos (8,46)
msgid ""
"ああ、姉さんところのお客さんなのかな。\n"
"姉さんはアバロソのペットショップで\n"
"働いてるから。"
msgstr ""
"啊，原来是姐姐那里的客人吗。\n"
"姐姐在阿巴罗索的宠物店工作。"

#. ID 72, Page 1, Line 15, Pos (8,46)
msgid "これからも何卒ご贔屓に……ってね。"
msgstr "今后也请多多惠顾……对吧。"

#. ID 72, Page 1, Line 19, Pos (8,46)
msgid ""
"こらこら、人の部屋にかってに入らない。\\!\n"
"勉強していたから良かったものの、これが\n"
"情事の最中とかだったらどうするんだ。"
msgstr ""
"喂喂，不要随便进别人的房间。\n"
"\\!幸亏我刚才在学习，\n"
"这要是在做爱中途可怎么办啊。"

#. ID 72, Page 2, Line 2, Pos (8,46)
msgid ""
"隊長は若いが腕は確かだ。\n"
"\n"
"若干子供っぽいところがまた保護欲を\n"
"刺激されるな。"
msgstr ""
"队长虽然年轻，但本事确实可靠。\n"
"有些孩子气的地方又刺激人的保护欲呢。"

#. ID 72, Page 3, Line 2, Pos (8,46)
msgid ""
"消えた金とウェイトレスの話題で砦は\n"
"持ちきりだ。"
msgstr "消失的钱和女服务员的话题在堡垒里传得沸沸扬扬。"

#. ID 72, Page 3, Line 4, Pos (8,46)
msgid ""
"ただでさえ、退屈でゴシップに飢えた環境\n"
"なこともあって、尾びれ背びれが付き……\n"
"早くもウェイトレスが犯人だと信じている\n"
"者も少なくない。"
msgstr ""
"本来就是个无聊又渴望八卦的环境，\n"
"所以传言被添油加醋……\n"
"已经有不少人相信女服务员是犯人。"

#. ID 72, Page 4, Line 2, Pos (8,46)
msgid ""
"また、盗賊にやられた。\n"
"このままでは砦の面目丸つぶれだ。"
msgstr "又被盗贼搞了。这样下去堡垒的面子就全丢光了。"

#. ID 72, Page 4, Line 4, Pos (8,46)
msgid ""
"よって、夜の警戒を強化することになった\n"
"らしい。"
msgstr "因此，好像决定要加强夜间警戒了。"

#. ID 72, Page 5, Line 2, Pos (8,46)
msgid "軍曹の遠征が近づいている……"
msgstr "军曹的远征临近了……"

#. ID 72, Page 5, Line 4, Pos (8,46)
msgid ""
"その間、この砦の戦闘員はブライ一門が\n"
"ほとんどを占めることになる。"
msgstr ""
"在此期间，\n"
"这座堡垒的战斗员将由布莱一门占据大半。"

#. ID 72, Page 5, Line 7, Pos (8,46)
msgid ""
"彼らは横柄なところがあるからな………\n"
"ちょっと憂鬱だ。"
msgstr "他们有些傲慢呢………有点郁闷。"

#. ID 72, Page 6, Line 2, Pos (8,46)
msgid ""
"軍曹の遠征が近づいている……\n"
"敵襲があったというのに、どうやら敢行\n"
"するらしい。"
msgstr ""
"军曹的远征临近了……明明有敌军来袭，\n"
"看来还是要坚决执行。"

#. ID 72, Page 6, Line 6, Pos (8,46)
msgid ""
"一度出たら当分帰っては来ない。\n"
"軍曹に手合わせ願いたいなら、今のうちに\n"
"挑むことだな。"
msgstr ""
"一旦出发，暂时就不会回来。如果想请军曹交手，\n"
"就得趁现在挑战了。"

#. ID 72, Page 7, Line 2, Pos (8,46)
msgid ""
"表には出さないが、最近の隊長は非常に\n"
"張りつめている。"
msgstr "虽然没表现出来，但最近的队长非常紧绷。"

#. ID 72, Page 7, Line 4, Pos (8,46)
msgid ""
"立て続けに事件があったからな……それは\n"
"無理もない話なんだが……"
msgstr "因为接连发生事件嘛……那也是没办法的事……"

#. ID 72, Page 7, Line 8, Pos (8,46)
msgid ""
"私にもっと力があれば、隊長を側で支えて\n"
"あげられるのに……"
msgstr "如果我有更多力量，就能在身旁支持队长了……"

#. ID 72, Page 8, Line 2, Pos (8,46)
msgid ""
"ブライが抜けた。\n"
"いったい何があったのか、詳しいことは\n"
"わかっていないが……"
msgstr "布莱离开了。到底发生了什么，详细情况还不清楚……"

#. ID 72, Page 8, Line 5, Pos (8,46)
msgid ""
"昔から確執はあった。それが今回爆発して\n"
"しまったのだという見方が一般的だ。"
msgstr "从以前就有矛盾。一般认为这次是爆发出来了。"

#. ID 72, Page 8, Line 7, Pos (8,46)
msgid ""
"しかし、ブライが抜けて大丈夫なのか？\n"
"この砦はともかく……彼らって王子の護衛\n"
"だとばかり思っていたが……"
msgstr ""
"但是，布莱离开没问题吗？这座堡垒暂且不论……\n"
"我一直以为他们是王子的护卫呢……"

#. ID 72, Page 8, Line 12, Pos (8,46)
msgid ""
"隊長はお優しい方だ。\n"
"今回の事件に関しても、胸を痛めて\n"
"おいでだろう……"
msgstr ""
"队长是个温柔的人。关于这次的事件，\n"
"他一定也很痛心吧……"

#. ID 72, Page 9, Line 2, Pos (8,46)
msgid "さすがにしんどいな……少し休むか………"
msgstr "果然还是很累啊……稍微休息一下吧………"

#. ID 72, Page 9, Line 5, Pos (8,46)
msgid "隊長……隊長は……私……が…………"
msgstr "队长……队长……我………………"

#. ID 75, Page 1, Line 1, Pos (55,53)
msgid "ああ、これ王子のサインがいるな。"
msgstr "啊，这个需要王子的签名啊。"

#. ID 75, Page 1, Line 3, Pos (55,53)
msgid "俺、王子苦手なんだよなぁ"
msgstr "我啊，不擅长应付王子呢。"

#. ID 76, Page 2, Line 1, Pos (70,34)
msgid "んがーーー……ごご……"
msgstr "唔嘎——……咕咕……"

#. ID 77, Page 1, Line 2, Pos (114,46)
msgid "うん？もう替わりの時間ですか？"
msgstr "嗯？已经到换班时间了吗？"

#. ID 77, Page 2, Line 2, Pos (114,46)
msgid ""
"君が私のルームメイトかい？\n"
"これからよろしくね。"
msgstr "你是我的室友吗？今后请多关照。"

#. ID 77, Page 3, Line 2, Pos (114,46)
msgid ""
"おはよう。\n"
"なんでも砦の金庫が荒らされたらしい。\n"
"同時にウェイトレスが一人消えたとか……"
msgstr ""
"早上好。听说要塞的金库被洗劫了。\n"
"同时还有一名女服务员消失了……"

#. ID 77, Page 3, Line 6, Pos (114,46)
msgid "そんなことする娘には見えなかったが……"
msgstr "不觉得她是会做那种事的女孩……"

#. ID 77, Page 4, Line 2, Pos (114,46)
msgid ""
"おはよう。\n"
"また金庫が荒らされたらしい。\n"
"そして今度も、エルフが一人消えた。"
msgstr ""
"早上好。金库好像又被洗劫了。而且这次，\n"
"也有一名精灵消失了。"

#. ID 77, Page 4, Line 6, Pos (114,46)
msgid ""
"剛胆なことだ。\n"
"ここには潤沢な資金があるとはいえ……"
msgstr "真是胆大包天。虽说这里有充裕的资金……"

#. ID 77, Page 5, Line 2, Pos (114,46)
msgid ""
"そう言えば、君が来てからだな。\n"
"金庫が荒らされたのって。"
msgstr "说起来，是从你来之后开始的吧。金库被洗劫这事。"

#. ID 77, Page 5, Line 6, Pos (114,46)
msgid "まさか、君が……？"
msgstr "难道，是你……？"

#. ID 77, Page 5, Line 9, Pos (114,46)
msgid ""
"じょ……冗談だよ、\n"
"そんな恐い顔すんなって！\n"
"来たばかりの君に金庫を漁るのは無理だ！"
msgstr ""
"开……开玩笑的，别摆出那么可怕的表情！\n"
"刚来的你不可能去翻金库的！"

#. ID 77, Page 5, Line 14, Pos (114,46)
msgid ""
"ホント、ごめんって……\n"
"迂闊だったよ。"
msgstr "真的，我说抱歉啦……是我太草率了。"

#. ID 77, Page 6, Line 2, Pos (114,46)
msgid ""
"最近……\n"
"ちょっとギスギスした感じなんだよね。"
msgstr "最近……感觉有点剑拔弩张呢。"

#. ID 77, Page 6, Line 6, Pos (114,46)
#. Contains choice at line 3 (2 options)
msgid ""
"組織の一体感がないっていうのは……\n"
"不安だよ。"
msgstr "组织缺乏一体感……让人不安啊。"

#. ID 77, Page 6, Line 9, Pos (114,46)
#. Choice (2 options, embedded in a message)
msgid ""
"気にしすぎじゃない？\n"
"じゃあ、合体しようか……"
msgstr ""
"是不是想太多了？\n"
"那，我们合体吧……"

#. ID 77, Page 6, Line 12, Pos (114,46)
msgid "うん……そうだといいけど……"
msgstr "嗯……那样就好了……"

#. ID 77, Page 6, Line 16, Pos (114,46)
#. Contains choice at line 2 (2 options)
msgid "いや、君、何言ってるの……女同士で……"
msgstr "不，你在说什么啊……女人之间……"

#. ID 77, Page 6, Line 18, Pos (114,46)
#. Choice (2 options, embedded in a message)
msgid ""
"問題ない。子供は2人がいいな。\n"
"君が難しい顔をしてるから…"
msgstr ""
"没问题。孩子的话两个不错。\n"
"因为你摆着为难的表情……"

#. ID 77, Page 6, Line 21, Pos (114,46)
msgid ""
"マジでなに言ってんの！？\n"
"できないから！！"
msgstr "说真的你在说什么啊！？做不到啦！！"

#. ID 77, Page 6, Line 26, Pos (114,46)
msgid "む？"
msgstr "唔？"

#. ID 77, Page 6, Line 29, Pos (114,46)
msgid ""
"これは、心配させてしまったのか……\\!\n"
"ありがとう。\n"
"でも、合体はしないからな。"
msgstr ""
"这是，让你担心了吗……\\!谢谢。但是，\n"
"不会合体的哦。"

#. ID 77, Page 6, Line 39, Pos (114,46)
msgid ""
"無言か……\\!\n"
"確かにその通りだ。\n"
"兵士が余計なことを考えてどうするんだ…"
msgstr "沉默吗……\\!确实如此。士兵想多余的事有什么用……"

#. ID 77, Page 7, Line 2, Pos (114,46)
msgid ""
"事件だよ！\n"
"なんでもこの砦が謎の敵から襲撃を受けた\n"
"らしい。大きな騒ぎにはならなかったが…"
msgstr ""
"出事了！听说这座要塞遭到了神秘敌人的袭击。\n"
"虽然没有引起大骚动……"

#. ID 77, Page 7, Line 5, Pos (114,46)
msgid ""
"私たちも腹を括らないといけない時が来た\n"
"のかもしれないな！"
msgstr "也许我们也到了必须下定决心的时候了！"

#. ID 77, Page 8, Line 2, Pos (114,46)
msgid ""
"食堂には行ったかい！？\n"
"コックが替わって味ががた落ちだよ！！\n"
"あったま来るなあ！"
msgstr ""
"你去食堂了吗！？厨师换了，味道一落千丈啊！！\n"
"真让人火大！"

#. ID 77, Page 8, Line 6, Pos (114,46)
msgid ""
"みんなカンカンさ。なんで急に替えるんだ\n"
"ってね。"
msgstr "大家都气坏了。说什么为什么突然换人啊。"

#. ID 77, Page 8, Line 10, Pos (114,46)
msgid ""
"いろんな噂が飛びかってるよ。\n"
"コックが実はスパイだったとか、\n"
"王子が乱心したとか……ケンカしたとか…"
msgstr ""
"各种谣言满天飞哦。说厨师其实是间谍啦，\n"
"王子发疯了啦……吵架了之类的……"

#. ID 77, Page 8, Line 13, Pos (114,46)
msgid ""
"コックが例の犯人だったなんて言う者も\n"
"いる。時期が時期だけにね……"
msgstr "也有人说厨师就是那个犯人。毕竟时机太巧了……"

#. ID 77, Page 9, Line 2, Pos (114,46)
msgid "おはよう。軍曹たちが遠征に出掛けたよ。"
msgstr "早上好。军士们出征了哦。"

#. ID 77, Page 9, Line 4, Pos (114,46)
msgid ""
"それに伴って兵士の数も大分減ってる。\n"
"彼らは元々訓練所にいるから\n"
"パッと見変わらないかもしれないけどね。"
msgstr ""
"随之士兵的数量也减少了很多。\n"
"他们本来就在训练所，\n"
"所以乍看之下可能没什么变化。"

#. ID 77, Page 9, Line 8, Pos (114,46)
msgid ""
"たいてい床にボロ雑巾みたいに転がってる\n"
"だけだけど、彼らってあれでめちゃくちゃ\n"
"強いんだよね……"
msgstr ""
"虽然大多时候只是像破抹布一样躺在地上，\n"
"但他们那样其实强得离谱呢……"

#. ID 77, Page 9, Line 11, Pos (114,46)
msgid "戦力の低下は否めないんだ。"
msgstr "战力的下降是无可否认的。"

#. ID 77, Page 9, Line 12, Pos (114,46)
msgid ""
"だから、それを埋めるために\n"
"これからはタイトなスケジュールになると\n"
"思う。君にも仕事が回ってくるかもよ？"
msgstr ""
"所以，为了填补这个空缺，今后日程会排得很紧。\n"
"工作可能也会轮到你来哦？"

#. ID 77, Page 10, Line 2, Pos (114,46)
msgid ""
"どうした？\n"
"今にも戦場に行きそうな\n"
"差し迫った顔してるぞ？"
msgstr "怎么了？你一副马上就要上战场的紧迫表情哦？"

#. ID 77, Page 10, Line 6, Pos (114,46)
msgid ""
"真面目なのはいいけど、\n"
"そんなんじゃ保たないぞ？"
msgstr "认真是好事，但那样可撑不住哦？"

#. ID 77, Page 11, Line 2, Pos (114,46)
msgid "なんだか下が騒がしいな……"
msgstr "总觉得下面很吵闹啊……"

#. ID 77, Page 12, Line 2, Pos (114,46)
msgid ""
"一大事だよ！\n"
"ブライ一門が軒並み首になっちゃった！！"
msgstr "出大事了！布莱一门全都被解雇了！！"

#. ID 77, Page 12, Line 4, Pos (114,46)
msgid ""
"ざまあみろ！！\n"
"………いやいや、なんでもない。\n"
"とにかくてんやわんやの大忙しだ！！"
msgstr ""
"活该！！……不不，没什么。\n"
"总之现在乱成一团忙得不可开交！！"

#. ID 77, Page 13, Line 2, Pos (114,46)
msgid ""
"しかし、王子はブライ共を返してしまって\n"
"よかったのかね？彼らって、事実上王子の\n"
"護衛だったんじゃないのか？"
msgstr ""
"不过，王子把布莱那伙人放回去真的好吗？\n"
"他们实际上不就是王子的护卫吗？"

#. ID 77, Page 13, Line 6, Pos (114,46)
#. Choice (2 options)
msgid ""
"なんで？\n"
"確かに"
msgstr ""
"为什么？\n"
"确实"

#. ID 77, Page 13, Line 9, Pos (114,46)
msgid ""
"なんでって……そりゃそうだろ？\n"
"こんな片田舎に、あんなごつい武力集団を\n"
"囲っておく理由ってなんだってんだい……"
msgstr ""
"为什么……那当然吧？在这种乡下地方，\n"
"养着那么一支粗壮的武力集团，理由是什么啊……"

#. ID 77, Page 13, Line 13, Pos (114,46)
msgid "少し考えればわかることさ。"
msgstr "稍微想想就明白了。"

#. ID 77, Page 13, Line 17, Pos (114,46)
msgid ""
"余程腹の立つことでもあったのか……\n"
"しかし、暗殺なんてことになったら\n"
"私らじゃ多分防げないぞ。"
msgstr ""
"难道是有什么让他非常生气的事……但是，\n"
"如果变成暗杀的话，我们多半防不住哦。"

#. ID 77, Page 13, Line 20, Pos (114,46)
msgid "この前泥棒に入られたくらいだからな。"
msgstr "毕竟之前才刚被小偷光顾过。"

#. ID 78, Page 1, Line 2, Pos (50,48)
msgid ""
"やれやれ……\n"
"事務ってのはやることが多いわりに\n"
"退屈でしょうがねえ"
msgstr "唉……事务工作虽然事情多，却无聊得要命。"

#. ID 78, Page 2, Line 3, Pos (50,48)
msgid ""
"すまんが忙しい。\n"
"後にしてくれ。"
msgstr "抱歉我很忙。之后再说。"

#. ID 78, Page 2, Line 8, Pos (50,48)
msgid "金庫の件は現在中だ。"
msgstr "金库的事现在正在调查中。"

#. ID 78, Page 2, Line 9, Pos (50,48)
msgid ""
"あの人がそんなことをするはずがない。\n"
"きっと真犯人を突き止めてやる……"
msgstr "那个人不可能做那种事。我一定会查明真凶……"

#. ID 78, Page 3, Line 2, Pos (50,48)
msgid "なんだ、こんな夜更けに……"
msgstr "什么啊，这么晚了……"

#. ID 78, Page 3, Line 6, Pos (50,48)
#. Contains choice at line 2 (3 options)
msgid "どう言って連れ出すか……"
msgstr "该怎么说服她带出来呢……"

#. ID 78, Page 3, Line 7, Pos (50,48)
#. Choice (3 options, embedded in a message)
msgid ""
"私は犯人を知っている\n"
"やい、盗人の妹！\n"
"やめておく"
msgstr ""
"我知道犯人是谁\n"
"喂，小偷的妹妹！\n"
"还是算了"

#. ID 78, Page 3, Line 10, Pos (50,48)
msgid ""
"君が？\n"
"何故だ？見ていたのか？"
msgstr "你知道？为什么？你看到了吗？"

#. ID 78, Page 3, Line 13, Pos (50,48)
#. Choice (3 options)
msgid ""
"はい\n"
"犯人だからさ\n"
"いや……戯れ言だ"
msgstr ""
"是的\n"
"因为就是犯人啊\n"
"不……是玩笑话"

#. ID 78, Page 3, Line 16, Pos (50,48)
#. Contains choice at line 2 (3 options)
msgid "誰だ！？言え！！"
msgstr "是谁！？说！！"

#. ID 78, Page 3, Line 17, Pos (50,48)
#. Choice (3 options, embedded in a message)
msgid ""
"私だ\n"
"羊だ\n"
"すまん、よく見えなかった"
msgstr ""
"是我\n"
"是羊\n"
"抱歉，没看清"

#. ID 78, Page 3, Line 23, Pos (50,48)
msgid ""
"あいつか……\n"
"よし、とっちめて吐かせてやる。"
msgstr "那家伙吗……好，我去逼问让他招供。"

#. ID 78, Page 3, Line 26, Pos (50,48)
msgid "君も手伝ってくれ……！"
msgstr "你也来帮忙……！"

#. ID 78, Page 3, Line 41, Pos (50,48)
msgid ""
"そうか……\n"
"何か思い出したら教えてくれ…………"
msgstr "这样啊……想起什么就告诉我…………"

#. ID 78, Page 3, Line 49, Pos (50,48)
msgid "なんだと！？"
msgstr "什么！？"

#. ID 78, Page 3, Line 53, Pos (50,48)
msgid "あ……かは……"
msgstr "啊……咔哈……"

#. ID 78, Page 3, Line 59, Pos (50,48)
msgid "よし、あとは担ぎ出すだけだ。"
msgstr "好，剩下只要抬出去就行了。"

#. ID 78, Page 3, Line 65, Pos (50,48)
msgid ""
"すまんが、\n"
"冗談に付き合ってる暇はないんだ。"
msgstr "抱歉，我没空陪你开玩笑。"

#. ID 78, Page 3, Line 73, Pos (50,48)
msgid ""
"なにを！！\\!\n"
"あの人は、そんなことする人じゃない！！"
msgstr "说什么！！\\!那个人不是会做那种事的人！！"

#. ID 78, Page 3, Line 75, Pos (50,48)
msgid ""
"今に見ていろ！！\n"
"私が………真犯人を突き止めてやる！！"
msgstr "走着瞧！！我一定会………查明真凶！！"

#. ID 78, Page 3, Line 81, Pos (50,48)
msgid ""
"私は……仕事がある。\n"
"君は早く寝るんだ。"
msgstr "我……还有工作。你早点睡吧。"

#. ID 78, Page 5, Line 1, Pos (50,48)
msgid ""
"エルフの子がいなくなった。\n"
"しかも、また金庫を漁っていったときた。"
msgstr "精灵女孩不见了。而且，金库又被洗劫了。"

#. ID 78, Page 5, Line 3, Pos (50,48)
msgid ""
"あいつは三姉妹だった。\n"
"もう一人は今もここでウェイトレスをしている……"
msgstr "那家伙是三姐妹。另一个现在也在这里当女服务员……"

#. ID 78, Page 5, Line 6, Pos (50,48)
msgid ""
"こりゃ、もう一人も\n"
"疑うなって方が無理だというものだぜ。"
msgstr "这样的话，让人不怀疑另一个才是不可能的。"

#. ID 78, Page 6, Line 1, Pos (50,48)
msgid ""
"急な人事に遠征。おまけに敵襲。\n"
"事務もにわかに大変になってきたわ。"
msgstr ""
"突然的人事变动加上远征。还有敌人袭击。\n"
"事务工作也突然变得很忙了。"

#. ID 79, Page 2, Line 1, Pos (109,44)
#. ID 79, Page 5, Line 1, Pos (109,44)
msgid "夜まで一眠りしようか…"
msgstr "睡到晚上吧……"

#. ID 79, Page 3, Line 1, Pos (109,44)
#. Contains choice at line 2 (2 options)
#. ID 79, Page 6, Line 1, Pos (109,44)
#. Contains choice at line 2 (2 options)
msgid "朝まで寝る？"
msgstr "睡到早上吗？"

#. ID 79, Page 3, Line 2, Pos (109,44)
#. Choice (2 options, embedded in a message)
#. ID 79, Page 6, Line 2, Pos (109,44)
#. Choice (2 options, embedded in a message)
#. ID 82, Page 6, Line 11, Pos (53,26)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 79, Page 3, Line 4, Pos (109,44)
#. ID 79, Page 6, Line 4, Pos (109,44)
msgid "おやすみなさい・・・"
msgstr "晚安……"

#. ID 81, Page 2, Line 1, Pos (109,47)
msgid ""
"\\s[2]むにゃむにゃ……\\!\n"
"\n"
"へえ……ご老人がねぇ……"
msgstr "\\s[2]嗯嗯喃喃……\\!嘿……老人家啊……"

#. ID 81, Page 3, Line 1, Pos (109,47)
msgid "\\s[2]むにゃむにゃ……とし子宇宙へ……"
msgstr "\\s[2]嗯嗯喃喃……年子去宇宙……"

#. ID 81, Page 4, Line 1, Pos (109,47)
msgid "\\s[2]…………いじめ、かっこ悪い。"
msgstr "\\s[2]…………欺负人，真丢脸。"

#. ID 81, Page 5, Line 1, Pos (109,47)
msgid ""
"\\s[2]むにゃむにゃ……\n"
"たくあんは嫌いだって言ったじゃないか…"
msgstr "\\s[2]嗯嗯喃喃……不是说了讨厌腌萝卜吗……"

#. ID 81, Page 6, Line 2, Pos (109,47)
msgid ""
"ん……？\n"
"どうしたの？"
msgstr "嗯……？怎么了？"

#. ID 81, Page 7, Line 2, Pos (109,47)
msgid "ちょっとひもじい……"
msgstr "有点饿……"

#. ID 81, Page 8, Line 2, Pos (109,47)
msgid ""
"ちくしょう……ブライのやつら…………\n"
"コケにして…………"
msgstr "可恶……布莱那帮家伙…………竟敢小看我…………"

#. ID 81, Page 9, Line 2, Pos (109,47)
msgid "か……からだがギシギシ言うよ……"
msgstr "身……身体嘎吱作响啊……"

#. ID 81, Page 10, Line 2, Pos (109,47)
msgid ""
"むにゃ……？\n"
"君ってよく夜中に出歩くよね。\n"
"トイレ近いの？"
msgstr "唔喵……？你经常半夜到处走呢。是尿频吗？"

#. ID 82, Page 1, Line 2, Pos (53,26)
#. Contains choice at line 2 (2 options)
msgid "こんな夜遅くになんの用かな？"
msgstr "这么晚了有什么事吗？"

#. ID 82, Page 1, Line 3, Pos (53,26)
#. Choice (2 options, embedded in a message)
#. ID 82, Page 2, Line 6, Pos (53,26)
#. Choice (2 options, embedded in a message)
msgid ""
"夜這いに来ました\n"
"特には……"
msgstr ""
"我是来夜袭的\n"
"也没什么特别的……"

#. ID 82, Page 1, Line 6, Pos (53,26)
msgid ""
"おお、恐いねえ……\n"
"冗談言ってないで早く寝なさい。"
msgstr "哦哦，好可怕啊……别开玩笑了，快去睡吧。"

#. ID 82, Page 1, Line 11, Pos (53,26)
msgid ""
"あんまり夜更かししちゃダメだよ？\n"
"美容にも良くないしね。"
msgstr "别太熬夜哦？对美容也不好呢。"

#. ID 82, Page 2, Line 2, Pos (53,26)
msgid "はぁ……"
msgstr "唉……"

#. ID 82, Page 2, Line 5, Pos (53,26)
#. Contains choice at line 2 (2 options)
msgid "どうしたの？こんな夜更けに……"
msgstr "怎么了？这么晚了……"

#. ID 82, Page 2, Line 9, Pos (53,26)
msgid ""
"またそんな冗談……\n"
"慰めてくれてるのかな？"
msgstr "又开这种玩笑……是在安慰我吗？"

#. ID 82, Page 2, Line 12, Pos (53,26)
msgid "ありがとね。"
msgstr "谢谢啦。"

#. ID 82, Page 2, Line 16, Pos (53,26)
msgid ""
"戸締まりはしっかりしなさい。\n"
"\n"
"………私が言えたことじゃないか……"
msgstr "要把门窗锁好。………这也不是我该说的话吧……"

#. ID 82, Page 3, Line 2, Pos (53,26)
#. ID 82, Page 10, Line 2, Pos (53,26)
msgid "やあ、君か。"
msgstr "嗨，是你啊。"

#. ID 82, Page 3, Line 5, Pos (53,26)
msgid ""
"知ってると思うけど、\n"
"立て続けに事件が起こってね……"
msgstr "你可能知道，最近接连发生事件呢……"

#. ID 82, Page 3, Line 7, Pos (53,26)
msgid ""
"容疑者……というのは早計なんだけど、\n"
"エルフの姉妹が消えて………\n"
"残った妹さんの元気がないの……"
msgstr ""
"嫌疑人……这么说还太早，但精灵姐妹失踪了………\n"
"留下的妹妹也没什么精神……"

#. ID 82, Page 3, Line 11, Pos (53,26)
msgid ""
"影でいじめられてるなんて話もある。\\!\n"
"種族が違うってこともあって、前々から\n"
"よく思わない人もいたんだけど、それが\n"
"一気に表面化してきたみたいなの。"
msgstr ""
"也有传闻说她在背地里被欺负。\n"
"\\!也有种族不同这方面原因，早就有人看她不顺眼，\n"
"不过这些似乎一下子浮上表面了。"

#. ID 82, Page 3, Line 16, Pos (53,26)
msgid ""
"直接の原因が彼女にあるわけじゃないし、\n"
"彼女の姉たちが犯人って決まったわけでも\n"
"ない。"
msgstr ""
"并不是说直接原因在她身上，\n"
"也没确定她姐姐们就是犯人。"

#. ID 82, Page 3, Line 19, Pos (53,26)
msgid ""
"兵士たちもそれはわかってるはずなの。\n"
"でもね……"
msgstr "士兵们应该也明白这一点。可是呢……"

#. ID 82, Page 4, Line 2, Pos (53,26)
msgid "ふう…ここのところ、嫌な事件が続くね。"
msgstr "呼……最近净是些讨厌的事件呢。"

#. ID 82, Page 4, Line 3, Pos (53,26)
msgid ""
"ブライさん達は\n"
"過激なこと言うようになったし……\n"
"そりゃ、普段から鬱憤が溜まっているのも\n"
"わかるけどさ……"
msgstr ""
"布莱他们也开始说些过激的话了……当然，\n"
"我也明白他们平时就积攒了不少怨气……"

#. ID 82, Page 4, Line 9, Pos (53,26)
msgid ""
"やっぱり、あの子たちが犯人なのかな……\\!\n"
"見えていないのは私の方……？"
msgstr ""
"果然，还是那些孩子干的吗……\\!看不见的是我这边……\n"
"？"

#. ID 82, Page 4, Line 12, Pos (53,26)
msgid ""
"あの子たちがここに来た時……\n"
"私はまだ士官候補生だった。"
msgstr "那些孩子来这里的时候……我还只是士官候补生。"

#. ID 82, Page 4, Line 14, Pos (53,26)
msgid ""
"しかも初等部……歳の変わらない子供が\n"
"国を失って途方に暮れているのを\n"
"目の当たりにして……愕然としたっけ……"
msgstr ""
"而且还是初等部……\n"
"亲眼看到和自己年龄相仿的孩子失去国家、\n"
"茫然无措……当时我愕然了……"

#. ID 82, Page 4, Line 19, Pos (53,26)
#. Contains choice at line 2 (2 options)
msgid "\\s[2]肩入れ……してるのかな…………"
msgstr "\\s[2]我是不是……在偏袒她们呢…………"

#. ID 82, Page 4, Line 21, Pos (53,26)
#. Choice (2 options, embedded in a message)
msgid ""
"いいんじゃないですか？\n"
"知るか！そんなことより夜這いだ！"
msgstr ""
"不是挺好吗？\n"
"谁知道啊！比起那个，夜袭要紧！"

#. ID 82, Page 4, Line 24, Pos (53,26)
msgid ""
"いいの……かな？\\!\n"
"そうだよね。\n"
"隊長の私が疑ってどうするんだよね。"
msgstr ""
"可以吗……？\\!是啊。\n"
"身为队长的我怎么能怀疑她们呢。"

#. ID 82, Page 4, Line 28, Pos (53,26)
msgid "ありがと。"
msgstr "谢谢。"

#. ID 82, Page 4, Line 32, Pos (53,26)
msgid "ちょっとお！"
msgstr "喂！"

#. ID 82, Page 4, Line 35, Pos (53,26)
msgid ""
"あはは、ありがと。\n"
"ちょっと元気出たよ。"
msgstr "啊哈哈，谢谢。稍微打起精神了。"

#. ID 82, Page 4, Line 40, Pos (53,26)
msgid ""
"無言か………\\!\n"
"そうだね。これは私のこと。\n"
"事件は事件。割り切らないとね。"
msgstr ""
"沉默吗………\\!是啊。这是我的事。事件归事件。\n"
"得划清界限才行。"

#. ID 82, Page 4, Line 44, Pos (53,26)
msgid ""
"一刻も早く、犯人を挙げるのが大事。\n"
"それが……どんな結末でもね……"
msgstr "尽早抓到犯人才最重要。不管……结局会是什么样……"

#. ID 82, Page 5, Line 2, Pos (53,26)
msgid ""
"正体不明の敵が現れたのよ。\n"
"すぐに動けるよう、自室で待機しつつ\n"
"適当に休んでなさい。"
msgstr ""
"出现了身份不明的敌人。为了能立刻行动，\n"
"就在自己房间待命，顺便适当休息吧。"

#. ID 82, Page 5, Line 7, Pos (53,26)
msgid "なんてね。あなたは知ってるんだよね。"
msgstr "开玩笑的。你是知道的吧。"

#. ID 82, Page 5, Line 9, Pos (53,26)
msgid ""
"そう…………\n"
"敵襲っていうのは、ブライさんたちの\n"
"面目を守るための虚偽報告だよ。"
msgstr ""
"没错…………所谓敌袭，\n"
"是为了保住布莱他们的面子而做的虚假报告。"

#. ID 82, Page 5, Line 12, Pos (53,26)
msgid ""
"女の子を犯しに行ったら、コックに金玉を\n"
"潰されましたなんてことが公になったら\n"
"名門の面目丸潰れだからね。"
msgstr ""
"要是「去侵犯女孩，\n"
"结果被厨师捏碎了睾丸」这种事公开了，\n"
"名门的脸面就全丢光了。"

#. ID 82, Page 5, Line 17, Pos (53,26)
msgid ""
"この砦にも…いられなくなっちゃうかも。\n"
"それは、こっちとしても困るんだよ……"
msgstr ""
"可能连这个堡垒……都待不下去了。那样的话，\n"
"我们这边也很为难……"

#. ID 82, Page 5, Line 20, Pos (53,26)
msgid ""
"辛い思いをさせたあなたにこう言うのも\n"
"心苦しいんだけど……お願い、このことは\n"
"どうか内密にしていて……"
msgstr ""
"让你痛苦了，还对你说这种话，我也很不好受……\n"
"拜托了，这件事请务必保密……"

#. ID 82, Page 6, Line 2, Pos (53,26)
msgid "あっは。君か……"
msgstr "啊哈。是你啊……"

#. ID 82, Page 6, Line 5, Pos (53,26)
msgid ""
"いや、ごめんごめん。ちょっと……\n"
"張りつめていたのが切れちゃった。\n"
"普段はあんまり飲まないんだけどね……"
msgstr ""
"不，抱歉抱歉。只是……一直紧绷的弦断了。\n"
"我平时不太喝酒的……"

#. ID 82, Page 6, Line 10, Pos (53,26)
#. Contains choice at line 2 (2 options)
msgid "ねえ……ちょっと愚痴を聞いてもらえる？"
msgstr "喂……能听我稍微抱怨一下吗？"

#. ID 82, Page 6, Line 14, Pos (53,26)
msgid ""
"ありがと。あんまり………部下にも聞いて\n"
"ほしくないことだからさ……"
msgstr "谢谢。因为这事不太………不想让部下听到……"

#. ID 82, Page 6, Line 18, Pos (53,26)
msgid ""
"料理長のこと……\n"
"君は真実を知ってるんだよね……？"
msgstr "厨师长的事……你知道真相吧……？"

#. ID 82, Page 6, Line 22, Pos (53,26)
msgid ""
"いや……言わなくてもいいよ。なんとなく\n"
"分かってるから……"
msgstr "不……不用说了。我大概明白……"

#. ID 82, Page 6, Line 26, Pos (53,26)
msgid ""
"ブライさんたちも料理長も……\n"
"なんていうか……やっちゃったね……"
msgstr "布莱他们和厨师长都……该怎么说呢……搞砸了呢……"

#. ID 82, Page 6, Line 28, Pos (53,26)
msgid ""
"昔から、ブライさんたちとのいざこざは\n"
"度々あったらしいの。それが少しずつ蓄積\n"
"していって……今回爆発しちゃった………"
msgstr ""
"听说从以前起，和布莱他们之间的摩擦就时有发生。\n"
"那些一点点积累起来……这次爆发了………"

#. ID 82, Page 6, Line 32, Pos (53,26)
msgid ""
"でも…一番溜め込んでるのは多分所長ね。\n"
"知ってるかもしれないけど、\n"
"所長って王子様なの。"
msgstr ""
"不过……积压最多的大概是所长吧。你也许知道，\n"
"所长是王子殿下。"

#. ID 82, Page 6, Line 35, Pos (53,26)
msgid ""
"王族気分でやってる…なんて言わないよ。\n"
"もちろんそのプライドもあると思うけど…\n"
"ブライさん達と他の兵士との間を取り持つ\n"
"のに神経を使い過ぎてる感じ。"
msgstr ""
"我不会说他是在摆王族架子……\n"
"当然我觉得他也有那份自尊……\n"
"只是感觉他在调和布莱他们和其他士兵之间太费神了\n"
"。"

#. ID 82, Page 6, Line 39, Pos (53,26)
msgid ""
"元々疑り深い人だったけど……\n"
"内部の不祥事に最近は本当に………\n"
"もう何も信じられなくなってる。"
msgstr ""
"他本来就很多疑……最近又碰上内部丑闻，真的是………\n"
"已经什么都不相信了。"

#. ID 82, Page 6, Line 42, Pos (53,26)
msgid ""
"信じていないのはブライさんたちも同じ。\n"
"それはもう昔からなんだけど…"
msgstr "布莱他们那边也一样不信任。这从以前就是这样了……"

#. ID 82, Page 6, Line 45, Pos (53,26)
msgid ""
"もし完全に決裂してしまったら……\n"
"私は多分崩壊を止められない。"
msgstr "如果彻底决裂了……我大概阻止不了崩溃。"

#. ID 82, Page 6, Line 47, Pos (53,26)
msgid "私も…どうしたらいいかわかんないの……"
msgstr "我也……不知道该怎么办……"

#. ID 82, Page 6, Line 49, Pos (53,26)
msgid ""
"私は……どうすればいいの……？\n"
"何を信じればいいの……？"
msgstr "我……该怎么做……？该相信什么才好……？"

#. ID 82, Page 6, Line 53, Pos (53,26)
msgid ""
"明日から……軍曹が遠征に行く……\n"
"ブライさんたちとまともに言い合えるのは\n"
"もう私くらい……"
msgstr ""
"从明天起……军曹要去远征……\n"
"能和布莱他们正经理论的人已经只剩我了吧……"

#. ID 82, Page 6, Line 56, Pos (53,26)
msgid "私が……なんとかしないと…………"
msgstr "我……得想办法才行…………"

#. ID 82, Page 6, Line 61, Pos (53,26)
msgid ""
"そっか……ううん。\n"
"ごめんね。こんな隊長で。"
msgstr "这样啊……不。抱歉，摊上我这样的队长。"

#. ID 82, Page 7, Line 2, Pos (53,26)
msgid "この砦は一枚岩じゃないのよねぇ…"
msgstr "这个堡垒并不是铁板一块呢……"

#. ID 82, Page 7, Line 4, Pos (53,26)
msgid ""
"やっぱ私がトップに立つしかないかなぁ…\n"
"所長には悪いけどさ。"
msgstr ""
"果然只能由我来当一把手了吧……\n"
"虽然对所长有点过意不去。"

#. ID 82, Page 7, Line 8, Pos (53,26)
msgid ""
"……なんていうのが\n"
"冗談になっちゃうのが問題よね。\n"
"私が隊長、ブライさん達は、筆頭ですら\n"
"ご意見番ってことになってるんだから。"
msgstr ""
"……可这话会变成玩笑，才是问题呢。我是队长，\n"
"布莱他们那边，连首席都成了专提意见的人。"

#. ID 82, Page 8, Line 2, Pos (53,26)
#. ID 82, Page 8, Line 13, Pos (53,26)
msgid "\\s[2]うつら……うつら……"
msgstr "\\s[2]迷迷糊糊……迷迷糊糊……"

#. ID 82, Page 8, Line 5, Pos (53,26)
msgid ""
"……あれ？\n"
"いつの間に……？"
msgstr "……咦？不知不觉间……？"

#. ID 82, Page 8, Line 8, Pos (53,26)
msgid ""
"いけないいけない…部屋に入られたのにも\n"
"気づかないなんて。\n"
"気が抜けてるのかも……"
msgstr ""
"不行不行……连有人进房间都没注意到。\n"
"我可能太松懈了……"

#. ID 82, Page 9, Line 2, Pos (53,26)
msgid "まさか……こんなことになるなんて………"
msgstr "没想到……竟然会变成这样………"

#. ID 82, Page 9, Line 4, Pos (53,26)
msgid ""
"王族ってのはなんでこうなのかな……\n"
"兄弟で命の取り合い、足の引っ張り合い…"
msgstr ""
"王族为什么会这样呢……兄弟之间互相夺命、\n"
"互相扯后腿…"

#. ID 82, Page 9, Line 7, Pos (53,26)
msgid ""
"ブライさんたち…本当に所長の命を狙って\n"
"たのかな……？\n"
"だって…普通無理だよ。王子が暗殺された\n"
"部署から栄転するなんて。"
msgstr ""
"布莱他们……真的想要所长的命吗……？因为……\n"
"一般来说不可能啊。\n"
"从王子被暗杀的部门还能高升什么的。"

#. ID 82, Page 9, Line 11, Pos (53,26)
msgid ""
"あの人たち、確かに粗暴で短絡的な所ある\n"
"けど……名誉にはとっても敏感だったし。"
msgstr ""
"那些人确实有粗暴和短视的地方……\n"
"但对名誉非常敏感。"

#. ID 82, Page 9, Line 13, Pos (53,26)
msgid ""
"でも、あの手紙はなんなんだろう…………\n"
"珍しく深酒してしまった筆頭………誰かに\n"
"罪をなすりつけられた……？"
msgstr ""
"但是，那封信到底是什么呢…………\n"
"少有地喝多了的头领………被人栽赃了……？"

#. ID 82, Page 9, Line 16, Pos (53,26)
msgid ""
"そう言えば、ブライさんたち、\n"
"1人だけ行方不明になってる……"
msgstr "说起来，布莱先生他们那边，有一个人下落不明……"

#. ID 82, Page 9, Line 19, Pos (53,26)
msgid ""
"彼女を見つけて……事情を聞いてみるのが\n"
"いいかもしれないな……"
msgstr "找到她……问问情况可能会比较好……"

#. ID 82, Page 9, Line 22, Pos (53,26)
msgid "でも…こんな時に人員は割けないし………"
msgstr "但是…这种时候抽不出人手啊………"

#. ID 82, Page 10, Line 5, Pos (53,26)
msgid ""
"兵士が足りない上に指揮を執れる人が\n"
"ほとんどいないんだよ。これは…ちょっと\n"
"まずいね。"
msgstr "士兵不足，而且几乎没人能指挥。这……有点不妙啊。"

#. ID 82, Page 10, Line 9, Pos (53,26)
msgid ""
"君、できるなら一週間くらいここに詰めて\n"
"いてくれないかな。少しでも戦力が欲しい\n"
"んだ。"
msgstr ""
"你，如果可以的话，能不能在这里驻守一周左右。\n"
"哪怕多一点战力也好。"

#. ID 82, Page 10, Line 13, Pos (53,26)
msgid ""
"何もないといいんだけど……\n"
"まあ……こんな片田舎、普通なら何もない\n"
"んだけどね。"
msgstr ""
"要是什么都不发生就好了……嘛……这种乡下地方，\n"
"一般来说什么都不会有。"

#. ID 82, Page 10, Line 18, Pos (53,26)
msgid ""
"逆に言うなら……何かあった場合…………\n"
"「この地」を…この隙を突いてくるような\n"
"輩が相手だった場合………"
msgstr ""
"反过来说……万一发生什么…………\n"
"如果对手是那种会趁这个空隙袭击「此地」的家伙……\n"
"…"

#. ID 82, Page 10, Line 22, Pos (53,26)
msgid ""
"普通なら、私は総員撤退を指示しなくては\n"
"いけない戦力…でも……"
msgstr ""
"正常情况下，以这种战力，我本应下令全员撤退……\n"
"但是……"

#. ID 82, Page 10, Line 25, Pos (53,26)
msgid ""
"これは、本当に最悪のシナリオだけど……\n"
"君、いざとなったら玉砕を覚悟してもらう\n"
"ことになるかもしれない。"
msgstr ""
"这真是最糟糕的情况……你，万一到了那一步，\n"
"或许得做好玉碎的觉悟。"

#. ID 82, Page 10, Line 28, Pos (53,26)
msgid ""
"悪いとは思ってるよ。\n"
"せめて………私は一足先に行くことで弁解\n"
"とさせて………"
msgstr "我觉得很抱歉。至少………让我先走一步作为辩解吧………"

#. ID 82, Page 11, Line 3, Pos (53,26)
msgid ""
"こんばんは。君はいつも元気だね。\n"
"こっちまで勇気が湧いてくるよ。"
msgstr "晚上好。你总是很有精神呢。连我都涌起勇气了。"

#. ID 82, Page 11, Line 6, Pos (53,26)
#. Contains choice at line 2 (2 options)
msgid "で、今度はどうしたの？"
msgstr "那么，这次又怎么了？"

#. ID 82, Page 11, Line 8, Pos (53,26)
#. Choice (2 options, embedded in a message)
msgid ""
"夜這いに来ました\n"
"いえ、特には"
msgstr ""
"我是来钻被窝的\n"
"不，没什么特别的"

#. ID 82, Page 11, Line 12, Pos (53,26)
#. Contains choice at line 2 (2 options)
msgid "また君は……そんな冗談ばっかりだね。"
msgstr "你又来了……老是开这种玩笑。"

#. ID 82, Page 11, Line 14, Pos (53,26)
#. Choice (2 options, embedded in a message)
msgid ""
"へっへっへ…今度は本気です\n"
"女同士じゃダメですか？"
msgstr ""
"嘿嘿嘿……这次我是认真的\n"
"女人之间不行吗？"

#. ID 82, Page 11, Line 17, Pos (53,26)
msgid ""
"へぇ……そんなに私が欲しいのかな？\n"
"男の子にも\n"
"そんなこと言われたことないよ。"
msgstr ""
"哦……就那么想要我吗？\n"
"连男孩子都没对我说过这种话哦。"

#. ID 82, Page 11, Line 23, Pos (53,26)
msgid ""
"あはは…\n"
"むさい男とよりも君みたいな娘との方が\n"
"いいかも。"
msgstr ""
"啊哈哈……比起粗野的男人，\n"
"也许像你这样的女孩更好呢。"

#. ID 82, Page 11, Line 28, Pos (53,26)
msgid "お上手ねぇ。ありがと。"
msgstr "真会说话呢。谢谢。"

#. ID 82, Page 11, Line 35, Pos (53,26)
msgid ""
"はふ………\n"
"…………いやいや、いけないいけない……"
msgstr "哈呼…………………不不，不行不行……"

#. ID 82, Page 11, Line 43, Pos (53,26)
#. Contains choice at line 3 (2 options)
msgid ""
"\\s[2]う……ごめん、ちょっと……独りにして\n"
"……くれないかな？"
msgstr "\\s[2]嗯……抱歉，能不能……让我一个人待一会儿……？"

#. ID 82, Page 11, Line 46, Pos (53,26)
#. Choice (2 options, embedded in a message)
msgid ""
"いっしょに楽しみましょうよ\n"
"おや、自分を慰めるのですか？"
msgstr ""
"一起快乐吧\n"
"哦呀，是要自慰吗？"

#. ID 82, Page 11, Line 49, Pos (53,26)
msgid ""
"お願い……そんなこと……言わないで……\n"
"私……負けちゃうかも………"
msgstr "拜托……别……说那种话……我……可能会输掉……"

#. ID 82, Page 11, Line 51, Pos (53,26)
msgid ""
"こんな時に……いけないよ…………\n"
"私……しっかりしなきゃいけないのに……"
msgstr "这种时候……不行的…………我……明明必须振作起来……"

#. ID 82, Page 11, Line 56, Pos (53,26)
msgid "そんなんじゃない！！"
msgstr "不是那样的！！"

#. ID 82, Page 11, Line 63, Pos (53,26)
msgid ""
"き……君は……ひ……ひょっとして………\n"
"けっこう本気で…欲求不満なのかな……？"
msgstr "你……你……难……难道………相当认真地…欲求不满吗……？"

#. ID 82, Page 11, Line 71, Pos (53,26)
msgid ""
"ちょっと…ダメだよ……\n"
"やめ……"
msgstr "等等…不行啊……住手……"

#. ID 82, Page 11, Line 86, Pos (53,26)
msgid "いや！軍服……脱がさないで………"
msgstr "不要！别脱……我的军服………"

#. ID 82, Page 11, Line 95, Pos (53,26)
msgid ""
"もう、やめて……\n"
"私……負けそう……"
msgstr "够了，住手……我……快要输了……"

#. ID 82, Page 11, Line 121, Pos (53,26)
msgid "い……いやああああああああああああ！！"
msgstr "不……不要啊啊啊啊啊啊啊啊啊啊啊！！"

#. ID 82, Page 11, Line 133, Pos (53,26)
msgid ""
"\\s[2]ふ……ふふ……\n"
"や…………やってしまいました……………"
msgstr "\\s[2]呼……呵呵……还…………还是做了……………"

#. ID 82, Page 11, Line 145, Pos (53,26)
msgid "と……とんだ粗相を…………"
msgstr "真……真是失态…………"

#. ID 82, Page 11, Line 148, Pos (53,26)
msgid "ごめん……ちょっと…………休むよ………"
msgstr "抱歉……我稍微…………休息一下………"

#. ID 82, Page 11, Line 152, Pos (53,26)
msgid ""
"あんまり女の子の部屋に無断で入っちゃ\n"
"だめだよ？女の部屋に入ったら殺されても\n"
"文句は言えないって誰かが言ってたわ。"
msgstr ""
"不可以随便闯入女孩子的房间哦？有人说过，\n"
"进了女人的房间，就算被杀也不能抱怨。"

#. ID 82, Page 11, Line 160, Pos (53,26)
msgid ""
"すぐに兵士の補充もできると思うんだけど\n"
"ちょっと心許ないね。"
msgstr ""
"我想马上也能补充士兵，\n"
"不过还是有点让人不放心呢。"

#. ID 82, Page 11, Line 164, Pos (53,26)
msgid ""
"なんでこうなっちゃったんだろ……\n"
"まぁ…何もないとは思うんだけど……"
msgstr ""
"为什么会变成这样呢……嘛…虽然我觉得不会有什么事…\n"
"…"

#. ID 82, Page 11, Line 167, Pos (53,26)
msgid ""
"所長にはちょっと冷静になってもらって…\n"
"王子との内紛は絶対に阻止しないと………"
msgstr ""
"得让所长稍微冷静一下……\n"
"和王子之间的内讧绝对要阻止………"

#. ID 82, Page 11, Line 170, Pos (53,26)
msgid ""
"でも…私の口を挟める次元の話じゃないの\n"
"よね……。最大の敵が兄弟だなんて………\n"
"せめて、所長を守ることくらいしか私には\n"
"できないな……"
msgstr ""
"但是……这不是我能插嘴的层面的事呢……。\n"
"最大的敌人竟然是兄弟………至少，\n"
"我能做的也只有保护所长了……"

#. ID 83, Page 1, Line 1, Pos (109,7)
msgid ""
"ほら、大人しくしな……\n"
"お前の態度によっちゃ\n"
"命だけは助けてやらんでもないぜ……ひひ……"
msgstr ""
"喂，乖乖听话……看你的态度，\n"
"我也不是不能只饶你一命……嘻嘻……"

#. ID 83, Page 2, Line 1, Pos (109,7)
msgid "汎用とか言うなあ！！"
msgstr "别说什么泛用啊！！"

#. ID 84, Page 1, Line 2, Pos (54,12)
msgid ""
"た……隊長が…………\n"
"あんなにボロボロに………"
msgstr "队……队长…………竟然被打得那么惨………"

#. ID 84, Page 1, Line 4, Pos (54,12)
msgid "くそ……隊長は……私が…………"
msgstr "可恶……队长……由我来…………"

#. ID 85, Page 1, Line 1, Pos (79,11)
msgid ""
"へへ……\n"
"難攻不落のゲスラ砦の魔道士がこの程度とはな！！"
msgstr ""
"嘿嘿……\n"
"难攻不落的盖斯拉要塞的魔道士就这点程度吗！！"

#. ID 86, Page 1, Line 1, Pos (81,11)
msgid ""
"女は犯してから殺せだとよ！！\n"
"プライドもモラルもあったもんじゃねえな、最高だぜ！"
msgstr "说女人就先奸后杀！！既没自尊也没道德，太棒了！"

#. ID 86, Page 2, Line 1, Pos (81,11)
msgid ""
"おいあんた！\n"
"気を確かに持ちな……！"
msgstr "喂，你！振作点……！"

#. ID 87, Page 1, Line 1, Pos (42,12)
msgid ""
"ここらへんは宿舎になっているのか。\n"
"どこかに隠れている奴がいるかもしれんな。"
msgstr "这一带是宿舍吗。说不定哪里藏着人。"

#. ID 87, Page 2, Line 1, Pos (42,12)
msgid "やっぱり戦はこうでなくてはな。"
msgstr "果然战争就该是这样啊。"

#. ID 88, Page 1, Line 1, Pos (31,12)
msgid ""
"しかし皆殺しにしろとは……\n"
"同じ兵士として胸が痛まないと言ったら嘘になるな。"
msgstr ""
"不过，竟然要全部杀光……作为同样的士兵，\n"
"要说心里不痛那是骗人的。"

#. ID 88, Page 2, Line 1, Pos (31,12)
msgid ""
"軍曹の部隊だと……！？\n"
"は……話が違う………！！"
msgstr "军曹的部队……！？什……和说好的不一样………！！"

#. ID 89, Page 1, Line 1, Pos (59,13)
msgid ""
"あのゲスラ砦が、奴ら不在の隙をついたとはいえ\n"
"こうもたやすく落ちるとはな。\n"
"ちょっと幻滅だぜ。"
msgstr ""
"那座盖斯拉要塞，虽说是趁他们不在的空隙，\n"
"居然这么轻易就陷落了。有点让人失望啊。"

#. ID 89, Page 2, Line 1, Pos (59,13)
msgid "軍曹指揮下の精鋭か、面白い！！"
msgstr "军曹指挥下的精锐吗，有意思！！"

#. ID 90, Page 1, Line 1, Pos (7,10)
msgid "なんだお前、ここの兵士か？"
msgstr "什么啊你这家伙，是这里的士兵吗？"

#. ID 90, Page 2, Line 1, Pos (7,10)
msgid ""
"押されている？\n"
"し……指揮官……指示をくれ！！"
msgstr "被压制了？指……指挥官……请下指示！！"

#. ID 91, Page 1, Line 1, Pos (50,26)
msgid "質素な部屋だ。下っ端が使ってたんだろうな。"
msgstr "朴素的房间。应该是底层的人用的吧。"

#. ID 91, Page 2, Line 1, Pos (50,26)
msgid ""
"どうやらここは隊長の部屋らしい。\n"
"なんでわかったかって…？\n"
"ムフフ……"
msgstr ""
"看来这里好像是队长的房间。你问为什么知道……？\n"
"嗯呵呵……"

#. ID 92, Page 1, Line 1, Pos (111,46)
#. ID 96, Page 1, Line 1, Pos (5,47)
msgid ""
"臭う……臭うぞ……女人の部屋だ！！\n"
"\n"
"……うっ"
msgstr "有味道……有味道啊……是女人的房间！！……呃"

#. ID 92, Page 2, Line 1, Pos (111,46)
msgid "ぬ……抜きすぎて力がでねえ……"
msgstr "唔……撸太多了没力气……"

#. ID 93, Page 1, Line 1, Pos (91,27)
msgid ""
"部屋がところどころ傷んでいるな。\n"
"相当情緒不安定な人間が使っているんだろう。"
msgstr ""
"房间到处都有损坏啊。\n"
"应该是相当情绪不稳定的人在用吧。"

#. ID 94, Page 1, Line 1, Pos (73,26)
msgid "夜盗を装えってことだからな。泥棒もするさ。"
msgstr "因为说是要装成夜盗嘛。偷东西也会做啦。"

#. ID 94, Page 2, Line 1, Pos (73,26)
msgid "なんだ？まだ敵が残っていたのか？"
msgstr "什么？还有敌人残留吗？"

#. ID 95, Page 1, Line 1, Pos (74,36)
msgid "ここはブライ一門の部屋か。なんもねえな。"
msgstr "这里是布莱一门的房间吗。什么都没有啊。"

#. ID 95, Page 2, Line 1, Pos (74,36)
msgid ""
"騒がしいな……\n"
"まだ生き残りがいたのか？"
msgstr "真吵啊……还有幸存者吗？"

#. ID 96, Page 1, Line 11, Pos (5,47)
msgid ""
"……でもどうしよう。\n"
"もし違ったら、俺は野郎の部屋の臭いで抜いた\n"
"ヤロウスメルファッカーとして一生十字架を背負って\n"
"いくことに……"
msgstr ""
"……但怎么办呢。如果弄错了，\n"
"我可就要作为闻着男人房间味道撸管的男味操蛋鬼，\n"
"一辈子背负十字架了……"

#. ID 97, Page 1, Line 1, Pos (114,13)
msgid ""
"ふん、この充実した装備も活かされないまま墜ちたと\n"
"いうわけか。"
msgstr "哼，这么充足的装备也没能派上用场就陷落了吗。"

#. ID 184, Page 1, Line 1, Pos (5,6)
msgid ""
"残虐な夜盗に徹しろってさ！\n"
"ヒャッハー！！"
msgstr "说是要彻底扮成残暴的夜盗！呀哈—！！"

#. ID 207, Page 1, Line 1, Pos (111,45)
msgid "な…ナニやってんだコイツ……"
msgstr "这……这家伙在干什么……"

#. ID 240, Page 1, Line 1, Pos (72,11)
msgid ""
"ここ、前任が立てこもってて開かないんですよねえ。\n"
"困ったなぁ。"
msgstr "这里，前任据守着打不开呢。真头疼啊。"
