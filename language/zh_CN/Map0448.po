msgstr "…………"

#. ID 4, Page 1, Line 3, Pos (5,6)
msgid ""
"いらっしゃい。\n"
"ゆっくりしていきな。"
msgstr "欢迎光临。慢慢来。"

#. ID 4, Page 2, Line 3, Pos (5,6)
msgid ""
"奴隷はさっさと出て行けよ。\n"
"それとも客に殴られにでも来たのか？"
msgstr "奴隶赶紧滚出去。还是说你是来挨客人揍的？"

#. ID 5, Page 1, Line 3, Pos (4,11)
msgid "今回の売れ行きはあまり良くなかったな……"
msgstr "这次的销路不太好啊……"

#. ID 6, Page 1, Line 3, Pos (27,10)
msgid "……俺はこの店の用心棒だ。"
msgstr "……我是这家店的保镖。"

#. ID 6, Page 1, Line 4, Pos (27,10)
msgid "あまり話しかけるな。"
msgstr "别太跟我搭话。"

#. ID 7, Page 1, Line 3, Pos (16,8)
msgid "いらっしゃいませ。"
msgstr "欢迎光临。"

#. ID 7, Page 2, Line 3, Pos (16,8)
#. ID 12, Page 2, Line 3, Pos (27,6)
msgid "奴隷はお引き取りください。"
msgstr "奴隶请回吧。"

#. ID 8, Page 1, Line 3, Pos (1,9)
msgid "金貨１枚でしゃぶってあげてもいいわよ……"
msgstr "一枚金币的话我可以给你舔哦……"

#. ID 8, Page 1, Line 5, Pos (1,9)
msgid "なら、もっと近くにきてちょうだい"
msgstr "那就再靠近一点吧。"

#. ID 8, Page 1, Line 10, Pos (1,9)
msgid "…って、あら、女性だったのね。"
msgstr "……咦，哎呀，原来是女性啊。"

#. ID 8, Page 1, Line 17, Pos (1,9)
#. Choice (2 options)
msgid ""
"責:や　ら　な　い　か(未実装)\n"
"攻:これが私のドミナントだ"
msgstr ""
"责:要　不　要　做(未实装)\n"
"攻:这就是我的支配"

#. ID 8, Page 1, Line 22, Pos (1,9)
msgid "よく見ておくんだな！"
msgstr "好好看着吧！"

#. ID 8, Page 1, Line 36, Pos (1,9)
msgid "ヒッ……！"
msgstr "咿……！"

#. ID 8, Page 1, Line 53, Pos (1,9)
msgid "え…？な、なんであなた…女の子じゃ…"
msgstr "诶…？为、为什么你…不是女孩子吗…"

#. ID 8, Page 1, Line 68, Pos (1,9)
msgid ""
"\\n[\\v[6]]はそそり立つ男根を扱きながら\n"
"ゆっくりと近づいた"
msgstr ""
"\\n[\\v[6]]一边套弄着勃起的阴茎，\n"
"一边缓缓靠近了。"

#. ID 8, Page 1, Line 84, Pos (1,9)
msgid "いや！来ないでっ！！"
msgstr "不要！别过来！！"

#. ID 8, Page 1, Line 99, Pos (1,9)
msgid ""
"女は\\n[\\v[6]]を振り解こうと暴れるが、か細い腕では\n"
"到底かなう筈もなく、ただただ\\n[\\v[6]]の劣情を刺激\n"
"するだけだった"
msgstr ""
"女人为了甩开\\n[\\v[6]]而挣扎，\n"
"但凭那纤细的手臂根本无法抗衡，\n"
"只会徒然刺激\\n[\\v[6]]的劣情。"

#. ID 8, Page 1, Line 103, Pos (1,9)
msgid "\\S[2]嫌ッ！イヤアアァアァァァァッッッッ！！"
msgstr "\\S[2]讨厌！不要啊啊啊啊啊啊啊啊！！！！"

#. ID 8, Page 1, Line 114, Pos (1,9)
msgid "んグゥ！？"
msgstr "唔咕！？"

#. ID 8, Page 1, Line 118, Pos (1,9)
msgid "\\S[2]んぶぅっ…！？　んっ…んがぅっ…！"
msgstr "\\S[2]唔噗…！？　唔…唔嘎…！"

#. ID 8, Page 1, Line 124, Pos (1,9)
msgid "\\S[2]ぐ…びちゅっ……んん！！……ふぁっ…"
msgstr "\\S[2]咕…噗啾……唔唔！！……哈啊…"

#. ID 8, Page 1, Line 128, Pos (1,9)
msgid "\\S[2]オゴッ…ぐ…ん…ぐぁ……ん！！！！？？？"
msgstr "\\S[2]呕咕…咕…唔…咕啊……唔！！！！？？？"

#. ID 8, Page 1, Line 143, Pos (1,9)
msgid "\\S[2]ンフゥンンンンン！！！！！"
msgstr "\\S[2]唔嗯嗯嗯嗯嗯！！！！！"

#. ID 8, Page 1, Line 149, Pos (1,9)
msgid ""
"\\S[2]ぐぷっ！？　んっ、んぐっ…！？　ぷはぁっ…\n"
"\n"
"\n"
"グッ！！！ゲホッゲホ！！！！"
msgstr ""
"\\S[2]咕噗！？　唔、唔咕…！？　噗哈…咕！！！\n"
"咳哈咳哈！！！！"

#. ID 8, Page 1, Line 153, Pos (1,9)
msgid "\\S[2]はぁっ、はぁっ…は、…っ…んっ"
msgstr "\\S[2]哈啊、哈啊…哈、…唔…"

#. ID 8, Page 1, Line 154, Pos (1,9)
msgid "\\S[2]ぐ…こん…な…"
msgstr "\\S[2]咕…这…样…"

#. ID 8, Page 1, Line 156, Pos (1,9)
msgid ""
"まぁだぁ全然足りないのぉ$k$k\n"
"思ぉいっきりぃ出してあげるからぁ$k$k\n"
"狂っちゃうくらい気持ちよぉくなってぇ$k$k$k$k"
msgstr ""
"还~远~远不够哦~$k$k我会让你狠狠地射出来~$k$k舒\n"
"服到要疯掉哦~$k$k$k$k"

#. ID 8, Page 1, Line 164, Pos (1,9)
msgid "\\S[2]え……？い、いや！！やめてぇぇぇぇっぇ！！！！"
msgstr "\\S[2]诶……？不、不要！！住手啊啊啊啊啊！！！！"

#. ID 8, Page 1, Line 169, Pos (1,9)
msgid ""
"\\S[2]女に…グッ…犯されるなんて…んぁ…あり…\n"
"……えな…ヒゥゥゥンッッ！！！！"
msgstr ""
"\\S[2]被女人…咕…侵犯什么的…唔啊…不可能………有的…\n"
"呜啊啊啊嗯！！！！"

#. ID 8, Page 1, Line 174, Pos (1,9)
msgid ""
"\\S[2]見られてる…私が…女の子に犯されて…\n"
"こんなのおかしいのに気持ちよくなってるところ…\n"
"みんなに見られてる…$s"
msgstr ""
"\\S[2]被看着…我…被女孩子侵犯…\n"
"明明这样很奇怪却感觉舒服的地方…被大家看着…$s"

#. ID 8, Page 1, Line 180, Pos (1,9)
msgid ""
"\\S[2]あっ、んあぁぁぁんっ…お願いだからっ…\n"
"見ないでぇぇっ$gんんぅっ…ダメなのっ…\n"
"ああぁぁっ…ひうぅぅぅっ…んあぁぁぁんっ！$g"
msgstr ""
"\\S[2]啊、嗯啊啊啊啊…求求你了…别看啊啊$g唔唔…\n"
"不行啊…啊啊啊啊…咿呜呜呜呜…嗯啊啊啊啊！$g"

#. ID 8, Page 1, Line 199, Pos (1,9)
msgid ""
"\\s[1]なに？なかれぇ…おおきくなっれるぅ$g…やめへぇ$g\n"
"ださないれ$gなからしらめなのぉ…$g\n"
"\n"
"\\s[2]なかれらしちゃらめなのほぉぉぉ$g"
msgstr ""
"\\s[1]什么？不要啊…变得好大了$g…\n"
"停下啊$g不要拿出来$g不要让我变成那样…\n"
"$g\\s[2]不要那样做啦不行啦呜嗬啊啊$g"

#. ID 8, Page 1, Line 218, Pos (1,9)
msgid "\\S[2]んほぉぉぉぉぉぉぉっっっっ！！！"
msgstr "\\S[2]嗯嗬啊啊啊啊啊啊啊啊！！！"

#. ID 8, Page 1, Line 222, Pos (1,9)
msgid ""
"\\S[2]しきゅう$g$gもう$gせいえきでいっぱぁい$g\n"
"らめぇ$gはいらにゃいにょぉぉぉぉ$g$g$g$g"
msgstr ""
"\\S[2]子宫$g$g已经$g被精液灌满啦$g不行了$g不要\n"
"进来呀啊啊啊啊$g$g$g$g"

#. ID 8, Page 1, Line 227, Pos (1,9)
msgid ""
"\\S[1]…お願いだからっ$g…もう許してぇぇぇ$g…\n"
"ふあぁぁぁっ…壊れちゃうっ$sんあぁぁっ…\n"
"ワタシの子宮っ…本当に…壊れちゃうのぉぉぉっ！\n"
"…ひやぁぁぁぁんっ！！$g$g$g$g$g"
msgstr ""
"\\S[1]…求求你了$g…已经饶了我吧$g…呼啊啊啊…\n"
"要坏掉了$s嗯啊啊…我的子宫…真的…要坏掉了啊！…\n"
"呀啊啊啊啊！！$g$g$g$g$g"

#. ID 8, Page 1, Line 237, Pos (1,9)
msgid ""
"\\S[2]んひぃぃぃぃ$k$kまだぁでりゅぅぅぅ$k$k\n"
"ぜんぶ、ぜぇんぶぅのんでぇぇぇえ！$k$k$k\\\n"
msgstr ""
"\\S[2]嗯嘻啊啊啊啊$k$k还在出来呀$k$k全部、\n"
"全部都喝下去啊啊啊！$k$k$k\\"

#. ID 8, Page 1, Line 251, Pos (1,9)
msgid "う……ぁ…"
msgstr "呜……啊…"

#. ID 8, Page 2, Line 5, Pos (1,9)
msgid "もう…なか…しゃせい…いやぁ……"
msgstr "已经…里面…射精…不要啊……"

#. ID 8, Page 2, Line 6, Pos (1,9)
msgid "股間からは精液が溢れている"
msgstr "精液从胯间溢了出来"

#. ID 8, Page 2, Line 10, Pos (1,9)
msgid "んっ……ふぅ……"
msgstr "嗯……呼……"

#. ID 8, Page 2, Line 14, Pos (1,9)
msgid "喋る事すら出来ないようだ"
msgstr "看来连说话都做不到"

#. ID 9, Page 1, Line 3, Pos (23,6)
msgid ""
"ここは結構犯罪者が集まってくるんだが……\n"
"中でも酒場は一番揉め事がおきやすいんだぜ。"
msgstr ""
"这里会聚集不少罪犯……\n"
"不过其中酒馆最容易闹出乱子啊。"

#. ID 10, Page 1, Line 3, Pos (7,9)
msgid "そこの反対側の席に座ってる奴は奴隷なんだ"
msgstr "坐在那边对面座位上的家伙是奴隶。"

#. ID 10, Page 1, Line 4, Pos (7,9)
msgid ""
"何で酒場に奴隷が……と思ったら\n"
"ここのマスターの奴隷だったんだな"
msgstr ""
"我还在想为什么酒馆里会有奴隶……\n"
"原来是这里老板的奴隶啊。"

#. ID 10, Page 1, Line 6, Pos (7,9)
msgid ""
"小遣い稼ぎ用の有料便器だそうだ\n"
"……仮にも飲食するところに\n"
"そんなもん置くなよな……"
msgstr ""
"听说是用来赚零花钱的收费便器……\n"
"再怎么说也不该把这种东西放在饮食场所吧……"

#. ID 11, Page 1, Line 3, Pos (16,5)
msgid "よう、何か用か？"
msgstr "哟，有什么事吗？"

#. ID 13, Page 1, Line 4, Pos (10,9)
msgid ""
"本当は自分で探しに行きたいんですが、\n"
"私に姉ほどの力はありません。\n"
"どうか、よろしくお願いいたします。"
msgstr ""
"其实我想自己去找，但我没有姐姐那样的力量。\n"
"拜托您了。"

#. ID 13, Page 1, Line 10, Pos (10,9)
msgid ""
"私の姉は冒険者なんですが、ここから南東の洞窟に\n"
"調査に行ったきり帰ってこないんです。\n"
"報酬は払うので、探しに行っていただけませんか？"
msgstr ""
"我的姐姐是冒险者，\n"
"但她去从这里东南边的洞窟调查之后就再也没回来。\n"
"我会支付报酬，能请您去找找她吗？"

#. ID 13, Page 1, Line 13, Pos (10,9)
#. Choice (2 options)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 13, Page 1, Line 15, Pos (10,9)
msgid ""
"ありがとうございます！\n"
"姉は私と同じペンダントを持っているので、\n"
"尋ねればわかると思います！"
msgstr ""
"非常感谢！姐姐和我戴着同样的吊坠，\n"
"所以问一下应该就能知道！"

#. ID 13, Page 1, Line 21, Pos (10,9)
msgid "◆蠢く洞窟　の情報を得た！"
msgstr "◆获得了 蠢动洞窟 的情报！"

#. ID 13, Page 2, Line 4, Pos (10,9)
msgid ""
"このペンダントは……！\n"
"お、お姉ちゃんはどうしたんですか！？"
msgstr "这个吊坠是……！姐、姐姐怎么了！？"

#. ID 13, Page 2, Line 11, Pos (10,9)
msgid ""
"そうですか……。人を飲み込む生きた洞窟……。\n"
"きっと姉は食べられてしまったんですね。"
msgstr ""
"这样啊……。吞人的活洞窟……。\n"
"姐姐一定是被吃掉了呢。"

#. ID 13, Page 2, Line 13, Pos (10,9)
msgid ""
"あなたが生きて帰ってきてくれてよかったです。\n"
"お礼を受け取ってください。"
msgstr "你能活着回来真是太好了。请收下谢礼。"

#. ID 13, Page 2, Line 19, Pos (10,9)
msgid ""
"3000G　をもらった！\n"
"プライムブルー　をもらった！\n"
"ふしぎなくし　をもらった！"
msgstr "获得了3000G！获得了原初蓝！获得了神奇梳子！"

#. ID 13, Page 2, Line 28, Pos (10,9)
msgid ""
"姉がせめて安らかに眠れたことを願いたいです。\n"
"改めて、ありがとうございました。"
msgstr "但愿姐姐至少能安息。再次感谢您。"

#. ID 13, Page 3, Line 5, Pos (10,9)
msgid "ありがとうございました。"
msgstr "非常感谢。"

#. ID 13, Page 3, Line 10, Pos (10,9)
msgid ""
"例の洞窟は生き物なんでしょうか。\n"
"それとも、もっと人知を超えた何かなんでしょうか。"
msgstr ""
"那个洞窟是活物吗。还是说，\n"
"是某种远远超乎人智的东西呢。"

#. ID 17, Page 1, Line 3, Pos (19,5)
#. Contains choice at line 2 (2 options)
msgid "＊ジューク・ボックスだ！"
msgstr "＊是自动点唱机！"

#. ID 17, Page 1, Line 4, Pos (19,5)
#. Choice (2 options, embedded in a message)
msgid ""
"金を入れる\n"
"ドブに捨てるようなモンだ"
msgstr ""
"投钱进去\n"
"就跟扔进阴沟里一样"

#. ID 17, Page 1, Line 7, Pos (19,5)
msgid "今は演奏中ですぞ！？"
msgstr "现在正在演奏哦！？"

#. ID 17, Page 1, Line 13, Pos (19,5)
msgid "10Gすらないだって！？"
msgstr "甚至连10G都没有！？"
