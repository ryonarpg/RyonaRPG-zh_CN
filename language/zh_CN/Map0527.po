#. ID 12, Page 7, Line 78, Pos (19,23)
#. ID 12, Page 8, Line 30, Pos (19,23)
msgid "ペットは寂しそうだ。"
msgstr "宠物看起来很寂寞。"

#. ID 12, Page 2, Line 79, Pos (19,23)
msgid ""
"ごしゅじんさまっ\n"
"これあげるっ"
msgstr "主人，这个给你。"

#. ID 12, Page 2, Line 81, Pos (19,23)
#. ID 12, Page 3, Line 90, Pos (19,23)
#. ID 12, Page 4, Line 48, Pos (19,23)
#. ID 12, Page 5, Line 50, Pos (19,23)
#. ID 12, Page 6, Line 54, Pos (19,23)
#. ID 12, Page 7, Line 94, Pos (19,23)
msgid "ペットが何かを差し出してきた。"
msgstr "宠物递过来了什么东西。"

#. ID 12, Page 2, Line 83, Pos (19,23)
msgid "マタタビをもらった。"
msgstr "获得了木天蓼。"

#. ID 12, Page 3, Line 3, Pos (19,23)
msgid "お帰りなさい、ご主人様。"
msgstr "欢迎回来，主人。"

#. ID 12, Page 3, Line 5, Pos (19,23)
msgid ""
"ご主人様…なんだか最近ご主人様の留守中\n"
"家の周りに不審な人がうろついてるんです\n"
"気をつけてくださいね。"
msgstr ""
"主人……最近总觉得在您外出期间，\n"
"家附近有可疑的人徘徊，请多加小心。"

#. ID 12, Page 3, Line 12, Pos (19,23)
msgid ""
"…………\\!あ、ご主人様…\n"
"\\!いえ…なんでもないです…"
msgstr "…………\\!啊，主人…\\!不……没什么……"

#. ID 12, Page 3, Line 18, Pos (19,23)
msgid ""
"…………\\!あ、ご主人様…\n"
"その…えっと…ごめんなさい…"
msgstr "…………\\!啊，主人……那个……呃……对不起……"

#. ID 12, Page 3, Line 31, Pos (19,23)
msgid ""
"くす…どうかしましたかご主人様？\n"
"夜まで待てませんか…？"
msgstr "呵……怎么了，主人？等不到晚上了吗……？"

#. ID 12, Page 3, Line 33, Pos (19,23)
msgid ""
"それにしても残念です…\n"
"もし私とご主人様が同じ種族だったら\n"
"もっともっと可愛がって上げれるのに…"
msgstr ""
"话说回来真遗憾……如果我和主人是同一种族的话，\n"
"就能更加更加疼爱您了……"

#. ID 12, Page 3, Line 36, Pos (19,23)
#. Contains choice at line 2 (2 options)
msgid "ハーピーは何事かを考えている……"
msgstr "哈比似乎在思考着什么……"

#. ID 12, Page 3, Line 37, Pos (19,23)
#. Choice (2 options, embedded in a message)
msgid ""
"もっと可愛がってください…\n"
"…………"
msgstr ""
"请更加疼爱我……\n"
"…………"

#. ID 12, Page 3, Line 39, Pos (19,23)
#. Contains choice at line 3 (2 options)
msgid ""
"……いいんですか？\n"
"もう元には戻れないかもしれないんですよ…？"
msgstr "……可以吗？也许已经再也变不回去了哦……？"

#. ID 12, Page 3, Line 41, Pos (19,23)
#. Choice (2 options, embedded in a message)
msgid ""
"それでも気持ちよくなりたい\n"
"…………"
msgstr ""
"即便如此也想变得舒服\n"
"…………"

#. ID 12, Page 3, Line 43, Pos (19,23)
msgid ""
"ふふ…わかりました\n"
"ご主人様がそこまで望まれるのでしたら\n"
"今夜にでも私だけのペットにして差し上げます……"
msgstr ""
"呵呵……我知道了。既然主人这么期望，\n"
"那今晚我就把您变成只属于我的宠物……"

#. ID 12, Page 3, Line 47, Pos (19,23)
#. ID 12, Page 3, Line 59, Pos (19,23)
#. ID 12, Page 7, Line 319, Pos (19,23)
msgid ""
"……\\!フフ…\n"
"今夜も一杯楽しみましょうね。"
msgstr "……\\!呵呵……今晚也好好享受一番吧。"

#. ID 12, Page 3, Line 51, Pos (19,23)
msgid ""
"くす…そうですよね\n"
"今の関係が一番良いと思いますご主人様…"
msgstr "呵……是啊，我觉得现在的关系最好，主人……"

#. ID 12, Page 3, Line 53, Pos (19,23)
#. ID 12, Page 7, Line 300, Pos (19,23)
msgid ""
"また今夜も楽しみましょうね。\n"
"ご主人様。"
msgstr "今晚也再一起享受吧，主人。"

#. ID 12, Page 3, Line 72, Pos (19,23)
msgid ""
"あ、ありがとうございます。\n"
"かまってくださるのは嬉しいです。"
msgstr "啊，谢谢您。您愿意陪我，我很高兴。"

#. ID 12, Page 3, Line 74, Pos (19,23)
#. ID 12, Page 4, Line 31, Pos (19,23)
#. ID 12, Page 5, Line 34, Pos (19,23)
#. ID 12, Page 6, Line 35, Pos (19,23)
#. ID 12, Page 7, Line 65, Pos (19,23)
#. ID 12, Page 8, Line 8, Pos (19,23)
msgid "ペットは嬉しそうだ。"
msgstr "宠物看起来很高兴。"

#. ID 12, Page 3, Line 88, Pos (19,23)
msgid ""
"日ごろの感謝の印です。\n"
"ご主人様。"
msgstr "这是平日感谢的证明，主人。"

#. ID 12, Page 3, Line 92, Pos (19,23)
msgid "ハーピーの卵をもらった。"
msgstr "获得了哈比之卵。"

#. ID 12, Page 4, Line 3, Pos (19,23)
msgid "ねえ、遊ぼうよごしゅじんさま。"
msgstr "呐，来玩吧，主人。"

#. ID 12, Page 4, Line 5, Pos (19,23)
msgid ""
"ねえごしゅじんさま…最近おうちの周りに\n"
"へんなひとがいるんだよ。\n"
"なんだかこわいからすぐ帰ってきてね。"
msgstr ""
"呐，主人……最近家附近有奇怪的人哦。\n"
"总觉得很可怕，所以你要马上回来哦。"

#. ID 12, Page 4, Line 12, Pos (19,23)
msgid ""
"ごしゅじんさま…\n"
"あ、うん\\!…なんでもないんだよ…"
msgstr "主人……啊，嗯\\!……没什么哦……"

#. ID 12, Page 4, Line 18, Pos (19,23)
msgid ""
"ごしゅじんさま…\n"
"きょうはちょっとあそぶ気になれないんだ\n"
"ごめんね…"
msgstr "主人……今天有点没心情玩，对不起哦……"

#. ID 12, Page 4, Line 30, Pos (19,23)
msgid "わーい、何して遊ぼっか？"
msgstr "哇——要玩什么呢？"

#. ID 12, Page 4, Line 45, Pos (19,23)
msgid ""
"いっつも大切にしてくれてありがとうね\n"
"これはおれいだよ。\n"
"これからもいっぱい遊ぼうね。"
msgstr ""
"谢谢你总是这么珍惜我，这是谢礼哦。\n"
"今后也要多陪我玩哦。"

#. ID 12, Page 4, Line 50, Pos (19,23)
msgid "はちみつをもらった。"
msgstr "获得了蜂蜜。"

#. ID 12, Page 5, Line 3, Pos (19,23)
msgid ""
"帰ってくるなら帰ってくるっていいなさい\n"
"心配したじゃないの。\n"
"………\\!心配って別に深い意味じゃないん\n"
"だからね。勘違いしないでよ。"
msgstr ""
"要回来的话就事先说一声啊，我不是担心了吗。………\n"
"\\!我说的担心可没有什么深意，别误会了。"

#. ID 12, Page 5, Line 8, Pos (19,23)
msgid ""
"ねえ、最近家の周りで変な奴がいるのよ\n"
"まるでこの家を見張ってるみたい\n"
"……\\!貴女、気をつけなさいよ\n"
"貴女に何かあったら…"
msgstr ""
"呐，最近家附近有奇怪的家伙哦，\n"
"简直像是在监视这座房子……\\!你，要小心啊。\n"
"你要是出了什么事……"

#. ID 12, Page 5, Line 16, Pos (19,23)
msgid ""
"あ…\\!お帰り…\\!\n"
"…大丈夫、何もなかったわ…\\!ほんとよ"
msgstr ""
"啊……\\!欢迎回来……\\!……没事，什么也没发生……\n"
"\\!真的哦。"

#. ID 12, Page 5, Line 22, Pos (19,23)
msgid "…\\!ちょっと一人にさせて…"
msgstr "……\\!让我一个人待一会儿……"

#. ID 12, Page 5, Line 32, Pos (19,23)
msgid ""
"ま…\\!そこまでいうなら遊んであげるわよ\n"
"ほら、何をするの？"
msgstr ""
"真……\\!你都说到这个份上了，那我就陪你玩吧。\n"
"来吧，要做什么？"

#. ID 12, Page 5, Line 48, Pos (19,23)
msgid ""
"まあ…いつもよくしてくれてるんだから\n"
"たまには…ね。勘違いしないでよ。"
msgstr ""
"嘛……因为你平时一直对我很好，偶尔也……对吧。\n"
"别误会哦。"

#. ID 12, Page 5, Line 52, Pos (19,23)
msgid "らみあの鱗をもらった。"
msgstr "获得了拉米亚之鳞。"

#. ID 12, Page 6, Line 6, Pos (19,23)
msgid "……………\\!お帰りなさい……"
msgstr "……………\\!欢迎回来……"

#. ID 12, Page 6, Line 8, Pos (19,23)
msgid ""
"最近ね…へんな人がいるみたい…\n"
"この家の中…みてるんだ…\n"
"気をつけてね…"
msgstr ""
"最近呢……好像有奇怪的人……在看着……这座房子里面……\n"
"要小心哦……"

#. ID 12, Page 6, Line 16, Pos (19,23)
msgid ""
"あ…\\!お帰り…\n"
"え…\\!泣いてなんかいないよ…ほんとに…"
msgstr "啊……\\!欢迎回来……诶……\\!我才没有哭哦……真的……"

#. ID 12, Page 6, Line 23, Pos (19,23)
msgid "……………ごめんなさい………"
msgstr "……………对不起………"

#. ID 12, Page 6, Line 34, Pos (19,23)
msgid "………\\!ありがと……"
msgstr "………\\!谢谢……"

#. ID 12, Page 6, Line 53, Pos (19,23)
msgid "……………\\!これ、もらって…"
msgstr "……………\\!这个，收下吧……"

#. ID 12, Page 6, Line 58, Pos (19,23)
msgid "アウラウネの花を貰った。"
msgstr "获得了阿尔拉乌涅之花。"

#. ID 12, Page 7, Line 3, Pos (19,23)
msgid "うふふ…\\!帰ってきて下さったのですね"
msgstr "呵呵呵……\\!您回来了呢。"

#. ID 12, Page 7, Line 8, Pos (19,23)
msgid ""
"そうそう、ご主人様。最近家の周りに\n"
"変な人がいるんです。泥棒かしら？\n"
"まあ安心してください。\n"
"留守はしっかり私が守ります。"
msgstr ""
"对了对了，主人。最近家附近有奇怪的人。\n"
"是小偷吗？不过请放心。\n"
"您不在的时候我会好好守着的。"

#. ID 12, Page 7, Line 16, Pos (19,23)
msgid ""
"あら、お帰りなさい、ご主人様\n"
"え…？なにか変なことがなかったかって？\n"
"ええ、\\!少し面白いことがありましたけど\n"
"大したことじゃあないですよ。"
msgstr ""
"哎呀，欢迎回来，主人。诶……？\n"
"您问有没有什么奇怪的事？是的，\n"
"\\!是发生了一点有趣的事，\n"
"不过不是什么大不了的事哦。"

#. ID 12, Page 7, Line 24, Pos (19,23)
msgid ""
"あら、お帰りなさい。ご主人様\n"
"こちらは相変わらず平穏無事ですよ。"
msgstr "哎呀，欢迎回来。主人，这边一如既往平安无事哦。"

#. ID 12, Page 7, Line 30, Pos (19,23)
msgid ""
"ただいまです、ご主人様。\n"
"あら、どうしたんですか？そんな驚いて\n"
"やっぱり私はご主人様のお傍にいたいので\n"
"戻ってきちゃいました。"
msgstr ""
"我回来了，主人。哎呀，怎么了？这么惊讶。\n"
"果然我还是想待在主人身边，所以就回来了。"

#. ID 12, Page 7, Line 34, Pos (19,23)
msgid ""
"ああ、あの男ですか？\n"
"フフ…\\!少し遊んであげたらすっかり枯れ\n"
"てしまいましたよ。まああれで少しは懲り\n"
"たでしょうね。"
msgstr ""
"啊，您说那个男人吗？呵呵……\n"
"\\!我稍微陪他玩了一下，他就彻底枯萎了哦。嘛，\n"
"这样一来他多少也长记性了吧。"

#. ID 12, Page 7, Line 38, Pos (19,23)
msgid ""
"ひょっとして寂しかったんですか？\n"
"フフフ…"
msgstr "难道是寂寞了吗？呵呵呵……"

#. ID 12, Page 7, Line 56, Pos (19,23)
msgid ""
"ふふ、ご主人様は猫さんですから\n"
"むしろ私がご主人様で遊ぶほうですかね？"
msgstr ""
"呵呵，因为主人是猫咪嘛，\n"
"倒不如说是我在逗主人玩吧？"

#. ID 12, Page 7, Line 60, Pos (19,23)
msgid ""
"私と一緒にいてくれるのですか？\n"
"とても嬉しいです。\n"
"ずっとずっとあなたと一緒に…"
msgstr ""
"您愿意和我在一起吗？我非常高兴。\n"
"一直一直和你在一起……"

#. ID 12, Page 7, Line 77, Pos (19,23)
msgid "あら、残念です……"
msgstr "哎呀，真遗憾……"

#. ID 12, Page 7, Line 84, Pos (19,23)
#. ID 12, Page 7, Line 106, Pos (19,23)
msgid ""
"うふふ、ご主人様はほんとに可愛いですね……\n"
"可愛すぎて私、もう感情を抑えられそうにありません。"
msgstr ""
"呵呵呵，主人真是可爱呢……\n"
"可爱到我已经快要压抑不住感情了。"

#. ID 12, Page 7, Line 86, Pos (19,23)
#. ID 12, Page 7, Line 108, Pos (19,23)
msgid ""
"ペットの表情が何だか妖しい。\n"
"大丈夫だろうか……"
msgstr "宠物的表情总觉得很妖艳。没问题吧……"

#. ID 12, Page 7, Line 91, Pos (19,23)
msgid ""
"これは私の気持ちです、\n"
"どうぞ受け取ってください。\n"
"\\!これからもずっと私を傍に置いて下さい"
msgstr ""
"这是我的感情，请收下吧。\n"
"\\!今后也请一直把我留在您身边。"

#. ID 12, Page 7, Line 98, Pos (19,23)
msgid "天使の涙を貰った。"
msgstr "获得了天使之泪。"

#. ID 12, Page 7, Line 171, Pos (19,23)
msgid ""
"クスクス…\n"
"\\!ご主人様、私に黙って楽しむなんて\n"
"寂しいじゃないですか。"
msgstr "呵呵……\\!主人，瞒着我一个人享受，也太寂寞了吧。"

#. ID 12, Page 7, Line 174, Pos (19,23)
msgid ""
"今日からこの鍵は私が預かりますよ。\n"
"ね、いいでしょう？いいですよね？"
msgstr ""
"从今天起，这把钥匙由我保管哦。呐，可以吧？\n"
"可以吧？"

#. ID 12, Page 7, Line 176, Pos (19,23)
#. Contains choice at line 2 (3 options)
msgid "＊　貞操帯の鍵をペットに渡しますか？"
msgstr "＊　要把贞操带的钥匙交给宠物吗？"

#. ID 12, Page 7, Line 177, Pos (19,23)
#. Choice (3 options, embedded in a message)
msgid ""
"はい\n"
"はい\n"
"はい"
msgstr ""
"是\n"
"是\n"
"是"

#. ID 12, Page 7, Line 185, Pos (19,23)
msgid ""
"＊　貞操帯の鍵を渡してしまった…\n"
"　　\\!ペットの許可なしに貞操帯を\n"
"　　外すことができなくなった！"
msgstr ""
"＊　已经把贞操带的钥匙交出去了…\n"
"　　\\!未经宠物许可，贞操带\n"
"　　已经无法解开了！"

#. ID 12, Page 7, Line 188, Pos (19,23)
msgid ""
"クスクス…\n"
"それでは、これからご主人様のお世話は私が致します。\n"
"\\!よろしくお願いしますね。"
msgstr ""
"呵呵……那么，今后主人的照顾就由我来做。\n"
"\\!请多关照哦。"

#. ID 12, Page 7, Line 223, Pos (19,23)
msgid ""
"ご主人様、\n"
"木馬を新調したことに気づきましたか？"
msgstr "主人，您注意到木马换新的了吗？"

#. ID 12, Page 7, Line 225, Pos (19,23)
msgid ""
"木馬が稼働しているときにリモコンを\n"
"充電できるようにしてもらいましたの。"
msgstr "我请人改成木马运行的时候也能给遥控器充电了哦。"

#. ID 12, Page 7, Line 227, Pos (19,23)
msgid "これで充電が切れても安心ですね、\\.ご主人様。"
msgstr "这样就算没电了也能放心呢、\\.主人。"

#. ID 12, Page 7, Line 234, Pos (19,23)
msgid ""
"トイレですか？\n"
"\\!そうですねぇ"
msgstr "厕所吗？\\!是呢……"

#. ID 12, Page 7, Line 237, Pos (19,23)
msgid "いいですよ。"
msgstr "可以哦。"

#. ID 12, Page 7, Line 241, Pos (19,23)
msgid "はい、行ってらっしゃい。"
msgstr "好的，您去吧。"

#. ID 12, Page 7, Line 251, Pos (19,23)
msgid ""
"フフフ…\\!\n"
"間違って排泄禁止モードを選択してしまいましたわ。"
msgstr "呵呵呵…\\!我不小心选成禁止排泄模式了呢。"

#. ID 12, Page 7, Line 254, Pos (19,23)
msgid ""
"私では止められないようなので\n"
"頑張って自分で止めてくださいね。"
msgstr "看来我无法阻止，所以请自己努力停下来哦。"

#. ID 12, Page 7, Line 258, Pos (19,23)
#. ID 12, Page 7, Line 264, Pos (19,23)
msgid ""
"今日はだめです。\n"
"我慢してください。"
msgstr "今天不行。请忍耐一下。"

#. ID 12, Page 7, Line 285, Pos (19,23)
msgid ""
"あらやだ。こんな道具も持っていたのですか？\n"
"\\!ご主人様は一人遊びが好きなのですね。\n"
"それも今日で終わりですよ。\n"
"\\!これも私以外使えないようにしますね"
msgstr ""
"哎呀真是。你居然还拿着这种道具？\n"
"\\!主人喜欢一个人玩呢。那也到今天为止了哦。\n"
"\\!这个我也会设定成除我以外的人用不了呢"

#. ID 12, Page 7, Line 289, Pos (19,23)
msgid ""
"＊　リモートコントローラが\\n[\\v[6]]には\n"
"　　使えないように設定されてしまった！"
msgstr "＊　遥控器被设定成\\n[\\v[6]]无法使用了！"

#. ID 12, Page 7, Line 303, Pos (19,23)
msgid ""
"クスクス…どうかなさいましたか\n"
"ご主人様。\n"
"楽しめるのは夜だけですからね。"
msgstr "嘻嘻……怎么了主人。能享受的只有晚上哦。"

#. ID 12, Page 7, Line 306, Pos (19,23)
msgid ""
"それにしても残念ですわね。\n"
"もし私とご主人様の立場が逆でしたら\n"
"昼も夜も可愛がって差し上げますのに…"
msgstr ""
"话说回来真遗憾呢。如果我和主人的立场反过来，\n"
"我明明会不分昼夜地疼爱您的……"

#. ID 12, Page 7, Line 309, Pos (19,23)
#. Contains choice at line 2 (2 options)
#. ID 21, Page 1, Line 267, Pos (29,11)
msgid "…………"
msgstr "…………"

#. ID 12, Page 7, Line 310, Pos (19,23)
#. Choice (2 options, embedded in a message)
msgid ""
"昼も私のご主人様になってください\n"
"なんでもない"
msgstr ""
"请白天也当我的主人\n"
"没什么"

#. ID 12, Page 7, Line 333, Pos (19,23)
msgid ""
"あら、よろしいんですの？\n"
"\\!クスクス、いいわ。\n"
"これから一杯可愛がってあげますわ\n"
"私の可愛いペットとしてね"
msgstr ""
"哎呀，可以吗？\\!嘻嘻，好吧。\n"
"从今往后我会好好疼爱你的，作为我可爱的宠物呢"

#. ID 12, Page 7, Line 349, Pos (19,23)
msgid ""
"フフフ、お似合いよ。\n"
"それではいきましょうか。"
msgstr "呵呵呵，很合适哦。那么，我们走吧。"

#. ID 12, Page 7, Line 359, Pos (19,23)
msgid "あら…どうしたのこの娘？"
msgstr "哎呀……这个女孩怎么了？"

#. ID 12, Page 7, Line 363, Pos (19,23)
msgid ""
"ウフフ、下界に下りた時、色々とお世話に\n"
"なったの。だからお礼としてペットに\n"
"してあげたの。天使のペットになれるなん\n"
"て、人間には光栄でしょ。"
msgstr ""
"呵呵，下到人间时，我受到了各种照顾。\n"
"所以作为谢礼，我把她变成宠物了。\n"
"能成为天使的宠物，对人类来说很光荣吧。"

#. ID 12, Page 7, Line 367, Pos (19,23)
msgid ""
"いいなあ。こんなかわいい娘みつけて\n"
"私もほしいなあこんなペット。"
msgstr ""
"真好啊。找到这么可爱的女孩，\n"
"我也想要这样的宠物啊。"

#. ID 12, Page 7, Line 369, Pos (19,23)
msgid ""
"いいわよ。みんなで可愛がってあげて\n"
"そのほうがこの娘も喜ぶわ。"
msgstr ""
"可以哦。大家一起疼爱她，\n"
"这样这女孩也会更高兴的。"

#. ID 12, Page 7, Line 381, Pos (19,23)
msgid ""
"こうして\\!天使達のペットとして\n"
"末永く可愛がられる事になった。"
msgstr "就这样，\\!她成了天使们的宠物，被长久地疼爱着。"

#. ID 12, Page 8, Line 3, Pos (19,23)
msgid ""
"帰ってきたのかお\n"
"ほら、なんかだすお"
msgstr "回来了吗？看，有什么东西出来哦"

#. ID 12, Page 8, Line 25, Pos (19,23)
msgid "ひ…\\!ひどいお…"
msgstr "呜……\\!太过分了……"

#. ID 12, Page 8, Line 26, Pos (19,23)
msgid "すっきりした。"
msgstr "清爽了。"

#. ID 13, Page 2, Line 11, Pos (3,5)
msgid "おい、おきな！！"
msgstr "喂，起来！！"

#. ID 13, Page 2, Line 17, Pos (3,5)
msgid ""
"へッヘッへッ…\\!おかしな動きはするなよ\n"
"お前さんはともかくペットまではその体勢\n"
"じゃあ守りきれないだろ。\n"
"おとなしく言うことを聞いてもらおうか…"
msgstr ""
"嘿嘿嘿……\\!别做奇怪的举动哦。你暂且不说，\n"
"连宠物都那样的话，那种姿势下我可保护不了吧。\n"
"乖乖听我的话吧……"

#. ID 13, Page 2, Line 21, Pos (3,5)
msgid ""
"鍵ねえ…？\\!あんなもん俺にとっちゃ\n"
"たいしたもんじゃねえよ。\n"
"なあ、そうだろ？"
msgstr ""
"钥匙啊……？\\!那种东西对我来说算不了什么。喂，\n"
"对吧？"

#. ID 13, Page 2, Line 28, Pos (3,5)
#. ID 13, Page 2, Line 34, Pos (3,5)
msgid "………"
msgstr "………"

#. ID 13, Page 2, Line 29, Pos (3,5)
#. ID 13, Page 2, Line 39, Pos (3,5)
msgid "ペットはビクっと体を震わせている。"
msgstr "宠物吓得身体一颤。"

#. ID 13, Page 2, Line 36, Pos (3,5)
msgid "ペットは笑顔でうなずいていた。"
msgstr "宠物笑着点了点头。"

#. ID 13, Page 2, Line 44, Pos (3,5)
msgid ""
"オラ、とっととベットから降りやがれ。\n"
"お楽しみの時間だぜ。"
msgstr "喂，赶紧从床上滚下来。现在是享乐时间了。"

#. ID 13, Page 3, Line 17, Pos (3,5)
#. ID 13, Page 5, Line 16, Pos (3,5)
msgid "なんだか体に違和感が…"
msgstr "总觉得身体有违和感……"

#. ID 13, Page 3, Line 20, Pos (3,5)
#. ID 13, Page 5, Line 19, Pos (3,5)
msgid "なんだか体がスースーする…"
msgstr "总觉得身体凉飕飕的……"

#. ID 13, Page 3, Line 26, Pos (3,5)
msgid ""
"あ…起きてしまいましたか？\n"
"寝ているご主人様の顔があまりにも可愛いくて…"
msgstr "啊……您醒了吗？睡着的主人脸实在太可爱了……"

#. ID 13, Page 3, Line 28, Pos (3,5)
msgid "そういうとハーピーは抱きついてきた。"
msgstr "说着，哈比抱了上来。"

#. ID 13, Page 3, Line 29, Pos (3,5)
msgid ""
"普段から可愛がって頂いてますから…\n"
"今日は私がご主人をたくさん可愛がりたいな、と…\n"
"くす、まずは胸から…"
msgstr ""
"平时一直承蒙您疼爱……今天我想好好疼爱主人……嘻，\n"
"首先从胸部开始……"

#. ID 13, Page 3, Line 32, Pos (3,5)
msgid "ハーピーの羽が乳首をくすぐり始める"
msgstr "哈比的羽毛开始搔弄乳头"

#. ID 13, Page 3, Line 39, Pos (3,5)
msgid ""
"あん…硬くなって来ましたね\n"
"私の羽、そんなに感じますか…？"
msgstr "啊嗯……变硬了呢。我的羽毛，让你这么有感觉吗……？"

#. ID 13, Page 3, Line 45, Pos (3,5)
#. ID 13, Page 5, Line 52, Pos (3,5)
#. ID 13, Page 7, Line 46, Pos (3,5)
#. ID 13, Page 8, Line 94, Pos (3,5)
msgid "それじゃあ、次は下のほうを…"
msgstr "那么，接下来是下面……"

#. ID 13, Page 3, Line 50, Pos (3,5)
msgid ""
"…どんな感じですかご主人様？癖になりますか…？\n"
"くす、素直なご主人様はとても可愛いです…\n"
"じゃあご褒美に、イカせて上げますね"
msgstr ""
"……感觉怎么样，主人？会上瘾吗……？嘻，\n"
"坦率的主人非常可爱……那么作为奖励，我让您高潮吧"

#. ID 13, Page 3, Line 65, Pos (3,5)
msgid ""
"あら…？お漏らし…\n"
"ふふ、これではご主人様がペットのようですね…\n"
"これからは私がお世話をしてあげますよ…？\n"
"気持ち良い事には逆らえないでしょう…？"
msgstr ""
"哎呀……？漏出来了……呵呵，\n"
"这样的话主人就像宠物一样了呢……\n"
"从今往后由我来照顾您哦……？\n"
"舒服的事是无法抗拒的吧……？"

#. ID 13, Page 4, Line 12, Pos (3,5)
msgid ""
"なんだか胸の辺りがむずむずする…\n"
"\\!様子を見てみるとなんとペットが\n"
"胸に吸い付いてきている\n"
"どうやら寝ぼけているようだ。"
msgstr ""
"总觉得胸口附近痒痒的……\\!一看，\n"
"竟然是宠物吸在胸口上。看来是在梦游。"

#. ID 13, Page 4, Line 27, Pos (3,5)
msgid ""
"なんとか振りほどこうとするも\n"
"こんどは触手を体に巻きつけてきた。"
msgstr "我设法想挣脱，结果这次触手缠上了身体。"

#. ID 13, Page 4, Line 39, Pos (3,5)
msgid ""
"さらに胸を吸い続けてくる\n"
"このままでは…"
msgstr "而且它还继续吸着胸口，这样下去的话……"

#. ID 13, Page 4, Line 50, Pos (3,5)
msgid ""
"ペットは満足したのがすっかり寝入って\n"
"しまった。\n"
"………\\!自分も休もう…\n"
"また明日もしてもらえるだろうか？"
msgstr ""
"宠物似乎满足了，完全睡着了。………\\!自己也休息吧…\n"
"…明天还能再让它做吗？"

#. ID 13, Page 5, Line 25, Pos (3,5)
msgid ""
"ふふふ…起きてしまわれましたか？\n"
"お休みになってるご主人様があまりにも\n"
"可愛らしいのでつい…"
msgstr ""
"呵呵呵……您醒了吗？休息中的主人实在太可爱了，\n"
"我不由得……"

#. ID 13, Page 5, Line 28, Pos (3,5)
msgid "そういうと天使は抱きついてきた。"
msgstr "说着，天使抱了上来。"

#. ID 13, Page 5, Line 29, Pos (3,5)
msgid ""
"日頃よくして頂いているお礼です\n"
"いっぱい可愛がって差し上げます。\n"
"まずはこの綺麗なおっぱいから…"
msgstr ""
"这是对平时您照顾我的谢礼，我会好好疼爱您的。\n"
"首先从这对漂亮的胸部开始……"

#. ID 13, Page 5, Line 39, Pos (3,5)
msgid ""
"うふふ…スーツ越しでも分かる位\n"
"硬くなっちゃいましたね。\n"
"本当に素敵…"
msgstr "呵呵……隔着套装都能看出变硬了呢。真是棒……"

#. ID 13, Page 5, Line 44, Pos (3,5)
#. ID 13, Page 8, Line 67, Pos (3,5)
msgid ""
"うふふ…硬くなっちゃいましたね。\n"
"本当に素敵…"
msgstr "呵呵……变硬了呢。真是棒……"

#. ID 13, Page 5, Line 57, Pos (3,5)
msgid ""
"うふふ…どうです、気持ちいいでしょう？\n"
"それじゃあイカせてあげましょう。"
msgstr "呵呵……怎么样，很舒服吧？那么，我让您高潮吧。"

#. ID 13, Page 5, Line 72, Pos (3,5)
#. ID 13, Page 5, Line 86, Pos (3,5)
msgid ""
"気持ち良かったですか？\n"
"これから夜は私がご主人様ですよ。\n"
"わかりましたね。\n"
"それではお休みなさい。"
msgstr ""
"舒服吗？从今往后，晚上我就是主人了哦。\n"
"明白了吧。那么，晚安。"

#. ID 13, Page 5, Line 80, Pos (3,5)
#. ID 13, Page 5, Line 94, Pos (3,5)
msgid ""
"あらあら、粗相しちゃいましたね…\n"
"これから夜は私がご主人様ですよ。\n"
"わかりましたね。\n"
"それではお休みなさい。"
msgstr ""
"哎呀哎呀，失态了呢……从今往后，\n"
"晚上我就是主人了哦。明白了吧。那么，晚安。"

#. ID 13, Page 6, Line 6, Pos (3,5)
#. Contains choice at line 2 (2 options)
#. ID 13, Page 7, Line 13, Pos (3,5)
#. Contains choice at line 2 (2 options)
#. ID 13, Page 8, Line 13, Pos (3,5)
#. Contains choice at line 2 (2 options)
#. ID 13, Page 9, Line 6, Pos (3,5)
#. Contains choice at line 2 (2 options)
#. ID 52, Page 6, Line 7, Pos (0,7)
#. Contains choice at line 2 (2 options)
msgid "休みますか？"
msgstr "要休息吗？"

#. ID 13, Page 6, Line 15, Pos (3,5)
#. Contains choice at line 2 (2 options)
#. ID 13, Page 7, Line 20, Pos (3,5)
#. Contains choice at line 2 (2 options)
#. ID 13, Page 8, Line 24, Pos (3,5)
#. Contains choice at line 2 (2 options)
msgid "ペットと添い寝しますか？"
msgstr "要和宠物一起睡吗？"

#. ID 13, Page 6, Line 20, Pos (3,5)
#. ID 13, Page 9, Line 19, Pos (3,5)
msgid "ペットはすごく喜んでいる。"
msgstr "宠物非常高兴。"

#. ID 13, Page 6, Line 64, Pos (3,5)
#. ID 13, Page 7, Line 275, Pos (3,5)
#. ID 13, Page 8, Line 204, Pos (3,5)
#. ID 13, Page 9, Line 34, Pos (3,5)
#. ID 52, Page 6, Line 153, Pos (0,7)
msgid "ゆっくり休んだ"
msgstr "好好休息了"

#. ID 13, Page 7, Line 29, Pos (3,5)
msgid ""
"じゃあ今日も気持ちよくしてあげますね\n"
"そんな欲しそうな顔しなくても…ふふ"
msgstr ""
"那么今天也让我带您舒服吧。\n"
"不用露出那么想要的表情……呵呵"

#. ID 13, Page 7, Line 39, Pos (3,5)
msgid ""
"…硬くなって来ましたね…\n"
"私の羽、そんなに気持ち良いですか…？"
msgstr "……变硬了呢……我的羽毛，让你这么舒服吗……？"

#. ID 13, Page 7, Line 52, Pos (3,5)
msgid ""
"くす…すっかり癖になってしまって…\n"
"そんな欲しそうな顔せずとも、今イカせてあげますから"
msgstr ""
"嘻……已经完全上瘾了呢……不用露出那么想要的表情，\n"
"我现在就让您高潮"

#. ID 13, Page 7, Line 63, Pos (3,5)
msgid ""
"気持ちよさそうですねご主人様…でも\n"
"今夜はこれからが本番なのですよ？"
msgstr ""
"看起来很舒服呢，主人……\n"
"不过今晚从现在开始才是正戏哦？"

#. ID 13, Page 7, Line 65, Pos (3,5)
msgid ""
"そう言うとハーピーは何かを咥え\n"
"\\n[\\v[6]]のお腹の上にポトリと落としてきた。"
msgstr ""
"说着，哈比叼着什么东西\\n[\\v[6]]，\n"
"轻轻落在肚子上。"

#. ID 13, Page 7, Line 67, Pos (3,5)
msgid ""
"これが何か、イったばかりの頭で分かりますか…？\n"
"ふふ、私の卵です……そして"
msgstr ""
"这是什么，刚高潮完的脑袋能明白吗……？呵呵，\n"
"是我的卵……然后"

#. ID 13, Page 7, Line 69, Pos (3,5)
msgid ""
"ハーピーに促されるままに視線を下げる\\n[\\v[6]]\n"
"その瞳に映るのは…ハーピーの股間に屹立するイチモツ"
msgstr ""
"在哈比的催促下，我低下头\\n[\\v[6]]，\n"
"映入眼帘的是……哈比胯间耸立的肉棒"

#. ID 13, Page 7, Line 71, Pos (3,5)
msgid "\\n[\\v[6]]「そっ、それ……！」"
msgstr "\\n[\\v[6]]「那、那个……！」"

#. ID 13, Page 7, Line 72, Pos (3,5)
msgid ""
"くす、ご主人様を本当の意味でのペットにするために\n"
"コレが必要になりますから……こうやって"
msgstr ""
"嘻，为了让主人成为真正意义上的宠物，\n"
"这是必要的……像这样"

#. ID 13, Page 7, Line 77, Pos (3,5)
msgid "\\n[\\v[6]]「あっ、ひ……」"
msgstr "\\n[\\v[6]]「啊、呜……」"

#. ID 13, Page 7, Line 78, Pos (3,5)
msgid "クチュリ、と\\n[\\v[6]]の膣口に卵が押し込まれる…"
msgstr "噗嗤一声，卵被推入\\n[\\v[6]]的阴道口……"

#. ID 13, Page 7, Line 79, Pos (3,5)
msgid "そしてこう……"
msgstr "然后这样……"

#. ID 13, Page 7, Line 83, Pos (3,5)
msgid ""
"膣口に咥えられた卵をさらに奥へと押し込むように\n"
"ハーピーの男根が打ち込まれる！"
msgstr ""
"哈比的阴茎被打入，\n"
"将含在阴道口的卵进一步推向深处！"

#. ID 13, Page 7, Line 85, Pos (3,5)
msgid "\\n[\\v[6]]「ん、ああっ……！卵が、奥に当たって……！」"
msgstr "\\n[\\v[6]]「嗯、啊啊……！卵顶到里面了……！」"

#. ID 13, Page 7, Line 90, Pos (3,5)
msgid "\\n[\\v[6]]「あ゛っ！ああああ─────っ！」"
msgstr "\\n[\\v[6]]「啊゛！啊啊啊啊─────！」"

#. ID 13, Page 7, Line 93, Pos (3,5)
msgid ""
"ハーピーの力強い抽送により\n"
"\\n[\\v[6]]の子宮に卵が押し込まれた！"
msgstr ""
"由于哈耳庇厄强有力的抽送，\n"
"卵被压入了\\n[\\v[6]]的子宫！"

#. ID 13, Page 7, Line 98, Pos (3,5)
msgid ""
"そしてハーピーから放たれた精液が\n"
"\\n[\\v[6]]の子宮を白く染め上げる。"
msgstr ""
"然后，从哈耳庇厄身上释放出的精液，\n"
"将\\n[\\v[6]]的子宫染成一片雪白。"

#. ID 13, Page 7, Line 100, Pos (3,5)
msgid ""
"はぁ…はぁ…\n"
"分かりますかご主人様…？私の卵の脈動が…"
msgstr "呼…呼…您明白吗，主人…？我卵的搏动…"

#. ID 13, Page 7, Line 105, Pos (3,5)
msgid "\\n[\\v[6]]「やっ、ふ……っ、お腹しびれて……！」"
msgstr "\\n[\\v[6]]「呀、呼……嗯、肚子发麻……！」"

#. ID 13, Page 7, Line 109, Pos (3,5)
msgid ""
"くす、そうです、貴方を段々と変えてしまう鼓動です…\n"
"ご主人様を私の仲間へ、と…"
msgstr ""
"呵呵，没错，那是会把您逐渐改变的搏动…\n"
"要把主人变成我的同伴，这样…"

#. ID 13, Page 7, Line 114, Pos (3,5)
msgid "\\n[\\v[6]]「ひ、あああっ！」"
msgstr "\\n[\\v[6]]「咿、啊啊啊！」"

#. ID 13, Page 7, Line 115, Pos (3,5)
msgid ""
"ざわり、と\\n[\\v[6]]の手足が鳥肌立ち\n"
"程なくして羽毛が生え揃い始める…"
msgstr ""
"一阵毛骨悚然，\\n[\\v[6]]的手脚起了鸡皮疙瘩，\n"
"没过多久便开始长齐羽毛……"

#. ID 13, Page 7, Line 120, Pos (3,5)
msgid "\\n[\\v[6]]「か、わる、変わっちゃう、のに…気持ちいい…っ」"
msgstr "\\n[\\v[6]]「明、明、明明要变了…却好舒服……！」"

#. ID 13, Page 7, Line 121, Pos (3,5)
msgid ""
"ほら、もう少しですよ…？\n"
"足も手も、もう殆ど私と一緒……\n"
"頑張ってください、私の可愛いペットちゃん"
msgstr ""
"看吧，就差一点了哦…？手脚都已经几乎和我一样了…\n"
"…请加油，我可爱的小宠物。"

#. ID 13, Page 7, Line 146, Pos (3,5)
#. ID 42, Page 3, Line 75, Pos (0,2)
msgid "…………………………………………"
msgstr "…………………………………………"

#. ID 13, Page 7, Line 150, Pos (3,5)
msgid "\\n[\\v[6]]はハーピーに転生させられてしまった……"
msgstr "\\n[\\v[6]]被转生成了哈耳庇厄……"

#. ID 13, Page 7, Line 155, Pos (3,5)
msgid ""
"くす、とても綺麗ですよ…\n"
"そして、これでもっと綺麗になります…"
msgstr "呵呵，非常漂亮哦…而且，这样会变得更漂亮…"

#. ID 13, Page 7, Line 166, Pos (3,5)
msgid "\\n[\\v[6]]の首に首輪がはめられた！"
msgstr "\\n[\\v[6]]的脖子上被套上了项圈！"

#. ID 13, Page 7, Line 167, Pos (3,5)
msgid ""
"ふふ…無駄ですよ？\n"
"あなたの翼になった腕では首輪を外せない…"
msgstr ""
"呵呵…没用的哦？\n"
"你那双变成翅膀的手臂可解不开项圈…"

#. ID 13, Page 7, Line 169, Pos (3,5)
msgid ""
"そして、これから私のペットとして\n"
"たくさんたくさん私の卵を孕んで貰いますね…？"
msgstr ""
"然后，从今往后作为我的宠物，\n"
"要给我怀上好多好多的卵哦…？"

#. ID 13, Page 7, Line 171, Pos (3,5)
msgid "そしてゆっくりとハーピーが\\n[\\v[6]]を押し倒す…"
msgstr "然后，哈耳庇厄缓缓地将\\n[\\v[6]]推倒……"

#. ID 13, Page 7, Line 193, Pos (3,5)
msgid "ふふ、私の卵、孕んでくれたみたいね……"
msgstr "呵呵，看来你怀上我的卵了呢……"

#. ID 13, Page 7, Line 194, Pos (3,5)
msgid ""
"この家の家賃のためにも、もっと沢山産んでね…？\n"
"私の可愛いペット、\\n[\\v[6]]ちゃん"
msgstr ""
"为了这房子的房租，也要多产一些哦…？\n"
"我可爱的小宠物，\\n[\\v[6]]酱"

#. ID 13, Page 7, Line 203, Pos (3,5)
msgid "とってもとっても可愛い貴方のボテ腹、みせて…"
msgstr "让我看看你超级超级可爱的孕肚…"

#. ID 13, Page 7, Line 210, Pos (3,5)
msgid ""
"はぁ、はぁ……こんなに注いだら、ふふ\n"
"すぐに卵を孕んじゃうね、それとも孕みたいのかな……？"
msgstr ""
"呼、呼……灌进去这么多的话，呵呵，\n"
"马上就会怀上卵呢，还是说你想怀上呢……？"

#. ID 13, Page 7, Line 218, Pos (3,5)
msgid "やはっ……止まらない、搾り取られちゃう……"
msgstr "呀哈……停不下来，要被榨干了……"

#. ID 13, Page 7, Line 225, Pos (3,5)
msgid "すごい……貴方のココ私のに絡み付いて……"
msgstr "好厉害……你的这里缠着我的那里……"

#. ID 13, Page 7, Line 242, Pos (3,5)
msgid ""
"\\S[2]こうして\\n[\\v[6]]はモンスターに堕とされ\n"
"永遠に産卵ペットとして鎖に繋がれる事と\n"
"なったのである…。"
msgstr ""
"\\S[2]就这样，\\n[\\v[6]]被堕落成魔物，\n"
"永远作为产卵宠物被锁链拴住了……。"

#. ID 13, Page 7, Line 257, Pos (3,5)
msgid ""
"ふふ？また漏らししましたね…？\n"
"本当に仕方がないペットなんですから\n"
"でも、そう言うところが凄く可愛いです\n"
"後始末は私がしますので、先におやすみなさい…"
msgstr ""
"呵呵？又漏出来了吧…？真是拿你没办法的宠物，\n"
"不过，这种地方也非常可爱。善后由我来做，\n"
"你先睡吧……"

#. ID 13, Page 8, Line 33, Pos (3,5)
msgid ""
"フフフ、それではまた一杯可愛がって\n"
"あげましょうね。"
msgstr "呵呵呵，那么下次再好好疼爱疼爱你吧。"

#. ID 13, Page 8, Line 63, Pos (3,5)
msgid ""
"お顔が蕩けてますよ。\n"
"うふふ…可愛いです…"
msgstr "你的表情都融化了哦。呵呵…真可爱…"

#. ID 13, Page 8, Line 86, Pos (3,5)
msgid "ご主人様、私の指をしゃぶってください…"
msgstr "主人，请吮吸我的手指……"

#. ID 13, Page 8, Line 91, Pos (3,5)
msgid "うふふ…気持ち良かったですよ。"
msgstr "呵呵…很舒服哦。"

#. ID 13, Page 8, Line 99, Pos (3,5)
msgid "うふふ…どうです、気持ちいいでしょう？"
msgstr "呵呵…怎么样，很舒服吧？"

#. ID 13, Page 8, Line 113, Pos (3,5)
msgid ""
"お休みなさい、ご主人様。\n"
"また明日も可愛がってあげますね。"
msgstr "晚安，主人。明天也会好好疼爱你的哦。"

#. ID 13, Page 8, Line 117, Pos (3,5)
msgid "それじゃあイカせてあげましょう。"
msgstr "那么，就让你高潮吧。"

#. ID 13, Page 8, Line 145, Pos (3,5)
msgid ""
"あらあら、また粗相しちゃったようですね\n"
"\\!恥ずかしい液体を沢山啜ったオムツスーツに\n"
"包まれて、どんな気持ちですか？\n"
"\\!クスクス…、お休みなさい。"
msgstr ""
"哎呀哎呀，好像又失禁了呢\\!被吸满羞耻液体的尿布\n"
"　套装包裹着，是什么感觉？\\!呵呵…晚安。"

#. ID 13, Page 8, Line 153, Pos (3,5)
#. ID 13, Page 8, Line 165, Pos (3,5)
msgid ""
"あらあら、また粗相しちゃいましたね…\n"
"ペットの後始末はご主人様の仕事ですので\n"
"私がやっておきます\n"
"あなたはお休みなさい。"
msgstr ""
"哎呀哎呀，又失禁了呢…宠物的善后是主人的工作，\n"
"所以由我来处理。你睡吧。"

#. ID 13, Page 8, Line 159, Pos (3,5)
msgid ""
"おしっこはトイレでしましょうね。\n"
"\\!クスクス…、お休みなさい。"
msgstr "尿尿要在厕所里哦。\\!呵呵…晚安。"

#. ID 13, Page 9, Line 14, Pos (3,5)
#. Contains choice at line 2 (2 options)
msgid "添い寝しますか？"
msgstr "要一起睡吗？"

#. ID 13, Page 9, Line 59, Pos (3,5)
msgid "……………\\!フフフ…ほら、起きなさい。"
msgstr "……………\\!呵呵呵…看，起来吧。"

#. ID 13, Page 9, Line 73, Pos (3,5)
msgid ""
"お久しぶりね。元気にしてたかしら？\n"
"こんな立派なお家を持ってるなんてね\n"
"大したものねえ…"
msgstr ""
"好久不见呢。过得还好吗？\n"
"居然拥有这么气派的房子，真了不起啊…"

#. ID 13, Page 9, Line 76, Pos (3,5)
msgid "フフフ、驚いてる？"
msgstr "呵呵呵，吓了一跳？"

#. ID 13, Page 9, Line 77, Pos (3,5)
msgid ""
"あの時貴女にやられた時はどうなる事かと\n"
"思ったけど…\\!あの後屋敷の調査に来た\n"
"教会の人たちに種子をくっつかせて\n"
"無事復活出来たわけ。"
msgstr ""
"那时候被你打倒时，我还以为会变成怎样呢…\n"
"\\!后来我让来宅邸调查的教会人们沾上种子，\n"
"才得以顺利复活。"

#. ID 13, Page 9, Line 81, Pos (3,5)
msgid ""
"しかしまさか貴女に飼って貰う事になる\n"
"なんて思いもしなかったわ…\n"
"\\!しかもわざわざ栄養剤まで貰えるなんて\n"
"…"
msgstr ""
"不过真没想到居然会变成被你饲养…\n"
"\\!而且还特意得到营养剂…"

#. ID 13, Page 9, Line 85, Pos (3,5)
msgid ""
"お蔭様で予定より早く力を取り戻す事が\n"
"出来たわ。ありがとうね\n"
"そしてこうなった以上、私がまず先にやる\n"
"事は…\\!貴女への復讐"
msgstr ""
"多亏如此，我比预定更早恢复了力量。谢谢你。\n"
"然后既然变成这样，我首先要做的事是…\n"
"\\!向你复仇。"

#. ID 13, Page 9, Line 89, Pos (3,5)
msgid ""
"でもこんな素敵なお家で戦うのは\n"
"ちょっと気が進まないわね。\n"
"\\!…では、こうしましょう…"
msgstr ""
"不过在这种漂亮的房子里战斗，我有点提不起劲呢。\n"
"\\!…那么，就这样吧…"

#. ID 13, Page 9, Line 102, Pos (3,5)
msgid ""
"フフフ、ここは私の作った幻想空間…\n"
"ここなら何の遠慮もいらないわ\n"
"それじゃあ始めましょうか。"
msgstr ""
"呵呵呵，这里是我制造的幻想空间…\n"
"在这里就不需要任何顾虑了。那么，开始吧。"

#. ID 14, Page 1, Line 3, Pos (34,4)
msgid "＊ジューク・ボックスだ！"
msgstr "＊是自动点唱机！"

#. ID 18, Page 1, Line 3, Pos (5,33)
#. Contains choice at line 2 (2 options)
msgid "お風呂に入りますか？"
msgstr "要洗澡吗？"

#. ID 18, Page 1, Line 24, Pos (5,33)
#. ID 18, Page 1, Line 40, Pos (5,33)
msgid "！？"
msgstr "！？"

#. ID 18, Page 1, Line 30, Pos (5,33)
msgid ""
"なにやら物音が聞こえた…\n"
"やはりストーカーだろうか？"
msgstr "听到了什么声响…果然是跟踪狂吗？"

#. ID 18, Page 1, Line 33, Pos (5,33)
msgid "また役所に相談してみよう…"
msgstr "再去市政厅商量一下吧…"

#. ID 18, Page 1, Line 46, Pos (5,33)
msgid ""
"なにやら物音が聞こえた…\n"
"覗かれていたのだろうか？"
msgstr "听到了什么声响…是被偷窥了吗？"

#. ID 18, Page 1, Line 49, Pos (5,33)
msgid "役所の公安課にでも相談してみよう…"
msgstr "去政府公安科商量一下吧…"

#. ID 18, Page 1, Line 57, Pos (5,33)
msgid ""
"さっぱりした。\n"
"\\!しかし、スーツの中は\n"
"熱気を帯びてサウナのようだ…"
msgstr "清爽了。\\!不过，套装里面带着热气，像桑拿一样…"

#. ID 18, Page 1, Line 63, Pos (5,33)
msgid ""
"さっぱりした。\n"
"\\!…寄生虫も水気を得て\n"
"ぬらぬらと妖しく光っている"
msgstr ""
"清爽了。\\!…寄生虫也吸了水分，\n"
"湿漉漉地泛着妖异的光。"

#. ID 18, Page 1, Line 68, Pos (5,33)
msgid "さっぱりした。"
msgstr "清爽了。"

#. ID 19, Page 1, Line 28, Pos (14,37)
#. ID 19, Page 2, Line 20, Pos (14,37)
msgid ""
"来客だろうか？\n"
"確認しに行こう…"
msgstr "是客人吗？去确认一下吧…"

#. ID 19, Page 1, Line 43, Pos (14,37)
msgid "………誰もいない。"
msgstr "………没有人。"

#. ID 19, Page 2, Line 36, Pos (14,37)
msgid ""
"ああ、先ほどご挨拶した隣の者です。\n"
"\\!本日はご挨拶としてやってきました。\n"
"これはお近づきのしるしです。"
msgstr ""
"啊，是刚才来打过招呼的邻居。\n"
"\\!今天我作为问候过来了。这是表示结交的心意。"

#. ID 19, Page 2, Line 40, Pos (14,37)
msgid "金塊をもらった。"
msgstr "得到了金块。"

#. ID 19, Page 2, Line 86, Pos (14,37)
msgid "ご主人様、誰か来たの？"
msgstr "主人，有人来了吗？"

#. ID 19, Page 2, Line 90, Pos (14,37)
msgid ""
"おお、これは……\\!\n"
"この子はお宅のペットでしょうか…\n"
"いや、可愛らしいペットですな。\n"
"私はペットが大好きなんですよ。"
msgstr ""
"哦哦，这是……\\!这孩子是你家的宠物吗…不，\n"
"真是可爱的宠物啊。我最喜欢宠物了。"

#. ID 19, Page 2, Line 94, Pos (14,37)
msgid ""
"男は無遠慮にペットを眺めている\n"
"その視線にペットが怯えているようなので\n"
"少し抗議するように男を睨み付けてやった"
msgstr ""
"男人毫不客气地打量着宠物，\n"
"宠物似乎被那道视线吓到了，\n"
"于是我像稍作抗议似的瞪了男人一眼。"

#. ID 19, Page 2, Line 97, Pos (14,37)
msgid ""
"………\\!さてそれじゃあ失礼します\n"
"今後とも良いご近所付き合いを願いたい\n"
"モノですな。失礼。"
msgstr ""
"………\\!那么，我就此告辞了。\n"
"今后也希望维持良好的邻里往来啊。告辞。"

#. ID 19, Page 2, Line 111, Pos (14,37)
msgid "………\\!なんか…怖い人ね…"
msgstr "………\\!总觉得…是个可怕的人呢…"

#. ID 21, Page 1, Line 3, Pos (29,11)
#. ID 21, Page 1, Line 63, Pos (29,11)
#. ID 21, Page 1, Line 291, Pos (29,11)
msgid "……………"
msgstr "……………"

#. ID 21, Page 1, Line 4, Pos (29,11)
msgid ""
"どうにもこの兵士の様子はおかしい\n"
"黙っている割にはどこか挙動不審だ。"
msgstr ""
"这名士兵的样子怎么看都很奇怪。明明沉默着，\n"
"却总觉得举止可疑。"

#. ID 21, Page 1, Line 6, Pos (29,11)
msgid ""
"……大丈夫ですよ。\n"
"何があってもボクが貴女を守りますから…"
msgstr "……没关系的。无论发生什么，我都会保护你…"

#. ID 21, Page 1, Line 8, Pos (29,11)
msgid ""
"今日はお疲れになったでしょう。\n"
"お風呂にでも入られてはいかがですか。"
msgstr "今天您累了吧。要不要去泡个澡？"

#. ID 21, Page 1, Line 10, Pos (29,11)
msgid "とりあえずそうすることにした。"
msgstr "总之决定就这么做了。"

#. ID 21, Page 1, Line 17, Pos (29,11)
msgid ""
"……喉が渇いたでしょう…\n"
"どうぞ……"
msgstr "……口渴了吧…请……"

#. ID 21, Page 1, Line 19, Pos (29,11)
msgid ""
"飲み物が用意してあった。\n"
"どうする？"
msgstr "饮料已经准备好了。怎么办？"

#. ID 21, Page 1, Line 22, Pos (29,11)
#. Choice (2 options)
#. ID 21, Page 1, Line 110, Pos (29,11)
#. Choice (2 options)
msgid ""
"飲む\n"
"飲むふりをする"
msgstr ""
"喝\n"
"假装喝"

#. ID 21, Page 1, Line 32, Pos (29,11)
msgid ""
"……特に変わった味はしない。\n"
"\\|飲み干しても問題はないだろう。"
msgstr ""
"……并没有什么特别奇怪的味道。\n"
"\\|就算喝光也没问题吧。"

#. ID 21, Page 1, Line 42, Pos (29,11)
#. ID 21, Page 1, Line 87, Pos (29,11)
msgid "何事もなく数日が過ぎた。"
msgstr "平安无事地过了几天。"

#. ID 21, Page 1, Line 54, Pos (29,11)
#. ID 21, Page 1, Line 99, Pos (29,11)
msgid ""
"残念ながらストーカーらしき人物は\n"
"発見できませんでした。"
msgstr "很遗憾，没能发现疑似跟踪狂的人物。"

#. ID 21, Page 1, Line 56, Pos (29,11)
#. ID 21, Page 1, Line 101, Pos (29,11)
msgid ""
"再度ストーカーの気配を感じたときに\n"
"またお越しください。"
msgstr "再次感觉到跟踪狂的气息时请再来。"

#. ID 21, Page 1, Line 75, Pos (29,11)
msgid ""
"湯あたりですか？\n"
"\\!ベッドで休みましょう。"
msgstr "是泡晕了吗？\\!到床上休息吧。"

#. ID 21, Page 1, Line 81, Pos (29,11)
msgid ""
"毒を仕込んだわけではないらしい。\n"
"\\|杞憂だったのだろうか。"
msgstr "似乎并没有下毒。\\|是杞人忧天吗。"

#. ID 21, Page 1, Line 125, Pos (29,11)
msgid ""
"……妙な味だ…\n"
"\\!……これは！"
msgstr "……奇怪的味道…\\!……这是！"

#. ID 21, Page 1, Line 132, Pos (29,11)
msgid ""
"……妙な味だ…\n"
"\\!！？頭がフラフラする…\\!これは…？"
msgstr "……奇怪的味道…\\!！？头好晕…\\!这是…？"

#. ID 21, Page 1, Line 141, Pos (29,11)
#. ID 21, Page 1, Line 298, Pos (29,11)
msgid ""
"ヒヒヒ…やった。やったんだ。\n"
"\\!これで…これで…"
msgstr "嘿嘿嘿…成功了。成功了。\\!这样一来…这样一来…"

#. ID 21, Page 1, Line 156, Pos (29,11)
msgid "ヒヒヒ…お目覚めですか？"
msgstr "嘿嘿嘿…您醒了吗？"

#. ID 21, Page 1, Line 158, Pos (29,11)
msgid ""
"気がつくと寝室で横にされたいた。\n"
"薬の後遺症か、体の自由が利かない。"
msgstr ""
"回过神来时，已被放倒在卧室里。是药物后遗症吗，\n"
"身体无法自由行动。"

#. ID 21, Page 1, Line 162, Pos (29,11)
msgid ""
"気がつくと寝室で裸に剥かれていた。\n"
"薬の後遺症か、体の自由が利かない。"
msgstr ""
"回过神来时，已在卧室里被剥光。是药物后遗症吗，\n"
"身体无法自由行动。"

#. ID 21, Page 1, Line 166, Pos (29,11)
msgid ""
"ヒヒヒ…ずっとずっと見ていたんですよ。\n"
"ずっと待ってた。貴女がボクのモノになる\n"
"日を、ずっと！！"
msgstr ""
"嘿嘿嘿…我一直一直在看着你哦。一直等着。\n"
"等着你成为我的东西的那一天，一直！！"

#. ID 21, Page 1, Line 169, Pos (29,11)
msgid "そういうと男は襲い掛かってきた。"
msgstr "这么说着，男人扑了过来。"

#. ID 21, Page 1, Line 182, Pos (29,11)
msgid ""
"ああ！！\\!素晴らしい…\n"
"もっと、もっといきますよ！"
msgstr "啊！！\\!太棒了…我还要，还要继续！"

#. ID 21, Page 1, Line 193, Pos (29,11)
msgid "ほら、出しますよ！！"
msgstr "看吧，要射了！！"

#. ID 21, Page 1, Line 196, Pos (29,11)
msgid ""
"ほら、出しますよ！！\n"
"ボクの子供を孕んでください！！"
msgstr "看吧，要射了！！请怀上我的孩子！！"

#. ID 21, Page 1, Line 214, Pos (29,11)
msgid "ヒヒヒ…これでもうキミはボクのモノだ"
msgstr "嘿嘿嘿…这样你已经是我的东西了"

#. ID 21, Page 1, Line 219, Pos (29,11)
msgid "その後、何度も何度も調教されて…"
msgstr "那之后，被一次又一次地调教…"

#. ID 21, Page 1, Line 258, Pos (29,11)
msgid ""
"汝、この者を妻とし永久に愛することを\n"
"誓いますか？"
msgstr "你愿意娶此人为妻，发誓永远爱她吗？"

#. ID 21, Page 1, Line 260, Pos (29,11)
msgid "はい、誓います。"
msgstr "是的，我发誓。"

#. ID 21, Page 1, Line 265, Pos (29,11)
msgid ""
"汝、この者を夫とし永久に愛することを\n"
"誓いますか？"
msgstr "你愿意与此人为夫，发誓永远爱他吗？"

#. ID 21, Page 1, Line 276, Pos (29,11)
msgid "…………はい"
msgstr "…………是的"

#. ID 21, Page 1, Line 278, Pos (29,11)
msgid ""
"ヒヒヒ、ずっと一緒にいようね。\n"
"\\!そう、逃げられないからな。"
msgstr "嘿嘿嘿，一直在一起吧。\\!对，因为逃不掉了。"

#. ID 21, Page 1, Line 284, Pos (29,11)
msgid ""
"それから\\n[\\v[6]]は\n"
"ストーカーの奴隷妻として\n"
"一生弄ばれ続けたのだった。"
msgstr ""
"从那以后\\n[\\v[6]]作为跟踪狂的奴隶妻子，\n"
"一生都被玩弄下去。"

#. ID 21, Page 1, Line 305, Pos (29,11)
msgid "ヒヒヒ、それじゃあ早速…"
msgstr "嘿嘿嘿，那么马上…"

#. ID 21, Page 1, Line 307, Pos (29,11)
msgid "え………"
msgstr "诶………"

#. ID 21, Page 1, Line 312, Pos (29,11)
msgid "ぎゃああああ！！！"
msgstr "呀啊啊啊啊！！！"

#. ID 21, Page 1, Line 324, Pos (29,11)
msgid ""
"まさか彼がストーカーだったとは…\n"
"本当に面目御座いません。\n"
"酷い失態です…!　これはせめてものお詫びです。\n"
"受け取ってください。"
msgstr ""
"没想到他竟然是跟踪狂…真的非常抱歉。严重的失态…\n"
"!　这是最起码的赔罪。请收下。"

#. ID 21, Page 1, Line 331, Pos (29,11)
msgid "10,000G貰った。"
msgstr "收到了10,000G。"

#. ID 21, Page 1, Line 334, Pos (29,11)
msgid ""
"今後こういった失態は起こしませんので…。\n"
"本当に申し訳ございませんでした。"
msgstr "今后不会再发生这样的失态…。真的非常抱歉。"

#. ID 22, Page 1, Line 4, Pos (4,5)
msgid ""
"あ、ごしゅじんさま...\n"
"まだねむいよ～"
msgstr "啊，主人...我还困呢～"

#. ID 22, Page 1, Line 8, Pos (4,5)
msgid "にゃー"
msgstr "喵～"

#. ID 22, Page 2, Line 5, Pos (4,5)
msgid ""
"くす、可愛い寝顔でした\n"
"おはようございます…"
msgstr "噗嗤，真是可爱的睡脸。早上好…"

#. ID 22, Page 2, Line 12, Pos (4,5)
msgid ""
"あ、おはようございます\n"
"ご主人様。"
msgstr "啊，早上好，主人。"

#. ID 22, Page 3, Line 3, Pos (4,5)
msgid ""
"あ、おはよー\\!ごしゅじんさま\n"
"今日もがんばろうね。"
msgstr "啊，早上好～\\!主人，今天也要加油哦。"

#. ID 22, Page 4, Line 3, Pos (4,5)
msgid "きゃ、急に起きないでよ！"
msgstr "呀，别突然起来啊！"

#. ID 22, Page 4, Line 4, Pos (4,5)
msgid ""
"目が覚めるとペットが顔を近づけていた\n"
"どうやら寝顔を見られていたらしい。"
msgstr "醒来时，宠物把脸凑了过来。看来睡脸被看到了。"

#. ID 22, Page 4, Line 6, Pos (4,5)
msgid ""
"べ、別に見とれてなんかいないわよ。\n"
"……\\!ほら、さっさと起きる！！"
msgstr "我、我才没有看入迷呢。……\\!喂，快点起来！！"

#. ID 22, Page 5, Line 4, Pos (4,5)
msgid "………うみゅ…\\!あう…"
msgstr "………唔喵…\\!啊呜…"

#. ID 22, Page 5, Line 5, Pos (4,5)
msgid "どうやら少し寝ぼけているようだ。"
msgstr "看来有点睡迷糊了。"

#. ID 22, Page 5, Line 7, Pos (4,5)
msgid "………おはよう……"
msgstr "………早上好……"

#. ID 22, Page 6, Line 3, Pos (4,5)
msgid ""
"うふふ…おはようございます。\n"
"\\!それにしても可愛らしい寝顔でした。\n"
"そう…ずっと眺めていたいくらい。"
msgstr ""
"呵呵…早上好。\\!话说回来，真是可爱的睡脸。对…\n"
"让人想一直看下去。"

#. ID 22, Page 6, Line 8, Pos (4,5)
msgid "また、今夜も楽しみましょうね。"
msgstr "那么，今晚也一起享受吧。"

#. ID 23, Page 1, Line 14, Pos (12,3)
msgid "捕まってしまった…"
msgstr "被抓住了…"

#. ID 23, Page 1, Line 22, Pos (12,3)
msgid ""
"必死にもがいたおかげか何とか外れた\n"
"今度から気をつけよう"
msgstr "也许是拼命挣扎的缘故，总算挣脱了。下次要小心。"

#. ID 24, Page 1, Line 4, Pos (12,4)
msgid ""
"どうやら前の住人が置いていった\n"
"モノみたいだ。\n"
"触らないほうがいいだろう。"
msgstr "看来像是前一个居民留下的东西。最好不要碰吧。"

#. ID 25, Page 1, Line 46, Pos (3,11)
#. ID 52, Page 9, Line 137, Pos (0,7)
msgid ""
"…………\\!\n"
"\\v[782]回分の充電が出来たようだ。"
msgstr "…………\\!看来已经充好了\\v[782]次份的电。"

#. ID 25, Page 1, Line 56, Pos (3,11)
msgid ""
"どうやら、これも前の住人が残していった\n"
"ものらしい…\n"
"\\!ひどい目にあった…"
msgstr ""
"看来，这也是前一个居民留下的东西…\n"
"\\!我真是倒了大霉…"

#. ID 31, Page 1, Line 14, Pos (12,8)
msgid ""
"男はソファに座ってペットを舐め回してい\n"
"る。…\\!助けたくても体を押さえ込まれて\n"
"動けない…"
msgstr ""
"男人坐在沙发上，来回舔着宠物。…\\!就算想救，\n"
"身体被按住也无法行动…"

#. ID 31, Page 1, Line 17, Pos (12,8)
msgid ""
"どうだい？とても気持ちよさそうだろう？\n"
"\\!ペットを可愛がるというのはこういう事\n"
"さ…\n"
"\\!なあ！？"
msgstr ""
"怎么样？看起来非常舒服吧？\n"
"\\!所谓疼爱宠物就是这么回事…\\!对吧！？"

#. ID 31, Page 1, Line 21, Pos (12,8)
msgid ""
"男はそういうと思いっきりペットの乳首を\n"
"捻りあげる。"
msgstr "男人说着，用力拧起宠物的乳头。"

#. ID 31, Page 1, Line 29, Pos (12,8)
msgid "ーーーーーーーーー！！！"
msgstr "～～～～～～～～～！！！"

#. ID 31, Page 1, Line 30, Pos (12,8)
msgid ""
"ペットは声にならない悲鳴を上げて\n"
"崩れ落ちる…"
msgstr "宠物发出不成声的惨叫，瘫倒下去…"

#. ID 31, Page 1, Line 38, Pos (12,8)
msgid ""
"おやおや、そんなに良かったか？…\n"
"今回が初めてというわけでもないのに\n"
"やはり主人に見られているというのは\n"
"違うのか？"
msgstr ""
"哎呀哎呀，有那么舒服吗？…明明也不是第一次了，\n"
"果然被主人看着还是不一样吗？"

#. ID 31, Page 1, Line 42, Pos (12,8)
msgid ""
"そうだよ！今まで何度も何度も可愛がって\n"
"やったさ！今夜みたいに侵入させて貰って\n"
"な。盗賊業から足洗ってもう鍵開けなんざ\n"
"使う事もねえと思ってたがな…"
msgstr ""
"是啊！至今为止我都疼爱过她好多次了！\n"
"像今晚这样让我潜入进来。\n"
"虽然我已经金盆洗手不干盗贼，\n"
"还以为再也不会用开锁之类的手段了…"

#. ID 31, Page 1, Line 46, Pos (12,8)
msgid ""
"もっとも、この事がご主人様にバレれば\n"
"嫌われて捨てられちまうぞって脅したら\n"
"素直に黙ってたがな。\n"
"お蔭様で何度でも侵入できたよ。"
msgstr ""
"不过，我威胁说如果这事被主人发现，\n"
"你就会被讨厌、被抛弃，她就乖乖闭嘴了。\n"
"多亏如此，我才能一次又一次地潜入。"

#. ID 31, Page 1, Line 50, Pos (12,8)
msgid ""
"いよいよもって気に入ったから今日は本格\n"
"的にいただきに来たというわけさ。\n"
"あの時大人しく金で渡しとけば良かったの\n"
"にねえ…主従そろってバカだな。"
msgstr ""
"我越来越中意她，所以今天就来正式收下她了。\n"
"那时候乖乖用钱把她让给我就好了…\n"
"主仆俩都是笨蛋啊。"

#. ID 31, Page 1, Line 67, Pos (12,8)
msgid ""
"男はそういいながら己の一物を\n"
"ペットの体になすりつけ始めた。"
msgstr ""
"男人一边这么说，\n"
"一边开始把自己的那话儿蹭到宠物身上。"

#. ID 31, Page 1, Line 69, Pos (12,8)
msgid ""
"フヒヒ、どうだい？\n"
"これでなんども可愛がってあげたろう？\n"
"今のご主人様はこんな気持ちいいこと\n"
"してくれるのか？"
msgstr ""
"呼嘿嘿，怎么样？这样我可疼爱过你好多次了吧？\n"
"现在的主人会给你做这么舒服的事吗？"

#. ID 31, Page 1, Line 73, Pos (12,8)
msgid ""
"今日は特別にもっといいものをプレゼント\n"
"してやろう\n"
"ほら、食らえ！！"
msgstr "今天特别给你更好的东西。看吧，吃下这个！！"

#. ID 31, Page 1, Line 77, Pos (12,8)
msgid "そういうと男はペットに何かの注射をした"
msgstr "这么说着，男人给宠物注射了某种东西"

#. ID 31, Page 1, Line 90, Pos (12,8)
msgid ""
"ペットの顔が紅潮しはじめ\n"
"息も荒くなっていった。\n"
"おそらくは薬の効果だろう…"
msgstr ""
"宠物的脸开始泛红，呼吸也变得粗重。\n"
"大概是药物的效果吧…"

#. ID 31, Page 1, Line 93, Pos (12,8)
msgid ""
"どうだ？欲しいだろう？\n"
"\\!素直になればいっぱいくれてやるぞ。"
msgstr ""
"怎么样？想要吧？\\!只要老实听话，\n"
"我就给你很多哦。"

#. ID 31, Page 1, Line 95, Pos (12,8)
msgid ""
"ペットはうつむいて必死に耐えていたが\n"
"ついに耐え切れなくなったのか\n"
"こくこくとうなずいた。"
msgstr ""
"宠物低着头拼命忍耐，但最终还是忍不住了吧，\n"
"连连点头。"

#. ID 31, Page 1, Line 98, Pos (12,8)
msgid ""
"はは、いい娘だ。それじゃあ\n"
"新しいご主人様のチンポをくらいな！！"
msgstr "哈哈，好姑娘。那就来尝尝新主人的鸡巴吧！！"

#. ID 31, Page 1, Line 128, Pos (12,8)
msgid "オラ！出すぞ。受け取れ！！"
msgstr "喂！要射了。接住！！"

#. ID 31, Page 1, Line 142, Pos (12,8)
msgid "！！！ーーーーー\\!！！"
msgstr "！！！～～～～～\\!！！"

#. ID 31, Page 1, Line 149, Pos (12,8)
msgid ""
"フフフ…\\!どうだ？\n"
"いいか、これでお前のご主人様は\n"
"今日から俺になるんだ？\n"
"わかったな？"
msgstr ""
"呵呵呵…\\!怎么样？听好了，\n"
"从今天起你的主人就是我了？明白了吗？"

#. ID 31, Page 1, Line 159, Pos (12,8)
msgid "…………\\!はい…ごしゅじんさま…"
msgstr "…………\\!是…主人…"

#. ID 31, Page 1, Line 166, Pos (12,8)
msgid ""
"よおし…\\!いい返事だ。\n"
"それじゃあもっと楽しむか。\n"
"\\!それとお前ら、そこにいるこいつの元\n"
"ご主人様で楽しんでな。"
msgstr ""
"好嘞…\\!回答得不错。那就再好好享受吧。\n"
"\\!还有你们，就拿那边这家伙的原主人好好玩玩吧。"

#. ID 31, Page 1, Line 173, Pos (12,8)
msgid ""
"へ、そいつはありがてえ。\n"
"生憎俺たちは旦那みてえな獣姦の趣味は\n"
"ねえからな。\n"
"それじゃあ楽しませてもらうぜ。"
msgstr ""
"嘿，那可真求之不得。不巧的是，\n"
"我们可没有像老爷你那样的兽奸趣味。\n"
"那就让我们好好享受吧。"

#. ID 31, Page 1, Line 186, Pos (12,8)
msgid "おら、出すぞ！！"
msgstr "喂，要射了！！"

#. ID 31, Page 1, Line 198, Pos (12,8)
msgid ""
"こんどはこっちだ。せいぜい楽しませて\n"
"くれよ！"
msgstr "这次轮到这边了。可要尽量让我享受啊！"

#. ID 31, Page 1, Line 218, Pos (12,8)
msgid ""
"へっへっへ\n"
"それじゃあこいつは貰っていくぜ。\n"
"訴えたりなんかはしない方がいいぜ。\n"
"こいつはもう俺の傍にいる方が幸せなんだ"
msgstr ""
"嘿嘿嘿，那我就把这家伙带走了。\n"
"你最好别去告发什么的。\n"
"这家伙待在我身边才更幸福。"

#. ID 31, Page 1, Line 228, Pos (12,8)
msgid "……さようなら……"
msgstr "……再见……"

#. ID 32, Page 1, Line 3, Pos (37,4)
#. Contains choice at line 2 (2 options)
msgid "時間を進めますか？"
msgstr "要推进时间吗？"

#. ID 32, Page 1, Line 9, Pos (37,4)
msgid "夜になりました"
msgstr "已入夜"

