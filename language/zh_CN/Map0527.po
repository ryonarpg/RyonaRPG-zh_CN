msgid "\\>0:未取得　1:取得　2～:無効"
msgstr "\\>0:未取得　1:取得　2～:无效"

#. ID 33, Page 2, Line 127, Pos (10,5)
msgid ""
"\\>0:未取得　1:自分　2:天使　3:鞭モード\n"
"\\>4:飴モード　5～:無効"
msgstr ""
"\\>0:未取得　1:自己　2:天使　3:鞭模式\n"
"\\>4:糖模式　5～:无效"

#. ID 33, Page 2, Line 143, Pos (10,5)
msgid ""
"\\>0:未管理　1:股　2:股＆胸(鍵なし)　3:胸\n"
"\\>4:股(鍵なし)＆胸　5:股＆胸　6～:無効"
