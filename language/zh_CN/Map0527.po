#. ID 12, Page 2, Line 63, Pos (19,23)
msgid "にゃーっ！"
msgstr "喵——！"

#. ID 12, Page 2, Line 64, Pos (19,23)
msgid "嬉しそうに飛びかかってきた。"
msgstr "它高兴地扑了过来。"

#. ID 12, Page 2, Line 68, Pos (19,23)
#. ID 12, Page 3, Line 78, Pos (19,23)
#. ID 12, Page 4, Line 35, Pos (19,23)
#. ID 12, Page 5, Line 38, Pos (19,23)
#. ID 12, Page 6, Line 42, Pos (19,23)
#. ID 12, Page 7, Line 72, Pos (19,23)
msgid "ペットとの愛情が深まった。"
msgstr "与宠物的感情加深了。"

#. ID 12, Page 2, Line 72, Pos (19,23)
msgid "にゃー..."
msgstr "喵……"

#. ID 12, Page 2, Line 73, Pos (19,23)
#. ID 12, Page 3, Line 82, Pos (19,23)
#. ID 12, Page 4, Line 39, Pos (19,23)
#. ID 12, Page 5, Line 42, Pos (19,23)
