#. ID 1, Page 1, Line 3, Pos (34,49)
#. Contains choice at line 2 (2 options)
msgid "このエリアから出ますか？"
msgstr "要离开这个区域吗？"

#. ID 1, Page 1, Line 4, Pos (34,49)
#. Choice (2 options, embedded in a message)
#. ID 4, Page 1, Line 75, Pos (47,45)
#. Choice (2 options, embedded in a message)
#. ID 4, Page 1, Line 91, Pos (47,45)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 3, Page 1, Line 5, Pos (21,45)
msgid ""
"スティライ\n"
"「さて今日はどんなご用件？"
msgstr "斯蒂莱「那么，今天有什么贵干？"

#. ID 3, Page 1, Line 10, Pos (21,45)
#. Choice (4 options)
msgid ""
"ここはなに？\n"
"今の住民居住数を教えて\n"
"町の開発をしたい\n"
"他の事を話す"
msgstr ""
"这里是什么？\n"
"告诉我现在的居民人数\n"
"我想进行城镇开发\n"
"谈其他事情"

#. ID 3, Page 1, Line 15, Pos (21,45)
msgid ""
"スティライ\n"
"「ここでは町の住民の人数確認と、\n"
"　町の開発ができるよ♪"
msgstr ""
"斯蒂莱「在这里可以确认城镇的居民人数，\n"
"　也可以进行城镇开发哦♪"

#. ID 3, Page 1, Line 19, Pos (21,45)
msgid ""
"スティライ\n"
"「町の開発をするとどんどん町が大きく\n"
"　なるから頑張って開発しようね。"
msgstr ""
"斯蒂莱「进行城镇开发的话，城镇会不断变大，\n"
"　所以要努力开发哦。"

#. ID 3, Page 1, Line 23, Pos (21,45)
msgid ""
"スティライ\n"
"「町の開発をするには、まず住民がある\n"
"　程度いないとダメだよ。それと開発資金\n"
"　も必要だね。"
msgstr ""
"斯蒂莱「要进行城镇开发，\n"
"首先得有一定程度的居民才行。\n"
"　另外开发资金　也是必要的呢。"

#. ID 3, Page 1, Line 28, Pos (21,45)
msgid ""
"スティライ\n"
"「条件が揃ったら、私のところに来てね♪\n"
"　街の開発をフェリスさんにお願い\n"
"　しておくから。"
msgstr ""
"斯蒂莱「条件齐了之后，\n"
"就来找我吧♪　我会先拜托菲莉丝小姐进行城镇开发\n"
"　的。"

#. ID 3, Page 1, Line 37, Pos (21,45)
msgid ""
"ポテチジャンキー\n"
"「すまぬの。住民増やすシステムはまだ\n"
"　開発中なのじゃ…。\n"
"　だからいくら聞いても0じゃよ。"
msgstr ""
"薯片狂热者「不好意思啊。\n"
"增加居民的系统还在　开发中……。\n"
"　所以不管你怎么问都是0哦。"

#. ID 3, Page 1, Line 50, Pos (21,45)
msgid ""
"スティライ\n"
"「今なら町を大きくできそうだよ！\n"
"　開発資金が10万かかるけどいい？"
msgstr ""
"斯蒂莱「现在的话应该能把城镇变大哦！\n"
"　虽然需要10万开发资金，可以吗？"

#. ID 3, Page 1, Line 58, Pos (21,45)
msgid ""
"スティライ\n"
"「今は町を発展させられそうにないよ。\\|\n"
"　もっと資金や人を集めないとね。"
msgstr ""
"斯蒂莱「现在似乎没法发展城镇。\n"
"\\|　得收集更多资金和人呢。"

#. ID 3, Page 1, Line 63, Pos (21,45)
#. Choice (4 options)
msgid ""
"雑談したい\n"
"開発資金の残り額を知りたい\n"
"他の事を話す\n"
"とくにない"
msgstr ""
"想闲聊\n"
"想知道开发资金的剩余金额\n"
"谈其他事情\n"
"没什么特别的"

#. ID 3, Page 1, Line 79, Pos (21,45)
msgid ""
"スティライ\n"
"「開発資金の残りの金額は、\n"
"　\\v[1538]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]Gだよ。"
msgstr ""
"斯蒂莱「开发资金的剩余金额是，\n"
"　\\v[1538]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]\n"
"　G哦。"

#. ID 3, Page 1, Line 84, Pos (21,45)
msgid ""
"スティライ\n"
"「開発資金の残りの金額は、\n"
"　\\v[1539]Gだよ。"
msgstr "斯蒂莱「开发资金的剩余金额是，　\\v[1539]G哦。"

#. ID 3, Page 1, Line 97, Pos (21,45)
msgid ""
"スティライ\n"
"「そっか～。\n"
"　また用事ができたら呼んでね。"
msgstr "斯蒂莱「这样啊～。　再有事情的话就叫我哦。"

#. ID 3, Page 2, Line 7, Pos (21,45)
msgid ""
"スティライ\n"
"「う～んいい天気だね。適度にディルネス\n"
"　と一緒に、お散歩行きたいな。"
msgstr ""
"斯蒂莱「嗯～天气真好呢。\n"
"想适度和迪尔内斯　一起散散步呢。"

#. ID 3, Page 2, Line 14, Pos (21,45)
msgid ""
"スティライ\n"
"「フェリスは何を考えているんだろう…。\n"
"　あの子は町づくりなんて…。"
msgstr ""
"斯蒂莱「菲莉丝在想什么呢……。\n"
"　那孩子居然搞城镇建设什么的……。"

#. ID 3, Page 2, Line 18, Pos (21,45)
msgid ""
"スティライ\n"
"「でもそれで幸せなら…いいかな。"
msgstr "斯蒂莱「不过如果那样她幸福的话……也好吧。"

#. ID 3, Page 2, Line 24, Pos (21,45)
msgid ""
"スティライ\n"
"「今でも絵画にいた頃のあの感じが、\n"
"　ふと蘇っちゃうことがあるんだよね。"
msgstr ""
"斯蒂莱「直到现在，待在画里时的那种感觉，\n"
"　还会突然复苏过来呢。"

#. ID 3, Page 2, Line 28, Pos (21,45)
msgid ""
"スティライ\n"
"「記憶も曖昧なままだし…\n"
"　せめて記憶さえ戻ればなぁ。"
msgstr ""
"斯蒂莱「记忆也还是模糊的……\n"
"　起码要是记忆能恢复就好了。"

#. ID 3, Page 2, Line 35, Pos (21,45)
msgid ""
"スティライ\n"
"「前まではディルネスと一緒に旅してたん\n"
"　だよねぇ。また行きたいな～。"
msgstr ""
"斯蒂莱「以前一直和迪尔内斯一起旅行来着。\n"
"　还想再去啊～。"

#. ID 3, Page 2, Line 42, Pos (21,45)
msgid ""
"スティライ\n"
"「町が少し大きくなったから、\n"
"　これからは施設も作っていかないとね。"
msgstr ""
"斯蒂莱「城镇变大了一点，\n"
"　今后也得建造设施才行呢。"

#. ID 3, Page 3, Line 7, Pos (21,45)
msgid ""
"スティライ\n"
"「みんなで頑張って、\n"
"　町を発展させましょうね♪"
msgstr "斯蒂莱「大家一起努力，　发展城镇吧♪"

#. ID 3, Page 3, Line 14, Pos (21,45)
msgid ""
"スティライ\n"
"「うとうと……"
msgstr "斯蒂莱「打瞌睡……"

#. ID 3, Page 3, Line 17, Pos (21,45)
msgid ""
"スティライ\n"
"「はっ！！！"
msgstr "斯蒂莱「哈！！！"

#. ID 3, Page 3, Line 20, Pos (21,45)
msgid ""
"スティライ\n"
"「いけないいけない。仕事仕事。"
msgstr "斯蒂莱「不行不行。工作工作。"

#. ID 3, Page 3, Line 26, Pos (21,45)
msgid ""
"スティライ\n"
"「ブツブツ……"
msgstr "斯蒂莱「碎碎念……"

#. ID 3, Page 3, Line 29, Pos (21,45)
msgid ""
"スティライ\n"
"「あっ！\\|ご、\\.ごめんなさい。\n"
"　ちょっと考え事してました。"
msgstr "斯蒂莱「啊！\\|对、\\.对不起。　我刚才在想事情。"

#. ID 3, Page 3, Line 36, Pos (21,45)
msgid ""
"スティライ\n"
"「施設を作るのにもお金が必要だよ。\n"
"　町を広げるだけじゃ駄目だから、\n"
"　気を付けてね。"
msgstr ""
"斯蒂莱「建造设施也需要金钱哦。\n"
"　只扩大城镇是不行的，　要注意哦。"

#. ID 4, Page 1, Line 4, Pos (47,45)
msgid ""
"ディルネス\n"
"「で、今日はどんな入用？"
msgstr "迪尔内斯「那么，今天有什么需要？"

#. ID 4, Page 1, Line 9, Pos (47,45)
#. Choice (4 options)
msgid ""
"ここはなに？\n"
"開発資金の寄付をしたい\n"
"開発資金の納付総額を知りたい\n"
"他の事を話す"
msgstr ""
"这里是什么？\n"
"我想捐赠开发资金\n"
"我想了解开发资金的缴纳总额\n"
"谈别的事"

#. ID 4, Page 1, Line 14, Pos (47,45)
msgid ""
"ディルネス\n"
"「ここでは開発資金の寄付と簡単なお店を\n"
"　覗けるわよ。基本は寄付だけどね。"
msgstr ""
"迪尔内斯「在这里可以捐赠开发资金，\n"
"还能看看简单的小店　哦。主要还是捐赠就是了。"

#. ID 4, Page 1, Line 18, Pos (47,45)
msgid ""
"ディルネス\n"
"「町の開発には人手も必要だけど、\n"
"　何より必要なのはお金よ。\\|\n"
"　これだけは外せないわね。"
msgstr ""
"迪尔内斯「城镇的开发也需要人手，\n"
"　但最需要的是金钱哦。\\|　唯独这一点不能少呢。"

#. ID 4, Page 1, Line 23, Pos (47,45)
msgid ""
"ディルネス\n"
"「私のところで渡された開発資金は、後で\n"
"　スティライのところで使われるわ。"
msgstr ""
"迪尔内斯「交到我这里的开发资金，\n"
"之后会在　斯蒂莱那里使用。"

#. ID 4, Page 1, Line 27, Pos (47,45)
msgid ""
"ディルネス\n"
"「『総額』と『残り額』は意味が違うから\n"
"　気を付けてよね！開発資金は当然開発を\n"
"　すすめると無くなるから。"
msgstr ""
"迪尔内斯「『总额』和『剩余额』的意思不同，\n"
"　要注意哦！\n"
"　开发资金当然会随着推进开发　而用完。"

#. ID 4, Page 1, Line 32, Pos (47,45)
msgid ""
"ディルネス\n"
"「あとはお店だけど、これはほんとに簡素\n"
"　なものを売るためのお店よ。まぁ流通が\n"
"　進めばもうちょっとよくなるかも。"
msgstr ""
"迪尔内斯「剩下就是小店了，\n"
"这里真的只是卖简朴　东西的店哦。嘛，\n"
"　等流通　进步了也许能稍微变好一点。"

#. ID 4, Page 1, Line 37, Pos (47,45)
msgid ""
"ディルネス\n"
"「お金の使いすぎには気を付けることね！\n"
"　寄付したお金は戻ってこないから！"
msgstr ""
"迪尔内斯「要注意别过度使用金钱哦！\n"
"　捐出去的金钱是不会回来的！"

#. ID 4, Page 1, Line 53, Pos (47,45)
msgid ""
"ディルネス\n"
"「開発資金の今の寄付総額は、\n"
"　\\v[1536]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]Gだよ。\n"
"　いくら寄付するの？"
msgstr ""
"迪尔内斯「开发资金现在的捐赠总额是，\n"
"　\\v[1536]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]\n"
"　G哦。　你要捐赠多少？"

#. ID 4, Page 1, Line 59, Pos (47,45)
msgid ""
"ディルネス\n"
"「開発資金の今の寄付総額は、\n"
"　\\v[1537]Gだよ。\n"
"　いくら寄付するの？"
msgstr ""
"迪尔内斯「开发资金现在的捐赠总额是，\n"
"　\\v[1537]G哦。　你要捐赠多少？"

#. ID 4, Page 1, Line 69, Pos (47,45)
msgid ""
"いくら寄付しようか？\n"
"(0Gで寄付をやめる)"
msgstr "要捐赠多少呢？(0G则停止捐赠)"

#. ID 4, Page 1, Line 74, Pos (47,45)
#. Contains choice at line 2 (2 options)
msgid "寄付するのをやめる？"
msgstr "要停止捐赠吗？"

#. ID 4, Page 1, Line 80, Pos (47,45)
msgid ""
"ディルネス\n"
"「寄付をやめるのね。\\|わかったわ。\\!\n"
"　また余裕があるときに来てね。"
msgstr ""
"迪尔内斯「你要停止捐赠呢。\\|我知道了。\n"
"\\!　等手头宽裕时再来哦。"

#. ID 4, Page 1, Line 90, Pos (47,45)
#. Contains choice at line 2 (2 options)
msgid "\\v[1515]G寄付でいい？"
msgstr "捐赠\\v[1515]G可以吗？"

#. ID 4, Page 1, Line 96, Pos (47,45)
msgid ""
"ディルネス\n"
"「\\v[1515]G寄付するのね。\n"
"　わかったわ！"
msgstr "迪尔内斯「你要捐赠\\v[1515]G呢。　我知道了！"

#. ID 4, Page 1, Line 121, Pos (47,45)
msgid ""
"ディルネス\n"
"「おっけ～。\\|たしかに預かったわ。\\!\n"
"　あとでフェリスに渡しておくわね。"
msgstr ""
"迪尔内斯「好～的。\\|确实收到了。\n"
"\\!　之后会交给费利斯的哦。"

#. ID 4, Page 1, Line 127, Pos (47,45)
msgid ""
"ディルネス\n"
"「ってちょっと！\\|お金足りないじゃない！\n"
"　寄付するのはいいけど、\n"
"　程々にしなさいよね！"
msgstr ""
"迪尔内斯「喂等等！\\|金钱不够啊！　捐赠是可以，\n"
"　但要有分寸哦！"

#. ID 4, Page 1, Line 153, Pos (47,45)
msgid ""
"ディルネス\n"
"「開発資金の今の寄付総額は、\n"
"　\\v[1536]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]Gだよ。"
msgstr ""
"迪尔内斯「开发资金现在的捐赠总额是，\n"
"　\\v[1536]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]\n"
"　G哦。"

#. ID 4, Page 1, Line 158, Pos (47,45)
msgid ""
"ディルネス\n"
"「開発資金の今の寄付総額は、\n"
"　\\v[1537]Gだよ。"
msgstr ""
"迪尔内斯「开发资金现在的捐赠总额是，\n"
"　\\v[1537]G哦。"

#. ID 4, Page 1, Line 165, Pos (47,45)
#. Choice (4 options)
msgid ""
"雑談したい\n"
"今の品ぞろえは？\n"
"ほかの事を話す\n"
"とくにない"
msgstr ""
"想闲聊\n"
"现在的商品种类是？\n"
"谈别的事\n"
"没什么特别"

#. ID 4, Page 1, Line 173, Pos (47,45)
msgid ""
"ディルネス\n"
"「今の品ぞろえはこんな感じだよ。"
msgstr "迪尔内斯「现在的商品种类是这样的哦。"

#. ID 4, Page 1, Line 177, Pos (47,45)
msgid ""
"ディルネス\n"
"「まいど～も。\\!\n"
"　え、\\.ガラクタしかないって？"
msgstr "迪尔内斯「欢迎光临～。\\!　诶，\\.只有破烂吗？"

#. ID 4, Page 1, Line 181, Pos (47,45)
msgid ""
"ディルネス\n"
"「しょ～がないでしょ！\\|\n"
"　物流がまだ悪いの！"
msgstr "迪尔内斯「那也没办法吧！\\|　物流还不太好嘛！"

#. ID 4, Page 1, Line 192, Pos (47,45)
msgid ""
"ディルネス\n"
"「そっか。\\|じゃあまたね。"
msgstr "迪尔内斯「这样啊。\\|那就再见啦。"

#. ID 4, Page 2, Line 7, Pos (47,45)
msgid ""
"ディルネス\n"
"「ここは静かなところね。\n"
"　他はもっと殺伐としてるから…。"
msgstr ""
"迪尔内斯「这里是个安静的地方呢。\n"
"　其他地方更加杀气腾腾的…。"

#. ID 4, Page 2, Line 14, Pos (47,45)
msgid ""
"ディルネス\n"
"「フェリスはいっつも何考えてるか\n"
"　分からないわ。スティライもだけど。"
msgstr ""
"迪尔内斯\n"
"「费利斯总是让人搞不懂她到底在想什么　呢。\n"
"　斯蒂莱也是。"

#. ID 4, Page 2, Line 18, Pos (47,45)
msgid ""
"ディルネス\n"
"「でもどこか二人とも放っておけないの\n"
"　よね…。\\|なんでだろ。"
msgstr ""
"迪尔内斯「但不知为何，\n"
"两个人都让人放心不下　呢…。\\|为什么呢。"

#. ID 4, Page 2, Line 25, Pos (47,45)
msgid ""
"ディルネス\n"
"「フェリスとスティライとは長い付き合い\n"
"　なのは間違いないんだけど…。"
msgstr ""
"迪尔内斯「和费利斯、\n"
"斯蒂莱有着很长交情　这一点是没错的…。"

#. ID 4, Page 2, Line 29, Pos (47,45)
msgid ""
"ディルネス\n"
"「どうしてここに来るまでに、鏡の中に\n"
"　閉じ込められてたんだろ。\n"
"　ど～しても思い出せないのよねぇ。"
msgstr ""
"迪尔内斯「为什么在来到这里之前，\n"
"会被关在镜子　里呢。　怎么～都想不起来呢。"

#. ID 4, Page 2, Line 37, Pos (47,45)
msgid ""
"ディルネス\n"
"「元商売人としてはこういうことするの\n"
"　も悪くはないわね。"
msgstr "迪尔内斯「作为曾经的商人，做这种事　也不坏呢。"

#. ID 4, Page 2, Line 44, Pos (47,45)
msgid ""
"ディルネス\n"
"「仕入れルートがあれば、施設の品も良く\n"
"　なるから定期的に覗くといいよ。\n"
"　"
msgstr ""
"迪尔内斯「如果有进货渠道，\n"
"设施里的商品也会变得更　好，所以定期来看看哦。"

#. ID 4, Page 3, Line 7, Pos (47,45)
msgid ""
"ディルネス\n"
"「町づくりはいいけど、\n"
"　なんで私が財務係なんだろ…"
msgstr ""
"迪尔内斯「建设城镇是好事，\n"
"　但为什么我是财务负责人呢…"

#. ID 4, Page 3, Line 11, Pos (47,45)
msgid ""
"ディルネス\n"
"「ちょっとぐらい拝借しても…"
msgstr "迪尔内斯「稍微借用一点应该也…"

#. ID 4, Page 3, Line 14, Pos (47,45)
msgid ""
"ディルネス\n"
"「いや、ダメダメダメ。\n"
"　なにされるかわかったものじゃない…！"
msgstr ""
"迪尔内斯「不，不行不行不行。\n"
"　不知道会被怎么样…！"

#. ID 4, Page 3, Line 21, Pos (47,45)
msgid ""
"ディルネス\n"
"「今日も一日頑張っていきますか！"
msgstr "迪尔内斯「今天也要努力干一天啊！"

#. ID 4, Page 3, Line 27, Pos (47,45)
msgid ""
"ディルネス\n"
"「ひぃ…ふぅ…みぃ…"
msgstr "迪尔内斯「一…二…三…"

#. ID 4, Page 3, Line 30, Pos (47,45)
msgid ""
