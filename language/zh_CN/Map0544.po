#. ID 49, Page 1, Line 3, Pos (13,26)
msgid ""
"何か、声が漏れてくる……。\\!\n"
"\n"
"声は試験室から聞こえてくるみたいだ。"
msgstr ""
"有什么声音传出来……。\n"
"\\!声音好像是从考试室传来的。"

#. ID 49, Page 1, Line 7, Pos (13,26)
#. Choice (3 options)
msgid ""
"覗く\n"
"こっそり覗く\n"
"堂々と男らしく覗く"
msgstr ""
"偷看\n"
"偷偷地看\n"
"堂堂正正地像个男人一样看"

#. ID 50, Page 1, Line 1, Pos (34,5)
msgid ""
"声が漏れてくる……。\\!\n"
"\n"
"つぐみの声と、複数の男の声。"
msgstr ""
"声音传出来……。\\!是鸫的声音，\n"
"还有多个男人的声音。"

#. ID 50, Page 1, Line 5, Pos (34,5)
msgid ""
"どうする？\\!\n"
"\n"
"また覗いてみる？"
msgstr "怎么办？\\!要再看看吗？"

#. ID 50, Page 1, Line 9, Pos (34,5)
#. Choice (4 options)
msgid ""
"覗く\n"
"こっそり覗く\n"
"堂々と女らしく覗く\n"
"プライバシーの侵害だ"
msgstr ""
"偷看\n"
"偷偷地看\n"
"堂堂正正地像个女人一样看\n"
"这是侵犯隐私"

#. ID 50, Page 1, Line 20, Pos (34,5)
msgid "……やめておこう"
msgstr "……还是算了吧"

#. ID 50, Page 3, Line 1, Pos (34,5)
msgid ""
"声が漏れてくる……。\\!\n"
"\n"
"つぐみと、○リーパーの声だ。"
msgstr "声音传出来……。\\!是鸫和○收割者的声音。"

#. ID 50, Page 3, Line 9, Pos (34,5)
msgid ""
"会いたかったです○リーパーさま……。\\!\n"
"わたし、頑張ったんですよ？\n"
"いまから成果を見せますね……。"
msgstr ""
"好想见您啊○收割者大人……。\\!我，很努力了哦？\n"
"现在就给您看成果呢……。"

#. ID 50, Page 3, Line 13, Pos (34,5)
msgid ""
"○リーパー「フヒヒッ！\n"
"　　　　　　それは楽しみなんだな！\\!\n"
"　　　　　　久しぶりにどれだけ上達したか\n"
"　　　　　　確かめてやるんだな！！」"
msgstr ""
"○收割者「嘻嘻嘻！\n"
"　　　　　　那真是期待啊！\\!\n"
"　　　　　　好久没见，到底进步了多少\n"
"　　　　　　就让我来确认一下吧！！」"

#. ID 50, Page 3, Line 18, Pos (34,5)
msgid "あっ、○リーパーさまぁ、嬉しいです……。"
msgstr "啊，○收割者大人，好高兴……。"

#. ID 50, Page 3, Line 27, Pos (34,5)
msgid ""
"きもひいいでふか？\n"
"（気持ちいいですか？）"
msgstr "舒、舒服吗？（舒服吗？）"

#. ID 50, Page 3, Line 30, Pos (34,5)
msgid ""
"○リーパー「うくっ！\n"
"　　　　　　こ、これはたまらないんだなー！！」"
msgstr ""
"○收割者「呜咕！\n"
"　　　　　　这、这真是让人受不了啊——！！」"

#. ID 50, Page 3, Line 46, Pos (34,5)
msgid ""
"○リーパーさま。\n"
"わたし、うまくなってますか？"
msgstr "○收割者大人。我、有变得更熟练了吗？"

#. ID 50, Page 3, Line 49, Pos (34,5)
msgid ""
"○リーパー「元から凄かったけど、\n"
"　　　　　　更に良くなったんだな！\\!\n"
"　　　　　　流石はボクの性奴隷なんだな！」"
msgstr ""
"○收割者「本来就很厉害，\n"
"　　　　　　但变得更好了啊！\\!\n"
"　　　　　　不愧是我的性奴隶啊！」"

#. ID 50, Page 3, Line 54, Pos (34,5)
msgid "じゃあもっと続けますね……"
msgstr "那我就继续更多了哦……"

#. ID 50, Page 3, Line 56, Pos (34,5)
msgid ""
"○リーパー「フヒヒッ！\n"
"　　　　　　いいんだな！！\n"
"　　　　　　淫乱なお前の気が\n"
"　　　　　　済むまでやればいいんだな！」"
msgstr ""
"○收割者「嘻嘻嘻！\n"
"　　　　　　可以吧！！\n"
"　　　　　　直到淫乱的你满足为止，\n"
"　　　　　　做下去就可以了吧！」"

#. ID 50, Page 3, Line 69, Pos (34,5)
msgid "んっ、んっむ、ちゅばっ"
msgstr "嗯、嗯唔、啾啪"

#. ID 50, Page 3, Line 71, Pos (34,5)
msgid ""
"○リーパー「うくっ！\n"
"　　　　　　ま、またイッてしまうんだなー！！」"
msgstr ""
"○收割者「呜咕！\n"
"　　　　　　又、又要高潮了啊——！！」"

#. ID 50, Page 3, Line 86, Pos (34,5)
msgid "こうかはばつぐんだ！"
msgstr "效果拔群！"

#. ID 50, Page 3, Line 89, Pos (34,5)
msgid ""
"感じて欲しいのはわたしの手や口だけじゃ\n"
"ないんですよ。\\!\n"
"もっともっと全身でわたしを感じて、\n"
"イッてほしいです……"
msgstr ""
"我想让你感受的，不只是我的手和嘴哦。\n"
"\\!希望你用全身更多更多地感受我，然后高潮……"

#. ID 50, Page 3, Line 94, Pos (34,5)
msgid ""
"○リーパー「な、なんだかモノが\n"
"　　　　　　全然おさまらないんだな！\\!\n"
"　　　　　　こうなったら\n"
"　　　　　　い、いけるトコまでイってやるんだな！」"
msgstr ""
"○收割者「总、总觉得那东西\n"
"　　　　　　完全平息不下来啊！\\!\n"
"　　　　　　既然这样\n"
"　　　　　　就、就做到能做的极限吧！」"

#. ID 50, Page 3, Line 99, Pos (34,5)
msgid "……あ、っはああぁぁんっ……！"
msgstr "……啊、哈啊啊啊啊嗯……！"

#. ID 50, Page 3, Line 121, Pos (34,5)
msgid ""
"○リーパー「フ、フヒヒッ！\n"
"　　　　　　ま、またイクんだなぁっ！！」"
msgstr ""
"○收割者「呼、呼嘻嘻！\n"
"　　　　　　又、又要高潮了啊！！」"

#. ID 50, Page 3, Line 137, Pos (34,5)
msgid ""
"あああああっっ！\\!\n"
"出てる……つぐみの中に\n"
"いっぱい出てるぅ……"
msgstr "啊啊啊啊啊！\\!射出来了……在鸫体内射了好多……"

#. ID 50, Page 3, Line 142, Pos (34,5)
msgid ""
"○リーパー「ふ、ふ～。\\!\n"
"　　　　　　あ、あれ？\n"
"　　　　　　本当に全然おさまらないんだな」"
msgstr ""
"○收割者「呼、呼～。\\!\n"
"　　　　　　啊、咦？\n"
"　　　　　　真的一点都平息不下来啊」"

#. ID 50, Page 3, Line 147, Pos (34,5)
msgid ""
"……あぁんっ……！\n"
"ダメですよ○リーパーさま。\\!\n"
"もっともっと逝ってもらわないと……"
msgstr ""
"……啊嗯……！不行的哦○收割者大人。\n"
"\\!不多多高潮可不行……"

#. ID 50, Page 3, Line 163, Pos (34,5)
msgid "○リーパー「フ、フフヒフヒヒヒヒィ！！？？」"
msgstr "○收割者「呼、呼呼嘻呼嘻嘻嘻嘻嘻！！？？」"

#. ID 50, Page 3, Line 173, Pos (34,5)
msgid ""
"○リーパー「フ、フヒヒッ！\n"
"　　　　　　ま、またイク……っ！？」"
msgstr ""
"○收割者「呼、呼嘻嘻！\n"
"　　　　　　又、又要高潮……！？」"

#. ID 50, Page 3, Line 188, Pos (34,5)
msgid ""
"つぐみ「ダメですよ。\\!\n"
"　　　　終わらせませんよ。\\!\n"
"　　　　出してください。\\!\n"
"　　　　一滴も残さない…………！！！」"
msgstr ""
"鸫「不行的哦。\\!\n"
"　　　　不会让你结束的哦。\\!\n"
"　　　　请射出来。\\!\n"
"　　　　一滴都不留…………！！！」"

#. ID 50, Page 3, Line 194, Pos (34,5)
msgid "○リーパー「？！？！？！？？？！！！？！！？」"
msgstr "○收割者「？！？！？！？？？！！！？！！？」"

#. ID 50, Page 3, Line 197, Pos (34,5)
msgid ""
"○リーパー「あがあがああっ！！\n"
"　　　　　　いだいいだいだだだだっ！？！」"
msgstr ""
"○收割者「啊嘎啊嘎啊啊！！\n"
"　　　　　　好痛好痛痛痛痛痛！！？！」"

#. ID 50, Page 3, Line 200, Pos (34,5)
msgid ""
"○リーパー「あうあああうあうああっ！？！\n"
"　　　　　　ひぐぅぎえええあああいいぃっ！？！？」"
msgstr ""
"○收割者「啊呜啊啊啊呜啊呜啊啊！！？\n"
"　　　　　　呜咕呜叽诶诶诶啊啊啊咿咿！？！？」"

#. ID 50, Page 3, Line 203, Pos (34,5)
msgid ""
"○リーパー「やめっ！！？\n"
"　　　　　　ぎぎょあああっ！？\n"
"　　　　　　やめでっぇっ！？！」"
msgstr ""
"○收割者「停下！！？\n"
"　　　　　　叽叽哟啊啊啊！？\n"
"　　　　　　停下啊！？！」"

#. ID 50, Page 3, Line 208, Pos (34,5)
msgid ""
"まだイケますよね？\\!\n"
"終わらせませんよ。\\!\n"
"おさまらないんですよね？\\!\n"
"もっともっと出してくださいね……！！"
msgstr ""
"还能高潮吧？\\!不会让你结束的哦。\n"
"\\!还没平息下来对吧？\\!请更多更多地射出来哦……！\n"
"！"

#. ID 50, Page 3, Line 214, Pos (34,5)
msgid ""
"○リーパー「ぐぎいぇぇえっ！？！？\n"
"　　　　　　なっ、なんでなん……！？！！\\!\n"
"　　　　　　なんっぐあああがががぐっ！？！？」"
msgstr ""
"○收割者「咕叽咿诶诶！？！？\n"
"　　　　　　为、为什么……！？！！\\!\n"
"　　　　　　什么咕啊啊啊啊嘎嘎嘎咕！？！？」"

#. ID 50, Page 3, Line 218, Pos (34,5)
msgid ""
"○リーパー「さっ、さいみぐぎっ！？\n"
"　　　　　　あがあああがああっ！！\\!\n"
"　　　　　　いだいださいみだっ！？！\n"
"　　　　　　ぎゃああああああああぁぁっ！？！！」"
msgstr ""
"○收割者「快、快催眠咕叽！？\n"
"　　　　　　啊嘎啊啊啊嘎啊啊！！\\!\n"
"　　　　　　好痛好痛，快催眠啊！？！\n"
"　　　　　　呀啊啊啊啊啊啊啊啊啊啊！？！！」"

#. ID 50, Page 3, Line 223, Pos (34,5)
msgid ""
"○リーパー「おごおぉぉぶおっ！？\n"
"　　　　　　あがっあがっあがああっ！！\\!\n"
"　　　　　　いだいいだいだだだだっ！？！\n"
"　　　　　　ぎゅあああああああぁぁっ！？！！」"
msgstr ""
"○收割者「呜噢噢噢呜噢！？\n"
"　　　　　　啊嘎、啊嘎、啊嘎啊啊！！\\!\n"
"　　　　　　好痛好痛痛痛痛痛！？！\n"
"　　　　　　咕呀啊啊啊啊啊啊啊啊！？！！」"

#. ID 50, Page 3, Line 228, Pos (34,5)
msgid "………………。"
msgstr "………………。"

#. ID 50, Page 3, Line 230, Pos (34,5)
msgid "…………まあ、死に方としては、本望だろう。"
msgstr "…………嘛，作为死法，算是如愿以偿了吧。"

#. ID 50, Page 3, Line 231, Pos (34,5)
msgid "私はその場をあとにした。"
msgstr "我离开了那个地方。"

#. ID 50, Page 3, Line 243, Pos (34,5)
msgid ""
"翌朝。\\!\n"
"干乾びてぼろぼろの○リーパーが見つかった。\\!\n"
"自分が何故こうなったかは覚えていなかったらしい。"
msgstr ""
"第二天早上。\n"
"\\!人们发现了干瘪而破破烂烂的○收割者。\n"
"\\!他似乎不记得自己为什么会变成这样。"
