#. ID 2, Page 1, Line 3, Pos (6,11)
msgid ""
"わたしハ\n"
"ダイジョーブはかせ　ノ　ちゅうじつナ　しもべ\n"
"じょしゅノ　「ゲドー」　デス"
msgstr ""
"我 是 没问题博士 的 忠实 的 助手 的 「盖德」\n"
" 是也"

#. ID 2, Page 1, Line 6, Pos (6,11)
msgid ""
"ダイジョーブはかせノ　オカゲデ\n"
"わたしモ　コンナニ　ぱわーあっぷ　シマシタ　デス"
msgstr "多亏 没问题博士 ，我 也 变得 这么 强 了 是也"

#. ID 2, Page 1, Line 9, Pos (6,11)
msgid ""
"……オヤ\n"
"改造サレスギテ　でちゅーん　状態デスネ"
msgstr "……哎呀 改造得 太过了 呢 状态 呢"

#. ID 2, Page 1, Line 14, Pos (6,11)
msgid ""
"……オヤ\n"
"アナタモ　ダイブ　ぱわーあっぷ　シテマスネ"
msgstr "……哎呀 你 也 相当 变强 了 呢"

#. ID 2, Page 1, Line 19, Pos (6,11)
msgid ""
"……オヤ\n"
"アナタニモ　ソノ素質　アリソウ　デス"
msgstr "……哎呀 你 也 似乎 有 那种 素质 呢"

#. ID 2, Page 2, Line 3, Pos (6,11)
msgid ""
"おやおや\n"
"……カワイソーに"
msgstr "哎呀呀……真可怜"

#. ID 6, Page 1, Line 3, Pos (10,10)
#. ID 6, Page 2, Line 3, Pos (10,10)
#. ID 6, Page 3, Line 3, Pos (10,10)
#. ID 6, Page 4, Line 8, Pos (10,10)
msgid ""
"ワタシハ世界的すぽーつ医学ノ権威\n"
"ダイジョーブ博士　デース！"
msgstr ""
"我 是 世界级 运动医学 的 权威 没问题博士 是也\n"
"！"

#. ID 6, Page 1, Line 5, Pos (10,10)
msgid ""
"アタナハ今ノ自分ニ不満デスネ？\n"
"デモ、モウダイジョーブ！\n"
"アナタヲぱわーあっぷシテアゲマショー！"
msgstr ""
"你 对 现在的 自己 不满 吧？但是，\n"
"已经 没问题了！让 我 来 让 你 变强 吧！"

#. ID 6, Page 1, Line 8, Pos (10,10)
#. Choice (2 options)
msgid ""
"試してみる\n"
"冗談じゃない"
msgstr ""
"试试看\n"
"开什么玩笑"

#. ID 6, Page 2, Line 5, Pos (10,10)
#. ID 6, Page 3, Line 5, Pos (10,10)
msgid ""
"ヤアヤア、あなたデスカ！\n"
"マタ体ヲイジッテホシイノデスカ？\n"
"イクラデモ改造シテアゲマショー！"
msgstr ""
"呀呀，是 你 啊！又 想 让 我 摆弄 身体 吗？\n"
"多少 次 都 可以 给 你 改造 哦！"

#. ID 6, Page 2, Line 8, Pos (10,10)
#. Choice (2 options)
#. ID 6, Page 3, Line 8, Pos (10,10)
#. Choice (2 options)
msgid ""
"お願いします\n"
"今日は遠慮する"
msgstr ""
"拜托了\n"
"今天就不用了"

#. ID 6, Page 3, Line 40, Pos (10,10)
msgid ""
"イツモ貴重ナでーたアリガトウゴザイマース！\n"
"今日モ好キナダケ改造サレテイッテクダサーイ！\n"
"さーびすシマスヨー！"
msgstr ""
"一直 感谢 你 提供 珍贵 的 数据！\n"
"今天 也 请 尽情 接受 改造 吧！\n"
"会 好好 服务 的哦！"

#. ID 6, Page 3, Line 43, Pos (10,10)
#. Choice (2 options)
msgid ""
"機械で……\n"
"触手で……"
msgstr ""
"用机械……\n"
"用触手……"

#. ID 6, Page 4, Line 10, Pos (10,10)
msgid "オヤ……アナタハ奴隷ナンデスネー！"
msgstr "哎呀……你 是 奴隶 呢！"

#. ID 6, Page 4, Line 11, Pos (10,10)
msgid ""
"アタナハ奴隷デアル自分ニ不満デスネ？\n"
"デモ、モウダイジョーブ！\n"
"ワタシガアナタノ奴隷ノ借金ヲ\n"
"返シテオイテアゲマショー！！"
msgstr ""
"你 对 身为 奴隶 的 自己 不满 吧？但是，\n"
"已经 没问题了！\n"
"我 来 替 你 把 奴隶 的 负债 还清 吧！！"

#. ID 6, Page 4, Line 15, Pos (10,10)
msgid ""
"\n"
"　　　　　　　タ　　ダ　　シ　　！　！"
msgstr "　　　　　　　但　　是　　！　！"

#. ID 6, Page 4, Line 17, Pos (10,10)
#. Contains choice at line 3 (2 options)
msgid ""
"代ワリニワタシニ人体改造サセテクダサーイ！\n"
"色々試シテミタイノデース！"
msgstr ""
"作为 交换，请 让 我 进行 人体改造 吧！\n"
"我 想 尝试 各种 东西 呢！"

#. ID 6, Page 4, Line 19, Pos (10,10)
#. Choice (2 options, embedded in a message)
#. ID 10, Page 1, Line 8, Pos (13,11)
#. Choice (2 options)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 6, Page 4, Line 23, Pos (10,10)
msgid ""
"ワカリマシター！\n"
"アナタハコレカラ晴レテ自由ノ身デース！\n"
"自由ニナレマース！"
msgstr ""
"明白 了！\n"
"你 从 现在 起 就 光明正大 地 是 自由 之身 了！\n"
"可以 自由 了！"

#. ID 6, Page 4, Line 26, Pos (10,10)
msgid "デハ約束ノ人体改造ヲハジメマース！"
msgstr "那么，开始 约定 的 人体改造 吧！"

#. ID 6, Page 4, Line 27, Pos (10,10)
#. ID 34, Page 6, Line 27, Pos (0,2)
#. ID 38, Page 6, Line 22, Pos (0,3)
#. ID 42, Page 6, Line 31, Pos (1,2)
#. ID 43, Page 1, Line 24, Pos (0,5)
#. ID 43, Page 2, Line 26, Pos (0,5)
msgid ""
"コレカラ先ハ、トテモ危険ナ作業ガ行ワレマース！\n"
"心ヲシッカリ保ツノデスヨ！\n"
"イキマスヨォォォォォ・・・"
msgstr ""
"接下来，将 进行 非常 危险 的 作业！\n"
"要 好好 保持 内心 哦！要 开始 了哦哦哦哦哦……"

#. ID 6, Page 4, Line 87, Pos (10,10)
msgid ""
"私ノ科学ニハ不可能ハ無イデース！\n"
"ソシテオメデトウ！\n"
"アナタハコレデ自由ノ身デース！"
msgstr ""
"我 的 科学 里 没有 不可能！然后 恭喜！\n"
"你 这样 就 是 自由 之身 了！"

#. ID 6, Page 4, Line 106, Pos (10,10)
msgid "………"
msgstr "………"

#. ID 6, Page 4, Line 107, Pos (10,10)
msgid ""
"＊身体中がおかしい……\n"
"　まるで、男に数人がかりで犯された後のような、\n"
"　猛烈な気だるさを感じる。"
msgstr ""
"＊全身 都 不对劲……\n"
"　简直 像 被 好几个 男人 一起 侵犯 之后 那样，\n"
"　感到 猛烈 的 倦怠感。"

#. ID 6, Page 4, Line 110, Pos (10,10)
msgid ""
"＊同時に、身体が変調をきたしているのを感じた……\n"
"　明らかに、体の調子がおかしい……。"
msgstr ""
"＊同时，我 感觉 到 身体 出现 了 状态异常……\n"
"　明显，身体 的 状况 不对劲……。"

#. ID 6, Page 4, Line 112, Pos (10,10)
msgid ""
"＊しかし、首輪は外されていた。\n"
"　晴れて\\n[\\v[6]]は、自由の身だ……！"
msgstr ""
"＊但是，项圈 已经 被 取下 了。\n"
"　光明正大地\\n[\\v[6]]已经 是 自由 之身 了……！"

