#. ID 10, Page 1, Line 12, Pos (12,3)
#. Contains choice at line 2 (3 options)
msgid "住人「休んでいくのかい？」"
msgstr "居民「要休息一下再走吗？」"

#. ID 10, Page 1, Line 13, Pos (12,3)
#. Choice (3 options, embedded in a message)
msgid ""
"休む　(金：\\v[1201])\n"
"隣の光ってるの何？\n"
"なんでもない"
msgstr ""
"休息　(金钱：\\v[1201])\n"
"旁边发光的是什么？\n"
"没什么"

#. ID 10, Page 1, Line 18, Pos (12,3)
msgid ""
"住人\n"
"「ではごゆっくり～」"
msgstr "居民「那就请慢慢休息～」"

#. ID 10, Page 1, Line 23, Pos (12,3)
msgid ""
"住人\n"
"「お金が足りないよ。」"
msgstr "居民「金钱不够哦。」"

#. ID 10, Page 1, Line 29, Pos (12,3)
msgid ""
"住人\n"
"「これ？\\.　これは\\c[9]セーブ球\\c[0]だよ。\n"
"　回復とセーブをしてくれるんだ。"
msgstr ""
"居民「这个？\\.　这是\\c[9]存档球\\c[0]哦。\n"
"　它会帮你恢复和存档。"

#. ID 10, Page 1, Line 32, Pos (12,3)
msgid ""
"　だけど、回復は１回しかできないから注意してね。\n"
"　セーブは何回でもできるよ。」"
msgstr ""
"　不过，恢复只能做1次，所以要注意哦。\n"
"　存档可以做任意次。」"

#. ID 10, Page 1, Line 36, Pos (12,3)
msgid ""
"住人\n"
"「休みたくなったらいつでもどうぞ。」"
msgstr "居民「想休息的话随时都可以。」"

#. ID 11, Page 1, Line 3, Pos (3,12)
#. Contains choice at line 2 (3 options)
msgid "住人「なにが欲しいんだい？」"
msgstr "居民「你想要什么？」"

#. ID 11, Page 1, Line 4, Pos (3,12)
#. Choice (3 options, embedded in a message)
msgid ""
"通常の品\n"
"オススメの品\n"
"なんでもない"
msgstr ""
"普通商品\n"
"推荐商品\n"
"没什么"

#. ID 11, Page 1, Line 7, Pos (3,12)
msgid "住人「商品が増えたよ！」"
msgstr "居民「商品增加了哦！」"

#. ID 11, Page 1, Line 12, Pos (3,12)
#. ID 11, Page 1, Line 30, Pos (3,12)
#. ID 11, Page 1, Line 112, Pos (3,12)
msgid ""
"住人\n"
"「まいどあり！」"
msgstr "居民「多谢惠顾！」"

#. ID 11, Page 1, Line 18, Pos (3,12)
#. ID 11, Page 1, Line 36, Pos (3,12)
#. ID 11, Page 1, Line 122, Pos (3,12)
msgid ""
"住人\n"
"「また来てね！」"
msgstr "居民「下次再来哦！」"

#. ID 11, Page 1, Line 24, Pos (3,12)
msgid "住人「いいの揃ってるよ！」"
msgstr "居民「好东西都齐全哦！」"

#. ID 11, Page 1, Line 44, Pos (3,12)
msgid ""
"住人\n"
"「崖のモンスターは出血や麻痺、転倒なんかを\n"
"　付与してくるよ。"
msgstr ""
"居民「悬崖的怪物会附加出血、麻痹、\n"
"倒地之类的状态哦。"

#. ID 11, Page 1, Line 47, Pos (3,12)
msgid ""
"　湿原ではとにかく毒の対策が重要かな。\\!\n"
"　あ、あとはネバネバにはりつかれると\n"
"　動き辛くなるんだけど、\n"
"　\\c[11]脱がせの鬼\\c[0]ならキレイに落とせるんだ。"
msgstr ""
"　在湿原总之毒的对策很重要吧。\\!　啊，\n"
"　还有被黏黏的东西粘附的话　会变得难以行动，\n"
"　不过　\\c[11]脱衣鬼\\c[0]的话就能漂亮地弄掉。"

#. ID 11, Page 1, Line 51, Pos (3,12)
#. Contains choice at line 3 (2 options)
msgid ""
"　持っていないのなら売ってあげるよ。\n"
"　希少品だからちょっと値ははるけど。」"
msgstr ""
"　如果你没有的话我可以卖给你哦。\n"
"　因为是稀有品所以价格会有点高。」"

#. ID 11, Page 1, Line 53, Pos (3,12)
#. Choice (2 options, embedded in a message)
msgid ""
"売って\n"
"大丈夫"
msgstr ""
"卖给我\n"
"没关系"

#. ID 11, Page 1, Line 66, Pos (3,12)
#. ID 11, Page 1, Line 103, Pos (3,12)
msgid ""
"住人\n"
"「お金が足りないと思うんだよ。」"
msgstr "居民「我觉得金钱不够哦。」"

#. ID 11, Page 1, Line 73, Pos (3,12)
msgid ""
"住人\n"
"「これ以上は持てないと思うんだよ。」"
msgstr "居民「我觉得你不能再拿更多了哦。」"

#. ID 11, Page 1, Line 84, Pos (3,12)
msgid ""
"住人「１つ3000になるけど、何個いる？\n"
"　　　君が持てるのはあと\\v[1203]個、\n"
"　　　買えるのはあと\\v[1202]個までだよ。」"
msgstr ""
"居民「1个要3000，你要几个？\n"
"　　　你还能拿\\v[1203]个，\n"
"　　　最多还能买\\v[1202]个哦。」"

#. ID 11, Page 1, Line 89, Pos (3,12)
msgid ""
"住人\n"
"「やめるんだね。\n"
"　また欲しい時はいつでも言ってね！」"
msgstr "居民「你不买了吗。　想要的时候随时告诉我哦！」"

#. ID 11, Page 1, Line 97, Pos (3,12)
msgid ""
"住人\n"
"「持ちきれないと思うんだよ。」"
msgstr "居民「我觉得你拿不了那么多哦。」"

#. ID 11, Page 1, Line 116, Pos (3,12)
msgid ""
"住人\n"
"「欲しくなったらいつでも来てね！」"
msgstr "居民「想要的时候随时来哦！」"

#. ID 12, Page 1, Line 3, Pos (16,2)
msgid ""
"住人\n"
"「ようこそ！　SHOP「崖っぷち」へ！\\.\\.\n"
"　ゆっくり見ていってね！」"
msgstr ""
"居民「欢迎！　来到商店「悬崖边」！\n"
"\\.\\.　慢慢看吧！」"

#. ID 13, Page 1, Line 3, Pos (8,10)
msgid ""
"住人\n"
"「知ってる？\\.　滝の下には浮島があるんだ。\\!\n"
"　そこには時々\\c[11]ネバルーン\\c[0]が現れるんだよ。"
msgstr ""
"居民「你知道吗？\\.　瀑布下面有浮岛哦。\n"
"\\!　那里有时会出现\\c[11]黏黏气球\\c[0]哦。"

#. ID 13, Page 1, Line 6, Pos (8,10)
msgid ""
"　アレはしぶといんだ。\\.\\.\n"
"　倒しても倒しても、他の土地へ遊びに行ったりすると\n"
"　また復活してたりするからね。"
msgstr ""
"　那家伙很顽强。\\.\\.　就算打倒一次又一次，\n"
"　去其他土地玩的时候　又会复活过来呢。"

#. ID 13, Page 1, Line 9, Pos (8,10)
msgid ""
"　浮島から出てこないから、\n"
"　こっちに害とかは無いんだけどね。\\!\n"
"　もし君がアレを倒す事があれば、\n"
"　管理人さんに報告するといいかもよ？」"
msgstr ""
"　因为它不会从浮岛出来，\n"
"　所以不会对我们这边造成危害。\n"
"　\\!　如果你打倒那家伙的话，\n"
"　或许去报告给管理员比较好哦？」"

#. ID 13, Page 1, Line 15, Pos (8,10)
msgid ""
"住人\n"
"「今日はいつもよりジメジメしてるから、\n"
"　ネバルーンも出没しているかもね。」"
msgstr ""
"居民「今天比平时更潮湿，\n"
"　黏黏气球可能也会出没哦。」"

#. ID 14, Page 1, Line 3, Pos (16,16)
msgid ""
"住人\n"
"「お約束かもしれないけど、\n"
"　滝の裏には隠し部屋があったりするのよ。\n"
"　気になったところは探してみるといいわ。"
msgstr ""
"居民「虽然可能算是常见套路，\n"
"　瀑布后面有时会有隐藏房间哦。\n"
"　在意的地方可以找找看。"

#. ID 14, Page 1, Line 7, Pos (16,16)
msgid ""
"　それと、私たちと湿原のネバネーバ達は仲が悪いの。\n"
"　だから出会ってもすぐにケンカになるわ。\\!\n"
"　ちなみにあのネバネバは、\n"
"　私たちの身体にはりつく事はないわよ。」"
msgstr ""
"　还有，我们和湿原的黏黏怪们关系不好。\n"
"　所以一遇到马上就会打起来。\\!　顺便说，\n"
"　那些黏黏的东西，　不会粘附到我们的身体上哦。\n"
"　」"

#. ID 15, Page 1, Line 3, Pos (12,13)
msgid ""
"住人\n"
"「ぷはー！　やっぱりここの水はうまいね！\\.\\.\n"
"　あ、でも人間には毒だからね？"
msgstr ""
"居民「噗哈—！　这里的水果然好喝！\\.\\.　啊，\n"
"不过对人类来说是有毒的哦？"

#. ID 15, Page 1, Line 7, Pos (12,13)
msgid ""
"　あれ？　君は人間じゃなかったんだね。\n"
"　じゃあ飲んでも平気なのかな？\\.\\.\n"
"　……分かんないや。"
msgstr ""
"　咦？　原来你不是人类啊。　那喝了也没事吗？\n"
"　\\.\\.　……不知道呀。"

#. ID 15, Page 1, Line 12, Pos (12,13)
msgid ""
"　そうそう、毒といえば。\\.\\.\n"
"　湿原の沼地には長居しない方がいいよ。\n"
"　あの沼の毒は触るだけでも侵されちゃうからね。\\!\n"
"　ちなみに\\c[11]浮遊\\c[0]状態ならへっちゃらだよ。」"
msgstr ""
"　对对，说到毒。\n"
"　\\.\\.　最好不要在湿原的沼泽地久留哦。\n"
"　那沼泽的毒光是碰到就会被侵蚀呢。\n"
"　\\!　顺便说，\\c[11]浮游\\c[0]状态下就没事哦。\n"
"　」"

#. ID 16, Page 1, Line 4, Pos (10,30)
#. Choice (4 options)
msgid ""
"湿原について\n"
"湿原へ行くには？\n"
"薬草について\n"
"次へ"
msgstr ""
"关于湿原\n"
"去湿原怎么走？\n"
"关于药草\n"
"继续"

#. ID 16, Page 1, Line 6, Pos (10,30)
msgid ""
"管理人\n"
"「滝の下には湿原があるんだ。\n"
"　昔は色とりどりの草花が咲いていたんだけど、\n"
"　今はもう見る影もなくなっちゃったんだよね。"
msgstr ""
"管理员「瀑布下面有湿原。\n"
"　以前开着五颜六色的花草，\n"
"　但现在已面目全非了。"

#. ID 16, Page 1, Line 10, Pos (10,30)
msgid ""
"　まぁ今は今で、スライムが変異したネバネーバ達や、\n"
"　強力な解毒作用のある植物が生えたりと、\n"
"　興味深い生態系が作られてるけどね。」"
msgstr ""
"　不过现在也有现在的样子，\n"
"　史莱姆变异成的黏黏怪们，\n"
"　以及长出有强力解毒作用的植物等，\n"
"　　形成了有趣的生态系统呢。」"

#. ID 16, Page 1, Line 13, Pos (10,30)
#. ID 16, Page 1, Line 29, Pos (10,30)
#. ID 16, Page 1, Line 69, Pos (10,30)
#. ID 16, Page 1, Line 101, Pos (10,30)
#. ID 16, Page 1, Line 127, Pos (10,30)
#. ID 16, Page 1, Line 180, Pos (10,30)
msgid ""
"管理人\n"
"「他に聞きたい事はあるのかい？」"
msgstr "管理员「还有别的想问的事吗？」"

#. ID 16, Page 1, Line 18, Pos (10,30)
msgid ""
"管理人\n"
"「店の外に対岸に続く橋があるんだけど、\n"
"　その先に湿原へ続く転送小屋があるんだよ。\\!\n"
"　けれどこの間の大雨で橋が流されちゃってね。"
msgstr ""
"管理员「店外有通往对岸的桥，\n"
"　桥的那头有通往湿原的传送小屋哦。\n"
"　\\!　但是前阵子的大雨把桥冲走了呢。"

#. ID 16, Page 1, Line 22, Pos (10,30)
msgid ""
"　修復の要請は出してるんだけど、\n"
"　いまだに返事が返ってこないんだよね。\\!\n"
"　まったく、何してるんだろうね、プンプン。"
msgstr ""
"　修复申请已经提交了，　但至今还没有回音呢。\n"
"　\\!　真是的，他们在干什么呀，气呼呼。"

#. ID 16, Page 1, Line 25, Pos (10,30)
msgid ""
"　転送小屋を使わない行き方だと、\n"
"　崖を下っていくしか無いかな。\\!\n"
"　モンスターも出るし、落石もしょっちゅう起きるから\n"
"　あんまりオススメはしないけど。」"
msgstr ""
"　如果不使用传送小屋过去，\n"
"　就只能从悬崖下去了吧。\\!　会有怪物出现，\n"
"　落石也经常发生，　所以不太推荐。」"

#. ID 16, Page 1, Line 34, Pos (10,30)
msgid ""
"管理人\n"
"「湿原に生えている草の中には、\n"
"　解毒作用の非常に強力な種があるんだよ。\\!\n"
"　その名も\\c[11]ドクケシソウ\\c[0]さ。まんまだね！"
msgstr ""
"管理员「湿原生长的草中，\n"
"　有一种解毒作用非常强的种类哦。\n"
"　\\!　它的名字就叫\\c[11]毒罂粟草\\c[0]。\n"
"　真是直白呢！"

#. ID 16, Page 1, Line 38, Pos (10,30)
msgid ""
"　あんまりにも強力なんで、\n"
"　周りの土地まで浄化しちゃってるくらいさ。\\!\n"
"　見ればすぐに分かるよ。\n"
"　毒の沼地の中にポツンポツンと生えてるから。"
msgstr ""
"　因为实在太强了，　甚至把周围的土地都净化了。\n"
"　\\!　看到就能马上认出来哦。\n"
"　因为它在毒沼地中零零星星地生长着。"

#. ID 16, Page 1, Line 42, Pos (10,30)
msgid ""
"　ただ素人が安易に摘むのは、止めた方がいいよ。\\!\n"
"　ドクケシソウは確かに毒の沼地に生えてるんだけど、\n"
"　非常に良く似た紛らわしい草も生えてるから。"
msgstr ""
"　不过外行人轻易去摘的话，\n"
"　还是别这么做比较好哦。\n"
"　\\!　毒罂粟草确实生长在毒沼地，\n"
"　　但那里也长着非常相似、容易混淆的草。"

#. ID 16, Page 1, Line 45, Pos (10,30)
#. Contains choice at line 2 (2 options)
#. ID 16, Page 1, Line 135, Pos (10,30)
#. Contains choice at line 2 (2 options)
msgid "　詳しく聞く？」"
msgstr "　要详细听听吗？」"

#. ID 16, Page 1, Line 46, Pos (10,30)
#. Choice (2 options, embedded in a message)
#. ID 16, Page 1, Line 136, Pos (10,30)
#. Choice (2 options, embedded in a message)
#. ID 16, Page 1, Line 154, Pos (10,30)
#. Choice (2 options, embedded in a message)
msgid ""
"うん\n"
"大丈夫"
msgstr ""
"嗯\n"
"没关系"

#. ID 16, Page 1, Line 48, Pos (10,30)
msgid ""
"管理人\n"
"「\\c[11]ドクケシソウ\\c[0]は強力な解毒作用を持っていて、\n"
"　周りの土地まで浄化してしまうんだ。"
msgstr ""
"管理员\n"
"「\\c[11]毒罂粟草\\c[0]拥有强力的解毒作用，\n"
"　甚至会把周围的土地都净化掉。"

#. ID 16, Page 1, Line 51, Pos (10,30)
msgid ""
"　特徴としては\\c[9]まん丸とした葉っぱ\\c[0]だって事かな。\\!\n"
"　\\c[11]ニセドクケシソウ\\c[0]はドクケシソウとは反対で、\n"
"　周りの毒を吸い尽くして蓄積するんだ。"
msgstr ""
"　特征的话，大概就是\\c[9]圆滚滚的叶子\\c[0]吧。\n"
"　\\!　\\c[11]伪毒罂粟草\\c[0]和毒罂粟草相反，\n"
"　会吸尽周围的毒并蓄积起来。"

#. ID 16, Page 1, Line 54, Pos (10,30)
msgid ""
"　特徴としてはドクケシソウよりも、\n"
"　\\c[9]葉っぱの先端がとがっている\\c[0]事かな。\\!\n"
"　\\c[11]ニセドクケシソウモドキ\\c[0]は\n"
"　人間にとってはただの草だね。"
msgstr ""
"　特征的话，比起毒罂粟草，\n"
"　\\c[9]叶子的尖端更尖\\c[0]吧。\n"
"　\\!　\\c[11]伪毒消草拟\\c[0]对人类来说只是普通\n"
"　的草呢。"

#. ID 16, Page 1, Line 58, Pos (10,30)
msgid ""
"　特徴としては葉っぱの先端が、\n"
"　ドクケシソウよりもとがっていて、\n"
"　ニセドクケシソウよりは丸みを帯びている事かな。\\!\n"
"　はっきり言って、ベテランでも判別に困る草だよ。"
msgstr ""
"　特征的话，叶子的尖端，　比毒罂粟草更尖，\n"
"　而且比伪毒罂粟草更圆润一些吧。\\!　说实话，\n"
"　就算是老手也会为辨别它而困扰的草哦。"

#. ID 16, Page 1, Line 62, Pos (10,30)
msgid ""
"　まぁ、人が食べる分には何も問題はないけどね。\n"
"　……死ぬほど苦いみたいだけど。\\!\n"
"　\\c[11]一部のモンスター\\c[0]には薬草として効くようだよ。」"
msgstr ""
"　嘛，人吃的话没什么问题。　……\n"
"　不过似乎苦得要命。\n"
"　\\!　\\c[11]一部分怪物\\c[0]似乎会把它当作药草\n"
"　有效呢。」"

#. ID 16, Page 1, Line 82, Pos (10,30)
#. Choice (4 options)
msgid ""
"転送陣について\n"
"モンスターについて\n"
"気をつけることは？\n"
"前へ"
msgstr ""
"关于传送阵\n"
"关于怪物\n"
"要注意的事？\n"
"前进"

#. ID 16, Page 1, Line 84, Pos (10,30)
msgid ""
"管理人\n"
"「湿原の奥には転送陣が置いてあって、\n"
"　対岸の転送小屋と行き来できるようになってるんだ。"
msgstr ""
"管理员「湿原深处放着传送阵，\n"
"　可以和对岸的传送小屋相互往来。"

#. ID 16, Page 1, Line 87, Pos (10,30)
msgid ""
"　この転送陣ってのは、\n"
"　魔力を注いで起動するのが普通なんだ。\\!\n"
"　けどそれだと万人が利用できるわけじゃないんで、\n"
"　ちょっと変わった仕様にしているみたいだよ。"
msgstr ""
"　这个传送阵啊，　通常是注入魔力来启动的。\n"
"　\\!　但那样并不是所有人都能使用，\n"
"　所以似乎做成了有点特殊的规格哦。"

#. ID 16, Page 1, Line 91, Pos (10,30)
msgid ""
"　設置した人達が言うには、\n"
"　『転送陣の周囲にいるモンスターを\n"
"　　魔力に変換して利用する画期的なアイデア！』\n"
"　って事だったかな？"
msgstr ""
"　据设置它的人们说，　\n"
"　『将传送阵周围的怪物　　转换为魔力加以利用的\n"
"　　划时代点子！』　是这么回事吧？"

#. ID 16, Page 1, Line 95, Pos (10,30)
msgid ""
"　転送陣を利用するには、\n"
"　\\c[11]最初にエネルギー変換場を展開\\c[0]してから、\n"
"　モンスターを放り込んでいってね。"
msgstr ""
"　要利用传送阵，\n"
"　\\c[11]首先展开能量转换场\\c[0]之后，\n"
"　把怪物扔进去哦。"

#. ID 16, Page 1, Line 98, Pos (10,30)
msgid ""
"　うーん、そういえば転送陣のメンテナンスは\n"
"　どうなっているんだろ？\\!\n"
"　前は定期的に見に来てたんだけどね。」"
msgstr ""
"　嗯——，说起来传送阵的维护　到底是怎么做的呢？\n"
"　\\!　以前还会定期来查看呢。」"

#. ID 16, Page 1, Line 106, Pos (10,30)
msgid ""
"管理人\n"
"「崖には\\c[11]吸血コウモリ\\c[0]と\\c[11]水グモ\\c[0]が出るよ。\\!\n"
"　\\c[11]吸血コウモリ\\c[0]はすばしっこいから、\n"
"　弓や銃みたいに一瞬で仕留めるような武器がいいね。"
msgstr ""
"管理员\n"
"「悬崖上会出现\\c[11]吸血蝙蝠\\c[0]和\\c[11]水蜘\n"
"　蛛\\c[0]哦。\\!　\\c[11]吸血蝙蝠\\c[0]很敏捷，\n"
"　所以像弓或枪那样能瞬间解决掉的武器比较好呢。"

#. ID 16, Page 1, Line 110, Pos (10,30)
msgid ""
"　\\c[11]水グモ\\c[0]は水の中に潜んでいるよ。\\!\n"
"　獲物が近くに来ると飛び出してくるんだけど、\n"
"　決まった場所でしか飛び出さないから、\n"
"　避けて通ることもできるかもね。"
msgstr ""
"　\\c[11]水蜘蛛\\c[0]潜伏在水里哦。\n"
"　\\!　猎物靠近时就会跳出来，\n"
"　但只会在固定的地方跳出，\n"
"　所以也许可以避开绕过去呢。"

#. ID 16, Page 1, Line 114, Pos (10,30)
msgid ""
"　湿原には\\c[11]ネバネーバ達\\c[0]とその\\c[11]亜種達\\c[0]が出るんだ。\n"
"　一番の違いは、攻撃が通るかどうかだね。\\!\n"
"　\\c[11]ネバネーバ達\\c[0]はスライムの変異種だから、\n"
"　ある程度攻撃が通るよ。"
msgstr ""
"　湿原会出现\\c[11]黏黏怪们\\c[0]和它们的\\c[11]\n"
"　亚种们\\c[0]。　最大的区别是，攻击能否奏效。\n"
"　\\!　\\c[11]黏黏怪们\\c[0]是史莱姆的变异种，\n"
"　所以攻击在一定程度上能奏效哦。"

#. ID 16, Page 1, Line 118, Pos (10,30)
msgid ""
"　けれど\\c[11]亜種\\c[0]はネバネーバ達と湿原の毒が混ざった、\n"
"　毒の塊のようなものだから攻撃が通らないんだ。\\!\n"
"　出会った時は、その点注意してね。"
msgstr ""
"　不过\\c[11]亚种\\c[0]是黏黏怪们和湿原的毒混合\n"
"　而成的、　像毒块一样的东西，\n"
"　所以攻击无法奏效。\\!　遇到时，\n"
"　请注意这一点哦。"

#. ID 16, Page 1, Line 121, Pos (10,30)
msgid ""
"　弱点だけど、崖の２種に対しては雷属性が一番かな。\\!\n"
"　湿原のネバネーバ通常３種は、\n"
"　属性ならどれも同じようなものだよ。"
msgstr ""
"　弱点的话，对悬崖的2种来说雷属性最合适吧。\n"
"　\\!　湿原的黏黏怪通常3种，\n"
"　若论属性的话哪种都差不多哦。"

#. ID 16, Page 1, Line 124, Pos (10,30)
msgid ""
"　湿原のネバネーバ亜種３種については、\n"
"　さっきも言ったとおり攻撃は通らない。\\!\n"
"　ただし\\c[11]フレイルや鉄球系の武器\\c[0]なら叩き落せるよ。」"
msgstr ""
"　关于湿原的黏黏怪亚种3种，　就像刚才说的，\n"
"　攻击无法奏效。\n"
"　\\!　不过\\c[11]连枷与铁球类武器\\c[0]的话就能\n"
"　把它们敲落哦。」"

#. ID 16, Page 1, Line 132, Pos (10,30)
msgid ""
"管理人\n"
"「湿原のモンスターは獲物が近付くと、\n"
"　特異な行動を起こす事があるんだよ。"
msgstr ""
"管理员「湿原的怪物在猎物靠近时，\n"
"　有时会做出特异行动哦。"

#. ID 16, Page 1, Line 138, Pos (10,30)
msgid ""
"管理人\n"
"「\\c[11]ネバネーバ\\c[0]は特に何も起こさないよ。\\!\n"
"　\\c[11]ネバーマン\\c[0]は地面に隠れて近付いてくるね。"
msgstr ""
"管理员「\\c[11]黏黏怪\\c[0]不会特别做什么哦。\n"
"\\!　\\c[11]黏黏男\\c[0]会躲在地面下靠近呢。"

#. ID 16, Page 1, Line 141, Pos (10,30)
msgid ""
"　\\c[11]ネバガール\\c[0]は叫んで、\n"
"　周囲のモンスターを一斉に特異行動に移させる。\\!\n"
"　\\c[11]ネバネーバ亜種\\c[0]は飛び跳ねて近付いてくるよ。"
msgstr ""
"　\\c[11]黏黏女孩\\c[0]会尖叫，\n"
"　让周围的怪物一起进入特异行动。\n"
"　\\!　\\c[11]黏黏怪亚种\\c[0]会蹦跳着靠近哦。"

#. ID 16, Page 1, Line 144, Pos (10,30)
msgid ""
"　\\c[11]ネバーマン亜種\\c[0]は地面に隠れて近付いてくるけど、\n"
"　通常種と違って完全に隠れてるから注意してね。\\!\n"
"　\\c[11]ネバガール亜種\\c[0]は叫んだ上に、\n"
"　ネバネバ弾をたくさん撃ちだしてくるよ。」"
msgstr ""
"　\\c[11]黏黏男亚种\\c[0]会躲在地面下靠近，\n"
"　但和通常种不同，它是完全隐藏起来的，\n"
"　所以要注意哦。\n"
"　\\!　\\c[11]黏黏女孩亚种\\c[0]不仅会尖叫，\n"
"　　还会射出很多黏黏弹哦。」"

#. ID 16, Page 1, Line 152, Pos (10,30)
#. Contains choice at line 3 (2 options)
msgid ""
"管理人\n"
"「あとはやっぱりはりつきかな？\\!　詳しく聞く？」"
msgstr ""
"管理员「剩下的果然还是黏附吧？\n"
"\\!　要详细听听吗？」"

#. ID 16, Page 1, Line 156, Pos (10,30)
msgid ""
"管理人\n"
"「ネバネーバ通常種を\\c[11]間近で倒したり\\c[0]、\n"
"　ネバネーバ亜種やネバネバ弾に\\c[11]触ったり\\c[0]すると、\n"
"　\\c[11]ネバネバにはりつかれて\\c[0]しまうんだ。"
msgstr ""
"管理员「\\c[11]在近处打倒\\c[0]黏黏怪通常种，\n"
"　或者\\c[11]碰到\\c[0]黏黏怪亚种和黏黏弹时，\n"
"　就会\\c[11]被黏黏物黏附住\\c[0]哦。"

#. ID 16, Page 1, Line 160, Pos (10,30)
msgid ""
"　少ない内は放っておいても特に問題は無いよ。\n"
"　……すっごく気持ち悪いかもしれないけど。\\!\n"
"　ただ、はりつかれた量が多くなってくると、\n"
"　口を塞がれたり脚に絡んできたりするんだ。"
msgstr ""
"　少量的时候放着不管也没什么特别问题哦。　……\n"
"　虽然可能会觉得非常恶心。\\!　不过，\n"
"　被黏附的量多起来后，　就会堵住嘴、\n"
"　缠住腿之类的。"

#. ID 16, Page 1, Line 164, Pos (10,30)
msgid ""
"　さらに大量にはりつかれると、\n"
"　今度は剥がれ落ちないように\\c[11]同化\\c[0]してくるんだ。\\!\n"
"　これが厄介なところでね。"
msgstr ""
"而且被大量黏附后，这次就会为了不剥落而\\c[11]同化\\c[0]过来\n"
"　哦。\\!　这就是麻烦的地方呢。"

#. ID 16, Page 1, Line 167, Pos (10,30)
msgid ""
"　同化も少ない内はあまり害は無いけど、\n"
"　量が増えてくると色々と感じやすくなっちゃうよ。\\!\n"
"　さらに大量に同化されると、\n"
"　最終的に身体が全部ネバネバになっちゃうからね。"
msgstr ""
"　同化在少量时也没什么太大危害，\n"
"　但量增加后就会变得更容易感受到各种东西哦。\n"
"　\\!　再被大量同化的话，\n"
"　最终身体会全部变成黏黏物哦。"

#. ID 16, Page 1, Line 171, Pos (10,30)
msgid ""
"　大事な事は、\n"
"　\\c[11]はりついたネバネバは取り除ける\\c[0]けど、\n"
"　\\c[11]同化したネバネバは取り除けない\\c[0]って事。"
msgstr ""
"　重要的是，\n"
"　\\c[11]黏附上的黏黏物可以去除\\c[0]，\n"
"　但\\c[11]同化后的黏黏物无法去除\\c[0]。"

#. ID 16, Page 1, Line 174, Pos (10,30)
msgid ""
"　取り返しのつかない事になる前に、\n"
"　アイテムで剥がしてしまうといいよ。」"
msgstr ""
"　在变成无法挽回的事态之前，\n"
"　用道具把它剥掉比较好哦。」"

#. ID 16, Page 2, Line 5, Pos (10,30)
msgid ""
"管理人\n"
"「やあお嬢ちゃん。\n"
"　またネバルーンを倒してくれたんだってね。\\!\n"
"　はいこれ、お礼ね。」"
msgstr ""
"管理员「呀，小姑娘。\n"
"　听说你又打倒黏黏气球了呢。\\!　来，这个，\n"
"　是谢礼哦。」"

#. ID 16, Page 2, Line 11, Pos (10,30)
msgid ""
"管理人\n"
"「やあおねえさん。\n"
"　またネバルーンを倒してくれたんだってね。\\!\n"
"　はいこれ、お礼ね。」"
msgstr ""
"管理员「呀，大姐姐。\n"
"　听说你又打倒黏黏气球了呢。\\!　来，这个，\n"
"　是谢礼哦。」"

#. ID 16, Page 2, Line 20, Pos (10,30)
msgid ""
"管理人\n"
"「やあお嬢ちゃん。\n"
"　ネバルーンを倒してくれたのかい？"
msgstr "管理员「呀，小姑娘。　你打倒了黏黏气球吗？"

#. ID 16, Page 2, Line 25, Pos (10,30)
msgid ""
"管理人\n"
"「やあおねえさん。\n"
"　ネバルーンを倒してくれたのかい？"
msgstr "管理员「呀，大姐姐。　你打倒了黏黏气球吗？"

#. ID 16, Page 2, Line 30, Pos (10,30)
msgid ""
"　アイツは浮島に近付かなければ害は無いし、\n"
"　倒しても倒してもいつの間にか復活するから\n"
"　放っておいたんだけどね。"
msgstr ""
"　那家伙只要不靠近浮岛就没有危害，\n"
"　不管打倒多少次都会不知不觉复活，\n"
"　所以我就一直没管它了。"

#. ID 16, Page 2, Line 33, Pos (10,30)
msgid ""
"　せっかく倒してきてくれたんだし、\n"
"　何かお礼をあげるよ。\\!\n"
"　うーん……\\.\\.何がいいかな……"
msgstr ""
"　难得你特意来打倒它了，\n"
"　我就给你点什么作为谢礼吧。\\!　嗯……\n"
"　\\.\\.送什么好呢……"

#. ID 16, Page 2, Line 36, Pos (10,30)
msgid ""
"　あぁそうだ、アレにしよう。\\!\n"
"　前に川岸に流れ着いてた物なんだけどね、\n"
"　僕達には不要の品だし、あげるね。」"
msgstr ""
"　啊，对了，就那个吧。\n"
"　\\!　是之前漂流到河岸边的东西，\n"
"　对我们来说是不需要的物品，就给你吧。」"

#. ID 16, Page 2, Line 97, Pos (10,30)
msgid ""
"管理人\n"
"「また気が向いたら倒しに行ってね。」"
msgstr "管理员「下次心血来潮的话，再去打倒它哦。」"

#. ID 16, Page 3, Line 4, Pos (10,30)
msgid ""
"管理人\n"
"「やあお嬢ちゃん。\n"
"　僕はここの管理人をしているんだ、よろしくね。\n"
"　何か聞きたいことがあるのかな？」"
msgstr ""
"管理员「你好，小姑娘。　我是这里的管理员，\n"
"请多关照。　有什么想打听的事吗？」"

#. ID 16, Page 3, Line 10, Pos (10,30)
msgid ""
"管理人\n"
"「やあおねえさん。\n"
"　僕はここの管理人をしているんだ、よろしくね。\n"
"　何か聞きたいことがあるのかな？」"
msgstr ""
"管理员「你好，大姐姐。　我是这里的管理员，\n"
"请多关照。　有什么想打听的事吗？」"

#. ID 16, Page 4, Line 13, Pos (10,30)
msgid ""
"管理人\n"
"「やあお嬢ちゃん。\n"
"　“どうかしたのかい？”」"
msgstr "管理员「你好，小姑娘。　「怎么了？」」"

#. ID 16, Page 4, Line 18, Pos (10,30)
msgid ""
"管理人\n"
"「やあおねえさん。\n"
"　“どうかしたのかい？”」"
msgstr "管理员「你好，大姐姐。　「怎么了？」」"

#. ID 16, Page 4, Line 26, Pos (10,30)
msgid ""
"管理人\n"
"「やあお嬢ちゃん。\n"
"　何か用かい？」"
msgstr "管理员「你好，小姑娘。　有什么事吗？」"

#. ID 16, Page 4, Line 31, Pos (10,30)
msgid ""
"管理人\n"
"「やあおねえさん。\n"
"　何か用かい？」"
msgstr "管理员「你好，大姐姐。　有什么事吗？」"

#. ID 17, Page 1, Line 3, Pos (11,4)
#. Contains choice at line 2 (3 options)
msgid "何を行いますか？"
msgstr "要做什么？"

#. ID 17, Page 1, Line 4, Pos (11,4)
#. Choice (3 options, embedded in a message)
msgid ""
"セーブ\n"
"ＢＧＳＥ－ＢＧＭ切替\n"
"昼夜変更"
msgstr ""
"存档\n"
"BGSE－BGM切换\n"
"昼夜变更"

#. ID 17, Page 1, Line 14, Pos (11,4)
msgid ""
"ＢＧＭモード\n"
"・崖と湿原でＳＥの代わりにＢＧＭを鳴らします\n"
"・イベントの滝マップでは強制的にＳＥになります"
msgstr ""
"BGM模式\n"
"・在悬崖和湿原中代替SE播放BGM\n"
"・在事件瀑布地图中会强制变为SE"

#. ID 17, Page 1, Line 19, Pos (11,4)
msgid ""
"ＳＥモード\n"
"・崖と湿原でＢＧＭの代わりにＳＥを鳴らします\n"
"・メニューや諸々の処理中に途切れる事があります"
msgstr ""
"SE模式\n"
"・在悬崖和湿原中代替BGM播放SE\n"
"・在菜单及各种处理过程中可能会中断"
