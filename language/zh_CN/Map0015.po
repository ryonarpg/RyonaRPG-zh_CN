msgstr "捡到了装满神秘液体的瓶子"

#. ID 43, Page 1, Line 3, Pos (26,10)
msgid "へへへ、盛りやがって…そんなに良いのかい！"
msgstr "嘿嘿嘿，这么兴奋……有那么爽吗！"

#. ID 43, Page 1, Line 7, Pos (26,10)
msgid "ああぁ…アナタぁ…ふ…もっとぉ…"
msgstr "啊啊……你……呼……再多一点……"

#. ID 44, Page 1, Line 3, Pos (35,10)
#. ID 44, Page 3, Line 3, Pos (35,10)
msgid "あら…こんばんは\\c[11]$k"
msgstr "哎呀……晚上好\\c[11]$k"

#. ID 44, Page 1, Line 4, Pos (35,10)
msgid "レイオンの夜は涼しくて気持ちいいですね。"
msgstr "雷昂的夜晚凉爽又舒服呢。"

#. ID 44, Page 2, Line 3, Pos (35,10)
msgid "あら…ごきげんよう\\c[11]$k"
msgstr "哎呀……贵安\\c[11]$k"

#. ID 44, Page 2, Line 4, Pos (35,10)
msgid ""
"調子はいかがですか？レイオンは旅人が多くて、\n"
"お仕事には困りませんよね…♪"
msgstr "情况怎么样？雷昂有很多旅人，工作应该不愁吧…♪"

#. ID 44, Page 3, Line 4, Pos (35,10)
