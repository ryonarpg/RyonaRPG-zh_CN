#. ID 2, Page 1, Line 3, Pos (24,14)
#. Contains choice at line 2 (2 options)
msgid "街の外に出ますか？"
msgstr "要出城吗？"

#. ID 2, Page 1, Line 4, Pos (24,14)
#. Choice (2 options, embedded in a message)
#. ID 14, Page 2, Line 5, Pos (41,11)
#. Choice (2 options)
#. ID 14, Page 2, Line 13, Pos (41,11)
#. Choice (2 options, embedded in a message)
