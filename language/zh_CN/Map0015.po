"\\n[\\v[6]]\n"
"「玩大人的禁忌游戏哦\\c[11]$k\\c[0]\\!呵呵\\c[11]$k\\c[0]」"

#. ID 40, Page 1, Line 13, Pos (37,13)
#. ID 40, Page 7, Line 4, Pos (37,13)
msgid ""
"ち…ちょっと！　何でズボン脱がせるの！？\n"
"やっやめて…！　誰か…誰かぁー！！"
msgstr ""
"等…等一下！　为什么脱我裤子！？住、住手…！\n"
"　来人…来人啊——！！"

#. ID 40, Page 1, Line 30, Pos (37,13)
msgid "………満足\\c[11]$k"
msgstr "………满足\\c[11]$k"

#. ID 40, Page 2, Line 21, Pos (37,13)
msgid ""
"ねこさんだー！\n"
"いっしょにあそぶー？"
msgstr "是猫咪——！一起玩——？"

#. ID 40, Page 3, Line 3, Pos (37,13)
msgid "あ、おねーさん奴隷なんだー？"
msgstr "啊，姐姐是奴隶啊——？"

#. ID 40, Page 3, Line 4, Pos (37,13)
#. Contains choice at line 2 (2 options)
#. ID 40, Page 4, Line 5, Pos (37,13)
#. Contains choice at line 2 (2 options)
