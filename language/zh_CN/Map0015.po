#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 2, Page 2, Line 3, Pos (24,14)
msgid ""
"だめ…あそこが疼いて気が…狂いそう\n"
"はやく…せっくすして鎮め…ないと…"
msgstr ""
"不行…那里疼得…快要疯了…快点…\n"
"不做爱镇静下来的话…"

#. ID 7, Page 2, Line 5, Pos (21,9)
#. ID 15, Page 2, Line 5, Pos (7,9)
#. ID 30, Page 2, Line 5, Pos (14,9)
msgid ""
"鍵がかかっている。\n"
"営業時間外のようだ。"
msgstr "锁着。看来是营业时间外。"

#. ID 12, Page 1, Line 3, Pos (0,12)
msgid ""
"（よくこんな草むらの中の緑ゴマに\n"
"　話しかける気になったものですね）"
msgstr "（真亏您会想跟这种草丛里的绿芝麻搭话呢）"

#. ID 12, Page 1, Line 5, Pos (0,12)
msgid ""
"（昔ケンカした白ゴマと黒ゴマに\n"
"　もしも会えるなら謝りたい）"
msgstr ""
"（以前吵过架的白芝麻和黑芝麻，\n"
"　如果能再见到的话想道歉）"

#. ID 12, Page 1, Line 7, Pos (0,12)
msgid ""
"（噂では白ゴマはここから遥か北の「氷雪の洞窟」に\n"
"　黒ゴマは「暗黒の地下迷宮」にいるとか。）"
msgstr ""
"（传闻白芝麻在这以北很远处的「冰雪洞窟」，\n"
"　黑芝麻在「黑暗地下迷宫」。）"

#. ID 12, Page 1, Line 9, Pos (0,12)
msgid ""
"（…いや、言ってみただけですよ。\n"
"　何その「エディター開いて探してみちゃおうかな」\n"
"　みたいな顔。）"
msgstr ""
"（…不，只是说说而已啦。\n"
"　干嘛一副「打开编辑器找找看吧」的表情。）"

#. ID 12, Page 1, Line 12, Pos (0,12)
msgid "（ふんとにもう。）"
msgstr "（真是的。）"

#. ID 12, Page 1, Line 14, Pos (0,12)
msgid "（………。）"
msgstr "（………。）"

#. ID 12, Page 1, Line 15, Pos (0,12)
msgid ""
"（待って待って。\n"
"　何その君のちょっと飽きた顔。思いついた顔。\n"
"　マメに目を通すってそういうことじゃないから。\n"
"　つか俺そもそもマメじゃないし。ゴマだし。）"
msgstr ""
"（等等等等。你那一脸有点腻了的表情算什么。\n"
"　一脸想到什么的表情。\n"
"　所谓勤快地过目不是那个意思。\n"
"　再说我本来就不是豆子，是芝麻。）"

#. ID 12, Page 1, Line 19, Pos (0,12)
msgid "（まったくもってふんとにもう。）"
msgstr "（真是的，完完全全真是的。）"

#. ID 13, Page 1, Line 3, Pos (33,10)
msgid "……………もう！"
msgstr "……………真是的！"

#. ID 13, Page 1, Line 4, Pos (33,10)
msgid ""
"お仕事の邪魔になるから、そこに\n"
"立たないでよ！"
msgstr "会妨碍工作的，别站在那里！"

#. ID 13, Page 2, Line 3, Pos (33,10)
msgid "…あんた錫でしょ！？何でここにいるの！？"
msgstr "…你是锡吧！？为什么在这里！？"

#. ID 13, Page 2, Line 4, Pos (33,10)
msgid "はやく、裏通りの巣に戻ったら！？"
msgstr "快点回后巷的巢里去！？"

#. ID 13, Page 3, Line 3, Pos (33,10)
msgid ""
"あら、\\N[\\V[6]]じゃない。\n"
"ごきげんよう。"
msgstr "哎呀，这不是\\N[\\V[6]]吗。贵安。"

#. ID 13, Page 3, Line 5, Pos (33,10)
msgid ""
"でも、ここは私たちの場所だから。\n"
"お仕事は別の場所でしたらどうかしら！"
msgstr ""
"但是，这里是我们的地盘。\n"
"工作的话能不能到别处去做呢！"

#. ID 13, Page 4, Line 3, Pos (33,10)
msgid ""
"あ、\\N[\\V[6]]さん…\n"
"ごきげんよう。"
msgstr "啊，\\N[\\V[6]]小姐…贵安。"

#. ID 13, Page 4, Line 5, Pos (33,10)
msgid "ええと…その…ここは私たちの…"
msgstr "呃…那个…这里是我们的…"

#. ID 13, Page 4, Line 6, Pos (33,10)
msgid "いえ、何でもないです…スミマセン"
msgstr "不，没什么…对不起。"

#. ID 13, Page 5, Line 3, Pos (33,10)
msgid "…奴隷…？"
msgstr "…奴隶…？"

#. ID 13, Page 5, Line 4, Pos (33,10)
msgid "…何よ。うるさいわね！"
msgstr "…什么啊。真烦人！"

#. ID 13, Page 5, Line 5, Pos (33,10)
msgid ""
"私たちが奴隷にしてあげられる事なんか、\n"
"何もないわよ！！行って！あっち行ってよお！"
msgstr ""
"我们能把你当奴隶做的事，什么都没有哦！！走开！\n"
"去那边啦！"

#. ID 14, Page 1, Line 1, Pos (41,11)
msgid "どうも。私、ミスリﾉﾚ製薬の方から来ました。"
msgstr "您好。我是米斯里诺雷制药的。"

#. ID 14, Page 1, Line 2, Pos (41,11)
#. Contains choice at line 2 (3 options)
msgid "ただ今、新製品のモニターを募集しております。"
msgstr "现在正在招募新产品的试用者。"

#. ID 14, Page 1, Line 3, Pos (41,11)
#. Choice (3 options, embedded in a message)
msgid ""
"ください\n"
"いらない\n"
"くわしく"
msgstr ""
"请给我\n"
"不需要\n"
"详细说明"

#. ID 14, Page 1, Line 5, Pos (41,11)
msgid "では装着させてあげましょう。"
msgstr "那么，就让我为您穿上吧。"

#. ID 14, Page 1, Line 13, Pos (41,11)
msgid ""
"相手のフードの袖から何かが飛び出し、\n"
"\\n[\\v[6]]の身体に取り付いた！"
msgstr ""
"有什么东西从对方兜帽的袖口飞出，\n"
"附到了\\n[\\v[6]]的身体上！"

#. ID 14, Page 1, Line 20, Pos (41,11)
msgid ""
"「何か」は素肌を生体ラバーに\n"
"閉じ込められた\\n[\\v[6]]の身体の上で、\n"
"何故か苦しそうに蠢いている。"
msgstr ""
"「某物」在裸露肌肤被生物乳胶包裹的\\n[\\v[6]]的身\n"
"体上，不知为何痛苦地蠕动着。"

#. ID 14, Page 1, Line 28, Pos (41,11)
msgid ""
"悶えていた「何か」は、やがて力なく\n"
"\\n[\\v[6]]の身体から離れていった…。"
msgstr ""
"痛苦挣扎的「某物」，\n"
"不久便无力地从\\n[\\v[6]]的身体上离开了……。"

#. ID 14, Page 1, Line 34, Pos (41,11)
msgid "「ああ…そのスーツは生科研さんの……"
msgstr "「啊……那套衣服是生命科学研究公司的……"

#. ID 14, Page 1, Line 39, Pos (41,11)
#. ID 14, Page 1, Line 60, Pos (41,11)
msgid ""
"「残念ですが、仕方ありません。\n"
"また次の機会がありましたら、\n"
"モニターよろしくおねがいします。"
msgstr ""
"「很遗憾，但没办法。如果下次有机会，\n"
"还请继续考虑当试用者。"

#. ID 14, Page 1, Line 50, Pos (41,11)
msgid "「おや……？"
msgstr "「哎呀……？"

#. ID 14, Page 1, Line 58, Pos (41,11)
msgid ""
"「\\N[101]の呪いが強すぎて、\n"
"　身に着けられないようですね……"
msgstr "「\\N[101]的诅咒太强了，　似乎穿不了呢……"

#. ID 14, Page 1, Line 73, Pos (41,11)
msgid "\\n[\\v[6]]は蟲に寄生されてしまった！"
msgstr "\\n[\\v[6]]被虫寄生了！"

#. ID 14, Page 1, Line 74, Pos (41,11)
msgid "・・・フフッ、良い感想を期待してますよ"
msgstr "・・・呵呵，期待您的好感想哦"

#. ID 14, Page 1, Line 79, Pos (41,11)
msgid "そうですか。しかし一応ご説明させていただきます。"
msgstr "这样啊。不过还是让我说明一下。"

#. ID 14, Page 1, Line 84, Pos (41,11)
msgid ""
"　今回モニターしていただく我が新製品は\n"
"装着しているだけで危険な状態になった場合\n"
"自動的に体力、魔力が回復してくれるアイテムです。"
msgstr ""
"　这次请试用者试用的本公司新产品，\n"
"　只要穿戴在身上，\n"
"　在陷入危险状态时就会自动恢复体力、\n"
"　魔力的物品。"

#. ID 14, Page 1, Line 87, Pos (41,11)
msgid ""
"しかも、回復する際は装着者のスキル、能力関係なく\n"
"魔力、アイテム消費なしで回復を行う画期的装備です。"
msgstr ""
"而且，恢复时与穿戴者的技能、能力无关，\n"
"不消耗魔力、物品即可恢复，是划时代的装备。"

#. ID 14, Page 2, Line 1, Pos (41,11)
#. ID 14, Page 3, Line 1, Pos (41,11)
msgid ""
"\n"
"…フフッ、ご満足いただけてますか？。"
msgstr "…呵呵，您满意吗？。"

#. ID 14, Page 2, Line 7, Pos (41,11)
msgid ""
"それはよかった。\n"
"実は新作があるのですがあなたには必要ないですね。"
msgstr "那太好了。其实我们有新作，不过您不需要吧。"

#. ID 14, Page 2, Line 11, Pos (41,11)
#. Contains choice at line 3 (2 options)
msgid ""
"そうですか・・・\n"
"それでしたら新作を試して見ませんか？"
msgstr "这样啊・・・那要不要试试新作？"

#. ID 14, Page 2, Line 15, Pos (41,11)
msgid "ではこれをどうぞ。"
msgstr "那么请收下这个。"

#. ID 14, Page 2, Line 17, Pos (41,11)
msgid "アイテムを貰った。"
msgstr "获得了物品。"

#. ID 14, Page 2, Line 18, Pos (41,11)
msgid "・・・フフッ、こんどこそ良い感想を期待してますよ"
msgstr "・・・呵呵，这次可要期待您的好感想哦"

#. ID 14, Page 2, Line 21, Pos (41,11)
msgid "不満がおありなら試していただきたいのですが・・・"
msgstr "如果您有不满，希望您能试用一下・・・"

#. ID 14, Page 3, Line 3, Pos (41,11)
msgid ""
"\\n[\\v[6]]\n"
"「ハイ。オカゲザマデ『生マレ変ワル』事ガ出来マシタ。\\!\n"
"まいますたー。」"
msgstr ""
"\\n[\\v[6]]「是的。多亏您，我得以‘重获新生’。\n"
"\\!主人。」"

#. ID 14, Page 3, Line 6, Pos (41,11)
msgid ""
"なんと！！\\!\n"
"じゃあ君は…完成体か…ふっ…\\!フハハハハハ！！"
msgstr ""
"竟然！！\\!那么你就是……完成体吗……呵……\n"
"\\!哇哈哈哈哈哈哈！！"

#. ID 14, Page 3, Line 8, Pos (41,11)
msgid ""
"素晴らしいよ！本当に素晴らしい！\\!\n"
"折角『人間』に『生まれ変わった』んだ！\\!\n"
"思う存分楽しんできなさい！！\\!"
msgstr ""
"太棒了！真的很棒！\\!好不容易‘转生’成了‘人类’！\n"
"\\!尽情去享受吧！！\\!"

#. ID 14, Page 3, Line 11, Pos (41,11)
msgid ""
"\\n[\\v[6]]\n"
"「ハイ！\\!ますたーノ望ムママニ。\\!\n"
"コノカラダデ…ウフフフフッ！！！」"
msgstr ""
"\\n[\\v[6]]「是！\\!一切都随主人的意。\n"
"\\!用这具身体……呵呵呵呵呵！！！」"

#. ID 14, Page 3, Line 14, Pos (41,11)
#. Contains choice at line 2 (3 options)
msgid "そうだ、早速『人間』の君に聞きたいのだが何が望みかね？"
msgstr ""
"对了，我想马上问问身为‘人类’的你，\n"
"你有什么愿望？"

#. ID 14, Page 3, Line 15, Pos (41,11)
#. Choice (3 options, embedded in a message)
msgid ""
"男ノ人ヲ限界マデ搾リ尽クシタイ\n"
"女ノ人ヲ滅茶苦茶ニ犯シタイ\n"
"マダ何モ考エテイナイ"
msgstr ""
"想把男人榨干到极限\n"
"想把女人侵犯得乱七八糟\n"
"还什么都没想"

#. ID 14, Page 3, Line 18, Pos (41,11)
msgid ""
"そうか…\n"
"よし！君に一度『蟲』に戻ってもらうけどいいかい？\\!\n"
"男の人とやるのに「ついていれば」不味いだろ？"
msgstr ""
"这样啊……好！让你暂时变回一次‘虫’，可以吗？\n"
"\\!和男人做的时候，如果‘带着那东西’就不妙了吧？"

#. ID 14, Page 3, Line 21, Pos (41,11)
#. ID 14, Page 3, Line 40, Pos (41,11)
#. ID 14, Page 3, Line 51, Pos (41,11)
msgid ""
"\\n[\\v[6]]\n"
"「解リマシタ。まいますたー。」"
msgstr "\\n[\\v[6]]「明白了。主人。」"

#. ID 14, Page 3, Line 33, Pos (41,11)
msgid ""
"\n"
"＊素体\\n[\\v[6]]の肉体は女性の股間に元通りになった＊"
msgstr "＊素体\\n[\\v[6]]的肉体恢复成了女性股间的原样＊"

#. ID 14, Page 3, Line 38, Pos (41,11)
msgid ""
"ふっ。今の君なら造作も無い事だろ？\n"
"君の思いのまま動きたまえ。"
msgstr ""
"呵。现在的你，这应该轻而易举吧？\n"
"就按你的想法行动吧。"

#. ID 14, Page 3, Line 48, Pos (41,11)
msgid ""
"そうか…\n"
"よし！君に一度『蟲』に戻ってもらうけどいいかい？\\!\n"
"女の人を犯すには何が必要か解るよね？"
msgstr ""
"这样啊……好！让你暂时变回一次‘虫’，可以吗？\n"
"\\!要侵犯女人需要什么，你懂的吧？"

#. ID 14, Page 3, Line 61, Pos (41,11)
msgid ""
"\n"
"＊素体\\n[\\v[6]]の肉体にいきり立つモノがそそり立った＊"
msgstr "＊素体\\n[\\v[6]]的肉体上，勃起之物挺立了起来＊"

#. ID 14, Page 3, Line 75, Pos (41,11)
msgid ""
"\\n[\\v[6]]\n"
"「\\!アア…ドンナコトシヨウカナ？\\!\n"
"イッパイ考エテ…\\!考エルッテ素晴ラシイ…」"
msgstr ""
"\\n[\\v[6]]「\\!啊啊……做点什么好呢？\\!好好想想……\n"
"\\!思考真是美好……」"

#. ID 14, Page 4, Line 3, Pos (41,11)
#. ID 40, Page 2, Line 3, Pos (37,13)
msgid "きゃっきゃっ。"
msgstr "咯咯。"

#. ID 14, Page 4, Line 5, Pos (41,11)
msgid "ねこさんかわいいー！"
msgstr "猫猫好可爱——！"

#. ID 14, Page 5, Line 3, Pos (41,11)
#. ID 14, Page 6, Line 3, Pos (41,11)
msgid "あ、おねーさん、おねーさん"
msgstr "啊，姐姐，姐姐"

#. ID 14, Page 5, Line 4, Pos (41,11)
#. Contains choice at line 2 (2 options)
#. ID 14, Page 6, Line 4, Pos (41,11)
#. Contains choice at line 2 (2 options)
msgid "おねーさんに良いものあげるよ！"
msgstr "给姐姐好东西哦！"

#. ID 14, Page 5, Line 5, Pos (41,11)
#. Choice (2 options, embedded in a message)
msgid ""
"うん、ちょうだい\n"
"ううん、いらないよ"
msgstr ""
"嗯，给我\n"
"嗯嗯，不要哦"

#. ID 14, Page 5, Line 11, Pos (41,11)
#. ID 14, Page 6, Line 26, Pos (41,11)
#. ID 14, Page 7, Line 11, Pos (41,11)
msgid "えへへ……じゃあはい、これ！　つけてあげる！"
msgstr "嘿嘿……那么，给，这个！　给你戴上！"

#. ID 14, Page 5, Line 17, Pos (41,11)
msgid "へえ…おねーさんってそんなにゴムの服が好きなんだ…"
msgstr "诶……姐姐那么喜欢橡胶衣服啊……"

#. ID 14, Page 5, Line 18, Pos (41,11)
msgid "おねーさんってへんたいなんだね！"
msgstr "姐姐原来是个变态呢！"

#. ID 14, Page 5, Line 21, Pos (41,11)
msgid ""
"あはははっ♪\n"
"良く似合ってるよ、奴隷のおねーさん♪"
msgstr "啊哈哈哈♪很适合你哦，奴隶姐姐♪"

#. ID 14, Page 5, Line 25, Pos (41,11)
#. ID 14, Page 6, Line 45, Pos (41,11)
msgid "えー、いらないのー？"
msgstr "诶——，不要吗——？"

#. ID 14, Page 6, Line 5, Pos (41,11)
#. Choice (2 options, embedded in a message)
msgid ""
"はい、頂きます\n"
"いいえ、遠慮します"
msgstr ""
"好，我收下\n"
"不，不用了"

#. ID 14, Page 6, Line 8, Pos (41,11)
msgid ""
"えー、でもおねーさん、\n"
"もういいものあげちゃったよ！"
msgstr "诶——，但是姐姐，我已经把好东西给你了哦！"

#. ID 14, Page 6, Line 17, Pos (41,11)
msgid "うーん、やっぱりあげない！"
msgstr "嗯——，果然还是不给你了！"

#. ID 14, Page 6, Line 37, Pos (41,11)
msgid ""
"あはははっ♪\n"
"良く似合ってるよ、奴隷のおねーさん♪\n"
"まるで捕らわれのお姫様みたい！"
msgstr ""
"啊哈哈哈♪很适合你哦，\n"
"奴隶姐姐♪简直就像被囚禁的公主！"

#. ID 14, Page 7, Line 3, Pos (41,11)
msgid "あ、\\N[\\V[6]]、\\N[\\V[6]]"
msgstr "啊，\\N[\\V[6]]，\\N[\\V[6]]"

#. ID 14, Page 7, Line 4, Pos (41,11)
#. Contains choice at line 2 (2 options)
msgid "\\N[\\V[6]]に良いものあげるよ！"
msgstr "给\\N[\\V[6]]好东西哦！"

#. ID 14, Page 7, Line 5, Pos (41,11)
#. Choice (2 options, embedded in a message)
msgid ""
"わん！\n"
"ううん、いらないよ"
msgstr ""
"汪！\n"
"嗯嗯，不要哦"

#. ID 14, Page 7, Line 17, Pos (41,11)
msgid "へえ…そんなにゴムの服が好きなんだ…"
msgstr "诶……原来那么喜欢橡胶衣服啊……"

#. ID 14, Page 7, Line 18, Pos (41,11)
msgid "へんたい雌犬なんて初めて見たぁ！"
msgstr "第一次见到变态母狗！"

#. ID 14, Page 7, Line 21, Pos (41,11)
msgid ""
"あはははっ♪\n"
"良く似合ってるよ、雌犬の\\N[\\V[6]]♪"
msgstr "啊哈哈哈♪很适合你哦，母狗\\N[\\V[6]]♪"

#. ID 14, Page 7, Line 25, Pos (41,11)
msgid "……へぇー…犬ごときが人間様の言葉しゃべるの？"
msgstr "……诶——……区区一条狗也会说人类大人的话？"

#. ID 14, Page 7, Line 33, Pos (41,11)
msgid ""
"【\\N[\\V[6]]】\n"
"ひいっ！"
msgstr "【\\N[\\V[6]]】咿——！"

#. ID 14, Page 7, Line 35, Pos (41,11)
msgid ""
"雌犬のくせに人間様の言葉を\n"
"し　ゃ　べ　る　の　？"
msgstr ""
"明明是母狗，\n"
"却会　说　人　类　大　人　的　话　吗　？"

#. ID 14, Page 7, Line 37, Pos (41,11)
msgid ""
"【\\N[\\V[6]]】\n"
"ごっ、ごめんな…"
