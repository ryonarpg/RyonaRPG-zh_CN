msgstr ""
"孩子的话让\\N[\\V[6]]感到巨大的羞耻和仅有一丁点\n"
"儿的满足感。"

#. ID 40, Page 4, Line 39, Pos (37,13)
msgid ""
"違うの？\n"
"おねーさん、あんまり奴隷っぽくないからなー。"
msgstr "不是吗？姐姐不太像奴隶呢——。"

#. ID 40, Page 5, Line 3, Pos (37,13)
msgid "あ、おねーさん犬なんだー？"
msgstr "啊，姐姐是狗啊——？"

#. ID 40, Page 5, Line 4, Pos (37,13)
#. Contains choice at line 2 (2 options)
msgid "おねーさん、お手！"
msgstr "姐姐，握手！"

#. ID 40, Page 5, Line 5, Pos (37,13)
#. Choice (2 options, embedded in a message)
msgid ""
"わん！\n"
"…"
msgstr ""
"汪！\n"
"…"

#. ID 40, Page 5, Line 7, Pos (37,13)
msgid ""
