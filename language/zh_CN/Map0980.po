#. ID 86, Page 2, Line 4, Pos (116,74)
#. ID 202, Page 2, Line 7, Pos (12,65)
msgid "扉は再び閉ざされてしまった……。"
msgstr "门再次关闭了……。"

#. ID 86, Page 2, Line 7, Pos (116,74)
#. ID 202, Page 2, Line 4, Pos (12,65)
msgid "扉は固く閉ざされている……。"
msgstr "门紧紧关闭着……。"

#. ID 107, Page 2, Line 4, Pos (120,78)
#. ID 116, Page 2, Line 4, Pos (93,66)
#. ID 200, Page 2, Line 4, Pos (8,69)
#. ID 213, Page 2, Line 4, Pos (8,58)
msgid ""
"この身体では\n"
"レバーを動かすことは不可能だ……。"
msgstr "以这个身体无法扳动拉杆……。"

#. ID 107, Page 2, Line 9, Pos (120,78)
#. Contains choice at line 2 (2 options)
#. ID 116, Page 2, Line 8, Pos (93,66)
#. Contains choice at line 2 (2 options)
#. ID 200, Page 2, Line 8, Pos (8,69)
#. Contains choice at line 2 (2 options)
#. ID 213, Page 2, Line 9, Pos (8,58)
#. Contains choice at line 2 (2 options)
msgid "レバーを見つけた。操作しますか?"
msgstr "发现了拉杆。要操作吗？"

#. ID 107, Page 2, Line 10, Pos (120,78)
#. Choice (2 options, embedded in a message)
#. ID 116, Page 2, Line 9, Pos (93,66)
#. Choice (2 options, embedded in a message)
