#. ID 7, Page 8, Line 18, Pos (4,4)
msgid "………"
msgstr "………"

#. ID 7, Page 1, Line 6, Pos (4,4)
#. ID 7, Page 2, Line 7, Pos (4,4)
msgid "……なにかしら"
msgstr "……有什么事吗"

#. ID 7, Page 1, Line 25, Pos (4,4)
#. Choice (2 options)
msgid ""
"エスラスがどういう状態なのか\n"
"なんでもない"
msgstr ""
"埃斯拉斯处于什么状态呢\n"
"没什么"

#. ID 7, Page 1, Line 30, Pos (4,4)
msgid ""
"………\n"
"私の口から言わせたいの？"
msgstr "………想让我亲口说出来吗？"

#. ID 7, Page 1, Line 34, Pos (4,4)
msgid ""
"あなたの屍霊術で作られた\n"
"生ける屍……それが私"
msgstr "由你的尸灵术制造出来的活尸……那就是我"

#. ID 7, Page 1, Line 36, Pos (4,4)
msgid ""
"死ぬ前の記憶もあるし……\n"
"あなたの術が完璧だったせいか\n"
"ゾンビのようには見えないけど"
msgstr ""
"死前的记忆也有……也许是因为你的术太完美了，\n"
"看起来不像僵尸。"

#. ID 7, Page 1, Line 40, Pos (4,4)
#. ID 7, Page 1, Line 59, Pos (4,4)
msgid ""
"つまり、あなたはご主人様……\n"
"私は絶対にあなたに逆らえない"
msgstr "也就是说，你是主人……我绝对无法违抗你"

#. ID 7, Page 1, Line 42, Pos (4,4)
msgid ""
"そればかりか\n"
"部屋を出て向こうにある\\C[5]魔方陣\\C[0]で\n"
"私の魔力の調整ができるわ"
msgstr ""
"不仅如此，\n"
"你还可以用房间外那边的\\C[5]魔法阵\\C[0]来调整我\n"
"的魔力。"

#. ID 7, Page 1, Line 45, Pos (4,4)
msgid ""
"私の記憶や精神も\n"
"あなたに操られてしまう\n"
"それが屍霊術"
msgstr "我的记忆和精神也会被你操纵，那就是尸灵术"

#. ID 7, Page 1, Line 51, Pos (4,4)
msgid ""
"あやつりの輪をはめられて\n"
"肉体や精神の全てを掌握された\n"
"生きた操り人形……それが私"
msgstr ""
"被套上操纵之轮，\n"
"肉体和精神的一切都被掌控的活人偶……那就是我"

#. ID 7, Page 1, Line 54, Pos (4,4)
msgid ""
"完全に意識を奪うタイプじゃないのか\n"
"操られているようには\n"
"見えないけれど……"
msgstr ""
"不是完全夺走意识的那种吗？\n"
"虽然看起来不像是被操纵的……"

#. ID 7, Page 1, Line 58, Pos (4,4)
msgid "……ハァ"
msgstr "……唉"

#. ID 7, Page 1, Line 61, Pos (4,4)
msgid ""
"そればかりか\n"
"部屋を出て向こうにある\\C[5]魔方陣\\C[0]で\n"
"あやつりの輪の操作ができるわ"
msgstr ""
"不仅如此，\n"
"你还能用房间外那边的\\C[5]魔法阵\\C[0]来操作操纵\n"
"之轮。"

#. ID 7, Page 1, Line 64, Pos (4,4)
msgid ""
"私の記憶や精神も\n"
"あなたに操られてしまう\n"
"どんなことでも命令できる\n"
"……それがあやつりの輪"
msgstr ""
"我的记忆和精神也会被你操纵，无论什么都能命令……\n"
"那就是操纵之轮"

#. ID 7, Page 1, Line 69, Pos (4,4)
msgid ""
"……あなたも\n"
"知っているとおり、ね"
msgstr "……就像你也知道的那样，对吧"

#. ID 7, Page 1, Line 74, Pos (4,4)
msgid ""
"……こんな風に、\n"
"私が不利になる情報でも\n"
"もう隠すこともできないわ"
msgstr "……就像这样，连对我不利的信息也已经无法隐瞒了。"

#. ID 7, Page 1, Line 77, Pos (4,4)
msgid "……それがお望みなのよね"
msgstr "……那就是你所希望的吧"

#. ID 7, Page 2, Line 5, Pos (4,4)
#. ID 7, Page 5, Line 5, Pos (4,4)
msgid "………？"
msgstr "………？"

#. ID 7, Page 2, Line 8, Pos (4,4)
msgid ""
"……私の身体をじろじろ見て……\n"
"まさか、何かしたの……？"
msgstr "……盯着我的身体看……难道，你做了什么……？"

#. ID 7, Page 4, Line 5, Pos (4,4)
msgid "\\S[17]………"
msgstr "\\S[17]………"

#. ID 7, Page 4, Line 6, Pos (4,4)
msgid "\\S[14]………ッ！"
msgstr "\\S[14]………唔！"

#. ID 7, Page 4, Line 7, Pos (4,4)
msgid ""
"あ、あなたは……ッ！\n"
"私の記憶からトイレを消したわね！？\n"
"は、はやくもとに……"
msgstr ""
"你、你……唔！你把厕所从我的记忆里删掉了对吧！？\n"
"快、快恢复原状……"

#. ID 7, Page 4, Line 10, Pos (4,4)
#. Contains choice at line 3 (2 options)
msgid ""
"……お、お願い……\n"
"トイレ、トイレに行かせて……！"
msgstr "……求、求你了……厕所，让我去厕所……！"

#. ID 7, Page 4, Line 14, Pos (4,4)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"いいえ"
msgstr ""
"不\n"
"不"

#. ID 7, Page 4, Line 23, Pos (4,4)
msgid ""
"そ、そんな……\n"
"い、いや……で、……\n"
"漏れ……うう……"
msgstr "怎、怎么会……不、不要……要、……漏出来了……呜呜……"

#. ID 7, Page 4, Line 28, Pos (4,4)
#. Choice (2 options)
msgid ""
"「漏らせ」と命令する\n"
"黙ってみている"
msgstr ""
"命令「漏出来」\n"
"默默看着"

#. ID 7, Page 4, Line 34, Pos (4,4)
msgid ""
"ひ、そ、そんな嫌……\n"
"あ、ああ……"
msgstr "不、那、那种事不要……啊、啊啊……"

#. ID 7, Page 4, Line 39, Pos (4,4)
msgid ""
"わか、わかりました……\n"
"私はここで……着たまま……\n"
"漏らします……\n"
"…いやぁ……"
msgstr ""
"我、我明白了……我就在这里……穿着衣服……漏出来………\n"
"不要啊……"

#. ID 7, Page 4, Line 48, Pos (4,4)
msgid "\\S[16]もう……だ、め……っ"
msgstr "\\S[16]已经……不、行了……唔"

#. ID 7, Page 4, Line 68, Pos (4,4)
msgid "\\S[16]あ、あ、あああ……"
msgstr "\\S[16]啊、啊、啊啊啊……"

#. ID 7, Page 4, Line 70, Pos (4,4)
#. ID 7, Page 7, Line 4, Pos (4,4)
msgid ""
"\\S[16]あ、あ、あは……\n"
"あはは……は……"
msgstr "\\S[16]啊、啊、啊哈……啊哈哈……哈……"

#. ID 7, Page 5, Line 7, Pos (4,4)
msgid "…………くっ"
msgstr "…………唔"

#. ID 7, Page 5, Line 9, Pos (4,4)
msgid ""
"……こんな……\n"
"身体が火照って……\n"
"ううっ"
msgstr "……这样……身体发烫……呜呜"

#. ID 7, Page 5, Line 15, Pos (4,4)
#. Choice (2 options)
msgid ""
"売春をさせる\n"
"黙ってみている"
msgstr ""
"让她卖淫\n"
"默默看着"

#. ID 7, Page 5, Line 20, Pos (4,4)
msgid ""
"………\n"
"嘘…また身売り？\n"
msgstr "………骗人…又要卖身？"

#. ID 7, Page 5, Line 31, Pos (4,4)
#. Choice (2 options)
msgid ""
"売春をやらせる\n"
"黙ってみている"
msgstr ""
"让她去卖淫\n"
"默默看着"

#. ID 7, Page 5, Line 36, Pos (4,4)
msgid ""
"………？\n"
"い、いったい何を……"
msgstr "………？你、到底要做什么……"

#. ID 7, Page 5, Line 39, Pos (4,4)
msgid "言って……"
msgstr "说啊……"

#. ID 7, Page 5, Line 42, Pos (4,4)
msgid ""
"ま、まさか……\n"
"本気じゃないわよね？\n"
"違うわよね？嘘よね？"
msgstr "难、难道……你不是认真的吧？不是吧？是骗人的吧？"

#. ID 7, Page 5, Line 47, Pos (4,4)
#. Choice (2 options)
msgid ""
"売春をさせる\n"
"やはり何もさせない"
msgstr ""
"让她卖淫\n"
"果然还是什么都不让她做"

#. ID 7, Page 5, Line 56, Pos (4,4)
msgid ""
"あ、ひ……\n"
"い、いや……"
msgstr "啊、咿……不、不要……"

#. ID 7, Page 5, Line 58, Pos (4,4)
msgid ""
"やめて！\n"
"それはやめて、お願い……"
msgstr "住手！那个不要，求你了……"

#. ID 7, Page 5, Line 62, Pos (4,4)
msgid ""
"い、いや……\n"
"おねが……"
msgstr "不、不要……求求……"

#. ID 7, Page 5, Line 67, Pos (4,4)
msgid "あ、う、あ………"
msgstr "啊、呜、啊………"

#. ID 7, Page 5, Line 75, Pos (4,4)
msgid ""
"はい……\n"
"ご主人様……"
msgstr "是……主人……"

#. ID 7, Page 5, Line 77, Pos (4,4)
msgid ""
"わたしは売春します……\n"
"今晩から売春して……\n"
"稼いだお金は全てお渡しします"
msgstr ""
"我会去卖淫……从今晚开始卖淫……\n"
"赚到的金钱全部交给您"

#. ID 7, Page 5, Line 83, Pos (4,4)
#. ID 7, Page 8, Line 20, Pos (4,4)
#. ID 7, Page 8, Line 30, Pos (4,4)
#. Contains choice at line 2 (2 options)
msgid "う、ううう……"
msgstr "呜、呜呜呜……"

#. ID 7, Page 6, Line 18, Pos (4,4)
msgid ""
"あっぁあぁ……\\c[11]$k\\c[0]\n"
"ぁ、からだが、\n"
"かって……にっ……\\c[11]$k$k"
msgstr ""
"啊、啊啊……\\c[11]$k\\c[0]啊、身体、擅自……地……\n"
"\\c[11]$k$k"

#. ID 7, Page 6, Line 21, Pos (4,4)
msgid "た、助……くぅぅぅぅ\\c[11]$k$k"
msgstr "救、救命……唔呜呜呜\\c[11]$k$k"

#. ID 7, Page 6, Line 38, Pos (4,4)
msgid ""
"あっ、くっ、ひぃぃ……\n"
"い、いやぁぁああ……\\c[11]$k\\c[0]"
msgstr "啊、唔、咿呀……不、不要啊啊啊……\\c[11]$k\\c[0]"

#. ID 7, Page 6, Line 40, Pos (4,4)
msgid ""
"あたまぁ……とけるぅ……\n"
"ばかになるぅ\\c[11]$k\\c[0]"
msgstr "脑袋……要融化了……要变傻了\\c[11]$k\\c[0]"

#. ID 7, Page 6, Line 42, Pos (4,4)
msgid ""
"おなにー、すきぃ……\\c[11]$k$k\n"
"くるっひゃう\\c[11]$k$k\n"
"おなにー、すきでくるうぅ\\c[11]$k$k"
msgstr ""
"自慰，好喜欢……\\c[11]$k$k要疯了\\c[11]$k$k自慰，\n"
"喜欢得发狂\\c[11]$k$k"

#. ID 7, Page 8, Line 9, Pos (4,4)
msgid ""
"や……\n"
"やってきたわ！\n"
"稼いできたわよ！"
msgstr "我……我回来了！赚到钱了哦！"

#. ID 7, Page 8, Line 14, Pos (4,4)
msgid "＊稼いだ金を受け取った"
msgstr "＊收下了赚到的钱"

#. ID 7, Page 8, Line 27, Pos (4,4)
msgid ""
"わたしは売春します……\n"
"稼いだお金は全てお渡しします"
msgstr "我会去卖淫……赚到的金钱全部交给您"

#. ID 7, Page 8, Line 33, Pos (4,4)
#. Choice (2 options, embedded in a message)
msgid ""
"売春をつづけさせる\n"
"売春をやめさせる"
msgstr ""
"让她继续卖淫\n"
"让她停止卖淫"

#. ID 7, Page 8, Line 37, Pos (4,4)
msgid "＊エスラスへの売春命令を取り消しました"
msgstr "＊取消了对埃斯拉斯的卖淫命令"

#. ID 41, Page 1, Line 3, Pos (5,63)
msgid ""
"見習いの魔法使いは\n"
"ここで熟練の魔法使いの教えを学ぶんだ"
msgstr "见习魔法师在这里学习熟练魔法师的教导"

#. ID 41, Page 1, Line 5, Pos (5,63)
msgid "魔法学校、とでもいえばいいのかな"
msgstr "该说是魔法学校之类的吧"

#. ID 42, Page 1, Line 6, Pos (9,56)
msgid "バーニングフィンガーアタック！"
msgstr "燃烧手指攻击！"

#. ID 42, Page 1, Line 13, Pos (9,56)
msgid "ついに完成したぜ……肩こりを治す魔法だ！"
msgstr "终于完成了……这是治疗肩膀酸痛的魔法！"

#. ID 43, Page 1, Line 6, Pos (12,56)
msgid "メケェェェェェェェ！！"
msgstr "咩呵呵呵呵呵呵呵！！"

#. ID 43, Page 1, Line 13, Pos (12,56)
msgid "……どうやら失敗のようね"
msgstr "……看来失败了呢"

#. ID 44, Page 1, Line 3, Pos (1,55)
msgid "はて……どこまで教えたんじゃったっけ"
msgstr "哎呀……我教到哪儿了来着"

#. ID 45, Page 1, Line 4, Pos (4,56)
msgid "ねこちゃんだー！"
msgstr "是小猫呀——！"

#. ID 45, Page 1, Line 7, Pos (4,56)
msgid ""
"このおじいちゃん先生……\n"
"自分が誰だったのかも忘れちゃうのよ……\n"
"本当に大魔法使いだったのかしら"
msgstr ""
"这位老爷爷老师……连自己是谁都忘了呢……\n"
"真的是大魔法师吗？"

#. ID 46, Page 1, Line 3, Pos (6,54)
msgid "Ｚｚｚ..."
msgstr "Zzz..."

#. ID 47, Page 1, Line 3, Pos (19,62)
msgid "適度な休憩は必要よ"
msgstr "适度的休息是必要的哦"

#. ID 48, Page 1, Line 3, Pos (18,55)
msgid ""
"研究室に若い男の魔法使いが入ったんだけど\n"
"なんというか、すごく不気味なのよね……"
msgstr ""
"研究室里进来了一个年轻男魔法师，怎么说呢，\n"
"感觉非常诡异呢……"

#. ID 48, Page 1, Line 5, Pos (18,55)
msgid ""
"誰ともコミュニケーションをとろうとしないし……\n"
"いっつもブツブツなにか呟いているし"
msgstr "不跟任何人交流……而且总是嘟嘟囔囔地念叨着什么"

#. ID 48, Page 1, Line 7, Pos (18,55)
msgid ""
"危険な人じゃないかしら……\n"
"ギルド長は考えているのやら"
msgstr "不会是个危险的人吧……不知道公会会长是怎么想的"

#. ID 55, Page 1, Line 1, Pos (1,41)
msgid ""
"＊無駄だ無駄だ無駄だ無駄だ無駄だ無駄だ\n"
"　エスラスに知識は渡さない\n"
"　知識は全部全て僕の僕のモノだ！"
msgstr ""
"＊没用没用没用没用没用没用　不会把知识交给艾斯\n"
"　拉斯　知识全部全都是我的我的东西！"

#. ID 61, Page 1, Line 3, Pos (2,41)
msgid "ヒ……ヒヒ……"
msgstr "嘻……嘻嘻……"

#. ID 61, Page 1, Line 10, Pos (2,41)
msgid ""
"古代魔法……\n"
"禁忌……ヒヒッ……禁呪……"
msgstr "古代魔法……禁忌……嘻嘻……禁咒……"

#. ID 61, Page 1, Line 18, Pos (2,41)
msgid ""
"魔導……ガストラ……\n"
"禁術……あやつり……ヒヒ……"
msgstr "魔导……加斯特拉……禁术……操纵……嘻嘻……"

#. ID 61, Page 1, Line 26, Pos (2,41)
msgid ""
"ヒヒ……ヒ……ヒ……\n"
"知識……\n"
"渡さない……渡さない……ヒ……"
msgstr ""
"嘻嘻……嘻……嘻……知识……不会交出去……不会交出去……\n"
"嘻……"

#. ID 66, Page 1, Line 3, Pos (30,31)
msgid ""
"＊ゴーレム研究室\n"
"　担当：ナタナエル"
msgstr "＊魔像研究室　负责人：纳塔纳艾尔"

#. ID 68, Page 1, Line 3, Pos (9,23)
msgid ""
"＊女性の魔法使いが際どい下着で\n"
"　危険なポーズをとっている写真の貼られた本だ"
msgstr ""
"＊这是一本贴着女魔法师身穿暴露内衣、\n"
"　摆出危险姿势照片的书"

#. ID 69, Page 1, Line 3, Pos (8,25)
msgid ""
"オレ！\n"
"魔法使い！"
msgstr "我！魔法师！"

#. ID 69, Page 1, Line 5, Pos (8,25)
msgid ""
"オレの！\n"
"最強の魔法！\n"
"見せる！"
msgstr "我的！最强魔法！给你看！"

#. ID 69, Page 1, Line 15, Pos (8,25)
msgid ""
"\n"
"　　　ま　　　ほ　　　う　　　　！"
msgstr "　　　魔　　　法　　　　！"

#. ID 69, Page 1, Line 21, Pos (8,25)
msgid ""
"\n"
"　　　　ふ　　　　　ん\"　　　　ッ　　　！"
msgstr ""
"哼\"\n"
"　　　　！"

#. ID 69, Page 1, Line 32, Pos (8,25)
msgid "どうだ！？"
msgstr "怎么样！？"

#. ID 69, Page 1, Line 37, Pos (8,25)
msgid ""
"遠くから！\n"
"殴る！\n"
"魔法！"
msgstr "从远处！揍！魔法！"

#. ID 72, Page 1, Line 5, Pos (42,38)
#. ID 73, Page 1, Line 5, Pos (43,38)
#. ID 74, Page 1, Line 5, Pos (44,38)
msgid ""
"＊露出の多い服が収まっている\n"
"　着用者の趣味だろう"
msgstr "＊里面收着暴露的衣服　大概是穿戴者的趣味吧"

#. ID 75, Page 1, Line 4, Pos (44,40)
msgid ""
"はじめまして～～\n"
"私は～～南国の～～歌姫です～～"
msgstr "初次见面～～我是～～南国的～～歌姬～～"

#. ID 75, Page 1, Line 10, Pos (44,40)
msgid ""
"なんか～～私の「歌」に～～\n"
"魔法のような～～効果がある、って～～\n"
"言われまして～～"
msgstr ""
"人家跟我说～～我的「歌」\n"
"～～好像有～～魔法般的～～效果～～"

#. ID 75, Page 1, Line 17, Pos (44,40)
msgid ""
"ここまで～～つれてこられて～～\n"
"しまいました～～"
msgstr "就这样被带到～～这里来了～～"

#. ID 78, Page 1, Line 3, Pos (39,23)
msgid ""
"＊魔物の生態が書かれた本だ\n"
"　色々加筆しているらしく、ページは真っ黒だ。"
msgstr ""
"＊这是写着魔物生态的书　似乎做了各种增补，\n"
"　页面一片漆黑。"

#. ID 79, Page 1, Line 3, Pos (41,23)
msgid ""
"「物体を召喚する魔法」……\n"
"召喚術と呼ばれているが、こちらは既存の魔法と違い\n"
"まだ詳しく解明されていない。"
msgstr ""
"「召唤物体的魔法」……虽然被称为召唤术，\n"
"但与现有魔法不同，尚未被详细探明。"

#. ID 79, Page 1, Line 6, Pos (41,23)
msgid ""
"召喚した魔物や生物を支配し戦わせたり\n"
"剣や鎧などの武器や兵器を自在に取り出せれば\n"
"これほど便利な術はないのだが……"
msgstr ""
"如果能支配召唤出的魔物或生物让其战斗，\n"
"或自由取出剑、铠甲等武器和兵器，\n"
"那就没有比这更方便的术了……"

#. ID 79, Page 1, Line 9, Pos (41,23)
msgid ""
"古代の書物の研究が進んで\n"
"小さな魔物くらいなら召喚できるようにはなったが\n"
"実用化にはまだまだ時間が掛かりそうだ"
msgstr ""
"随着古代书籍研究的推进，\n"
"已经能够召唤小型魔物了，\n"
"但距离实用化似乎还需要很长时间"

#. ID 81, Page 1, Line 3, Pos (45,24)
msgid ""
"＊ケルベロスの召喚……と書いてあるが\n"
"　柵の中に居るのはどう見ても子犬だ。"
msgstr ""
"＊上面写着……召唤刻耳柏洛斯……\n"
"　但待在栅栏里的怎么看都是小狗。"

#. ID 82, Page 1, Line 4, Pos (36,23)
#. ID 84, Page 1, Line 4, Pos (34,25)
#. ID 99, Page 1, Line 3, Pos (25,24)
msgid "…………"
msgstr "…………"

#. ID 83, Page 1, Line 3, Pos (20,24)
msgid "ヒッヒッヒ……何か用事かい？"
msgstr "嘻嘻嘻……有什么事吗？"

#. ID 83, Page 1, Line 6, Pos (20,24)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "アラクネ"
msgstr "阿剌克涅"

#. ID 83, Page 1, Line 9, Pos (20,24)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "気味の悪い男"
msgstr "令人毛骨悚然的男人"

#. ID 83, Page 1, Line 12, Pos (20,24)
#. Choice (4 options)
msgid ""
"何の魔法を研究しているのか\n"
"ギルド長は何者か\n"
"禁呪について\n"
"\\n[101]について"
msgstr ""
"在研究什么魔法\n"
"公会会长是什么人\n"
"关于禁咒\n"
"关于\\n[101]"

#. ID 83, Page 1, Line 14, Pos (20,24)
msgid ""
"私は見ての通り……\n"
"古くから伝わる魔法を研究しておるんじゃよ"
msgstr "我正如你所见……在研究自古流传下来的魔法哦"

#. ID 83, Page 1, Line 16, Pos (20,24)
msgid ""
"古いからといってバカには出来ん……\n"
"調べることで新しい発見が\n"
"あるかもしれないしねぇ、ヒッヒッヒ"
msgstr ""
"虽说古老，但可不能小看……\n"
"调查一下说不定会有新发现呢，嘻嘻嘻"

#. ID 83, Page 1, Line 23, Pos (20,24)
#. ID 83, Page 1, Line 35, Pos (20,24)
msgid ""
"ギルド長は先代ギルドの息子さんでねぇ\n"
"若いんでどうもそそっかしいんじゃが\n"
"熱意は十分あったみたいじゃよ"
msgstr ""
"公会会长是前任公会会长的儿子，因为年轻，\n"
"总觉得有些冒失，但似乎有十足的热情哦"

#. ID 83, Page 1, Line 26, Pos (20,24)
#. ID 83, Page 1, Line 38, Pos (20,24)
msgid "……まあ、もう亡くなっちまったがねえ"
msgstr "……不过嘛，他已经去世了。"

#. ID 83, Page 1, Line 27, Pos (20,24)
#. ID 83, Page 1, Line 39, Pos (20,24)
msgid ""
"その補佐に\n"
"副ギルド長がついていたんじゃが……"
msgstr "当时由公会副会长辅佐他……"

#. ID 83, Page 1, Line 29, Pos (20,24)
msgid "副ギルド長も行方不明になってしまってのぉ"
msgstr "可公会副会长也下落不明了哦"

#. ID 83, Page 1, Line 30, Pos (20,24)
msgid "……苦労は続くもんじゃわい"
msgstr "……辛苦事真是接连不断啊"

#. ID 83, Page 1, Line 41, Pos (20,24)
msgid ""
"副ギルド長もギルド長がなくなったショックで\n"
"どこかへ行かれてしまってねえ"
msgstr ""
"公会副会长也因为公会会长去世的打击，\n"
"不知去了哪里啊"

#. ID 83, Page 1, Line 43, Pos (20,24)
msgid "……やっぱ恋でもしとったかねぇ？"
msgstr "……果然是谈恋爱了吗？"

#. ID 83, Page 1, Line 47, Pos (20,24)
msgid ""
"ギルド長は先代ギルドの息子さんでねぇ\n"
"若いんでどうもそそっかしいんじゃが\n"
"熱意は十分あるみたいじゃよ"
msgstr ""
"公会会长是前任公会会长的儿子，因为年轻，\n"
"总觉得有些冒失，但似乎有十足的热情哦"

#. ID 83, Page 1, Line 50, Pos (20,24)
msgid ""
"……ただ、最近どうもぼんやりしているというか\n"
"心此処にあらず、といった面持ちだねぇ"
msgstr ""
"……不过，最近总觉得他有些心不在焉，\n"
"或者说魂不守舍的样子呢"

#. ID 83, Page 1, Line 52, Pos (20,24)
msgid ""
"まあ今はその補佐に\n"
"副ギルド長がついているが、どうしたものやら……"
msgstr "不过现在由公会副会长担任辅佐，但不知会怎样……"

#. ID 83, Page 1, Line 54, Pos (20,24)
msgid "恋でもしたのかねぇヒッヒッヒ！"
msgstr "是不是谈恋爱了呢，嘻嘻嘻！"

#. ID 83, Page 1, Line 58, Pos (20,24)
msgid ""
"禁じられた魔法のことじゃよ\n"
"古代の魔法使いが余りの危険さに封印したとも\n"
"言われているがねぇ"
msgstr ""
"说的是被禁止的魔法哦　据说古代魔法师因其过于危\n"
"险而将其封印了呢"

#. ID 83, Page 1, Line 61, Pos (20,24)
msgid ""
"１つは、生物の生死や死体を操る魔法……\n"
"２つは、人間の意思や肉体を操る魔法……\n"
"３つは、太陽を作り出す魔法と言われているねぇ"
msgstr ""
"其一是操纵生物生死或尸体的魔法……\n"
"其二是操纵人的意志或肉体的魔法……\n"
"其三据说是创造出太阳的魔法呢"

#. ID 83, Page 1, Line 67, Pos (20,24)
msgid ""
"あいつかい？\n"
"中々生徒たちからも気味悪がられているからねぇ\n"
"わたしもギルド長に文句いったもんさ"
msgstr ""
"你说那家伙吗？学生们也觉得他相当恶心，\n"
"所以我也向公会会长抱怨过呢"

#. ID 83, Page 1, Line 71, Pos (20,24)
msgid ""
"とうとう、魔導院で調査員を攻撃し、\n"
"監禁するとか……\n"
"だからいったのにねぇ"
msgstr ""
"听说他终于在魔导院攻击并监禁了调查员……\n"
"所以我不是说过了嘛"

#. ID 83, Page 1, Line 74, Pos (20,24)
msgid ""
"あいつは魔導……古代魔法の研究をしとった筈じゃ\n"
"何かで気が触れてしまったのかもねえ"
msgstr ""
"那家伙应该是在研究魔导……古代魔法，\n"
"说不定是因为什么而精神错乱了吧"

#. ID 83, Page 1, Line 79, Pos (20,24)
msgid ""
"ただ、ギルド長は問題ないって仰ってねぇ\n"
"まあ確かに……何か問題を起こしているわけじゃあ\n"
"ないからねぇ"
msgstr ""
"不过，公会会长说没有问题呢　嘛，确实……\n"
"他也没有引发什么问题嘛"

#. ID 83, Page 1, Line 82, Pos (20,24)
msgid ""
"あいつは魔導……古代魔法の研究をしとった筈じゃ\n"
"古代の魔法使いたちが研究所として入っていた\n"
"魔導院を調査しているらしいがねぇ"
msgstr ""
"那家伙应该是在研究魔导……古代魔法，\n"
"听说他正在调查古代魔法师们曾作为研究所使用的魔\n"
"导院呢"

#. ID 84, Page 1, Line 14, Pos (34,25)
msgid "ああ、彼女かい？"
msgstr "啊，你说她吗？"

#. ID 84, Page 1, Line 20, Pos (34,25)
msgid ""
"人のように見えるだろう？\n"
"だけど彼女は古代の遺跡から\n"
"発掘された自動人形なんだ"
msgstr ""
"看起来像人吧？\n"
"但她是从古代遗迹中发掘出来的自动人偶"

#. ID 84, Page 1, Line 23, Pos (34,25)
msgid ""
"見つかったときは身体もボロボロで…\n"
"……なんとなく可愛そうでね\n"
"ここまで直してあげるのには苦労したよ"
msgstr ""
"被发现的时候身体也破破烂烂的………总觉得很可怜，\n"
"把她修到这个程度可费了不少劲哦"

#. ID 84, Page 1, Line 31, Pos (34,25)
msgid ""
"ゴーレムのように動かせるかと思ったが\n"
"ちょっと勝手が違うようでね……"
msgstr "我以为能像魔像一样驱动她，但好像有点不一样呢……"

#. ID 84, Page 1, Line 33, Pos (34,25)
msgid ""
"どうすれば動いてくれるのか\n"
"まだ研究中なんだ"
msgstr "要怎样才能让她动起来，我还在研究中"

#. ID 84, Page 2, Line 4, Pos (34,25)
#. ID 84, Page 3, Line 4, Pos (34,25)
msgid ""
"こんにちは\n"
"私は自動人形\n"
"オランピア　です"
msgstr "你好，我是自动人偶奥林匹亚"

#. ID 84, Page 2, Line 7, Pos (34,25)
msgid ""
"ご主人様の\n"
"ナタナエル様に\n"
"直していただきました"
msgstr "是主人纳塔纳艾尔大人把我修好的"

#. ID 84, Page 2, Line 10, Pos (34,25)
msgid ""
"私のメモリーにある\n"
"古代の状況とは全く違う環境なので\n"
"色々と勉強しようと思います"
msgstr ""
"因为这里与我的记忆中的古代情况是完全不同的\n"
"　环境，所以我想多学习各种事物"

#. ID 84, Page 3, Line 11, Pos (34,25)
msgid ""
"あなたは……\n"
"ナタナエル様に伺いました\n"
"あなたが私の部品を集めて\n"
"くださったのだと"
msgstr "你……我听纳塔纳艾尔大人说了，是你帮我收集了零件"

#. ID 84, Page 3, Line 15, Pos (34,25)
msgid ""
"本当に有難うございます\n"
"……それでお礼というわけでは\n"
"ないのですが……"
msgstr "真的非常感谢……所以虽说这不是谢礼……"

#. ID 84, Page 3, Line 21, Pos (34,25)
msgid "＊[瑪瑙の欠片]を手に入れた"
msgstr "＊获得了[玛瑙碎片]"

#. ID 84, Page 3, Line 28, Pos (34,25)
msgid ""
"メモリーが破損しているので\n"
"何かは詳しく解らないのですが\n"
"私はそれを持っていたそうなのです"
msgstr ""
"因为记忆损坏了，所以不太清楚那是什么，\n"
"但据说我曾经拥有它"

#. ID 84, Page 3, Line 31, Pos (34,25)
msgid ""
"私の出自に関係するモノなのかも\n"
"しれませんが……\n"
"よろしければお持ちください"
msgstr ""
"这或许是与我的出身有关的东西……如果不介意的话，\n"
"请收下吧"

#. ID 86, Page 1, Line 4, Pos (31,25)
msgid "こんにちは"
msgstr "你好"

#. ID 86, Page 1, Line 5, Pos (31,25)
msgid ""
"ここはゴーレム研究室……\n"
"無生物に魔法を吹き込んで\n"
"生きている様に動かす研究をしている"
msgstr ""
"这里是魔像研究室……在进行向无生物注入魔法、\n"
"使其像活着一样行动的研究"

#. ID 86, Page 1, Line 8, Pos (31,25)
msgid ""
"生きているように、と言っても\n"
"動きの滑らかさとかはともかく\n"
"実際は命令通りにしか動かないがね"
msgstr ""
"虽说像活着一样，但先不论动作的流畅度，\n"
"实际上只会按命令行动。"

#. ID 86, Page 1, Line 15, Pos (31,25)
msgid ""
"古代のゴーレム……自動人形は、\n"
"自分の意思で動くことが出来たと聞く。\n"
"僕はそれも研究しているんだ。"
msgstr ""
"古代的魔像……听说自动人偶能够凭自己的意志行动。\n"
"我也在研究那个。"

#. ID 86, Page 1, Line 19, Pos (31,25)
msgid ""
"……君は中々冒険に慣れていそうだ\n"
"見たことがないか？自動人形を"
msgstr "……你看起来相当习惯冒险。你没见过自动人偶吗？"

#. ID 86, Page 1, Line 25, Pos (31,25)
msgid ""
"もし自動人形の部品……\n"
"[シリンダーの心臓]を見つけたら\n"
"是非譲って欲しい、お願いだ"
msgstr ""
"如果你找到自动人偶的零件……[气缸之心]，\n"
"请务必让给我，拜托了"

#. ID 86, Page 1, Line 28, Pos (31,25)
#. Choice (2 options)
#. ID 100, Page 1, Line 29, Pos (24,24)
#. Choice (2 options, embedded in a message)
#. ID 100, Page 1, Line 74, Pos (24,24)
#. Choice (2 options, embedded in a message)
#. ID 113, Page 2, Line 11, Pos (30,8)
#. Choice (2 options, embedded in a message)
#. ID 113, Page 3, Line 11, Pos (30,8)
#. Choice (2 options, embedded in a message)
#. ID 113, Page 4, Line 19, Pos (30,8)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 86, Page 1, Line 31, Pos (31,25)
msgid ""
"そうか、有難う\n"
"報酬は必ず用意しよう\n"
"よろしく頼む"
msgstr "这样啊，谢谢。报酬我一定会准备好，拜托了"

#. ID 86, Page 1, Line 38, Pos (31,25)
msgid "そうか……残念だ"
msgstr "这样啊……真遗憾"

#. ID 86, Page 2, Line 4, Pos (31,25)
msgid ""
"自動人形は古代の遺跡など\n"
"そういった場所にあるはずだ"
msgstr "自动人偶应该就在古代遗迹之类的场所。"

#. ID 86, Page 2, Line 6, Pos (31,25)
msgid ""
"ただ……大抵の遺跡は盗掘されている\n"
"どこか人が全く行った事のない\n"
"遠い場所にならあるかもしれないが"
msgstr ""
"不过……大多数遗迹都已被盗掘，\n"
"或许在某个完全没人去过的遥远地方才会有。"

#. ID 86, Page 3, Line 4, Pos (31,25)
msgid ""
"おお……！\n"
"それは[シリンダーの心臓]！\n"
"本当に見つけ出してくれるとは！"
msgstr "哦哦……！那是[气缸之心]！没想到你真的找到了！"

#. ID 86, Page 3, Line 10, Pos (31,25)
msgid "＊[シリンダーの心臓]を手渡しました"
msgstr "＊递交了[气缸之心]"

#. ID 86, Page 3, Line 15, Pos (31,25)
msgid ""
"これで彼女も目を覚ますだろう\n"
"……本当に有難う"
msgstr "这样一来她也会醒来吧……真的谢谢你"

#. ID 86, Page 3, Line 23, Pos (31,25)
msgid "＊[クリスタルのかけら]を手に入れました"
msgstr "＊获得了[水晶碎片]"

#. ID 86, Page 4, Line 4, Pos (31,25)
msgid ""
"やあ！\n"
"お陰で彼女を直すことができたよ！"
msgstr "呀！多亏你，我才能把她修好！"

#. ID 86, Page 4, Line 6, Pos (31,25)
msgid ""
"お手伝いとして居てくれると言うし\n"
"色々教えてあげているんだ\n"
"大変だけどとても充実しているよ！"
msgstr ""
"她说愿意作为帮手留下来，\n"
"所以我正在教她各种东西。虽然很辛苦，\n"
"但非常充实！"

#. ID 86, Page 4, Line 9, Pos (31,25)
msgid ""
"また何かあったら\n"
"お使いを頼むかもしれないけど\n"
"そのときはお願いするよ！"
msgstr ""
"如果又发生什么事，我可能还会拜托你跑腿，\n"
"到时候就麻烦你了！"

#. ID 86, Page 5, Line 5, Pos (31,25)
msgid ""
"君は……その体は自動人形か！？\n"
"一体何があったっていうんだい？"
msgstr "你……那具身体是自动人偶吗！？到底发生了什么？"

#. ID 86, Page 5, Line 7, Pos (31,25)
msgid ""
"何か困ったことがあったら力になるよ\n"
"君は恩人だからね"
msgstr "如果有什么困难，我会帮忙的，因为你是我的恩人。"

#. ID 86, Page 5, Line 15, Pos (31,25)
msgid ""
"体の調子がおかしくなってきた？\n"
"よし、ちょっと見せてもらえるかな？"
msgstr "身体开始不舒服了吗？好，能让我稍微看一下吗？"

#. ID 86, Page 5, Line 25, Pos (31,25)
msgid ""
"故障箇所はわかったけど\n"
"修理に使う材料が無くてね……"
msgstr "故障的地方我知道了，但没有修理用的材料啊……"

#. ID 86, Page 5, Line 27, Pos (31,25)
msgid ""
"自動人形の装甲部品あたりが\n"
"手に入れば直せそうだけど\n"
"なにか心当たりはないかな？"
msgstr ""
"如果能拿到自动人偶的装甲部件之类的，\n"
"似乎就能修好，你有什么线索吗？"

#. ID 86, Page 5, Line 31, Pos (31,25)
msgid ""
"その「金属装甲」は……！\n"
"それがあれば君を直せそうだけど\n"
"どうする？"
msgstr ""
"那个「金属装甲」是……！\n"
"有那个的话似乎就能修好你，你要怎么做？"

#. ID 86, Page 5, Line 38, Pos (31,25)
#. Choice (2 options)
msgid ""
"修理を頼む\n"
"断る"
msgstr ""
"请求修理\n"
"拒绝"

#. ID 86, Page 5, Line 44, Pos (31,25)
msgid ""
"よし、そこに横になってくれ\n"
"すぐ終わるからね"
msgstr "好，你躺到那里吧，马上就结束。"

#. ID 86, Page 5, Line 68, Pos (31,25)
msgid ""
"完了したよ\n"
"また調子が悪くなったら言ってくれ\n"
"材料を持ってきてくれれば修理するよ"
msgstr ""
"完成了。如果又不舒服了就告诉我，\n"
"只要把材料带来，我就帮你修理。"

#. ID 86, Page 5, Line 77, Pos (31,25)
msgid ""
"そうか……\n"
"気が変わったら言ってくれ\n"
"待っているよ"
msgstr "这样啊……如果改变主意了就告诉我，我等着。"

#. ID 87, Page 1, Line 4, Pos (29,24)
msgid ""
"イラッシャイ…………マセ\n"
"ココハ…………ゴーレムけんきゅうしつ……\n"
"デス"
msgstr "欢迎…………这里…………是魔像研究室……"

#. ID 87, Page 1, Line 7, Pos (29,24)
msgid ""
"ワタシハ……サンドマン……\n"
"デス"
msgstr "我是……沙人……"

#. ID 100, Page 1, Line 5, Pos (24,24)
msgid "よろしくお願いしますね"
msgstr "请多指教。"

#. ID 100, Page 1, Line 14, Pos (24,24)
msgid ""
"ようこそ……\n"
"魔法ギルド・アバロソ本部へ。\n"
"私は副ギルド長のエスラスです。"
msgstr ""
"欢迎来到……魔法公会·阿巴洛索本部。\n"
"我是公会副会长艾斯拉斯。"

#. ID 100, Page 1, Line 17, Pos (24,24)
msgid ""
"ギルド長はまだお若いので\n"
"私がギルド長の補佐・代理を\n"
"務めさせていただいております。"
msgstr ""
"因为公会会长还很年轻，\n"
"所以我担任公会会长的辅佐与代理。"

#. ID 100, Page 1, Line 27, Pos (24,24)
#. Contains choice at line 3 (2 options)
msgid ""
"ところで……少々お話を伺って\n"
"いただけないでしょうか？"
msgstr "对了……能稍微听我说几句话吗？"

#. ID 100, Page 1, Line 32, Pos (24,24)
msgid "有難うございます"
msgstr "非常感谢"

#. ID 100, Page 1, Line 39, Pos (24,24)
msgid "お願いというより依頼になるのですが……"
msgstr "与其说是请求，不如说是一个委托……"

#. ID 100, Page 1, Line 40, Pos (24,24)
msgid ""
"この魔法ギルドはかねてより、\n"
"古代の魔導遺跡の調査を行っているのです"
msgstr "本魔法公会从很早以前就在调查古代的魔导遗迹。"

#. ID 100, Page 1, Line 42, Pos (24,24)
msgid ""
"「ガストラ魔導院」……\n"
"かつて栄華を極めた古代王国から\n"
"存在する重要な場所なのです"
msgstr ""
"「加斯特拉魔导院」……\n"
"是自曾经极尽荣华的古代王国时期起就存在的重要地\n"
"点。"

#. ID 100, Page 1, Line 45, Pos (24,24)
msgid ""
"そこには古代魔法の魔導書や魔道具などもあり\n"
"我々は調査や発掘作業を行っていたのですが……"
msgstr ""
"那里也有古代魔法的魔导书和魔道具等，\n"
"我们一直在进行调查和发掘工作……"

#. ID 100, Page 1, Line 53, Pos (24,24)
msgid ""
"……その調査団のリーダー、\n"
"アラクネが突然、ギルド員を襲い始めたのです"
msgstr ""
"……\n"
"那个调查团的队长阿剌克涅突然开始袭击公会成员。"

#. ID 100, Page 1, Line 56, Pos (24,24)
msgid ""
"調査団というのは……\n"
"魔導院は王国が亡んで以来、\n"
"魔物の住処となってしまったのです"
msgstr ""
"所谓调查团……自从王国灭亡以来，\n"
"魔导院就变成了魔物的巢穴。"

#. ID 100, Page 1, Line 59, Pos (24,24)
msgid ""
"そこで我々は戦闘に長けた魔法使いを集め\n"
"調査団として派遣していました……\n"
"アラクネはその調査団のリーダーだったのです"
msgstr ""
"因此我们聚集了擅长战斗的魔法师，\n"
"作为调查团派遣过去……\n"
"阿剌克涅就是那支调查团的队长。"

#. ID 100, Page 1, Line 62, Pos (24,24)
msgid ""
"……あなたにお願いしたいのは、\n"
"調査員たちの救助と、アラクネの確保です"
msgstr ""
"……我想拜托你的是，救助调查员们，\n"
"以及捕获阿剌克涅。"

#. ID 100, Page 1, Line 65, Pos (24,24)
msgid ""
"……いえ、アラクネの生死は問いません\n"
"彼がすんなり捕まるとは思いませんから"
msgstr ""
"……不，阿剌克涅的生死无所谓，\n"
"因为我不认为他会轻易被捕。"

#. ID 100, Page 1, Line 73, Pos (24,24)
#. Contains choice at line 2 (2 options)
msgid "……依頼を受けていただけますか？"
msgstr "……你愿意接受这个委托吗？"

#. ID 100, Page 1, Line 77, Pos (24,24)
msgid ""
"有難うございます\n"
"アラクネの死亡や調査員の無事が確認でき次第\n"
"報酬の方をお渡しします"
msgstr ""
"非常感谢。一旦确认阿剌克涅死亡以及调查员平安，\n"
"我就会把报酬交给你。"

#. ID 100, Page 1, Line 80, Pos (24,24)
msgid ""
"魔導遺跡へは、隣の老婆の魔法使いに、\n"
"転送の魔法を用意させますので、\n"
"そちらをご利用ください"
msgstr ""
"前往魔导遗迹时，\n"
"我会让隔壁的老婆婆魔法师准备好传送魔法，\n"
"请使用那个。"

#. ID 100, Page 2, Line 5, Pos (24,24)
msgid ""
"有難うございました……\n"
"また、よろしくお願いしますね"
msgstr "非常感谢……今后也请多指教。"

#. ID 100, Page 2, Line 15, Pos (24,24)
msgid ""
"アラクネを倒していただけたのですね！\n"
"有難うございます"
msgstr "你打倒了阿剌克涅呢！非常感谢。"

#. ID 100, Page 2, Line 22, Pos (24,24)
msgid "生存者は確認しました"
msgstr "已确认幸存者。"

#. ID 100, Page 2, Line 24, Pos (24,24)
msgid ""
"……何人か行方不明になってしまったようですが\n"
"……それは仕方がありません"
msgstr "……似乎有几个人失踪了……那也是没办法的事。"

#. ID 100, Page 2, Line 31, Pos (24,24)
msgid "それでは、お約束の報酬です"
msgstr "那么，这是约定的报酬。"

#. ID 100, Page 2, Line 37, Pos (24,24)
msgid "＊[プライムブルー]を手に入れた！"
msgstr "＊获得了[原初蓝]！"

#. ID 101, Page 1, Line 3, Pos (30,24)
msgid "＊人形の構造などが精密に書かれている本だ"
msgstr "＊这是一本精密记载了人偶构造等内容的书。"

#. ID 102, Page 1, Line 3, Pos (23,25)
msgid "＊調査団の行方不明者のリストのようだ"
msgstr "＊似乎是调查团失踪者的名单。"

#. ID 102, Page 1, Line 8, Pos (23,25)
msgid ""
"＊行方不明者は２名\n"
"　コーデイリア　女性\n"
"　サーシャ　　　女性　　"
msgstr "＊失踪者为2名　科迪莉亚　女性　萨莎　　　女性"

#. ID 102, Page 1, Line 11, Pos (23,25)
msgid ""
"＊捜索は打ち切り……\n"
"　（エスラスのサインも書かれている）"
msgstr "＊搜索已中止……　（上面也写着艾斯拉斯的签名）"

#. ID 106, Page 1, Line 3, Pos (3,54)
msgid ""
"＊薄汚れた机だ。\n"
"　落書きもされている。大分古そうだ。"
msgstr ""
"＊是一张有些脏的桌子。　上面还有涂鸦。\n"
"　看起来相当古老。"

#. ID 107, Page 1, Line 3, Pos (17,38)
msgid ""
"そこのガーゴイルの石造は\n"
"ここの魔法使いが作ったんだ"
msgstr "那边的石像鬼石雕是这里的魔法师做的。"

#. ID 107, Page 1, Line 5, Pos (17,38)
msgid "不審者が来たら攻撃を加えるんだってさ"
msgstr "据说如果有可疑人物来了，它就会发动攻击。"

#. ID 108, Page 1, Line 3, Pos (2,32)
msgid ""
"この前のレポートの結果……\n"
"先生に聞きにいくの、嫌だなぁ"
msgstr "上次报告的结果……要去问老师，真不想去啊。"

#. ID 109, Page 1, Line 3, Pos (30,64)
msgid "ここの蔵書の多さはアバロソでも随一だよ。"
msgstr "这里的藏书数量在阿巴洛索也是首屈一指的哦。"

#. ID 109, Page 1, Line 4, Pos (30,64)
msgid "世界でみても……世界だと2番目くらいかな"
msgstr "就算放眼世界……在世界上大概排第二吧。"

#. ID 109, Page 2, Line 8, Pos (30,64)
msgid "本ひっかいちゃだめだよ？"
msgstr "不可以抓书哦？"

#. ID 110, Page 1, Line 3, Pos (36,63)
msgid "自習をする部屋でもあるの"
msgstr "也是自习用的房间吗？"

#. ID 111, Page 1, Line 4, Pos (33,54)
msgid ""
"ここの蔵書は確かにすごいが\n"
"ガストラ魔導院に比べればまだまだ……"
msgstr ""
"这里的藏书确实很厉害，\n"
"但比起加斯特拉魔导院还差得远……"

#. ID 111, Page 1, Line 6, Pos (33,54)
msgid ""
"しかしガストラ魔導院は古代に魔物の襲撃を受け\n"
"今も魔物が蔓延っておるからのう\n"
"腕利きの調査員が向かっておるが骨が折れる"
msgstr ""
"不过加斯特拉魔导院在古代遭到过魔物袭击，\n"
"如今魔物仍在蔓延，所以即便派了能干的调查员去，\n"
"也很费劲啊。"

#. ID 111, Page 1, Line 10, Pos (33,54)
msgid ""
"オマケに裏切り者が魔物を召喚する始末……\n"
"奪還には当分時間がかかりそうじゃのう"
msgstr ""
"更糟的是，竟然还有叛徒召唤魔物……\n"
"要夺回看来暂时得花不少时间啊。"

#. ID 111, Page 1, Line 14, Pos (33,54)
msgid ""
"奪還すれば古代の魔法書物や\n"
"古代の研究の成果が手に入るんじゃがのう……"
msgstr ""
"只要夺回，就能得到古代魔法书籍和古代研究成果，\n"
"不过啊……"

#. ID 112, Page 1, Line 3, Pos (46,33)
msgid "ここの学校の机、1個だけすごく古いんだって"
msgstr "听说这所学校的桌子，只有一张特别旧。"

#. ID 112, Page 1, Line 4, Pos (46,33)
msgid ""
"汚いし落書きもしてあるし、\n"
"取り替えてくれないかなぁ。"
msgstr "又脏又被涂鸦了，能不能给我换掉啊。"

#. ID 113, Page 2, Line 3, Pos (30,8)
#. ID 113, Page 3, Line 3, Pos (30,8)
msgid "＊今はエスラスに売春を命令しているところだ"
msgstr "＊现在正命令埃斯拉斯卖淫。"

#. ID 113, Page 2, Line 4, Pos (30,8)
msgid ""
"＊命令を変更するなら\n"
"　この命令を一旦取り下げよう"
msgstr "＊如果要更改命令　就先撤销这条命令吧"

#. ID 113, Page 2, Line 9, Pos (30,8)
#. Contains choice at line 3 (2 options)
msgid ""
"＊エスラスにつけたあやつりの輪で\n"
"　記憶や感情を操作しますか？"
msgstr ""
"＊要用戴在埃斯拉斯身上的操纵之轮来操作记忆或感\n"
"　情吗？"

#. ID 113, Page 2, Line 14, Pos (30,8)
#. ID 113, Page 3, Line 14, Pos (30,8)
msgid "何を変化させますか？"
msgstr "要改变什么？"

#. ID 113, Page 2, Line 15, Pos (30,8)
#. Choice (4 options)
msgid ""
"常識の操作\n"
"感情の操作\n"
"肉体の操作\n"
"操作をリセットする"
msgstr ""
"常识操作\n"
"感情操作\n"
"肉体操作\n"
"重置操作"

#. ID 113, Page 2, Line 17, Pos (30,8)
#. Choice (4 options)
#. ID 113, Page 3, Line 17, Pos (30,8)
#. Choice (4 options)
msgid ""
"エロ水着を着せる\n"
"衣服の認識を消す\n"
"トイレを忘れさせる\n"
"別の操作"
msgstr ""
"让她穿上色情泳装\n"
"消除对衣服的认知\n"
"让她忘记上厕所\n"
"其他操作"

#. ID 113, Page 2, Line 36, Pos (30,8)
#. Choice (2 options)
#. ID 113, Page 3, Line 36, Pos (30,8)
#. Choice (2 options)
msgid ""
"発情させる\n"
"別の操作"
msgstr ""
"让她发情\n"
"其他操作"

#. ID 113, Page 2, Line 47, Pos (30,8)
#. Choice (2 options)
#. ID 113, Page 3, Line 47, Pos (30,8)
#. Choice (2 options)
msgid ""
"強制オナニー\n"
"別の操作"
msgstr ""
"强制自慰\n"
"其他操作"

#. ID 113, Page 2, Line 58, Pos (30,8)
#. ID 113, Page 3, Line 58, Pos (30,8)
msgid "＊操作をリセットして、基本の状態へと戻した"
msgstr "＊重置操作，恢复到了基础状态。"

#. ID 113, Page 2, Line 63, Pos (30,8)
#. ID 113, Page 3, Line 63, Pos (30,8)
msgid "＊エスラスの様子を見てみよう"
msgstr "＊去看看埃斯拉斯的情况吧"

#. ID 113, Page 3, Line 4, Pos (30,8)
msgid ""
"＊魔力を書き換えるなら\n"
"　命令を一旦取り下げよう"
msgstr "＊如果要改写魔力，就先撤销命令吧"

#. ID 113, Page 3, Line 9, Pos (30,8)
#. Contains choice at line 3 (2 options)
msgid ""
"＊エスラスにかけた屍霊術の\n"
"　魔力を変化させますか？"
msgstr "＊要改变施在埃斯拉斯身上的尸灵术的　魔力吗？"

#. ID 113, Page 3, Line 15, Pos (30,8)
#. Choice (4 options)
msgid ""
"“記憶”の魔力調整\n"
"“感情”の魔力調整\n"
"“肉体”の魔力調整\n"
"操作をリセットする"
msgstr ""
"「记忆」的魔力调整\n"
"「感情」的魔力调整\n"
"「肉体」的魔力调整\n"
"重置操作"

#. ID 113, Page 4, Line 4, Pos (30,8)
msgid ""
"＊……魔法の文字から、\n"
"　輝きが失われてしまっているようだ。"
msgstr "＊……魔法文字似乎已经失去了光辉。"

#. ID 113, Page 4, Line 10, Pos (30,8)
msgid ""
"＊人骨だ……まだ小さい人間のもののようだ\n"
"　綺麗に磨かれており、骨にはびっしりと、\n"
"　魔法の文字が書き込まれている"
msgstr ""
"＊是人骨……\n"
"　看起来还是小个子人类的骨头　被磨得很漂亮，\n"
"　骨头上密密麻麻地，　写满了魔法文字"

#. ID 113, Page 4, Line 17, Pos (30,8)
msgid "＊……微かに何かが光ったような……"
msgstr "＊……好像有什么微微闪了一下……"

#. ID 113, Page 4, Line 18, Pos (30,8)
#. Contains choice at line 2 (2 options)
msgid "＊何かあるか、探しますか？"
msgstr "＊要探查一下有没有什么吗？"

#. ID 113, Page 4, Line 21, Pos (30,8)
msgid "＊………………………………"
msgstr "＊………………………………"

#. ID 113, Page 4, Line 29, Pos (30,8)
msgid "＊[冥府の魔符]を手に入れた"
msgstr "＊获得了[冥府魔符]"

#. ID 113, Page 6, Line 3, Pos (30,8)
msgid "＊魔方陣は不思議な光を漂わせている"
msgstr "＊魔法阵漂浮着奇异的光芒"

#. ID 114, Page 1, Line 8, Pos (36,25)
msgid ""
"そちらは　ナタナエル様が\n"
"私に用意してくださった物です"
msgstr "那是　纳塔纳艾尔大人为我准备的东西。"

#. ID 114, Page 1, Line 15, Pos (36,25)
msgid ""
"古代とは衣服や文化が\n"
"違うということなので\n"
"用意してくださったんです"
msgstr ""
"因为听说与古代的衣服和文化不同，\n"
"所以他就为我准备了。"

#. ID 114, Page 1, Line 18, Pos (36,25)
msgid "本当に嬉しいです"
msgstr "我真的很高兴。"

#. ID 114, Page 1, Line 27, Pos (36,25)
msgid ""
"＊メイド服や女性物の際どい下着、\n"
"　バイブや、女性が読む性的な書物が\n"
"　ぎっしり入っている。"
msgstr ""
"＊里面塞满了女仆装、女性用的暴露内衣、\n"
"　振动棒，以及女性阅读的色情书籍。"

#. ID 114, Page 1, Line 40, Pos (36,25)
msgid "＊こちらからでは開けられないようだ"
msgstr "＊从这边似乎打不开。"

#. ID 115, Page 2, Line 3, Pos (35,8)
msgid ""
"＊移動用の魔方陣だが……\n"
"　活動を停止しているようだ"
msgstr "＊是移动用的魔法阵，不过……　似乎已经停止运作了"

#. ID 117, Page 1, Line 3, Pos (24,27)
#. ID 117, Page 2, Line 3, Pos (24,27)
msgid ""
"＊ギルド長がお亡くなりになられてのぉ……\n"
"　まだお若いのに、可哀想に"
msgstr "＊公会会长去世了啊……　明明还那么年轻，真可怜"

#. ID 117, Page 1, Line 5, Pos (24,27)
msgid ""
"＊副ギルド長も大層ショックを受けた様子で……\n"
"　「あり得ない……」と仰いながら\n"
"　どこかへ失踪してしもうた"
msgstr ""
"＊公会副会长也受到了很大冲击的样子……\n"
"　一边说着「不可能……」　一边失踪到什么地方去了"

#. ID 117, Page 2, Line 5, Pos (24,27)
msgid ""
"＊副ギルド長も行方不明に……\n"
"　一体どうなることやら……"
msgstr ""
"＊公会副会长也下落不明了……\n"
"　究竟会变成什么样呢……"

#. ID 119, Page 1, Line 4, Pos (14,25)
msgid "お疲れ様じゃったな"
msgstr "辛苦你了啊"

#. ID 119, Page 1, Line 9, Pos (14,25)
msgid ""
"そこに転送用の魔方陣を用意したからの……\n"
"お気をつけてな"
msgstr "那里已经准备好了传送用的魔法阵……路上小心啊"
