#. ID 3, Page 1, Line 3, Pos (5,4)
msgid ""
"\n"
"『有料トイレ　100G』\n"
msgstr "『收费厕所　100G』"

#. ID 3, Page 1, Line 6, Pos (5,4)
#. Contains choice at line 2 (2 options)
msgid "このトイレを使いますか?"
msgstr "要使用这个厕所吗？"

#. ID 3, Page 1, Line 7, Pos (5,4)
#. Choice (2 options, embedded in a message)
#. ID 5, Page 10, Line 10, Pos (26,17)
#. Choice (2 options, embedded in a message)
#. ID 16, Page 1, Line 3, Pos (4,4)
#. Choice (2 options, embedded in a message)
#. ID 23, Page 1, Line 14, Pos (21,15)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 3, Page 1, Line 28, Pos (5,4)
msgid ""
"\n"
"お金が足りない。\n"
msgstr "金钱不足。"

#. ID 4, Page 1, Line 3, Pos (24,23)
msgid ""
"\n"
"ここ、混浴なのがね…"
msgstr "这里，是混浴这点真是……"

#. ID 4, Page 2, Line 3, Pos (24,23)
msgid ""
"\n"
"髪が変な色に染まっちゃったわ。\n"
"このお湯何が入っているのかしら?"
msgstr ""
"头发被染成奇怪的颜色了。\n"
"这热水里到底加了什么啊？"

#. ID 5, Page 1, Line 4, Pos (26,17)
msgid ""
"\n"
"だ・か・ら・\n"
"掃・除・中なの!はいらないで！"
msgstr "所・以・说・正・在・清・扫・中!不要进来！"

#. ID 5, Page 2, Line 4, Pos (26,17)
#. ID 5, Page 10, Line 4, Pos (26,17)
msgid ""
"\n"
"いらっしゃい。\n"
"ここはお風呂です。"
msgstr "欢迎光临。这里是浴室。"

#. ID 5, Page 2, Line 10, Pos (26,17)
msgid ""
"\n"
"でも。\n"
"風呂掃除中だから入れないよ。"
msgstr "但是。正在打扫浴室所以不能进哦。"

#. ID 5, Page 2, Line 17, Pos (26,17)
msgid ""
"\n"
"あぁ。たいくつ。\n"
"根っこが生えそうだわ。"
msgstr "啊。好无聊。感觉要长根了。"

#. ID 5, Page 2, Line 23, Pos (26,17)
msgid ""
"\n"
"夜に来てね。\n"
"脱衣を手伝っちゃうよ。"
msgstr "晚上再来哦。我会帮你脱衣服的。"

#. ID 5, Page 3, Line 7, Pos (26,17)
msgid ""
"\n"
"それじゃ\n"
"脱ぐのをお手伝いしますね。"
msgstr "那么我来帮您脱衣服吧。"

#. ID 5, Page 3, Line 19, Pos (26,17)
msgid ""
"\n"
"ん？あんたこっちの服が本体なのか。\n"
"じゃぁ、外さないでおくわ。"
msgstr "嗯？你的衣服才是本体吗。那我就，不脱下来了。"

#. ID 5, Page 3, Line 52, Pos (26,17)
msgid ""
"\n"
"うわ、その触手貴女から生えてるの？"
msgstr "哇，那些触手是从你身上长出来的吗？"

#. ID 5, Page 3, Line 61, Pos (26,17)
msgid ""
"\n"
"おもしろーい、感覚もあるんだ。\n"
"切る訳にもいかないからそのままね。"
msgstr "好有趣，还有感觉呢。也不能切掉那就这样吧。"

#. ID 5, Page 3, Line 73, Pos (26,17)
msgid ""
"\n"
"うわー、両腕忘れてきちゃった？"
msgstr "哇～，忘记带双臂来了？"

#. ID 5, Page 3, Line 96, Pos (26,17)
msgid ""
"\n"
"これまた硬そうな殻だねー。\n"
"貴女の身体に食い込んで離れないや。"
msgstr ""
"这壳看起来也很硬呢～。\n"
"紧紧嵌在你身体里不肯离开呢。"

#. ID 5, Page 3, Line 121, Pos (26,17)
msgid ""
"\n"
"ん？これラバースーツじゃないの？\n"
"変な肌してるわねー。"
msgstr "嗯？这不是橡胶衣吗？皮肤好奇怪呢～。"

#. ID 5, Page 3, Line 134, Pos (26,17)
#. ID 5, Page 3, Line 146, Pos (26,17)
msgid ""
"\n"
"ん？このラバースーツ脱ぐとこないじゃん。\n"
"\\!っていうか、どうやって着たのよ…"
msgstr ""
"嗯？这件橡胶衣没有可以脱的地方嘛。\\!话说，\n"
"你是怎么穿上去的啊…"

#. ID 5, Page 3, Line 157, Pos (26,17)
msgid ""
"\n"
"うー、この金具固すぎて降りない…"
msgstr "呜～，这金属件太硬了降不下来…"

#. ID 5, Page 3, Line 169, Pos (26,17)
msgid ""
"\n"
"貴女の身体、その蟲が動かしてるのね。\n"
"勝手に身体動かされるのってどんな感じ？"
msgstr ""
"你的身体，是那只虫在操控呢。\n"
"身体被随意操控是什么感觉？"

#. ID 5, Page 3, Line 175, Pos (26,17)
msgid ""
"\n"
"うー、この蟲剥がれない…"
msgstr "呜～，这只虫剥不下来…"

#. ID 5, Page 3, Line 200, Pos (26,17)
#. ID 5, Page 3, Line 229, Pos (26,17)
#. ID 5, Page 3, Line 307, Pos (26,17)
msgid ""
"\n"
"ありゃ？"
msgstr "哎呀？"

#. ID 5, Page 3, Line 215, Pos (26,17)
#. ID 5, Page 3, Line 322, Pos (26,17)
msgid ""
"\n"
"貴女の首輪、鍵穴がつぶれてるじゃん。\n"
"外れるわけないよ。こんなの。"
msgstr ""
"你的项圈，锁孔都压坏了嘛。\n"
"这种东西不可能摘下来的。"

#. ID 5, Page 3, Line 244, Pos (26,17)
msgid ""
"\n"
"貴女の首輪、鍵穴がないじゃん。\n"
"外れるわけないよ。こんなの。"
msgstr ""
"你的项圈，根本没有锁孔嘛。\n"
"这种东西不可能摘下来的。"

#. ID 5, Page 3, Line 259, Pos (26,17)
msgid ""
"\n"
"うわ、改めて見るとすごいわね。\n"
"お尻からほんとに触手が生えてる。"
msgstr "哇，重新一看真厉害呢。屁股上真的长出触手了。"

#. ID 5, Page 3, Line 265, Pos (26,17)
msgid ""
"\n"
"お尻にこんな大きいのくっついてちゃ、\n"
"私じゃどうにもできないよ。"
msgstr "屁股上粘着这么大的东西，我可没办法啊。"

#. ID 5, Page 3, Line 291, Pos (26,17)
msgid ""
"\n"
"頭の中まで犯されてるのね。"
msgstr "连脑袋里都被侵犯了呢。"

#. ID 5, Page 3, Line 293, Pos (26,17)
msgid ""
"\n"
"もう自分が何されてるかも\n"
"分かんないんだろうなあ。"
msgstr "大概已经不知道自己在被做什么了吧。"

#. ID 5, Page 3, Line 342, Pos (26,17)
msgid ""
"\n"
"別に取って食いやしないわよ。\n"
"大げさねぇ。"
msgstr "又不会吃了你啦。真夸张呢。"

#. ID 5, Page 4, Line 7, Pos (26,17)
msgid ""
"\n"
"この子がお待ちかねだよ。\n"
"またギッチギチに縛ってもらおうね。"
msgstr "这孩子等不及了哦。再让人把你紧紧地绑起来吧。"

#. ID 5, Page 4, Line 17, Pos (26,17)
#. ID 5, Page 5, Line 49, Pos (26,17)
#. ID 5, Page 6, Line 8, Pos (26,17)
#. ID 5, Page 6, Line 29, Pos (26,17)
#. ID 5, Page 6, Line 36, Pos (26,17)
#. ID 5, Page 7, Line 45, Pos (26,17)
#. ID 5, Page 8, Line 59, Pos (26,17)
msgid ""
"\n"
"たしか。預かったものはない…はず。"
msgstr "确实。寄存的东西没有……应该。"

#. ID 5, Page 4, Line 24, Pos (26,17)
msgid ""
"\n"
"えーとこれかな?"
msgstr "呃——是这个吗？"

#. ID 5, Page 5, Line 7, Pos (26,17)
msgid ""
"\n"
"むー。預かり物は…\n"
"たしかこの奴隷の鎖ね"
msgstr "唔——。寄存的东西是……确实是这条奴隶锁链呢。"

#. ID 5, Page 5, Line 17, Pos (26,17)
msgid ""
"\n"
"自分から両手を差し出すなんて…\n"
"お風呂の時も物足りなかったんじゃない？"
msgstr "竟然自己伸出双手……洗澡的时候也没满足吧？"

#. ID 5, Page 5, Line 21, Pos (26,17)
msgid ""
"\n"
"それじゃあ…えいっ！"
msgstr "那么……嘿！"

#. ID 5, Page 5, Line 30, Pos (26,17)
msgid ""
"\n"
"へー、\\n[\\v[6]]ちゃんって言うんだ。\n"
"名札元に戻してあげるね。ワンちゃん♪"
msgstr ""
"嘿——，原来你叫\\n[\\v[6]]酱啊。\n"
"我把名牌给你放回原处哦。小狗♪"

#. ID 5, Page 5, Line 39, Pos (26,17)
msgid ""
"\n"
"うわー、実験動物？エグいわねー。\n"
"まあ、貴女は分かんないだろうけどね。"
msgstr ""
"哇——，实验动物？真过分呢——。不过嘛，\n"
"你大概不会懂吧。"

#. ID 5, Page 5, Line 56, Pos (26,17)
msgid ""
"\n"
"確かこれだったわ。"
msgstr "确实是这个呢。"

#. ID 5, Page 6, Line 16, Pos (26,17)
msgid ""
"\n"
"うわー。服の中にうねうねがいっぱい。\n"
"貴女に吸い付きたくてたまらないみたいね。"
msgstr ""
"哇——。衣服里面好多蠕动的东西。\n"
"好像迫不及待地想吸附在你身上呢。"

#. ID 5, Page 6, Line 20, Pos (26,17)
msgid ""
"\n"
"それじゃ、また着せてあげる。"
msgstr "那么，再给你穿上吧。"

#. ID 5, Page 6, Line 46, Pos (26,17)
msgid ""
"\n"
"何も着てこないなんて…\n"
"そんなにお風呂に入りたかったの？"
msgstr "居然什么都没穿来……就那么想洗澡吗？"

#. ID 5, Page 6, Line 50, Pos (26,17)
msgid ""
"\n"
"それとも…うふふ\\c[9]$k\\c[0]"
msgstr "还是说……呵呵\\c[9]$k\\c[0]"

#. ID 5, Page 6, Line 57, Pos (26,17)
msgid ""
"\n"
"そうそうこれこれ。"
msgstr "对对，这个这个。"

#. ID 5, Page 7, Line 7, Pos (26,17)
msgid ""
"\n"
"ふふ。いい顔ね。\n"
"首輪をしてから大変な目にあったのかな？"
msgstr "呵呵。表情不错呢。戴上项圈之后吃了不少苦头吧？"

#. ID 5, Page 7, Line 11, Pos (26,17)
#. ID 5, Page 8, Line 49, Pos (26,17)
msgid ""
"\n"
"でも。ご愁傷様。\n"
"ちゃんと元通りにしてあげちゃうからね\\c[9]$k\\c[0]"
msgstr ""
"不过。真可怜。\n"
"我会好好给你恢复原样的哦\\c[9]$k\\c[0]"

#. ID 5, Page 7, Line 21, Pos (26,17)
msgid ""
"\n"
"さて。また犬になる覚悟は出来た？"
msgstr "那么。做好再次变成狗的准备了吗？"

#. ID 5, Page 7, Line 23, Pos (26,17)
msgid ""
"\n"
"じゃ、嵌めてあげるね\\c[9]$k\\c[0]"
msgstr "那么，我给你戴上哦\\c[9]$k\\c[0]"

#. ID 5, Page 7, Line 32, Pos (26,17)
msgid ""
"\n"
"あらー。何とも素敵な顔。\n"
"この首輪そんなに待ち遠しかったの?"
msgstr ""
"哎呀——。多么美妙的表情。\n"
"这个项圈就那么让你期待吗？"

#. ID 5, Page 7, Line 36, Pos (26,17)
msgid ""
"\n"
"じゃ、また嵌めてあげるね\\c[9]$k\\c[0]"
msgstr "那么，我再给你戴上哦\\c[9]$k\\c[0]"

#. ID 5, Page 7, Line 52, Pos (26,17)
msgid ""
"\n"
"たぶんこれね。"
msgstr "大概就是这个吧。"

#. ID 5, Page 8, Line 6, Pos (26,17)
msgid ""
"\n"
"さて。口を大きく開けてね。"
msgstr "那么。把嘴张大哦。"

#. ID 5, Page 8, Line 15, Pos (26,17)
msgid ""
"\n"
"それじゃあ、こっちにお尻向けて。\n"
"しっかり力抜いてね。"
msgstr "那么，把屁股朝向这边。好好放松哦。"

#. ID 5, Page 8, Line 25, Pos (26,17)
msgid ""
"\n"
"じゃあ、足出して。"
msgstr "那么，把脚伸出来。"

#. ID 5, Page 8, Line 34, Pos (26,17)
msgid ""
"\n"
"さあ、スライムちゃん。\n"
"ご主人様が帰ってきたよ。"
msgstr "来吧，史莱姆酱。主人回来了哦。"

#. ID 5, Page 8, Line 45, Pos (26,17)
msgid ""
"\n"
"ふふ。いい顔ね。\n"
"ボンデージを着てから大変な目にあったのかな？"
msgstr ""
"呵呵。表情不错呢。\n"
"穿上束缚装之后吃了不少苦头吧？"

#. ID 5, Page 8, Line 66, Pos (26,17)
msgid ""
"\n"
"うん。これで間違いない。"
msgstr "嗯。这样就没错了。"

#. ID 5, Page 9, Line 8, Pos (26,17)
msgid ""
"\n"
"待ったー。\n"
"預かった装備をお着せしますね。"
msgstr "等等——。我来给您穿上寄存的装备哦。"

#. ID 5, Page 9, Line 121, Pos (26,17)
msgid ""
"\n"
"はーい。これで元通り。\n"
"よかったね。"
msgstr "好——。这样恢复原样了。太好了呢。"

#. ID 5, Page 10, Line 7, Pos (26,17)
#. Choice (3 options)
msgid ""
"お風呂に入りたい\n"
"ここは？\n"
"あなたは？"
msgstr ""
"想洗澡\n"
"这里是？\n"
"你是？"

#. ID 5, Page 10, Line 9, Pos (26,17)
#. Contains choice at line 2 (2 options)
msgid "お風呂はいる?"
msgstr "要洗澡吗？"

#. ID 5, Page 10, Line 15, Pos (26,17)
msgid ""
"\n"
"うーん、機械は駄目じゃない？"
msgstr "嗯——，机械不行吧？"

#. ID 5, Page 10, Line 24, Pos (26,17)
msgid ""
"\n"
"じゃあ、まず\n"
"そのゴッツイのから降りて…"
msgstr "那么，先从那笨重的东西上下来……"

#. ID 5, Page 10, Line 28, Pos (26,17)
msgid ""
"\n"
"え？降りられない？\n"
"…さすがにそのままはねー…"
msgstr "诶？下不来？……总不能就这样吧……"

#. ID 5, Page 10, Line 36, Pos (26,17)
msgid ""
"\n"
"それじゃ\n"
"どうぞどうぞ。お風呂は無料よ!"
msgstr "那就请进请进。洗澡免费哦！"

#. ID 5, Page 10, Line 47, Pos (26,17)
msgid ""
"\n"
"はいはい。そこでストップ。"
msgstr "好了好了。就在那里停下。"

#. ID 5, Page 10, Line 59, Pos (26,17)
msgid ""
"\n"
"はいはい。そこでちょっと待ってね。"
msgstr "好了好了。在那里稍等一下哦。"

#. ID 5, Page 10, Line 71, Pos (26,17)
msgid ""
"\n"
"冷やかしはお断り!\n"
"しっ　しっ　"
msgstr "谢绝捣乱！去　去"

#. ID 5, Page 10, Line 80, Pos (26,17)
msgid ""
"\n"
"いわゆる銭湯。お風呂屋です。"
msgstr "所谓的钱汤。是澡堂。"

#. ID 5, Page 10, Line 83, Pos (26,17)
msgid ""
"\n"
"水質改善の結果。\n"
"何と肌に触れても大丈夫になりました！"
msgstr "水质改善的结果。竟然变得碰到皮肤也没问题了！"

#. ID 5, Page 10, Line 86, Pos (26,17)
msgid ""
"\n"
"植物の力ってすごいでしょ！"
msgstr "植物的力量很厉害吧！"

#. ID 5, Page 10, Line 89, Pos (26,17)
msgid ""
"\n"
"……まぁ、飲んだら命の保証ないけどね。"
msgstr "……不过嘛，喝了可不保证性命哦。"

#. ID 5, Page 10, Line 95, Pos (26,17)
msgid ""
"\n"
"私は、大地に咲く一輪の花!!\n"
"\\S[8]………\\S[1]なぁんてね。"
msgstr ""
"我是开在大地上的一朵花!!\\S[8]………\n"
"\\S[1]开个玩笑啦。"

#. ID 5, Page 10, Line 99, Pos (26,17)
msgid ""
"\n"
"悪気のあるモンスターじゃないよ！"
msgstr "不是有恶意的怪物哦！"

#. ID 10, Page 1, Line 3, Pos (33,10)
msgid ""
"\n"
"畜生、混浴なのによぉ\n"
msgstr "畜生，明明是混浴啊。"

#. ID 10, Page 1, Line 6, Pos (33,10)
msgid ""
"\n"
"…待ちすぎてのぼせたぜ……\n"
msgstr "……等太久泡晕了……"

#. ID 11, Page 1, Line 4, Pos (10,8)
msgid ""
"\n"
"はぁ…、はぁ……\n"
msgstr "哈啊……、哈啊……"

#. ID 11, Page 1, Line 16, Pos (10,8)
msgid ""
"\n"
"あっ…、あっ…ダメ……\n"
msgstr "啊……、啊……不行……"

#. ID 12, Page 1, Line 4, Pos (9,8)
msgid ""
"\n"
"お。お前もよくみるとなかなか可愛い奴隷なんだな。"
msgstr "哦。你仔细看也是个相当可爱的奴隶嘛。"

#. ID 12, Page 1, Line 6, Pos (9,8)
msgid ""
"\n"
"可愛がってやるんだな。"
msgstr "会好好疼爱你的哦。"

#. ID 12, Page 1, Line 27, Pos (9,8)
msgid ""
"\n"
"ゲヘヘ…\n"
"オイラの嫁にぴったりのピアスを着けたんだな"
msgstr "嘿嘿嘿……戴上了正适合俺老婆的环嘛。"

#. ID 12, Page 1, Line 30, Pos (9,8)
msgid ""
"\n"
"ほら、いつまでもそれじゃ辛そうなんだな\n"
"いつものようにおねだりするんだな。"
msgstr ""
"看吧，一直那样好像很难受吧，\n"
"就像平时一样撒娇求我吧。"

#. ID 12, Page 2, Line 3, Pos (9,8)
msgid ""
"\n"
"嫁が元気になりすぎたんだな。\n"
"オイラが持たないからちょっと発散させてるんだな"
msgstr ""
"老婆变得太有精神了。俺受不了，\n"
"所以让她稍微发泄一下。"

#. ID 12, Page 2, Line 7, Pos (9,8)
#. ID 18, Page 1, Line 112, Pos (11,8)
msgid ""
"\n"
"……"
msgstr ""
"\n"
"……"

#. ID 12, Page 2, Line 9, Pos (9,8)
msgid ""
"\n"
"可愛い奴隷だけど浮気になるからダメなんだな。\n"
"残念なんだな。"
msgstr ""
"虽然是可爱的奴隶，但会变成出轨所以不行啊。\n"
"真遗憾啊。"

#. ID 13, Page 1, Line 3, Pos (5,15)
msgid ""
"\n"
"このお湯本当に飲めないのかしらね…。"
msgstr "这热水真的不能喝吗……。"

#. ID 15, Page 1, Line 3, Pos (14,9)
msgid ""
"\n"
"うぉぉぉぉぉぉおおおおおおおおおお！！！！！！\n"
msgstr ""
"呜哦哦哦哦哦哦哦哦哦哦哦哦哦哦哦！！！！！！！\n"
"！！"

#. ID 15, Page 1, Line 6, Pos (14,9)
msgid ""
"\n"
"見えるっ！！見えるぞ！！丸見えでござるっ！！！\n"
msgstr "看得见！！看得见！！完全看得一清二楚是也！！！"

#. ID 15, Page 2, Line 3, Pos (14,9)
msgid ""
"\n"
"のぉぉぉぉぉぉおおおおおおおおおお！！！！！！\n"
msgstr "唔哦哦哦哦哦哦哦哦哦哦哦！！！！！！！！！"

#. ID 15, Page 2, Line 6, Pos (14,9)
msgid ""
"\n"
"見たくもないものが付いているでござるっ！！！\n"
msgstr "长着不想看的东西是也！！！"

#. ID 16, Page 1, Line 2, Pos (4,4)
#. Contains choice at line 2 (2 options)
msgid "＊用を足しますか？"
msgstr "＊要排泄吗？"

#. ID 16, Page 1, Line 25, Pos (4,4)
msgid ""
"\\n[\\v[6]] \n"
"「ふぅ…………」"
msgstr "\\n[\\v[6]] 「呼…………」"

#. ID 16, Page 1, Line 29, Pos (4,4)
msgid ""
"\\n[\\v[6]] \n"
"「くっ……うぅ……」"
msgstr "\\n[\\v[6]] 「唔……呜呜……」"

#. ID 16, Page 1, Line 33, Pos (4,4)
msgid ""
"纏っているラバースーツが\n"
"全て吸収してしまったようだ……"
msgstr "穿在身上的橡胶衣似乎已经把它全部吸收了……"

#. ID 16, Page 1, Line 40, Pos (4,4)
msgid ""
"異様な格好のままでしか排泄ができない自分に、\n"
"\\n[\\v[6]]は酷くみじめな気分になった……"
msgstr ""
"只能以这种怪异打扮排泄的自己，\n"
"\\n[\\v[6]]感到非常悲惨……"

#. ID 16, Page 1, Line 57, Pos (4,4)
msgid ""
"\\n[\\v[6]]は股に食い込んでいる貞操帯に\n"
"アタッチメントを取り付けた"
msgstr "\\n[\\v[6]]在嵌进胯下的贞操带上安装了附件"

#. ID 16, Page 1, Line 66, Pos (4,4)
msgid ""
"貞操帯に塞がれていて、\n"
"出す物が出せない！"
msgstr "被贞操带堵着，想排的东西排不出来！"

#. ID 16, Page 1, Line 88, Pos (4,4)
msgid ""
"モノは出ているのに\n"
"排泄感がまったくない……"
msgstr "东西明明出来了，却完全没有排泄感……"

#. ID 16, Page 1, Line 94, Pos (4,4)
msgid ""
"自分の大事なところが機械のようにされて\n"
"\\n[\\v[6]]はみじめな気分になった……"
msgstr ""
"自己的重要部位被弄得像机械一样，\n"
"\\n[\\v[6]]感到十分悲惨……"

#. ID 16, Page 1, Line 101, Pos (4,4)
msgid "＊排出完了確認。自動閉鎖します…"
msgstr "＊确认排出完成。自动关闭……"

#. ID 16, Page 1, Line 111, Pos (4,4)
msgid "……"
msgstr "……"

#. ID 16, Page 1, Line 112, Pos (4,4)
msgid "ものすごく臭い……"
msgstr "非常臭……"

#. ID 16, Page 1, Line 113, Pos (4,4)
msgid ""
"悪臭の元を辿ってみると、貞操帯の\n"
"アタッチメントから臭っているようだ……"
msgstr ""
"循着恶臭的来源找去，\n"
"似乎是从贞操带的附件散发出来的……"

#. ID 16, Page 1, Line 115, Pos (4,4)
msgid ""
"悪臭がきつくてこれ以上持っていられず、\n"
"\\n[\\v[6]]は泣く泣く捨てることにした……"
msgstr ""
"恶臭太强烈了，再也拿不住了，\n"
"\\n[\\v[6]]只好哭着丢弃了……"

#. ID 16, Page 1, Line 127, Pos (4,4)
msgid ""
"\\S \\n[\\v[6]] \n"
"　「ふぅ…………」\\^"
msgstr "\\S \\n[\\v[6]] 　「呼…………」\\^"

#. ID 16, Page 1, Line 133, Pos (4,4)
msgid "＊まだ我慢できる……かな？"
msgstr "＊还能忍耐……吧？"

#. ID 16, Page 1, Line 141, Pos (4,4)
msgid ""
"・・・？\n"
"トイレって・・・\n"
"どう使うんだったっけ・・・？"
msgstr "……？厕所……该怎么用来着……？"

#. ID 16, Page 1, Line 149, Pos (4,4)
msgid ""
"○リーパー\n"
"　おまえはトイレの使い方が分からなくなるんだな…\n"
"　おまえはおもらしすることが大好きだから、\n"
"　それは当り前の事なんだな…"
msgstr ""
"○收割者　你变得不懂厕所的使用方法了呢……\n"
"　因为你非常喜欢尿裤子，\n"
"　所以这是理所当然的事呢……"

#. ID 16, Page 1, Line 158, Pos (4,4)
msgid ""
"・・・わたしはといれのつかいかたが・・・\n"
"・・・まったく・・・わからない・・・"
msgstr ""
"・・・我不知道厕所的使用方法・・・・・・完全・\n"
"・・不知道・・・"

#. ID 16, Page 1, Line 165, Pos (4,4)
msgid ""
"・・・？私は一体何を考えていたのだろうか？\n"
"私がトイレの使い方が分からないのは\n"
"当り前の事だというのに・・・。"
msgstr ""
"……？我到底在想什么？\n"
"明明我不知道厕所的使用方法是理所当然的事……。"

#. ID 16, Page 1, Line 173, Pos (4,4)
msgid ""
"・・・そもそも、トイレなんて何の為にある\n"
"のだろうか？\n"
"みんなもおもらしすればいいのに・・・。"
msgstr ""
"……说起来，厕所到底是为了什么而存在的呢？\n"
"大家也都尿裤子就好了……。"

#. ID 16, Page 1, Line 176, Pos (4,4)
msgid ""
"\\N[\\V[6]]はそう考えると、ぶるりと身を震わせ、\n"
"盛大におもらしをした・・・。"
msgstr ""
"\\N[\\V[6]]这样想着，猛地打了个寒颤，\n"
"然后大肆尿了裤子……。"

#. ID 16, Page 2, Line 8, Pos (4,4)
msgid ""
"\n"
"\\n[\\v[6]]は\n"
"このトイレを使うのに必要なモノがない!"
msgstr "\\n[\\v[6]]没有使用这个厕所所必需的东西!"

#. ID 17, Page 1, Line 3, Pos (32,19)
msgid ""
"\n"
"お風呂上がりに1ついかが？"
msgstr "泡完澡后来一个怎么样？"

#. ID 18, Page 1, Line 4, Pos (11,8)
msgid ""
"\n"
"鏡には\\n[\\v[6]]の顔が映っている。"
msgstr "镜子里映着\\n[\\v[6]]的脸。"

#. ID 18, Page 1, Line 6, Pos (11,8)
msgid ""
"\n"
"………？"
msgstr ""
"\n"
"………？"

#. ID 18, Page 1, Line 8, Pos (11,8)
msgid ""
"\n"
"\\n[\\v[6]]は\n"
"何か違和感を覚えて首に手を触れた。"
msgstr "\\n[\\v[6]]感到某种违和感，把手放到了脖子上。"

#. ID 18, Page 1, Line 11, Pos (11,8)
msgid ""
"\n"
"首を彩っていたあの首輪が今はない。\n"
msgstr "曾经装点脖颈的那个项圈现在不在了。"

#. ID 18, Page 1, Line 14, Pos (11,8)
msgid ""
"\n"
"あの息苦しさも、好奇の視線も今は感じることはない。\n"
"\\n[\\v[6]]は安堵のため息をついた。"
msgstr ""
"那种窒息感，还有好奇的视线，现在都感觉不到了。\n"
"\\n[\\v[6]]松了一口气。"

#. ID 18, Page 1, Line 17, Pos (11,8)
msgid ""
"\n"
"………"
msgstr ""
"\n"
"………"

#. ID 18, Page 1, Line 19, Pos (11,8)
msgid ""
"\n"
"……なのに…この違和感は何なのだろう…？"
msgstr "……明明如此……这种违和感到底是什么呢……？"

#. ID 18, Page 1, Line 25, Pos (11,8)
msgid ""
"\n"
"いつも首を絞めつけていたあの首輪が今はない。\n"
msgstr "总是勒紧脖子的那个项圈现在不在了。"

#. ID 18, Page 1, Line 28, Pos (11,8)
msgid ""
"\n"
"\\n[\\v[6]]は\n"
"首だけでなく心まで軽くなった気がした。"
msgstr "\\n[\\v[6]]觉得不只是脖子，连心都变轻了。"

#. ID 18, Page 1, Line 36, Pos (11,8)
msgid ""
"\n"
"鍵穴がない頑丈な首輪は\n"
"今も変わらず首を締め付けている…"
msgstr "没有锁孔的坚固项圈如今依然不变地勒紧着脖子……"

#. ID 18, Page 1, Line 39, Pos (11,8)
#. ID 18, Page 1, Line 47, Pos (11,8)
msgid ""
"\n"
"絶対に外せない。その現実を思い知り、\n"
"\\n[\\v[6]]は鏡から目を背けた。"
msgstr ""
"绝对摘不下来。认识到这个现实后，\n"
"\\n[\\v[6]]把目光从镜子上移开了。"

#. ID 18, Page 1, Line 44, Pos (11,8)
msgid ""
"\n"
"鍵穴を潰された奴隷の首輪は\n"
"今も変わらず首を締め付けている"
msgstr "锁孔被毁掉的奴隶项圈如今依然不变地勒紧着脖子"

#. ID 18, Page 1, Line 56, Pos (11,8)
msgid ""
"\n"
"\\n[\\v[6]]の身体を隙間なく覆うラバーは\n"
"風呂の熱気がこもり、蒸れた感覚を伝えてくる。"
msgstr ""
"\\n[\\v[6]]的身体被橡胶毫无缝隙地覆盖着，\n"
"浴室的热气闷在里面，传来潮湿闷热的感觉。"

#. ID 18, Page 1, Line 60, Pos (11,8)
msgid ""
"\n"
"ラバーの感覚の虜となった\\n[\\v[6]]でも、\n"
"耐えがたい熱気に不快感を隠すことはできなかった。"
msgstr ""
"即使成为了橡胶触感的俘虏，\n"
"\\n[\\v[6]]也无法掩饰对难以忍受的热气的不快。"

#. ID 18, Page 1, Line 65, Pos (11,8)
msgid ""
"\n"
"鏡には風呂場でもラバースーツを着たままの\n"
"\\n[\\v[6]]の姿が映っている。"
msgstr ""
"镜子里映着即使在浴室里也仍穿着橡胶套装的\\n[\\v[6]]的\n"
"　身影。"

#. ID 18, Page 1, Line 68, Pos (11,8)
msgid ""
"\n"
"しかし\\n[\\v[6]]は黒々とした肢体や\n"
"圧力と熱にまみれた不快感に\n"
"顔をしかめることしかできなかった…"
msgstr ""
"然而\\n[\\v[6]]只能对黑黝黝的肢体以及充满压力与\n"
"热量的不快皱起眉头……"

#. ID 18, Page 1, Line 78, Pos (11,8)
msgid ""
"\n"
"\\n[\\v[6]]の皮膚と化したラバーは\n"
"風呂の熱気がこもり、蒸れた感覚を伝えてくる。"
msgstr ""
"\\n[\\v[6]]的皮肤化成的橡胶闷着浴室的热气，\n"
"传来潮湿闷热的感觉。"

#. ID 18, Page 1, Line 82, Pos (11,8)
msgid ""
"\n"
"しかし、すっかり\n"
"ラバーの感覚の虜となった\\n[\\v[6]]には\n"
"それすらも心地よかった。"
msgstr ""
"但是，\n"
"对于完全成为橡胶触感俘虏的\\n[\\v[6]]来说，\n"
"就连这也觉得很舒服。"

#. ID 18, Page 1, Line 88, Pos (11,8)
msgid ""
"\n"
"鏡に映る自分自身の黒い「身体」\n"
"\\|光沢を放ち、ボディラインを強調された肢体"
msgstr ""
"镜中映出的自己的黑色「身体」\\|散发着光泽、\n"
"强调身体线条的肢体"

#. ID 18, Page 1, Line 91, Pos (11,8)
msgid ""
"\n"
"\\n[\\v[6]]はラバーで染められた、\n"
"自らの「裸身」から思わず視線を外した。"
msgstr ""
"\\n[\\v[6]]不由得把目光从被橡胶染成的自己的\n"
"「裸身」上移开了。"

#. ID 18, Page 1, Line 94, Pos (11,8)
msgid ""
"\n"
"しかし、窮屈感と熱気は\\n[\\v[6]]の\n"
"ささやかな逃避すら許してくれなかった…"
msgstr ""
"但是，\n"
"拘束感和热气连\\n[\\v[6]]小小的逃避都不允许……"

#. ID 18, Page 1, Line 104, Pos (11,8)
msgid ""
"\n"
"いつもドオリにキれいナワタしがうつッテイル。"
msgstr "总是如出一辙地，漂亮的我映照在那里。"

#. ID 18, Page 1, Line 109, Pos (11,8)
msgid ""
"\n"
"鏡には触手が生えた自分が映っている。\n"
"こんなもの…"
msgstr "镜子里映着长出触手的自己。这种东西……"

#. ID 18, Page 1, Line 114, Pos (11,8)
msgid ""
"\n"
"何だか自分が綺麗になった気がした。"
msgstr "总觉得感觉自己变漂亮了。"

#. ID 18, Page 1, Line 119, Pos (11,8)
msgid ""
"\n"
"下腹部が蟲のようになった自分が映っている…"
msgstr "镜子里映着自己的下腹部变得像虫一样……"

#. ID 18, Page 1, Line 121, Pos (11,8)
msgid ""
"\n"
"気分が悪くなり、\n"
"\\n[\\v[6]]は鏡から目を背けた。"
msgstr "心情变差了，\\n[\\v[6]]把目光从镜子上移开了。"

#. ID 18, Page 1, Line 127, Pos (11,8)
msgid ""
"\n"
"鏡には蟲の殻に覆われた\n"
"\\n[\\v[6]]が映っている。"
msgstr "镜子里映着被虫壳覆盖的\\n[\\v[6]]。"

#. ID 18, Page 1, Line 132, Pos (11,8)
msgid ""
"\n"
"鏡には蟲が張り付いた\\n[\\v[6]]が映っている。"
msgstr "镜子里映着虫子贴附在身上的\\n[\\v[6]]。"

#. ID 18, Page 1, Line 145, Pos (11,8)
msgid ""
"\n"
"鏡には侵食蟲に乗っ取られ、\n"
"異様な姿をしている\n"
"\\n[\\v[6]]だったものが映っている。"
msgstr ""
"镜子里映着被侵蚀虫占据、呈现异样姿态的、\n"
"曾经是\\n[\\v[6]]的东西。"

#. ID 18, Page 1, Line 152, Pos (11,8)
msgid ""
"\n"
"鏡に裸の\\n[\\v[6]]が映っている。"
msgstr "镜子里映着赤裸的\\n[\\v[6]]。"

#. ID 23, Page 1, Line 3, Pos (21,15)
msgid ""
"\n"
"あなた冒険者？\n"
msgstr "你是冒险者？"

#. ID 23, Page 1, Line 6, Pos (21,15)
msgid ""
"\n"
"…遠いところからやってきたのね。\n"
msgstr "……是从很远的地方来的呢。"

#. ID 23, Page 1, Line 9, Pos (21,15)
msgid ""
"\n"
"疲れてるんじゃない？\n"
"ゆっくりお湯につかったら？"
msgstr "你是不是累了？要不要慢慢泡个热水澡？"

#. ID 23, Page 1, Line 22, Pos (21,15)
msgid ""
"\n"
"\\n[\\v[6]]は\n"
"湯船に身を浸した。"
msgstr "\\n[\\v[6]]把身体浸入了浴缸。"

#. ID 23, Page 1, Line 25, Pos (21,15)
msgid ""
"\n"
"旅の疲れに温かなお湯が心地よい。\n"
msgstr "温暖的热水舒服地缓解了旅途的疲劳。"

#. ID 24, Page 1, Line 3, Pos (8,24)
msgid ""
"\n"
"ぺたぺた\n"
msgstr "啪嗒啪嗒"

#. ID 24, Page 1, Line 6, Pos (8,24)
msgid ""
"\n"
"ここあしがひっつくの。\n"
"おもしろーい！"
msgstr "这里脚会粘在一起。好有趣！"

#. ID 28, Page 1, Line 3, Pos (5,19)
msgid ""
"\n"
"あ～。いい湯だぜ…"
msgstr "啊～。真是好澡啊……"

#. ID 28, Page 1, Line 5, Pos (5,19)
msgid ""
"\n"
"…………おまけに目も癒されるぜ\n"
msgstr "…………而且眼睛也得到了治愈。"

#. ID 28, Page 2, Line 3, Pos (5,19)
msgid ""
"\n"
"お…!?"
msgstr "哦……！？"

#. ID 28, Page 2, Line 5, Pos (5,19)
msgid ""
"\n"
"あんたのせいで俺のムスコが興奮してきちまったぜ。\n"
"責任とって静めてもらおうかい。"
msgstr ""
"都怪你，我的小弟弟兴奋起来了。\n"
"你负起责任让它冷静下来吧。"

#. ID 28, Page 2, Line 10, Pos (5,19)
msgid ""
"\n"
"歯を立てるんじゃねぇぞ。"
msgstr "别用牙咬啊。"

#. ID 28, Page 2, Line 17, Pos (5,19)
msgid ""
"\n"
"ふぅ。ちょっとは収まってきたな。\n"
"また、頼むぜぃ。"
msgstr "呼。稍微平静下来点了。下次再拜托你啦。"
