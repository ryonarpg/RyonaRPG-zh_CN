msgid "＊「これでも喰らえ、極悪人め！」\\^"
msgstr "＊「吃这个吧，极恶之徒！」\\^"

#. ID 163, Page 1, Line 1, Pos (2,8)
msgid "＊「伯爵様を殺そうだなんて酷い奴め！」\\^"
msgstr "＊「竟然想杀伯爵大人，真是过分的家伙！」\\^"

#. ID 164, Page 1, Line 1, Pos (3,8)
msgid "＊「お前みたいな売女は地獄へ落ちろー！」\\^"
msgstr "＊「像你这样的婊子就下地狱去吧——！」\\^"
