msgid "……行こう。"
msgstr "……走吧。"

#. ID 57, Page 4, Line 29, Pos (51,0)
msgid ""
"ランドレイの成体に気をつけて、\n"
"通り過ぎればいい。"
msgstr "小心兰德雷的成体，穿过去就好。"

#. ID 57, Page 5, Line 3, Pos (51,0)
#. ID 58, Page 6, Line 3, Pos (51,1)
