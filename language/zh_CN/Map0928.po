#. ID 16, Page 11, Line 58, Pos (5,0)
msgid ""
"\n"
"黒い魂が身体の芯へとへ入っていく…\\.\\.\\^"
msgstr "黑之魂正钻进身体的核心…\\.\\.\\^"

#. ID 16, Page 11, Line 127, Pos (5,0)
#. ID 16, Page 11, Line 151, Pos (5,0)
msgid ""
"\n"
"腕の力が抜けて、\n"
"\\n[101]\\n[102]を取り落としてしまった！"
msgstr "手臂脱力，\\n[101]\\n[102]失手掉落！"

#. ID 16, Page 11, Line 132, Pos (5,0)
#. ID 16, Page 11, Line 156, Pos (5,0)
msgid ""
"\n"
"手の力が抜けたが、\n"
"\\n[101]\\n[102]が外れることはなかった…"
msgstr "手部脱力，但\\n[101]\\n[102]并没有脱落……"

#. ID 16, Page 11, Line 139, Pos (5,0)
#. ID 16, Page 11, Line 163, Pos (5,0)
msgid ""
"\n"
"手の力が抜けたが、何も握っていなかった…"
msgstr "手部脱力，但什么也没握着……"

#. ID 16, Page 11, Line 175, Pos (5,0)
msgid ""
"気持ち悪さに耐えきれず\n"
"\\n[101]\\n[102]を\n"
"脱ぎ棄ててしまった!"
msgstr "因恶心难耐，\\n[101]\\n[102]被脱下丢掉了！"

#. ID 16, Page 11, Line 180, Pos (5,0)
msgid ""
"\n"
"\\n[101]\\n[102]に封じられた身体を\n"
"不快な感触が跳ねまわっていく…"
msgstr ""
"令人不适的触感在封印于\\n[101]\\n[102]的身体中四\n"
"处窜动……"

#. ID 16, Page 11, Line 187, Pos (5,0)
msgid ""
"\n"
"不快な感触が身体に纏わりつく感触に、\n"
"\\n[\\v[006]]は小さく震えた。"
msgstr ""
"因那令人不适的触感缠在身体上的感觉，\n"
"\\n[\\v[006]]轻轻颤抖了。"

#. ID 16, Page 11, Line 200, Pos (5,0)
msgid ""
"不快感に耐えきれず\n"
"\\n[101]\\n[102]を外してしまった!"
msgstr "因不适感难以忍受，\\n[101]\\n[102]被取下来了！"

#. ID 16, Page 11, Line 204, Pos (5,0)
#. ID 16, Page 11, Line 229, Pos (5,0)
msgid ""
"\n"
"\\n[101]\\n[102]を外したい衝動に駆られたが、\n"
"じっと我慢するしかなかった…"
msgstr ""
"虽然被想要取下\\n[101]\\n[102]的冲动驱使，\n"
"但也只能强忍着……"

#. ID 16, Page 11, Line 211, Pos (5,0)
#. ID 16, Page 11, Line 236, Pos (5,0)
msgid ""
"\n"
"不快感に思わず身体を弄ったが、\n"
"身につけているものはなかった…"
msgstr ""
"因不适感不由自主地摸了摸身上，\n"
"但身上什么也没戴……"

#. ID 16, Page 11, Line 224, Pos (5,0)
msgid ""
"\n"
"不快感に耐えきれず\n"
"\\n[101]\\n[102]を外してしまった!"
msgstr "因不适感难以忍受，\\n[101]\\n[102]被取下来了！"

#. ID 16, Page 11, Line 254, Pos (5,0)
msgid ""
"\n"
"…気がつくと\\n[\\v[006]]は\n"
"\\n[101]\\n[102]を身につけて立ち竦んでいた…"
msgstr ""
"…回过神来时，\n"
"\\n[\\v[006]]已经\\n[101]\\n[102]装备在身上，\n"
"呆立当场…"

#. ID 66, Page 3, Line 12, Pos (44,3)
msgid "空間の歪みに吸い込まれる！"
msgstr "被空间的扭曲吸进去了！"

#. ID 85, Page 2, Line 3, Pos (3,14)
#. ID 98, Page 2, Line 3, Pos (44,1)
msgid ""
"\n"
"おかしな宝箱がある。\n"
"存在感が妙に薄く、輪郭もはっきりしない。"
msgstr "有个奇怪的宝箱。存在感异常稀薄，轮廓也不清晰。"

#. ID 85, Page 2, Line 6, Pos (3,14)
#. Choice (2 options)
#. ID 98, Page 2, Line 6, Pos (44,1)
#. Choice (2 options)
msgid ""
"あけてみる\n"
"ここではやめとく"
msgstr ""
"打开看看\n"
"还是算了"

#. ID 85, Page 3, Line 3, Pos (3,14)
#. ID 98, Page 3, Line 3, Pos (44,1)
#. ID 98, Page 4, Line 3, Pos (44,1)
msgid ""
"\n"
"存在感の薄い空箱がある。\n"
"中身もからっぽだ。"
msgstr "有个存在感稀薄的空箱子。里面也空空如也。"

#. ID 95, Page 2, Line 3, Pos (26,27)
msgid ""
"？？？\n"
"\\s[10]「その鍵は…それなら…この鏡から…\n"
"　でも…危険…気を付けて…。"
msgstr ""
"？？？\\s[10]「那把钥匙…那样的话…从这面镜子…\n"
"　不过…危险…小心点…。"

#. ID 95, Page 2, Line 10, Pos (26,27)
msgid ""
"\\N[\\V[6]]\n"
"「誰かの声が聞こえた気がしたけど…\\|\n"
"　鍵ってこれのこと？"
msgstr ""
"\\N[\\V[6]]「好像听到了某人的声音…\n"
"\\|　你说的钥匙是这个吗？"

#. ID 95, Page 2, Line 13, Pos (26,27)
#. Contains choice at line 2 (2 options)
#. ID 95, Page 3, Line 4, Pos (26,27)
#. Contains choice at line 2 (2 options)
msgid "異界の鍵を鏡に挿してみますか？"
msgstr "要试着把异界之钥插进镜子里吗？"

#. ID 95, Page 2, Line 14, Pos (26,27)
#. Choice (2 options, embedded in a message)
#. ID 95, Page 3, Line 5, Pos (26,27)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 95, Page 2, Line 22, Pos (26,27)
msgid ""
"？？？\n"
"「ふむ、このお菓子はなかなか…\\|\\^"
msgstr "？？？「嗯，这点心相当不错…\\|\\^"

#. ID 95, Page 2, Line 25, Pos (26,27)
msgid ""
"？？？\n"
"「む？"
msgstr "？？？「嗯？"

#. ID 95, Page 2, Line 28, Pos (26,27)
msgid ""
"？？？\n"
"「お主何奴…？\\|どうやってこのわらわの\n"
" 食事風景を覗き見ている？"
msgstr "？？？「你是什么人…？\\|是怎么偷看吾用餐的？"

#. ID 95, Page 2, Line 36, Pos (26,27)
msgid ""
"？？？\n"
"「む、\\.その鍵は…\\|なるほど。\\!\n"
"　何やら訳ありのようじゃな。"
msgstr ""
"？？？「嗯，\\.那把钥匙是…\\|原来如此。\n"
"\\!　看来似乎有些隐情啊。"

#. ID 95, Page 2, Line 40, Pos (26,27)
msgid ""
"？？？\n"
"「ふむ、\\|用件はそこの鏡の童子か…。\\!"
msgstr "？？？「嗯，\\|你要找的是那边的镜中童子吗…。\\!"

#. ID 95, Page 2, Line 43, Pos (26,27)
msgid ""
"？？？\n"
"「しかしこれは中々骨が折れそうじゃな。\\!\n"
"　強力な封印術がかかっておるようじゃ。"
msgstr ""
"？？？「不过这事似乎相当棘手啊。\n"
"\\!　看来被施了很强的封印术。"

#. ID 95, Page 2, Line 47, Pos (26,27)
msgid ""
"？？？\n"
"「無論、わらわにかかればこの程度の\n"
"　封印術造作もなく破れるじゃろう。\\!\n"
"　しかしタダでとはいかぬぞ。"
msgstr ""
"？？？「当然，若由吾出手，\n"
"这种程度的封印术应该能轻而易举地破开。\n"
"　\\!　但可不能白干哦。"

#. ID 95, Page 2, Line 52, Pos (26,27)
msgid ""
"？？？\n"
"「そうじゃなぁ…"
msgstr "？？？「说得也是啊…"

#. ID 95, Page 2, Line 60, Pos (26,27)
msgid ""
"？？？\n"
"「ふむ、ソウルポット100分用意すれば\n"
"　考えてやらんでもないぞ？"
msgstr ""
"？？？「嗯，准备100份灵魂壶的话，\n"
"吾也不是不能考虑考虑哦？"

#. ID 95, Page 2, Line 65, Pos (26,27)
msgid ""
"\\N[\\V[6]]\n"
"「100って多すぎじゃ…"
msgstr "\\N[\\V[6]]「100也太多了吧…"

#. ID 95, Page 2, Line 70, Pos (26,27)
msgid ""
"？？？\n"
"「これでも譲歩しとるほうなのじゃぞ？\\|\n"
"　やれやれ最近のはがめついのぉ。"
msgstr ""
"？？？「这已经是吾让步后的条件了哦？\\|　唉，\n"
"最近的人可真贪心啊。"

#. ID 95, Page 2, Line 74, Pos (26,27)
msgid ""
"？？？\n"
"「しかしわらわも鬼ではない。\n"
"　カステラを持ってきたのなら、\n"
"　考え直してやろう！"
msgstr ""
"？？？「不过吾也不是魔鬼。\n"
"　若你带来了长崎蛋糕，　吾就重新考虑吧！"

#. ID 95, Page 2, Line 79, Pos (26,27)
msgid ""
"？？？\n"
"「よいな？\\|ソウルポット100分か、\n"
"　カステラをここに持ってくるのじゃ。\\!\n"
"　それで手を打つとしよう。"
msgstr ""
"？？？「听好了？\\|灵魂壶100份，\n"
"或者　把长崎蛋糕带到这里来。\\!　就以此成交吧。"

#. ID 95, Page 2, Line 89, Pos (26,27)
msgid ""
"？？？\n"
"「ところでその鍵…\\|よくない呪いが\n"
"　かかっているようじゃな。"
msgstr ""
"？？？「话说那把钥匙…\n"
"\\|似乎被施了不好的诅咒啊。"

#. ID 95, Page 2, Line 93, Pos (26,27)
msgid ""
"？？？\n"
"「無断持ち出しに対応した呪いのようじゃ\n"
"　が…なに、元の場所に戻せば解けること\n"
"　じゃろう。"
msgstr ""
"？？？「看起来是针对擅自带出的诅咒　不过…\n"
"没什么，放回原处应该就能解开吧。"

#. ID 95, Page 2, Line 98, Pos (26,27)
msgid ""
"？？？\n"
"「じゃあの小娘。"
msgstr "？？？「那么，告辞了小丫头。"

#. ID 95, Page 2, Line 113, Pos (26,27)
msgid ""
"？？？\n"
"\\s[10]「う、動けない…誰か…誰か助けて…"
msgstr "？？？\\s[10]「呜，动不了…谁…谁来救救我…"

#. ID 95, Page 2, Line 119, Pos (26,27)
msgid ""
"\\N[\\V[6]]\n"
"「誰かの声が聞こえた気がしたけど…"
msgstr "\\N[\\V[6]]「好像听到了某人的声音…"

#. ID 95, Page 3, Line 13, Pos (26,27)
msgid ""
"？？？\n"
"「む、\\.来たか。\\|\n"
"　では早速取引と行こうかのぉ。"
msgstr "？？？「嗯，\\.来了啊。\\|　那就赶紧来谈交易吧。"

#. ID 95, Page 3, Line 17, Pos (26,27)
msgid ""
"？？？\n"
"「ソウルポット100分か、カステラ。\n"
"　お主はどちらを選ぶのじゃ？"
msgstr ""
"？？？「灵魂壶100份，还是长崎蛋糕。\n"
"　你要选哪个？"

#. ID 95, Page 3, Line 22, Pos (26,27)
#. Choice (3 options)
msgid ""
"ソウルポット100分で手を打つ\n"
"カステラで手を打つ\n"
"考えさせてほしい"
msgstr ""
"以灵魂壶100份成交\n"
"以长崎蛋糕成交\n"
"让我考虑一下"

#. ID 95, Page 3, Line 37, Pos (26,27)
msgid ""
"？？？\n"
"「ソウルポットじゃな。\n"
"　さて、お主の持つ魂の数は…"
msgstr ""
"？？？「灵魂壶是吧。　那么，\n"
"你持有的灵魂数量是…"

#. ID 95, Page 3, Line 41, Pos (26,27)
msgid ""
"？？？\n"
"「全部で\\v[781]分じゃな。"
msgstr "？？？「总共\\v[781]份是吧。"

#. ID 95, Page 3, Line 45, Pos (26,27)
msgid ""
"？？？\n"
"「ほう、本当に100分魂を持ってくる\n"
"　とは…。\\!お主中々やるのぉ。"
msgstr ""
"？？？「哦？真的带来了100份灵魂　啊…。\n"
"\\!你还真有两下子啊。"

#. ID 95, Page 3, Line 49, Pos (26,27)
msgid ""
"？？？\n"
"「では約束通りソウルポットで手を打つと\n"
"　しようか。"
msgstr "？？？「那么，就如约以灵魂壶成交吧。"

#. ID 95, Page 3, Line 118, Pos (26,27)
msgid ""
"？？？\n"
"「む、魂に端数が出てしもうたか…。"
msgstr "？？？「嗯，灵魂的数目出现零头了啊…。"

#. ID 95, Page 3, Line 121, Pos (26,27)
msgid ""
"？？？\n"
"「仕方あるまい。\\|端数の魂は知り合いの\n"
"　悪魔に送ってやるとしよう！"
msgstr ""
"？？？「没办法。\n"
"\\|零头的灵魂就送给吾认识的　恶魔吧！"

#. ID 95, Page 3, Line 132, Pos (26,27)
msgid ""
"？？？\n"
"「なんじゃ。\\|数が足らぬではないか。\\!\n"
"　出直してくるがいい。"
msgstr ""
"？？？「什么啊。\\|数目不够不是吗。\n"
"\\!　改日再来吧。"

#. ID 95, Page 3, Line 143, Pos (26,27)
msgid ""
"？？？\n"
"「おおそうじゃこれじゃよこれ。\n"
"　どこで手に入れたか知らぬが、お主中々\n"
"　やるのぉ。"
msgstr ""
"？？？「哦哦没错就是这个。\n"
"　虽然不知你从哪弄到的，你还真有两下子啊。"

#. ID 95, Page 3, Line 153, Pos (26,27)
msgid ""
"？？？\n"
"「取引は成立じゃ。\\|ではこの封印を破ると\n"
"　しようか。\\!危ないから下がっとれ。"
msgstr ""
"？？？「交易成立了。\\|那么，\n"
"就来破掉这个封印吧。\\!危险，退后些。"

#. ID 95, Page 3, Line 165, Pos (26,27)
msgid ""
"？？？\n"
"「むぅっ！！！"
msgstr "？？？「唔！！！"

#. ID 95, Page 3, Line 185, Pos (26,27)
msgid ""
"？？？\n"
"「契約は成された。\n"
"　あとはお主が何とかするのじゃぞ。"
msgstr ""
"？？？「契约已成立。\n"
"　接下来就靠你自己想办法了。"

#. ID 95, Page 3, Line 189, Pos (26,27)
msgid ""
"？？？\n"
"「縁があればまた会うかもしれんの。\\|\n"
"　それではな小娘。"
msgstr ""
"？？？「若有缘分，或许还会再见。\n"
"\\|　再会了小丫头。"

#. ID 95, Page 3, Line 200, Pos (26,27)
msgid "異界の鍵は砕け散った！"
msgstr "异界之钥碎裂四散了！"

#. ID 95, Page 3, Line 205, Pos (26,27)
msgid "レベル1固定の呪いが解けた！"
msgstr "等级1固定诅咒解除了！"

#. ID 95, Page 3, Line 217, Pos (26,27)
msgid ""
"？？？\n"
"「なんじゃ。\n"
"　カステラを持っておらぬではないか。\n"
"　出直してくるがいい。"
msgstr ""
"？？？「什么啊。　你不是没带长崎蛋糕来吗。\n"
"　改日再来吧。"

#. ID 95, Page 3, Line 228, Pos (26,27)
msgid ""
"？？？\n"
"「なんじゃ、優柔不断な奴じゃの。\\!\n"
"　まぁよい、わらわは寛大だからの。\n"
"　いくらでも待つとしよう。"
msgstr ""
"？？？「什么啊，真是个优柔寡断的家伙。\n"
"\\!　算了，吾可是很宽大的。　想等多久都行。"

#. ID 95, Page 3, Line 247, Pos (26,27)
msgid "彼女と話すには冥界の鍵が必要だ。"
msgstr "要和她说话，需要冥界之钥。"

#. ID 95, Page 5, Line 3, Pos (26,27)
msgid "鏡にはもはやなにも映っていない…。"
msgstr "镜中已经什么也没有映出来了…。"

#. ID 98, Page 3, Line 10, Pos (44,1)
msgid ""
"\n"
"…底に何かある。"
msgstr "…底部有什么东西。"

#. ID 114, Page 2, Line 4, Pos (27,28)
msgid "大丈夫だろうか…？"
msgstr "没问题吧…？"

#. ID 114, Page 2, Line 8, Pos (27,28)
msgid ""
"？？？\\s[10]\n"
"「うう、\\|私…\\|どうなって？"
msgstr "？？？\\s[10]「呜、\\|我…\\|怎么了？"

#. ID 114, Page 2, Line 25, Pos (27,28)
msgid ""
"？？？\\s[10]\n"
"「あんた…誰？\\!\n"
"　それに…ここは…どこなの？"
msgstr "？？？\\s[10]「你…是谁？\\!　还有…这里…是哪里？"

#. ID 114, Page 2, Line 30, Pos (27,28)
msgid ""
"\\N[\\V[6]]\n"
"「ダンジョンの中だけど…\\|\n"
"　ケガはない？"
msgstr "\\N[\\V[6]]「在迷宫里面…\\|　你没受伤吧？"

#. ID 114, Page 2, Line 36, Pos (27,28)
msgid ""
"？？？\\s[10]\n"
"「ケガはない…けど。\\!これは…\n"
"　魂が身体から抜けちゃってるわね。"
msgstr ""
"？？？\\s[10]「没受伤…不过。\\!这…\n"
"　是灵魂从身体里跑出来了呢。"

#. ID 114, Page 2, Line 42, Pos (27,28)
msgid ""
"？？？\\s[10]\n"
"「あんた…私を…元の身体のところに…\n"
"　連れてってくれない？"
msgstr ""
"？？？\\s[10]「你…能不能…把我…\n"
"带到原来的身体那里去…？"

#. ID 114, Page 2, Line 46, Pos (27,28)
msgid ""
"？？？\\s[10]\n"
"「ま…ダメって言っても…\n"
"　連れて行ってもらうけどね…！"
msgstr ""
"？？？\\s[10]「嘛…就算你说不行…\n"
"　我也要你带我过去…！"

#. ID 114, Page 2, Line 55, Pos (27,28)
msgid ""
"鏡面の少女は\\N[\\V[6]]の身体に\n"
"溶けるように消えていった！"
msgstr ""
"镜面少女仿佛融化一般，\n"
"消失在\\N[\\V[6]]的身体里了！"

#. ID 114, Page 2, Line 59, Pos (27,28)
msgid ""
"\\N[\\V[6]]\n"
"「え、\\.ちょ、\\|ちょっと…"
msgstr "\\N[\\V[6]]「诶，\\.等、\\|等一下…"

#. ID 114, Page 2, Line 63, Pos (27,28)
msgid ""
"？？？\n"
"「大丈夫大丈夫！\\|身体見つければ、\n"
"　すぐ元通りになるから！"
msgstr ""
"？？？「没事没事！\\|只要找到身体，\n"
"　马上就能恢复原样的！"

#. ID 114, Page 2, Line 66, Pos (27,28)
msgid ""
"？？？\n"
"「それじゃいくわよ！\\!\n"
"　道中気をつけなさいよね！"
msgstr "？？？「那么我走了！\\!　路上要小心点哦！"
