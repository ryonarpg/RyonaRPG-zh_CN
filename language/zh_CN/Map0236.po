#. ID 38, Page 2, Line 3, Pos (17,28)
msgid "……？"
msgstr "……？"

#. ID 38, Page 2, Line 4, Pos (17,28)
msgid "この小屋はなんだろうか？"
msgstr "这个小屋是什么呢？"

#. ID 38, Page 2, Line 5, Pos (17,28)
#. Contains choice at line 2 (2 options)
msgid "調べてみますか？"
msgstr "要调查一下吗？"

#. ID 38, Page 2, Line 6, Pos (17,28)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 38, Page 2, Line 9, Pos (17,28)
msgid "何かが体から抜けて行ったような気がする……。"
msgstr "感觉有什么东西从体内流失了……。"

#. ID 38, Page 2, Line 13, Pos (17,28)
msgid ""
"中を探ってみると、背筋を悪寒が走った！\n"
"…………。\n"
"突然の事に驚いたが、異常はないようだ……。"
msgstr ""
"往里面摸索时，一阵寒意窜过背脊！…………。\n"
"虽然被这突如其来的事吓了一跳，但似乎没有异常……\n"
"。"

#. ID 38, Page 2, Line 21, Pos (17,28)
msgid "探るのは止しておこう……。"
msgstr "还是别探了吧……。"

#. ID 38, Page 3, Line 4, Pos (17,28)
#. Choice (4 options)
msgid ""
"\\>ここで休む\n"
"\\>セーブする\n"
"\\>ワールドマップに出る\n"
"\\>何もしない"
msgstr ""
"\\>在此休息\n"
"\\>存档\n"
"\\>前往世界地图\n"
"\\>什么都不做"

#. ID 38, Page 3, Line 6, Pos (17,28)
#. Contains choice at line 2 (3 options)
msgid "いつまで休みますか？"
msgstr "要休息到什么时候？"

#. ID 38, Page 3, Line 7, Pos (17,28)
#. Choice (3 options, embedded in a message)
msgid ""
"\\>朝まで\n"
"\\>夜まで\n"
"\\>やめる"
msgstr ""
"\\>到早上\n"
"\\>到晚上\n"
"\\>取消"

#. ID 38, Page 4, Line 3, Pos (17,28)
msgid "どうやらここに、妖猫の骨が埋められていたようだ……。"
msgstr "看来这里曾经埋着妖猫之骨……。"
