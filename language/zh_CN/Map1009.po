"是\n"
"否"

#. ID 61, Page 2, Line 20, Pos (55,28)
#. ID 98, Page 2, Line 13, Pos (79,52)
msgid "どこか近くで音がしたようだ……"
msgstr "附近某处好像发出了声音……"

#. ID 61, Page 3, Line 3, Pos (55,28)
#. ID 98, Page 3, Line 3, Pos (79,52)
msgid "固定されて元に戻らないようだ。"
msgstr "似乎被固定住了，无法复位。"

#. ID 75, Page 2, Line 7, Pos (57,18)
msgid "たいしたことないものを手に入れた。"
msgstr "获得了没什么大不了的东西。"
