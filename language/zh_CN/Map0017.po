"\\>\\c[19]【ダーリン】\\c[0]\n"
"まいどありー。\\$"
msgstr ""
"\\>\\c[19]【亲爱的】\\c[0]\n"
"多谢惠顾～。\\$"

#. ID 3, Page 1, Line 246, Pos (9,6)
#. ID 3, Page 1, Line 260, Pos (9,6)
#. ID 3, Page 1, Line 274, Pos (9,6)
msgid ""
"\\>\\c[19]【ダーリン】\\c[0]\n"
"あ、お金が足りないね…"
msgstr ""
"\\>\\c[19]【亲爱的】\\c[0]\n"
"啊，金钱不够呢…"

#. ID 3, Page 1, Line 283, Pos (9,6)
msgid ""
"\\>【客】\n"
"買った！！やったぞ！全部！！\n"
"ミルク！！すべて！私の手にッ！！"
msgstr ""
"\\>【客人】\n"
"买到了！！太棒了！全部！！牛奶！！\n"
"全部！都在我手里了！！"

#. ID 3, Page 1, Line 287, Pos (9,6)
msgid ""
"\\>\\c[19]【ダーリン】\\c[0]\n"
"やったよサマンサ！また完売したよ！\n"
"また明日もよろしくねー。"
msgstr ""
"\\>\\c[19]【亲爱的】\\c[0]\n"
"做到了哦，萨曼莎！\n"
"又卖光啦！明天也请多关照哦～"

#. ID 3, Page 1, Line 292, Pos (9,6)
msgid ""
"\\>\\c[19]【ダーリン】\\c[0]\n"
"ﾋｸﾋｸ"
msgstr ""
"\\>\\c[19]【亲爱的】\\c[0]\n"
"抽泣抽泣"

#. ID 3, Page 3, Line 7, Pos (9,6)
msgid ""
"\\>\\c[19]【ダーリン】\\c[0]\n"
"犬…か、\n"
"まあ見ていってくれ"
msgstr ""
"\\>\\c[19]【亲爱的】\\c[0]\n"
"狗…吗，嘛，看看再走吧"

#. ID 4, Page 1, Line 14, Pos (10,6)
msgid ""
"\\>\\c[6]【サマンサ】\\c[0]\n"
"サマンサの魔法店へようこ…そ。\n"
"んっ……"
msgstr ""
"\\>\\c[6]【萨曼莎】\\c[0]\n"
"欢迎来到萨曼莎的魔法店…。\n"
"嗯……"

#. ID 4, Page 1, Line 17, Pos (10,6)
msgid ""
"\\>\\c[6]【サマンサ】\\c[0]\n"
"魔法の入れ替え、されますか…？"
msgstr ""
"\\>\\c[6]【萨曼莎】\\c[0]\n"
"要更换魔法吗…？"

#. ID 4, Page 1, Line 19, Pos (10,6)
#. Choice (4 options)
msgid ""
"魔法入れ替えする(新方式 / 推奨)\n"
"魔法入れ替えする(旧方式)\n"
"キャンセル\n"
"ガン見する"
msgstr ""
"更换魔法（新方式 / 推荐）\n"
"更换魔法（旧方式）\n"
"取消\n"
"盯着看"

#. ID 4, Page 1, Line 29, Pos (10,6)
msgid ""
"\\>\\c[6]【サマンサ】\\c[0]\n"
"旧方式で魔法の入れ替えを行うと\n"
"いったん全ての魔法が失われます…が\n"
"よろしいですか…？"
msgstr ""
"\\>\\c[6]【萨曼莎】\\c[0]\n"
"如果用旧方式更换魔法，\n"
"会暂时失去所有魔法…这样可以吗…？"

