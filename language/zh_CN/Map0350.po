#. ID 5, Page 1, Line 3, Pos (5,25)
msgid "…Zzz"
msgstr "…Zzz"

#. ID 10, Page 1, Line 4, Pos (39,8)
msgid ""
"借りたコインを返却するまで\n"
"外に出ることはできない！"
msgstr "在归还借来的硬币之前，不能到外面去！"

#. ID 12, Page 1, Line 48, Pos (14,16)
msgid "＊バーストしてしまった……"
msgstr "＊爆牌了……"

#. ID 12, Page 1, Line 63, Pos (14,16)
msgid "＊ブラックジャックだ！"
msgstr "＊是黑杰克！"

#. ID 12, Page 1, Line 120, Pos (14,16)
msgid "＊ディーラーがバーストした！"
msgstr "＊荷官爆牌了！"

#. ID 12, Page 1, Line 162, Pos (14,16)
#. ID 12, Page 1, Line 341, Pos (14,16)
msgid "＊現在の合計は \\v[251]だ。"
msgstr "＊当前合计是 \\v[251]。"

#. ID 12, Page 1, Line 164, Pos (14,16)
msgid ""
"\\>＊現在の合計は \\v[251]だ。\\<\n"
"　ダブルダウンのため、自動的にスタンドします。"
msgstr ""
"\\>＊当前合计是 \\v[251]。\\<　因为双倍下注，\n"
"　所以自动停牌。"

#. ID 12, Page 1, Line 172, Pos (14,16)
#. Choice (3 options)
msgid ""
"\\>ヒット（カードを引く）\\<\n"
"\\>スタンド（これで勝負！）\\<\n"
"\\>サレンダー（勝負を降りる）\\<"
msgstr ""
"\\>要牌（抽牌）\\<\n"
"\\>停牌（就这样决胜负！）\\<\n"
"\\>投降（退出胜负）\\<"

#. ID 12, Page 1, Line 185, Pos (14,16)
#. Contains choice at line 2 (2 options)
msgid "＊本当に勝負を降りますか？"
msgstr "＊真的要退出胜负吗？"

#. ID 12, Page 1, Line 186, Pos (14,16)
#. Choice (2 options, embedded in a message)
#. ID 12, Page 1, Line 345, Pos (14,16)
#. Choice (2 options)
#. ID 12, Page 1, Line 376, Pos (14,16)
#. Choice (2 options, embedded in a message)
msgid ""
"\\>はい\\<\n"
"\\>いいえ\\<"
msgstr ""
"\\>是\\<\n"
"\\>否\\<"

#. ID 12, Page 1, Line 188, Pos (14,16)
msgid "それでは、ベットの半額をお返しいたします。"
msgstr "那么，我将退还下注金额的一半。"

#. ID 12, Page 1, Line 192, Pos (14,16)
msgid "\\$ベットの半額の\\v[256]コインが戻ってきた。"
msgstr "\\$下注金额一半的\\v[256]硬币回来了。"

#. ID 12, Page 1, Line 203, Pos (14,16)
msgid ""
"\\>＊現在の合計は \\v[251]だ。\\<\n"
"　合計が21になったので、自動的にスタンドします。"
msgstr ""
"\\>＊当前合计是 \\v[251]。\\<　因为合计变成21了，\n"
"　所以自动停牌。"

#. ID 12, Page 1, Line 218, Pos (14,16)
msgid ""
"＊ディーラーがブラックジャックではないので\n"
"　自動的に勝利となります！"
msgstr "＊因为荷官不是黑杰克　所以自动获胜！"

#. ID 12, Page 1, Line 230, Pos (14,16)
msgid "＊ディーラーはブラックジャックだった！"
msgstr "＊荷官是黑杰克！"

#. ID 12, Page 1, Line 233, Pos (14,16)
msgid ""
"ディーラーがブラックジャックだったので\n"
"負けてしまった……"
msgstr "因为荷官是黑杰克，所以我输了……"

#. ID 12, Page 1, Line 240, Pos (14,16)
msgid ""
"\\$＊しかし、インシュアランスしていたので\n"
"　ベットと保険金の合計\\v[256]コインが戻ってきた。"
msgstr ""
"\\$＊但是，\n"
"　因为事先买了保险　下注金额和保险金合计\\v[256]\n"
"硬币回来了。"

#. ID 12, Page 1, Line 265, Pos (14,16)
msgid "＊\\N[\\V[6]] \\v[251]　：　ディーラー \\v[252]　"
msgstr "＊\\N[\\V[6]] \\v[251]　：　荷官 \\v[252]"

#. ID 12, Page 1, Line 272, Pos (14,16)
msgid "負けてしまった……"
msgstr "输了……"

#. ID 12, Page 1, Line 278, Pos (14,16)
msgid "引き分け。"
msgstr "平局。"

#. ID 12, Page 1, Line 281, Pos (14,16)
#. ID 15, Page 1, Line 207, Pos (21,32)
msgid "\\$ベットした\\v[256]コインが戻ってきた。"
msgstr "\\$下注的\\v[256]硬币回来了。"

#. ID 12, Page 1, Line 289, Pos (14,16)
msgid "勝利！"
msgstr "胜利！"

#. ID 12, Page 1, Line 296, Pos (14,16)
msgid ""
"\\$ブラックジャックだったため、\n"
"　\\v[256]コインを獲得！"
msgstr "\\$因为是黑杰克，　获得了\\v[256]硬币！"

#. ID 12, Page 1, Line 303, Pos (14,16)
#. ID 15, Page 1, Line 229, Pos (21,32)
#. ID 15, Page 1, Line 236, Pos (21,32)
#. ID 17, Page 1, Line 350, Pos (5,16)
msgid "\\$\\v[256]コインを獲得した。"
msgstr "\\$获得了\\v[256]硬币。"

#. ID 12, Page 1, Line 319, Pos (14,16)
#. Contains choice at line 2 (2 options)
#. ID 15, Page 1, Line 267, Pos (21,32)
#. Contains choice at line 2 (2 options)
#. ID 17, Page 1, Line 369, Pos (5,16)
#. Contains choice at line 2 (2 options)
msgid "続けられますか？"
msgstr "还能继续吗？"

#. ID 12, Page 1, Line 320, Pos (14,16)
#. Choice (2 options, embedded in a message)
#. ID 15, Page 1, Line 268, Pos (21,32)
#. Choice (2 options, embedded in a message)
#. ID 17, Page 1, Line 370, Pos (5,16)
#. Choice (2 options, embedded in a message)
msgid ""
"\\>続ける！\\<\n"
"\\>やめておきます\\<"
msgstr ""
"\\>继续！\\<\n"
"\\>还是算了\\<"

#. ID 12, Page 1, Line 325, Pos (14,16)
#. ID 12, Page 10, Line 216, Pos (14,16)
#. ID 17, Page 1, Line 376, Pos (5,16)
#. ID 17, Page 10, Line 388, Pos (5,16)
msgid ""
"左様でございますか。\\!\n"
"それでは、またのお越しを…"
msgstr "原来如此。\\!那么，欢迎您再次光临……"

#. ID 12, Page 1, Line 342, Pos (14,16)
msgid ""
"\\$\\>＊現在の合計は \\v[251]だ。\\<\n"
"　ダブルダウンで勝負しますか？\n"
"　（\\v[256]コイン必要）"
msgstr ""
"\\$\\>＊当前合计是 \\v[251]。\n"
"　\\<　要双倍下注决胜负吗？　（需要\\v[256]硬币）"

#. ID 12, Page 1, Line 348, Pos (14,16)
msgid ""
"＊コインが足りない為、ダブルダウン出来ません。\n"
"　通常の勝負となります。"
msgstr ""
"＊因为硬币不够，无法双倍下注。\n"
"　将进行普通胜负。"

#. ID 12, Page 1, Line 355, Pos (14,16)
msgid "\\$＊\\v[256]コインを追加ベットした！！"
msgstr "\\$＊追加下注了\\v[256]硬币！！"

#. ID 12, Page 1, Line 374, Pos (14,16)
#. Contains choice at line 3 (2 options)
msgid ""
"\\$＊インシュアランスしますか？\n"
"　（\\v[241]コイン必要）"
msgstr "\\$＊要买保险吗？　（需要\\v[241]硬币）"

#. ID 12, Page 1, Line 379, Pos (14,16)
msgid ""
"＊コインが足りない為、インシュアランス出来ません。\n"
"　自動的にパスされます。"
msgstr "＊因为金币不足，无法进行保险。　将自动跳过。"

#. ID 12, Page 1, Line 385, Pos (14,16)
msgid "\\$＊\\v[241]コインを保険金として支払った。"
msgstr "\\$＊\\v[241]金币已作为保险金支付。"

#. ID 12, Page 1, Line 396, Pos (14,16)
msgid "……\\.\\.……\\.\\.……\\.\\.……\\.\\^"
msgstr "……\\.\\.……\\.\\.……\\.\\.……\\.\\^"

#. ID 12, Page 1, Line 405, Pos (14,16)
msgid "＊ディーラーはブラックジャックではなかった！"
msgstr "＊荷官并不是黑杰克！"

#. ID 12, Page 1, Line 408, Pos (14,16)
msgid ""
"\\>＊ディーラーはブラックジャックではなかった！\\<\n"
"　保険金は没収されてしまった……"
msgstr "\\>＊荷官并不是黑杰克！\\<　保险金被没收了……"

#. ID 12, Page 1, Line 419, Pos (14,16)
#. ID 15, Page 1, Line 373, Pos (21,32)
msgid ""
"＊獲得コインが10000コインを超えましたので\n"
"　これにて打ち止めとさせていただきます。"
msgstr ""
"＊由于获得的金币已超过10000金币，\n"
"　因此就此到此为止。"

#. ID 12, Page 1, Line 425, Pos (14,16)
#. Contains choice at line 3 (2 options)
#. ID 15, Page 1, Line 379, Pos (21,32)
#. Contains choice at line 3 (2 options)
msgid ""
"\\$この配当\\v[256]コインを、そのまま次のゲームに\n"
"賭けることができます。挑戦しますか？"
msgstr ""
"\\$这份奖金\\v[256]金币，\n"
"可以就这样下注到下一局。要挑战吗？"

#. ID 12, Page 1, Line 427, Pos (14,16)
#. Choice (2 options, embedded in a message)
#. ID 15, Page 1, Line 381, Pos (21,32)
#. Choice (2 options, embedded in a message)
msgid ""
"\\>女は度胸！\\<\n"
"\\>やめておきます\\<"
msgstr ""
"\\>女人靠胆量！\\<\n"
"\\>还是算了\\<"

#. ID 12, Page 1, Line 432, Pos (14,16)
#. ID 12, Page 9, Line 34, Pos (14,16)
#. ID 15, Page 1, Line 418, Pos (21,32)
#. ID 15, Page 9, Line 60, Pos (21,32)
#. ID 17, Page 9, Line 39, Pos (5,16)
#. ID 32, Page 4, Line 38, Pos (29,20)
msgid "\\$＊\\v[241]コインをベットした。"
msgstr "\\$＊\\v[241]金币已下注。"

#. ID 12, Page 9, Line 4, Pos (14,16)
#. ID 17, Page 9, Line 6, Pos (5,16)
msgid ""
"コインが足りないようですね。\n"
"最低ベットは5コインからとなっております。"
msgstr "金币似乎不够呢。最低下注从5金币起。"

#. ID 12, Page 9, Line 13, Pos (14,16)
#. ID 15, Page 9, Line 34, Pos (21,32)
#. ID 17, Page 9, Line 18, Pos (5,16)
msgid ""
"\\$＊ベットするコイン数を設定してください。\n"
"　最低ベットは5コインで200コインまで賭けられます。"
msgstr ""
"\\$＊请设置要下注的金币数。　最低下注为5金币，\n"
"　最多可下注200金币。"

#. ID 12, Page 9, Line 18, Pos (14,16)
#. ID 15, Page 9, Line 39, Pos (21,32)
#. ID 17, Page 9, Line 23, Pos (5,16)
msgid "＊ベットが少なすぎます。再度入力してください。"
msgstr "＊下注太少了。请重新输入。"

#. ID 12, Page 9, Line 23, Pos (14,16)
#. ID 15, Page 9, Line 44, Pos (21,32)
#. ID 17, Page 9, Line 28, Pos (5,16)
msgid "＊ベットが多すぎます。再度入力してください。"
msgstr "＊下注太多了。请重新输入。"

#. ID 12, Page 9, Line 28, Pos (14,16)
#. ID 15, Page 9, Line 49, Pos (21,32)
#. ID 17, Page 9, Line 33, Pos (5,16)
msgid "＊コインが足りません。再度入力してください。"
msgstr "＊金币不足。请重新输入。"

#. ID 12, Page 10, Line 4, Pos (14,16)
msgid ""
"こちらはブラックジャックのテーブルです。\n"
"勝負なさいますか？"
msgstr "这里是黑杰克的牌桌。您要进行对局吗？"

#. ID 12, Page 10, Line 6, Pos (14,16)
#. Choice (3 options)
msgid ""
"\\>はい\n"
"\\>いいえ\n"
"\\>ルール説明"
msgstr ""
"\\>是\n"
"\\>否\n"
"\\>规则说明"

#. ID 12, Page 10, Line 18, Pos (14,16)
msgid ""
"かしこまりました。\\!\n"
"ブラックジャックとは、カードの合計点数を\n"
"21に近づけ、勝負するゲームです。"
msgstr ""
"明白了。\\!所谓黑杰克，\n"
"是一种让牌的总点数接近21来进行对局的游戏。"

#. ID 12, Page 10, Line 33, Pos (14,16)
msgid ""
"まず、プレイヤーとディーラー（カジノ側）に\n"
"2枚ずつカードが配られます。\\!\n"
"ディーラーのカードは1枚は伏せられており、\n"
"最初は見ることはできません。"
msgstr ""
"首先，玩家和荷官（赌场方）各发2张牌。\n"
"\\!荷官的牌有1张是盖着的，最初看不到。"

#. ID 12, Page 10, Line 37, Pos (14,16)
msgid ""
"2～9までのカードは数字そのままの数、\n"
"10、J、Q、Kは全て10としてカウントされます。"
msgstr ""
"2～9的牌按牌面数字本身计算，10、J、Q、\n"
"K全部按10计算。"

#. ID 12, Page 10, Line 39, Pos (14,16)
msgid ""
"Aは、通常は11としてカウントしますが、\n"
"カードの合計点が21を超えてしまう場合は\n"
"1としてカウントされます。"
msgstr ""
"A通常按11计算，但如果牌的总点数超过21，\n"
"则按1计算。"

#. ID 12, Page 10, Line 42, Pos (14,16)
msgid ""
"カードが配られましたら、プレイヤーは\n"
"「ヒット」か「スタンド」の選択を行います。"
msgstr "发牌后，玩家选择「要牌」还是「停牌」。"

#. ID 12, Page 10, Line 44, Pos (14,16)
msgid ""
"ヒット（カードを引く）：\n"
"カードの合計点数が低いと感じた場合に、\n"
"カードをもう1枚引く事です。"
msgstr ""
"要牌（抽牌）：当觉得牌的总点数较低时，\n"
"再抽1张牌。"

#. ID 12, Page 10, Line 54, Pos (14,16)
msgid ""
"カードを引いてもまだ点数が低いと感じた場合は、\n"
"更に追加でカードを引くことができます。\\!\n"
"21を超えない限り、何枚でも引くことができます。"
msgstr ""
"抽牌后如果仍觉得点数低，还可以继续追加抽牌。\n"
"\\!只要不超过21，抽多少张都可以。"

#. ID 12, Page 10, Line 64, Pos (14,16)
msgid ""
"ただし、カードの合計点が21を超えてしまった場合、\n"
"「バースト」となり、その時点で\n"
"プレイヤーの負けとなりますのでご注意を。"
msgstr ""
"不过，如果牌的总点数超过21，就会「爆牌」，\n"
"此时玩家即告失败，请注意。"

#. ID 12, Page 10, Line 70, Pos (14,16)
msgid ""
"スタンド（勝負）：\n"
"カードを引かず、その時点の合計点で勝負します。\\!\n"
"プレイヤーがスタンドした時点で、ディーラーの\n"
"伏せられたカードがオープンされます。"
msgstr ""
"停牌（对局）：不再抽牌，\n"
"以此时的总点数进行对局。\\!玩家停牌时，\n"
"荷官盖着的牌会被翻开。"

#. ID 12, Page 10, Line 76, Pos (14,16)
msgid ""
"ディーラーの合計点が16以下の場合、\n"
"追加のカードを引きます。\\!これは、合計点が\n"
"17以上になるまで行われます。"
msgstr ""
"如果荷官的总点数为16以下，则追加抽牌。\n"
"\\!这会持续到总点数达到17以上为止。"

#. ID 12, Page 10, Line 91, Pos (14,16)
msgid ""
"ディーラーが21を超えた場合、プレイヤーが\n"
"21以下であれば、プレイヤーの勝ちとなります。"
msgstr "如果荷官超过21，而玩家为21以下，则玩家获胜。"

#. ID 12, Page 10, Line 93, Pos (14,16)
msgid ""
"プレイヤーとディーラーが共に21以下の場合は、\n"
"より21に近い点数の方が勝ちとなります。\\!\n"
"点数が同じ場合は引き分けとなります。"
msgstr ""
"玩家和荷官都在21以下时，\n"
"点数更接近21的一方获胜。\\!点数相同时为平局。"

#. ID 12, Page 10, Line 96, Pos (14,16)
msgid ""
"なお、途中で勝ち目が薄いと判断されましたら、\n"
"「サレンダー」を宣言し、降りることも可能です。\\!\n"
"この場合、ベットの半額をお返しいたします。"
msgstr ""
"另外，如果中途判断胜算不大，\n"
"也可以宣布「投降」并退出。\\!这种情况下，\n"
"将退还下注额的一半。"

#. ID 12, Page 10, Line 117, Pos (14,16)
msgid ""
"また、プレイヤーが最初の2枚で21となった場合を\n"
"「ブラックジャック」と呼び、その時点で\n"
"自動的に勝利となります。\\!\n"
"この場合、2.5倍の配当となります。"
msgstr ""
"另外，\n"
"玩家用最初2张牌就达到21的情况称为「黑杰克」，\n"
"此时自动获胜。\\!这种情况下，将获得2.5倍赔付。"

#. ID 12, Page 10, Line 121, Pos (14,16)
msgid ""
"同様に、ディーラーがブラックジャックだった場合、\n"
"その時点で自動的に負けとなります。\\!\n"
"この場合、1.5倍の支払い…\\!とはなりませんので\n"
"その点はご安心ください。"
msgstr ""
"同样，如果荷官是黑杰克，此时玩家自动失败。\n"
"\\!这种情况下，也不会要求支付1.5倍……\n"
"\\!所以这一点请放心。"

#. ID 12, Page 10, Line 125, Pos (14,16)
msgid ""
"プレイヤー、ディーラーが共に\n"
"ブラックジャックだった場合は引き分けです。"
msgstr "玩家、荷官双方都是黑杰克时，为平局。"

#. ID 12, Page 10, Line 137, Pos (14,16)
msgid ""
"続きまして、一定の条件下で選択できる\n"
"特殊なアクションについて説明いたします。"
msgstr "接下来，说明在一定条件下可以选择的特殊行动。"

#. ID 12, Page 10, Line 151, Pos (14,16)
msgid ""
"ダブルダウン（ベットを倍にして勝負）：\n"
"最初の2枚の合計点が9～11だった場合、\n"
"ベットを倍にして、カードを1枚のみ引いて\n"
"勝負することができます。"
msgstr ""
"双倍下注（将下注翻倍进行对局）：\n"
"最初2张牌的总点数为9～11时，可以将下注翻倍，\n"
"只抽1张牌进行对局。"

#. ID 12, Page 10, Line 162, Pos (14,16)
msgid ""
"なお、ダブルダウンを行った場合、自動的に\n"
"スタンド（勝負）となり、それ以上は\n"
"カードが引けなくなるのでご注意ください。"
msgstr ""
"另外，进行双倍下注时，会自动变为停牌（对局），\n"
"之后不能再抽牌，请注意。"

#. ID 12, Page 10, Line 183, Pos (14,16)
msgid ""
"インシュアランス（保険をかける）：\n"
"ディーラーの開かれているカードがAだった場合、\n"
"ベットの半額を追加で支払い、ディーラーの\n"
"ブラックジャックに対し、保険をかける事ができます。"
msgstr ""
"保险（购买保险）：如果荷官的明牌是A，\n"
"可以额外支付下注额的一半，\n"
"为荷官出现黑杰克投保。"

#. ID 12, Page 10, Line 189, Pos (14,16)
msgid ""
"インシュアランスをした上で、\n"
"ディーラーがブラックジャックだった場合、\n"
"勝負の上ではプレイヤーの負けとなりますが、\n"
"ベットしたコインと保険金は全額返還されます。"
msgstr ""
"购买保险后，如果荷官是黑杰克，\n"
"虽然对局判定上玩家失败，\n"
"但下注的金币和保险金会全额退还。"

#. ID 12, Page 10, Line 195, Pos (14,16)
msgid ""
"ですが、ディーラーがブラックジャックでない場合、\n"
"支払った保険金はそのまま没収されてしまいます。\\!\n"
"この場合は、そのまま通常の勝負へと移行します。"
msgstr ""
"但如果荷官不是黑杰克，\n"
"已支付的保险金将被直接没收。\\!这种情况下，\n"
"将直接转入通常对局。"

#. ID 12, Page 10, Line 207, Pos (14,16)
#. Contains choice at line 3 (2 options)
msgid ""
