#. ID 64, Page 1, Line 3, Pos (31,34)
msgid "この台は点検中です。"
msgstr "这台机器正在检修中。"

#. ID 65, Page 1, Line 3, Pos (35,34)
msgid "話しかけるな。"
msgstr "别跟我搭话。"

#. ID 66, Page 1, Line 3, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「クソッ、また外した。」"
msgstr "紫头巾男「可恶，又没中。」"

#. ID 66, Page 1, Line 6, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「ん？\\.\\.　お前さんは確かヒドゥンで……」"
msgstr "紫头巾男「嗯？\\.\\.　你好像是希顿……」"

#. ID 66, Page 1, Line 8, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「こんな所で再会するなんて奇遇だな。\n"
"　そんなお前さんに良い事を教えてやろう。」"
msgstr ""
"紫头巾男「在这种地方重逢，真是奇遇啊。\n"
"　就告诉你件好事吧。」"

#. ID 66, Page 1, Line 13, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「ん、何だ？\\.\\.　ここは俺が使ってるんだが。」"
msgstr ""
"紫头巾男「嗯，什么事？\\.\\.　这里可是我在用啊。\n"
"」"

#. ID 66, Page 1, Line 15, Pos (31,37)
msgid ""
"\n"
"「いえ、何でも……」"
msgstr "「不，没什么……」"

#. ID 66, Page 1, Line 17, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「そうか？\n"
"　なら邪魔しないでくれよ。」"
msgstr "紫头巾男「是吗？　那就别打扰我啊。」"

#. ID 66, Page 1, Line 26, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「ああ、ちょっと待ってくれ。」"
msgstr "紫头巾男「啊，等一下。」"

#. ID 66, Page 1, Line 34, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「お前さん、ちょいと金を恵んでくれないか？\\.\\.\n"
"　ほんの1000ぽっちで構わないんだ。\n"
"　もちろんタダでくれとは言わないさ。」"
msgstr ""
"紫头巾男「你，能不能施舍我一点金钱？\n"
"\\.\\.　只要区区1000就好。　当然，\n"
"　我不会白要你的。」"

#. ID 66, Page 1, Line 38, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「俺の持っている情報を、お前さんにも教えてやろう。\n"
"　それでどうだい？」"
msgstr ""
"紫头巾男「我把我掌握的情报也告诉你。　怎么样？\n"
"」"

#. ID 66, Page 1, Line 44, Pos (31,37)
#. Contains choice at line 3 (2 options)
msgid ""
"\n"
"お金を出しますか？"
msgstr "要拿出金钱吗？"

#. ID 66, Page 1, Line 46, Pos (31,37)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 66, Page 1, Line 53, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「ありがとよ。\n"
"　じゃあ、俺の持ってる情報を教えよう。」"
msgstr ""
"紫头巾男「谢啦。\n"
"　那我就把我知道的情报告诉你吧。」"

#. ID 66, Page 1, Line 61, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「お前さんも貧乏だったんだな……」"
msgstr "紫头巾男「你也挺穷的啊……」"

#. ID 66, Page 1, Line 73, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「そうか……\\.\\.\n"
"　気が変わったら、よろしく頼むぜ。」"
msgstr ""
"紫头巾男「这样啊……\\.\\.　要是改变主意了，\n"
"就拜托你了。」"

#. ID 66, Page 1, Line 83, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「この街の郊外にな、\n"
"　ぽつんと建っている建物があるんだ。」"
msgstr ""
"紫头巾男「这座城市的郊外啊，\n"
"　有一栋孤零零建着的建筑。」"

#. ID 66, Page 1, Line 86, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「その建物の中には、\n"
"　ここで大金持ちになったヤツの財宝が\n"
"　保管されているらしいぜ。」"
msgstr ""
"紫头巾男「听说那栋建筑里，\n"
"　保管着在这里成为大富豪的家伙的财宝。」"

#. ID 66, Page 1, Line 90, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「人気の無い郊外に財宝……\\.\\.\n"
"　まるで盗みに来てくださいって\n"
"　言ってるようなものだが……」"
msgstr ""
"紫头巾男「把财宝放在人迹罕至的郊外……\n"
"\\.\\.　简直就像在说请来偷吧一样……」"

#. ID 66, Page 1, Line 100, Pos (31,37)
msgid ""
"\n"
"◆「郊外の宝物庫」の情報を手に入れた。"
msgstr "◆获得了「郊外宝物库」的情报。"

#. ID 66, Page 2, Line 3, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「クソッ、またか……」"
msgstr "紫头巾男「可恶，又来啊……」"

#. ID 66, Page 2, Line 5, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「なあ、お前さん。\n"
"　ちっと買い物していかないか？」"
msgstr "紫头巾男「喂，你。　要不要稍微买点东西再走？」"

#. ID 66, Page 2, Line 13, Pos (31,37)
#. ID 66, Page 4, Line 13, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「ありがとよ。」"
msgstr "紫头巾男「谢啦。」"

#. ID 66, Page 2, Line 19, Pos (31,37)
#. ID 66, Page 4, Line 19, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「欲しくなったら、また声をかけてくれよ。」"
msgstr "紫头巾男「想要的话，再来叫我一声啊。」"

#. ID 66, Page 4, Line 3, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「ん？　ああ、お前さんか。\n"
"　何か用かい？」"
msgstr "紫头巾男「嗯？　啊，是你啊。　有什么事吗？」"

#. ID 66, Page 4, Line 6, Pos (31,37)
#. Choice (3 options)
msgid ""
"\\>買い物\n"
"\\>悪魔の森について聞く\n"
"\\>なんでもない"
msgstr ""
"\\>买东西\n"
"\\>打听恶魔之森的事\n"
"\\>没什么"

#. ID 66, Page 4, Line 25, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「何を聞きたいんだい？」"
msgstr "紫头巾男「你想问什么？」"

#. ID 66, Page 4, Line 28, Pos (31,37)
#. Choice (4 options)
msgid ""
"\\>悪魔の森について\n"
"\\>西の悪魔・南の魔女について\n"
"\\>森で気をつける事は？\n"
"\\>なんでもない"
msgstr ""
"\\>关于恶魔之森\n"
"\\>关于西方恶魔・南方魔女\n"
"\\>在森林里要注意什么？\n"
"\\>没什么"

#. ID 66, Page 4, Line 30, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「この間お前さんに調べてもらった森があるだろう？\n"
"　その森の元々の呼び名さ。\n"
"　文字通り、昔はたくさんの悪魔達がいたらしい。"
msgstr ""
"紫头巾男「之前让你调查过的那片森林有吧？\n"
"　那是那片森林原本的名字。　顾名思义，\n"
"　以前好像有很多恶魔。"

#. ID 66, Page 4, Line 34, Pos (31,37)
msgid ""
"　そいつらの親玉は随分とやんちゃらしくてね。\n"
"　見かねた\\c[11]西の悪魔\\c[0]と\\c[11]南の魔女\\c[0]によって、\n"
"　森の奥に封じられていたんだが……\n"
"　どうやら、その封印が解けたみたいだな。」"
msgstr ""
"　那群家伙的头目好像相当胡闹呢。\n"
"　看不下去的\\c[11]西方恶魔\\c[0]和\\c[11]南方\n"
"　魔女\\c[0]将其封印在森林深处……　不过，\n"
"　看来那道封印好像解开了。」"

#. ID 66, Page 4, Line 41, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「西のっていうのは霊峰のずっと先の事でよ、\n"
"　確かガッなんとかっていう城の主らしいぜ。"
msgstr ""
"紫头巾男「所谓西方的那个，\n"
"是在灵峰更前方的地方，\n"
"　我记得好像是叫加什么来着的一座城堡之主。」"

#. ID 66, Page 4, Line 44, Pos (31,37)
msgid ""
"　南の魔女は、まあ魔女さ。\n"
"　魔法を駆使して何百年も生きているみたいだぜ。\n"
"　\\c[9]野菜嫌い\\c[0]の魔女っていうのはおかしな話だけどな。"
msgstr ""
"　南方魔女嘛，就是魔女啦。\n"
"　好像驱使魔法活了好几百年。　不过，\n"
"　说她是\\c[9]讨厌蔬菜\\c[0]的魔女，\n"
"　倒是挺奇怪的。"

#. ID 66, Page 4, Line 47, Pos (31,37)
msgid ""
"\n"
"　ん？　知り合いなのかって？\n"
"　まあ、仕事上の付き合いって程度だけどな。」"
msgstr ""
"　嗯？　你问是不是熟人？　嘛，\n"
"　也就是工作上的交情而已。」"

#. ID 66, Page 4, Line 53, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「野盗に気を付けるのは当然なんだが、\n"
"　悪魔にも十分気を付けた方がいいと思うぜ。"
msgstr ""
"紫头巾男「提防土匪是理所当然的，\n"
"　不过我觉得对恶魔也要多加小心。」"

#. ID 66, Page 4, Line 56, Pos (31,37)
msgid ""
"　始めにこの情報を持ってきた奴が言ってたんだが、\n"
"　どうも悪魔達は普通の魔法以外にも、\n"
"　特殊な魔法を使ってくるらしい。"
msgstr ""
"　最开始带来这个情报的家伙说过，\n"
"　那些恶魔似乎除了普通魔法之外，\n"
"　还会使用特殊魔法。"

#. ID 66, Page 4, Line 59, Pos (31,37)
msgid ""
"　その魔法が使われると、\n"
"　\\c[11]敵の攻撃が強力になったり、耐久力が増したり、\n"
"　スピードが上昇したり\\c[0]するらしい。"
msgstr ""
"　据说一旦那种魔法被使用，\n"
"　\\c[11]敌人的攻击会变强、耐久力会增加、\n"
"　速度会提升\\c[0]。"

#. ID 66, Page 4, Line 62, Pos (31,37)
msgid ""
"\n"
"　手がつけられなくなる前に悪魔を倒すか、\n"
"　強化された敵を優先して倒した方が良いかもな。"
msgstr ""
"　在变得无法应付之前打倒恶魔，\n"
"　或者优先打倒被强化的敌人，或许比较好。"

#. ID 66, Page 4, Line 65, Pos (31,37)
msgid ""
"　まあ、あくまで魔法みたいだから、\n"
"　\\c[11]魔法を使えなくする魔法\\c[0]とか、\n"
"　\\c[11]魔除けの効果のある魔法\\c[0]を使って、\n"
"　一気に駆け抜けてしまうのも手だろう。」"
msgstr ""
"　嘛，终究好像是魔法，\n"
"　所以使用\\c[11]能让魔法无法使用的魔法\\c[0]\n"
"　啦，　或者\\c[11]具有驱魔效果的魔法\\c[0]，\n"
"　一口气冲过去也是个办法吧。」"

#. ID 66, Page 4, Line 72, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「森に入るなら、準備は怠らずにな。」"
msgstr ""
"紫头巾男「要进森林的话，可别偷懒不做好准备啊。\n"
"」"

#. ID 66, Page 4, Line 78, Pos (31,37)
msgid ""
"紫バンダナの男\n"
"「用がある時はいつでも声かけてくれよな。」"
msgstr "紫头巾男「有事的时候随时叫我啊。」"

#. ID 67, Page 1, Line 3, Pos (35,37)
msgid "Zzz"
msgstr "Zzz"
