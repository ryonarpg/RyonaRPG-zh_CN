#. ID 2, Page 1, Line 3, Pos (38,14)
#. ID 28, Page 1, Line 3, Pos (38,13)
msgid ""
"ここから先は立ち入り禁止です。\n"
"入りたければ犯罪者になるしかないですね"
msgstr ""
"从这里往前禁止入内。\n"
"想进去的话就只能成为犯罪者了呢。"

#. ID 8, Page 1, Line 3, Pos (37,8)
msgid "くそ、懲役食らっちまった。"
msgstr "可恶，被判刑了。"

#. ID 9, Page 1, Line 3, Pos (33,8)
msgid "お、こりゃいい目の保養だぜ。"
msgstr "哦，这可真是养眼啊。"

#. ID 10, Page 2, Line 3, Pos (29,8)
msgid "くそっ、貴族の俺がなんでこんな所に。"
msgstr "可恶，本大爷明明是贵族，为什么会在这种地方。"

#. ID 11, Page 1, Line 3, Pos (25,8)
msgid ""
"帝国民の資格をもたねえってだけで\n"
"放り込まれたぜ。"
msgstr "只是因为没有帝国民的资格就被扔进来了。"

#. ID 12, Page 1, Line 3, Pos (21,8)
msgid "くそっ、しくじったぜ。"
msgstr "可恶，失手了。"

#. ID 13, Page 1, Line 3, Pos (17,8)
msgid "へっへ…\\!出してくれねえかね。嬢ちゃん"
msgstr "嘿嘿……\\!能不能放我出去啊，小姑娘。"

#. ID 14, Page 1, Line 3, Pos (13,8)
msgid ""
"税金が支払えなくて放り込まれました。\n"
"\\!ああ、妻や娘はどうなったのか…\n"
"奥に連れて行かれたっきりだよ。"
msgstr ""
"因为付不起税被扔进来了。\\!啊啊，\n"
"我的妻子和女儿怎么样了……\n"
"被带到里面去之后就再没消息了。"

#. ID 16, Page 1, Line 3, Pos (4,17)
msgid "囚人への過剰な接触は禁止です。"
msgstr "禁止与囚犯过度接触。"

#. ID 31, Page 1, Line 3, Pos (20,17)
msgid ""
"ああ…ボクに会いに来て下さったんですね\n"
"やはり貴女はボクの事が…。"
msgstr "啊啊……您是来见我的吧，果然您对我……。"

#. ID 32, Page 1, Line 6, Pos (15,24)
msgid "\\n[\\v[6]]は牢の前に人の気配を感じた。"
msgstr "\\n[\\v[6]]感觉到牢房前有人的气息。"

#. ID 32, Page 1, Line 10, Pos (15,24)
msgid ""
"「こいつが俺の下僕か　\n"
"おいっ　お前こっちに来て顔を見せろ！」"
msgstr ""
"「这家伙就是我的仆人吗　喂　你给我过来露个脸！\n"
"」"

#. ID 32, Page 1, Line 17, Pos (15,24)
msgid ""
"「…ほぉ　これは拾いものだったな\n"
"しっかりサポートしてくれよ、夜の生活もな…」"
msgstr ""
"「……哦　这还真是捡到宝了啊，要好好支持我哦，\n"
"夜生活也是……」"

#. ID 32, Page 1, Line 29, Pos (15,24)
msgid ""
"「ほら、これに着替えな。\n"
"ご主人さま直々に選んでやった装備だ。\n"
"感謝するんだぞ」"
msgstr ""
"「喂，换上这个。这是主人亲自为你挑选的装备。\n"
"要感谢哦。」"

#. ID 32, Page 1, Line 37, Pos (15,24)
msgid "「…なんだと！　その妙な服は脱げないってのか？」"
msgstr "「……什么！　那件奇怪的衣服脱不下来吗？」"

#. ID 32, Page 1, Line 38, Pos (15,24)
msgid ""
"(ラバースーツで全身のラインがくっきり浮き出た\n"
"\\n[\\v[6]]の黒光りした身体を見る…\n"
"相手の目が落胆から好奇のそれに変わっていく)"
msgstr ""
"(穿着橡胶紧身衣，全身线条清晰地凸显出来，\n"
"看着\\n[\\v[6]]那泛着黑光的身体……\n"
"对方的眼神从失望变成了好奇)"

#. ID 32, Page 1, Line 41, Pos (15,24)
msgid "「…まぁいいかそれはそれでエロイし」"
msgstr "「……算了，那样也挺色情的。」"

#. ID 32, Page 1, Line 50, Pos (15,24)
msgid ""
"「それじゃあ明日からの冒険に備えて\n"
"宿屋で英気を養うとするか。\n"
"下僕の\\n[\\v[6]]、ご主人様に首輪の鎖を差し出せ！」"
msgstr ""
"「那么，为准备明天的冒险，就在旅馆养精蓄锐吧。\n"
"仆人的\\n[\\v[6]]，把项圈上的锁链献给主人！」"

#. ID 32, Page 1, Line 58, Pos (15,24)
msgid "「ほら行くぞ」"
msgstr "「喂，走了。」"

#. ID 32, Page 1, Line 66, Pos (15,24)
msgid ""
"【\\N[\\V[6]]】\n"
"「きゃあ！！！\n"
"　\\!鎖を引っ張らないでください！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「呀啊！！！　\\!请不要拉锁链！"

#. ID 32, Page 1, Line 76, Pos (15,24)
msgid ""
"【\\N[\\V[6]]】\n"
"「カハァ！……痛い………\n"
"　鎖で首が絞まるんです！\n"
"　放してください！！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「咳哈！……好痛………\n"
"　锁链勒住脖子了！　请放开我！！"

#. ID 32, Page 1, Line 107, Pos (15,24)
msgid ""
"【\\N[\\V[6]]】\n"
"「い、嫌　鎖を引っ張られたまま外に出るなんて！」"
msgstr ""
"【\\N[\\V[6]]】「不、\n"
"不要　居然要被人拉着锁链到外面去！"

#. ID 32, Page 1, Line 125, Pos (15,24)
msgid ""
"【\\N[\\V[6]]】\n"
"「嫌ぁぁぁ！！！！！！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「不要啊啊啊！！！！！！"
