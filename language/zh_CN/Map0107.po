#. ID 14, Page 2, Line 3, Pos (9,4)
msgid "パワーロングソードを手に入れた。"
msgstr "获得了强力长剑。"

#. ID 21, Page 2, Line 3, Pos (11,9)
msgid "ソウルポット４を手に入れた。"
msgstr "获得了灵魂壶4。"

#. ID 22, Page 2, Line 3, Pos (3,2)
msgid ""
"巨大な鉄塊だ…\n"
"こんなものを持ち運べば\n"
"まともに歩くのも難しいだろう…"
msgstr ""
"是巨大的铁块……带着这种东西走的话，\n"
"连正常行走都会很困难吧……"

#. ID 22, Page 2, Line 6, Pos (3,2)
#. Contains choice at line 2 (2 options)
msgid "鉄塊を持っていきますか？"
msgstr "要带走铁块吗？"

#. ID 22, Page 2, Line 7, Pos (3,2)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 22, Page 2, Line 9, Pos (3,2)
msgid "鉄塊を手に入れた。"
msgstr "获得了铁块。"
