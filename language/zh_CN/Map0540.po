#. ID 29, Page 2, Line 3, Pos (7,25)
msgid "ほら、緊張しないで飲んで飲んで…"
msgstr "来，别紧张，喝吧喝吧…"

#. ID 31, Page 2, Line 3, Pos (31,28)
msgid "…\\!酷いセクハラ親父ね"
msgstr "…\\!真是过分的性骚扰大叔呢"

#. ID 32, Page 2, Line 3, Pos (29,18)
msgid "お兄さんはこのお店初めて？"
msgstr "大哥哥是第一次来这家店吗？"

#. ID 33, Page 2, Line 3, Pos (29,8)
msgid "ねえ～\\!私そろそろ誕生日が近いのよ～"
msgstr "呐～\\!我的生日也快到了哦～"

#. ID 34, Page 2, Line 3, Pos (31,8)
msgid "私も近いんだ～"
msgstr "我的也快到了～"

#. ID 35, Page 2, Line 3, Pos (31,18)
msgid "ウフフ…\\!ほら、そんな緊張しないで…"
msgstr "呵呵…\\!来，别那么紧张…"

#. ID 36, Page 2, Line 3, Pos (29,28)
msgid "や…止めてください…"
msgstr "呀…请停下…"

#. ID 37, Page 1, Line 3, Pos (11,18)
msgid "そんなにじろじろ見て…\\!気になる？"
msgstr "那么直勾勾地盯着看…\\!在意吗？"

#. ID 37, Page 1, Line 4, Pos (11,18)
msgid "おっぱい、おっぱい！"
msgstr "奶子、奶子！"

#. ID 38, Page 1, Line 3, Pos (20,19)
msgid "聖職者がこんな所に来ていいんですか？"
msgstr "圣职者可以来这种地方吗？"

#. ID 38, Page 1, Line 4, Pos (20,19)
msgid ""
"厳しい修行の毎日だからたまにはここで\n"
"息抜きしないとやっていけないんだよ\n"
"わかってくれ"
msgstr ""
"每天都是严格的修行，\n"
"偶尔不在这里喘口气就撑不下去啊，你理解一下"

#. ID 39, Page 2, Line 3, Pos (6,7)
msgid ""
"騎士団の部隊長さんって給料いいんでしょ\n"
"憧れるなあ。"
msgstr "骑士团的部队长薪水很不错吧，真让人憧憬啊。"

#. ID 39, Page 2, Line 5, Pos (6,7)
msgid ""
"そうだよねえ～\\!だからこの\n"
"お酒割と高いけどあけちゃってもいいよね"
msgstr "是吧～\\!所以这酒虽然比较贵，但打开它也没关系吧"

#. ID 39, Page 2, Line 7, Pos (6,7)
msgid ""
"いや…それほどでも…\\!ないからさ…\n"
"頼むからちょっとは手加減してくれ…"
msgstr ""
"不…也没那么…\\!没有那么多啦…求你了，\n"
"稍微手下留情吧…"

#. ID 40, Page 2, Line 3, Pos (6,15)
msgid ""
"出来ればこういう店で働く前のキミに\n"
"会いたかったよ…"
msgstr "可以的话，我想在你在这种店工作之前遇见你…"

#. ID 40, Page 2, Line 5, Pos (6,15)
msgid "ヤダー\\!それって口説いてるの？"
msgstr "讨厌啦\\!那是在泡我吗？"

#. ID 40, Page 2, Line 6, Pos (6,15)
msgid "真剣なんだよ。ボクは…！"
msgstr "我是认真的。我啊…！"

#. ID 40, Page 2, Line 7, Pos (6,15)
msgid ""
"だったらあ…\\!私欲しい宝石があるんだー\n"
"本気ならプレゼントしてくれるよね～"
msgstr ""
"那样的话…\\!我有个想要的宝石——如果是认真的，\n"
"你会送给我吧～"

#. ID 41, Page 2, Line 3, Pos (6,25)
msgid ""
"おお、おぼっこいのお…\n"
"新人さんかい？"
msgstr "哦哦，小姑娘啊…是新来的吗？"

#. ID 41, Page 2, Line 5, Pos (6,25)
msgid "は…はい…\\!よろしくお願いします"
msgstr "是…是的…\\!请多关照"

#. ID 41, Page 2, Line 6, Pos (6,25)
msgid ""
"ほッほッほッ、いいのお、\n"
"こういう初々しさも。"
msgstr "嚯、嚯、嚯，不错哦，这种青涩感也不错。"

#. ID 42, Page 2, Line 3, Pos (6,33)
msgid "いつもいつも御指名ありがとうございます"
msgstr "感谢您总是指名我"

#. ID 42, Page 2, Line 4, Pos (6,33)
msgid ""
"そうなんだよなあ…\\!キミといると安心\n"
"できるというか…\n"
"\\!キミたちにしてみればしてやったりって\n"
"所かな…？"
msgstr ""
"是啊…\\!和你在一起让人安心，该说是…\n"
"\\!在你们看来，或许正是得逞之处吧…？"

#. ID 42, Page 2, Line 8, Pos (6,33)
msgid ""
"いえそんな…\\!私だって…その…\n"
"\\!ねえ…\\!お客様…私…"
msgstr "不，哪有…\\!我也…那个…\\!呐…\\!客人…我…"

#. ID 42, Page 2, Line 10, Pos (6,33)
msgid "？…なんだい？"
msgstr "？…怎么了？"

#. ID 42, Page 2, Line 11, Pos (6,33)
msgid "私も…\\!その…"
msgstr "我也…\\!那个…"

#. ID 42, Page 2, Line 12, Pos (6,33)
msgid "これ以上は立ち入らないほうが良さそうだ"
msgstr "再往下还是不要深入为好"

#. ID 43, Page 2, Line 3, Pos (30,28)
msgid "ええのんか～\\!ここがええのんか～？"
msgstr "可以吗～\\!这里可以吗～？"

#. ID 44, Page 2, Line 3, Pos (30,18)
msgid "あ…あの…\\!そ…その…"
msgstr "啊…那个…\\!那…那个…"

#. ID 45, Page 2, Line 3, Pos (30,8)
msgid "いいよ。\\!何でもプレゼントしてあげるよ"
msgstr "好啊。\\!我什么都会送给你哦"

#. ID 46, Page 1, Line 3, Pos (11,12)
msgid "ねえ…\\!今度の休みデートしない？"
msgstr "呐…\\!下次休息日要不要约会？"

#. ID 46, Page 1, Line 4, Pos (11,12)
msgid "ええ～？\\!どうしよっかなあ～"
msgstr "诶～？\\!怎么办好呢～"

#. ID 47, Page 1, Line 3, Pos (16,12)
msgid "フフフ、面白い人ですね～"
msgstr "呵呵呵，真是有趣的人呢～"

#. ID 47, Page 1, Line 4, Pos (16,12)
msgid "わかる？、だからさ～"
msgstr "懂吗？、所以说嘛～"

#. ID 48, Page 1, Line 3, Pos (16,18)
msgid "………\\!チェンジ………"
msgstr "………\\!交换………"

#. ID 48, Page 1, Line 4, Pos (16,18)
msgid "なにさ、失礼な客ね"
msgstr "什么嘛，真是失礼的客人呢"

#. ID 49, Page 1, Line 3, Pos (20,12)
msgid "お隣さん、大変そうね。"
msgstr "邻居，看起来真辛苦呢。"

#. ID 49, Page 1, Line 4, Pos (20,12)
msgid ""
"ああ、つれてきて悪いことしたなあ。\n"
"ま、こっちはこっちで楽しもうぜ。"
msgstr ""
"啊啊，把你带来真是抱歉啊。算了，这边就这边，\n"
"我们好好享受吧。"

#. ID 50, Page 1, Line 3, Pos (24,12)
msgid "拙者…\\!女人は…"
msgstr "在下…\\!女人是…"

#. ID 50, Page 1, Line 4, Pos (24,12)
msgid ""
"あらあら、こんなに緊張しちゃって\n"
"可愛い。"
msgstr "哎呀哎呀，这么紧张真可爱。"

#. ID 51, Page 1, Line 3, Pos (24,19)
msgid ""
"この人お金もないのに過剰にセクハラして\n"
"くるんです！"
msgstr "这个人明明没有金钱，还过分地性骚扰！"

#. ID 52, Page 1, Line 3, Pos (7,3)
msgid "ここから先はVIPの方以外お断りで～す"
msgstr "这前面除VIP客人外谢绝入内～"

#. ID 55, Page 1, Line 3, Pos (13,7)
msgid ""
"いらっしゃいませ。\n"
"ごゆっくりどうぞ。"
msgstr "欢迎光临。请慢慢享受。"

#. ID 55, Page 2, Line 3, Pos (13,7)
msgid "お疲れさん"
msgstr "辛苦了"

#. ID 56, Page 1, Line 3, Pos (18,7)
#. Contains choice at line 2 (2 options)
msgid "…あんた…\\!ここで働きたいのかい？"
msgstr "…你…\\!想在这里工作吗？"

#. ID 56, Page 1, Line 4, Pos (18,7)
#. Choice (2 options, embedded in a message)
#. ID 56, Page 2, Line 4, Pos (18,7)
#. Choice (2 options, embedded in a message)
#. ID 56, Page 3, Line 4, Pos (18,7)
#. Choice (2 options, embedded in a message)
#. ID 56, Page 4, Line 4, Pos (18,7)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 56, Page 1, Line 6, Pos (18,7)
msgid ""
"よし、わかった。仕事内容はまあ見ての\n"
"とおりだ。\n"
"あんたは美人だし、十分だろ。\n"
"じゃあ、早速はじめてもらうぜ。"
msgstr ""
"好，知道了。工作内容嘛，就如你所见。你是美人，\n"
"足够了吧。那就马上开始吧。"

#. ID 56, Page 1, Line 10, Pos (18,7)
msgid ""
"衣装もまあ、そのままでもいいし\n"
"なんなら着替えてきてくれてもかまわない\n"
"裏に控え室があるからそこで着替えてくれ\n"
"色々と衣装も用意してあるしな。"
msgstr ""
"服装嘛，就这样也可以，或者你去换一下也没关系，\n"
"后面有等候室，你在那里换吧，\n"
"各种服装也都准备好了。"

#. ID 56, Page 1, Line 23, Pos (18,7)
msgid ""
"そうか、ま、\\!気が向いたら来いよ\n"
"いつでも大歓迎さ\n"
"おたくみたいな美人は特にな"
msgstr ""
"这样啊，嗯，\\!有兴趣就来吧，随时欢迎，\n"
"像你这样的美人尤其欢迎。"

#. ID 56, Page 2, Line 3, Pos (18,7)
#. Contains choice at line 2 (2 options)
msgid "お、また働いてくれるのかい？"
msgstr "哦，你又要来工作吗？"

#. ID 56, Page 2, Line 6, Pos (18,7)
msgid "そうか、それじゃあ頼むぜ"
msgstr "这样啊，那就拜托了。"

#. ID 56, Page 2, Line 15, Pos (18,7)
msgid "そうかい…\\!ま、気が向いたら頼むぜ"
msgstr "这样啊…\\!嗯，有兴趣的话就拜托了。"

#. ID 56, Page 3, Line 3, Pos (18,7)
#. Contains choice at line 2 (2 options)
msgid "へえ…あんた、ここで働きたいのかい？"
msgstr "哦…你，想在这里工作吗？"

#. ID 56, Page 3, Line 6, Pos (18,7)
msgid ""
"別にいいが…\n"
"ただ…\\!奴隷に普通のホステスやらす訳に\n"
"はいかねえな…\n"
"ウチの店の沽券にかかわる…"
msgstr ""
"倒也不是不行…只是…\n"
"\\!总不能奴隶去当普通陪酒女吧…\n"
"这关系到我们店的颜面…"

#. ID 56, Page 3, Line 10, Pos (18,7)
msgid ""
"そうだ…\\!ちょっと特別な仕事をやって\n"
"もらおうかね…何、ひょっとすりゃ\n"
"こっちの方が儲かるぜ。"
msgstr ""
"对了…\\!让你做点特别的工作吧…没什么，\n"
"搞不好这边更能赚钱。"

#. ID 56, Page 3, Line 13, Pos (18,7)
msgid ""
"それじゃあ控え室で準備してきな\n"
"いろいろ用意してあるぜ。"
msgstr "那就在等候室准备一下吧，各种东西都准备好了。"

#. ID 56, Page 3, Line 24, Pos (18,7)
msgid "フン、そうかい"
msgstr "哼，这样啊"

#. ID 56, Page 4, Line 3, Pos (18,7)
#. Contains choice at line 2 (2 options)
msgid "なんだあ？また働きたいのか？"
msgstr "什么啊？又想来工作吗？"

#. ID 56, Page 4, Line 6, Pos (18,7)
msgid "ヘッ！！大した淫乱奴隷だ！！"
msgstr "嘿！！真是个了不得的淫乱奴隶！！"

#. ID 56, Page 4, Line 15, Pos (18,7)
msgid ""
"じゃあ、とっとと消えろ\n"
"ここは奴隷が大きな面してのさばって\n"
"いい場所じゃねえんだよ！！"
msgstr ""
"那就赶紧滚吧，\n"
"这里可不是奴隶摆架子逞威风的地方！！"

#. ID 87, Page 1, Line 3, Pos (24,21)
msgid ""
"困りますなあ…お客様…\n"
"ちょっと裏にきてもらえますか…"
msgstr "这可不好办啊…客人…能请您到后面来一下吗…"

#. ID 91, Page 1, Line 4, Pos (1,0)
msgid ""
"おいおいどこのペットだ？\n"
"\\!ここは人間様専用なんだ\n"
"ほら、追い出しとけ"
msgstr ""
"喂喂，这是哪来的宠物？\\!这里是人类大人专用的，\n"
"来，把它赶出去。"

#. ID 92, Page 1, Line 3, Pos (17,2)
msgid "ここは関係者以外立ち入り禁止だ"
msgstr "这里除相关人员外禁止入内"

#. ID 92, Page 2, Line 4, Pos (17,2)
msgid ""
"今日はもう帰りな。\n"
"休まないと体が持たないぜ。"
msgstr "今天先回去吧。不休息身体会撑不住的。"

#. ID 92, Page 2, Line 9, Pos (17,2)
msgid "ほら、さっそく御指名だぜ。"
msgstr "来，马上就有指名了。"

#. ID 92, Page 3, Line 3, Pos (17,2)
msgid ""
"来たな…\\!ほらお客様がお待ちだ\n"
"VIPだからな。しっかりやれよ"
msgstr "来了啊…\\!来，客人在等着呢，是VIP哦。好好干。"

#. ID 92, Page 3, Line 12, Pos (17,2)
msgid ""
"ここはウチの店のVIP用の特別室なの\n"
"ここではホステスにどんなことをしても\n"
"いいの。\\!ここにあてがわれるホステスは\n"
"全員奴隷だから何をしてもOK"
msgstr ""
"这里是我们店的VIP专用特别室，\n"
"在这里可以对陪酒女做任何事。\n"
"\\!被安排到这里的陪酒女全都是奴隶，\n"
"所以做什么都OK"

#. ID 92, Page 3, Line 16, Pos (17,2)
msgid ""
"ほら、可愛がられてらっしゃいな。\n"
"しっかりとノルマ分働かなければ許さない\n"
"わよ。"
msgstr ""
"来，去好好被疼爱吧。\n"
"不认真完成指标可不会饶你哦。"

#. ID 93, Page 1, Line 3, Pos (15,24)
msgid "お客様を放ってどこへいく？"
msgstr "把客人丢下要去哪？"

#. ID 94, Page 1, Line 5, Pos (15,26)
msgid ""
"おお、これは可愛い娘だ。\n"
"これからよろしくな。"
msgstr "哦哦，真是个可爱的姑娘。今后请多关照。"

#. ID 94, Page 1, Line 9, Pos (15,26)
msgid "やあ、またきたよ。"
msgstr "呀，我又来了。"

#. ID 94, Page 1, Line 12, Pos (15,26)
msgid "お客様と楽しくお話した…"
msgstr "和客人愉快地聊了天…"

#. ID 94, Page 1, Line 24, Pos (15,26)
#. ID 94, Page 1, Line 31, Pos (15,26)
#. ID 94, Page 1, Line 38, Pos (15,26)
#. ID 94, Page 1, Line 45, Pos (15,26)
msgid ""
"これ、君にプレゼントだよ。\n"
"いつも楽しませてもらってるからね。"
msgstr "这个，送给你的礼物。因为你总是让我很开心。"

#. ID 94, Page 1, Line 27, Pos (15,26)
msgid "イヤリングを貰った"
msgstr "收到了耳环"

#. ID 94, Page 1, Line 34, Pos (15,26)
msgid "指輪を貰った。"
msgstr "收到了戒指。"

#. ID 94, Page 1, Line 41, Pos (15,26)
msgid "ペンダントを貰った。"
msgstr "收到了吊坠。"

#. ID 94, Page 1, Line 48, Pos (15,26)
msgid "金塊を貰った。"
msgstr "收到了金块。"

#. ID 94, Page 1, Line 51, Pos (15,26)
msgid "それじゃあまたくるよ…"
msgstr "那就再见了…"

#. ID 94, Page 1, Line 55, Pos (15,26)
msgid "え…どうしたんだい？"
msgstr "诶…怎么了？"

#. ID 94, Page 1, Line 57, Pos (15,26)
msgid ""
"…いつも…\\!御贔屓に…\n"
"\\!してもらっている…\\!お礼です\n"
"…\\!私のおうちに…\\!きませんか…？"
msgstr ""
"…总是…\\!承蒙您…\\!关照…\\!这是谢礼…\\!要不要…\n"
"\\!来我家…？"

#. ID 94, Page 1, Line 60, Pos (15,26)
msgid ""
"え…それは…\n"
"\\!わかった。それじゃあいこうか…"
msgstr "诶…那…\\!知道了。那就去吧…"

#. ID 94, Page 1, Line 62, Pos (15,26)
msgid ""
"店長から今日の分の給料を貰い\n"
"そのまま男と自宅に帰った…"
msgstr ""
"从店长那里领了今天的工资，\n"
"就那样和男人回了自己家…"

#. ID 94, Page 1, Line 87, Pos (15,26)
msgid "フフフ…\\!それじゃあいくよ…"
msgstr "呵呵呵…\\!那就来哦…"

#. ID 94, Page 1, Line 88, Pos (15,26)
msgid "はい…\\!気持ちよくしてください…"
msgstr "是…\\!请让我舒服…"

#. ID 94, Page 1, Line 95, Pos (15,26)
msgid ""
"どうだい？\\!\n"
"もっと気持ちよくしてあげようか？"
msgstr "怎么样？\\!要让你更舒服吗？"

#. ID 94, Page 1, Line 97, Pos (15,26)
msgid ""
"はい…\\!お願いします\n"
"もっともっと可愛がってください…"
msgstr "是…\\!拜托了，请更多地疼爱我…"

#. ID 94, Page 1, Line 106, Pos (15,26)
msgid ""
"それじゃあ、こんどはこっちをよくして\n"
"もらおうか。\n"
"ほら、じゃぶってよ"
msgstr "那么，这次就好好弄弄这边吧。来，给我口吧"

#. ID 94, Page 1, Line 109, Pos (15,26)
msgid "はい、どうぞ私の淫らな口をお使いください"
msgstr "是，请使用我淫荡的嘴吧"

#. ID 94, Page 1, Line 112, Pos (15,26)
msgid ""
"それじゃあ、こんどはこっちをよくして\n"
"もらおうか。\n"
"ほら、挿入れるよ"
msgstr "那么，这次就好好弄弄这边吧。来，要插入了哦"

#. ID 94, Page 1, Line 115, Pos (15,26)
msgid "はい、どうぞ私の雌壷をお使いください"
msgstr "是，请使用我的雌壶吧"

#. ID 94, Page 1, Line 123, Pos (15,26)
msgid ""
"う…凄いな…\\!なんて舌だ…\n"
"ほら、動くよ…"
msgstr "唔…真厉害…\\!多棒的舌头…来，我动了哦…"

#. ID 94, Page 1, Line 127, Pos (15,26)
msgid ""
"う…凄いな…\\!なんて名器だ…\n"
"ほら、動くよ…"
msgstr "唔…真厉害…\\!真是名器…来，我动了哦…"

#. ID 94, Page 1, Line 141, Pos (15,26)
msgid "ほら…\\!だ…だすぞ！！"
msgstr "来…\\!要…要射了！！"

#. ID 94, Page 1, Line 143, Pos (15,26)
msgid ""
"はひ…\n"
"\\[6]ハグッ…ンムッ…レルッ…レロォ"
msgstr "哈嘻…\\[6]哈咕…唔呣…舔…舔咧"

#. ID 94, Page 1, Line 147, Pos (15,26)
msgid "は…はい…\\!いっぱい注いでください！！"
msgstr "哈…是…\\!请多多注入！！"

#. ID 94, Page 1, Line 164, Pos (15,26)
msgid "それじゃあ…\\!綺麗にしてあげますね…"
msgstr "那么…\\!我帮您弄干净哦…"

#. ID 94, Page 1, Line 170, Pos (15,26)
msgid "フフフ、それじゃあまたお店にいくからね"
msgstr "呵呵呵，那我还会再去店里的。"

#. ID 94, Page 1, Line 201, Pos (15,26)
msgid ""
"え…送ってくれるって？\n"
"そいつはうれしいな\n"
"それじゃあいこうか…"
msgstr "诶…你说要送我？那可真高兴，那就走吧…"

#. ID 94, Page 1, Line 204, Pos (15,26)
msgid ""
"店長から本日分の給料を貰い\n"
"男と一緒に店を出た。"
msgstr "从店长那里领了今天的工资，和男人一起出了店。"

#. ID 94, Page 1, Line 222, Pos (15,26)
msgid "ハァ…ハァ…\\!ほ…本当にいいのかい？"
msgstr "哈啊…哈啊…\\!真…真的可以吗？"

#. ID 94, Page 1, Line 224, Pos (15,26)
msgid ""
"はい…\\!いつも…よくしてもらっている\n"
"お礼です…"
msgstr "是…\\!这是对您总是…关照我的谢礼…"

#. ID 94, Page 1, Line 240, Pos (15,26)
msgid ""
"こうやって外でやるというのも\n"
"いいものだな…"
msgstr "像这样在外面做也别有一番滋味啊…"

#. ID 94, Page 1, Line 249, Pos (15,26)
msgid ""
"はは、凄い乱れようだ\n"
"やっぱり外だと興奮するのかい？\n"
"酷く淫乱な娘だな…"
msgstr ""
"哈哈，乱得真厉害，果然在外面就会兴奋吗？\n"
"真是个非常淫乱的姑娘…"

#. ID 94, Page 1, Line 252, Pos (15,26)
msgid ""
"はい…\\!\\n[\\v[6]]は\n"
"外でえっちされて興奮する\n"
"淫乱な娘です\n"
"もっとお情けをください…"
msgstr ""
"是…\n"
"\\!\\n[\\v[6]]是在外面被做爱就会兴奋的淫乱姑娘，\n"
"请再多给些怜爱…"

#. ID 94, Page 1, Line 262, Pos (15,26)
msgid ""
"フフ、ずいぶんと具合もよくなったし\n"
"\\!それじゃあ入れてあげるよ！"
msgstr "呵呵，已经相当进入状态了！那我就插进去吧！"

#. ID 94, Page 1, Line 273, Pos (15,26)
msgid "ほ…\\!ほら…\\!出すぞ！！"
msgstr "要…\\!来了…\\!要射了！！"

#. ID 94, Page 1, Line 287, Pos (15,26)
msgid ""
"フフ、よかったよ…\n"
"\\!それじゃあまたお店でね…"
msgstr "呵呵，太好了…\\!那就下次店里见哦…"

#. ID 94, Page 1, Line 330, Pos (15,26)
msgid ""
"ご苦労さん\n"
"ほら、今日の報酬だ"
msgstr "辛苦了，来，今天的报酬。"

#. ID 94, Page 1, Line 336, Pos (15,26)
#. ID 94, Page 2, Line 94, Pos (15,26)
msgid "\\v[1201]Ｇをもらった"
msgstr "获得了\\v[1201]G"

#. ID 94, Page 1, Line 337, Pos (15,26)
msgid "それじゃあまた頼むよ"
msgstr "那就下次再拜托了。"

#. ID 94, Page 2, Line 4, Pos (15,26)
msgid ""
"ヒョヒョヒョ…\n"
"\\!えらい別嬪さんが来てくれたわい\n"
"それじゃあ今日はたのしみましょか"
msgstr ""
"嘻嘻嘻…\\!来了个了不起的美人啊，\n"
"那么今天就好好享受吧"

#. ID 94, Page 2, Line 13, Pos (15,26)
msgid ""
"このお客様はやたらいやらしい視線で\n"
"こちらを舐めまわしてくる…\n"
"\\!まあこういう店だから仕方ないかもしれ\n"
"ないが…\\!それにしても少しいき過ぎだ…"
msgstr ""
"这位客人用格外下流的视线在我身上来回打量…\n"
"\\!不过在这种店里或许也没办法…\n"
"\\!即便如此也未免有些过分了…"

#. ID 94, Page 2, Line 17, Pos (15,26)
msgid "ヘッヘッへ…\\!可愛らしい娘やな…"
msgstr "嘿嘿嘿…\\!真是个可爱的姑娘啊…"

#. ID 94, Page 2, Line 18, Pos (15,26)
msgid "そういうとお客様は突然抱きついてきた"
msgstr "说着，客人突然抱了上来"

#. ID 94, Page 2, Line 19, Pos (15,26)
msgid ""
"う～ん、いい匂いだ…\n"
"それに素晴らしいおっぱいでんな\n"
"\\!たまらんわい！"
msgstr "嗯～，好香啊…而且这对奶子真棒啊\\!受不了啦！"

#. ID 94, Page 2, Line 27, Pos (15,26)
msgid ""
"服の上から乳首を弄んでくる…\n"
"\\!さすがに抗議の声を上げようとすると…\n"
"\\!唇を塞がれてしまった…"
msgstr ""
"隔着衣服玩弄起我的乳头…\\!我正想开口抗议…\n"
"\\!嘴唇就被堵住了…"

#. ID 94, Page 2, Line 49, Pos (15,26)
msgid ""
"ぷは～\\!フフ、ワシのキスはどうだった？\n"
"ほら、ほら、もっとコミュニケーションを\n"
"とったろうや…"
msgstr ""
"噗哈～\\!呵呵，我的吻怎么样？来，来，\n"
"再多交流交流嘛…"

#. ID 94, Page 2, Line 59, Pos (15,26)
msgid ""
"フフフ、すっかり出来上がって…\n"
"どうや…？これから二人でどこかに…"
msgstr ""
"呵呵呵，已经完全来兴致了啊…怎么样…？\n"
"接下来两个人去某个地方…"

#. ID 94, Page 2, Line 62, Pos (15,26)
msgid "お客様…"
msgstr "客人…"

#. ID 94, Page 2, Line 63, Pos (15,26)
msgid ""
"なんや…\\!ええとこやのに…\n"
"邪魔するなや"
msgstr "搞什么…\\!明明正到好处…别来打扰啊"

#. ID 94, Page 2, Line 65, Pos (15,26)
msgid ""
"当ホステスへの過剰な接触は厳禁でござい\n"
"ます…\n"
"ちょっと事務所へ…"
msgstr ""
"严禁对本店女招待有过度的接触…\n"
"请跟我去一趟事务所…"

#. ID 94, Page 2, Line 68, Pos (15,26)
msgid "…………\\!また…くるからな…"
msgstr "…………\\!我还会…再来的…"

#. ID 94, Page 2, Line 86, Pos (15,26)
msgid ""
"まあ、災難だったな。\n"
"まあ…懲りずにまた来てくれよな\n"
"ほら、報酬だ。\n"
"ちょっと多めにしといた。"
msgstr ""
"嘛，真是倒霉啊。算了…别因为这次就不来了，\n"
"下次再来吧。喏，报酬。我稍微多给了一些。"

#. ID 94, Page 2, Line 95, Pos (15,26)
msgid "それじゃあな。"
msgstr "那就这样吧。"

#. ID 96, Page 1, Line 3, Pos (15,33)
msgid "この店で用心棒をやってます…"
msgstr "我在这家店里当保镖…"

#. ID 96, Page 2, Line 3, Pos (15,33)
msgid ""
"とんでもないセクハラしてくるお客様が\n"
"いたら、ワシを呼びな\n"
"\\!成敗してくれるわい！"
msgstr ""
"要是有客人做出过分的性骚扰，\n"
"就叫我来\\!我会替天行道收拾他！"
