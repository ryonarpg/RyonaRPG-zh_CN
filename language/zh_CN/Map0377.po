#. ID 2, Page 2, Line 3, Pos (13,5)
msgid ""
"………魔王がいなくなってからは、\n"
"スライムに出番を取られてしまって………"
msgstr ""
"………自从魔王消失之后，出场机会就被史莱姆抢走了…\n"
"……"

#. ID 2, Page 2, Line 10, Pos (13,5)
#. Contains choice at line 2 (3 options)
msgid "…あら、貴方は私の仲間になってくれたのね。"
msgstr "…哎呀，你成了我的同伴呢。"

#. ID 2, Page 2, Line 11, Pos (13,5)
#. Choice (3 options, embedded in a message)
msgid ""
"スライムより貴女の方が好きだ\n"
"好きでこうなったんじゃない\n"
"元の体に戻して下さい！"
msgstr ""
"比起史莱姆，我更喜欢你\n"
"不是因为喜欢才变成这样的\n"
"请把我变回原来的样子！"

#. ID 2, Page 2, Line 13, Pos (13,5)
msgid "…うふふっ、ありがと♪"
msgstr "…呵呵，谢谢♪"

#. ID 2, Page 2, Line 20, Pos (13,5)
msgid "…キスされてしまった。"
msgstr "…被亲了。"

#. ID 2, Page 2, Line 25, Pos (13,5)
msgid "あらあら、随分と嫌われたものね。"
msgstr "哎呀哎呀，相当被讨厌了呢。"

#. ID 2, Page 2, Line 28, Pos (13,5)
#. Contains choice at line 3 (2 options)
msgid ""
"やっと仲間に会えたのに、\n"
"…貴女もここから去ってしまうの？"
msgstr "好不容易才遇到同伴，…你也要离开这里吗？"

#. ID 2, Page 2, Line 30, Pos (13,5)
#. Choice (2 options, embedded in a message)
msgid ""
"……このままでもいいかな。\n"
"仲間になった覚えは無い。"
msgstr ""
"……就这样也可以吧。\n"
"我不记得自己成了同伴。"

#. ID 2, Page 2, Line 32, Pos (13,5)
msgid "…うふっ、よかった♪"
msgstr "…呵呵，太好了♪"

#. ID 2, Page 2, Line 35, Pos (13,5)
msgid "……そう、そんなに戻りたいなら戻してあげるわ。"
msgstr "……是啊，既然那么想回去，那就让你回去吧。"

#. ID 2, Page 2, Line 37, Pos (13,5)
msgid ""
"あら……この貞操帯ちょっと変ね。\n"
"これがあるんじゃ貴女を元には戻せないわ。"
msgstr ""
"哎呀……这条贞操带有点奇怪呢。有这个的话，\n"
"就没法把你变回原样了。"

#. ID 2, Page 2, Line 53, Pos (13,5)
msgid "突然、彼女の蔦が\\n[\\v[6]]の体に巻きついてきた！"
msgstr "突然，她的藤蔓缠上了\\n[\\v[6]]的身体！"

#. ID 2, Page 2, Line 67, Pos (13,5)
msgid ""
"下半身に巻きついた蔦が強引に足を押し開くと、\n"
"彼女は膣に添えた手を一気にねじ込んでしまった！"
msgstr ""
"缠在下半身的藤蔓强行掰开双腿，\n"
"她把手贴在阴道上，一口气拧了进去！"

#. ID 2, Page 2, Line 99, Pos (13,5)
msgid ""
"膣の奥深く子宮にまでねじ込んだ手に\n"
"何かをつかまれる感覚がしたかと思うと、\n"
"一気に引き抜かれてしまった！！"
msgstr ""
"感觉伸进阴道深处甚至子宫里的手抓住了什么东西，\n"
"紧接着就被一口气拔了出来！！"

#. ID 2, Page 2, Line 118, Pos (13,5)
msgid "\\.…………。"
msgstr "\\.…………。"

#. ID 2, Page 2, Line 123, Pos (13,5)
msgid "次からは魔物には十分気をつけることね。"
msgstr "下次要十分小心魔物哦。"

#. ID 2, Page 2, Line 128, Pos (13,5)
msgid "所詮互いに相容れることなど無いのだから……"
msgstr "反正彼此之间根本不可能相容……"

#. ID 2, Page 2, Line 133, Pos (13,5)
msgid ""
"引き抜いた手には大きな枯れた種子のようなものが\n"
"握られている。"
msgstr "拔出来的手里握着一个像巨大干枯种子一样的东西。"

#. ID 2, Page 2, Line 139, Pos (13,5)
msgid "それを見つめる彼女の目はどこか悲しそうだ………"
msgstr "她凝视着那东西的眼睛，不知为何显得有些悲伤………"

#. ID 2, Page 2, Line 148, Pos (13,5)
msgid ""
"…はぁっ、つまらないわ～\n"
"ねぇ、あなた私の仲間にならない？"
msgstr "…哈啊，真无聊啊～喂，你要不要成为我的伙伴？"

#. ID 3, Page 1, Line 3, Pos (3,10)
msgid ""
"あああっんんぅ……\n"
"あああうぁぁぁぁぁっんんん…\n"
"ああうぁぁぁぁぁぁぁぁっ～……"
msgstr ""
"啊啊啊嗯嗯唔……啊啊啊呜啊啊啊啊啊嗯嗯嗯…\n"
"啊啊呜啊啊啊啊啊啊啊啊～……"

#. ID 3, Page 1, Line 17, Pos (3,10)
msgid ""
"う…うううぉぉぉぉ！！！！！\n"
"お　おな…が　裂…け……\n"
"…お…おおおおぉぉぉぉぉぉ………！！！！！！"
msgstr ""
"呜…呜呜呜哦哦哦哦！！！！！肚、肚子…要裂…开了…\n"
"……呜…呜呜呜呜哦哦哦哦哦哦………！！！！！！"

#. ID 3, Page 1, Line 46, Pos (3,10)
msgid ""
"んんんがががぁぁぁ！！！！\n"
"…ぎぁぁぁぁんんがあぁぁぁぁぁぁぁ！！！\n"
"おおおおぉぉぉぉ！！！！！"
msgstr ""
"嗯嗯嗯嘎嘎嘎啊啊啊！！！！…\n"
"嘎啊啊啊啊嗯嗯嘎啊啊啊啊啊啊啊！！！\n"
"哦哦哦哦哦哦哦！！！！！"

#. ID 5, Page 1, Line 3, Pos (9,8)
msgid ""
"召喚されたんですが……\n"
"孕ませてくださいと言われまして。"
msgstr "我被召唤出来了……然后被要求「请让我怀孕」。"

#. ID 17, Page 1, Line 3, Pos (17,9)
msgid ""
"んぐ……\n"
"から　だぁ…　いうこと　きか…な"
msgstr "嗯咕……身、身体…不听话…"

#. ID 17, Page 1, Line 16, Pos (17,9)
msgid ""
"う…うううぉぉぉぉ！！！！！\n"
"も　もうだ……めぇ！！！\n"
"…お…おおおおぉぉぉぉぉぉ………！！！！！！"
msgstr ""
"呜…呜呜呜哦哦哦哦！！！！！已、已经不行了……\n"
"不行了！！！…呜…呜呜呜呜哦哦哦哦哦哦………！！！\n"
"！！！"

#. ID 17, Page 1, Line 31, Pos (17,9)
msgid ""
"んんんがががぁぁぁ！！！！\n"
"おなかのな……があああああああ！！！\n"
"われる　われぢゃううううううううう！！！"
msgstr ""
"嗯嗯嗯嘎嘎嘎啊啊啊！！！！肚、肚子里面……\n"
"嘎啊啊啊啊啊啊！！！要裂了，\n"
"要裂开了啊啊啊啊啊啊啊啊！！！"

#. ID 29, Page 1, Line 3, Pos (6,6)
msgid ""
"んごおおおぉお\"おぉ\"ぉお\"\n"
"ああああ\"あ\"おおおぉおお\""
msgstr "嗯咕哦哦哦哦\"哦哦\"哦哦\"啊啊啊啊\"啊\"哦哦哦哦哦\""

#. ID 29, Page 1, Line 16, Pos (6,6)
msgid ""
"んごおおおお\"おぉ\"……ぉ\"！\n"
"でる\"う\"ぅ！！　なにがでぐうううう\"うっ！！\n"
msgstr ""
"嗯咕哦哦哦哦\"哦哦\"……哦\"！出来了\"呜\"呜！！\n"
"　有什么要出来了啊啊啊啊\"呜！！"

#. ID 29, Page 1, Line 45, Pos (6,6)
msgid "んごぉおおあああああああ\"ぁ\"ぁああああ\""
msgstr "嗯咕哦哦哦啊啊啊啊啊啊啊\"啊\"啊啊啊啊啊\""

#. ID 29, Page 2, Line 3, Pos (6,6)
msgid ""
"んぎぃあああ……もうやめでぇ……\n"
"も\"う孕まぜないえ\"ぇえ……\n"
"もう\"うみだぐないい\"おおぉ……"
msgstr ""
"嗯嘎啊啊啊……已经停下吧……别\"再让我怀孕了\"啊啊……\n"
"别\"再让我生出来了\"哦哦哦……"

#. ID 29, Page 2, Line 17, Pos (6,6)
msgid ""
"んご、おおおお\"おぉ\"……ぉ\"！\n"
"いや\"ぁ\"ッ！！ででぐうううう\"うっ！！\n"
"んあああ\"あ\"！！"
msgstr ""
"嗯咕、哦哦哦哦\"哦哦\"……哦\"！不要\"啊\"！！\n"
"要出来了啊啊啊啊\"呜！！嗯啊啊啊\"啊\"！！"

#. ID 29, Page 2, Line 46, Pos (6,6)
msgid "んぎぃぃ\"ぃいいい\"ぃい\"………！！！"
msgstr "嗯嘎咿\"咿啊啊啊\"咿呀\"………！！！"

#. ID 29, Page 3, Line 34, Pos (6,6)
msgid "んご……ぉ\"……ぉ\"………"
msgstr "嗯咕……哦\"……哦\"………"
