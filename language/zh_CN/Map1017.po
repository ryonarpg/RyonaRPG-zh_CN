#. ID 38, Page 2, Line 7, Pos (17,31)
msgid ""
"\n"
"　　　　　　　黄金の腕輪奪取成功！！"
msgstr "　　　　　　　黄金手镯夺取成功！！"

#. ID 38, Page 2, Line 9, Pos (17,31)
msgid ""
"手鏡と遠見の水晶玉は\n"
"音も無く崩れ去った……"
msgstr "手镜与远见水晶球无声无息地崩解消逝了……"

#. ID 73, Page 2, Line 20, Pos (84,12)
msgid ""
"黄金の爪を奪う者に、\n"
"災い、あれっ！"
msgstr "夺取黄金之爪者，灾祸，降临！"

#. ID 77, Page 1, Line 3, Pos (72,5)
msgid ""
"\n"
"　　　　　　100体撃破達成！！"
msgstr "　　　　　　100体击破达成！！"

#. ID 77, Page 1, Line 5, Pos (72,5)
#. Contains choice at line 2 (2 options)
#. ID 78, Page 1, Line 5, Pos (73,5)
#. Contains choice at line 2 (2 options)
#. ID 79, Page 1, Line 5, Pos (74,5)
#. Contains choice at line 2 (2 options)
#. ID 80, Page 1, Line 5, Pos (75,5)
#. Contains choice at line 2 (2 options)
msgid "このまま続けますか？"
msgstr "就这样继续吗？"

#. ID 77, Page 1, Line 6, Pos (72,5)
#. Choice (2 options, embedded in a message)
#. ID 78, Page 1, Line 6, Pos (73,5)
#. Choice (2 options, embedded in a message)
#. ID 79, Page 1, Line 6, Pos (74,5)
#. Choice (2 options, embedded in a message)
#. ID 80, Page 1, Line 6, Pos (75,5)
#. Choice (2 options, embedded in a message)
msgid ""
"もう…ダメ…\n"
"まだまだ！"
msgstr ""
"已经…不行了…\n"
"还差得远呢！"

#. ID 77, Page 1, Line 8, Pos (72,5)
#. ID 78, Page 1, Line 8, Pos (73,5)
#. ID 79, Page 1, Line 8, Pos (74,5)
#. ID 80, Page 1, Line 8, Pos (75,5)
msgid ""
"雲霞の如く押し寄せるミイラ達に耐えかね、\n"
"たまらず\\n[\\v[6]]は\n"
"黄金の爪を投げ捨てた！！"
msgstr ""
"抵挡不住如云霞般蜂拥而至的木乃伊们，\n"
"终于忍不住，\\n[\\v[6]]将黄金之爪扔掉了！！"

#. ID 77, Page 1, Line 11, Pos (72,5)
#. ID 78, Page 1, Line 11, Pos (73,5)
#. ID 79, Page 1, Line 11, Pos (74,5)
#. ID 80, Page 1, Line 11, Pos (75,5)
msgid ""
"奇妙な軌跡を描きながら飛んだ\n"
"黄金の爪は、ふわりと宝箱の中に\n"
"吸い込まれていった……"
msgstr ""
"描绘着奇妙轨迹飞出的黄金之爪，\n"
"轻飘飘地被吸入了宝箱之中……"

#. ID 78, Page 1, Line 3, Pos (73,5)
msgid ""
"\n"
"　　　　　　200体撃破達成！！"
msgstr "　　　　　　200体击破达成！！"

#. ID 79, Page 1, Line 3, Pos (74,5)
msgid ""
"\n"
"　　　　　　300体撃破達成！！"
msgstr "　　　　　　300体击破达成！！"

#. ID 80, Page 1, Line 3, Pos (75,5)
msgid ""
"\n"
"　　　　　　400体撃破達成！！"
msgstr "　　　　　　400体击破达成！！"

#. ID 81, Page 1, Line 7, Pos (76,5)
msgid ""
"\n"
"　　　　　　500体撃破達成！！"
msgstr "　　　　　　500体击破达成！！"

#. ID 81, Page 1, Line 9, Pos (76,5)
msgid ""
"\n"
"　　　　　　　黄金の爪奪取成功！！"
msgstr "　　　　　　　黄金之爪夺取成功！！"

#. ID 82, Page 2, Line 5, Pos (80,41)
msgid "ぐぬぬ……"
msgstr "唔奴奴……"

#. ID 82, Page 2, Line 8, Pos (80,41)
msgid ""
"この先には\n"
"我らが秘法、『黄金の爪』が封印されておる。\n"
"欲しくばゆくがいい……クックック。"
msgstr ""
"前方封印着我们的秘法『黄金之爪』。想要便去吧……\n"
"库库库。"

