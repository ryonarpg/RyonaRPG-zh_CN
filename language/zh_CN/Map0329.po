msgstr "\\n[102]不行了……饶…了我…\\n[103]\\n[104]\\^"

#. ID 43, Page 2, Line 853, Pos (3,6)
msgid ""
"\\S[2]\n"
"………"
msgstr ""
"\\S[2]\n"
"………"

#. ID 43, Page 2, Line 855, Pos (3,6)
msgid ""
"\\S[2]\n"
"＊……\\n[\\v[6]]は、すでに視るも無残な肉の塊と\n"
"　化していた。"
msgstr "\\S[2]＊……\\n[\\v[6]]已经化作了惨不忍睹的肉块。"

#. ID 43, Page 2, Line 858, Pos (3,6)
msgid ""
"\\S[2]\n"
"＊腹部を切り裂いた\\n[\\v[6]]の手が、\n"
"　そのまま内部の腸を引き千切り、外へとぶちまける。"
msgstr ""
"\\S[2]＊切开腹部后，\n"
"\\n[\\v[6]]的手就那样将内部的肠子扯碎，\n"
"　向外泼洒出来。"

#. ID 43, Page 2, Line 861, Pos (3,6)
msgid ""
"\\S[2]\n"
"＊小腸を手で千切り、大腸を握りつぶし、\n"
"　子宮にナイフを突き立て、腎臓を抉る。\n"
"　採り出した膵臓を\\n[\\v[6]]の口へ押し込む。"
msgstr ""
"\\S[2]＊用手扯碎小肠，捏烂大肠，\n"
"　将刀刺入子宫，剜出肾脏。\n"
"　将取出的胰脏塞进\\n[\\v[6]]的嘴里。"

#. ID 43, Page 2, Line 865, Pos (3,6)
msgid ""
"\\S[2]\n"
"＊そして、魚を捌くように、\n"
"　\\n[\\v[6]]の手はナイフを上へと切り上げ、\n"
"　縦に大きく切り込みを入れた。"
msgstr ""
"\\S[2]＊然后，就像处理鱼一样，\n"
"　\\n[\\v[6]]的手将刀向上挑起，\n"
"　纵向划开了一道大口子。"

#. ID 43, Page 2, Line 869, Pos (3,6)
msgid ""
"\\S[2]\n"
"＊しかし、激痛を感じても意識を失うこともできない。\n"
"　強力な催眠術が理性を常に保たせ、\n"
"　それ故に苦痛を最後まで味わうことになった。"
msgstr ""
"\\S[2]＊但是，即使感到剧痛也无法失去意识。\n"
"　强力的催眠术让她始终保持理性，\n"
"　因此她只得将痛苦品味到最后。"

#. ID 43, Page 2, Line 879, Pos (3,6)
msgid ""
"\\S[2]\n"
"＊ナイフが、\\n[\\v[6]]の胸に突き刺さった。"
msgstr "\\S[2]＊刀，刺进了\\n[\\v[6]]的胸口。"

#. ID 43, Page 2, Line 881, Pos (3,6)
msgid ""
"\\S[2]\n"
"＊\\n[\\v[6]]の乳房を抉り、それを斬り捨てると、\n"
"　さらにナイフを奥へと突きさし……\n"
"　\\n[\\v[6]]の心臓へと、抉るようにして力を込めた。"
msgstr ""
"\\S[2]＊\\n[\\v[6]]的乳房被剜出，将其斩下丢弃后，\n"
"　又把刀向更深处刺去……　向\\n[\\v[6]]的心脏，\n"
"　像要剜出一般用力。"

#. ID 43, Page 2, Line 888, Pos (3,6)
msgid "＊血が噴き出す。"
msgstr "＊鲜血喷涌而出。"

#. ID 43, Page 2, Line 889, Pos (3,6)
msgid "＊命が失われるのを感じる。"
msgstr "＊感觉到生命正在消逝。"

#. ID 43, Page 2, Line 916, Pos (3,6)
msgid ""
"\\S[2]\n"
"＊\\n[\\v[6]]の手が、胸から心臓を抜き取った。\n"
"　そして……その手が心臓を目の前で握りつぶし、\n"
"　意識が一瞬で赤く塗りつぶされた。"
msgstr ""
"\\S[2]＊\\n[\\v[6]]的手从胸口取出了心脏。　然后……\n"
"那只手在眼前将心脏捏碎，\n"
"　意识在一瞬间被涂成一片鲜红。"

#. ID 43, Page 2, Line 920, Pos (3,6)
msgid ""
"\\S[2]\n"
"………\n"
"……\n"
"…"
msgstr ""
"\\S[2]\n"
"………\n"
"……\n"
"…"

#. ID 44, Page 2, Line 3, Pos (2,6)
msgid ""
"ああ……○リーパーさまぁ……\\c[11]$k$k$k$k$k\\c[0]\n"
"わたくしにも○リーパーさまの寵愛をくださいましぃ…"
msgstr ""
"啊啊……○收割者大人……\n"
"\\c[11]$k$k$k$k$k\\c[0]也请赐予我○收割者大人的宠\n"
"爱吧……"
