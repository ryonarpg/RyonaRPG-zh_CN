#. ID 2, Page 5, Line 11, Pos (0,0)
msgid ""
"コインが足りないみたいですわね…\n"
"最低ベットは5コインからとなっておりますの。"
msgstr "好像硬币不够呢……最低下注为5枚硬币哦。"

#. ID 2, Page 5, Line 34, Pos (0,0)
msgid ""
"＊矢印キーで賭ける場所を選んで\n"
"　Enterキー（決定ボタン）で決定してください。"
msgstr ""
"＊用方向键选择下注位置　按Enter键（决定按钮）\n"
"　确定。"

#. ID 2, Page 5, Line 313, Pos (0,0)
#. ID 2, Page 5, Line 325, Pos (0,0)
msgid ""
"＊ベットする場所が重複しています。\n"
"　再度選択してください。"
msgstr "＊下注位置重复。　请重新选择。"

#. ID 2, Page 5, Line 342, Pos (0,0)
#. Contains choice at line 3 (2 options)
msgid ""
"ベット方式：\\n[101]\\n[102]\\n[103]\n"
"ここにコインを賭けますか？"
msgstr ""
"下注方式：\n"
"\\n[101]\\n[102]\\n[103]要在这里下注硬币吗？"

#. ID 2, Page 5, Line 344, Pos (0,0)
#. Choice (2 options, embedded in a message)
#. ID 2, Page 5, Line 444, Pos (0,0)
#. Choice (2 options, embedded in a message)
msgid ""
"\\>はい\n"
"\\>いいえ"
msgstr ""
"\\>是\n"
"\\>否"

#. ID 2, Page 5, Line 375, Pos (0,0)
msgid ""
"\\$＊ベットするコイン数を設定してください。\n"
"　最低ベットは5コインで\\v[250]コインまで賭けられます。"
msgstr ""
"\\$＊请设置下注的硬币数量。\n"
"　最低下注为5枚硬币，最多可下注\\v[250]枚硬币。"

#. ID 2, Page 5, Line 380, Pos (0,0)
msgid "＊ベットが少なすぎます。再度入力してください。"
msgstr "＊下注太少。请重新输入。"

#. ID 2, Page 5, Line 385, Pos (0,0)
msgid "＊ベットが多すぎます。再度入力してください。"
msgstr "＊下注太多。请重新输入。"

#. ID 2, Page 5, Line 390, Pos (0,0)
msgid "＊コインが足りません。再度入力してください。"
msgstr "＊硬币不足。请重新输入。"

#. ID 2, Page 5, Line 394, Pos (0,0)
#. Contains choice at line 3 (2 options)
msgid ""
"ベット方式：\\n[101]\\n[102]\\n[103]\n"
"ベットするコイン：\\v[241]"
msgstr ""
"下注方式：\\n[101]\\n[102]\\n[103]下注硬币：\n"
"\\v[241]"

#. ID 2, Page 5, Line 396, Pos (0,0)
#. Choice (2 options, embedded in a message)
msgid ""
"\\>これでOK\n"
"\\>再度考える"
msgstr ""
"\\>这样OK\n"
"\\>重新考虑"

#. ID 2, Page 5, Line 430, Pos (0,0)
msgid "\\$＊\\v[241]コインをベットした。"
msgstr "\\$＊已下注\\v[241]枚硬币。"

#. ID 2, Page 5, Line 443, Pos (0,0)
#. Contains choice at line 2 (2 options)
msgid "続けて違う場所にベットしますか？"
msgstr "要继续在其他位置下注吗？"

#. ID 2, Page 5, Line 447, Pos (0,0)
msgid ""
"＊コインが足りないため、追加ベットできません。\n"
"　このまま勝負に移行します。"
msgstr ""
"＊因为硬币不足，无法追加下注。\n"
"　将直接进入胜负。"
