#. ID 39, Page 2, Line 2, Pos (11,20)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "使用済"
msgstr "已使用"

#. ID 39, Page 2, Line 6, Pos (11,20)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "１回だけ使用"
msgstr "仅可使用1次"

#. ID 39, Page 2, Line 7, Pos (11,20)
#. ChangeHeroName (Actor 102)
msgctxt "actors.name"
msgid "可能"
msgstr "可能"

#. ID 39, Page 2, Line 12, Pos (11,20)
#. Contains choice at line 2 (3 options)
msgid "何を行いますか？"
msgstr "要做什么？"

#. ID 39, Page 2, Line 13, Pos (11,20)
#. Choice (3 options, embedded in a message)
msgid ""
"全回復（\\c[9]\\n[101]\\n[102]\\c[0]）\n"
"セーブ（\\c[9]何回でも使用可能\\c[0]）\n"
"何もしない"
msgstr ""
"全回复（\\c[9]\\n[101]\\n[102]\\c[0]）\n"
"保存（\\c[9]可无限次使用\\c[0]）\n"
"什么都不做"

#. ID 39, Page 2, Line 16, Pos (11,20)
msgid ""
"\n"
"何も起きなかった……"
msgstr "什么也没有发生……"

#. ID 42, Page 2, Line 9, Pos (25,24)
msgid ""
"\\>\n"
"\\>（……あれ？　道を間違えたかな？\\<\\!\n"
"\\>　もう１度進んでみようっと。）"
msgstr ""
"\\>\n"
"\\>（……咦？　我是不是走错路了？\\<\\!\n"
"\\>　再往前走一次看看吧。）"

#. ID 42, Page 2, Line 22, Pos (25,24)
msgid ""
"\\>\n"
"\\>（……………。）"
msgstr ""
"\\>\n"
"\\>（……………。）"

#. ID 42, Page 2, Line 27, Pos (25,24)
msgid ""
"\\>\n"
"\\>どうやらこの場所には、\n"
"\\>何らかの仕掛けがしてあるようだ。"
msgstr ""
"\\>\n"
"\\>看来这个地方，\n"
"\\>似乎设置了某种机关。"

#. ID 42, Page 2, Line 30, Pos (25,24)
msgid ""
"\\>周りには野盗達はもとい生物の気配が全く無く、\n"
"\\>無理をして先へ進む必要も無さそうだ。\\<\\!\n"
"\\>\\n[\\v[6]]は調査の報告をしに戻る事にした。"
msgstr ""
"\\>周围别说土匪了，连生物的气息都完全没有，\n"
"\\>看来也没有必要勉强继续前进。\\<\\!\n"
"\\>\\n[\\v[6]]决定回去报告调查结果。"
