#. ID 34, Page 2, Line 4, Pos (29,12)
msgid "\\S[2]* 管理者登録用パスワード確認機器"
msgstr "\\S[2]* 管理员注册用密码确认设备"

#. ID 34, Page 2, Line 6, Pos (29,12)
msgid ""
"\\S[2][ここでは女性生徒拘束衣、通称【奴隷の貞操帯】\n"
" の脱衣やリモコン操作をするために必要な管理者登録\n"
" 用パスワードを確認することができます。"
msgstr ""
"\\S[2][在此可以确认，为了脱下女学生拘束衣、\n"
" 通称【奴隶贞操带】\n"
" 以及进行遥控操作所需的管理员注册 用密码。"

#. ID 34, Page 2, Line 10, Pos (29,12)
msgid ""
"\\S[2][ただし閲覧にはセキュリティクリアランスレッド\n"
" 以上が必要となります。閲覧の際には必ず基地入り口\n"
" で得られるクリアランスカードを持参してください]"
msgstr ""
"\\S[2][但查看需要红色安全许可 以上。\n"
" 查看时请务必携带在基地入口 取得的权限卡]"

#. ID 34, Page 2, Line 14, Pos (29,12)
msgid ""
"\\S[2][クリアランス違反が判明した場合、強力な電磁波\n"
" を放出するとともに特殊電波を放出します]"
msgstr ""
"\\S[2][若查明存在权限违规，\n"
" 将释放强力电磁波 并同时释放特殊电波]"

#. ID 34, Page 2, Line 18, Pos (29,12)
#. Contains choice at line 2 (2 options)
msgid "どうしよう？"
msgstr "怎么办？"

#. ID 34, Page 2, Line 19, Pos (29,12)
#. Choice (2 options, embedded in a message)
msgid ""
"端末を操作する\n"
"なにもしない"
msgstr ""
"操作终端\n"
"什么都不做"

#. ID 34, Page 2, Line 25, Pos (29,12)
msgid "\\S[2][クリアランスカードをチェックします…\\|…\\|…\\|]"
msgstr "\\S[2][正在检查权限卡…\\|…\\|…\\|]"

#. ID 34, Page 2, Line 28, Pos (29,12)
msgid ""
"\\S[2][ERROR!!!\n"
" クリアランスカードの所持を確認できません！]"
msgstr "\\S[2][ERROR!!! 无法确认持有权限卡！]"

#. ID 34, Page 2, Line 43, Pos (29,12)
msgid ""
"\\S[2][Complete......本日のパスワードを表示します\n"
"　現在のパスワードは「\\v[1499]」となっております]"
msgstr ""
"\\S[2][Complete......将显示今日密码　当前密码为\n"
"　「\\v[1499]」]"

#. ID 34, Page 2, Line 51, Pos (29,12)
msgid ""
"\\S[2][ERROR!!!クリアランス階級が正しくありません！\n"
" 周囲に特殊電波を放出します]"
msgstr ""
"\\S[2][ERROR!!!权限等级不正确！\n"
" 将向周围释放特殊电波]"

#. ID 35, Page 2, Line 3, Pos (30,7)
msgid ""
"＊＊＊\n"
"「戦闘に特化した自動人形が列を成して人の軍隊を殲滅\n"
"　する……実に美しいとは思わないか？"
msgstr ""
"＊＊＊「专门用于战斗的自动人偶排成队列，\n"
"将人类军队歼灭　……你不觉得这实在很美吗？"

#. ID 36, Page 2, Line 3, Pos (4,9)
msgid ""
"＊＊＊\n"
"「ここには自動人形たちの発祥となった、\n"
"　ラピュタの資料が保存されている。"
msgstr ""
"＊＊＊「这里保存着成为自动人偶们发祥地的、\n"
"　拉普达的资料。"

#. ID 36, Page 2, Line 6, Pos (4,9)
msgid ""
"＊＊＊\n"
"「未だに作成者目的等謎が多い自動人形だが、\n"
"　まさか天使が関わっているとでもいうのか……？"
msgstr ""
"＊＊＊「这种自动人偶至今在制作者、\n"
"目的等方面仍有许多谜团，\n"
"　难道说天使也参与其中了吗……？"

#. ID 37, Page 2, Line 3, Pos (5,5)
msgid ""
"＊＊＊\n"
"「天使共は自動人形の価値に気付いてないらしい。\\|\n"
"　我々にとっては都合がいいがな。"
msgstr ""
"＊＊＊「那群天使似乎没有注意到自动人偶的价值。\n"
"\\|　这对我们来说倒是正合适。"

#. ID 40, Page 2, Line 5, Pos (19,4)
#. Choice (3 options)
msgid ""
"６Ｆ データバンク\n"
"９Ｆ 機体整備室\n"
"やめておく"
msgstr ""
"6F 数据库\n"
"9F 机体整备室\n"
"算了"

#. ID 42, Page 2, Line 4, Pos (14,12)
msgid ""
"\\S[2][クリアランスの階級は全9つありインフラレッド（黒）\n"
"レッド（赤）オレンジ（橙）イエロー（黄）\n"
"グリーン（緑）ブルー（青）インディゴ（藍）\n"
"バイオレット（紫）ウルトラバイオレット（白）です]"
msgstr ""
"\\S[2][权限等级共有9个，分别是红外（黑）红色\n"
"（红）橙色（橙）黄色（黄）绿色（绿）蓝色（蓝）\n"
"靛蓝（蓝）紫色（紫）紫外（白）]"

#. ID 42, Page 2, Line 9, Pos (14,12)
msgid ""
"\\S[2][清廉で潔白で幸福な市民はまずRedとして判定され、\n"
" さらにこの街での奉仕度合いに応じて階級が上昇\n"
" していきます]"
msgstr ""
"\\S[2][清廉、\n"
" 纯洁而幸福的市民首先会被判定为Red，\n"
" 然后根据在这座城市中的奉献程度，\n"
"等级会逐步上升]"

#. ID 42, Page 2, Line 13, Pos (14,12)
msgid ""
"\\S[2][それ以外の市民、奴隷やライオネルに敵対する旅人等\n"
" は全て階級はインフラレッドとして判定されます]"
msgstr ""
"\\S[2][除此之外的市民、\n"
" 奴隶以及与莱昂内尔敌对的旅人等 全都会被判定为\n"
"红外（黑）等级]"

#. ID 43, Page 2, Line 5, Pos (11,6)
msgid "＊研究員の日誌"
msgstr "＊研究员的日志"

#. ID 43, Page 2, Line 10, Pos (11,6)
msgid ""
"＊自動人形は素晴らしい\n"
"　疲れも知らず恐れも知らない\n"
"　生殖さえ出来れば生物を凌駕する"
msgstr ""
"＊自动人偶真是出色　不知疲倦也不知恐惧　只要能\n"
"　够生殖就能凌驾于生物之上"

#. ID 43, Page 2, Line 13, Pos (11,6)
msgid ""
"＊……いや、自動人形が自動人形を作れば\n"
"　それが可能になれば……\n"
"　もはや人間など過去の遺物にしかならない"
msgstr ""
"＊……不，\n"
"　如果自动人偶制造自动人偶　如果那成为可能……\n"
"　人类之类就已经只能成为过去的遗物了"

#. ID 63, Page 2, Line 4, Pos (33,28)
msgid "\\S[2][自動人形の兵士化について]"
msgstr "\\S[2][关于自动人偶的士兵化]"

#. ID 63, Page 2, Line 6, Pos (33,28)
msgid ""
"\\S[2][現在はまだ試用段階だが\n"
" ほぼ通常の兵士の兵力に匹敵]"
msgstr ""
"\\S[2][目前仍处于试用阶段 但几乎匹敌普通士兵的\n"
" 兵力]"

#. ID 63, Page 2, Line 9, Pos (33,28)
msgid "\\S[2][現在は武装よりもAIの強化に尽力を]"
msgstr "\\S[2][目前比起武装，更应致力于AI的强化]"

#. ID 64, Page 2, Line 4, Pos (7,8)
msgid "\\S[2][蔵書データベース]"
msgstr "\\S[2][藏书数据库]"

#. ID 64, Page 2, Line 6, Pos (7,8)
msgid ""
"\\S[2][古代ラピュタから持ち込まれた書物を\n"
" 保管しています\n"
" 貴重品ですので持ち帰りは、厳禁]"
msgstr ""
"\\S[2][保管着从古代拉普达带入的书籍 因属贵重物\n"
" 品，严禁带出]"

#. ID 65, Page 2, Line 4, Pos (3,31)
msgid ""
"\\S[2][自動人形を兵士にする点の\n"
"倫理とそれに関する反論について]"
msgstr ""
"\\S[2][关于将自动人偶作为士兵的伦理问题及相关反\n"
"驳]"

#. ID 65, Page 2, Line 7, Pos (3,31)
msgid ""
"\\S[2][自動人形を兵として使用する。\n"
"この計画を発表する際必ず指摘されるのは\n"
"「倫理」というくだらない発想についてだ]"
msgstr ""
"\\S[2][将自动人偶作为士兵使用。\n"
"公布这项计划时必定会被指出的，就是关于「伦理」\n"
"这种无聊想法的问题]"

#. ID 65, Page 2, Line 11, Pos (3,31)
msgid ""
"\\S[2][曰く、人以外のものが人を殺してはいけない\n"
"曰く、人が作ったものが人を殺してはいけない\n"
"曰く、それが人類に対し反乱をしたらどうする]"
msgstr ""
"\\S[2][有人说，人类以外的存在不可杀人；有人说，\n"
"人类制造之物不可杀人；有人说，\n"
"若它反叛人类又该如何]"

#. ID 65, Page 2, Line 15, Pos (3,31)
msgid ""
"\\S[2][全くもって手垢のついた理論だ\n"
"軍犬や武器が人を殺すのとどう違うのか\n"
"訓練した兵が裏切る可能性は無視するのか]"
msgstr ""
"\\S[2][完全是老掉牙的理论。\n"
"这和军犬或武器杀人有什么不同？\n"
"训练有素的士兵背叛的可能性就可以无视吗？]"

#. ID 65, Page 2, Line 19, Pos (3,31)
msgid ""
"\\S[2][倫理という言葉も何度聴いたか解らない\n"
"自動人形を開発して尚、\n"
"いい歳をしてまだ神様のことでも信じているのか]"
msgstr ""
"\\S[2][都不知道听过多少次「伦理」这个词了。\n"
"都已经开发出自动人偶了，\n"
"一把年纪了还相信神明之类的东西吗？]"

#. ID 65, Page 2, Line 23, Pos (3,31)
msgid ""
"\\S[2][それに付き合わないといけない\n"
"兵の身になってみるべきだ\n"
"死なずにすむならそれに越したことがない]"
msgstr ""
"\\S[2][应该站在不得不奉陪这一套的士兵的立场想想。若\n"
"　能不必死，那再好不过了]"

#. ID 65, Page 2, Line 27, Pos (3,31)
msgid ""
"\\S[2][自動人形開発局　\n"
"　　　事務局長　ディオ・ムスタディオ]"
msgstr ""
"\\S[2][自动人偶开发局\n"
"　　　事务局长　迪奥·穆斯塔迪奥]"

#. ID 66, Page 2, Line 3, Pos (26,7)
msgid ""
"列を為せ\n"
"汝\n"
"従順のマシン"
msgstr "排成队列吧，你这顺从的机器"

#. ID 68, Page 2, Line 3, Pos (32,7)
msgid ""
"甘受せよ\n"
"さあ、思慮は\n"
"今、罪と知るべし"
msgstr "甘受吧，来吧，如今当知思虑即为罪"

#. ID 69, Page 2, Line 3, Pos (7,28)
msgid "幸福は義務です"
msgstr "幸福是义务"

#. ID 75, Page 2, Line 4, Pos (35,12)
msgid ""
"\\S[2]アバロソの騎士団と\n"
"ライオネルの機械兵士団との兵力差は\n"
"もはや、無いと言えるでしょう"
msgstr ""
"\\S[2]阿巴罗索骑士团与莱昂内尔机械士兵团之间的\n"
"兵力差距，如今可以说已经不存在了吧"

#. ID 75, Page 2, Line 8, Pos (35,12)
msgid ""
"\\S[2]まだ人間の兵士を指揮官として\n"
"命令をしなければ上手く運用はできませんが"
msgstr ""
"\\S[2]目前如果不由人类士兵作为指挥官来下达命令，还是\n"
"　无法顺利运用，不过"

#. ID 75, Page 2, Line 11, Pos (35,12)
msgid ""
"\\S[2]最終的には機械兵士のみで構成された\n"
"軍隊を作成可能でしょう"
msgstr "\\S[2]最终应该可以组建仅由机械士兵构成的军队吧"
