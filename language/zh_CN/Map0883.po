#. ID 33, Page 3, Line 21, Pos (2,0)
msgid ""
"\\>\n"
"\\>野盗の毛を手に入れた！！\\<\\.\\.\\^"
msgstr "\\>\\>获得了盗贼毛！！\\<\\.\\.\\^"

#. ID 33, Page 3, Line 29, Pos (2,0)
msgid ""
"\\>\n"
"\\>野盗頭領の毛を手に入れた！！\\<\\.\\.\\^"
msgstr "\\>\\>获得了盗贼头目毛！！\\<\\.\\.\\^"

#. ID 33, Page 4, Line 202, Pos (2,0)
msgid ""
"\\>「捕まえたぜ！！\n"
"\\>　……って、なんだこりゃ。\\<\\|\\.\\.\n"
"\\>　妙なもん着けやがって！！」\\<\\|\\|\\^"
msgstr ""
"\\>「抓到你了！！\\>　……等等，这是什么玩意儿。\n"
"\\<\\|\\.\\.\\>　居然戴着奇怪的东西！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 209, Pos (2,0)
msgid ""
"\\>\n"
"\\>　男は舌打ちすると、\n"
"\\>　\\n[\\v[6]]の荷物を物色して去っていった。\\<\\|\\|\\^"
msgstr ""
"\\>\\>　男人啧了一声，\n"
"\\>　\\n[\\v[6]]的行李翻找一番后离开了。\\<\\|\\|\\^"

#. ID 33, Page 4, Line 225, Pos (2,0)
msgid ""
"\\>\n"
"\\>「捕まえたぜ！！」\\<\\|\\.\\.\\^"
msgstr "\\>\\>「抓到你了！！」\\<\\|\\.\\.\\^"

#. ID 33, Page 4, Line 243, Pos (2,0)
msgid ""
"\\>\n"
"\\>「邪魔なもん剥ぎとっちまうか。」\\<\\|\\.\\.\\^"
msgstr "\\>\\>「把碍事的东西扯掉吧。」\\<\\|\\.\\.\\^"

#. ID 33, Page 4, Line 254, Pos (2,0)
msgid ""
"\\>\n"
"\\>男が服に手をかけようとした隙をつき、\n"
"\\>\\n[\\v[6]]は逃げ出す事に成功した！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>趁男人把手伸向衣服的间隙，\n"
"\\>\\n[\\v[6]]成功逃走了！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 292, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ヘヘッ、久々の女だ。\n"
"\\>　たっぷり可愛がってやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「嘿嘿，好久没碰女人了。\n"
"\\>　我会好好疼你的！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 306, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ツイてんな、俺！\n"
"\\>　久々の女がこんなチビッ子だなんてよ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「我运气真好啊！\n"
"\\>　好久没碰到的女人竟然是这么个小不点！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 324, Pos (2,0)
msgid ""
"\\>\n"
"\\>「うひゃー、おっぱい！　でけー、おっぱい！！\n"
"\\>　サイコーだよ、お前のおっぱい！！！！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜哇——，奶子！　好大——，奶子！！\n"
"\\>　太棒了，你的奶子！！！！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 334, Pos (2,0)
msgid ""
"\\>\n"
"\\>「うひょー、でけえ乳しやがって！\n"
"\\>　たっぷり搾ってやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜哟——，居然长着这么大的奶子！\n"
"\\>　我会给你好好榨出来的！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 352, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ヘヘッ、いいケツしてんじゃねーか。\n"
"\\>　たっぷりとかき回してやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「嘿嘿，屁股长得不错嘛。\n"
"\\>　我会好好搅弄一番的！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 368, Pos (2,0)
msgid ""
"\\>\n"
"\\>「うひょー、このぷっくりと膨らんだ腹！！\n"
"\\>　腹ん中の子供、精子漬けにしてやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜哟——，这圆鼓鼓隆起的肚子！！\n"
"\\>　肚子里的小孩，我要让你泡满精子！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 380, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ヘヘッ、匂いで分かるぜ……\n"
"\\>　腹ん中の子供、精子漬けにしてやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「嘿嘿，闻味道就知道了……\\>　肚子里的小孩，\n"
"我要让你泡满精子！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 402, Pos (2,0)
msgid ""
"\\>\n"
"\\>「なんだこれ？\n"
"\\>　おっぱいが変なので覆われてるじゃねぇか！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「这是什么？\\>　奶子被奇怪的东西盖住了嘛！\n"
"」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 408, Pos (2,0)
msgid ""
"\\>\n"
"\\>「下も変なので覆われてやがるし…\n"
"\\>　まぁ両方穴がパックリ開いてるのは悪くねぇな！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「下面也被奇怪的东西盖住了……\n"
"\\>　不过两个洞都大敞着倒也不赖嘛！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 413, Pos (2,0)
msgid ""
"\\>\n"
"\\>「下も変なので覆われてやがるし…\n"
"\\>　まぁ前の穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「下面也被奇怪的东西盖住了……\n"
"\\>　不过前面的洞能用就行吧！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 420, Pos (2,0)
msgid ""
"\\>\n"
"\\>「下も変なので覆われてやがるし…\n"
"\\>　まぁ後ろの穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「下面也被奇怪的东西盖住了……\n"
"\\>　不过后面的洞能用就行吧！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 427, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まぁ下の穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr "\\>\\>「不过下面的洞能用就行吧！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 434, Pos (2,0)
msgid ""
"\\>\n"
"\\>「なんだこれ？\n"
"\\>　下が変なので覆われてるじゃねぇか！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「这是什么？\\>　下面被奇怪的东西盖住了嘛！\n"
"」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 439, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まぁ両方穴がパックリ開いてるのは悪くねぇな！」\\<\\|\\|\\^"
msgstr "\\>\\>「不过两个洞都大敞着倒也不赖嘛！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 443, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まぁ前の穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr "\\>\\>「不过前面的洞能用就行吧！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 449, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まぁ後ろの穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr "\\>\\>「不过后面的洞能用就行吧！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 469, Pos (2,0)
msgid ""
"\\>\n"
"\\>\\n[\\v[6]]は男から逃れようと抵抗し……\\<\\|\\|\\^"
msgstr ""
"\\>\\>\\n[\\v[6]]为了从男人手里逃开而反抗……\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 481, Pos (2,0)
msgid ""
"\\>\n"
"\\>なぜだか急に力が入らなくなってしまった……\\<\\|\\|\\^"
msgstr "\\>\\>不知为何突然使不上力气了……\\<\\|\\|\\^"

#. ID 33, Page 4, Line 487, Pos (2,0)
msgid ""
"\\>\n"
"\\>「なんだぁ？　急にボケーっとしやがって。\\<\\|\\|\n"
"\\>　まぁいいか。」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「怎么了？　突然发起呆来。\\<\\|\\|\\>　算了，\n"
"无所谓。」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 497, Pos (2,0)
msgid ""
"\\>\n"
"\\>\\n[\\v[6]]は抵抗し、\n"
"\\>男の手から逃げ出す事に成功した！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>\\n[\\v[6]]反抗着，\\>成功从男人手里逃走了！\n"
"！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 508, Pos (2,0)
#. ID 33, Page 4, Line 1094, Pos (2,0)
msgid ""
"\\>\n"
"\\>「暴れんじゃねぇよ！！」\\<\\|\\|\\^"
msgstr "\\>\\>「别乱动！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 561, Pos (2,0)
#. ID 33, Page 4, Line 1154, Pos (2,0)
msgid ""
"\\>\n"
"\\>「痛い目みたくなければ大人しくしてな。」\\<\\|\\|\\^"
msgstr "\\>\\>「不想吃苦头就乖乖别动。」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 585, Pos (2,0)
msgid ""
"\\>\n"
"\\>「前戯なんていらねぇ！\n"
"\\>　すぐにぶち込んでやるよ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「前戏什么的才不需要！\\>　我马上就插进去！\n"
"」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 622, Pos (2,0)
#. ID 33, Page 4, Line 1082, Pos (2,0)
msgid ""
"\\>\n"
"\\>\\n[\\v[6]]は激しく抵抗し、\n"
"\\>男の手から逃げ出す事に成功した！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>\\n[\\v[6]]激烈地反抗，\n"
"\\>成功从男人手里逃走了！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1063, Pos (2,0)
msgid ""
"\\>\n"
"\\>「う～ん、ちったぁ色気のある反応してくれよ。\n"
"\\>　人形とヤッてる気分になってくるぜ。」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「嗯～，稍微给点像女人的反应啊。\n"
"\\>　我都快觉得是在跟人偶做了。」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1099, Pos (2,0)
msgid ""
"\\>\n"
"\\>「だから暴れんじゃねぇって言ってるだろ！！」\\<\\|\\|\\^"
msgstr "\\>\\>「都说了别乱动！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1170, Pos (2,0)
msgid ""
"\\>\n"
"\\>「無理矢理されてるってのに、嫌がらねぇのな。\n"
"\\>　実はまんざらでもないってか？」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「明明是被强迫的，却一点都不讨厌啊。\n"
"\\>　其实也不是完全不情愿吧？」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1175, Pos (2,0)
msgid ""
"\\>\n"
"\\>「さっきと違って、随分と大人しくなったじゃねぇか。\n"
"\\>　実はまんざらでもないってか？」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「跟刚才不一样，变得相当老实了嘛。\n"
"\\>　其实也不是完全不情愿吧？」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1200, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まだ濡れ足りねぇみたいだが、もう我慢できねぇ！\n"
"\\>　一気にぶち込んでやるぜ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「好像还没湿透，但我已经忍不住了！\n"
"\\>　一口气插进去！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1205, Pos (2,0)
msgid ""
"\\>\n"
"\\>「大分いい具合になってきたみたいだな。\n"
"\\>　それじゃぶち込んでやるぜ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「看起来状态已经相当不错了。\n"
"\\>　那我就插进去！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1213, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まだ濡れ足りねぇみたいだが、暴れたバツだ。\n"
"\\>　このままぶち込んでやるぜ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「好像还没湿透，这是你乱动的惩罚。\n"
"\\>　我就这样直接插进去！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1218, Pos (2,0)
msgid ""
"\\>「嫌がる割にはビショビショじゃねぇか！\n"
"\\>　ほんとは欲しくてたまらないんだろ？\n"
"\\>　だったら思いきりぶち込んでやるよ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「明明在抗拒，却湿得一塌糊涂嘛！\n"
"\\>　其实想要得不得了吧？\\>　那我就狠狠插进去！\n"
"！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1236, Pos (2,0)
msgid ""
"\\>\n"
"\\>「そろそろツルツルまんこにぶち込んでやるよ。\n"
"\\>　俺のカタチ、しっかり覚えるんだぞ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「差不多该插进光溜溜的骚穴里了。\n"
"\\>　给我好好记住我的形状！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1249, Pos (2,0)
msgid ""
"\\>\n"
"\\>「そいじゃそろそろ種付けといこうか。\n"
"\\>　しっかり孕んで、いい乳出すんだぞ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「那么差不多该配种了吧。\\>　好好怀上，\n"
"给我产出好奶！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1254, Pos (2,0)
msgid ""
"\\>\n"
"\\>「いい乳が出せるように、\n"
"\\>　たっぷり注ぎ込んでやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「为了让你能产出好奶，\n"
"\\>　我会给你灌得满满的！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1278, Pos (2,0)
msgid ""
"\\>\n"
"\\>「大分ほぐれてきたようだな。\n"
"\\>　そいじゃケツ穴にぶっ挿してやるぜ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「好像松得差不多了。\n"
"\\>　那我就插进屁股洞里！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1291, Pos (2,0)
msgid ""
"\\>\n"
"\\>「そろそろ妊婦まんこにぶち込んでやるよ。\n"
"\\>　そのデカ腹揺らして、イキまくりな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「差不多该插进孕妇骚穴里了。\n"
"\\>　晃着那大肚子，给我高潮到死！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1363, Pos (2,0)
#. ID 33, Page 4, Line 1489, Pos (2,0)
msgid ""
"\\>\n"
"\\>\\n[\\v[6]]は必死に抵抗し、\n"
"\\>男の手から逃げ出す事に、かろうじて成功した……\\<\\|\\|\\^"
msgstr ""
"\\>\\>\\n[\\v[6]]拼命反抗，\n"
"\\>好不容易才成功从男人手里逃走了……\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1455, Pos (2,0)
msgid ""
"\\>「おっ、いいねいいね。\n"
"\\>　必死にもがくたんびに、\n"
"\\>　キュウキュウ締めつけてきやがるぜ。\\<\\|\\|\\^"
msgstr ""
"\\>\\>「哦，不错不错。\\>　每次拼命挣扎，\n"
"\\>　都夹得紧紧的。\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1458, Pos (2,0)
msgid ""
"\\>\n"
"\\>　そんなに締めつけられたら……\n"
"\\>　ヘヘッ、こっちもあんまもたないかもなぁ？」\\<\\|\\|\\^"
msgstr ""
"\\>\\>　要是被夹得这么紧……\\>　嘿嘿，\n"
"我这边可能也撑不了多久啊？」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1515, Pos (2,0)
#. ID 33, Page 4, Line 1535, Pos (2,0)
#. ID 33, Page 4, Line 1566, Pos (2,0)
#. ID 33, Page 4, Line 1573, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ウオオオッ！！　出るっ！　出るっ！！\n"
"\\>　ケツん中にぶちまけてやるっ！！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜噢噢噢！！　要出来了！　要出来了！！\n"
"\\>　我要全灌进你屁股里！！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1521, Pos (2,0)
#. ID 33, Page 4, Line 1546, Pos (2,0)
#. ID 33, Page 4, Line 1552, Pos (2,0)
#. ID 33, Page 4, Line 1581, Pos (2,0)
#. ID 33, Page 4, Line 1587, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ウオオオッ！！　出るっ！　出るっ！！\n"
"\\>　腹ん中の子供にぶっかけてやるっ！！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜噢噢噢！！　要出来了！　要出来了！！\n"
"\\>　我要浇射到你肚子里那孩子身上！！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1526, Pos (2,0)
#. ID 33, Page 4, Line 1557, Pos (2,0)
#. ID 33, Page 4, Line 1592, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ウオオオッ！！　出るっ！　出るっ！！\n"
"\\>　孕めっ！！　孕んじまえっ！！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜噢噢噢！！　要出来了！　要出来了！！\n"
"\\>　怀孕吧！！　给我怀上！！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1782, Pos (2,0)
msgid ""
"\\>\n"
"\\>男の動きが止まった瞬間を見計らい、\n"
"\\>\\n[\\v[6]]は男を突き飛ばした！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>趁男人动作停下的瞬间，\n"
"\\>\\n[\\v[6]]把男人猛地撞开！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1816, Pos (2,0)
msgid ""
"\\>「チッ、中に出しそびれちまったぜ。\n"
"\\>　でもまぁ、白濁まみれのイイ格好になったな。\\<\\|\\|\n"
"\\>\n"
"\\>　またぶっかけられたくなったら、いつでも来いよ！！」\\<\\|\\|\\^"
msgstr ""
"\\>「啧，没来得及射在里面啊。\\>　不过嘛，\n"
"你这副沾满白浊的样子可真够好看的。\n"
"\\<\\|\\|\\>\\>　要是又想被浇射了，随时来啊！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1826, Pos (2,0)
#. ID 33, Page 4, Line 1935, Pos (2,0)
#. ID 33, Page 4, Line 2135, Pos (2,0)
msgid ""
"\\>\n"
"\\>男は去り際に荷物を物色していった！！\\<\\|\\|\\^"
msgstr "\\>\\>男人临走时还翻找了行李！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1834, Pos (2,0)
#. ID 33, Page 4, Line 1965, Pos (2,0)
#. ID 33, Page 4, Line 2165, Pos (2,0)
msgid ""
"\\>\n"
"\\>男が去ってからしばらくして、\n"
"\\>\\n[\\v[6]]はヨロヨロと体を起こす。\\<\\|\\|\\|\\^"
msgstr ""
"\\>\\>男人离开后过了一会儿，\n"
"\\>\\n[\\v[6]]摇摇晃晃地撑起身子。\\<\\|\\|\\|\\^"

#. ID 33, Page 4, Line 1837, Pos (2,0)
msgid ""
"\\>身体中にかけられた白濁から匂いがたちこめる。\\<\\|\\|\n"
"\\>鼻をつくその匂いの中、\n"
"\\>\\n[\\v[6]]はそっと涙をこぼした。\\<\\|\\|\\|\\^"
msgstr ""
"\\>泼洒在全身的白浊散发出浓烈气味。\n"
"\\<\\|\\|\\>在那刺鼻的气味中，\n"
"\\>\\n[\\v[6]]悄悄落下了眼泪。\\<\\|\\|\\|\\^"

#. ID 33, Page 4, Line 1890, Pos (2,0)
msgid ""
"\\>\n"
"\\>虚ろな瞳でされるがままの\\n[\\v[6]]の腸奥に、\n"
"\\>男の精が注ぎ込まれてしまった！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>眼神空洞、任人摆布的\\n[\\v[6]]的肠道深处，\n"
"\\>男人的精液被灌了进去！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1896, Pos (2,0)
msgid ""
"\\>一切の抵抗を止め、\n"
"\\>諦めきった表情の\\n[\\v[6]]の腸奥に、\n"
"\\>男の精が勢い良く注ぎ込まれてしまった！！\\<\\|\\|\\^"
msgstr ""
"\\>停止了所有抵抗，\n"
"\\>一脸彻底放弃表情的\\n[\\v[6]]的肠道深处，\n"
"\\>男人的精液被猛烈地灌了进去！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1902, Pos (2,0)
msgid ""
"\\>\\n[\\v[6]]の僅かな抵抗も虚しく、\n"
"\\>腸奥へと深く穿たれた男のイチモツから、\n"
"\\>勢い良く精が注ぎ込まれてしまった！！\\<\\|\\|\\^"
msgstr ""
"\\>\\n[\\v[6]]微弱的抵抗也无济于事，\n"
