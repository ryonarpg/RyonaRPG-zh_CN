#. ID 12, Page 1, Line 18, Pos (0,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「……体が……動か、な……」"
msgstr "\\n[\\v[6]]\\S[2]「……身体……动、不了……」"

#. ID 12, Page 1, Line 23, Pos (0,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「機体　破損\n"
"修理　してください……\n"
"修理　してください……ガガ、ガガガガ……」"
msgstr ""
"\\n[\\v[6]]\\S[2]「机体　破损修理　请……修理　请……\n"
"嘎嘎、嘎嘎嘎嘎……」"

#. ID 12, Page 1, Line 29, Pos (0,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「キタイ　ハソン……　キタイ　ハソン……\n"
"修理……　シテクダサイ……」"
msgstr ""
"\\n[\\v[6]]\\S[2]「机体　破损……　机体　破损……\n"
"修理……　请……」"

#. ID 12, Page 1, Line 41, Pos (0,1)
msgid "＊部屋の中に声が響く。"
msgstr "＊房间里响起声音。"

#. ID 12, Page 1, Line 46, Pos (0,1)
msgid "屈強な元冒険者だと期待したが、所詮この程度か。"
msgstr "本以为会是强壮的原冒险者，终究只是这种程度吗。"

#. ID 12, Page 1, Line 47, Pos (0,1)
msgid ""
"まったく、ろくにデータも取れないまま\n"
"まともに動かなくなるとはな。\n"
"とんだ粗大ゴミだ。"
msgstr ""
"真是的，\n"
"连数据都没能好好取得就变得无法正常运转了。\n"
"真是离谱的大件垃圾。"

#. ID 12, Page 1, Line 50, Pos (0,1)
msgid ""
"……修理するのも面倒だな。\\.\\.\n"
"解体してしまえ。"
msgstr "……修理也很麻烦啊。\\.\\.干脆解体掉吧。"

#. ID 12, Page 1, Line 58, Pos (0,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「……い、いや……そんな……！\n"
"人を、こんな体にしておいて……！」"
msgstr ""
"\\n[\\v[6]]\\S[2]「……不、不要……怎么会……！\n"
"把人变成这种身体……！」"

#. ID 12, Page 1, Line 64, Pos (0,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「…………イ、イヤ…………」"
msgstr "\\n[\\v[6]]\\S[2]「…………不、不要…………」"

#. ID 12, Page 1, Line 68, Pos (0,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「機体、ハソン……　脳部、破損……\n"
"腕部、破損……キャクブ、ハソン……\n"
"修理……シュウリ……シュウ、リ……」"
msgstr ""
"\\n[\\v[6]]\\S[2]「机体、破损……　脑部、破损……\n"
"腕部、破损……脚部、破损……修理……修理……修、理……」"

#. ID 13, Page 1, Line 47, Pos (1,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「……痛い……痛いいたいいたい……\n"
"痛い痛いいたいイタいイたイいタイイタイ……！」"
msgstr ""
"\\n[\\v[6]]\\S[2]「……好痛……好痛好痛好痛……\n"
"好痛好痛好痛好痛好痛好痛……！」"

#. ID 13, Page 1, Line 52, Pos (1,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「ガガ……ガガガガガガガ……！！」"
msgstr "\\n[\\v[6]]\\S[2]「嘎嘎……嘎嘎嘎嘎嘎嘎嘎……！！」"

#. ID 13, Page 1, Line 73, Pos (1,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「アアアアアア……ガガ……ガ……\n"
"機体破損……機体破損……壊……レ……チャ……\n"
"……死……ン………………」"
msgstr ""
"\\n[\\v[6]]\\S[2]「啊啊啊啊啊啊……嘎嘎……嘎……\n"
"机体破损……机体破损……坏……掉……了…………死……了………………\n"
"」"

#. ID 13, Page 1, Line 91, Pos (1,1)
msgid "＊…………………………"
msgstr "＊…………………………"

#. ID 13, Page 1, Line 96, Pos (1,1)
msgid ""
"まったく、どいつもこいつもガラクタばかり。\n"
"気が滅入るな。"
msgstr "真是的，这家伙那家伙全是破烂。真让人郁闷啊。"

#. ID 13, Page 1, Line 98, Pos (1,1)
msgid ""
"さて、ごみの片付けも終わったし、\n"
"次のサンプルの改造にうつろう。"
msgstr "那么，垃圾也收拾完了，开始改造下一个样本吧。"

#. ID 13, Page 1, Line 104, Pos (1,1)
msgid ""
"\\S[2]＊\\n[\\v[6]]は解体処理され、\n"
"文字通り物言わぬ鉄屑となって、\n"
"ダストシュートの底で動かなくなった……"
msgstr ""
"\\S[2]＊\\n[\\v[6]]被解体处理，\n"
"字面意义上成了不会说话的铁屑，\n"
"在垃圾滑槽底部不再动弹了……"

#. ID 13, Page 1, Line 119, Pos (1,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[10]「キタイ　ハソン　コウドウ　フノウ……\n"
"キタイ　ハソン……　コウ　ドウ……　フノ……ウ……\n"
"…………ガガ　ガガガガガガ…………"
msgstr ""
"\\n[\\v[6]]\\S[10]「机体　破损　无法行动……\n"
"机体　破损……　无　法……　行……动………………\n"
"嘎嘎　嘎嘎嘎嘎嘎嘎…………"

#. ID 13, Page 1, Line 134, Pos (1,1)
msgid ""
"\\n[\\v[6]]\n"
"\\S[10]「……………………"
msgstr ""
"\\n[\\v[6]]\n"
"\\S[10]「……………………"
