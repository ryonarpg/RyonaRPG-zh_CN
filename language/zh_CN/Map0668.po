#. ID 12, Page 1, Line 3, Pos (8,8)
#. ID 15, Page 1, Line 3, Pos (10,24)
msgid ""
"\\S[2]＊\\n[\\v[6]]は目を覚ますと……\n"
"　寝台の上に居ることに気がついた"
msgstr "\\S[2]＊\\n[\\v[6]]醒来后……　发现自己身在床铺上"

#. ID 12, Page 1, Line 15, Pos (8,8)
#. ID 15, Page 1, Line 27, Pos (10,24)
msgid "\\S[2]＊拘束されている……動けない"
msgstr "\\S[2]＊被拘束着……无法行动"

#. ID 12, Page 1, Line 16, Pos (8,8)
msgid ""
"\\S[2]＊腕や足は当然だが……\n"
"　頭や首、背中にも何か機械が取り付けられている"
msgstr ""
"\\S[2]＊手脚自不必说……　头部、\n"
"　脖子和背上也被安装了什么机械"

#. ID 12, Page 1, Line 26, Pos (8,8)
msgid "「気がついた？」"
msgstr "「醒了吗？」"

#. ID 12, Page 1, Line 31, Pos (8,8)
msgid ""
"「言ったわよね？\n"
"　あなたの記憶さえあれば私はあなたになれる\n"
"　……って」"
msgstr ""
"「我说过吧？　只要有你的记忆，我就能成为你　……\n"
"　是吧」"

#. ID 12, Page 1, Line 39, Pos (8,8)
#. ID 15, Page 1, Line 60, Pos (10,24)
msgid ""
"\\n[\\v[6]]\n"
"「い、一体何を……？」"
msgstr "\\n[\\v[6]]「你、你到底要做什么……？」"

#. ID 12, Page 1, Line 49, Pos (8,8)
msgid "「今からあなたの記憶を抜き取る」"
msgstr "「现在开始抽取你的记忆」"

#. ID 12, Page 1, Line 54, Pos (8,8)
msgid ""
"「脳に直接電気刺激を与えて……\n"
"　あなたの記憶をそのままコピーして\n"
"　私の脳に伝えるの」"
msgstr ""
"「直接对脑施加电刺激……\n"
"　原样复制你的记忆　再传达到我的脑里」"

#. ID 12, Page 1, Line 61, Pos (8,8)
msgid ""
"「完全じゃあないけど\n"
"　この方法が一番精確に記憶を手に入れられる」"
msgstr "「虽然不完全　但这种方法能最精确地获取记忆」"

#. ID 12, Page 1, Line 68, Pos (8,8)
msgid ""
"「もっとも……\n"
"　電気刺激を直接脳に受ける貴方は\n"
"　記憶がなくなって廃人になっちゃうけど」"
msgstr ""
"「不过……\n"
"　直接让脑部承受电刺激的你　会失去记忆变成废人\n"
"　」"

#. ID 12, Page 1, Line 76, Pos (8,8)
#. ID 15, Page 1, Line 124, Pos (10,24)
msgid ""
"\\n[\\v[6]]\n"
"「い……いやっ、うそ……」"
msgstr "\\n[\\v[6]]「不……不要，骗人……」"

#. ID 12, Page 1, Line 82, Pos (8,8)
msgid ""
"「私は\\n[\\v[6]]、\n"
"　あなたが研究所で生まれたモンスターだったの」"
msgstr "「我是\\n[\\v[6]]，　你是在研究所诞生的怪物」"

#. ID 12, Page 1, Line 84, Pos (8,8)
msgid ""
"「あなたは退治されて、\n"
"　私の……\\n[\\v[6]]の記憶を取り返すのよ」"
msgstr ""
"「你被讨伐了，　我要取回我的……\n"
"　\\n[\\v[6]]的记忆哦」"

#. ID 12, Page 1, Line 90, Pos (8,8)
#. ID 15, Page 1, Line 137, Pos (10,24)
msgid ""
"\\n[\\v[6]]\n"
"「いやっ！　やめて！　離してッ！」"
msgstr "\\n[\\v[6]]「不要！　住手！　放开我！」"

#. ID 12, Page 1, Line 105, Pos (8,8)
#. ID 15, Page 1, Line 153, Pos (10,24)
msgid ""
"\\n[\\v[6]]\n"
"「ひ……ひぃっ………」"
msgstr "\\n[\\v[6]]「噫……噫咿………」"

#. ID 12, Page 1, Line 112, Pos (8,8)
msgid ""
"「怖いの？\n"
"　安心して……すぐに何もなくなるわ」"
msgstr "「害怕吗？　放心吧……很快就会什么都没有了」"

#. ID 12, Page 1, Line 123, Pos (8,8)
#. ID 15, Page 1, Line 179, Pos (10,24)
msgid ""
"\\n[\\v[6]]\n"
"「い……いや……\n"
"　お願い……いや、やめて……」"
msgstr "\\n[\\v[6]]「不……不要……　求求你……不要，住手……」"

#. ID 12, Page 1, Line 136, Pos (8,8)
#. ID 15, Page 1, Line 192, Pos (10,24)
msgid ""
"\\n[\\v[6]]\n"
"「い、いやぁぁぁぁぁぁ―――――！」"
msgstr "\\n[\\v[6]]「不、不要啊啊啊啊啊啊―――――！」"

#. ID 12, Page 1, Line 147, Pos (8,8)
msgid "\\S[2]「大丈夫よ……ほら$g」"
msgstr "\\S[2]「没事的……你看$g」"

#. ID 12, Page 1, Line 156, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「ひ、はあぁっ！？　いやっ、な、なに、\n"
"　なに、な、なにこれぇっ$g」"
msgstr ""
"\\S[2]\\n[\\v[6]]「噫、哈啊！？　不要，什、什么，\n"
"　什么，这、这是什么啊$g」"

#. ID 12, Page 1, Line 163, Pos (8,8)
msgid "\\S[2]「キモチイイ……でしょう？」"
msgstr "\\S[2]「很舒服……对吧？」"

#. ID 12, Page 1, Line 164, Pos (8,8)
msgid ""
"\\S[2]「苦痛で記憶が壊れたり……\n"
"　暴れられたりされても困るから\n"
"　脳にあたえる電気信号は快楽だけを刺激するの」"
msgstr ""
"\\S[2]「如果因痛苦导致记忆损坏……\n"
"　或者你闹起来我也会很麻烦　所以对脑施加的电信\n"
"　号只刺激快感」"

#. ID 12, Page 1, Line 173, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「んああぁっ$g　いっ、ああっ$g」"
msgstr "\\S[2]\\n[\\v[6]]「嗯啊啊$g　呜、啊啊$g」"

#. ID 12, Page 1, Line 179, Pos (8,8)
msgid ""
"\\S[2]「苦痛は抗えても……\n"
"　快楽を我慢できる人間は居ないわ」"
msgstr ""
"\\S[2]「痛苦或许能抵抗……\n"
"　但能忍受快感的人可不存在」"

#. ID 12, Page 1, Line 185, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「んひっ$g　だめ、それぇっ$g」"
msgstr "\\S[2]\\n[\\v[6]]「嗯咿$g　不行，那里$g」"

#. ID 12, Page 1, Line 187, Pos (8,8)
msgid "\\S[2]「……って、もうトロトロなのね」"
msgstr "\\S[2]「……我说，已经变得软绵绵了呢」"

#. ID 12, Page 1, Line 188, Pos (8,8)
msgid ""
"\\S[2]「いいわ……快楽で一杯にして\n"
"　\\n[\\v[6]]の記憶を全て返してもらうわよ\n"
"　あなたを馬鹿にしてあげる」"
msgstr ""
"\\S[2]「好啊……\n"
"　用快感填满你　\\n[\\v[6]]的记忆全部还回来哦　我\n"
"　会好好羞辱你的」"

#. ID 12, Page 1, Line 195, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「ひっ$g　は、はひっ$g　ひゃめ、\n"
"　ひゃめてぇぇぇぇ………」"
msgstr ""
"\\S[2]\\n[\\v[6]]「噫$g　哈、哈咿$g　不要，\n"
"　住手啊啊啊啊………」"

#. ID 12, Page 1, Line 203, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「んひぃぃぃぃぃ$g$g」"
msgstr "\\S[2]\\n[\\v[6]]「嗯咿咿咿咿咿$g$g」"

#. ID 12, Page 1, Line 223, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「いやぁああっ$g　\n"
"　も、もうだめ、らめええぇ$g」\\.\\^"
msgstr ""
"\\S[2]\\n[\\v[6]]「不要啊啊$g　　已、已经不行了，\n"
"不行了啊啊$g」\\.\\^"

#. ID 12, Page 1, Line 229, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「んほぉぉぉおぉっ$g　ほおぉおおっ$g」\\.\\^"
msgstr "\\S[2]\\n[\\v[6]]「嗯嗬啊啊啊$g　嗬啊啊啊$g」\\.\\^"

#. ID 12, Page 1, Line 234, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「ああああ\"あ\"っ$g　ん\"いううううう\"$g」\\.\\^"
msgstr ""
"\\S[2]\\n[\\v[6]]\n"
"「啊啊啊啊\"啊\"$g　嗯\"咿呜呜呜呜\"$g」\\.\\^"

#. ID 12, Page 1, Line 239, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「らめえええぇっ$g$g　もうらめぇぇ$g\n"
"　あ、あへえええええええっ$g」\\.\\^"
msgstr ""
"\\S[2]\\n[\\v[6]]\n"
"「不行了了了了$g$g　已经不行了$g　啊、\n"
"　啊嘿诶诶诶诶诶诶$g」\\.\\^"

#. ID 12, Page 1, Line 245, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「くぅぁぁ……$g　んひゅぅぅ……$g」\\.\\^"
msgstr "\\S[2]\\n[\\v[6]]「呜啊啊……$g　嗯咻呜呜……$g」\\.\\^"

#. ID 12, Page 1, Line 250, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「ふひゃぁぁああぁぁぁ$g$g」\\.\\^"
msgstr "\\S[2]\\n[\\v[6]]「呼呀啊啊啊啊啊啊$g$g」\\.\\^"

#. ID 12, Page 1, Line 271, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「あ～……$g　あ～……$g」"
msgstr "\\S[2]\\n[\\v[6]]「啊～……$g　啊～……$g」"

#. ID 12, Page 1, Line 277, Pos (8,8)
msgid ""
"\\S[2]\n"
"「もう良いわね……」"
msgstr "\\S[2]「已经够了吧……」"

#. ID 12, Page 1, Line 293, Pos (8,8)
msgid ""
"\\S[2]\n"
"「私は\\n[\\v[6]]……\n"
"　あなたは私に倒されたモンスター」"
msgstr "\\S[2]「我\\n[\\v[6]]……　你是被我打倒的怪物」"

#. ID 12, Page 1, Line 300, Pos (8,8)
msgid ""
"\\S[2]\n"
"「だから\\n[\\v[6]]の……私の身体が\n"
"　残らないよう、ここで身体をバラバラにするわ」"
msgstr ""
"\\S[2]「所以\\n[\\v[6]]的……为了不留下我的身体，\n"
"就在这里把身体拆散吧」"

#. ID 12, Page 1, Line 319, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「あぁああ～ぁっ$g　んぁあぁ～～っ$g」\\.\\^"
msgstr ""
"\\S[2]\\n[\\v[6]]「啊啊啊啊～啊$g　嗯啊啊～～$g」\n"
"\\.\\^"

#. ID 12, Page 1, Line 325, Pos (8,8)
msgid ""
"\\S[2]\n"
"「でも大丈夫……脳にはずっと快楽を\n"
"　流し込んであげるから、痛くない」"
msgstr ""
"\\S[2]「但是没关系……\n"
"我会一直把快感　注入你的大脑，所以不会痛」"

#. ID 12, Page 1, Line 332, Pos (8,8)
msgid ""
"\\S[2]\n"
"「脳だけになっても、キモチイイ」"
msgstr "\\S[2]「即使只剩下大脑，也会很舒服」"

#. ID 12, Page 1, Line 350, Pos (8,8)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「おぉぁ～～……$g　あ～～っ……$g」\\.\\^"
msgstr ""
"\\S[2]\\n[\\v[6]]「哦啊啊～～……$g　啊～～……$g」\n"
"\\.\\^"

#. ID 12, Page 1, Line 356, Pos (8,8)
msgid ""
"\\S[2]\n"
"「身体がなくなっていっても……\n"
"　ずっとずっと……キモチイイ……$g」"
msgstr ""
"\\S[2]「即使身体渐渐消失……　一直一直……很舒服……\n"
"$g」"

#. ID 12, Page 1, Line 397, Pos (8,8)
msgid ""
"\\n[\\v[6]]\n"
"「さよなら」"
msgstr "\\n[\\v[6]]「再见」"

#. ID 15, Page 1, Line 16, Pos (10,24)
msgid "\\S[2]＊動けない……体が動かない"
msgstr "\\S[2]＊无法行动……身体动不了"

#. ID 15, Page 1, Line 34, Pos (10,24)
msgid "「気がついたか？」"
msgstr "「你醒了吗？」"

#. ID 15, Page 1, Line 40, Pos (10,24)
msgid ""
"「このまま気を失っている間に済ませるつもり\n"
"　だったが……薬剤を投与して正解、だった」"
msgstr ""
"「本来打算趁你一直昏迷时把事情办完　但是……\n"
"　给你用药是正确的」"

#. ID 15, Page 1, Line 44, Pos (10,24)
msgid ""
"「このまま気を失っている間に済ませるつもり\n"
"　だったが……拘束しておいて正解、だった」"
msgstr ""
"「本来打算趁你一直昏迷时把事情办完　但是……\n"
"　事先拘束你是正确的」"

#. ID 15, Page 1, Line 50, Pos (10,24)
msgid ""
"「早くやろう」\n"
"\n"
"　　　　　　　　　　　　　「はやく」"
msgstr "「快点做吧」　　　　　　　　　　　　　「快点」"

#. ID 15, Page 1, Line 53, Pos (10,24)
msgid ""
"\n"
"「おちつけ」\n"
"　　　　　　　　　　　　「あわてるな」"
msgstr "「冷静点」　　　　　　　　　　　　「别慌」"

#. ID 15, Page 1, Line 70, Pos (10,24)
msgid "「研究材料が足りない」"
msgstr "「研究材料不够」"

#. ID 15, Page 1, Line 71, Pos (10,24)
#. ID 15, Page 1, Line 96, Pos (10,24)
msgid "「肉が足りないんだ、新鮮な肉が」"
msgstr "「肉不够，新鲜的肉」"

#. ID 15, Page 1, Line 72, Pos (10,24)
msgid "「サンプルの人間もすでに尽きてしまった」"
msgstr "「作为样本的人类也已经耗尽了」"

#. ID 15, Page 1, Line 73, Pos (10,24)
#. ID 15, Page 1, Line 98, Pos (10,24)
msgid "「我々には既に肉体は遺されていない」"
msgstr "「我们已不再拥有肉体」"

#. ID 15, Page 1, Line 78, Pos (10,24)
msgid "「実験に使う、サンプルが足りない……」"
msgstr "「用于实验的样本不够……」"

#. ID 15, Page 1, Line 83, Pos (10,24)
msgid ""
"「我々の身体も、もう使い切ってしまった\n"
"　サンプルが必要なんだ……\n"
"　もう種族を選んではいられない」"
msgstr ""
"「我们的身体也已经用尽了　需要样本……\n"
"　已经不能挑种族了」"

#. ID 15, Page 1, Line 90, Pos (10,24)
msgid ""
"「君の肉体を使いたい……\n"
"　足先から頭の上まで全て……\n"
"　私たちの研究欲を満たすために、解体する」"
msgstr ""
"「想用你的肉体……　从脚尖到头顶全部……\n"
"　为了满足我们的研究欲，要解体」"

#. ID 15, Page 1, Line 95, Pos (10,24)
msgid "「人体が足りない」"
msgstr "「人体不够」"

#. ID 15, Page 1, Line 97, Pos (10,24)
msgid "「サンプルの内臓もすでに尽きてしまった」"
msgstr "「作为样本的内脏也已经耗尽了」"

#. ID 15, Page 1, Line 103, Pos (10,24)
msgid "「実験に使う、生きた肉体が足りない……」"
msgstr "「用于实验的活体肉体不够……」"

#. ID 15, Page 1, Line 108, Pos (10,24)
msgid ""
"「我々の身体は、もう使い切ってしまった\n"
"　健全で健康な肉体が必要なんだ」"
msgstr "「我们的身体已经用尽了　需要健全而健康的肉体」"

#. ID 15, Page 1, Line 114, Pos (10,24)
msgid ""
"「君の肉体を使いたい……\n"
"　爪の一片から髪の切先まで全て……\n"
"　ここでバラバラに分け、新鮮なまま保存する」"
msgstr ""
"「想用你的肉体……　从一片指甲到发梢全部……\n"
"　在这里拆散，保持新鲜保存」"

#. ID 15, Page 1, Line 130, Pos (10,24)
msgid ""
"「時間が無い……\n"
"　一秒ですら我々には惜しいのだ」"
msgstr "「没有时间了……　连一秒对我们来说都很可惜」"

#. ID 15, Page 1, Line 132, Pos (10,24)
msgid "「早速、君の肉体を解体させてもらおう」"
msgstr "「事不宜迟，就让我们来解体你的肉体吧」"

#. ID 15, Page 1, Line 161, Pos (10,24)
msgid ""
"「……ほう、スライムでも排泄をするのだな\n"
"　すばらしい……新しい発見だ」"
msgstr ""
"「……哦，原来史莱姆也会排泄啊　太棒了……\n"
"　这是新的发现」"

#. ID 15, Page 1, Line 165, Pos (10,24)
msgid ""
"「……我々はもう尿を出すことすら\n"
"　出来ないのに……\n"
"　羨ましい……赤い血の流れる身体が」"
msgstr ""
"「……我们甚至连排尿都　做不到了……　真羡慕……\n"
"　流淌着红色血液的身体」"

#. ID 15, Page 1, Line 204, Pos (10,24)
msgid "\\S[2]「まずは指先の部分からいただこう……」"
msgstr "\\S[2]「先从指尖部分开始吧……」"

#. ID 15, Page 1, Line 207, Pos (10,24)
msgid "\\S[2]「まずは腹部にメスを」"
msgstr "\\S[2]「首先对腹部下刀」"

#. ID 15, Page 1, Line 222, Pos (10,24)
msgid "\\S[2]「ほう……」"
msgstr "\\S[2]「哦……」"

#. ID 15, Page 1, Line 224, Pos (10,24)
msgid ""
"\\S[2]\n"
"「スライムといえど痛覚はあるのだな……」"
msgstr "\\S[2]「即使是史莱姆，也有痛觉啊……」"

#. ID 15, Page 1, Line 226, Pos (10,24)
msgid ""
"\\S[2]\n"
"「ふむ\n"
"　千切り取った部分は別々に活動するのか……」"
msgstr "\\S[2]「嗯　切下来的部分会分别活动吗……」"

#. ID 15, Page 1, Line 229, Pos (10,24)
msgid ""
"\\S[2]\n"
"「すばらしい生命力だ……\n"
"　その秘密を解き明かさなければ……」"
msgstr ""
"\\S[2]「真是惊人的生命力……　必须解开其中的秘密…\n"
"…」"

#. ID 15, Page 1, Line 236, Pos (10,24)
msgid "\\S[2]「では順次、サンプルとして取り出そう……」"
msgstr "\\S[2]「那么依次作为样本取出吧……」"

#. ID 15, Page 1, Line 239, Pos (10,24)
msgid ""
"\\S[2]\n"
"「綺麗な腸……胃だ……」"
msgstr "\\S[2]「漂亮的肠……胃……」"

#. ID 15, Page 1, Line 241, Pos (10,24)
msgid ""
"\\S[2]\n"
"「我々にはもう……\n"
"　残ってすらいない……」"
msgstr "\\S[2]「我们已经……　连这些都不剩了……」"

#. ID 15, Page 1, Line 248, Pos (10,24)
msgid "\\S[2]「では内臓を取り出していこう……」"
msgstr "\\S[2]「那么开始取出内脏吧……」"

#. ID 15, Page 1, Line 251, Pos (10,24)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「い、い\"や\"……ッ！　どら\"ない\"で……！」"
msgstr "\\S[2]\\n[\\v[6]]「不、不\"要\"……！　别\"拿走\"……！」"

#. ID 15, Page 1, Line 261, Pos (10,24)
msgid ""
"\\S[2]＊\\n[\\v[6]]\n"
"「があ\"ッ！？」"
msgstr "\\S[2]＊\\n[\\v[6]]「嘎啊\"！？」"

#. ID 15, Page 1, Line 268, Pos (10,24)
msgid "\\S[2]「次は足にあたる部分を……」"
msgstr "\\S[2]「接下来是相当于脚的部分……」"

#. ID 15, Page 1, Line 280, Pos (10,24)
msgid "\\S[2]「私は腹部を……」"
msgstr "\\S[2]「我要腹部……」"

#. ID 15, Page 1, Line 292, Pos (10,24)
msgid ""
"\\S[2]「性器の部分をいただこう……\n"
"　スライムの生殖には興味がある……」"
msgstr ""
"\\S[2]「性器官部分就交给我吧……\n"
"　我对史莱姆的生殖很有兴趣……」"

#. ID 15, Page 1, Line 305, Pos (10,24)
msgid "\\S[2]「では腕を……」"
msgstr "\\S[2]「那么手臂……」"

#. ID 15, Page 1, Line 308, Pos (10,24)
msgid "\\S[2]「まずは胃を……」"
msgstr "\\S[2]「首先是胃……」"

#. ID 15, Page 1, Line 320, Pos (10,24)
msgid "\\S[2]「私は腸を……」"
msgstr "\\S[2]「我要肠子……」"

#. ID 15, Page 1, Line 332, Pos (10,24)
msgid ""
"\\S[2]「肝臓を半分いただこう……\n"
"この肉体の肝臓ならばきっと抗原が……」"
msgstr ""
"\\S[2]「肝脏就取一半吧……这个肉体的肝脏的话，\n"
"一定会有抗原……」"

#. ID 15, Page 1, Line 345, Pos (10,24)
msgid "\\S[2]「脾臓を……」"
msgstr "\\S[2]「脾脏……」"

#. ID 15, Page 1, Line 357, Pos (10,24)
msgid "\\S[2]「膵臓……」"
msgstr "\\S[2]「胰腺……」"

#. ID 15, Page 1, Line 371, Pos (10,24)
msgid "\\S[2]「………」"
msgstr "\\S[2]「………」"

#. ID 15, Page 1, Line 407, Pos (10,24)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「も……も、う\"……\n"
"　や\"め……で……」"
msgstr "\\S[2]\\n[\\v[6]]「已……已经\"……　住\"手……吧……」"

#. ID 15, Page 1, Line 411, Pos (10,24)
msgid ""
"\\S[2]\n"
"「ふむ……個々の破片は生きているのだが\n"
"　こうも苦痛を感じるとは興味深い……」"
msgstr ""
"\\S[2]「嗯……\n"
"每一块碎片都还活着　不过竟能感受到如此痛苦，\n"
"　真有意思……」"

#. ID 15, Page 1, Line 414, Pos (10,24)
msgid ""
"\\S[2]\n"
"「自我を維持する限界があるのだろう……\n"
"　知的スライムが人の形を取る理由か」"
msgstr ""
"\\S[2]「这大概就是维持自我的极限吧……\n"
"　这就是智慧史莱姆采取人形的理由吗」"

#. ID 15, Page 1, Line 419, Pos (10,24)
msgid ""
"\\S[2]\n"
"「ほう……もう内臓も殆ど無いのに\n"
"　まだ生きていられるのか」"
msgstr "\\S[2]「哦……内脏几乎都没有了　却还能活着吗」"

#. ID 15, Page 1, Line 422, Pos (10,24)
msgid ""
"\\S[2]\n"
"「肺と心臓さえ残せば……\n"
"　短期の生命維持は可能ということだろう」"
msgstr ""
"\\S[2]「只要留下肺和心脏……\n"
"　就能维持短期生命吧」"

#. ID 15, Page 1, Line 427, Pos (10,24)
msgid ""
"\\S[2]\n"
"「貴重なデータだ」"
msgstr "\\S[2]「这是宝贵的数据」"

#. ID 15, Page 1, Line 433, Pos (10,24)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「お\"ねがいでず……もう\"やめでぐださ……」"
msgstr "\\S[2]\\n[\\v[6]]「求\"你了……请\"住手吧……」"

#. ID 15, Page 1, Line 436, Pos (10,24)
msgid ""
"\\S[2]\n"
"「では頭部を構成する部分を切除しよう……\n"
"　……どちらに自我が残るのか見ものだ」"
msgstr ""
"\\S[2]「那么切除构成头部的部分吧……　……\n"
"自我会留在哪一边，值得一看」"

#. ID 15, Page 1, Line 444, Pos (10,24)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「お\"ねがい……そ、それだげは……\n"
"　わだじ、が消える、ぎえる……ぞれ残じて…」"
msgstr ""
"\\S[2]\\n[\\v[6]]「求\"你了……唯、唯独那个……　我、\n"
"会消失、会消失……留下那个…」"

#. ID 15, Page 1, Line 449, Pos (10,24)
msgid ""
"\\S[2]\n"
"「では肺と心臓は最後に採取しよう……\n"
"　……先に目をもらおう」"
msgstr ""
"\\S[2]「那么肺和心脏最后再采集吧……　……\n"
"先收下眼睛吧」"

#. ID 15, Page 1, Line 457, Pos (10,24)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「お\"ねがい……め、めだげは……\n"
"　わだじ、人のかたち、だげは、残して…」"
msgstr ""
"\\S[2]\\n[\\v[6]]「求\"求你……眼、眼睛……　我、\n"
"人的形状，至少……留下来…」"
