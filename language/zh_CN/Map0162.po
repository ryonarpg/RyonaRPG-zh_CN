#. ID 13, Page 2, Line 3, Pos (12,13)
msgid ""
"ひっ……ひっ……\n"
"\\.………やっ……"
msgstr "呜……抽……\\.………不要……"

#. ID 14, Page 2, Line 3, Pos (11,7)
msgid "んぉっ……んぉぉおぉぉおぉ……っ！！"
msgstr "嗯哦……嗯哦哦哦哦哦……！！"

#. ID 15, Page 2, Line 3, Pos (18,7)
msgid ""
"ひっ……ひっ……\n"
"\\.………んぁぁ……"
msgstr "呜……抽……\\.………嗯啊啊……"

#. ID 15, Page 2, Line 5, Pos (18,7)
#. Contains choice at line 2 (2 options)
msgid "この娘とスライムのプレイを見ますか？"
msgstr "要观看这个女孩与史莱姆的表演吗？"

#. ID 15, Page 2, Line 6, Pos (18,7)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 15, Page 2, Line 13, Pos (18,7)
msgid "あはっ♪ねぇはやく……"
msgstr "啊哈♪喂，快点……"

#. ID 15, Page 2, Line 19, Pos (18,7)
msgid "いっきゅうん！！"
msgstr "要去了——！！"

#. ID 15, Page 2, Line 20, Pos (18,7)
msgid ""
"あはぁ……♪\n"
"ボクのアナルにぃ……うんち出すところに\n"
"スライムさんがはいってきたぁ♪"
msgstr ""
"啊哈……♪我的肛门里……我拉大便的地方，\n"
"史莱姆先生进来了♪"

#. ID 15, Page 2, Line 28, Pos (18,7)
msgid ""
"あひんっ！\n"
"ずりゅっ、ずりゅうってボクのうんち穴にぃ！"
msgstr "啊嗯！哧溜、哧溜地钻进我的大便穴里！"

#. ID 15, Page 2, Line 35, Pos (18,7)
msgid ""
"くぅん！\n"
"もっとぉ、もっと奥までぇ……♪\n"
"アナルぐちゅぐちゅにしてぇ♪"
msgstr "唔嗯！再、再往深处……♪把肛门弄得咕啾咕啾的♪"

#. ID 15, Page 2, Line 38, Pos (18,7)
msgid ""
"ボクのうんち穴はぁ、こ～もんもなかもぉ\n"
"あなりゅのしわしわだって\n"
"ぜ～んぶスライムさんの物なんだからぁ♪"
msgstr ""
"我的大便穴啊，肛门也好里面也好，\n"
"连肛门的褶皱也全都～是史莱姆先生的东西♪"

#. ID 15, Page 2, Line 46, Pos (18,7)
msgid ""
"いいっ！いいよぉ！！\n"
"もっとボクのうんち穴ぐちゃぐちゃにしてぇ！"
msgstr "好棒！好啊！！再多把我的大便穴弄得乱七八糟！"

#. ID 15, Page 2, Line 51, Pos (18,7)
msgid ""
"あははっ♪\n"
"ボクのうん……ち……あなぁ\n"
"もう……うんちあ……なじゃ……ないぃ♪"
msgstr "啊哈哈♪我的大……便……穴已经……不是大便穴……了♪"

#. ID 15, Page 2, Line 59, Pos (18,7)
msgid ""
"くひぃん！\n"
"……ボクのうんち穴はぁっ！もうスライムさん専用のぉ\n"
"けつまんこなのぉぉぉぉ！！"
msgstr ""
"呜嘻嗯！……我的大便穴啊！\n"
"已经是史莱姆先生专用的屁眼了啊——！！"

#. ID 15, Page 2, Line 67, Pos (18,7)
msgid ""
"いいのぉ！けつまんこいいのぉ！\n"
"ボクはスライムさんのためのけつまんこ奴隷だからぁ！"
msgstr ""
"好棒啊！屁眼好棒啊！\n"
"因为我是为了史莱姆先生而存在的屁眼奴隶啊！"

#. ID 15, Page 2, Line 69, Pos (18,7)
msgid ""
"スライムさんはいつでもボクのけつまんこぉ\n"
"弄んでいいのぉ！"
msgstr "史莱姆先生随时都可以玩弄我的屁眼啊！"

#. ID 15, Page 2, Line 76, Pos (18,7)
msgid ""
"好きなときにボクのけつまんこいぢってぇ！\n"
"中も外もぐちゅぐちゅにしてぇ！\n"
"ボクの腸内ぜんぶスライムさんの物にしてぇぇ！！"
msgstr ""
"想什么时候就玩弄我的屁眼！\n"
"里面外面都弄得咕啾咕啾！\n"
"把我的肠子里全都变成史莱姆先生的东西——！！"

#. ID 15, Page 2, Line 84, Pos (18,7)
msgid ""
"おなかいっぱいになるまで\n"
"スライムさんのせ～えきぃ！ザ～メン！\n"
"ちんぽ汁ぅ！注ぎこんでぇぇぇぇぇ！！！"
msgstr ""
"直到我肚子装满为止，史莱姆先生的精～液！\n"
"精～液！鸡巴汁！全灌进来——！！！"

#. ID 15, Page 2, Line 92, Pos (18,7)
msgid "あひぃぃぃぃぃぃぃぃん！！！！"
msgstr "啊嘻——！！！！"

#. ID 15, Page 2, Line 106, Pos (18,7)
msgid "くぅぅぅん……いっぱいでてるぅ……"
msgstr "唔——……流出来好多……"

#. ID 15, Page 2, Line 118, Pos (18,7)
msgid ""
"あぁ……あふれちゃってるぅ……\n"
"もったいないよぉ……じゅるっ……じゅるっ……\n"
"じゅるるるるっ…ごきゅっ"
msgstr ""
"啊……溢出来了……好浪费啊……啾噜……啾噜……\n"
"啾噜噜噜噜……咕咚"

#. ID 15, Page 2, Line 121, Pos (18,7)
msgid "スライムさんのちんぽ汁ぅ……おいしいよぉ……♪"
msgstr "史莱姆先生的鸡巴汁……好好吃哦……♪"

#. ID 15, Page 2, Line 131, Pos (18,7)
msgid ""
"あぁん……まだでてるぅ……\n"
"ボク、し　あ　わ　せ　ぇ　♪"
msgstr "啊嗯……还在流出来……我，好　幸　福　啊　♪"

#. ID 15, Page 2, Line 139, Pos (18,7)
msgid "ひきゅっ！？"
msgstr "咻啾！？"

#. ID 15, Page 2, Line 145, Pos (18,7)
msgid "あっくぅん！"
msgstr "啊唔嗯！"

#. ID 15, Page 2, Line 151, Pos (18,7)
msgid "あはぁんっ！"
msgstr "啊哈嗯！"

#. ID 15, Page 2, Line 152, Pos (18,7)
msgid ""
"食べてるぅ……\n"
"スライムさんボクのうんち食べてるぅ……"
msgstr "在吃……史莱姆先生在吃我的大便……"

#. ID 15, Page 2, Line 159, Pos (18,7)
msgid ""
"おなかの中から\n"
"直接うんち食べられちゃうなんてぇ……"
msgstr "竟然从肚子里直接吃我的大便……"

#. ID 15, Page 2, Line 161, Pos (18,7)
msgid "きもちよすぎるよぉっ！"
msgstr "太舒服了！"

#. ID 15, Page 2, Line 167, Pos (18,7)
msgid ""
"もっと食べてぇ！おなかのなかのうんち\n"
"ぜんぶ食べていいからぁ！"
msgstr "多吃点！肚子里的大便全都吃掉也可以！"

#. ID 15, Page 2, Line 174, Pos (18,7)
msgid ""
"うんちなくなったらまたちんぽ汁たくさんちょうだい！\n"
"スライムさんのちんぽ汁食べて\n"
"ボクいっぱいうんち作るからぁ！！"
msgstr ""
"大便没了的话再给我好多鸡巴汁！\n"
"我会吃史莱姆先生的鸡巴汁，做很多大便的！！"

#. ID 15, Page 2, Line 192, Pos (18,7)
msgid ""
"うきゅぅぅぅぅぅ！！\n"
"イクッ！イッちゃうぅぅぅぅぅ！"
msgstr "呜啾——！！要去了！要去了——！"

#. ID 15, Page 2, Line 207, Pos (18,7)
msgid ""
"ちんぽ汁ぅ！\n"
"ボクのけつまんこに溢れるくらいしゃせ～されて\n"
"イッちゃうのぉぉぉぉぉぉぉぉ！！"
msgstr "鸡巴汁！我的屁眼被射～到溢出来，要去了——！！"

#. ID 15, Page 2, Line 219, Pos (18,7)
msgid ""
"はぁ……はぁ……ずっと一緒だよ……\n"
"スライムさん……♪"
msgstr "哈啊……哈啊……一直在一起哦……史莱姆先生……♪"

#. ID 15, Page 2, Line 221, Pos (18,7)
msgid ""
"少女はこちらにまるで気づかない\n"
"だがその顔は満ち足りており\n"
"とても幸せそうに見える"
msgstr ""
"少女完全没有注意到这边，但她的脸显得很满足，\n"
"看起来非常幸福"

#. ID 16, Page 2, Line 3, Pos (22,13)
msgid ""
"く……ひっ……\n"
"\\.………っ……はっ……ぁ……"
msgstr "呜……抽……\\.………唔……哈……啊……"
