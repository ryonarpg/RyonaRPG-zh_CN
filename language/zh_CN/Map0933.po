#. ID 119, Page 5, Line 357, Pos (31,27)
msgid ""
"\n"
"ソウルポット４ を \\v[1203]個手に入れた"
msgstr "获得了 \\v[1203] 个灵魂壶4"

#. ID 176, Page 2, Line 5, Pos (28,30)
msgid ""
"\n"
"…理論では……、\n"
"十分な経験と…空のソウルポットがあれば……\\|\\^"
msgstr "…理论上……、只要有足够的经验和…空的灵魂壶……\\|\\^"

#. ID 176, Page 2, Line 11, Pos (28,30)
msgid ""
"\n"
"…思念を…、強化するのだ……\\|\\^"
msgstr "…将思念…、加以强化……\\|\\^"

#. ID 176, Page 2, Line 16, Pos (28,30)
msgid ""
"\n"
"…次元を…、技術が足りない……\\|\\^"
msgstr "…次元…、技术还不足……\\|\\^"

#. ID 176, Page 2, Line 21, Pos (28,30)
msgid ""
"\n"
"…核となるのは…自らの……、他人の思念では…\\|\\^"
msgstr "…成为核心的是…自己的……、用他人的思念则…\\|\\^"

#. ID 176, Page 2, Line 26, Pos (28,30)
msgid ""
"\n"
"…不足したエネルギー…、理想の再現には…\\|\\^"
msgstr "…不足的能量…、对于理想的再现而言…\\|\\^"

#. ID 176, Page 2, Line 31, Pos (28,30)
msgid ""
"\n"
"…私の…名は……、後世に…残すのだ……\\|\\^"
msgstr "…我的…名字……、要留给后世……\\|\\^"

#. ID 176, Page 2, Line 36, Pos (28,30)
msgid ""
"\n"
"…次元の観測に…、波長の乱れが……\\|\\^"
msgstr "…在次元观测中…、波长出现了紊乱……\\|\\^"

#. ID 177, Page 3, Line 12, Pos (1,5)
msgid "空間の歪みに吸い込まれる！"
msgstr "被吸入空间的扭曲之中！"

#. ID 178, Page 2, Line 4, Pos (27,30)
#. Contains choice at line 3 (2 options)
msgid ""
"\n"
"メモ書きがある"
msgstr "有张便条"

#. ID 178, Page 2, Line 8, Pos (27,30)
msgid "…触媒に適さない物質について"
msgstr "…关于不适合作为触媒的物质"

#. ID 178, Page 2, Line 9, Pos (27,30)
msgid ""
"………の実験から、いくつかの装備については、\n"
"別次元からのエネルギー抽出の触媒としては\n"
"適さないことが予想されている。"
msgstr ""
"………从……的实验来看，\n"
"预计某些装备不适合作为从异次元抽取能量的触媒。"

#. ID 178, Page 2, Line 12, Pos (27,30)
msgid ""
"特に注意が必要なのは、\n"
"逃亡防止や脱出防止の魔法がかけられた物品だ。\n"
"淫虐の首輪やノウブルカラーが該当する。"
msgstr ""
"特别需要注意的是，\n"
"被施加了防止逃亡或防止逃脱魔法的物品。\n"
"淫虐项圈和贵族项圈就属于此类。"

#. ID 178, Page 2, Line 15, Pos (27,30)
msgid ""
"装着者を拘束している魔法が\n"
"存在の保護として働くと予見されている。\n"
"奴隷を使う場合は重々注意されたし…"
msgstr ""
"可以预见到，\n"
"束缚着装者的魔法会作为对存在的保护发挥作用。\n"
"使用奴隶时请务必万分注意…"

#. ID 180, Page 2, Line 13, Pos (34,16)
msgid "着せ替え"
msgstr "换装"
