#. ID 13, Page 2, Line 61, Pos (2,11)
#. ID 13, Page 2, Line 91, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「ぅぐ…キャイン！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「呜咕…汪呜！"

#. ID 13, Page 2, Line 49, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「キャン！！！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「汪！！！"

#. ID 13, Page 2, Line 133, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「くぅん！くぅん！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「呜嗯！呜嗯！"

#. ID 13, Page 2, Line 154, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「！！！！！！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「！！！！！！"

#. ID 13, Page 2, Line 164, Pos (2,11)
#. ID 13, Page 3, Line 168, Pos (2,11)
msgid "……\\!……\\!……\\!……\\!……\\!……\\!……\\!……\\!……\\!"
msgstr "……\\!……\\!……\\!……\\!……\\!……\\!……\\!……\\!……\\!"

#. ID 13, Page 2, Line 184, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「\\!………ハッハッ！…………"
msgstr ""
"【\\N[\\V[6]]】\n"
"「\\!………哈、哈！…………"

#. ID 13, Page 3, Line 14, Pos (2,11)
#. ID 13, Page 3, Line 82, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「きゃあ！！！\n"
"　\\!鎖を引っ張らないでください！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「呀啊！！！　\\!请不要拉锁链！"

#. ID 13, Page 3, Line 25, Pos (2,11)
#. ID 13, Page 3, Line 93, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「カハァ！……痛い………\n"
"　鎖で首が絞まるんです！\n"
"　放してください！！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「咳哈！……好痛………\n"
"　锁链勒住脖子了！　请放开我！！"

#. ID 13, Page 3, Line 47, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「きゃあ！！！\n"
"　\\!何をするんですか！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「呀啊！！！　\\!你在做什么！"

#. ID 13, Page 3, Line 60, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「カハァ！……痛い………\n"
"　首が絞まります！\n"
"　鎖を放してください！！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「咳哈！……好痛………　脖子被勒住了！\n"
"　请放开锁链！！"

#. ID 13, Page 3, Line 137, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「な、何をするつもりですか！！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「你、你打算做什么！！"

#. ID 13, Page 3, Line 158, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「嫌ぁぁぁ！！！！！！"
msgstr ""
"【\\N[\\V[6]]】\n"
"「不要啊啊啊啊！！！！！！"

#. ID 13, Page 3, Line 188, Pos (2,11)
msgid ""
"【\\N[\\V[6]]】\n"
"「\\!………はぁ\\!………はぁ\\!…………\\!…………"
msgstr ""
"【\\N[\\V[6]]】\n"
"「\\!………哈啊\\!………哈啊\\!…………\\!…………"

#. ID 14, Page 1, Line 3, Pos (4,11)
msgid "ｿﾜｿﾜ……"
msgstr "坐立不安……"

#. ID 14, Page 2, Line 7, Pos (4,11)
msgid "ﾅﾃﾞﾅﾃﾞ"
msgstr "抚摸抚摸"

#. ID 14, Page 3, Line 3, Pos (4,11)
msgid "ﾄﾞｷﾄﾞｷ……"
msgstr "扑通扑通……"

#. ID 14, Page 4, Line 3, Pos (4,11)
msgid ""
"ﾌﾞｰｯ！\n"
"\\.……ﾊｧﾊｧ"
msgstr ""
"呼——！\n"
"\\.……哈啊哈啊"

#. ID 15, Page 1, Line 3, Pos (13,11)
msgid "…ト…トイレはどこだッ！"
msgstr "…厕…厕所在哪里！"

#. ID 15, Page 1, Line 4, Pos (13,11)
msgid ""
"右端の部屋は\\>\\c[2]アビリティの習得\\c[0]\\<でッ！\n"
"その隣の部屋は\\>\\c[2]キャラ変更\\c[0]\\<の部屋ッ！\n"
"そして三番目の部屋は\\>\\c[2]オプション設定\\c[0]\\<の部屋だがッ！"
msgstr ""
"最右端的房间是\\>\\c[2]能力习得\\c[0]\\<！\n"
"旁边那间房是\\>\\c[2]角色变更\\c[0]\\<的房间！\n"
"然后第三间房是\\>\\c[2]选项设置\\c[0]\\<的房间！"

#. ID 15, Page 1, Line 7, Pos (13,11)
msgid ""
"\n"
"俺が探しているのはッ！トイレなんだッ！"
msgstr "我要找的是！厕所啊！"

#. ID 15, Page 1, Line 13, Pos (13,11)
msgid ""
"ん？犬？\n"
"よし！そこらで用をたしてこの犬がしたことにすれば！"
msgstr ""
"嗯？狗？好！就在那附近解决，\n"
"然后当作是这只狗干的就行！"

#. ID 15, Page 1, Line 20, Pos (13,11)
msgid ""
"ん？猫？\n"
"よし！そこらで用をたしてこの猫がしたことにすれば！"
msgstr ""
"嗯？猫？好！就在那附近解决，\n"
"然后当作是这只猫干的就行！"

#. ID 15, Page 1, Line 22, Pos (13,11)
msgid ""
"【\\N[\\V[6]]】\n"
"………"
msgstr ""
"【\\N[\\V[6]]】\n"
"………"

#. ID 15, Page 1, Line 27, Pos (13,11)
msgid ""
"いってええ！！？\\!\n"
"冗談！冗談だよお！！"
msgstr "好痛啊啊！！？\\!玩笑！是开玩笑的啦！！"

#. ID 16, Page 1, Line 3, Pos (14,12)
#. Contains choice at line 2 (2 options)
msgid "おかみさん、綺麗だろう？"
msgstr "老板娘，很漂亮吧？"

#. ID 16, Page 2, Line 3, Pos (14,12)
msgid "ｽﾔｽﾔ･･･"
msgstr "呼呼・・・"

#. ID 16, Page 3, Line 3, Pos (14,12)
msgid "やあ、おはよう。"
msgstr "哎呀，早上好。"

#. ID 16, Page 3, Line 4, Pos (14,12)
msgid "もうこの村には馴染んだかい？"
msgstr "已经习惯这个村子了吗？"

#. ID 17, Page 1, Line 6, Pos (8,9)
msgid ""
"あっ、おはようございます\\c[11]$k\\c[0]\n"
"\\.昨晩はよく眠れましたか？"
msgstr "啊，早上好\\c[11]$k\\c[0]\\.昨晚睡得好吗？"

#. ID 17, Page 1, Line 10, Pos (8,9)
msgid ""
"いつでも私の所にきてくださいね？\\!\n"
"\\N[\\V[6]]さんが猫さんでも\n"
"私はいつでも可愛がってあげますから♪"
msgstr ""
"随时都可以来我这儿哦？\n"
"\\!\\N[\\V[6]]就算你变成猫猫，我也会随时疼爱你的♪"

#. ID 17, Page 1, Line 15, Pos (8,9)
msgid ""
"疲れた時は、無理せずに\n"
"私の部屋に来てくださいね♪\n"
"\\.精一杯、ご奉仕しますから……\\c[11]$k"
msgstr ""
"累的时候，不要勉强，\n"
"来我的房间吧♪\\.我会竭尽全力侍奉您……\\c[11]$k"

#. ID 19, Page 1, Line 5, Pos (17,11)
msgid ""
"昼と夜では、町にいる人が違うぜ。\n"
"特定の時間でしか行けない場所とか、\n"
"開いてない店とか、あるかもな。"
msgstr ""
"白天和夜晚，镇上的人会不同。\n"
"也许有只有在特定时间才能去的地方，\n"
"或者不开门的店。"

#. ID 19, Page 1, Line 10, Pos (17,11)
msgid "鏡を見れば、自分の容姿が確認できるぜ。"
msgstr "看看镜子就能确认自己的容貌哦。"

#. ID 19, Page 1, Line 13, Pos (17,11)
msgid "はっ！"
msgstr "哈！"

#. ID 19, Page 1, Line 14, Pos (17,11)
msgid ""
"ま、また何かが俺の体をハックして、\n"
"当たり前のことを言わせやがった…！"
msgstr ""
"又、又有什么东西入侵了我的身体，\n"
"让我说出这种理所当然的话…！"

#. ID 19, Page 2, Line 3, Pos (17,11)
msgid ""
"へへ、お嬢ちゃん…いい話があるんだがどうだ？\n"
"なんでも使われてない工場があるらしいんだが…\n"
"50Gでどうだ？"
msgstr ""
"嘿嘿，小姑娘…我有笔好买卖，怎么样？\n"
"听说有座没人使用的工厂…50G怎么样？"

#. ID 19, Page 2, Line 6, Pos (17,11)
#. Choice (2 options)
msgid ""
"教えて！\n"
"そう かんけいないね"
msgstr ""
"告诉我！\n"
"不，这和我没关系。"

#. ID 19, Page 2, Line 9, Pos (17,11)
msgid "金が足りねえよ…"
msgstr "钱不够啊…"

#. ID 19, Page 2, Line 12, Pos (17,11)
msgid "情報料として50G支払った。"
msgstr "作为情报费支付了50G。"

#. ID 19, Page 2, Line 14, Pos (17,11)
msgid "おっ、いいねえ。オレ気にいっちゃったよ"
msgstr "哦，不错嘛。我中意你了。"

#. ID 19, Page 2, Line 15, Pos (17,11)
msgid ""
"その廃工場ってのはここから南東にあって\n"
"噂によると兵器やら実験生物やらが徘徊してるらしい\n"
"まあ行くんなら、無事を祈るぜ"
msgstr ""
"那座废弃工厂从这里往东南方向，听说有兵器、\n"
"实验生物之类的在四处游荡。总之你要去的话，\n"
"祝你好运。"

#. ID 19, Page 2, Line 21, Pos (17,11)
msgid "◆廃工場　の情報を得た！"
msgstr "◆获得了废弃工厂　的情报！"

#. ID 19, Page 2, Line 27, Pos (17,11)
msgid "あぁ、そうか。それは残念だな"
msgstr "啊，这样啊。那真是遗憾。"

#. ID 19, Page 3, Line 3, Pos (17,11)
msgid "zzz…"
msgstr "zzz…"

#. ID 19, Page 3, Line 4, Pos (17,11)
msgid "……寝ている"
msgstr "……正在睡觉"

#. ID 20, Page 1, Line 3, Pos (10,9)
#. Contains choice at line 2 (2 options)
msgid "時間を進めるかえ？\\>\\c[10]（昼夜変更）\\c[0]"
msgstr "要推进时间吗？\\>\\c[10]（昼夜变更）\\c[0]"

#. ID 20, Page 1, Line 12, Pos (10,9)
msgid ""
"夜は魔物達が凶暴になる時間だから\n"
"気をつけるんだよ・・・"
msgstr ""
"夜晚是魔物们变得凶暴的时间，\n"
"所以要小心哦・・・"
