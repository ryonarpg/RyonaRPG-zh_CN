#. ID 7, Page 1, Line 3, Pos (17,8)
msgid "＊ 精神と時の部屋 ＊"
msgstr "＊ 精神与时间之屋 ＊"

#. ID 7, Page 1, Line 4, Pos (17,8)
#. Contains choice at line 2 (2 options)
msgid "＠アビリティを習得しますか？"
msgstr "＠要习得能力吗？"

#. ID 7, Page 1, Line 5, Pos (17,8)
#. Choice (2 options, embedded in a message)
#. ID 8, Page 3, Line 18, Pos (6,7)
#. Choice (2 options, embedded in a message)
#. ID 16, Page 1, Line 4, Pos (14,12)
#. Choice (2 options, embedded in a message)
#. ID 20, Page 1, Line 4, Pos (10,9)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 8, Page 1, Line 4, Pos (6,7)
msgid ""
"今空いてるのはこれだけだよ。\n"
"どの部屋にするね？"
msgstr "现在空着的只有这些哦。要哪间房呢？"

#. ID 8, Page 1, Line 14, Pos (6,7)
msgid ""
"金がないのかい…\n"
"\\.こっちも商売だからね。金がなきゃ\n"
"部屋を貸してはやれないよ。"
msgstr ""
"没钱吗……\\.我这边也是做生意嘛。\n"
"没钱的话可不能把房间租给你哦。"

#. ID 8, Page 1, Line 17, Pos (6,7)
#. ID 8, Page 1, Line 30, Pos (6,7)
msgid ""
"ま、どうしても休みたいなら\n"
"\\c[4]夜になってから\\c[0]2階のメイドに頼めば\n"
"ただで休ませてもらえるだろうけど、ね…"
msgstr ""
"嘛，如果无论如何都想休息的话，\n"
"\\c[4]入夜之后\\c[0]去求二楼的女仆，\n"
"也许就能免费让你休息，不过呢……"

#. ID 8, Page 1, Line 27, Pos (6,7)
msgid ""
"その部屋は満室だよ？\n"
"これでも結構繁盛してるのさ。\n"
"金があるやつにしか部屋は貸せないよ。"
msgstr ""
"那间房已经满房了哦？别看我这样，\n"
"生意还挺兴隆的。房间只能租给有钱的家伙哦。"

#. ID 8, Page 2, Line 11, Pos (6,7)
msgid ""
"ムチャすんなって言っただろ。\n"
"おとなしく上で寝てな。"
msgstr "别胡闹，我说过了吧。乖乖到上面睡吧。"

#. ID 8, Page 3, Line 12, Pos (6,7)
msgid ""
"ああ、あんたかい。\n"
"部屋は二階の奥の部屋を使いな"
msgstr "啊，是你啊。房间就用二楼里面那间吧"

#. ID 8, Page 3, Line 16, Pos (6,7)
#. Contains choice at line 3 (2 options)
msgid ""
"ああ、あんたかい。どうだい、\n"
"泊まる場所はあるのかい？"
msgstr "啊，是你啊。怎么样，有住的地方吗？"

#. ID 8, Page 3, Line 20, Pos (6,7)
msgid "そうかい、困ったらまたおいでよ"
msgstr "这样啊，有困难的话再来吧"

#. ID 8, Page 3, Line 24, Pos (6,7)
#. Contains choice at line 3 (2 options)
msgid ""
"うちで拾ったのも何かの縁だ、しばらく\n"
"泊まっていかないかい？"
msgstr ""
"既然是我家捡到的也算某种缘分，\n"
"要不要暂住一阵子？"

#. ID 8, Page 3, Line 26, Pos (6,7)
#. Choice (2 options, embedded in a message)
msgid ""
"よろしくおねがいします\n"
"せっかくですが・・・"
msgstr ""
"请多关照\n"
"难得您的好意，不过……"

#. ID 8, Page 3, Line 28, Pos (6,7)
msgid ""
"なら、二階の奥の部屋を使いな\n"
"朝食は無しだよ"
msgstr "那么，就用二楼里面那间房吧。没有早餐哦"

#. ID 8, Page 3, Line 33, Pos (6,7)
msgid "そう、なら気をつけて行きな"
msgstr "这样啊，那就路上小心"

#. ID 8, Page 5, Line 12, Pos (6,7)
#. ID 8, Page 6, Line 12, Pos (6,7)
msgid "おはよう。昨夜はよく眠れたかい？"
msgstr "早上好。昨晚睡得好吗？"

#. ID 8, Page 6, Line 15, Pos (6,7)
msgid "\\s[2]ふッ！？・・・ん・・・・"
msgstr "\\s[2]呼！？……嗯……"

#. ID 8, Page 6, Line 16, Pos (6,7)
msgid ""
"いや、なんでもないよ\n"
"気にしないでおくれ"
msgstr "不，没什么。别在意"

#. ID 8, Page 10, Line 9, Pos (6,7)
msgid ""
"あんた……\n"
"\\.何て格好してるんだい……？"
msgstr "你……\\.怎么这副打扮……？"

#. ID 8, Page 10, Line 15, Pos (6,7)
msgid ""
"やれやれ…\n"
"あんた、飼い主はいないのかい？"
msgstr "哎呀哎呀……你，没有主人吗？"

#. ID 8, Page 10, Line 19, Pos (6,7)
msgid ""
"…しょうがないねえ。\n"
"外の犬小屋は今誰も使ってないから、\n"
"そこで飼ってやろうか？"
msgstr ""
"……真拿你没办法。外面的狗屋现在没人用，\n"
"要不要就在那里养你？"

#. ID 8, Page 10, Line 22, Pos (6,7)
#. Choice (2 options)
msgid ""
"わんわん！\n"
"…"
msgstr ""
"汪汪！\n"
"……"

#. ID 8, Page 10, Line 24, Pos (6,7)
msgid ""
"分かったよ。\n"
"それじゃあ、名札でもつけてやろうかね。"
msgstr "明白了。那么，就给你挂个名牌吧。"

#. ID 8, Page 10, Line 32, Pos (6,7)
msgid "「\\N[\\V[6]]」とかいてあるなふだをもらった。"
msgstr "收到了写着「\\N[\\V[6]]」的名牌。"

#. ID 8, Page 10, Line 37, Pos (6,7)
msgid ""
"それじゃあ、表に行きな。\n"
"今日からはあの小屋で寝るんだよ。"
msgstr "那么，到外面去吧。从今天起就睡那间小屋哦。"

#. ID 8, Page 10, Line 42, Pos (6,7)
msgid ""
"こうして\\N[\\V[6]]は\n"
"RAYONの宿屋で飼われることになった。"
msgstr "就这样，\\N[\\V[6]]被RAYON的旅店收养了。"

#. ID 8, Page 10, Line 59, Pos (6,7)
msgid "なんだい、やっぱり野良がいいのかい？"
msgstr "怎么了，果然还是当流浪狗好吗？"

#. ID 8, Page 10, Line 64, Pos (6,7)
msgid ""
"犬は泊まる事ができないよ…\n"
"\n"
"ああ、犬小屋に行ってみるといいよ"
msgstr "狗不能住宿哦……啊，去狗屋看看就好"

#. ID 8, Page 11, Line 8, Pos (6,7)
msgid ""
"こらこら、あんたの寝床は外の小屋だよ。\n"
"客の邪魔になるからね。"
msgstr "喂喂，你的床是外面的小屋哦。会妨碍客人的。"

#. ID 8, Page 12, Line 12, Pos (6,7)
msgid ""
"あんた、その首輪……\n"
"\\.一体、何をしたんだい？"
msgstr "你，那个项圈……\\.到底做了什么？"

#. ID 8, Page 12, Line 16, Pos (6,7)
msgid ""
"あんた、その格好……\n"
"\\.一体、何をしたんだい？"
msgstr "你，那身打扮……\\.到底做了什么？"

#. ID 8, Page 12, Line 20, Pos (6,7)
msgid ""
"すまないけれど、\n"
"普通の部屋は、店の評判に関わるから\n"
"奴隷には使わせてあげられないんだよ…"
msgstr ""
"抱歉，普通房间关系到店的声誉，\n"
"所以不能让奴隶使用……"

#. ID 8, Page 12, Line 23, Pos (6,7)
#. Contains choice at line 3 (2 options)
msgid ""
"犬小屋で良ければ、タダで泊めてあげられるけど、\n"
"それでも、いいかね…？"
msgstr ""
"如果狗屋也可以的话，能免费让你住，不过，\n"
"这样可以吗……？"

#. ID 8, Page 12, Line 25, Pos (6,7)
#. Choice (2 options, embedded in a message)
msgid ""
"……はい……\n"
"そ…そんな……"
msgstr ""
"……好……\n"
"那…那种事……"

#. ID 8, Page 12, Line 27, Pos (6,7)
#. ID 8, Page 12, Line 119, Pos (6,7)
msgid "すまないね……"
msgstr "抱歉啊……"

#. ID 8, Page 12, Line 29, Pos (6,7)
msgid ""
"せめて、寝床くらいは\n"
"きっちりするから、勘弁しておくれよ。"
msgstr "至少床铺我会给你弄好，请见谅。"

#. ID 8, Page 12, Line 49, Pos (6,7)
msgid ""
"…終わりを告げるはずだった奴隷としての生活。\n"
"それから開放されることがなくなった絶望で、\n"
"\\n[\\v[6]]は声をあげて泣いた。"
msgstr ""
"本应宣告结束的奴隶生活。\n"
"由于再也无法从中获得解放的绝望，\n"
"\\n[\\v[6]]放声大哭。"

#. ID 8, Page 12, Line 55, Pos (6,7)
msgid ""
"…借金は返し終えた。\n"
"ようやくこんな生活から脱出できることに\n"
"安堵しながら、\\n[\\v[6]]は犬小屋で眠りについた。"
msgstr ""
"……负债已经还清了。终于能从这种生活中逃脱，\n"
"\\n[\\v[6]]一边为此感到安心，\n"
"一边在狗屋中睡去了。"

#. ID 8, Page 12, Line 63, Pos (6,7)
msgid ""
"\\N[\\V[6]]は、犬小屋の藁の中で\n"
"必死に涙をこらえていた。\n"
"心まで堕ちないために。"
msgstr ""
"\\N[\\V[6]]在狗屋的稻草中拼命忍住眼泪。\n"
"为了不让心也堕落。"

#. ID 8, Page 12, Line 68, Pos (6,7)
msgid ""
"＊……\\N[\\V[6]]は、犬小屋の汚れきった藁の中で\n"
"一人声もなく泣いた…"
msgstr ""
"＊……\n"
"\\N[\\V[6]]在狗窝里脏透了的稻草中独自无声地哭泣…"

#. ID 8, Page 12, Line 76, Pos (6,7)
#. ID 13, Page 1, Line 3, Pos (2,11)
msgid "………"
msgstr "………"

#. ID 8, Page 12, Line 101, Pos (6,7)
msgid ""
"＊………無理な場所で寝たせいか、\n"
"身体のあちこちが痛む。"
msgstr "＊………也许是因为睡在别扭的地方，身体到处都疼。"

#. ID 8, Page 12, Line 104, Pos (6,7)
msgid "＊体力はあまり回復していないようだ…"
msgstr "＊体力似乎没有恢复多少…"

#. ID 8, Page 12, Line 109, Pos (6,7)
msgid "＊体力はほとんど回復していないようだ…"
msgstr "＊体力似乎几乎没有恢复…"

#. ID 8, Page 13, Line 27, Pos (6,7)
msgid ""
"誰かを助けたはずだけど\n"
"誰を助けたのかわからなくなったって？\n"
"幻でも見たんじゃないのかい。"
msgstr ""
"你说你明明救了谁，却不知道救了谁？\n"
"是不是看到幻觉了。"

#. ID 8, Page 13, Line 75, Pos (6,7)
msgid "黄金像とはこれまた豪勢だねえ……"
msgstr "黄金像啊，这还真是豪华……"

#. ID 8, Page 13, Line 76, Pos (6,7)
msgid ""
"あん？　これが\\n[\\v[535]]？\n"
"たちの悪い冗談だね。\n"
"ただのインテリアじゃないか。"
msgstr ""
"嗯？　这就是\\n[\\v[535]]？真是恶劣的玩笑。\n"
"不就是个摆设吗。"

#. ID 8, Page 13, Line 83, Pos (6,7)
#. ID 8, Page 13, Line 103, Pos (6,7)
msgid ""
"＊……これが\\n[\\v[535]]だとは、\n"
"やはり信じてもらえないようだ。"
msgstr "＊……看来果然还是不能相信这就是\\n[\\v[535]]。"

#. ID 8, Page 13, Line 85, Pos (6,7)
msgid ""
"＊なんとかして元に戻す方法はないだろうか？\n"
"あの遺跡の中なら、\n"
"方法を知っている人物がいるんじゃないか？"
msgstr ""
"＊难道没有什么办法能设法恢复原状吗？\n"
"若是在那座遗迹里，说不定会有知道方法的人？"

#. ID 8, Page 13, Line 96, Pos (6,7)
msgid "なんだい、これは？"
msgstr "这是什么啊？"

#. ID 8, Page 13, Line 97, Pos (6,7)
msgid ""
"彼女？　たちの悪い冗談だね。\n"
"ただの壊れたガラクタ人形じゃないか。"
msgstr ""
"她？　真是恶劣的玩笑。\n"
"不就是个坏掉的破烂人偶吗。"

#. ID 8, Page 13, Line 105, Pos (6,7)
msgid ""
"＊なんとかして元に戻す方法はないだろうか？\n"
"あの研究所の人間なら、あるいは？"
msgstr ""
"＊难道没有什么办法能设法恢复原状吗？\n"
"若是那个研究所的人，说不定？"

#. ID 8, Page 13, Line 114, Pos (6,7)
msgid "こいつは、ひどいね…"
msgstr "这家伙，真惨啊…"

#. ID 8, Page 13, Line 115, Pos (6,7)
msgid ""
"わかった。\n"
"この子は預かっておくよ。"
msgstr "明白了。这个孩子我就先收下了。"

#. ID 13, Page 1, Line 4, Pos (2,11)
msgid "…ｸｽ"
msgstr "……噗嗤"

#. ID 13, Page 2, Line 9, Pos (2,11)
#. ID 13, Page 3, Line 4, Pos (2,11)
msgid "……"
msgstr "……"

