#. ID 99, Page 6, Line 7, Pos (84,0)
msgid "プヨプヨした舌ざわり………"
msgstr "软弹弹的舌感………"

#. ID 99, Page 6, Line 22, Pos (84,0)
msgid "耳たぶの味………"
msgstr "耳垂的味道………"

#. ID 99, Page 6, Line 42, Pos (84,0)
msgid "すえた香り………"
msgstr "发馊的气味………"

#. ID 99, Page 6, Line 57, Pos (84,0)
msgid "\\n[\\v[6]]は死にたくなった………"
msgstr "\\n[\\v[6]]想死了………"

#. ID 99, Page 6, Line 79, Pos (84,0)
msgid "ヒルが背筋を這いあがるような快感………"
msgstr "就像水蛭沿着脊背爬上来般的快感………"

#. ID 99, Page 6, Line 92, Pos (84,0)
msgid "目の前を走るピンクの豚………"
msgstr "在眼前跑过的粉色猪………"

#. ID 99, Page 6, Line 102, Pos (84,0)
msgid "歯が紫に染まって一本一本抜けていくような気分………"
msgstr "感觉牙齿被染成紫色，一颗接一颗脱落………"

#. ID 99, Page 6, Line 128, Pos (84,0)
msgid "酸いモノが\\n[\\v[6]]の口いっぱいにこみあげてきた………"
msgstr "酸涩的东西涌满了\\n[\\v[6]]的口腔………"
