#. ID 177, Page 6, Line 449, Pos (75,62)
msgid ""
"\\S[2]\n"
"………"
msgstr ""
"\\S[2]\n"
"………"

#. ID 177, Page 6, Line 451, Pos (75,62)
msgid ""
"\\S[2]\n"
"＊……\\n[\\v[6]]は、すでに視るも無残な肉の塊と\n"
"　化していた。"
msgstr "\\S[2]＊……\\n[\\v[6]]已经化成了惨不忍睹的肉块。"

#. ID 177, Page 6, Line 454, Pos (75,62)
msgid ""
"\\S[2]\n"
"＊腹部を切り裂いた\\n[\\v[6]]の手が、\n"
"　そのまま内部の腸を引き千切り、外へとぶちまける。"
msgstr ""
"\\S[2]＊撕裂了腹部\\n[\\v[6]]的手，\n"
"　就那样将内部的肠子扯碎，泼洒到外面。"

#. ID 177, Page 6, Line 457, Pos (75,62)
msgid ""
"\\S[2]\n"
"＊小腸を手で千切り、大腸を握りつぶし、\n"
"　子宮にナイフを突き立て、腎臓を抉る。\n"
"　採り出した膵臓を\\n[\\v[6]]の口へ押し込む。"
msgstr ""
"\\S[2]＊用手将小肠扯碎，将大肠捏碎，\n"
"　将刀刺入子宫，剜出肾脏。\n"
"　把取出的胰腺塞进\\n[\\v[6]]的嘴里。"

#. ID 177, Page 6, Line 461, Pos (75,62)
msgid ""
"\\S[2]\n"
"＊そして、魚を捌くように、\n"
"　\\n[\\v[6]]の手はナイフを上へと切り上げ、\n"
"　縦に大きく切り込みを入れた。"
msgstr ""
"\\S[2]＊然后，就像处理鱼一样，\n"
"　\\n[\\v[6]]的手将刀向上挑起，\n"
"　纵向划开了一道大口子。"

#. ID 177, Page 6, Line 465, Pos (75,62)
msgid ""
"\\S[2]\n"
"＊しかし、激痛を感じても意識を失うこともできない。\n"
"　強力な催眠術が理性を常に保たせ、\n"
"　それ故に苦痛を最後まで味わうことになった。"
msgstr ""
"\\S[2]＊但是，即使感受到剧痛也无法失去意识。\n"
"　强力的催眠术使其始终保持理性，\n"
"　因此她不得不将痛苦品尝到最后。"

#. ID 177, Page 6, Line 475, Pos (75,62)
msgid ""
"\\S[2]\n"
"＊ナイフが、\\n[\\v[6]]の胸に突き刺さった。"
msgstr "\\S[2]＊刀，刺进了\\n[\\v[6]]的胸口。"

#. ID 177, Page 6, Line 477, Pos (75,62)
msgid ""
"\\S[2]\n"
"＊\\n[\\v[6]]の乳房を抉り、それを斬り捨てると、\n"
"　さらにナイフを奥へと突きさし……\n"
"　\\n[\\v[6]]の心臓へと、抉るようにして力を込めた。"
msgstr ""
"\\S[2]＊\\n[\\v[6]]的乳房被剜出，将其砍下后，\n"
"　又将刀进一步刺入深处……\n"
"　\\n[\\v[6]]将力量灌注到心脏，像在剜挖一样。"

#. ID 177, Page 6, Line 484, Pos (75,62)
msgid "＊血が噴き出す。"
msgstr "＊血喷涌而出。"

#. ID 177, Page 6, Line 485, Pos (75,62)
msgid "＊命が失われるのを感じる。"
msgstr "＊感觉到生命正在消逝。"

#. ID 177, Page 6, Line 512, Pos (75,62)
msgid ""
"\\S[2]\n"
"＊\\n[\\v[6]]の手が、胸から心臓を抜き取った。\n"
"　そして……その手が心臓を目の前で握りつぶし、\n"
"　意識が一瞬で赤く塗りつぶされた。"
msgstr ""
"\\S[2]＊\\n[\\v[6]]的手从胸膛中取出了心脏。\n"
"　然后……那只手在眼前将心脏捏碎，\n"
"　意识在一瞬间被涂成一片赤红。"

#. ID 177, Page 6, Line 516, Pos (75,62)
msgid ""
"\\S[2]\n"
"………\n"
"……\n"
"…"
msgstr ""
"\\S[2]\n"
"………\n"
"……\n"
"…"

#. ID 177, Page 7, Line 3, Pos (75,62)
msgid "＊……スカートの前部分に大きなスリットが入っている"
msgstr "＊……裙子前面部分开了一道很大的开衩"

#. ID 177, Page 7, Line 8, Pos (75,62)
msgid ""
"＊下着は履いていない……\n"
"　下半身が丸見えの状態だ"
msgstr "＊没有穿内裤……　下半身处于完全暴露的状态"

#. ID 177, Page 7, Line 14, Pos (75,62)
msgid ""
"＊そして手を伸ばし\n"
"　作業をするように、そこを弄り続けている"
msgstr "＊然后伸出手　像在做工一样，持续抚弄着那里"

#. ID 177, Page 7, Line 19, Pos (75,62)
msgid ""
"オナニーが大好き……\n"
"いつでもどこでも……\n"
"オナニーがしたい……"
msgstr "最喜欢自慰……无论何时何地……都想自慰……"

#. ID 177, Page 7, Line 49, Pos (75,62)
msgid ""
"あー……$g\n"
"ぁあー……$g$g"
msgstr "啊——……$g啊啊——……$g$g"

#. ID 178, Page 1, Line 3, Pos (29,47)
msgid "こちらは近衛兵やメイドの宿直所になります。"
msgstr "这里是近卫兵和女仆的夜间值班室。"

#. ID 178, Page 1, Line 4, Pos (29,47)
msgid "24時間体制で城内を警備しているのです。"
msgstr "以24小时体制警备城内。"

#. ID 179, Page 1, Line 3, Pos (62,63)
msgid "メイドや兵士は交替制勤務になります。"
msgstr "女仆和士兵是轮班制工作。"

#. ID 179, Page 1, Line 4, Pos (62,63)
msgid ""
"シフトを組んでいるので、\n"
"非番のメイドは城下の家で休んでいたりしてます。"
msgstr ""
"因为排了班，\n"
"所以不当班的女仆会在城下的家里休息。"

#. ID 179, Page 1, Line 6, Pos (62,63)
msgid ""
"ただ、一番右端の部屋にいらっしゃるメイド長は、\n"
"常に城内で勤務されています。"
msgstr "不过，在最右边房间里的女仆长，始终在城内工作。"

#. ID 179, Page 1, Line 9, Pos (62,63)
msgid ""
"メイド長は本当に、\n"
"立派な方です……"
msgstr "女仆长真的是个了不起的人……"

#. ID 179, Page 1, Line 38, Pos (62,63)
msgid ""
"あ……$g\n"
"メイド長と一緒にオナニーしたい……$g"
msgstr "啊……$g想和女仆长一起自慰……$g"

#. ID 179, Page 1, Line 42, Pos (62,63)
msgid ""
"メイド長は本当に、\n"
"立派な方です……好きになっちゃいそう"
msgstr "女仆长真的是个了不起的人……感觉自己要喜欢上她了"

#. ID 180, Page 1, Line 3, Pos (25,51)
msgid "草木の手入れも大切ですからね。"
msgstr "草木的养护也很重要呢。"

#. ID 181, Page 1, Line 3, Pos (22,65)
msgid ""
"こちらは中庭です。\n"
"我々専属の庭師が手入れをしています。"
msgstr "这里是中庭。我们专属的园丁在养护。"

#. ID 181, Page 1, Line 5, Pos (22,65)
msgid ""
"特に、第二王女様はこの中庭がお気に入りで、\n"
"いつもお褒めの言葉をかけてくださいます。"
msgstr ""
"特别是，第二王女大人很喜欢这个中庭，\n"
"总是给予夸奖。"

#. ID 182, Page 1, Line 4, Pos (1,53)
msgid ""
"ふん……街が助かったとはいえ、\n"
"どいつもこいつも第一王女第一王女と……\n"
"まったく不愉快な話じゃ"
msgstr ""
"哼……就算城镇得救了，\n"
"这些家伙也一个个第一王女第一王女地……\n"
"真是不愉快。"

#. ID 182, Page 1, Line 7, Pos (1,53)
msgid "……今に見ておれよ"
msgstr "……走着瞧吧"

#. ID 182, Page 2, Line 4, Pos (1,53)
msgid "ほほ……そちか"
msgstr "呵呵……是你啊"

#. ID 182, Page 2, Line 5, Pos (1,53)
msgid ""
"早速じゃが\n"
"我が姉の権威を失墜させるため……\n"
"催眠を深めるための道具を\n"
"持ってきてもらいたいんじゃが"
msgstr ""
"事不宜迟，为了让我姐姐的权威失坠……\n"
"希望你去把加深催眠的道具拿来。"

#. ID 182, Page 2, Line 14, Pos (1,53)
msgid ""
"お前が手に入れた魔法書……\n"
"アレは結構な代物だったのじゃが\n"
"どうやらそれを補足するメモが\n"
"あるようなんじゃ"
msgstr ""
"你得到的魔法书……那东西相当了不得，\n"
"不过看来有补充它的笔记。"

#. ID 182, Page 2, Line 19, Pos (1,53)
msgid ""
"わらわの考えでは……\n"
"その書物のさらに奥の部屋に\n"
"あると踏んでおる"
msgstr "依我之见……我猜它在书物更深处的房间里。"

#. ID 182, Page 2, Line 22, Pos (1,53)
msgid ""
"それを取ってきて欲しい……\n"
"何、簡単なことじゃろう？"
msgstr "希望你去把它取来……怎么，很简单吧？"

#. ID 182, Page 3, Line 4, Pos (1,53)
msgid "まだおったのか？"
msgstr "你还在啊？"

#. ID 182, Page 3, Line 5, Pos (1,53)
msgid ""
"そちが手に入れた魔導書…\n"
"支配の塔という場所に\n"
"あるのじゃろう？"
msgstr "你得到的魔导书……是在一个叫支配之塔的地方吧？"

#. ID 182, Page 3, Line 8, Pos (1,53)
msgid ""
"ちゃんと移動方法も\n"
"用意してある\n"
"宿屋にいけば解るじゃろう"
msgstr "去已经准备好移动方法的旅馆的话，就会明白了吧。"

#. ID 182, Page 4, Line 4, Pos (1,53)
msgid ""
"……ほほ\n"
"手に入れたようじゃな　"
msgstr "……呵呵，看来你拿到了。"

#. ID 182, Page 4, Line 6, Pos (1,53)
msgid ""
"そちの手に入れたこの補足で…\n"
"さらに催眠深度を深め\n"
"姉を取り返しのつかない状態に\n"
"してやれる……"
msgstr ""
"用你得到的这份补充……可以进一步加深催眠深度，\n"
"让姐姐陷入无法挽回的状态……"

#. ID 182, Page 4, Line 10, Pos (1,53)
msgid "愉快じゃ……ふふ"
msgstr "真愉快……呵呵"

#. ID 182, Page 4, Line 15, Pos (1,53)
msgid ""
"さて……\n"
"今回の礼をせねばならぬな\n"
"取っておくが良い"
msgstr "那么……这次得给你谢礼。先收下吧。"

#. ID 182, Page 4, Line 21, Pos (1,53)
msgid "＊20,000G 手に入れた！"
msgstr "＊获得了20,000G！"

#. ID 182, Page 4, Line 27, Pos (1,53)
msgid ""
"さて……\n"
"また何か依頼をするかもしれん\n"
"そのときはよろしくの"
msgstr "那么……也许还会再委托你什么，到时候就拜托了。"

#. ID 182, Page 5, Line 4, Pos (1,53)
msgid ""
"また何か依頼をするかもしれん\n"
"そのときはよろしくの"
msgstr "也许还会再委托你什么，到时候就拜托了。"

#. ID 183, Page 1, Line 3, Pos (54,75)
msgid ""
"ここから先は領主様の私室になります。\n"
"お通しできません。"
msgstr "从这里往前是领主大人的私人房间。不能通过。"

#. ID 183, Page 2, Line 3, Pos (54,75)
msgid ""
"どうぞ\n"
"おとおり　ください"
msgstr "请　通行。"

#. ID 183, Page 3, Line 3, Pos (54,75)
msgid ""
"よるは……○リーパーさまが……\n"
"たねをつけるので……はいってはいけま……せん"
msgstr "晚上……○梦貘人大人……要播种……所以不能进……去。"

#. ID 186, Page 1, Line 3, Pos (15,72)
msgid "こちらは中庭です。"
msgstr "这里是中庭。"

#. ID 186, Page 2, Line 3, Pos (15,72)
msgid "夜間でも警備です。"
msgstr "即使夜间也要警备。"

#. ID 187, Page 1, Line 3, Pos (40,74)
msgid ""
"中庭は第二王女様が作らせたものです。\n"
"こういった場所は落ち着くのだとか。"
msgstr ""
"中庭是第二王女大人让人建造的。\n"
"据说这种地方能让人心情平静。"

#. ID 187, Page 1, Line 5, Pos (40,74)
msgid "……ちょっとは可愛げがありますよね。"
msgstr "……还是有点可爱的地方呢。"

#. ID 188, Page 1, Line 3, Pos (25,74)
msgid ""
"中庭の置くは近衛兵士やメイドの\n"
"宿直所になっています。"
msgstr "中庭深处是近卫士兵和女仆的夜间值班处。"

#. ID 188, Page 1, Line 5, Pos (25,74)
msgid ""
"メイド長テッドは多忙ですので、\n"
"お会いできないかと思います。"
msgstr "女仆长泰德非常忙碌，我想您可能见不到她。"

#. ID 189, Page 1, Line 3, Pos (1,52)
msgid ""
"第二王女、ラヴィアン様は\n"
"とてもお優しい方でありますのに……"
msgstr "第二王女拉维安大人明明是非常温柔的人……"

#. ID 189, Page 1, Line 5, Pos (1,52)
msgid ""
"領主様は第一王女様ばかりを愛され……\n"
"ご不憫でなりません"
msgstr "领主大人只疼爱第一王女大人……实在令人惋惜。"

#. ID 201, Page 1, Line 7, Pos (33,6)
#. ID 202, Page 1, Line 7, Pos (34,6)
#. ID 203, Page 1, Line 7, Pos (32,6)
msgid ""
"お風呂場で使うおもちゃが並んでいる\\!\n"
"勿論大人用の、だ"
msgstr "摆放着在浴室里用的玩具\\!当然是成人用的。"

#. ID 201, Page 1, Line 11, Pos (33,6)
#. ID 202, Page 1, Line 11, Pos (34,6)
#. ID 203, Page 1, Line 11, Pos (32,6)
msgid ""
"タオルなどの入浴道具が並んでいる\n"
"どれも高級そうだ"
msgstr "摆放着毛巾等洗浴用具，看起来每样都很高级。"

#. ID 208, Page 1, Line 6, Pos (23,21)
#. ID 209, Page 1, Line 6, Pos (23,22)
#. ID 210, Page 1, Line 6, Pos (23,20)
msgid "＊豪華なネックレスや指輪が入っている。"
msgstr "＊里面装着华丽的项链和戒指。"

#. ID 213, Page 1, Line 4, Pos (35,19)
#. ID 213, Page 2, Line 4, Pos (35,19)
msgid "ふふん……いい気味じゃ"
msgstr "哼哼……活该。"

#. ID 213, Page 1, Line 11, Pos (35,19)
#. ID 213, Page 2, Line 11, Pos (35,19)
msgid "しかしコレだけでは終わらぬ……"
msgstr "但是，仅凭这些还不会结束……"

#. ID 213, Page 1, Line 12, Pos (35,19)
#. ID 213, Page 2, Line 12, Pos (35,19)
msgid ""
"さらに催眠を深め……\\.\n"
"完全な性奴隷になるまで\n"
"洗脳してくれるわ"
msgstr ""
"要进一步加深催眠……\n"
"\\.洗脑到成为完全的性奴隶为止。"

#. ID 213, Page 2, Line 16, Pos (35,19)
msgid ""
"ん、なんじゃ？リナ？\n"
"はて……おおそうじゃ、この前連れてきた\n"
"兵士がそんな名前をしておったわ。"
msgstr ""
"嗯，什么？莉娜？唔……哦对了，\n"
"之前带来的那个士兵就是叫这个名字。"

#. ID 213, Page 2, Line 19, Pos (35,19)
msgid ""
"あの娘は傑作じゃったぞ！\n"
"誰の入れ知恵か、睡眠解除薬を持って\n"
"おってのう、○リーパーのイチモツに\n"
"噛み付いたのじゃ！"
msgstr ""
"那女孩真是杰作！不知是谁教的，\n"
"她居然带着睡眠解除药，咬了○梦貘人的那话儿！"

#. ID 213, Page 2, Line 23, Pos (35,19)
msgid ""
"○リーパーは悶絶しておったわ！\n"
"\n"
"……まあ、その後に念入りに催眠術を\n"
"かけられてどこかへ行ったがのう。"
msgstr ""
"○梦貘人当时痛苦得直打滚！……不过，\n"
"之后被仔细施了催眠术，不知去向了。"

#. ID 213, Page 2, Line 27, Pos (35,19)
msgid ""
"なまじ抵抗をするから、\n"
"より悲惨な結果になるのじゃ。\n"
"\n"
"……笑いが止まらぬ。"
msgstr ""
"因为做了无谓的抵抗，结果才更加悲惨。……\n"
"我笑个不停。"

#. ID 224, Page 1, Line 3, Pos (2,26)
msgid "＊緊急用の脱出路のようだ。"
msgstr "＊似乎是紧急用的逃生通道。"

#. ID 224, Page 1, Line 4, Pos (2,26)
#. Contains choice at line 2 (2 options)
msgid "＊利用しますか？"
msgstr "＊要使用吗？"

#. ID 225, Page 1, Line 3, Pos (6,14)
msgid "＊第二王女ラヴィアンの部屋"
msgstr "＊第二王女拉维安的房间"

#. ID 226, Page 1, Line 3, Pos (22,27)
msgid "＊第一王女アリシアの部屋"
msgstr "＊第一王女阿莉西亚的房间"

#. ID 227, Page 1, Line 3, Pos (28,27)
msgid "＊領主の部屋"
msgstr "＊领主的房间"

#. ID 228, Page 1, Line 3, Pos (30,97)
msgid "ここは応接間になります。"
msgstr "这里是会客室。"

#. ID 229, Page 1, Line 3, Pos (38,107)
msgid ""
"食堂は昼夜関係なく大忙しです。\n"
"ほんと死にそうです。リョナです。"
msgstr ""
"食堂不分昼夜都非常忙碌。真要累死了。\n"
"我是莉奥娜。"

#. ID 230, Page 1, Line 3, Pos (76,97)
msgid ""
"私はこの都市の人間ではない\n"
"アバロソからの使いだ"
msgstr "我不是这座城市的人，是从阿巴罗索来的使者。"

#. ID 230, Page 1, Line 5, Pos (76,97)
msgid "メルベルはやはり堅牢な要塞だ……"
msgstr "梅尔贝尔果然是一座坚固的要塞……"

#. ID 230, Page 1, Line 6, Pos (76,97)
msgid ""
"この都市があるからこそ\n"
"他の村や町へ魔物が向かわないのだろう"
msgstr ""
"正因为有这座城市，\n"
"魔物才不会去其他村庄和城镇吧。"

#. ID 232, Page 1, Line 3, Pos (11,110)
#. ID 238, Page 1, Line 3, Pos (74,116)
#. ID 239, Page 1, Line 3, Pos (77,116)
msgid ""
"城内は基本的に、\n"
"自由に見学などをしていただいて構いません。"
msgstr "城内基本上可以自由参观。"

#. ID 232, Page 1, Line 5, Pos (11,110)
#. ID 238, Page 1, Line 5, Pos (74,116)
#. ID 239, Page 1, Line 5, Pos (77,116)
msgid ""
"しかし王室や食堂など、\n"
"入ることの出来ない場所もあります"
msgstr "但是，也有王族区域和食堂等不能进入的地方。"

#. ID 233, Page 1, Line 3, Pos (16,116)
msgid ""
"第一王女様は美しいよなあ……\n"
"我々近衛兵にもお声をかけてくださる"
msgstr ""
"第一王女大人真美啊……\n"
"还会主动向我们这些近卫兵打招呼。"

#. ID 233, Page 1, Line 5, Pos (16,116)
msgid ""
"それに引き換え第二王女様は……\n"
"昔は可愛かったのに今はあのようになられて……"
msgstr ""
"相比之下，第二王女大人……以前明明很可爱，\n"
"现在却变成了那样……"

#. ID 233, Page 2, Line 3, Pos (16,116)
msgid ""
"ここは休憩室です。\n"
"といっても、本当に休むだけの場所ですが"
msgstr ""
"这里是休息室。虽这么说，\n"
"不过真的只是用来休息的地方。"

#. ID 234, Page 1, Line 3, Pos (16,105)
#. ID 235, Page 1, Line 3, Pos (58,106)
msgid "巡回警備中です。"
msgstr "正在巡逻警备。"

#. ID 236, Page 1, Line 3, Pos (9,104)
msgid "ここは会議室です。"
msgstr "这里是会议室。"

#. ID 237, Page 1, Line 3, Pos (18,95)
msgid "第二王女様も昔は可愛い方だったのですが……"
msgstr "第二王女大人以前也很可爱……"

#. ID 241, Page 1, Line 3, Pos (0,1)
msgid "＊……………"
msgstr "＊……………"

#. ID 241, Page 1, Line 58, Pos (0,1)
msgid ""
"＊…………何か妙な感覚がする。\n"
"　ずっと眠っていたような………。"
msgstr "＊…………有种奇怪的感觉。　好像一直沉睡着………。"

#. ID 241, Page 1, Line 65, Pos (0,1)
msgid ""
"＊良く分からないが……\n"
"　あまりこの不審な者に関わらない方が良さそうだ\n"
"　"
msgstr ""
"＊虽然不太明白……\n"
"　最好还是不要和这个可疑的家伙牵扯太多。"

#. ID 242, Page 1, Line 3, Pos (21,20)
msgid ""
"＊綺麗なアクセサリーだが、\n"
"　無造作に床に捨てられている"
msgstr "＊虽然是漂亮的饰品，　却被随意丢在地上。"

#. ID 245, Page 1, Line 9, Pos (33,20)
msgid "……これからは毎晩オナニーするんだな……"
msgstr "……从今以后每晚都要自慰啊……"

#. ID 245, Page 1, Line 10, Pos (33,20)
msgid ""
"お風呂に入るのはキモチいいんだな……\n"
"お風呂は毎晩入るんだな……\n"
"それならオナニーもキモチいいから\n"
"毎晩オナニーするんだな……普通なんだな……"
msgstr ""
"泡澡很舒服啊……每晚都要泡澡啊……\n"
"既然自慰也很舒服，那就每晚都要自慰啊……\n"
"这是很普通的事啊……"

#. ID 245, Page 1, Line 18, Pos (33,20)
msgid ""
"止めようと思ってもダメなんだな……\n"
"夜になると股間と胸が疼いて……\n"
"熱くなって堪らないんだな……"
msgstr ""
"就算想停下来也不行啊……\n"
"一到晚上胯间和胸口就发疼……热得受不了啊……"

#. ID 245, Page 1, Line 25, Pos (33,20)
msgid ""
"じっくり時間をかけてオナニーするんだな……\n"
"そのほうがもっとキモチいいからな……"
msgstr "要花时间慢慢自慰啊……因为那样会更舒服啊……"

#. ID 245, Page 1, Line 27, Pos (33,20)
msgid ""
"それで毎晩10回はイかないと\n"
"ヤメてはダメなんだな……"
msgstr "所以每晚不达到10次高潮就不能停啊……"

#. ID 245, Page 1, Line 33, Pos (33,20)
msgid ""
"胸もお尻の穴もよーく使うんだな……\n"
"全身くまなくオナニーするんだな……"
msgstr ""
"胸和屁股的洞也要好好用上啊……\n"
"要仔仔细细地自慰遍全身啊……"

#. ID 245, Page 1, Line 39, Pos (33,20)
msgid ""
"道具も使って構わないんだな……\n"
"とにかくキモチよくなるんだな……\n"
"そしてオナニーを大好きになるんだな……\n"
"オナニーもお前が大好きなんだな……"
msgstr ""
"用道具也没关系啊……总之就是要变得舒服啊……\n"
"然后要变得最喜欢自慰啊……自慰也最喜欢你啊……"

#. ID 245, Page 1, Line 47, Pos (33,20)
msgid ""
"何故か部屋の鍵はかけ忘れてしまうんだな……\n"
"そしてオナニーを誰かに見られても\n"
"キモチ良いのがとめられないんだな……"
msgstr ""
"不知为何总是忘记锁房门啊……\n"
"而且就算自慰被别人看到，舒服得也停不下来啊……"

#. ID 245, Page 1, Line 50, Pos (33,20)
msgid ""
"お風呂を覗かれても裸は隠せないよな？\n"
"それと同じなんだな……\n"
"どうせオナニーを隠せないなら\n"
"ずっと続けたほうがキモチいいんだな……"
msgstr ""
"就算被人偷看洗澡也没法遮住裸体吧？\n"
"和这个一样啊……反正自慰也藏不住，\n"
"那就一直继续下去更舒服啊……"

#. ID 246, Page 1, Line 3, Pos (33,21)
msgid ""
"…………はい\n"
"……私は毎晩オナニーするのが……\n"
"大好き……です"
msgstr "…………是的……我……最喜欢每晚自慰……了"

#. ID 247, Page 1, Line 28, Pos (12,21)
msgid ""
"ああっ……\n"
"いや……もういや……\n"
"なの……にぃ……"
msgstr "啊啊……不要……已经不要了……明明……不要啊……"

#. ID 247, Page 1, Line 31, Pos (12,21)
msgid ""
"夜になると我慢が……\n"
"ああっ……$g"
msgstr "一到晚上就忍不住……啊啊……$g"

#. ID 247, Page 1, Line 33, Pos (12,21)
msgid ""
"人に見られてるのに……\n"
"それなのに……\n"
"あっ$g　これイイ……っ$g"
msgstr "明明被人看着……可是……啊$g　这个好舒服……$g"

#. ID 248, Page 1, Line 3, Pos (15,20)
msgid ""
"オナニーのやり方まで知らないようだったから\n"
"ちょーっと仕込んであげたんだな……\\!\n"
"特大サイズのエイナスは流石に遠慮したんだな"
msgstr ""
"好像连自慰的方法都不知道，\n"
"所以我就稍微调教了一下啊……\n"
"\\!特大号的艾纳斯果然还是没敢用啊"

#. ID 248, Page 1, Line 6, Pos (15,20)
msgid ""
"それでもこんなに淫乱なオナニーするとは\\.\\.\n"
"肉便器の素質が大有りなんだな……フヒヒ！"
msgstr ""
"尽管如此，\n"
"她居然自慰得这么淫乱\\.\\.作为肉便器的素质可是大\n"
"大的有啊……嘻嘻嘻！"

#. ID 249, Page 1, Line 4, Pos (9,7)
msgid ""
"おお、そちか\n"
"我が姉の痴態は\n"
"どうじゃったかの？"
msgstr "哦，是你啊。我姐姐的痴态怎么样？"

#. ID 249, Page 1, Line 7, Pos (9,7)
msgid ""
"ふん、本当は淫乱の癖に\n"
"民や兵の前では良い顔を\n"
"しおって……"
msgstr ""
"哼，明明本性淫乱，\n"
"却偏要在民众和士兵面前摆出好脸色……"

#. ID 249, Page 1, Line 10, Pos (9,7)
msgid ""
"少しずつ、少しずつ……\n"
"化けの皮を剥いで\n"
"手遅れにしてやらねばのう"
msgstr ""
"得一点一点、一点一点地……剥下她的假面具，\n"
"让她无法挽回才行啊。"

#. ID 250, Page 1, Line 3, Pos (10,6)
msgid ""
"＊第一王女アリシアと第二王女ラヴィアンが\n"
"　一緒に写っている写真のアルバムだ"
msgstr ""
"＊这是第一王女阿莉西亚和第二王女拉维安　一起拍\n"
"　的照片相册。"
