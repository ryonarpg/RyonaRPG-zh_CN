msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 177, Page 2, Line 30, Pos (75,62)
msgid "やはりそうですか……"
msgstr "果然如此吗……"

#. ID 177, Page 2, Line 36, Pos (75,62)
msgid ""
"……\n"
"こんなことを貴方に頼むのも\n"
"おかしいかもしれませんが……"
msgstr "……把这种事拜托你可能有些奇怪，但是……"

#. ID 177, Page 2, Line 43, Pos (75,62)
msgid ""
"……単刀直入に、\n"
"全てをお話します"
msgstr "……我就单刀直入，把一切都说出来吧"

#. ID 177, Page 2, Line 49, Pos (75,62)
msgid ""
"私はメルベル城メイド長にして\n"
"メルベル第一王女様に仕える隠密……\n"
"「テッド」と申します"
msgstr ""
"我是梅尔贝尔城女仆长，\n"
"同时也是侍奉梅尔贝尔第一王女大人的密探……名叫\n"
"「泰德」"

#. ID 177, Page 2, Line 57, Pos (75,62)
msgid ""
"テッド\n"
"「……第一王女様の様子が\n"
"　おかしいのです"
msgstr "泰德「……第一王女的样子很奇怪"

#. ID 177, Page 2, Line 60, Pos (75,62)
msgid ""
"ある日突然……\n"
"執務もお稽古も上の空に……\n"
"夜は自室に引きこもってばかりで"
msgstr ""
"有一天突然……处理政务和练习都心不在焉……\n"
"晚上总是闷在自己房间里"

#. ID 177, Page 2, Line 63, Pos (75,62)
msgid ""
"……調査の結果\n"
"恐ろしいことが解りました"
msgstr "……调查结果发现了可怕的事情"

#. ID 177, Page 2, Line 70, Pos (75,62)
msgid ""
"○リーパー……、\n"
"あの魔物が第一王女様を洗脳……\n"
"催眠術で操っているのです"
msgstr ""
"○梦貘人……那个魔物洗脑了第一王女……\n"
"用催眠术操纵着她"

#. ID 177, Page 2, Line 73, Pos (75,62)
msgid ""
"毎晩毎晩……第一王女様に\n"
"何か術をかけては\n"
"猥褻な行為に及んでいる事実を\n"
"確認しました"
msgstr ""
"每晚每晚……\n"
"都对第一王女施展某种术法并实施猥亵行为，\n"
"我已确认了这一事实"

#. ID 177, Page 2, Line 82, Pos (75,62)
msgid ""
"しかし、既に……\n"
"私以外の頼れる兵士や仲間は\n"
"○リーパーの手に落ちていました"
msgstr ""
"但是，已经……\n"
"除我之外可靠的士兵和同伴都落入了○梦貘人手中"

#. ID 177, Page 2, Line 85, Pos (75,62)
msgid ""
"隠密である私を見つけ出し\n"
"私に術をかけるのも時間の\n"
"問題でしょう"
msgstr "找出身为密探的我并对我施术也只是时间问题吧"

#. ID 177, Page 2, Line 88, Pos (75,62)
msgid ""
"私が何か動くべきなのですが……\n"
"……バレてしまうことを考えると\n"
"迂闊に動くことが出来ないのです"
msgstr ""
"我本应该采取行动…………但考虑到会暴露，\n"
"就不能轻举妄动"

#. ID 177, Page 2, Line 96, Pos (75,62)
msgid "……そこでお願いがあるんです"
msgstr "……所以我有件事想拜托你"

#. ID 177, Page 2, Line 97, Pos (75,62)
msgid ""
"助けてもらいたいのです……\n"
"第一王女様を助ける手段を\n"
"見つけていただきたいのです"
msgstr "希望你能帮我……希望你能找到拯救第一王女的方法"

#. ID 177, Page 2, Line 100, Pos (75,62)
msgid ""
"○リーパーに疑惑があり……\n"
"この城の人間ではない\n"
"あなたにしかお願いできないのです"
msgstr "○梦貘人有嫌疑……我只能拜托不是这座城里的人的你"

#. ID 177, Page 2, Line 107, Pos (75,62)
#. Contains choice at line 2 (2 options)
msgid "＊依頼を受けますか？"
msgstr "＊接受委托吗？"

#. ID 177, Page 2, Line 115, Pos (75,62)
msgid "……有難うございます"
msgstr "……谢谢您"

#. ID 177, Page 2, Line 116, Pos (75,62)
msgid ""
"依頼の内容ですが……\n"
"「人間を操る術」について\n"
"解った物があれば渡してください"
msgstr ""
"委托内容是……\n"
"如果有关于「操纵人类的术法」的已知物品，请交给我"

#. ID 177, Page 2, Line 120, Pos (75,62)
msgid ""
"解除する方法、でなくても結構です\n"
"術にかける方法さえ解れば\n"
"解除の方法も解りますから"
msgstr ""
"不是解除方法也可以，只要知道施术方法，\n"
"就能知道解除方法"

#. ID 177, Page 2, Line 128, Pos (75,62)
msgid ""
"……大分投げやりな依頼ですが\n"
"よろしくお願いします"
msgstr "……虽然是个相当草率的委托，但还是拜托您了"

#. ID 177, Page 2, Line 140, Pos (75,62)
msgid ""
"そうですか……\n"
"仕方がありません"
msgstr "这样啊……没办法"

#. ID 177, Page 2, Line 142, Pos (75,62)
#. ID 177, Page 2, Line 157, Pos (75,62)
msgid "この話は忘れてください"
msgstr "请忘掉这件事吧"

#. ID 177, Page 2, Line 155, Pos (75,62)
msgid ""
"そうですか……\n"
"失礼なことを聞いてすみません"
msgstr "这样啊……问了失礼的事情，抱歉"

#. ID 177, Page 3, Line 4, Pos (75,62)
msgid "何か解りましたか？"
msgstr "明白了什么吗？"

#. ID 177, Page 3, Line 6, Pos (75,62)
#. Contains choice at line 2 (2 options)
msgid "＊[催眠解除薬]を渡しますか？"
msgstr "＊要交出[催眠解除药]吗？"

#. ID 177, Page 3, Line 11, Pos (75,62)
msgid ""
"……はい、これは一番最初に\n"
"調べてみたのですが……"
msgstr "……是的，这个我一开始就调查过了……"

#. ID 177, Page 3, Line 13, Pos (75,62)
msgid ""
"どうやら、これでは解除\n"
"できないようなのです"
msgstr "看来，这个似乎无法解除"

#. ID 177, Page 3, Line 22, Pos (75,62)
#. Contains choice at line 2 (2 options)
msgid "＊[あやつりの輪]を渡しますか？"
msgstr "＊要交出[操纵之轮]吗？"

#. ID 177, Page 3, Line 27, Pos (75,62)
#. ID 177, Page 3, Line 46, Pos (75,62)
#. ID 177, Page 3, Line 65, Pos (75,62)
#. ID 177, Page 3, Line 84, Pos (75,62)
#. ID 177, Page 3, Line 103, Pos (75,62)
msgid "これは……"
msgstr "这是……"

#. ID 177, Page 3, Line 28, Pos (75,62)
msgid ""
"……なるほど、人間の思考を\n"
"止める道具ですか……"
msgstr "……原来如此，是停止人类思考的道具吗……"

#. ID 177, Page 3, Line 30, Pos (75,62)
#. ID 177, Page 3, Line 49, Pos (75,62)
#. ID 177, Page 3, Line 68, Pos (75,62)
#. ID 177, Page 3, Line 87, Pos (75,62)
#. ID 177, Page 3, Line 106, Pos (75,62)
msgid ""
"……解りました、\n"
"こちらでも調べて見ます\n"
"有難うございます"
msgstr "……明白了，这边也会调查看看，谢谢您"

#. ID 177, Page 3, Line 41, Pos (75,62)
#. Contains choice at line 2 (2 options)
msgid "＊[マリオネットパウダー]を渡しますか？"
msgstr "＊要交出[提线木偶粉末]吗？"

#. ID 177, Page 3, Line 47, Pos (75,62)
msgid ""
"……なるほど、\n"
"人間を操る道具ですか……"
msgstr "……原来如此，是操纵人类的道具吗……"

#. ID 177, Page 3, Line 60, Pos (75,62)
#. Contains choice at line 2 (2 options)
msgid "＊[冥府の魔符]を渡しますか？"
msgstr "＊要交出[冥府魔符]吗？"

#. ID 177, Page 3, Line 66, Pos (75,62)
msgid ""
"……なるほど、\n"
"死体を操る道具ですか……"
msgstr "……原来如此，是操纵尸体的道具吗……"

#. ID 177, Page 3, Line 79, Pos (75,62)
#. Contains choice at line 2 (2 options)
msgid "＊[賢者の薬]を渡しますか？"
msgstr "＊要交出[贤者之药]吗？"

#. ID 177, Page 3, Line 85, Pos (75,62)
msgid ""
"……なるほど、\n"
"賢者になる道具ですか……"
msgstr "……原来如此，是成为贤者的道具吗……"

#. ID 177, Page 3, Line 98, Pos (75,62)
#. Contains choice at line 2 (2 options)
msgid "＊[マインドコントローラ]を渡しますか？"
msgstr "＊要交出[精神控制器]吗？"

#. ID 177, Page 3, Line 104, Pos (75,62)
msgid ""
"……なるほど、\n"
"精神を操る道具ですか……"
msgstr "……原来如此，是操纵精神的道具吗……"

#. ID 177, Page 3, Line 117, Pos (75,62)
msgid ""
"……何を探せばいいか\n"
"ですか？"
msgstr "……问我该找什么吗？"

#. ID 177, Page 3, Line 119, Pos (75,62)
msgid ""
"そうですね……\n"
"私も古い文献でしか\n"
"読んだことがないのですが"
msgstr "是啊……我也只在古老文献里读到过"

#. ID 177, Page 3, Line 122, Pos (75,62)
msgid ""
"「マリオネットパウダー」\n"
"「あやつりの輪」……\n"
"これらは人を操る効果のある\n"
"道具だそうです"
msgstr ""
"「提线木偶粉末」「操纵之轮」……\n"
"这些据说是具有操纵人类效果的道具"

#. ID 177, Page 3, Line 126, Pos (75,62)
msgid ""
"他にも……\n"
"マインドコントローラーのような\n"
"旧時代の遺物などでしょうか"
msgstr "还有……像精神控制器那样的旧时代遗物之类的吧"

#. ID 177, Page 3, Line 129, Pos (75,62)
msgid ""
"古代の魔法の研究施設などに\n"
"あったと聞いています"
msgstr "听说曾在古代魔法研究设施之类的地方"

#. ID 177, Page 3, Line 131, Pos (75,62)
msgid ""
"他にも精神を落ち着かせる……\n"
"「賢者モード」にする\n"
"薬や物品があれば、\n"
"それでも構いません。"
msgstr ""
"另外，如果有能让人精神平静……\n"
"进入「贤者模式」的药物或物品，也可以。"

#. ID 177, Page 3, Line 137, Pos (75,62)
msgid ""
"…………\\!\n"
"また何か解ったらお願いします"
msgstr "…………\\!如果又明白了什么，请告诉我"

#. ID 177, Page 4, Line 4, Pos (75,62)
msgid ""
"有難うございます\n"
"譲り受けた品を調べましたが\n"
"助ける方法が見えてきました"
msgstr ""
"谢谢您，我调查了您让给我的物品，\n"
"已经看到拯救的方法了"

#. ID 177, Page 4, Line 12, Pos (75,62)
msgid "……それで、最後のお願いになるのですが"
msgstr "……然后，这是最后的请求了"

#. ID 177, Page 4, Line 17, Pos (75,62)
msgid ""
"「支配の塔」……\n"
"という場所をご存知ですか？"
msgstr "您知道一个叫「支配之塔」……的地方吗？"

#. ID 177, Page 4, Line 19, Pos (75,62)
msgid ""
"……古代の文献を調べてみたところ\n"
"どうやらこの場所で\n"
"人を操る術を研究していたのです"
msgstr ""
"……我调查了古代文献，\n"
"看来这个地方曾研究操纵人类的术法"

#. ID 177, Page 4, Line 22, Pos (75,62)
msgid ""
"この場所になら、\n"
"そういった術にかかった人間を\n"
"元に戻す術もあるはずです"
msgstr ""
"在这个地方，\n"
"应该也有让中了那种术的人恢复原状的方法"

#. ID 177, Page 4, Line 25, Pos (75,62)
msgid "……それを見つけ出してください"
msgstr "……请找出它"

#. ID 177, Page 4, Line 30, Pos (75,62)
msgid ""
"……支配の塔へは\n"
"宿屋の魔導士に転送してもらうよう\n"
"依頼してあります"
msgstr ""
"……去支配之塔的事，\n"
"我已经委托旅馆的魔导士进行传送了"

#. ID 177, Page 4, Line 33, Pos (75,62)
msgid ""
"お手数をおかけします……\n"
"よろしくお願いします"
msgstr "给您添麻烦了……拜托您了"

#. ID 177, Page 5, Line 4, Pos (75,62)
msgid ""
"支配の塔は……\n"
"表向きは古代王国の遺跡として\n"
"アバロソが管理しています"
msgstr ""
"支配之塔……\n"
"表面上作为古代王国的遗迹由阿巴罗索管理着"

#. ID 177, Page 5, Line 7, Pos (75,62)
msgid ""
"その実体は“禁呪”……\n"
"禁忌の魔法を行使する\n"
"場所だったのです"
msgstr "其实体是「禁咒」……是行使禁忌魔法的场所"

#. ID 177, Page 5, Line 10, Pos (75,62)
msgid ""
"恐らく……“禁呪”について\n"
"何かの資料が塔には\n"
"残っているはずです"
msgstr "恐怕……塔里应该还留有关于「禁咒」的某些资料"

#. ID 177, Page 5, Line 13, Pos (75,62)
msgid ""
"怪しいと思う場所は\n"
"調べてみてください"
msgstr "请调查您觉得可疑的地方"

#. ID 177, Page 5, Line 15, Pos (75,62)
msgid "例えば、本棚とか……"
msgstr "比如，书架之类的……"

#. ID 177, Page 6, Line 3, Pos (75,62)
msgid "＊……何かに夢中で、こちらに気がついていない"
msgstr "＊……正专注于什么，没有注意到这边"

#. ID 177, Page 6, Line 4, Pos (75,62)
#. Contains choice at line 2 (2 options)
msgid "＊話しかけますか？"
msgstr "＊要搭话吗？"

#. ID 177, Page 6, Line 7, Pos (75,62)
#. ID 177, Page 6, Line 215, Pos (75,62)
#. ID 177, Page 6, Line 247, Pos (75,62)
msgid "………"
msgstr "………"

#. ID 177, Page 6, Line 16, Pos (75,62)
msgid ""
"うー……\n"
"あー……"
msgstr "唔——……啊——……"

#. ID 177, Page 6, Line 18, Pos (75,62)
msgid "はっ……　あっ……"
msgstr "啊……　呀……"

#. ID 177, Page 6, Line 24, Pos (75,62)
msgid "ふん……やはりお前じゃったか"
msgstr "哼……果然是你啊"

#. ID 177, Page 6, Line 32, Pos (75,62)
msgid ""
"そこの隠密が……\n"
"何かコソコソやっていたのには\n"
"とっくに気がついておったわ"
msgstr "那边的密探……偷偷摸摸搞什么，我早就注意到了"

#. ID 177, Page 6, Line 35, Pos (75,62)
msgid ""
"第一王女の洗脳を解こうと\n"
"お前を遣って\n"
"調べていたそうじゃな？"
msgstr "听说为了解除第一王女的洗脑，派你进行调查了？"

#. ID 177, Page 6, Line 42, Pos (75,62)
msgid ""
"その隠密も、もう\n"
"催眠を施してある……\n"
"全ては聞き出してある"
msgstr "那个密探也已经被施加了催眠……全都问出来了"

#. ID 177, Page 6, Line 45, Pos (75,62)
msgid ""
"……ま、それで用は済んだが\n"
"折角なんで頭の中をずっと\n"
"真っ白にしてやったがのう"
msgstr ""
"……嘛，这样事情就办完了，不过难得，\n"
"我就把他的脑子一直弄成一片空白了"

#. ID 177, Page 6, Line 52, Pos (75,62)
msgid "…さて、提案じゃ"
msgstr "…那么，我提个建议"

#. ID 177, Page 6, Line 53, Pos (75,62)
msgid ""
"お前は中々骨がある……\n"
"わらわと○リーパーに\n"
"協力をするのじゃ"
msgstr "你相当有骨气……来协助我和○梦貘人吧"

#. ID 177, Page 6, Line 56, Pos (75,62)
msgid ""
"そうすれば第一王女を\n"
"助けようとしたことを\n"
"見逃してやってもよいぞ？"
msgstr "这样的话，你试图救第一王女的事我可以放过哦？"

#. ID 177, Page 6, Line 60, Pos (75,62)
#. Choice (2 options)
msgid ""
"協力する\n"
"協力しない"
msgstr ""
"协助\n"
"不协助"

#. ID 177, Page 6, Line 62, Pos (75,62)
