#. ID 33, Page 3, Line 21, Pos (2,0)
msgid ""
"\\>\n"
"\\>野盗の毛を手に入れた！！\\<\\.\\.\\^"
msgstr "\\>\\>获得了盗贼毛！！\\<\\.\\.\\^"

#. ID 33, Page 3, Line 29, Pos (2,0)
msgid ""
"\\>\n"
"\\>野盗頭領の毛を手に入れた！！\\<\\.\\.\\^"
msgstr "\\>\\>获得了盗贼头目毛！！\\<\\.\\.\\^"

#. ID 33, Page 4, Line 202, Pos (2,0)
msgid ""
"\\>「捕まえたぜ！！\n"
"\\>　……って、なんだこりゃ。\\<\\|\\.\\.\n"
"\\>　妙なもん着けやがって！！」\\<\\|\\|\\^"
msgstr ""
"\\>「抓住你了！！\\>　……话说，这是什么啊。\n"
"\\<\\|\\.\\.\\>　居然戴着奇怪的东西！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 209, Pos (2,0)
msgid ""
"\\>\n"
"\\>　男は舌打ちすると、\n"
"\\>　\\n[\\v[6]]の荷物を物色して去っていった。\\<\\|\\|\\^"
msgstr ""
"\\>\\>　男人咂了咂嘴，\n"
"\\>　把\\n[\\v[6]]的行李翻找一番后离开了。\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 225, Pos (2,0)
msgid ""
"\\>\n"
"\\>「捕まえたぜ！！」\\<\\|\\.\\.\\^"
msgstr "\\>\\>「抓住你了！！」\\<\\|\\.\\.\\^"

#. ID 33, Page 4, Line 243, Pos (2,0)
msgid ""
"\\>\n"
"\\>「邪魔なもん剥ぎとっちまうか。」\\<\\|\\.\\.\\^"
msgstr "\\>\\>「把碍事的东西扒掉吧。」\\<\\|\\.\\.\\^"

#. ID 33, Page 4, Line 254, Pos (2,0)
msgid ""
"\\>\n"
"\\>男が服に手をかけようとした隙をつき、\n"
"\\>\\n[\\v[6]]は逃げ出す事に成功した！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>趁男人把手放到衣服上的间隙，\n"
"\\>\\n[\\v[6]]成功逃走了！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 292, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ヘヘッ、久々の女だ。\n"
"\\>　たっぷり可愛がってやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「嘿嘿，好久没见女人了。\n"
"\\>　我会好好疼你的！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 306, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ツイてんな、俺！\n"
"\\>　久々の女がこんなチビッ子だなんてよ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「我真走运！\n"
"\\>　好久没见到的女人居然是这么个小不点！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 324, Pos (2,0)
msgid ""
"\\>\n"
"\\>「うひゃー、おっぱい！　でけー、おっぱい！！\n"
"\\>　サイコーだよ、お前のおっぱい！！！！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「哇哈——，奶子！　好大，奶子！！\n"
"\\>　太棒了，你的奶子！！！！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 334, Pos (2,0)
msgid ""
"\\>\n"
"\\>「うひょー、でけえ乳しやがって！\n"
"\\>　たっぷり搾ってやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「哇哦——，居然长了这么大的奶子！\n"
"\\>　我会给你好好挤出来的！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 352, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ヘヘッ、いいケツしてんじゃねーか。\n"
"\\>　たっぷりとかき回してやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「嘿嘿，屁股挺不错嘛。\n"
"\\>　我会好好搅弄一番的！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 368, Pos (2,0)
msgid ""
"\\>\n"
"\\>「うひょー、このぷっくりと膨らんだ腹！！\n"
"\\>　腹ん中の子供、精子漬けにしてやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「哇哦——，这圆鼓鼓隆起的肚子！！\n"
"\\>　你肚子里的孩子，我要让他泡满精子！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 380, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ヘヘッ、匂いで分かるぜ……\n"
"\\>　腹ん中の子供、精子漬けにしてやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「嘿嘿，闻气味就知道了……\n"
"\\>　你肚子里的孩子，我要让他泡满精子！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 402, Pos (2,0)
msgid ""
"\\>\n"
"\\>「なんだこれ？\n"
"\\>　おっぱいが変なので覆われてるじゃねぇか！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「这是什么？\\>　奶子被奇怪的东西盖住了嘛！\n"
"」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 408, Pos (2,0)
msgid ""
"\\>\n"
"\\>「下も変なので覆われてやがるし…\n"
"\\>　まぁ両方穴がパックリ開いてるのは悪くねぇな！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「下面也被奇怪的东西盖住了……\n"
"\\>　不过两个洞都张得大大的，倒也不坏！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 413, Pos (2,0)
msgid ""
"\\>\n"
"\\>「下も変なので覆われてやがるし…\n"
"\\>　まぁ前の穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「下面也被奇怪的东西盖住了……\n"
"\\>　不过前面的洞能用就行！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 420, Pos (2,0)
msgid ""
"\\>\n"
"\\>「下も変なので覆われてやがるし…\n"
"\\>　まぁ後ろの穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「下面也被奇怪的东西盖住了……\n"
"\\>　不过后面的洞能用就行！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 427, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まぁ下の穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr "\\>\\>「不过下面的洞能用就行！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 434, Pos (2,0)
msgid ""
"\\>\n"
"\\>「なんだこれ？\n"
"\\>　下が変なので覆われてるじゃねぇか！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「这是什么？\\>　下面被奇怪的东西盖住了嘛！\n"
"」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 439, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まぁ両方穴がパックリ開いてるのは悪くねぇな！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「不过两个洞都张得大大的，倒也不坏！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 443, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まぁ前の穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr "\\>\\>「不过前面的洞能用就行！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 449, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まぁ後ろの穴が使えるならいいか！」\\<\\|\\|\\^"
msgstr "\\>\\>「不过后面的洞能用就行！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 469, Pos (2,0)
msgid ""
"\\>\n"
"\\>\\n[\\v[6]]は男から逃れようと抵抗し……\\<\\|\\|\\^"
msgstr ""
"\\>\\>\\n[\\v[6]]为了从男人手中逃脱而抵抗……\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 481, Pos (2,0)
msgid ""
"\\>\n"
"\\>なぜだか急に力が入らなくなってしまった……\\<\\|\\|\\^"
msgstr "\\>\\>不知为何突然使不上力气了……\\<\\|\\|\\^"

#. ID 33, Page 4, Line 487, Pos (2,0)
msgid ""
"\\>\n"
"\\>「なんだぁ？　急にボケーっとしやがって。\\<\\|\\|\n"
"\\>　まぁいいか。」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「怎么了？　突然发起呆来了。\n"
"\\<\\|\\|\\>　算了，无所谓。」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 497, Pos (2,0)
msgid ""
"\\>\n"
"\\>\\n[\\v[6]]は抵抗し、\n"
"\\>男の手から逃げ出す事に成功した！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>\\n[\\v[6]]抵抗着，\\>成功从男人手中逃走了！\n"
"！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 508, Pos (2,0)
#. ID 33, Page 4, Line 1094, Pos (2,0)
msgid ""
"\\>\n"
"\\>「暴れんじゃねぇよ！！」\\<\\|\\|\\^"
msgstr "\\>\\>「别乱动！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 561, Pos (2,0)
#. ID 33, Page 4, Line 1154, Pos (2,0)
msgid ""
"\\>\n"
"\\>「痛い目みたくなければ大人しくしてな。」\\<\\|\\|\\^"
msgstr "\\>\\>「不想吃苦头就乖乖待着。」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 585, Pos (2,0)
msgid ""
"\\>\n"
"\\>「前戯なんていらねぇ！\n"
"\\>　すぐにぶち込んでやるよ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「前戏什么的才不需要！\\>　我马上插进去！！\n"
"」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 622, Pos (2,0)
#. ID 33, Page 4, Line 1082, Pos (2,0)
msgid ""
"\\>\n"
"\\>\\n[\\v[6]]は激しく抵抗し、\n"
"\\>男の手から逃げ出す事に成功した！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>\\n[\\v[6]]激烈地抵抗，\n"
"\\>成功从男人手中逃走了！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1063, Pos (2,0)
msgid ""
"\\>\n"
"\\>「う～ん、ちったぁ色気のある反応してくれよ。\n"
"\\>　人形とヤッてる気分になってくるぜ。」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「嗯——，多少给我点有女人味的反应啊。\n"
"\\>　感觉像在跟人偶做一样。」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1099, Pos (2,0)
msgid ""
"\\>\n"
"\\>「だから暴れんじゃねぇって言ってるだろ！！」\\<\\|\\|\\^"
msgstr "\\>\\>「所以我不是说了别乱动吗！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1170, Pos (2,0)
msgid ""
"\\>\n"
"\\>「無理矢理されてるってのに、嫌がらねぇのな。\n"
"\\>　実はまんざらでもないってか？」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「明明是被强行侵犯，居然不讨厌啊。\n"
"\\>　其实并不是不情愿吧？」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1175, Pos (2,0)
msgid ""
"\\>\n"
"\\>「さっきと違って、随分と大人しくなったじゃねぇか。\n"
"\\>　実はまんざらでもないってか？」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「和刚才不同，变得相当老实了嘛。\n"
"\\>　其实并不是不情愿吧？」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1200, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まだ濡れ足りねぇみたいだが、もう我慢できねぇ！\n"
"\\>　一気にぶち込んでやるぜ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「好像还湿得不够，但我已经忍不住了！\n"
"\\>　一口气狠狠插进去！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1205, Pos (2,0)
msgid ""
"\\>\n"
"\\>「大分いい具合になってきたみたいだな。\n"
"\\>　それじゃぶち込んでやるぜ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「看来已经相当到位了。\n"
"\\>　那我就狠狠插进去！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1213, Pos (2,0)
msgid ""
"\\>\n"
"\\>「まだ濡れ足りねぇみたいだが、暴れたバツだ。\n"
"\\>　このままぶち込んでやるぜ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「好像还湿得不够，不过这是你乱动的惩罚。\n"
"\\>　就这样狠狠插进去！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1218, Pos (2,0)
msgid ""
"\\>「嫌がる割にはビショビショじゃねぇか！\n"
"\\>　ほんとは欲しくてたまらないんだろ？\n"
"\\>　だったら思いきりぶち込んでやるよ！！」\\<\\|\\|\\^"
msgstr ""
"\\>「明明嘴上嫌弃，却已经湿得一塌糊涂了不是吗！\n"
"\\>　其实你根本想要得不得了吧？\n"
"\\>　那我就尽情狠狠插进去！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1236, Pos (2,0)
msgid ""
"\\>\n"
"\\>「そろそろツルツルまんこにぶち込んでやるよ。\n"
"\\>　俺のカタチ、しっかり覚えるんだぞ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「差不多该插进你那光滑的骚穴里了。\n"
"\\>　给我好好记住我的形状！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1249, Pos (2,0)
msgid ""
"\\>\n"
"\\>「そいじゃそろそろ種付けといこうか。\n"
"\\>　しっかり孕んで、いい乳出すんだぞ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「那么差不多开始配种吧。\\>　好好怀上，\n"
"给我产出好奶！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1254, Pos (2,0)
msgid ""
"\\>\n"
"\\>「いい乳が出せるように、\n"
"\\>　たっぷり注ぎ込んでやるからな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「为了让你能出好奶，\n"
"\\>　我会给你灌得满满的！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1278, Pos (2,0)
msgid ""
"\\>\n"
"\\>「大分ほぐれてきたようだな。\n"
"\\>　そいじゃケツ穴にぶっ挿してやるぜ！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「看来已经松软不少了。\n"
"\\>　那我就插进你屁眼里！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1291, Pos (2,0)
msgid ""
"\\>\n"
"\\>「そろそろ妊婦まんこにぶち込んでやるよ。\n"
"\\>　そのデカ腹揺らして、イキまくりな！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「差不多该插进孕妇的骚穴里了。\n"
"\\>　晃着那个大肚子，给我拼命高潮吧！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1363, Pos (2,0)
#. ID 33, Page 4, Line 1489, Pos (2,0)
msgid ""
"\\>\n"
"\\>\\n[\\v[6]]は必死に抵抗し、\n"
"\\>男の手から逃げ出す事に、かろうじて成功した……\\<\\|\\|\\^"
msgstr ""
"\\>\\>\\n[\\v[6]]拼命抵抗，\n"
"\\>好不容易才成功从男人手中逃了出来……\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1455, Pos (2,0)
msgid ""
"\\>「おっ、いいねいいね。\n"
"\\>　必死にもがくたんびに、\n"
"\\>　キュウキュウ締めつけてきやがるぜ。\\<\\|\\|\\^"
msgstr ""
"\\>「哦，不错不错。\\>　每次你拼命挣扎，\n"
"\\>　都夹得我紧紧的。\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1458, Pos (2,0)
msgid ""
"\\>\n"
"\\>　そんなに締めつけられたら……\n"
"\\>　ヘヘッ、こっちもあんまもたないかもなぁ？」\\<\\|\\|\\^"
msgstr ""
"\\>\\>　被你夹得这么紧的话……\\>　嘿嘿，\n"
"我这边可能也撑不了多久啊？」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1515, Pos (2,0)
#. ID 33, Page 4, Line 1535, Pos (2,0)
#. ID 33, Page 4, Line 1566, Pos (2,0)
#. ID 33, Page 4, Line 1573, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ウオオオッ！！　出るっ！　出るっ！！\n"
"\\>　ケツん中にぶちまけてやるっ！！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜哦哦哦！！　要出来了！　要出来了！！\n"
"\\>　我要全射在你屁眼里！！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1521, Pos (2,0)
#. ID 33, Page 4, Line 1546, Pos (2,0)
#. ID 33, Page 4, Line 1552, Pos (2,0)
#. ID 33, Page 4, Line 1581, Pos (2,0)
#. ID 33, Page 4, Line 1587, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ウオオオッ！！　出るっ！　出るっ！！\n"
"\\>　腹ん中の子供にぶっかけてやるっ！！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜哦哦哦！！　要出来了！　要出来了！！\n"
"\\>　我要浇射在你肚子里的孩子身上！！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1526, Pos (2,0)
#. ID 33, Page 4, Line 1557, Pos (2,0)
#. ID 33, Page 4, Line 1592, Pos (2,0)
msgid ""
"\\>\n"
"\\>「ウオオオッ！！　出るっ！　出るっ！！\n"
"\\>　孕めっ！！　孕んじまえっ！！！」\\<\\|\\|\\^"
msgstr ""
"\\>\\>「呜哦哦哦！！　要出来了！　要出来了！！\n"
"\\>　怀上吧！！　给我怀上！！！」\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1782, Pos (2,0)
msgid ""
"\\>\n"
"\\>男の動きが止まった瞬間を見計らい、\n"
"\\>\\n[\\v[6]]は男を突き飛ばした！！\\<\\|\\|\\^"
msgstr ""
"\\>\\>看准男人动作停下的瞬间，\n"
"\\>\\n[\\v[6]]一把将男人推开！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1816, Pos (2,0)
msgid ""
"\\>「チッ、中に出しそびれちまったぜ。\n"
"\\>　でもまぁ、白濁まみれのイイ格好になったな。\\<\\|\\|\n"
"\\>\n"
"\\>　またぶっかけられたくなったら、いつでも来いよ！！」\\<\\|\\|\\^"
msgstr ""
"\\>「啧，没来得及射在里面。\\>　不过嘛，\n"
"你现在浑身白浊的样子倒挺不错。\n"
"\\<\\|\\|\\>\\>　要是又想被浇射了，随时来啊！！」\n"
"\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1826, Pos (2,0)
#. ID 33, Page 4, Line 1935, Pos (2,0)
#. ID 33, Page 4, Line 2135, Pos (2,0)
msgid ""
"\\>\n"
"\\>男は去り際に荷物を物色していった！！\\<\\|\\|\\^"
msgstr "\\>\\>男人离开时还顺手翻找物色了行李！！\\<\\|\\|\\^"

#. ID 33, Page 4, Line 1834, Pos (2,0)
#. ID 33, Page 4, Line 1965, Pos (2,0)
#. ID 33, Page 4, Line 2165, Pos (2,0)
msgid ""
"\\>\n"
"\\>男が去ってからしばらくして、\n"
"\\>\\n[\\v[6]]はヨロヨロと体を起こす。\\<\\|\\|\\|\\^"
