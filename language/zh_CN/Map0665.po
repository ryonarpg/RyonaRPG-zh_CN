#. ID 13, Page 3, Line 3, Pos (4,22)
#. ID 17, Page 3, Line 3, Pos (17,22)
#. ID 18, Page 3, Line 3, Pos (17,8)
msgid "転生は完了したようだ。"
msgstr "转生好像完成了。"

#. ID 14, Page 1, Line 3, Pos (18,6)
msgid ""
"最近、遠くの村を襲った魔物のデータが\n"
"手に入ってね。試そうと思っているのだ。"
msgstr ""
"最近，我得到了袭击远处村庄的魔物的数据。\n"
"正想试试呢。"

#. ID 14, Page 2, Line 3, Pos (18,6)
msgid "なるほど。これは興味深い。"
msgstr "原来如此。这很有意思。"

#. ID 15, Page 1, Line 4, Pos (4,9)
#. ID 15, Page 2, Line 4, Pos (4,9)
msgid "美しい体ですな。"
msgstr "真是美丽的身体啊。"

#. ID 15, Page 1, Line 8, Pos (4,9)
#. ID 15, Page 2, Line 8, Pos (4,9)
msgid ""
"転生は素晴らしい技術です。\n"
"\\!まさに「新しい自分になる」\n"
"という言葉にふさわしい！"
msgstr ""
"转生是了不起的技术。\n"
"\\!正适合「成为新的自己」这句话！"

#. ID 15, Page 1, Line 15, Pos (4,9)
#. Contains choice at line 2 (2 options)
#. ID 15, Page 2, Line 15, Pos (4,9)
#. Contains choice at line 2 (2 options)
msgid "貴方、人の限界を超えてみませんか？"
msgstr "您，不想超越人类的极限试试看吗？"

#. ID 15, Page 1, Line 18, Pos (4,9)
#. ID 15, Page 2, Line 18, Pos (4,9)
msgid "では、こちらへ・・・・。"
msgstr "那么，请到这边来・・・・。"

#. ID 15, Page 1, Line 36, Pos (4,9)
#. ID 15, Page 2, Line 37, Pos (4,9)
msgid "・・・・！？"
msgstr "・・・・！？"

#. ID 15, Page 1, Line 37, Pos (4,9)
#. ID 15, Page 2, Line 38, Pos (4,9)
msgid "体の様子がおかしい。"
msgstr "身体的情况很奇怪。"

#. ID 15, Page 1, Line 50, Pos (4,9)
#. ID 15, Page 2, Line 52, Pos (4,9)
msgid ""
"周りのコードが\\n[\\v[6]]の淫核に、\n"
"何かを入れて刺激してきた！"
msgstr ""
"周围的线缆将什么东西插进\\n[\\v[6]]的阴核里刺激\n"
"起来！"

#. ID 15, Page 1, Line 83, Pos (4,9)
#. ID 15, Page 2, Line 88, Pos (4,9)
msgid ""
"機械の触手によって\\n[\\v[6]]の体が、\n"
"ほぐされていく！"
msgstr "机械触手将\\n[\\v[6]]的身体一点点揉松！"

#. ID 15, Page 1, Line 117, Pos (4,9)
#. ID 15, Page 2, Line 125, Pos (4,9)
msgid ""
"\\n[\\v[6]]は自らの体の異常に気付くが\n"
"その事について何か行動を起こす前に\n"
"左右の機械が両足に何かを捻じ込んできた！"
msgstr ""
"\\n[\\v[6]]虽然察觉到自己身体的异常，\n"
"但在对此做出任何行动之前，\n"
"左右的机械就把什么东西拧进了双腿！"

#. ID 15, Page 1, Line 156, Pos (4,9)
#. ID 15, Page 2, Line 167, Pos (4,9)
msgid "\\n[\\v[6]]は頭で体の異常を理解できなくなった！"
msgstr "\\n[\\v[6]]头脑中已经无法理解身体的异常了！"

#. ID 15, Page 1, Line 179, Pos (4,9)
#. ID 15, Page 2, Line 191, Pos (4,9)
msgid ""
"自らの血と愛液にまみれた\\n[\\v[6]]の両足は\n"
"異形の物と化し埋め込まれた物と\n"
"同じような鱗に覆われてしまった……"
msgstr ""
"沾满自己鲜血与爱液的\\n[\\v[6]]的双腿化作了异形\n"
"之物，并被与埋入之物相同的鳞片覆盖了……"

#. ID 15, Page 1, Line 188, Pos (4,9)
#. ID 15, Page 2, Line 200, Pos (4,9)
#. ID 30, Page 2, Line 345, Pos (15,19)
#. ID 30, Page 3, Line 434, Pos (15,19)
#. ID 40, Page 1, Line 72, Pos (10,23)
#. ID 40, Page 2, Line 72, Pos (10,23)
msgid "…………………………………………"
msgstr "…………………………………………"

#. ID 15, Page 1, Line 189, Pos (4,9)
#. ID 15, Page 2, Line 201, Pos (4,9)
msgid "\\n[\\v[6]]はらみあに転生してしまった……"
msgstr "\\n[\\v[6]]已经转生成了拉米亚……"

#. ID 15, Page 3, Line 3, Pos (4,9)
msgid "犬には関係のないことだ。"
msgstr "这跟狗没有关系。"

#. ID 15, Page 4, Line 3, Pos (4,9)
msgid "機械は機械。生命とは根本が違う。"
msgstr "机械就是机械。与生命有着根本的不同。"

#. ID 16, Page 1, Line 3, Pos (6,8)
msgid ""
"ラミアの鱗を使う事で、\n"
"ラミアに転生できるのです。"
msgstr "使用拉米亚之鳞，就能转生为拉米亚。"

#. ID 17, Page 1, Line 11, Pos (17,22)
msgid ""
"お願いします！\\.\\.なんでも言うこと聞きますから！\\.\\.\\.\n"
"だから魔物にだけはしないでっ・・・\\^"
msgstr ""
"拜托了！\\.\\.我什么都会听您的！\n"
"\\.\\.\\.所以请至少不要把我变成魔物・・・\\^"

#. ID 17, Page 1, Line 24, Pos (17,22)
msgid "ひッ・・・！"
msgstr "咿・・・！"

#. ID 17, Page 2, Line 11, Pos (17,22)
msgid ""
"あんっ・・・！\\.\n"
"早く私をスライムにして・・・！"
msgstr "啊嗯・・・！\\.快点把我变成史莱姆・・・！"

#. ID 17, Page 2, Line 105, Pos (17,22)
msgid "ア・・・・\\.\\.\\.アハ？"
msgstr "啊・・・・\\.\\.\\.啊哈？"

#. ID 18, Page 1, Line 11, Pos (17,8)
msgid ""
"ねぇ、お姉ちゃん？\n"
"それなに・・・？"
msgstr "呐，姐姐？那是什么・・・？"

#. ID 18, Page 1, Line 24, Pos (17,8)
msgid "いぎッ・・・！"
msgstr "咿咕・・・！"

#. ID 18, Page 2, Line 11, Pos (17,8)
msgid "・・・あ、\\.\\.またそれするの？"
msgstr "・・・啊，\\.\\.又要做那个吗？"

#. ID 18, Page 2, Line 58, Pos (17,8)
msgid "ッ・・・！"
msgstr "呃・・・！"

#. ID 18, Page 2, Line 166, Pos (17,8)
msgid ""
"これが・・・わたし？\\.\\.\n"
"すごくうれしい！"
msgstr "这就是・・・我？\\.\\.好高兴！"

#. ID 19, Page 1, Line 3, Pos (9,7)
msgid ""
"とても出来のいい個体は、\n"
"その手の人がいい値で買ってくれるのだ。"
msgstr "做得非常好的个体，会有那种人出高价买走。"

#. ID 20, Page 1, Line 3, Pos (2,5)
msgid ""
"*中にいるラミアは何かを\n"
" 訴えるような目でこちらを見ている。"
msgstr "*里面的拉米亚用像是在诉说什么的眼神看着这边。"

#. ID 25, Page 1, Line 4, Pos (2,19)
msgid ""
"嫌だ・・・！\n"
"魔物なんかになるもんか・・！"
msgstr "不要・・・！我怎么会变成魔物那种东西・・！"

#. ID 25, Page 1, Line 9, Pos (2,19)
msgid ""
"私が・・・\\.私じゃない・・・！\n"
"助けて・・・！元に戻して！"
msgstr ""
"我・・・\\.不是我・・・！救我・・・！\n"
"把我变回去！"

#. ID 25, Page 1, Line 14, Pos (2,19)
msgid "あぁぁぁぁ・・・・"
msgstr "啊啊啊啊・・・・"

#. ID 25, Page 1, Line 15, Pos (2,19)
msgid "*もう自分が人であった事など覚えてないのだろう。"
msgstr "*大概已经不记得自己曾经是人了。"

#. ID 30, Page 1, Line 4, Pos (15,19)
msgid ""
"私が何をしたの・・・！？\n"
"ここから出してください・・・！"
msgstr "我做了什么・・・！？请让我离开这里・・・！"

#. ID 30, Page 1, Line 11, Pos (15,19)
msgid ""
"あはっ・・・\\.\\.溶けたい・・・。\n"
"溶けたいのに・・・！"
msgstr ""
"啊哈・・・\\.\\.我想融化・・・。\n"
"明明想融化・・・！"

#. ID 30, Page 1, Line 13, Pos (15,19)
msgid "*大分、影響を受けているようだ。"
msgstr "*看来受到了相当大的影响。"

#. ID 30, Page 1, Line 39, Pos (15,19)
msgid ""
"ソノ体、きもちイイデショ？\n"
"モットモット、なかまフヤソウ、ネ"
msgstr "那具身体，很舒服吧？更多更多，增加同伴吧，呐"

#. ID 30, Page 1, Line 43, Pos (15,19)
msgid ""
"この体、きもちイイヨ？\n"
"アナタモ、変えてアゲヨウカ？"
msgstr "这具身体，很舒服哦？你也，要我帮你改变吗？"

#. ID 30, Page 1, Line 45, Pos (15,19)
msgid "*丁寧にお断りした。"
msgstr "*礼貌地拒绝了。"

#. ID 30, Page 2, Line 3, Pos (15,19)
#. ID 30, Page 3, Line 3, Pos (15,19)
msgid ""
"・・・アラ？ソノクビワ・・・\n"
"あなたセイドレイなの・・・？\n"
"ソウ・・・うふふ・・・ソウナンダ"
msgstr ""
"・・・哎呀？那个项圈・・・你是性奴隶啊・・・？\n"
"这样・・・呵呵・・・是这样啊"

#. ID 30, Page 2, Line 16, Pos (15,19)
#. ID 30, Page 3, Line 21, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「きゃっ！……な、なに……？は、放してっ！」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「呀！……什、什么……？放、放开我！\n"
"」\\|\\^"

#. ID 30, Page 2, Line 18, Pos (15,19)
#. ID 30, Page 3, Line 25, Pos (15,19)
msgid ""
"スライムがぬるりと金網をすり抜けて\n"
"\\n[\\v[6]]に絡み付いてきた！"
msgstr "史莱姆滑腻地穿过铁丝网，缠上了\\n[\\v[6]]！"

#. ID 30, Page 2, Line 34, Pos (15,19)
#. ID 30, Page 3, Line 46, Pos (15,19)
msgid ""
"ウフフ・・・つかマえタ・・・♪\n"
"今のワタシににカナアミなんて意味がないノ\n"
"あなたがトってもカワイイのが悪いのヨ・・・"
msgstr ""
"呵呵・・・抓・到・了・・・♪现在的我，\n"
"铁丝网什么的根本没有意义，\n"
"你太可爱了才是你的错哦・・・"

#. ID 30, Page 2, Line 37, Pos (15,19)
#. ID 30, Page 3, Line 49, Pos (15,19)
msgid ""
"ウフフ・・・あなたワタシのものにするワ\n"
"研究所インが、シャベってタ・・・\n"
"セイドレいはカイゾウしても、イイって"
msgstr ""
"呵呵・・・我要把你变成我的东西。\n"
"研究所的人说过・・・性奴隶就算改造也没关系"

#. ID 30, Page 2, Line 40, Pos (15,19)
#. ID 30, Page 3, Line 57, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「ひっ！い、や……いや、いや！やめてぇ！」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「咿！不、要……不要，不要！\n"
"住手啊！」\\|\\^"

#. ID 30, Page 2, Line 54, Pos (15,19)
#. ID 30, Page 3, Line 74, Pos (15,19)
msgid ""
"\\S[3]「フフ、わたしもオナジコトを願ったワ・・・\n"
"　デモ・・・もう、ワカルデショウ？\\|\\^"
msgstr ""
"\\S[3]「呵呵，\n"
"　我也曾经许过同样的愿望・・・\n"
"　但是・・・现在，你明白了吧？\\|\\^"

#. ID 30, Page 2, Line 56, Pos (15,19)
#. ID 30, Page 3, Line 76, Pos (15,19)
msgid ""
"\\S[3]「ダイジョウブ、痛くはないワ・・・\n"
"気持ちヨクして、アナタも私のナカマに、ネ？」\\|\\^"
msgstr ""
"\\S[3]「没关系，不会痛的・・・我会让你舒服的，\n"
"你也成为我的同伴吧，呐？」\\|\\^"

#. ID 30, Page 2, Line 59, Pos (15,19)
#. ID 30, Page 3, Line 79, Pos (15,19)
msgid ""
"\\n[\\v[6]]の懇願など聞くつもりなどなく\n"
"ねっとりとしたスライムの触腕が体中を這い回る！"
msgstr ""
"\\n[\\v[6]]的恳求之类的，它根本不打算听，\n"
"黏糊糊的史莱姆触腕在全身爬来爬去！"

#. ID 30, Page 2, Line 69, Pos (15,19)
#. ID 30, Page 3, Line 96, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「だっ、だめぇ……！やめて！ん、んっ……！\n"
"　そんなトコばっかり……あっ、ひぃ」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「不、不行……！住手！嗯、嗯……！\n"
"　尽是那种地方……啊、咿」\\|\\^"

#. ID 30, Page 2, Line 102, Pos (15,19)
#. ID 30, Page 3, Line 138, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「はぁ……はぁ……あひっ！か、らだが、熱く……\n"
"んっ、ああっ！」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「哈啊……哈啊……啊咿！身、身体，\n"
"好热……嗯、啊啊！」\\|\\^"

#. ID 30, Page 2, Line 105, Pos (15,19)
#. ID 30, Page 3, Line 141, Pos (15,19)
msgid ""
"\\S[3]「ダイブほぐされテきたヨウ・・・ね？\n"
"　ハァ、ハァ、ガマンできないワ・・・」\\|\\^"
msgstr ""
"\\S[3]「相当被揉松了的样子……对吧？　哈啊、\n"
"　哈啊，忍不住了哇……」\\|\\^"

#. ID 30, Page 2, Line 108, Pos (15,19)
#. ID 30, Page 3, Line 146, Pos (15,19)
msgid "\\n[\\v[6]]の膣口にスライムの一部が入り込んだ！"
msgstr "\\n[\\v[6]]的阴道口有一部分史莱姆侵入了！"

#. ID 30, Page 2, Line 110, Pos (15,19)
#. ID 30, Page 3, Line 150, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「あっ！ああぁぁぁ───────っ！」\\|\\^"
msgstr "\\S[3]\\n[\\v[6]]「啊！啊啊啊啊───────！」\\|\\^"

#. ID 30, Page 2, Line 144, Pos (15,19)
#. ID 30, Page 3, Line 189, Pos (15,19)
msgid "\\S[3]「モット、モット・・・！ナカマ、ふやス・・・！」\\|\\^"
msgstr "\\S[3]「更多、更多……！同伴，增加……！」\\|\\^"

#. ID 30, Page 2, Line 145, Pos (15,19)
#. ID 30, Page 3, Line 190, Pos (15,19)
msgid ""
"何かに取り付かれたように前も後ろも構わず\n"
"\\n[\\v[6]]の穴という穴を塞ぎほじくり返す！"
msgstr ""
"像被什么东西附身一样，不顾前后，\n"
"\\n[\\v[6]]所有能称为孔洞的地方都塞住并反复抠挖\n"
"！"

#. ID 30, Page 2, Line 185, Pos (15,19)
#. ID 30, Page 3, Line 241, Pos (15,19)
msgid ""
"\\S[3]「イク、いく・・・アナタのイチバンおくニ\n"
"ワタしの分身、イクッ・・・！ウケとっテ！」\\|\\^"
msgstr ""
"\\S[3]「要去了、要去了……在你最深处，我的分身，\n"
"要去了……！接住吧！」\\|\\^"

#. ID 30, Page 2, Line 187, Pos (15,19)
#. ID 30, Page 3, Line 243, Pos (15,19)
msgid ""
"\\n[\\v[6]]の子宮と直腸にこれでもかと\n"
"スライムが注ぎ込まれる！"
msgstr ""
"\\n[\\v[6]]的子宫和直肠里，\n"
"史莱姆像是没完没了般注入！"

#. ID 30, Page 2, Line 202, Pos (15,19)
#. ID 30, Page 3, Line 270, Pos (15,19)
msgid ""
"\\S[3]「フフ・・・？おナカ、クチュクチュうごいテ\n"
"アナたのコト、きもちヨク変えチャうノ・・・」\\|\\^"
msgstr ""
"\\S[3]「呵呵……？肚子里咕啾咕啾地动着，\n"
"会把你舒服地改变掉哦……」\\|\\^"

#. ID 30, Page 2, Line 204, Pos (15,19)
#. ID 30, Page 3, Line 272, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「からダが……カラだが、ぁあ……ひんっ……」\\|\\^"
msgstr "\\S[3]\\n[\\v[6]]「身体……身体，啊啊……嗯……」\\|\\^"

#. ID 30, Page 2, Line 223, Pos (15,19)
#. ID 30, Page 3, Line 296, Pos (15,19)
msgid ""
"\\S[3]「ホラ、なかカラどんドン溶かシテ・・・\n"
"おナカのイロ、かわッテ、変えラレテるノワカる？」\\|\\^"
msgstr ""
"\\S[3]「看，从里面不断地融化……肚子的颜色变了，\n"
"你能明白自己正被改变着吗？」\\|\\^"

#. ID 30, Page 2, Line 225, Pos (15,19)
#. ID 30, Page 3, Line 298, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「へん……っ、おなかが、へん、なのぉ……\n"
"胎内で、動いて……やはぁん！」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「奇怪……肚子里、好奇怪……\n"
"在胎内动着……呀哈嗯！」\\|\\^"

#. ID 30, Page 2, Line 245, Pos (15,19)
#. ID 30, Page 3, Line 326, Pos (15,19)
msgid ""
"\\S[3]「ココロも、カラだモ、ドロドロにとけテ・・・\n"
"フフ、きもちイイでしョ・・・？そんナカオしてル」\\|\\^"
msgstr ""
"\\S[3]「心也好、身体也好，都黏糊糊地融化……\n"
"呵呵，很舒服吧……？露出那种表情」\\|\\^"

#. ID 30, Page 2, Line 247, Pos (15,19)
#. ID 30, Page 3, Line 328, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「いや、いやァ……とけチャう、とけちゃウ\n"
"なんデ……気持ちイいの、あっアッ……くぅン！」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「不要、不要啊……要融化了、\n"
"要融化了……好舒服，啊、啊……唔嗯！」\\|\\^"

#. ID 30, Page 2, Line 267, Pos (15,19)
#. ID 30, Page 3, Line 350, Pos (15,19)
msgid "\\S[3]「ほラ、モウすこシ・・・」\\|\\^"
msgstr "\\S[3]「看，再多一点……」\\|\\^"

#. ID 30, Page 2, Line 268, Pos (15,19)
#. ID 30, Page 3, Line 351, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「かわル、かわっちゃウ……私、かわっちャウ！\n"
"変わりたく、ナイ、溶けたく、きもちヨク……アハ」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「要变了、要变了……我、要变了！\n"
"不想变、不想融化，舒服地……啊哈」\\|\\^"

#. ID 30, Page 2, Line 288, Pos (15,19)
#. ID 30, Page 3, Line 379, Pos (15,19)
msgid ""
"\\S[3]！！\n"
"\\n[\\v[6]]の手足の指先がドロドロと溶け出している！\\|\\^"
msgstr ""
"\\S[3]！！\n"
"\\n[\\v[6]]的手脚指尖正黏糊糊地开始融化！\\|\\^"

#. ID 30, Page 2, Line 290, Pos (15,19)
#. ID 30, Page 3, Line 381, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「ひンッ！とける、とけルノぉ！気持ちイイ……ッ\n"
"どろドロに、アンッ！わたシ、溶けちゃウぅ──ッ」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「嗯！融化了、要融化了！好舒服……\n"
"黏糊糊地，啊嗯！我、要融化了──！」\\|\\^"

#. ID 30, Page 2, Line 303, Pos (15,19)
#. ID 30, Page 3, Line 394, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「あッアっ……きもちイイ──────ッ！！！」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「啊、啊……好舒服──────！！！」\n"
"\\|\\^"

#. ID 30, Page 2, Line 337, Pos (15,19)
#. ID 30, Page 3, Line 426, Pos (15,19)
msgid ""
"\\n[\\v[6]]の体はテラテラと滑り光る\n"
"ゼリーのような半透明のものに\n"
"作り変えられてしまった……"
msgstr ""
"\\n[\\v[6]]的身体被改造成了闪闪发亮、\n"
"滑溜溜的果冻般半透明物体……"

#. ID 30, Page 2, Line 348, Pos (15,19)
#. ID 30, Page 3, Line 437, Pos (15,19)
msgid "\\n[\\v[6]]はスライムに転生してしまった……"
msgstr "\\n[\\v[6]]转生成了史莱姆……"

#. ID 30, Page 2, Line 352, Pos (15,19)
#. ID 30, Page 3, Line 441, Pos (15,19)
msgid ""
"\\S[3]アハ、アナタの色とってもキレイ・・・\n"
"それジャあ、スライム同士たのしみまショウ・・・\\|\\^"
msgstr ""
"\\S[3]啊哈，你的颜色非常漂亮……那么，\n"
"就让我们史莱姆之间好好享受吧……\\|\\^"

#. ID 30, Page 2, Line 354, Pos (15,19)
#. ID 30, Page 3, Line 443, Pos (15,19)
msgid ""
"\\S[3]その後、事が終わるのを見計らったように\n"
"駆け付けた研究所員に助け出された・・・\\|\\^"
msgstr ""
"\\S[3]之后，\n"
"仿佛算准事情结束般赶来的研究所人员救出了她……\n"
"\\|\\^"

#. ID 30, Page 3, Line 17, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「うわっ！……な、なんだ……？は、放せっ！」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「哇！……什、什么……？放、放开我！\n"
"」\\|\\^"

#. ID 30, Page 3, Line 53, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「ひっ！い、や……いやだ、よせ！やめろぉ！」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「咿！不、要……不要，住手！\n"
"快停下！」\\|\\^"

#. ID 30, Page 3, Line 91, Pos (15,19)
msgid ""
"\\S[3]\\n[\\v[6]]\n"
"「だっ、だめだ……！よせ！ん、んっ……！\n"
"　そんなところばかり……あっ、ひぃ」\\|\\^"
msgstr ""
"\\S[3]\\n[\\v[6]]「不、不行……！住手！嗯、嗯……！\n"
"　净是那种地方……啊、咿」\\|\\^"

#. ID 35, Page 1, Line 4, Pos (15,5)
msgid "ママぁ。おうち帰りたいよ・・・。"
msgstr "妈妈。我想回家……。"

#. ID 35, Page 1, Line 8, Pos (15,5)
msgid "*意識を失っているようだ。"
msgstr "*似乎失去了意识。"

#. ID 35, Page 1, Line 12, Pos (15,5)
msgid ""
"ママぁ。どこー？\n"
"ママも私の針で仲間にしてあげるよー。"
msgstr ""
"妈妈。在哪里～？\n"
"我也要用我的针把妈妈变成同伴哦～。"

#. ID 35, Page 1, Line 14, Pos (15,5)
msgid "*誰が見ても立派な蜂少女である。"
msgstr "*不管谁看都是个出色的蜂少女。"

#. ID 40, Page 1, Line 10, Pos (10,23)
#. ID 40, Page 2, Line 10, Pos (10,23)
msgid "お姉ちゃんもわたしが仲間にしてあげる！"
msgstr "姐姐也由我来把你变成同伴！"

#. ID 40, Page 1, Line 75, Pos (10,23)
#. ID 40, Page 2, Line 75, Pos (10,23)
msgid "\\n[\\v[6]]は蜂少女に転生してしまった……"
msgstr "\\n[\\v[6]]转生成了蜂少女……"

#. ID 40, Page 1, Line 82, Pos (10,23)
msgid "わたしがみんなの所へ連れて行ってあげる！"
msgstr "我来带你去大家那里！"

#. ID 40, Page 2, Line 82, Pos (10,23)
msgid ""
"タイミングをみはからったように、\n"
"研究員が助けに来てくれた。"
msgstr "仿佛算准时机似的，研究员来救我了。"
