#. ID 5, Page 2, Line 3, Pos (14,39)
msgid ""
"この家から出て行きたくない…\\!\n"
"ずっとあの人の傍にいたい…"
msgstr "我不想离开这个家……\\!我想一直待在那个人身边……"

#. ID 12, Page 1, Line 8, Pos (13,11)
msgid ""
"ウフフ…\\!ご主人様…\n"
"\\!もう、我慢できません…"
msgstr "嘻嘻……\\!主人……\\!已经，忍不住了……"

#. ID 12, Page 1, Line 24, Pos (13,11)
msgid ""
"どう…\\!気持ちいい…？\n"
"私も…気持ちいいよ…"
msgstr "怎么样……\\!舒服吗……？我也……很舒服哦……"

#. ID 12, Page 1, Line 31, Pos (13,11)
msgid ""
"ウフフ、綺麗です…\\!ご主人様…\n"
"もっと…\\!もっと…"
msgstr "嘻嘻，好美……\\!主人……再多……\\!再多……"

#. ID 12, Page 1, Line 36, Pos (13,11)
msgid ""
"ねえ…\\!まだまだこんなもんじゃないよね\n"
"もっともっときもちよくなれるよね…"
msgstr ""
"呐……\\!还远远不止这样吧，还能更加、\n"
"更加舒服对吧……"

#. ID 12, Page 1, Line 41, Pos (13,11)
msgid ""
"素敵…\\!こうやって貴女とひとつになれる\n"
"なんて…\\!これなら私…"
msgstr ""
"太美妙了……\\!居然能像这样与你合为一体……\n"
"\\!这样的话我……"

#. ID 12, Page 1, Line 46, Pos (13,11)
msgid ""
"本当はもっと早くご主人様とこんな事\n"
"したかったんですよ…\\!フフフ…"
msgstr "其实我想更早和主人做这种事的…\\!呵呵呵…"

#. ID 12, Page 1, Line 56, Pos (13,11)
msgid "あらあら何をやってるのかしら？"
msgstr "哎呀哎呀，你们在做什么呢？"

#. ID 12, Page 1, Line 65, Pos (13,11)
#. ID 12, Page 1, Line 81, Pos (13,11)
msgid "あ…\\!ウネ様…"
msgstr "啊…\\!乌涅大人…"

#. ID 12, Page 1, Line 73, Pos (13,11)
msgid "あ…\\!ウネさまぁ…"
msgstr "啊…\\!乌涅大人～…"

#. ID 12, Page 1, Line 77, Pos (13,11)
msgid "あ…\\!ウネさまだぁ…"
msgstr "啊…\\!是乌涅大人～…"

#. ID 12, Page 1, Line 85, Pos (13,11)
msgid ""
"クス…\\!ウネ様…どうですか？\n"
"ご一緒に。"
msgstr "噗嗤…\\!乌涅大人…怎么样？一起吧。"

#. ID 12, Page 1, Line 91, Pos (13,11)
msgid ""
"まったく、いけないペット達ね。\n"
"いいわ、お仕置きしてあげる…"
msgstr "真是的，不乖的宠物们呢。好吧，我来惩罚你们…"

#. ID 12, Page 1, Line 100, Pos (13,11)
msgid "ひっ…ひゃ…\\!あう…\\!気持ちいいよぉ…"
msgstr "咿…呀…\\!啊呜…\\!好舒服啊…"

#. ID 12, Page 1, Line 108, Pos (13,11)
#. ID 12, Page 1, Line 112, Pos (13,11)
msgid "ウネさまぁ…\\!もっと…もっとしてえ…"
msgstr "乌涅大人～…\\!再多…再多做一点啊…"

#. ID 12, Page 1, Line 116, Pos (13,11)
msgid "ああ…素敵…\\!お願い…もっとこの人と…"
msgstr "啊啊…好棒…\\!拜托…让我和这个人更多地…"

#. ID 12, Page 1, Line 120, Pos (13,11)
msgid ""
"ああ…ウネ様もとても素敵です…\n"
"\\!もっともっと可愛がってください…"
msgstr "啊啊…乌涅大人也非常棒…\\!请更加更加疼爱我…"

#. ID 12, Page 1, Line 126, Pos (13,11)
msgid "まったく、仕様がないペット達だこと…"
msgstr "真是的，拿你们这些宠物没办法…"

#. ID 12, Page 1, Line 137, Pos (13,11)
msgid ""
"ほら、出すわよ！！\n"
"受け取りなさい！！"
msgstr "看，要出来了哦！！接好了！！"

#. ID 12, Page 1, Line 143, Pos (13,11)
msgid ""
"…あ…\\!死んじゃう…\\!気持ちよすぎて\n"
"死んじゃうよ…"
msgstr "…啊…\\!要死了…\\!舒服得要死了…"

#. ID 12, Page 1, Line 148, Pos (13,11)
msgid "出してぇ…\\!膣内に一杯出してぇ…"
msgstr "射出来啊…\\!在阴道里射满啊…"

#. ID 12, Page 1, Line 152, Pos (13,11)
msgid ""
"ウネさまぁ…\\!とってもとってもきもち\n"
"いいよぉ…"
msgstr "乌涅大人～…\\!非常非常舒服哦…"

#. ID 12, Page 1, Line 157, Pos (13,11)
msgid "も…もう駄目…\\!私…！\\!私…！"
msgstr "不…不行了…\\!我…！\\!我…！"

#. ID 12, Page 1, Line 161, Pos (13,11)
msgid ""
"出してぇ…\\!私とご主人様を真っ白に染め\n"
"てくださいいい！！"
msgstr "射出来啊…\\!请把我和主人染成纯白吧！！"

#. ID 12, Page 1, Line 176, Pos (13,11)
msgid ""
"フフフ…\\!可愛いペット達だこと\n"
"ほら、汚しちゃった所を綺麗にしなさい。"
msgstr ""
"呵呵呵…\\!真是可爱的宠物们，来，\n"
"把弄脏的地方清理干净。"

#. ID 12, Page 1, Line 186, Pos (13,11)
msgid ""
"……\\!ご主人様…\\!これからもずっと…\\!\n"
"一緒…\\!だよ…"
msgstr "……\\!主人…\\!今后也一直…\\!在一起…\\!哦…"

#. ID 12, Page 1, Line 193, Pos (13,11)
msgid ""
"ウフフ…\\!これからもずっと一緒に\n"
"いましょうね…"
msgstr "呵呵…\\!今后也一直在一起吧…"

#. ID 12, Page 1, Line 198, Pos (13,11)
msgid ""
"これからもずっといっしょだよ\n"
"\\!ごしゅじんさま…"
msgstr "今后也一直在一起哦\\!主人…"

#. ID 12, Page 1, Line 203, Pos (13,11)
msgid ""
"フフ…貴女と私…\\!これからもずっと…\n"
"\\!…この牢獄の中で…"
msgstr "呵呵…你和我…\\!今后也一直…\\!…在这牢狱之中…"

#. ID 12, Page 1, Line 208, Pos (13,11)
msgid ""
"フフ…\\!これも悪くないですよね…\n"
"ご主人様…"
msgstr "呵呵…\\!这样也不错吧…主人…"

#. ID 12, Page 2, Line 3, Pos (13,11)
msgid ""
"アハ…\\!ごしゅじんさまだあ…\n"
"ねえ…？きもちいいことしない？\n"
"ウネさまにおしえてもらったんだよ。"
msgstr ""
"啊哈…\\!是主人～…呐…？不做舒服的事吗？\n"
"是乌涅大人教我的哦。"

#. ID 12, Page 3, Line 3, Pos (13,11)
msgid ""
"ウフ…\\!ねえ…貴女…\n"
"気持ちいいことしましょう？"
msgstr "呵呵…\\!呐…你…我们来做舒服的事吧？"

#. ID 12, Page 4, Line 4, Pos (13,11)
msgid ""
"……ご主人様……\\!\n"
"…もう…逃げられないね…\n"
"…\\!なら…せめて…"
msgstr "……主人……\\!…已经…逃不掉了呢……\\!那么…至少…"

#. ID 12, Page 5, Line 3, Pos (13,11)
msgid ""
"ウフフ…\\!ご主人様ぁ♪\n"
"一緒に気持ちいいことしましょうよ。"
msgstr "呵呵…\\!主人～♪一起做舒服的事吧。"

#. ID 13, Page 1, Line 4, Pos (15,8)
msgid ""
"さて、それじゃあ躾の時間よ。\n"
"もう二度と逆らえないようにしてあげるわ"
msgstr ""
"那么，接下来就是调教时间了。\n"
"我会让你再也不能反抗。"

#. ID 13, Page 1, Line 13, Pos (15,8)
msgid ""
"さて、躾の時間よ。\n"
"また良い声で泣いて見せなさい。"
msgstr "那么，是调教时间了。再用好听的声音哭给我看吧。"

#. ID 13, Page 1, Line 22, Pos (15,8)
msgid ""
"さて、躾の時間よ。\n"
"フフフ、本当はこの時を愉しみにしているんでしょう？"
msgstr ""
"那么，是调教时间了。呵呵呵，\n"
"其实你一直在期待这一刻吧？"

#. ID 13, Page 1, Line 31, Pos (15,8)
msgid ""
"さあ、躾の時間よ。\n"
"ふふ、貴女は本当に躾けられるのが大好きのようね。"
msgstr ""
"来吧，是调教时间了。呵呵，\n"
"你好像真的很喜欢被调教呢。"

#. ID 13, Page 1, Line 39, Pos (15,8)
msgid ""
"さあ、貴女の大好きな躾の時間よ。\n"
"あらあら、本当に嬉しそうな顔をしているわね。"
msgstr ""
"来吧，是你最喜欢的调教时间哦。哎呀哎呀，\n"
"真是一副很高兴的样子呢。"

#. ID 13, Page 1, Line 61, Pos (15,8)
msgid "ウフフ、一杯可愛がってあげるわ。"
msgstr "呵呵，我会好好疼爱你的。"

#. ID 13, Page 1, Line 71, Pos (15,8)
msgid ""
"さあて、本番を始めましょう。\n"
"フフフ、耐えられるかしらね。"
msgstr ""
"那么，开始正式的吧。呵呵呵，\n"
"不知道你受不受得了呢。"

#. ID 13, Page 1, Line 87, Pos (15,8)
msgid "フフフ、どうだったかしら…"
msgstr "呵呵，感觉怎么样呢…"

#. ID 13, Page 1, Line 107, Pos (15,8)
msgid "これからも一杯してあげるからね。"
msgstr "今后也会给你很多哦。"

#. ID 13, Page 1, Line 118, Pos (15,8)
msgid ""
"あら…ひょっとして…\\!\n"
"出来ちゃったかしら…"
msgstr "哎呀…难道说…\\!有了吗…"

#. ID 13, Page 1, Line 120, Pos (15,8)
msgid ""
"フフフ、こうやって仲間を増やしていけば\n"
"…フフフ…"
msgstr "呵呵呵，只要这样不断增加同伴的话…呵呵呵…"

#. ID 13, Page 2, Line 3, Pos (15,8)
msgid ""
"あら、ダメよ。貴女にはしっかりと\n"
"私の子どもを産んでもらわないと…"
msgstr "哎呀，不行哦。你可得好好地为我生下孩子才行…"

#. ID 13, Page 3, Line 8, Pos (15,8)
#. Contains choice at line 2 (2 options)
msgid "ご主人様が妖しく微笑んでいる…"
msgstr "主人妖异地微笑着…"

#. ID 13, Page 3, Line 9, Pos (15,8)
#. Choice (2 options, embedded in a message)
msgid ""
"完全に屈服する\n"
"………………"
msgstr ""
"完全屈服\n"
"………………"

#. ID 13, Page 4, Line 4, Pos (15,8)
#. Contains choice at line 2 (3 options)
msgid "あら、どうしたの？"
msgstr "哎呀，怎么了？"

#. ID 13, Page 4, Line 5, Pos (15,8)
#. Choice (3 options, embedded in a message)
msgid ""
"衰弱剤を振り掛ける\n"
"別の方法を考える\n"
"使わない…"
msgstr ""
"撒衰弱剂\n"
"考虑别的方法\n"
"不使用…"

#. ID 13, Page 4, Line 8, Pos (15,8)
msgid ""
"衰弱剤入りのビンのふたを開け、\n"
"思いっきり振りかけた…\\!しかし…"
msgstr "打开装有衰弱剂的瓶盖，使劲撒了出去…\\!然而…"

#. ID 13, Page 4, Line 10, Pos (15,8)
msgid "あら、残念…。"
msgstr "哎呀，真遗憾…。"

#. ID 13, Page 4, Line 11, Pos (15,8)
msgid ""
"そうくることを予測していたのか\n"
"あっさり全て避けられてしまった。"
msgstr "难道她预料到会这样吗，全都被轻易躲开了。"

#. ID 13, Page 4, Line 13, Pos (15,8)
msgid ""
"まったく…\\!どうしても貴女は私のモノに\n"
"ならないと言う訳ね…\n"
"これで私に刃向かうのは3度目。\n"
"さすがにもう許してあげないわ！"
msgstr ""
"真是的…\\!你无论如何都不肯成为我的人是吧…\n"
"这已经是第三次反抗我了。\n"
"这次我可不会再原谅你了！"

#. ID 13, Page 4, Line 55, Pos (15,8)
msgid "フフフ、それじゃあいくわよ…"
msgstr "呵呵呵，那就开始咯…"

#. ID 13, Page 4, Line 59, Pos (15,8)
msgid ""
"なんだか体がおかしい…\n"
"\\!少しつづ、触手と一体化しつつある…"
msgstr ""
"总觉得身体有些奇怪…\n"
"\\!正在一点一点地与触手融为一体…"

#. ID 13, Page 4, Line 61, Pos (15,8)
msgid ""
"このまま私の体の中に取り込んであげるわ\n"
"\\!私の体の一部ともなればもう二度と\n"
"逆らえないでしょう…\\!ウフフ…"
msgstr ""
"就让我这样把你吸入我的体内吧\\!一旦成为我身体的\n"
"一部分，就再也不能反抗了吧…\\!呵呵…"

#. ID 13, Page 4, Line 68, Pos (15,8)
msgid ""
"もうからだのかんかくがなくなっている…\n"
"このまま…じぶんが…\\!じぶんで…\\!"
msgstr "身体的感觉已经没有了…就这样…自己…\\!自己…\\!"

#. ID 13, Page 4, Line 83, Pos (15,8)
msgid ""
"フフフ…\\!私の中で…\\!永遠の快楽を\n"
"味わっていなさいね…"
msgstr "呵呵呵…\\!在我的体内…\\!永远地品尝快乐吧…"

#. ID 13, Page 4, Line 89, Pos (15,8)
msgid ""
"\\S[2]その後の\\n[\\v[6]]はどうなったのか\n"
"\\!それは誰にもわからない…"
msgstr "\\S[2]那之后的\\n[\\v[6]]怎么样了\\!没有人知道…"

#. ID 13, Page 4, Line 96, Pos (15,8)
msgid ""
"普通の方法じゃとてもこの液を浴びせる\n"
"ことは出来ないだろう…\n"
"\\!しかし、この身体では…"
msgstr ""
"用普通的方法恐怕根本无法让她淋到这种液体吧…\n"
"\\!但是，以这具身体的话…"

#. ID 13, Page 4, Line 103, Pos (15,8)
msgid ""
"普通の方法じゃとてもこの液を浴びせる\n"
"ことは出来ないだろう…\n"
"\\!ならば…"
msgstr ""
"用普通的方法恐怕根本无法让她淋到这种液体吧…\n"
"\\!既然如此…"

#. ID 13, Page 4, Line 112, Pos (15,8)
msgid ""
"………！！！…\\!こ…これは…！！\n"
"あ…\\!あなた…\\!ま…\\!まさか…"
msgstr "………！！！…\\!这…这是…！！啊…\\!你…\\!难…\\!难道…"

#. ID 13, Page 4, Line 114, Pos (15,8)
msgid ""
"そう…あの薬を自分の体の膣中に入れてお\n"
"いたのだ…\\!それなら愛液やら尿やらに\n"
"混じって誤魔化すことが出来た…"
msgstr ""
"没错…她把那种药预先放进了自己体内的阴道中…\n"
"\\!那样的话就能混在爱液或尿液里蒙混过去…"

#. ID 13, Page 4, Line 117, Pos (15,8)
msgid ""
"そして思う存分この体を楽しんだ彼女にも\n"
"\\!…あの液は十分に入ったはずである…"
msgstr ""
"而那个尽情享受了这具身体的女人也\\!…\n"
"那种液体应该已经充分进入她体内了…"

#. ID 13, Page 4, Line 119, Pos (15,8)
msgid "そ…そんな…\\!ああ…"
msgstr "怎…怎么会…\\!啊啊…"

#. ID 13, Page 4, Line 144, Pos (15,8)
msgid "これが…\\!ラストチャンス！！"
msgstr "这是…\\!最后的机会！！"

#. ID 13, Page 4, Line 156, Pos (15,8)
msgid "ぎゃああああああ！！！！"
msgstr "咿呀啊啊啊啊啊啊啊！！！！！！"

#. ID 13, Page 4, Line 163, Pos (15,8)
msgid "……\\!終わった…"
msgstr "……\\!结束了…"

#. ID 13, Page 4, Line 213, Pos (15,8)
msgid "……\\!使わないことにした…"
msgstr "……\\!决定不使用…"

#. ID 14, Page 1, Line 3, Pos (34,4)
msgid "＊ジューク・ボックスだ！"
msgstr "＊是自动点唱机！"

#. ID 15, Page 1, Line 3, Pos (6,9)
msgid "今の自分の寝床だ…"
msgstr "这是自己现在的睡床…"

#. ID 15, Page 1, Line 4, Pos (6,9)
#. Contains choice at line 2 (2 options)
msgid "休みますか？"
msgstr "要休息吗？"

#. ID 15, Page 1, Line 5, Pos (6,9)
#. Choice (2 options, embedded in a message)
#. ID 18, Page 2, Line 5, Pos (31,24)
#. Choice (2 options, embedded in a message)
#. ID 21, Page 1, Line 6, Pos (29,7)
#. Choice (2 options, embedded in a message)
#. ID 29, Page 2, Line 4, Pos (10,5)
#. Choice (2 options, embedded in a message)
#. ID 32, Page 1, Line 4, Pos (37,4)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 15, Page 1, Line 7, Pos (6,9)
msgid "ゆっくり休んだ。"
msgstr "好好休息了。"

#. ID 16, Page 1, Line 3, Pos (5,24)
msgid ""
"ウネ様についてきたの。\n"
"これからよろしくね"
msgstr "我是跟着乌涅大人来的哦。今后请多关照。"

#. ID 16, Page 2, Line 3, Pos (5,24)
msgid ""
"あら、あなたのおっぱい、とても素敵ね。\n"
"いい精気があるミルクが搾り取れそうだわ\n"
"ウネ様もまだ完全には力を回復していない\n"
"から…\\!ちょうどいいわね。"
msgstr ""
"哎呀，你的乳房真不错呢。\n"
"看起来能挤出带有精气的奶水。\n"
"乌涅大人也还没有完全恢复力量…\\!正好呢。"

#. ID 16, Page 2, Line 12, Pos (5,24)
msgid "つぎはこの器具を取り付けて…"
msgstr "接下来装上这个器具…"

#. ID 16, Page 2, Line 20, Pos (5,24)
msgid "でそうなのね？\\!いいわ、一杯出すのよ！"
msgstr "那么，是这样吧？\\!好的，要出很多哦！"

#. ID 16, Page 2, Line 25, Pos (5,24)
msgid ""
"フフ、また一杯絞ってあげるわ。\n"
"楽しみにしてなさい。"
msgstr "呵呵，我会再给你挤很多哦。好好期待吧。"

#. ID 18, Page 1, Line 4, Pos (31,24)
msgid ""
"ほら、\n"
"もっと一杯ウネ様の子どもを産みなさい"
msgstr "来吧，再多生一些乌涅大人的孩子"

#. ID 18, Page 1, Line 8, Pos (31,24)
msgid "ウネ様が復活してくれて良かったわ"
msgstr "乌涅大人能复活真是太好了。"

#. ID 18, Page 2, Line 3, Pos (31,24)
#. Contains choice at line 3 (2 options)
msgid ""
"貴女の中のウネ様の子ども、\n"
"生ませてあげようか？"
msgstr "要不要让你生下你体内乌涅大人的孩子呢？"

#. ID 18, Page 2, Line 7, Pos (31,24)
msgid "フフフ、それじゃあはじめるわよ。"
msgstr "呵呵呵，那就开始咯。"

#. ID 18, Page 2, Line 11, Pos (31,24)
msgid "それじゃあまずはこの薬を飲んでね。"
msgstr "那么首先请喝下这个药哦。"

#. ID 18, Page 2, Line 19, Pos (31,24)
#. ID 18, Page 2, Line 131, Pos (31,24)
msgid "………"
msgstr "………"

#. ID 18, Page 2, Line 26, Pos (31,24)
#. ID 18, Page 2, Line 94, Pos (31,24)
msgid "………！！"
msgstr "………！！"

#. ID 18, Page 2, Line 27, Pos (31,24)
msgid ""
"\\n[\\v[6]]は突如襲ってきた下腹部の違和感を\n"
"感じた"
msgstr "\\n[\\v[6]]感觉到了突然袭来的下腹部异样感"

#. ID 18, Page 2, Line 29, Pos (31,24)
msgid ""
"子供を宿した\\n[\\v[6]]の腹は、\n"
"急に大きく膨らみ始めた"
msgstr "怀上孩子的\\n[\\v[6]]的腹部，突然开始迅速膨大。"

#. ID 18, Page 2, Line 50, Pos (31,24)
msgid ""
"\\n[\\v[6]]は体を横たえさせられ\n"
"股を大きく開かされた"
msgstr "\\n[\\v[6]]被放倒身体，双腿被大大分开。"

#. ID 18, Page 2, Line 57, Pos (31,24)
msgid ""
"\\n[\\v[6]]は服を脱がされ、寝かされて、\n"
"股を大きく開かされた"
msgstr ""
"\\n[\\v[6]]被脱去衣服，被放倒在床上，\n"
"双腿被大大分开。"

#. ID 18, Page 2, Line 66, Pos (31,24)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"んんっ！……で、出てきてる……\n"
"中で擦れちゃうよぉ……"
msgstr ""
"\\S[2]\\n[\\v[6]]嗯嗯！……出、出来了……\n"
"在里面摩擦到了呀……"

#. ID 18, Page 2, Line 69, Pos (31,24)
msgid ""
"フフフ、そうよ。しっかりと息を整えて…\n"
"ほら、がんばりなさい。\n"
"愛しのご主人様の子どもを産むんだから"
msgstr ""
"呵呵呵，没错哦。好好调整呼吸…来吧，加油。\n"
"你可是要生下心爱主人的孩子呢。"

#. ID 18, Page 2, Line 72, Pos (31,24)
msgid "\\S[2]\\n[\\v[6]]は、さらに下腹部に力を入れる"
msgstr "\\S[2]\\n[\\v[6]]进一步向下腹部用力。"

#. ID 18, Page 2, Line 85, Pos (31,24)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"く、くるしい！…う、産まれる……も、もう少し……"
msgstr ""
"\\S[2]\\n[\\v[6]]好、好难受！…呜，要生了……再、\n"
"再一点……"

#. ID 18, Page 2, Line 95, Pos (31,24)
msgid "ひぎぃぃぃぃぃぃぃ！！！！！！"
msgstr "咿呀啊啊啊啊啊啊啊！！！！！！"

#. ID 18, Page 2, Line 109, Pos (31,24)
msgid "\\S[2]…ぜぇ…ぜぇ…"
msgstr "\\S[2]…呼…呼…"

#. ID 18, Page 2, Line 110, Pos (31,24)
msgid "がんばったわね。ほら。元気な赤ちゃんよ"
msgstr "你很努力了呢。看，是个健康的宝宝哦。"

#. ID 18, Page 2, Line 111, Pos (31,24)
msgid ""
"生まれたばかりの赤子をみせてもらう…\n"
"不思議といとしい感情が生まれた"
msgstr ""
"看到刚出生的婴儿…\n"
"心中不可思议地生出了怜爱之情。"

#. ID 18, Page 2, Line 123, Pos (31,24)
msgid "\\S[2]…………………"
msgstr "\\S[2]…………………"

#. ID 18, Page 2, Line 132, Pos (31,24)
msgid ""
"\n"
"\\n[\\v[6]]は、出産がもたらす快楽の\n"
"虜となってしまった！"
msgstr "\\n[\\v[6]]成了分娩带来的快感的俘虏！"

#. ID 18, Page 2, Line 135, Pos (31,24)
msgid ""
"\\n[\\v[6]]は\n"
"排卵異常\n"
"のアビリティを得た！"
msgstr "\\n[\\v[6]]获得了排卵异常的能力！"

#. ID 18, Page 2, Line 159, Pos (31,24)
msgid ""
"あ、ウネ様。どうです\n"
"元気な赤ちゃんですよ。"
msgstr "啊，乌涅大人。怎么样，是个健康的宝宝哦。"

#. ID 18, Page 2, Line 161, Pos (31,24)
msgid ""
"あらあら、がんばったわねえ…\\!フフフ\n"
"でももっともっと産んでもらわないとね"
msgstr ""
"哎呀哎呀，你很努力了呢…\\!呵呵呵，\n"
"不过还得让你生更多更多才行呢。"

#. ID 18, Page 2, Line 163, Pos (31,24)
msgid "はい…ご主人様…\\!がんばります…"
msgstr "是…主人…\\!我会努力的…"

#. ID 18, Page 2, Line 178, Pos (31,24)
msgid "あら、そう…"
msgstr "哎呀，是吗…"

#. ID 21, Page 1, Line 3, Pos (29,7)
msgid ""
"あら…\n"
"おひさしぶりね…"
msgstr "哎呀…好久不见呢…"

#. ID 21, Page 1, Line 5, Pos (29,7)
#. Contains choice at line 2 (2 options)
msgid "……\\!さて、貴女はこのままでいいの？"
msgstr "……\\!那么，你就这样下去可以吗？"

#. ID 21, Page 1, Line 8, Pos (29,7)
msgid "そう…\\!ならいいわ…"
msgstr "这样啊…\\!那就好…"

#. ID 21, Page 1, Line 11, Pos (29,7)
msgid "なら、これを使いなさい。"
msgstr "那么，就用这个吧。"

#. ID 21, Page 1, Line 14, Pos (29,7)
msgid "衰弱剤を貰った…"
msgstr "得到了衰弱剂…"

#. ID 21, Page 1, Line 18, Pos (29,7)
msgid "フフ、それじゃあね…"
msgstr "呵呵，那就这样吧…"

#. ID 21, Page 2, Line 3, Pos (29,7)
msgid "…\\!もうダメみたいね…\\!可哀想に…"
msgstr "…\\!好像已经不行了呢…\\!真可怜…"

#. ID 22, Page 1, Line 3, Pos (4,33)
msgid "ほら、綺麗にしてあげるわよ…"
msgstr "来吧，我帮你弄干净哦…"

#. ID 22, Page 1, Line 16, Pos (4,33)
msgid "はい、おしまい。"
msgstr "好，结束了。"

#. ID 23, Page 1, Line 15, Pos (12,3)
msgid "捕まってしまった…"
msgstr "被抓住了…"

#. ID 23, Page 1, Line 17, Pos (12,3)
msgid ""
"あらあら、何をやってるのかしら。\n"
"いたずらな子ね。"
msgstr "哎呀哎呀，你在做什么呢。真是个淘气的孩子。"

#. ID 23, Page 1, Line 24, Pos (12,3)
msgid ""
"まったく…\\!こういういたずらな子には\n"
"お仕置きをしてあげないとねえ…"
msgstr ""
"真是的…\\!对这种淘气的孩子，\n"
"必须得惩罚一下才行呢…"

#. ID 23, Page 1, Line 53, Pos (12,3)
msgid ""
"あらあら、はしたないわね…\n"
"ま、今回はこれくらいにしておいてあげるわ。"
msgstr ""
"哎呀哎呀，真不知羞耻呢…算了，这次就到此为止，\n"
"放过你吧。"

#. ID 23, Page 1, Line 63, Pos (12,3)
msgid ""
"ま、こんなものかしらね…\n"
"もう二度とこんなことしちゃだめよ。"
msgstr "唉，也就这样吧…以后可不能再做这种事了哦。"

#. ID 25, Page 1, Line 25, Pos (3,11)
msgid ""
"どうやら、これも前の住人が残していった\n"
"ものらしい…\n"
"\\!ひどい目にあった…"
msgstr ""
"看来，这也是之前的居民留下的东西…\n"
"\\!真是倒了大霉…"

#. ID 26, Page 3, Line 3, Pos (10,11)
msgid "ママ～"
msgstr "妈妈～"

#. ID 29, Page 2, Line 3, Pos (10,5)
#. Contains choice at line 2 (2 options)
msgid "憑依されてる生き物を変更しますか"
msgstr "要更改被附身的生物吗"

#. ID 29, Page 2, Line 6, Pos (10,5)
#. Contains choice at line 2 (2 options)
msgid "どれにしますか？"
msgstr "要选哪一个？"

#. ID 29, Page 2, Line 7, Pos (10,5)
#. Choice (2 options, embedded in a message)
msgid ""
"犬\n"
"猫"
msgstr ""
"狗\n"
"猫"

#. ID 29, Page 2, Line 19, Pos (10,5)
#. ChangeHeroTitle (Actor 5)
msgctxt "actors.title"
msgid "飼い犬"
msgstr "宠物狗"

#. ID 29, Page 2, Line 37, Pos (10,5)
#. ChangeHeroTitle (Actor 5)
msgctxt "actors.title"
msgid "飼い猫"
msgstr "宠物猫"

#. ID 32, Page 1, Line 3, Pos (37,4)
#. Contains choice at line 2 (2 options)
msgid "時間を進めますか？"
msgstr "要推进时间吗？"

#. ID 32, Page 1, Line 9, Pos (37,4)
msgid "夜になりました"
msgstr "到了夜晚。"

#. ID 33, Page 1, Line 3, Pos (0,3)
msgid ""
"ウフフ、\\!もうすっかり立派なペットね…\n"
"私に逆らうといったこともないみたいだし…"
msgstr ""
"呵呵，\\!已经完全是一只好宠物了呢…\n"
"看起来也不会再反抗我了…"

#. ID 33, Page 1, Line 5, Pos (0,3)
msgid ""
"これからはずっと私の傍にいるのよ…\n"
"わかったかしら？"
msgstr "从今以后你要一直待在我身边哦…明白了吗？"

#. ID 33, Page 1, Line 7, Pos (0,3)
msgid ""
"そうね…その証をつけてあげましょう\n"
"ほら…動かないでね…"
msgstr "是啊…那就给你戴上那个证明吧，来…别动哦…"

#. ID 33, Page 1, Line 23, Pos (0,3)
msgid ""
"この焼印は私への忠誠の証…\n"
"\\!これでもう、身も心も私のモノよ。"
msgstr ""
"这个烙印是对我忠诚的证明…\\!这样一来，\n"
"你的身心就都属于我了。"

#. ID 33, Page 1, Line 45, Pos (0,3)
#. ID 33, Page 2, Line 71, Pos (0,3)
#. ID 33, Page 3, Line 147, Pos (0,3)
#. ID 33, Page 4, Line 56, Pos (0,3)
msgid ""
"\\S[2]こうして\\n[\\v[6]]は全てを奪われ、\n"
"永遠に奴隷ペットとして弄ばれる事と\n"
"なったのである…。"
msgstr ""
"\\S[2]就这样，\\n[\\v[6]]被夺走了一切，\n"
"从此永远作为奴隶宠物被玩弄…。"

#. ID 33, Page 2, Line 6, Pos (0,3)
#. ID 33, Page 3, Line 97, Pos (0,3)
#. ID 33, Page 4, Line 6, Pos (0,3)
msgid "その後…"
msgstr "在那之后…"

#. ID 33, Page 2, Line 24, Pos (0,3)
msgid "こっちにいらっしゃい。"
msgstr "到这边来。"

#. ID 33, Page 2, Line 34, Pos (0,3)
msgid ""
"ふふ、いい子ね。\n"
"さあ、散歩に連れて行ってあげるわ。"
msgstr "呵呵，真乖。来，我带你出去散步。"

#. ID 33, Page 2, Line 40, Pos (0,3)
msgid ""
"【\\N[\\V[6]]】\n"
"…ハッハッ！……"
msgstr "【\\N[\\V[6]]】…哈、哈！……"

#. ID 33, Page 3, Line 7, Pos (0,3)
msgid ""
"………\n"
"あら、ちゃんとこれをつけていたのね。\n"
"偉いわ。"
msgstr "………哎呀，你好好地戴着这个呢。真了不起。"

#. ID 33, Page 3, Line 18, Pos (0,3)
msgid "それと…"
msgstr "还有…"

#. ID 33, Page 3, Line 85, Pos (0,3)
msgid "鈴のピアスと雌豚のピアスを着けられた。"
msgstr "被戴上了铃之环和雌豚之环。"

#. ID 33, Page 3, Line 90, Pos (0,3)
msgid "やっぱりこれがお似合いね。"
msgstr "果然这个很适合你呢。"

#. ID 33, Page 3, Line 121, Pos (0,3)
msgid "なぁに、遊んでほしいの？"
msgstr "怎么了，想让我陪你玩吗？"

#. ID 33, Page 3, Line 127, Pos (0,3)
msgid ""
"どうしようかしら…\n"
"遊んでほしければ、上手におねだりしてみせなさい。"
msgstr "怎么办呢…如果想玩，就好好地向我撒娇央求吧。"

#. ID 33, Page 3, Line 136, Pos (0,3)
msgid "\\N[\\V[6]]は必死におねだりをした……"
msgstr "\\N[\\V[6]]拼命地央求着……"

#. ID 33, Page 3, Line 141, Pos (0,3)
msgid "ふふ、可愛いわよ…"
msgstr "呵呵，真可爱哦…"

#. ID 33, Page 4, Line 24, Pos (0,3)
msgid "こちらへいらっしゃい。"
msgstr "到这边来。"

#. ID 33, Page 4, Line 35, Pos (0,3)
msgid ""
"フフフ……\n"
"さあ、また一緒に楽しみましょう。"
msgstr "呵呵呵……来，我们再一起享受吧。"

#. ID 34, Page 1, Line 3, Pos (23,4)
msgid "怪しげな道具がたくさん残っている…"
msgstr "还留着许多可疑的道具…"
