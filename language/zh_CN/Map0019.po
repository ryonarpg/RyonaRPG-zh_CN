#. ID 4, Page 1, Line 3, Pos (4,6)
#. Contains choice at line 3 (2 options)
#. ID 4, Page 2, Line 3, Pos (4,6)
#. Contains choice at line 3 (2 options)
msgid ""
"いらっしゃい。\n"
"ゆっくりしていってくれ。"
msgstr "欢迎。慢慢来吧。"

#. ID 4, Page 1, Line 5, Pos (4,6)
#. Choice (2 options, embedded in a message)
#. ID 4, Page 2, Line 5, Pos (4,6)
#. Choice (2 options, embedded in a message)
msgid ""
"仕事の斡旋\n"
"いいえ"
msgstr ""
"工作介绍\n"
"不"

#. ID 4, Page 1, Line 7, Pos (4,6)
#. ID 4, Page 4, Line 8, Pos (4,6)
msgid ""
"……そうだな、\n"
"今入ってきてるのは……"
msgstr "……是啊，现在接到的委托是……"

#. ID 4, Page 1, Line 12, Pos (4,6)
#. ID 4, Page 4, Line 12, Pos (4,6)
msgid ""
"\\N[101]駆除\n"
"ノルマ：\\V[528]匹\n"
"目的地：\\N[103]"
msgstr "\\N[101]驱除指标：\\V[528]只目的地：\\N[103]"

#. ID 4, Page 1, Line 21, Pos (4,6)
#. ID 4, Page 4, Line 21, Pos (4,6)
msgid ""
"\\N[101]調達\n"
"ノルマ：\\V[528]個"
msgstr "\\N[101]筹集指标：\\V[528]个"

#. ID 4, Page 1, Line 30, Pos (4,6)
#. ID 4, Page 4, Line 30, Pos (4,6)
msgid ""
"\\N[101]回収\n"
"ノルマ：\\V[528]個\n"
"目的地：\\N[103]"
msgstr "\\N[101]回收指标：\\V[528]个目的地：\\N[103]"

#. ID 4, Page 1, Line 35, Pos (4,6)
#. ID 4, Page 4, Line 35, Pos (4,6)
msgid ""
"\\N[101]採取\n"
"ノルマ：\\V[528]個\n"
"目的地：\\N[103]"
msgstr "\\N[101]采集指标：\\V[528]个目的地：\\N[103]"

#. ID 4, Page 1, Line 47, Pos (4,6)
#. ID 4, Page 4, Line 47, Pos (4,6)
msgid ""
"難易度：\\N[101]\n"
"報酬　：\\V[523]G\n"
"期限　：\\V[525]日"
msgstr "难度：\\N[101]报酬　：\\V[523]G期限　：\\V[525]日"

#. ID 4, Page 1, Line 50, Pos (4,6)
#. ID 4, Page 4, Line 50, Pos (4,6)
msgid ""
"違約金　　　：\\V[1]G\n"
"キャンセル料：\\V[2]G"
msgstr "违约金　　　：\\V[1]G取消费：\\V[2]G"

#. ID 4, Page 1, Line 52, Pos (4,6)
#. Choice (3 options)
msgid ""
"依頼を受ける\n"
"いいえ\n"
"他の依頼"
msgstr ""
"接受委托\n"
"不\n"
"其他委托"

#. ID 4, Page 1, Line 54, Pos (4,6)
msgid ""
"わかった。後で依頼主に連絡しておこう…\n"
"期限をオーバーしないように気をつけろよ。"
msgstr ""
"知道了。我之后会联系委托人…\n"
"注意不要超过期限啊。"

#. ID 4, Page 1, Line 62, Pos (4,6)
msgid "もう他には何もないな。"
msgstr "其他就没有什么了。"

#. ID 4, Page 1, Line 66, Pos (4,6)
msgid "そうだな…他には…"
msgstr "是啊…其他嘛…"

#. ID 4, Page 1, Line 73, Pos (4,6)
msgid "他にはもう何もないな。"
msgstr "其他已经没有什么了。"

#. ID 4, Page 1, Line 85, Pos (4,6)
msgid ""
"そうか……じゃあ、ビールでも飲むかね？\n"
"\\.……おっと。ハハハ、まだ未成年だったな。"
msgstr ""
"是吗……那，要不要喝点啤酒？\\.……哎哟。哈哈哈，\n"
"你还是未成年呢。"

#. ID 4, Page 1, Line 89, Pos (4,6)
msgid ""
"じゃあ、代わりにおじさんが\n"
"特製メニューをご馳走してあげよう！\n"
"\\.とても珍しい動物のステーキだ！"
msgstr ""
"那这样，大叔就请你吃特制菜单吧！\n"
"\\.是非常稀有的动物牛排哦！"

#. ID 4, Page 1, Line 92, Pos (4,6)
msgid ""
"何の肉だと思うね？\n"
"ふふふ…"
msgstr "你猜是什么肉？呵呵呵…"

#. ID 4, Page 1, Line 94, Pos (4,6)
msgid ""
"\n"
"\\S[5]そう　あんたの　にくだよ！"
msgstr "\\S[5]没错　就是你的　肉哦！"

#. ID 4, Page 1, Line 96, Pos (4,6)
msgid "\\.………\\.ハ\\.　ハ\\.　ハ　\\.冗談だよ！"
msgstr "\\.………\\.哈\\.　哈\\.　哈　\\.开玩笑的啦！"

#. ID 4, Page 1, Line 99, Pos (4,6)
msgid ""
"じゃあ、代わりに\n"
"カエルノションベンジュースを作ってあげよう。\n"
"\\.………\\.ハ\\.　ハ\\.　ハ　\\.冗談だよ！"
msgstr ""
"那这样，作为替代我给你做青蛙尿果汁吧。\\.………\n"
"\\.哈\\.　哈\\.　哈　\\.开玩笑的啦！"

#. ID 4, Page 2, Line 7, Pos (4,6)
msgid ""
"今のあんたに仕事の話は来ないよ\n"
"……わかるだろ？\n"
"\\.ハ\\.　ハ\\.　ハ"
msgstr ""
"现在的你不会有工作找上门哦……懂吧？\n"
"\\.哈\\.　哈\\.　哈"

#. ID 4, Page 3, Line 3, Pos (4,6)
msgid ""
"…やれやれ、犬が迷い込んだか…\n"
"\n"
"誰も気づいてない内に逃げるんだな"
msgstr ""
"……真是的，有只狗迷路进来了吗……\n"
"趁没人发现赶紧逃吧"

#. ID 4, Page 4, Line 3, Pos (4,6)
msgid ""
"いらっしゃい。\n"
"で、どうだい？仕事の方は。"
msgstr "欢迎光临。那么，怎么样？工作方面。"

#. ID 4, Page 4, Line 6, Pos (4,6)
#. Choice (4 options)
msgid ""
"依頼の確認\n"
"ぼちぼちやね\n"
"依頼をキャンセルする\n"
"依頼の品を渡す"
msgstr ""
"确认委托\n"
"马马虎虎吧\n"
"取消委托\n"
"交付委托物品"

#. ID 4, Page 4, Line 56, Pos (4,6)
msgid "キャンセル料は\\V[2]Gだ。\\$"
msgstr "取消费是\\V[2]G。\\$"

#. ID 4, Page 4, Line 57, Pos (4,6)
#. Contains choice at line 2 (2 options)
msgid "本当に依頼をキャンセルするのかね？"
msgstr "真的要取消委托吗？"

#. ID 4, Page 4, Line 58, Pos (4,6)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"依頼をキャンセルする"
msgstr ""
"否\n"
"取消委托"

#. ID 4, Page 4, Line 67, Pos (4,6)
msgid ""
"金が足りないぞ！\n"
"大人しく依頼を完遂するんだな。"
msgstr "钱不够哦！乖乖把委托完成吧。"

#. ID 4, Page 4, Line 74, Pos (4,6)
msgid ""
"あいよ。\n"
"次はちゃんと自分の力量を考えて\n"
"仕事を選ぶんだな。"
msgstr "好嘞。下次要好好考虑自己的实力再选工作啊。"

#. ID 4, Page 4, Line 84, Pos (4,6)
msgid ""
"首の数が足りんぞ！\n"
"とっとともぎ取ってこい！"
msgstr "脑袋的数量不够！赶紧去砍回来！"

#. ID 4, Page 4, Line 90, Pos (4,6)
msgid ""
"よし、よくやった。\n"
"さぁ、報酬を受け取りな。"
msgstr "好，干得漂亮。来，领取报酬吧。"

#. ID 4, Page 4, Line 92, Pos (4,6)
#. ID 4, Page 6, Line 7, Pos (4,6)
msgid "\\V[523]Gを受け取った。"
msgstr "获得了\\V[523]G。"

#. ID 4, Page 4, Line 98, Pos (4,6)
msgid ""
"数が足りんぞ！\n"
"とっとと集めてこい。"
msgstr "数量不够！赶紧去收集来。"

#. ID 4, Page 5, Line 3, Pos (4,6)
msgid "いらっしゃい。"
msgstr "欢迎光临。"

#. ID 4, Page 5, Line 6, Pos (4,6)
#. Contains choice at line 2 (2 options)
msgid "違約金は\\V[1]Gだ。\\$"
msgstr "违约金是\\V[1]G。\\$"

#. ID 4, Page 5, Line 7, Pos (4,6)
#. Choice (2 options, embedded in a message)
msgid ""
"違約金を支払う\n"
"いいえ"
msgstr ""
"支付违约金\n"
"否"

#. ID 4, Page 5, Line 10, Pos (4,6)
msgid "金が足りないんだが…"
msgstr "钱不太够啊……"

#. ID 4, Page 5, Line 11, Pos (4,6)
#. ID 4, Page 5, Line 25, Pos (4,6)
msgid ""
"違約金を支払い終えるまでは\n"
"依頼の斡旋はできんよ。\n"
"とっとと金を集めてきな。"
msgstr ""
"在付清违约金之前，我可没法给你介绍委托哦。\n"
"赶紧去筹钱吧。"

#. ID 4, Page 5, Line 17, Pos (4,6)
msgid ""
"………\n"
"次からは気をつけるんだな。"
msgstr "………下次可要小心点啊。"

#. ID 4, Page 6, Line 3, Pos (4,6)
msgid ""
"依頼を達成したようだな！よくやった。\n"
"さぁ、報酬を受け取りな。"
msgstr "看来你完成委托了呢！干得好。来，领取报酬吧。"

#. ID 4, Page 7, Line 3, Pos (4,6)
msgid ""
"今日はもう依頼はないよ。\n"
"また明日来な。"
msgstr "今天已经没有委托了。明天再来吧。"

#. ID 5, Page 1, Line 3, Pos (14,6)
msgid "ピアノのエステルです。"
msgstr "我是钢琴手艾丝黛尔。"

#. ID 5, Page 1, Line 4, Pos (14,6)
msgid ""
"私あんまり器用じゃないから\n"
"演奏中にしゃべったりできないのよね。"
msgstr "我不太灵巧，所以演奏中没法说话呢。"

#. ID 6, Page 1, Line 3, Pos (16,5)
msgid "ベースのロバートだ。"
msgstr "我是贝斯手罗伯特。"

#. ID 6, Page 2, Line 3, Pos (16,5)
msgid ""
"あんまりじろじろ見るなよ。\n"
"…ほほ染めてテれちゃうぜ！"
msgstr "别那么盯着看啊。…脸都要红起来的啦！"

#. ID 7, Page 1, Line 3, Pos (18,5)
msgid ""
"あったかい…\n"
"\\!このままここで寝てしまいたい"
msgstr "好暖和…\\!真想就这样在这里睡着"

#. ID 7, Page 2, Line 3, Pos (18,5)
msgid "波の音担当のジョニー・ザ・ポットと"
msgstr "负责波音的约翰尼·锅，以及"

#. ID 7, Page 2, Line 4, Pos (18,5)
msgid "風の音担当のスティーブ・ザ・ストーブです。"
msgstr "负责风声的史蒂夫·炉。"

#. ID 8, Page 1, Line 3, Pos (12,5)
msgid "テナーサックスの忍者です。"
msgstr "我是次中音萨克斯的忍者。"

#. ID 8, Page 2, Line 3, Pos (12,5)
msgid ""
"あとビブラフォンと\n"
"アコースティックギターも弾いてます。"
msgstr "另外还弹颤音琴和原声吉他。"

#. ID 8, Page 2, Line 5, Pos (12,5)
msgid "忍者だから出来る芸当です。"
msgstr "这是只有忍者才能做到的本事。"

#. ID 9, Page 1, Line 3, Pos (1,8)
msgid ""
"どうせお前ら、17番がどう見ても…\n"
"とか言いたいんだろ？\n"
"わかってるんだよ…うぃー　ひっく。"
msgstr ""
"反正你们是想说，17号怎么看都……对吧？我懂啦……\n"
"呃—　嗝。"

#. ID 9, Page 1, Line 6, Pos (1,8)
msgid ""
"だけど10万回とか設定して一晩放置しちゃダメだぜ？\n"
"ていうかそれ、いったい何のためにやるんだぜ？\n"
"自分で見るわけでも無いのに。\n"
"いくらなんでも特殊すぎだろぜ？"
msgstr ""
"但是可别设置个10万次然后放一整晚不管啊？\n"
"话说那到底是为了什么才做的啊？\n"
"明明自己也不会看。再怎么说也太特殊了吧？"

#. ID 9, Page 1, Line 10, Pos (1,8)
msgid ""
"うぃー。\n"
"…ん？なんか俺、酔っ払っておかしな事を\n"
"口走ってたような…"
msgstr "呃—。…嗯？我好像醉醺醺地说了些奇怪的话……"

#. ID 10, Page 1, Line 3, Pos (9,6)
msgid ""
"そこでスタンバってる連中、\n"
"「ヴァルキリー」ってバンドなんだけど…\n"
"今度、メジャーデビューするらしいんだ。"
msgstr ""
"在那边待命的那些人，是个叫「瓦尔基里」的乐队……\n"
"听说下次要主流出道了。"

#. ID 10, Page 1, Line 6, Pos (9,6)
msgid ""
"結成当初から地味～に追っかけてた俺としては\n"
"嬉しいやらちょっぴり寂しいやら。"
msgstr ""
"作为从结成之初就低调～地追着他们的我来说，\n"
"真是又高兴又有点寂寞。"

#. ID 10, Page 1, Line 8, Pos (9,6)
msgid "なんつーの？「悲喜こもごも」ってやつ？"
msgstr "怎么说呢？就是所谓的「悲喜交加」？"

#. ID 10, Page 1, Line 11, Pos (9,6)
msgid ""
"……おっ！\n"
"\\.そろそろ始まるみたいだぜ！"
msgstr "……哦！\\.好像差不多要开始了！"

#. ID 10, Page 2, Line 3, Pos (9,6)
msgid "…。"
msgstr "…。"

#. ID 10, Page 3, Line 3, Pos (9,6)
msgid "ちくしょう・・あいつら・・・くそう・・・"
msgstr "可恶……那帮家伙……可恶……"

#. ID 10, Page 3, Line 5, Pos (9,6)
msgid ""
"ん・・・？あんた冒険者だな・・・\n"
"そ、そうだ、宝のありかについて知りたくないか？\n"
"へ・・・へ・・・"
msgstr ""
"嗯……？你是冒险者吧……对、对了，\n"
"你想不想知道宝藏的所在地？嘿……嘿……"

#. ID 10, Page 3, Line 8, Pos (9,6)
#. Contains choice at line 3 (2 options)
msgid ""
"いまなら、そ、そうだな、たったの1000Gだ！\n"
"へ・・へ・・・"
msgstr "现在的话，对、对了，只要1000G！嘿……嘿……"

#. ID 10, Page 3, Line 10, Pos (9,6)
#. Choice (2 options, embedded in a message)
#. ID 10, Page 3, Line 33, Pos (9,6)
#. Choice (2 options, embedded in a message)
msgid ""
"買う\\$\n"
"買わない"
msgstr ""
"买\\$\n"
"不买"

#. ID 10, Page 3, Line 13, Pos (9,6)
#. ID 10, Page 3, Line 36, Pos (9,6)
msgid ""
"金が足りないんじゃあ・・・\n"
"しょ、しょうがないよな・・・\n"
"へ・・・へ・・・"
msgstr "钱不够的话……那、那也没办法啊……嘿……嘿……"

#. ID 10, Page 3, Line 23, Pos (9,6)
msgid ""
"へ・・・へ・・・まいど・・・\n"
"お宝ってのはな、ノースレイの・・・"
msgstr "嘿……嘿……多谢惠顾……所谓宝藏啊，就在诺斯雷的……"

#. ID 10, Page 3, Line 25, Pos (9,6)
msgid ""
"・・・うっ・・・！\n"
"い、いや、やっぱりダメだ・・・\n"
"売れねぇ・・・"
msgstr "……唔……！不、不，果然还是不行……不能卖……"

#. ID 10, Page 3, Line 28, Pos (9,6)
msgid ""
"そ、そうだ・・・！「聖域」なんだよ！\n"
"なんたって「聖域」だからな・・・\n"
"・・・あと2000Gだ！"
msgstr ""
"对、对了……！是「圣域」啊！不管怎么说都是\n"
"「圣域」嘛……再加2000G！"

#. ID 10, Page 3, Line 31, Pos (9,6)
#. Contains choice at line 3 (2 options)
msgid ""
"あと2000G払えば、とっておきの情報を・・・\n"
"お、おしえてやるぜ・・・！"
msgstr ""
"再付2000G的话，我就把珍藏的情报……告、告诉你……\n"
"！"

#. ID 10, Page 3, Line 46, Pos (9,6)
msgid ""
"ま、マジか・・・\n"
"・・・う、売るっていっちまったものはしょうがねぇ"
msgstr "真、真的吗……既、既然说了要卖，那也没办法了"

#. ID 10, Page 3, Line 48, Pos (9,6)
msgid ""
"ほ、ほらよ・・・\n"
"これがその地図だ・・・！"
msgstr "给、给你……这就是那张地图……！"

#. ID 10, Page 3, Line 53, Pos (9,6)
msgid "◆ノースレイの腐海　の情報を得た！"
msgstr "◆获得了诺斯雷腐海　的情报！"

#. ID 10, Page 3, Line 56, Pos (9,6)
msgid "・・・あとのことは俺は知らねぇーーーッ！"
msgstr "……后面的事我可不知道啊———！"

#. ID 10, Page 3, Line 64, Pos (9,6)
msgid ""
"へ・・・へ・・・\n"
"そうだ、そ、それがいい・・・"
msgstr "嘿……嘿……对，就、就这样好……"

#. ID 10, Page 3, Line 70, Pos (9,6)
msgid ""
"そ、そうか、そうだよな・・・\n"
"へ・・・へ・・・"
msgstr "这、这样啊，也是啊……嘿……嘿……"

#. ID 11, Page 1, Line 3, Pos (7,11)
msgid ""
"知っての通り、\n"
"ダンジョンには様々な罠が仕掛けられている。\n"
"だが、「盗賊の指輪」というアイテムがあれば\n"
"どんな罠にも掛からなくなるという。"
msgstr ""
"正如你所知，地下城里设置了各种陷阱。不过，\n"
"据说只要拥有名为「盗贼戒指」的道具，\n"
"就不会中任何陷阱。"

#. ID 11, Page 1, Line 7, Pos (7,11)
msgid ""
"そうすると盗賊がいる意味が無くなってしまう。\n"
"クビにするか？はたまた忍者にでも転職させるか？\n"
"…実に微妙。微妙ベリーマッチ。"
msgstr ""
"这样一来，盗贼存在的意义就没了。要炒掉吗？\n"
"还是干脆让他转职成忍者？……实在微妙。\n"
"非常非常微妙。"

#. ID 11, Page 2, Line 3, Pos (7,11)
msgid ""
"「盗賊の指輪」というどんな罠にも掛からなくなる\n"
"アイテムがあったと思ったがいつのまにか\n"
"「シーブズ・アイ」という魔法に変わっていた・・・\n"
"な、何をいってるかわからｎ(ry"
msgstr ""
"我记得本来有个叫「盗贼戒指」、\n"
"能让人不中任何陷阱的道具，\n"
"但不知什么时候变成了叫「盗贼之眼」的魔法……我、\n"
"我在说什么完全不明n(ry"

#. ID 11, Page 2, Line 7, Pos (7,11)
msgid ""
"つまり\\c[9]アビリティ：けいかい\\c[0]や\n"
"\\c[4]特殊技能：警戒\\c[0]などで罠にかかる確率を減らすのが\n"
"賢明ってことだな！"
msgstr ""
"也就是说，通过\\c[9]能力：\n"
"警戒\\c[0]或\\c[4]特殊技能：\n"
"警戒\\c[0]等来降低中陷阱的概率才是明智之举！"

#. ID 11, Page 2, Line 10, Pos (7,11)
msgid ""
"まぁ、うちのパーティは盗賊が\n"
"全部罠にかかってくれるから問題ないんだけどな！"
msgstr ""
"不过嘛，\n"
"我们队伍里反正盗贼会把所有陷阱都踩一遍，\n"
"所以没问题啦！"

#. ID 12, Page 1, Line 3, Pos (6,12)
#. ID 12, Page 2, Line 3, Pos (6,12)
msgid "やめて二人とも！私のために争うのは！！"
msgstr "住手，你们两个！不要为了我争斗！！"

#. ID 12, Page 1, Line 4, Pos (6,12)
msgid ""
"ていうかさ～。\n"
"わざわざそんなもん買うくらいなら\n"
"私に「金の髪飾り」買ってよ！"
msgstr ""
"话说回来～。与其特意买那种东西，不如给我买\n"
"「金色发饰」啦！"

#. ID 12, Page 2, Line 4, Pos (6,12)
msgid ""
"ていうかさ～。\n"
"私にどんな状態異常でも防ぐ「リボン」買ってよ！\n"
"どこにも売ってないけど！"
msgstr ""
"话说回来～。给我买能防住任何状态异常的「缎带」\n"
"啦！虽然哪里都买不到就是了！"

#. ID 12, Page 2, Line 7, Pos (6,12)
msgid ""
"「ねぎ」も全状態異常を防ぐとか聞いたけど\n"
"そんなもの振り回してたらネギ臭いネギ女に\n"
"なっちゃうわ・・・。"
msgstr ""
"听说「葱」也能防所有状态异常，\n"
"但要是挥着那种东西，会变成一股葱味的葱女哦……。"

#. ID 12, Page 2, Line 11, Pos (6,12)
msgid "やっぱりネギよりレモンよね！"
msgstr "果然还是柠檬比葱好啊！"

#. ID 13, Page 1, Line 3, Pos (5,11)
msgid ""
"忍者か…\n"
"ちょっとイイな。"
msgstr "忍者吗……有点不错啊。"

#. ID 13, Page 1, Line 5, Pos (5,11)
msgid ""
"…じゃなくて。\n"
"なにげにみんなヒドい事言ってない？\n"
"もしかしてイジメ？"
msgstr ""
"……不是啦。大家是不是若无其事地在说很过分的话？\n"
"难道是欺负？"

#. ID 13, Page 2, Line 3, Pos (5,11)
msgid "トラップ解除ならまかせろー！(ﾊﾞﾘﾊﾞﾘ)"
msgstr "解除陷阱就交给我吧——！(干劲十足)"

#. ID 13, Page 2, Line 5, Pos (5,11)
msgid "って俺が罠にひっかかる前提かよ！？"
msgstr "等等，这是以我会踩中陷阱为前提吗！？"

#. ID 15, Page 1, Line 3, Pos (1,11)
msgid ""
"アレが……ほしいの？\n"
"ﾌﾌﾌ…\n"
"通なのね…"
msgstr "那个……你想要？呵呵呵……真是内行呢……"

#. ID 15, Page 1, Line 8, Pos (1,11)
msgid ""
"心臓病…\n"
"腎臓病…\n"
"高血圧…"
msgstr "心脏病……肾病……高血压……"

#. ID 15, Page 1, Line 13, Pos (1,11)
msgid "西洋人はこれだから…"
msgstr "西方人就是这样……"

#. ID 16, Page 1, Line 3, Pos (2,12)
msgid ""
"私は自他共に認める事情通の男。\n"
"塩昆布の美味しさもよくわかっております。\\^"
msgstr ""
"我是自他公认的消息通男人。\n"
"我也深知盐昆布的美味。\\^"

#. ID 16, Page 1, Line 6, Pos (2,12)
msgid ""
"\\>私は自他共に認める事情通の男。\n"
"\\>塩昆布の美味しさもよくわかっております。\n"
"\\s[2]ｸﾁｬｸﾁｬ"
msgstr ""
"\\>我是自他公认的消息通男人。\n"
"\\>我也深知盐昆布的美味。\\s[2]吧唧吧唧"

#. ID 16, Page 1, Line 9, Pos (2,12)
#. Contains choice at line 3 (2 options)
msgid ""
"メニュー画面の説明文に書き切れず、\n"
"削除された文章のことももちろん知っています。"
msgstr ""
"菜单画面的说明文本中没写完而被删除的文章，\n"
"我当然也知道。"

