#. ID 3, Page 1, Line 3, Pos (11,9)
msgid "嫌な予感がする。近づくのはよそう。"
msgstr "有种不祥的预感。还是别靠近了。"

#. ID 12, Page 1, Line 7, Pos (2,0)
msgid "な、なにをするんですか！？"
msgstr "你、你要做什么！？"

#. ID 12, Page 1, Line 57, Pos (2,0)
msgid "はぁはぁ……。"
msgstr "哈啊哈啊……。"

#. ID 12, Page 1, Line 58, Pos (2,0)
msgid ""
"……！？\\.\\.\n"
"貴方、何をするつもりなの！？"
msgstr "……！？\\.\\.你，打算做什么！？"

#. ID 12, Page 1, Line 60, Pos (2,0)
msgid "や、やめて！お願い許して！\\.\\^"
msgstr "住、住手！求求你饶了我！\\.\\^"

#. ID 12, Page 1, Line 108, Pos (2,0)
msgid ""
"お願い。何でも言うこと聞くから\n"
"これ以上は……。"
msgstr "求求你。我什么都听你的，所以别再继续了……。"

#. ID 12, Page 1, Line 110, Pos (2,0)
msgid ""
"え？\\.\\.\\.嫌だ、魔物にはなりたくない！\n"
"お願いやめて！！\\.\\^"
msgstr ""
"诶？\\.\\.\\.不要，我不想变成魔物！求求你住手！！\n"
"\\.\\^"

#. ID 12, Page 1, Line 192, Pos (2,0)
msgid ""
"……お姉様。私をこのような姿に\n"
"してくれてありがとうございます。"
msgstr "……姐姐大人。谢谢你把我变成这副模样。"

#. ID 12, Page 1, Line 194, Pos (2,0)
msgid "これからはお姉様のために尽くしますわ。"
msgstr "从今以后，我会为姐姐大人效劳。"

#. ID 13, Page 1, Line 8, Pos (3,0)
msgid "……呪ってやる。"
msgstr "……我会诅咒你的。"

#. ID 13, Page 1, Line 60, Pos (3,0)
msgid "……やめて。"
msgstr "……住手。"

#. ID 13, Page 1, Line 108, Pos (3,0)
msgid "……やめるの？"
msgstr "……你要住手吗？"

#. ID 13, Page 1, Line 113, Pos (3,0)
msgid "！？\\.\\.なに……それ……\\.\\^"
msgstr "！？\\.\\.什么……那个……\\.\\^"

#. ID 13, Page 1, Line 196, Pos (3,0)
msgid "……全てご主人様に捧げます。"
msgstr "……我会把一切献给主人。"

#. ID 14, Page 1, Line 6, Pos (5,0)
msgid ""
"助けてくれたのは礼を言おう。\n"
"あのままあそこにいたら奴隷として\n"
"売り飛ばされていたかもしれん。"
msgstr ""
"你救了我，我道声谢吧。要是就那样待在那里，\n"
"说不定会被当作奴隶卖掉。"

#. ID 14, Page 1, Line 9, Pos (5,0)
msgid ""
"しかし、ここはなんだ？\n"
"まるで牢屋……\\.\\^"
msgstr "可是，这里是哪里？简直像牢房……\\.\\^"

#. ID 14, Page 1, Line 61, Pos (5,0)
msgid ""
"くぬっ……！\\.\n"
"お主、そっちの気のものか！\\.\n"
"すまないが私はそっちの趣味はry\\^"
msgstr ""
"可恶……！\\.你、你是那方面的人吗！\\.抱歉，\n"
"我没有那方面的兴趣ry\\^"

#. ID 14, Page 1, Line 110, Pos (5,0)
msgid ""
"き、\\.気持ちいい……だと……。\\.\\.\n"
"私にもそっちの気があるというのか……！"
msgstr ""
"舒、\\.舒服……你说……。\\.\\.我也有那方面的癖好吗……\n"
"！"

#. ID 14, Page 1, Line 112, Pos (5,0)
msgid ""
"おい、まて。\\.なんだそれは！？\\.\n"
"よせっ！よせ！\\.\\^"
msgstr "喂，等等。\\.那是什么！？\\.住手！住手！\\.\\^"

#. ID 14, Page 1, Line 201, Pos (5,0)
msgid ""
"あぁ、我が主よ。\n"
"このような私めを使い魔にして頂き、\n"
"誠に感謝します。"
msgstr ""
"啊啊，我的主人啊。您竟将我这样的人收为使魔，\n"
"我衷心感谢。"

#. ID 15, Page 1, Line 6, Pos (4,0)
msgid ""
"……？\\.\n"
"ごはんをたべさせてくれるんじゃないの？"
msgstr "……？\\.不是会给我饭吃吗？"

#. ID 15, Page 1, Line 58, Pos (4,0)
msgid ""
"こわいよぅ……。\n"
"助けて、ママ……。"
msgstr "好可怕啊……。救救我，妈妈……。"

#. ID 15, Page 1, Line 106, Pos (4,0)
msgid ""
"はぁ……\\.はぁ……。\\.\n"
"きもちいいよぉ、いやなのにきもちいいよぉ。"
msgstr ""
"哈啊……\\.哈啊……。\\.好舒服啊，\n"
"明明很讨厌却好舒服啊。"

#. ID 15, Page 1, Line 195, Pos (4,0)
msgid ""
"ママぁ……。\n"
"わたしをこんなすがたにしてくれてありがとう。"
msgstr "妈妈……。谢谢你把我变成这副样子。"

#. ID 16, Page 1, Line 6, Pos (6,0)
msgid ""
"貴方、何をしているのかわかっているのかしら？\n"
"わたくし達リョナンブルグ家を\n"
"敵に回すことになりますわよ！？"
msgstr ""
"你，知道自己在做什么吗？\n"
"这会与我廖南伯格家族为敌哦！？"

#. ID 16, Page 1, Line 9, Pos (6,0)
msgid ""
"お金が目当てなのね？\n"
"お金なら1000000Gぐらいはだしますわよ。\n"
"ですから早くわたくしを解放なさい！"
msgstr ""
"你图的是金钱吧？金钱的话，\n"
"1000000G左右我还是拿得出来的。所以快把我放了！"

#. ID 16, Page 1, Line 62, Pos (6,0)
msgid ""
"な、なにをなさるの……！？\n"
"まさかわたくしをお売りになるの！？"
msgstr "你、你要做什么……！？难道要把我卖掉吗！？"

#. ID 16, Page 1, Line 110, Pos (6,0)
msgid ""
"あっ……\\.はぁん……。\n"
"う……ぁ……"
msgstr "啊……\\.哈啊嗯……。唔……啊……"

#. ID 16, Page 1, Line 197, Pos (6,0)
msgid ""
"あら？\\.\\.\n"
"わたくし、気を失って……。"
msgstr "哎呀？\\.\\.我晕过去了……。"

#. ID 16, Page 1, Line 199, Pos (6,0)
msgid ""
"な、なんですのこの体！\n"
"これではまるで魔物……！"
msgstr "这、这身体是怎么回事！简直就像魔物……！"

#. ID 16, Page 1, Line 201, Pos (6,0)
msgid ""
"貴方！わたくしを早く人間に戻しなさい！\n"
"さもないとリョナンブルグ家総動員で\n"
"貴方を抹殺しますよ！"
msgstr ""
"你！快把我变回人类！\n"
"否则我就动员廖南伯格家族全体将你抹杀！"

#. ID 16, Page 1, Line 252, Pos (6,0)
msgid "ぅ……ぁ……"
msgstr "唔……啊……"

#. ID 16, Page 1, Line 253, Pos (6,0)
msgid "もう、リョナンブルグ家なんてどうでもいいわ……。"
msgstr "廖南伯格家族什么的，已经无所谓了……。"

#. ID 16, Page 1, Line 254, Pos (6,0)
msgid ""
"わたくし、人間なんて辞めて、\n"
"貴方の奴隷になってさしあげますわ。"
msgstr "我就放弃当人类，做你的奴隶好了。"

#. ID 16, Page 1, Line 256, Pos (6,0)
msgid ""
"＊性格に難あり。と言ったところだろうか。\n"
"　ともかく、逆らうことはなさそうだ。"
msgstr ""
"＊性格有缺陷。该这么说吧。　总之，\n"
"　似乎不会反抗了。"

#. ID 17, Page 1, Line 6, Pos (7,0)
msgid ""
"ねぇ、やめない？\n"
"私にこんなことしたら、\n"
"一緒に世界を支配できないわよ……？"
msgstr ""
"呐，你不打算停手吗？要是对我做这种事，\n"
"就没法一起支配世界了哦……？"

#. ID 17, Page 1, Line 59, Pos (7,0)
msgid "ひっ……そんなの、はいらないわ……！\\.\\^"
msgstr "咿……那种东西，我才不需要……！\\.\\^"

#. ID 17, Page 1, Line 106, Pos (7,0)
msgid ""
"ぁぁ……。\n"
"もう何を言っても駄目なのね……"
msgstr "啊啊……。已经不管说什么都没用了呢……"

#. ID 17, Page 1, Line 195, Pos (7,0)
msgid ""
"もう……復讐なんて……\\.\\.\n"
"どうでもいい……"
msgstr "已经……复仇什么的……\\.\\.都无所谓了……"

#. ID 17, Page 1, Line 197, Pos (7,0)
msgid "魔物の体がこんなにきもちいいなんて……"
msgstr "魔物的身体竟然这么舒服……"

#. ID 17, Page 1, Line 198, Pos (7,0)
msgid ""
"貴方、ありがとう。\n"
"私は今、最高に幸せよ。"
msgstr "你，谢谢你。我现在，无比幸福。"
