"いいえ"
msgstr ""
"是\n"
"不是"

#. ID 58, Page 2, Line 99, Pos (5,8)
msgid "そうか。話は聞いていたな？"
msgstr "这样啊。你也听到了吧？"

#. ID 58, Page 2, Line 100, Pos (5,8)
msgid ""
