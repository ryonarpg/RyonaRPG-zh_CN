#. ID 25, Page 2, Line 37, Pos (31,13)
msgid "閉じこめられた！"
msgstr "被关起来了！"

#. ID 25, Page 2, Line 67, Pos (31,13)
msgid "表面から粘性の液体が流れ出てきた！"
msgstr "粘稠的液体从表面流了出来！"

#. ID 25, Page 2, Line 90, Pos (31,13)
msgid "ドロドロの粘液が身体にまとわりつく！"
msgstr "黏糊糊的黏液缠裹在身体上！"

#. ID 25, Page 2, Line 123, Pos (31,13)
msgid "液が……からみついて…………"
msgstr "液体……缠绕上来…………"

#. ID 25, Page 2, Line 141, Pos (31,13)
msgid "身体が……液で……固まって…………"
msgstr "身体……被液体……凝固住…………"

#. ID 25, Page 2, Line 152, Pos (31,13)
msgid "うご……か………な………………"
msgstr "动……不……了………………"

#. ID 25, Page 2, Line 182, Pos (31,13)
msgid "…………………………"
msgstr "…………………………"

#. ID 25, Page 2, Line 197, Pos (31,13)
msgid "生きたまま固められてしまった…………"
msgstr "就这样活着被凝固住了…………"

#. ID 28, Page 2, Line 3, Pos (31,8)
msgid "レバーがある。"
msgstr "有一个拉杆。"

#. ID 28, Page 2, Line 4, Pos (31,8)
#. Contains choice at line 2 (2 options)
msgid "引きますか？"
msgstr "要拉吗？"

#. ID 28, Page 2, Line 5, Pos (31,8)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"露骨に怪しい"
msgstr ""
"是\n"
"明显很可疑"

#. ID 28, Page 3, Line 3, Pos (31,8)
msgid "すでに引いている。"
msgstr "已经拉了。"

#. ID 46, Page 2, Line 3, Pos (17,30)
msgid "特に何も起こらない。"
msgstr "并没有发生什么特别的事。"

#. ID 46, Page 3, Line 18, Pos (17,30)
msgid "身体が動かない……！"
msgstr "身体动不了……！"

#. ID 57, Page 2, Line 3, Pos (11,30)
msgid ""
"等身大の人形だ。\n"
"乱暴に扱われているのか、\n"
"あちこちがボロボロにほつれてしまっている。"
msgstr ""
"是等身大的人偶。或许是被粗暴对待过，\n"
"到处都破破烂烂地绽线了。"
