#. ID 41, Page 2, Line 3, Pos (16,15)
#. ID 45, Page 2, Line 3, Pos (14,14)
#. ID 46, Page 2, Line 3, Pos (17,16)
msgid "塗装済みの人形だ。"
msgstr "是已涂装的人偶。"

#. ID 41, Page 2, Line 4, Pos (16,15)
#. ID 45, Page 2, Line 4, Pos (14,14)
msgid "ぬくもりすら感じられそうな質感だ。"
msgstr "质感仿佛连温暖都能感觉到。"

#. ID 42, Page 2, Line 3, Pos (7,15)
#. ID 43, Page 2, Line 3, Pos (10,15)
#. ID 44, Page 2, Line 3, Pos (9,14)
msgid "塗装前の人形だ。"
msgstr "是涂装前的人偶。"

#. ID 42, Page 2, Line 4, Pos (7,15)
msgid "この時点ですでに生きているかのようだ。"
msgstr "在这个阶段就已经像是活着一样。"

#. ID 42, Page 2, Line 8, Pos (7,15)
#. ID 44, Page 2, Line 8, Pos (9,14)
#. ID 46, Page 2, Line 9, Pos (17,16)
#. ID 48, Page 2, Line 8, Pos (24,14)
msgid "た………す…………け…………て……………"
msgstr "救………救…………我…………啊……………"

#. ID 42, Page 2, Line 12, Pos (7,15)
#. ID 44, Page 2, Line 12, Pos (9,14)
msgid "何か聞こえたような気がする。"
msgstr "好像听到了什么。"

#. ID 43, Page 2, Line 4, Pos (10,15)
#. ID 44, Page 2, Line 4, Pos (9,14)
msgid "この時点で今にも動き出しそうだ。"
msgstr "在这个阶段就已经像随时会动起来。"

#. ID 46, Page 2, Line 4, Pos (17,16)
msgid ""
"ぬくもりすら感じられそうな質感だ。\n"
"触ってはいけないのが惜しい。"
msgstr "质感仿佛连温暖都能感觉到。不能触碰实在可惜。"

#. ID 46, Page 2, Line 13, Pos (17,16)
#. ID 48, Page 2, Line 12, Pos (24,14)
msgid ""
"………………？\n"
"何か聞こえたような気がする。"
msgstr "………………？好像听到了什么。"

#. ID 47, Page 2, Line 3, Pos (23,16)
msgid ""
"完成だ。\n"
"本物の人間と見まがうような現実感だ。"
msgstr "完成了。有着几乎会被误认为真人的现实感。"

#. ID 48, Page 2, Line 3, Pos (24,14)
#. ID 49, Page 2, Line 3, Pos (21,15)
msgid ""
"完成だ。\n"
"生きているようにしか見えない。"
msgstr "完成了。怎么看都只像是活着的。"

#. ID 57, Page 2, Line 4, Pos (30,16)
#. ID 58, Page 2, Line 4, Pos (27,14)
msgid ""
"これは石像だ。\n"
"まさかこの部屋……？"
msgstr "这是石像。难道这个房间……？"

#. ID 57, Page 2, Line 8, Pos (30,16)
#. ID 58, Page 2, Line 8, Pos (27,14)
msgid ""
"これは石像だ。\n"
"これから型を取るのだろうか。"
msgstr "这是石像。接下来要取模吗。"

#. ID 59, Page 2, Line 4, Pos (29,20)
msgid "開かない！"
msgstr "打不开！"

#. ID 60, Page 4, Line 6, Pos (2,5)
msgid ""
"……………………………………？\n"
"体が、動かない……………………"
msgstr "……………………………………？身体，动不了……………………"

#. ID 60, Page 4, Line 16, Pos (2,5)
msgid "石に……なって、しまっ……た…………"
msgstr "变成……石头、了…………"

#. ID 63, Page 2, Line 3, Pos (30,14)
msgid "レバーがある。"
msgstr "有一个拉杆。"

#. ID 63, Page 2, Line 4, Pos (30,14)
#. Contains choice at line 2 (2 options)
msgid "引きますか？"
msgstr "要拉吗？"

#. ID 63, Page 2, Line 5, Pos (30,14)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"露骨に怪しい"
msgstr ""
"是\n"
"明显可疑"

#. ID 63, Page 3, Line 3, Pos (30,14)
msgid "すでに引いている。"
msgstr "已经拉了。"
