#. ID 22, Page 2, Line 3, Pos (21,14)
msgid ""
"王妃だ……目を瞑ってはいるものの\n"
"どうやら生きているようだ。"
msgstr "是王妃……虽然闭着眼睛，但看来还活着。"

#. ID 22, Page 2, Line 5, Pos (21,14)
msgid ""
"先の戦闘を密かに脱出し、\n"
"ここで傷を癒していたらしい。"
msgstr "似乎是从先前的战斗中悄悄逃脱，在这里疗伤。"

#. ID 22, Page 2, Line 16, Pos (21,14)
msgid ""
"ひぃっ！？　あ……貴女は！！\n"
"ま、また来たのですかっ！？"
msgstr "咿！？　啊……你是！！又、又来了吗！？"

#. ID 22, Page 2, Line 18, Pos (21,14)
msgid ""
"お、お願いします……！\n"
"どうか乱暴しないで……！"
msgstr "求、求求您……！请千万不要动粗……！"

#. ID 22, Page 2, Line 22, Pos (21,14)
msgid ""
"なっ！？　あ……貴女は！！\n"
"まさかこんな所まで来るとはっ！！"
msgstr ""
"什么！？　啊……你是！！没想到竟会来到这种地方！\n"
"！"

#. ID 22, Page 2, Line 24, Pos (21,14)
msgid ""
"ぶっ、無礼者！\n"
"貴人の寝所をなんと心得ます！！\n"
"即刻立ち去りなさい！！"
msgstr ""
"无、无礼之徒！你把贵人的寝所当成什么地方了！！\n"
"立刻离开！！"

#. ID 22, Page 2, Line 54, Pos (21,14)
#. Contains choice at line 3 (2 options)
#. ID 24, Page 1, Line 31, Pos (9,14)
msgid ""
"\\N[\\V[6]]\n"
"「………」"
msgstr ""
"\\N[\\V[6]]\n"
"「………」"

#. ID 22, Page 2, Line 60, Pos (21,14)
#. Choice (2 options, embedded in a message)
msgid ""
"犯す\n"
"なにもしない"
msgstr ""
"侵犯\n"
"什么都不做"

#. ID 22, Page 3, Line 3, Pos (21,14)
msgid "う……ぁ……。"
msgstr "呜……啊……。"

#. ID 22, Page 3, Line 4, Pos (21,14)
msgid ""
"息も絶え絶えといった様子で、\n"
"放心状態になっているようだ。"
msgstr "一副气息奄奄的样子，似乎处于失神状态。"

#. ID 23, Page 2, Line 3, Pos (21,45)
#. Contains choice at line 2 (2 options)
msgid "元の場所に戻りますか？"
msgstr "要回到原来的地方吗？"

#. ID 23, Page 2, Line 4, Pos (21,45)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 24, Page 1, Line 22, Pos (9,14)
msgid ""
"そっ、そんな！！\n"
"後生です、どうかお許しを……！！"
msgstr "怎、怎么会！！求求您，请饶了我吧……！！"

#. ID 24, Page 1, Line 26, Pos (9,14)
msgid ""
"えっ……何故、突然服を……って、え？\n"
"え、ええっ！？\n"
"あ、ああ貴女、股間のそれって……！？"
msgstr ""
"诶……为什么突然脱衣服……等等，诶？诶、诶诶！？\n"
"啊、啊啊你，胯间那个是……！？"

#. ID 24, Page 1, Line 48, Pos (9,14)
msgid ""
"ひっ、ひぃぃいいいい！！\n"
"やめてっ、もう嫌っ、\n"
"いやあああぁぁぁああああああああ！！"
msgstr ""
"咿、咿咿咿——！！住手、已经不要了、\n"
"不要啊啊啊啊啊啊啊啊啊啊！！"

#. ID 24, Page 1, Line 53, Pos (9,14)
msgid ""
"ひっ、ひぃぃいいいい！！\n"
"や、やめなさいっ、ちょっやめっ、\n"
"いやあああぁぁぁああああああああ！！"
msgstr ""
"咿、咿咿咿——！！住、住手、快住手、\n"
"不要啊啊啊啊啊啊啊啊啊啊！！"

#. ID 24, Page 1, Line 58, Pos (9,14)
msgid ""
"王妃はのしかかる\\n[\\v[6]]を振り解こうと暴れるが、\n"
"必死にもがくその姿が\n"
"余計に\\n[\\v[6]]の劣情を刺激する！！"
msgstr ""
"王妃压上\\n[\\v[6]]试图甩开她而挣扎，\n"
"但拼命扭动的样子反而更加\\n[\\v[6]]的劣情被刺激\n"
"！！"

#. ID 24, Page 1, Line 66, Pos (9,14)
msgid ""
"許してっ、お願いっ！\n"
"お願いだから、それだけはああぁぁあっ！！"
msgstr ""
"饶了我吧，求求你！求求你了，\n"
"唯独那个不要啊啊啊啊！！"

#. ID 24, Page 1, Line 74, Pos (9,14)
msgid "はうぅっ！？"
msgstr "哈呜！？"

#. ID 24, Page 1, Line 82, Pos (9,14)
msgid ""
"……あ、あああ……。\n"
"またしても……汚されてしまうなんて……。"
msgstr "……啊、啊啊……。竟然又一次……被玷污了……。"

#. ID 24, Page 1, Line 86, Pos (9,14)
msgid ""
"い、入れられているの……？\n"
"わたくしの、膣に……あ、あああ……。"
msgstr "被、被插进来了吗……？我的、阴道里……啊、啊啊……。"

#. ID 24, Page 1, Line 98, Pos (9,14)
msgid ""
"あうっ、あひぃぃっ、\n"
"もう、もうやめてください……っ！！"
msgstr "啊呜、啊咿……、已经、已经请住手吧……！！"

#. ID 24, Page 1, Line 102, Pos (9,14)
msgid "そ、そんな……こんなことって……。"
msgstr "怎、怎么会……竟然有这种事……。"

#. ID 24, Page 1, Line 112, Pos (9,14)
msgid ""
"わ、我が君っ、\n"
"どうかお助けをおおおぉぉぉおお！！！！"
msgstr "我、我的主君，求您救救我啊啊啊啊啊啊！！！！"

#. ID 24, Page 1, Line 116, Pos (9,14)
msgid ""
"わ、我が君にも、\n"
"触れていただいたことがないのにぃいいいっ！！"
msgstr "可、可是连我的主君都还没碰过我啊啊啊啊！！"

#. ID 24, Page 1, Line 126, Pos (9,14)
msgid "あはああぁぁぁあああっ！！！！"
msgstr "啊哈啊啊啊啊啊啊啊啊！！！！"

#. ID 24, Page 1, Line 132, Pos (9,14)
msgid ""
"ああ、あ……\n"
"どうして……こんなことに……。"
msgstr "啊啊，啊……为什么……会变成这样……。"

#. ID 24, Page 1, Line 136, Pos (9,14)
msgid ""
"あ……ああ、あ……ひ、ひどい……\n"
"わ、わたくしの処女を……よりにもよって……\n"
"女になんて……。"
msgstr ""
"啊……啊啊，啊……太、太过分了……竟、\n"
"竟然把我的处女……偏偏……给了女人……。"

#. ID 24, Page 1, Line 139, Pos (9,14)
msgid ""
"我が君……\n"
"どうか……わたくしを……\n"
"お許しください……。"
msgstr "我的主君……请您……原谅我……。"

#. ID 28, Page 2, Line 20, Pos (42,14)
msgid ""
"目が覚めたようですね。\n"
"御気分はいかがですか？"
msgstr "看来您醒了。您感觉如何？"

#. ID 28, Page 2, Line 36, Pos (42,14)
msgid ""
"\\N[\\V[6]]は精一杯もがくが、\n"
"四肢をきつく拘束され身動きがとれない。\n"
msgstr ""
"\\N[\\V[6]]拼命挣扎，但四肢被紧紧束缚，\n"
"无法动弹。"

#. ID 28, Page 2, Line 44, Pos (42,14)
msgid ""
"大丈夫。\n"
"恐れる必要はありません……。"
msgstr "没关系。没有必要害怕……。"

#. ID 28, Page 2, Line 52, Pos (42,14)
msgid ""
"わたくしは\n"
"強い者が好き。気高い者が好き。\n"
"勇気ある者が好き。"
msgstr "我喜欢强者。喜欢高洁的人。喜欢有勇气的人。"

#. ID 28, Page 2, Line 55, Pos (42,14)
msgid ""
"――そして何より美しい者が好き……\n"
"貴女はどれも満たしている。"
msgstr "――而且最重要的是，我喜欢美丽的人……你全都具备。"

#. ID 28, Page 2, Line 63, Pos (42,14)
msgid ""
"そんな貴女を害そうはずがないでしょう。\n"
"ねえ……？"
msgstr "我怎么可能伤害这样的你呢。对吧……？"

#. ID 28, Page 2, Line 69, Pos (42,14)
msgid ""
"拘束台に身を乗り出し\n"
"\\N[\\V[6]]の耳元で囁く王妃の声音は\n"
"どこまでも甘く優しい……それこそぞっとするほど。"
msgstr ""
"王妃探身靠近拘束台，在\\N[\\V[6]]耳边低语，\n"
"那声音无比甜美温柔……甚至令人毛骨悚然。"

#. ID 28, Page 2, Line 86, Pos (42,14)
msgid ""
"恐怖心を煽られた\n"
"\\N[\\V[6]]は精一杯もがくが、\n"
"しかし拘束が緩む気配はまったくない。"
msgstr ""
"被煽起恐惧的\\N[\\V[6]]拼命挣扎，\n"
"但束缚完全没有松动的迹象。"

#. ID 28, Page 2, Line 95, Pos (42,14)
msgid ""
"ふふふ……貴女のような者こそ\n"
"わたくしに仕えるに相応しい。"
msgstr "呵呵呵……像你这样的人，才配侍奉我。"

#. ID 28, Page 2, Line 97, Pos (42,14)
msgid ""
"……そう、\n"
"この部屋にいる皆のように、ね……。"
msgstr "……没错，就像这个房间里的所有人一样，对吧……。"

#. ID 28, Page 2, Line 116, Pos (42,14)
msgid ""
"心配は無用です。処置が終われば、\n"
"煩わしいことは全て忘れてしまいますよ。"
msgstr "无需担心。等处置结束，一切烦心的事都会忘掉的。"

#. ID 28, Page 2, Line 126, Pos (42,14)
msgid "――おやりなさい。"
msgstr "――动手吧。"

#. ID 28, Page 2, Line 159, Pos (42,14)
msgid ""
"――！？\n"
"何かを体に巻きつけられた！！\n"
"布？　……包帯！？"
msgstr "――！？有什么东西缠到了身上！！布？　……绷带！？"

#. ID 28, Page 2, Line 163, Pos (42,14)
msgid ""
"あ、熱っ……、熱い！！\n"
"肌に張り付く何かに、物凄い熱を案じる！！"
msgstr ""
"啊，烫……、好烫！！紧贴在皮肤上的东西，\n"
"让我感到惊人的热度！！"

#. ID 28, Page 2, Line 178, Pos (42,14)
msgid ""
"\\N[\\V[6]]の身体から\n"
"凄まじい勢いで水分が搾り取られていく！！"
msgstr ""
"\\N[\\V[6]]的身体里，\n"
"水分正以惊人的势头被榨取出来！！"

#. ID 28, Page 2, Line 180, Pos (42,14)
msgid ""
"熱い、熱い、熱い……！！\n"
"このままでは……干物にされてしまう！"
msgstr ""
"好烫、好烫、好烫……！！这样下去……\n"
"我会被做成干物的！"

#. ID 28, Page 2, Line 195, Pos (42,14)
msgid ""
"体中が燃えるように熱い！\n"
"体内の水分が絞られ、\n"
"瑞々しかった肉体が干からびていくのがわかる……！"
msgstr ""
"全身像燃烧一样烫！能感觉到体内的水分被榨出，\n"
"原本水润的身体正在干枯……！"

#. ID 28, Page 2, Line 211, Pos (42,14)
msgid ""
"\n"
"熱ううぅうぅうああああっ！！！！"
msgstr "好烫啊啊啊啊啊啊啊啊！！！！"

#. ID 28, Page 2, Line 263, Pos (42,14)
msgid ""
"………。\n"
"終わったようですね……。"
msgstr "………。看来结束了呢……。"

#. ID 28, Page 2, Line 276, Pos (42,14)
msgid ""
"うふふ……\n"
"とってもいい格好……。"
msgstr "呵呵呵……真是非常好的模样……。"

#. ID 28, Page 2, Line 283, Pos (42,14)
msgid ""
"わたくしの名はアムネリス。この国の王妃です。\n"
"答えなさい。……貴女の名は？"
msgstr ""
"我的名字是阿姆内利斯。是这个国家的王妃。\n"
"回答我。……你叫什么名字？"

#. ID 28, Page 2, Line 289, Pos (42,14)
msgid ""
"………。\n"
"\\N[\\V[6]]……。"
msgstr ""
"………。\n"
"\\N[\\V[6]]……。"

#. ID 28, Page 2, Line 296, Pos (42,14)
msgid ""
"答えなさい\\N[\\V[6]]。\n"
"貴女は何者？"
msgstr "回答我，\\N[\\V[6]]。你是什么人？"

#. ID 28, Page 2, Line 302, Pos (42,14)
msgid ""
"………。\n"
"全能なる王と王妃、\n"
"そして偉大なる王国に仕える衛士……。"
msgstr ""
"………。侍奉全能之王与王妃、以及伟大王国的卫士……\n"
"。"

#. ID 28, Page 2, Line 309, Pos (42,14)
msgid ""
"よく答えられました、\\N[\\V[6]]。\n"
"うふふ……今の貴女の姿、とっても素敵ですよ……。"
msgstr ""
"回答得很好，\\N[\\V[6]]。呵呵呵……你现在的样子，\n"
"非常漂亮哦……。"

#. ID 28, Page 2, Line 316, Pos (42,14)
msgid ""
"そして\\N[\\V[6]]は王妃に伴なわれ\n"
"ピラミッドの闇の奥底へ消えて行った……。"
msgstr ""
"然后\\N[\\V[6]]在王妃的带领下，\n"
"消失在金字塔黑暗的深处……。"

#. ID 28, Page 2, Line 322, Pos (42,14)
msgid "その後、\\n[\\v[6]]の姿を見たものはいない………"
msgstr "那之后，\\n[\\v[6]]的身影再没有人见过………"
