#. ID 37, Page 2, Line 3, Pos (10,36)
msgid ""
"ものまね士シンシア\n"
"「私は仲間……姉妹と、\n"
"　酒場の仕事で調査に来たの」"
msgstr ""
"模仿士辛西娅「我和伙伴……姐妹们，\n"
"　因为酒馆的工作来调查的」"

#. ID 37, Page 2, Line 6, Pos (10,36)
msgid ""
"「ここに臨時のキャンプを敷いて、\n"
"　私がここのお守りを任せられたんだけど……」"
msgstr "「在这里设置了临时营地，　我被委派看守这里……」"

#. ID 37, Page 2, Line 13, Pos (10,36)
msgid "「……調査に行った仲間が戻ってこないの」"
msgstr "「……去调查的伙伴没有回来」"

#. ID 37, Page 2, Line 14, Pos (10,36)
msgid ""
"「腕利きの冒険者ばかりだから\n"
"　大丈夫だと思うけど……」"
msgstr ""
"「因为都是些身手高明的冒险者　我想应该没问题……\n"
"　」"

#. ID 37, Page 3, Line 3, Pos (10,36)
msgid ""
"ものまね士シンシア\n"
"「あなたが助けてくれたのね！\n"
"　有難う！」"
msgstr "模仿士辛西娅「是你救了我吧！　谢谢！」"

#. ID 37, Page 3, Line 11, Pos (10,36)
msgid ""
"「でも、まだ戻っていない仲間が居るの……\n"
"　大丈夫だと思うけど……」"
msgstr "「但是，还有没回来的伙伴……　我想应该没问题……」"

#. ID 37, Page 4, Line 3, Pos (10,36)
msgid ""
"ものまね士シンシア\n"
"「あなたが皆を助けてくれたのね！\n"
"　本当に有難う！」"
msgstr "模仿士辛西娅「是你救了大家吧！　真的谢谢！」"

#. ID 37, Page 4, Line 11, Pos (10,36)
msgid ""
"「……あの、これ……\n"
"　皆を助けてくれたお礼にプレゼントするね！」"
msgstr ""
"「……那个，这个……　作为救了大家的谢礼，\n"
"　送给你哦！」"

#. ID 37, Page 4, Line 23, Pos (10,36)
msgid "＊[クリスタルのかけら]を３個　手に入れた！"
msgstr "＊获得了3个[水晶碎片]！"

#. ID 37, Page 4, Line 29, Pos (10,36)
msgid ""
"「さて……酒場のマスターに謝ってこないと\n"
"　怒られるだろうけど……でも大丈夫！\n"
"　怒られるの私だけじゃあないから！」"
msgstr ""
"「那么……得去跟酒馆老板道歉才行　虽然会被骂……\n"
"　但没关系！　因为挨骂的不只我一个！」"

#. ID 37, Page 4, Line 32, Pos (10,36)
msgid ""
"「これからもずっと皆と冒険していくわ！\n"
"　ありがとう……またね！」"
msgstr ""
"「今后也要一直和大家一起冒险！　谢谢……再见啦！\n"
"　」"

#. ID 58, Page 2, Line 3, Pos (40,49)
#. ID 59, Page 2, Line 3, Pos (41,49)
msgid "＊どこか遠くへ通じているようだ……"
msgstr "＊似乎通向某个遥远的地方……"

#. ID 67, Page 2, Line 3, Pos (8,35)
msgid ""
"「……え？\n"
"　ものまね士さんがどこにいったかって？」"
msgstr "「……诶？　你问模仿士小姐去哪里了？」"

#. ID 67, Page 2, Line 5, Pos (8,35)
msgid ""
"「何でも、仲間が中々戻ってこないから\n"
"　一人で探しにいったらしいわよ」"
msgstr "「听说因为伙伴迟迟没回来　她好像一个人去找了」"

#. ID 67, Page 2, Line 7, Pos (8,35)
msgid ""
"「一人じゃ危険だからって引き止めたんだけど\n"
"　仲間が待ってる！って聞かなくて……」"
msgstr ""
"「我说一个人太危险就劝阻了她　但她说伙伴在等着\n"
"　！根本不听……」"

#. ID 67, Page 2, Line 9, Pos (8,35)
msgid "「無事だと良いんだけど……」"
msgstr "「要是平安无事就好了……」"

#. ID 68, Page 2, Line 3, Pos (10,35)
#. ID 68, Page 3, Line 3, Pos (10,35)
msgid ""
"時魔導士ジョアン\n"
"「助けてくれてありがと～\n"
"　ここまで来れば一安心……かな？」"
msgstr ""
"时魔导士乔安\n"
"「谢谢你救了我～　到了这里总算能安心……吧？」"

#. ID 68, Page 2, Line 12, Pos (10,35)
msgid ""
"「でも、まだ仲間が全員戻ってないから……\n"
"　もうちょっと待っていようかな」"
msgstr ""
"「但是，伙伴还没有全部回来……\n"
"　要不再多等一会儿吧」"

#. ID 68, Page 2, Line 16, Pos (10,35)
msgid "「でも……他の仲間は大丈夫……かな？」"
msgstr "「但是……其他伙伴没事……吧？」"

#. ID 68, Page 3, Line 11, Pos (10,35)
msgid ""
"「ああでも、酒場のマスターに怒られちゃう…\n"
"　許してもらえない……かな？」"
msgstr ""
"「啊，不过，会被酒馆老板骂的…　也许不会原谅我…\n"
"　…吧？」"

#. ID 69, Page 2, Line 3, Pos (13,35)
msgid ""
"白魔導士エレーヌ\n"
"「…………」"
msgstr "白魔导士埃莱娜「…………」"

#. ID 69, Page 2, Line 5, Pos (13,35)
#. ID 69, Page 2, Line 30, Pos (13,35)
msgid "「………あ………あの……」"
msgstr "「………啊………那个……」"

#. ID 69, Page 2, Line 11, Pos (13,35)
msgid "「回復………」"
msgstr "「回复………」"

#. ID 69, Page 2, Line 24, Pos (13,35)
msgid "＊全回復した！"
msgstr "＊完全恢复了！"

#. ID 69, Page 2, Line 37, Pos (13,35)
msgid ""
"「たすけてくれて……\n"
"　あ、……りがと………」"
msgstr "「救了我……　啊，……谢谢………」"

#. ID 69, Page 2, Line 47, Pos (13,35)
msgid "「わたし………待ってる、から」"
msgstr "「我………会等的，所以」"

#. ID 69, Page 3, Line 3, Pos (13,35)
msgid ""
"白魔導士エレーヌ\n"
"「………あ………あの……」"
msgstr "白魔导士埃莱娜「………啊………那个……」"

#. ID 69, Page 3, Line 11, Pos (13,35)
msgid ""
"「たすけてくれて……\n"
"　本当に……ありがと………」"
msgstr "「救了我……　真的……谢谢………」"

#. ID 69, Page 3, Line 19, Pos (13,35)
msgid "「あの………これ……」"
msgstr "「那个………这个……」"

#. ID 69, Page 3, Line 20, Pos (13,35)
msgid ""
"「う……うけとって……\n"
"　ください………」"
msgstr "「请……请收下……　拜托了………」"

#. ID 69, Page 3, Line 29, Pos (13,35)
msgid "＊手紙を渡された"
msgstr "＊被递来了一封信"

#. ID 71, Page 2, Line 3, Pos (4,35)
msgid ""
"「最近見つかったダンジョンってことで\n"
"　結構な数の冒険者が調査に来ているみたいだな」"
msgstr ""
"「听说因为是最近发现的地下城　好像有相当多的冒\n"
"　险者来调查」"

#. ID 71, Page 2, Line 5, Pos (4,35)
msgid ""
"「ただ、戻ってこない連中も多いって聞くぜ。\n"
"　よく注意しろよ。」"
msgstr ""
"「不过，听说回不来的家伙也很多。\n"
"　要多加小心啊。」"

#. ID 72, Page 2, Line 3, Pos (11,37)
msgid ""
"見習い戦士アマンダ\n"
"「さっきは助かったわ！有難う！」"
msgstr "见习战士阿曼达「刚才真是得救了！谢谢！」"

#. ID 72, Page 2, Line 10, Pos (11,37)
msgid ""
"「それにしても……\n"
"　ワタシを置いて逃げていったくせに！\n"
"　まだ戻ってないってどういうことよ！」"
msgstr ""
"「话说回来……　明明把我丢下逃走了！\n"
"　还没回来是怎么回事啊！」"

#. ID 72, Page 2, Line 13, Pos (11,37)
msgid "「本当に……！」"
msgstr "「真是的……！」"

#. ID 72, Page 2, Line 20, Pos (11,37)
msgid ""
"「本当に……先に逃げたんだから\n"
"　……大丈夫に決まってるわ\n"
"　絶対……いつか戻ってくるわよ」"
msgstr ""
"「真是的……既然先逃走了　……肯定没事的　绝对……\n"
"　总有一天会回来的」"

#. ID 72, Page 3, Line 3, Pos (11,37)
msgid ""
"見習い戦士アマンダ\n"
"「今度は逃げないようにしてもらいたいわね！」"
msgstr "见习战士阿曼达「下次希望你别再逃走了呢！」"

#. ID 72, Page 3, Line 5, Pos (11,37)
msgid ""
"「……ま、お夕食奢ってくれるらしいから\n"
"　許してあげるけど」"
msgstr "「……嘛，好像会请我吃晚饭　所以就原谅他们吧」"

#. ID 73, Page 2, Line 3, Pos (13,36)
msgid ""
"アイテム士ヴェロニカ\n"
"「いや～～～～～\n"
"　助かった助かったほんと有難うございます～」"
msgstr ""
"道具士维罗妮卡\n"
"「哎呀～～～～～　得救了得救了真的非常感谢～」"

#. ID 73, Page 2, Line 11, Pos (13,36)
msgid "「で……アイテム買わへんかい？」"
msgstr "「那么……不买道具吗？」"

#. ID 73, Page 2, Line 16, Pos (13,36)
msgid "「まあ、命あっただけ儲けだわね～」"
msgstr "「嘛，只要还有命就算赚了～」"

#. ID 73, Page 3, Line 3, Pos (13,36)
msgid ""
"アイテム士ヴェロニカ\n"
"「あ～いや～その節は助かりました～\n"
"　感謝しとります～」"
msgstr ""
"道具士维罗妮卡\n"
"「啊～不～那时真是帮大忙了～　非常感谢～」"

#. ID 73, Page 3, Line 11, Pos (13,36)
msgid "「さて……入用ですかいな？」"
msgstr "「那么……需要些什么吗？」"

#. ID 73, Page 3, Line 16, Pos (13,36)
msgid "「ん？　いつまでここに居るかって？」"
msgstr "「嗯？　问我在这里待到什么时候？」"

#. ID 73, Page 3, Line 17, Pos (13,36)
msgid ""
"「そりゃ決まってますよい～\n"
"　皆が揃うまでですがな～」"
msgstr "「那还用说嘛～　当然是要待到大家集齐为止啦～」"

#. ID 73, Page 3, Line 19, Pos (13,36)
msgid ""
"「身内の食い扶持くらいは、ここの調査に来る\n"
"　冒険者相手に商売すれば稼げますからの～」"
msgstr ""
"「家里人的口粮钱总得挣嘛，\n"
"　只要向来这里调查的冒险者做买卖就能赚到的～」"

#. ID 73, Page 3, Line 21, Pos (13,36)
msgid ""
"「全員そろってこその、仲間でっしゃい\n"
"　お金やアイテムなんかには変えられませんて」"
msgstr ""
"「要全员到齐才算得上伙伴嘛　这可不是金钱或道具\n"
"　能替代的」"

#. ID 73, Page 4, Line 3, Pos (13,36)
msgid ""
"アイテム士ヴェロニカ\n"
"「全員揃った揃った！\n"
"　さあて、次の稼ぎ場所を何処にするか……」"
msgstr ""
"道具士维罗妮卡「全员到齐了到齐了！　那么，\n"
"下一个赚钱的地方要定在哪里呢……」"

#. ID 74, Page 2, Line 3, Pos (3,41)
msgid ""
"「ここはゾンビのような敵が多いでござる\n"
"　毒消しや止血剤が欲しいでござるな」"
msgstr ""
"「这里像僵尸一样的敌人很多是也　想要解毒剂和止\n"
"　血剂是也」"

#. ID 75, Page 2, Line 3, Pos (3,44)
msgid "「一人で行くのか？」"
msgstr "「你要一个人去吗？」"

#. ID 75, Page 2, Line 4, Pos (3,44)
msgid ""
"「やめたほうが良いと思うぜ……\n"
"　つい先日も有名どころのギルド部隊が\n"
"　全滅したとか聞くしさ」"
msgstr ""
"「我觉得还是别去了……　听说就在前几天，\n"
"　连有名气公会的部队都全军覆没了」"

#. ID 77, Page 2, Line 3, Pos (32,26)
#. Contains choice at line 2 (2 options)
msgid "ここで釣りができそうだ。"
msgstr "这里好像能钓鱼。"

#. ID 77, Page 2, Line 10, Pos (32,26)
#. Choice (2 options, embedded in a message)
msgid ""
"釣りをする\n"
"そんな場合ではない！"
msgstr ""
"钓鱼\n"
"现在不是做那种事的时候！"

#. ID 77, Page 2, Line 29, Pos (32,26)
msgid "釣り竿を装備していない。"
msgstr "没有装备钓竿。"

#. ID 77, Page 2, Line 39, Pos (32,26)
msgid "釣りを始めた。"
msgstr "开始钓鱼了。"
