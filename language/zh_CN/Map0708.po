#. ID 3, Page 5, Line 5, Pos (2,0)
#. ID 24, Page 2, Line 6, Pos (13,0)
msgid "……嘘でしょぉ……"
msgstr "……骗人的吧……"

#. ID 3, Page 5, Line 6, Pos (2,0)
msgid ""
"ここで戦闘シーンになるなんて\n"
"聞いてないわ……誰の仕業よ……"
msgstr "我可没听说这里会变成战斗场景……是谁干的啊……"

#. ID 4, Page 5, Line 5, Pos (3,0)
#. ID 24, Page 2, Line 19, Pos (13,0)
msgid ""
"ありゃありゃりゃ……\n"
"どうしようかなこれ"
msgstr "哎呀呀呀……这个该怎么办呢"

#. ID 4, Page 5, Line 7, Pos (3,0)
#. ID 24, Page 2, Line 21, Pos (13,0)
msgid "よし、逃げるが勝ちってことで"
msgstr "好，那就逃为上策吧。"

#. ID 12, Page 2, Line 5, Pos (12,0)
msgid "見つけたっスよ、密猟者ども！！"
msgstr "找到你们了，盗猎者们！！"

#. ID 12, Page 2, Line 15, Pos (12,0)
msgid ""
"あ、来てくれたんスか、でも\n"
"もう大丈夫っスよ。\n"
"後はコイツ等ぶっ飛ばして終わらせるッス"
msgstr ""
"啊，你来了啊，不过已经没事了。\n"
"接下来把这些家伙揍飞就结束了。"

#. ID 12, Page 2, Line 24, Pos (12,0)
msgid "\\n[\\v[6]]さん…\\!来てくれたんだ…"
msgstr "\\n[\\v[6]]…\\!你来了啊…"

#. ID 12, Page 2, Line 31, Pos (12,0)
msgid "さあ！！覚悟するっスよ！！"
msgstr "来吧！！做好觉悟吧！！"

#. ID 12, Page 2, Line 36, Pos (12,0)
#. ID 12, Page 3, Line 21, Pos (12,0)
msgid "あ…あわわわ…！"
msgstr "啊…啊哇哇哇…！"

#. ID 12, Page 2, Line 41, Pos (12,0)
#. ID 12, Page 3, Line 26, Pos (12,0)
msgid ""
"今までの捕まえたの全員解放するから\n"
"命だけは助けてもらえないかな？\n"
"せめて私だけでもさ。そもそも私はこの人\n"
"に無理やりつき合わされてるだけなんだし"
msgstr ""
"至今抓来的人我全都放了，所以能不能只饶我一命？\n"
"至少只放过我也行啊。\n"
"再说我本来只是被这个人硬拖下水的。"

#. ID 12, Page 2, Line 49, Pos (12,0)
#. ID 12, Page 3, Line 34, Pos (12,0)
msgid "ちょ…\\!それだと私は…？"
msgstr "喂…\\!那这样的话我…？"

#. ID 12, Page 2, Line 54, Pos (12,0)
#. ID 12, Page 3, Line 39, Pos (12,0)
msgid ""
"お墓はちゃんと立ててあげるよ。\n"
"ドラゴンにずたずたにされて眠るって…"
msgstr ""
"我会给你好好立个墓的。\n"
"就说你被龙撕成碎片后长眠了…"

#. ID 12, Page 2, Line 60, Pos (12,0)
#. ID 12, Page 3, Line 45, Pos (12,0)
#. ID 14, Page 2, Line 4, Pos (13,9)
msgid "………"
msgstr "………"

#. ID 12, Page 2, Line 65, Pos (12,0)
#. ID 12, Page 3, Line 50, Pos (12,0)
msgid ""
"ダメっス！！\\!お前等みたいなのは絶対に\n"
"許しちゃなんないっス！！"
msgstr "不行！！\\!像你们这样的家伙绝对不能原谅！！"

#. ID 12, Page 2, Line 71, Pos (12,0)
#. ID 12, Page 3, Line 56, Pos (12,0)
msgid "だ…\\!だったら…！！"
msgstr "那…\\!那就…！！"

#. ID 12, Page 2, Line 79, Pos (12,0)
#. ID 12, Page 3, Line 64, Pos (12,0)
msgid "ひっ！！"
msgstr "咿！！"

#. ID 12, Page 2, Line 84, Pos (12,0)
#. ID 12, Page 3, Line 69, Pos (12,0)
msgid "こ、こいつがどうなっても知らないよ！！"
msgstr "这、这家伙会怎样我可不管哦！！"

#. ID 12, Page 2, Line 89, Pos (12,0)
#. ID 12, Page 3, Line 74, Pos (12,0)
msgid ""
"姉さん…\\!それ三下のやることだよ…\n"
"だいたいその子も曲がりなりにもドラゴン\n"
"だから…\\!ちょっとやそっとじゃ傷つかな\n"
"いよ…"
msgstr ""
"姐姐…\\!那是小喽啰才会做的事哦…\n"
"再说那孩子好歹也是龙…\n"
"\\!可不是随随便便就会受伤的…"

#. ID 12, Page 2, Line 93, Pos (12,0)
#. ID 12, Page 3, Line 78, Pos (12,0)
msgid ""
"姉さんがその子の首を絞める前に\n"
"姉さんの首が吹っ飛ぶ方が速いだろうね～\n"
"\\!ご愁傷様"
msgstr ""
"在姐姐掐住那孩子脖子之前，\n"
"姐姐的头被轰飞会更快吧～\\!节哀顺变"

#. ID 12, Page 2, Line 100, Pos (12,0)
#. ID 12, Page 3, Line 85, Pos (12,0)
msgid "う…\\!うるさーい！！"
msgstr "呜…\\!吵死了——！！"

#. ID 12, Page 2, Line 105, Pos (12,0)
#. ID 12, Page 3, Line 90, Pos (12,0)
msgid ""
"さあ、覚悟は出来たっスか？\n"
"それじゃあ行くっスよ！！"
msgstr "来吧，做好觉悟了吗？那就上了哦！！"

#. ID 12, Page 2, Line 113, Pos (12,0)
#. ID 12, Page 3, Line 98, Pos (12,0)
msgid "ひゃあああ！！！"
msgstr "呀啊啊啊啊！！！"

#. ID 12, Page 2, Line 118, Pos (12,0)
msgid "仕方ないなあ…\\!なすーん！！"
msgstr "真没办法啊…\\!娜丝恩！！"

#. ID 12, Page 2, Line 123, Pos (12,0)
#. ID 12, Page 3, Line 112, Pos (12,0)
msgid "………\\!はい…\\!ご主人様…"
msgstr "………\\!是的…\\!主人…"

#. ID 12, Page 2, Line 128, Pos (12,0)
#. ID 12, Page 3, Line 129, Pos (12,0)
msgid "………\\!え…"
msgstr "………\\!诶…"

#. ID 12, Page 2, Line 141, Pos (12,0)
msgid "……あ…が……"
msgstr "……啊…唔……"

#. ID 12, Page 2, Line 151, Pos (12,0)
msgid ""
"ふふん…\\!よくやったね。なすーん\n"
"…\\!この子が持ってるのは毒塗りの刃物。\n"
"ドラゴンですら一発で昏倒させるってさ。\n"
"眉唾だったけど買っといてよかったよ。"
msgstr ""
"呵呵…\\!干得不错嘛。娜丝恩…\n"
"\\!这孩子拿的是涂了毒的刀刃。\n"
"据说连龙都能一击昏倒。虽然我半信半疑，\n"
"但买了真是太好了。"

#. ID 12, Page 2, Line 155, Pos (12,0)
msgid ""
"ま、真っ当な人間がドラゴンを刺すなんて\n"
"事自体が不可能だけど…\n"
"\\!さすがに同じドラゴンなら余裕って訳ね"
msgstr ""
"不、不过，正常人类刺中龙这种事本身就不可能…\n"
"\\!果然同为龙的话就轻松多了呢"

#. ID 12, Page 2, Line 162, Pos (12,0)
msgid ""
"……え…\\!…あ…\\!どういうことっすか…\n"
"なすーんさん…？"
msgstr "……诶…\\!…啊…\\!这是什么意思啊…娜丝恩小姐…？"

#. ID 12, Page 2, Line 168, Pos (12,0)
msgid ""
"ごめんね、村長さん。\n"
"\\!でも…\\!ご主人様のいう事は絶対だから…"
msgstr "对不起，村长。\\!但是…\\!主人的话是绝对的…"

#. ID 12, Page 2, Line 174, Pos (12,0)
msgid "あ…\\!あんた一体なにしたのよ…"
msgstr "啊…\\!你到底做了什么…"

#. ID 12, Page 2, Line 179, Pos (12,0)
msgid ""
"ちょっと躾けてあげただけだよ。\n"
"そうやって人間のペットにするんでしょ？"
msgstr ""
"只是稍微调教了一下而已。\n"
"就是这样把人变成宠物的吧？"

#. ID 12, Page 2, Line 185, Pos (12,0)
msgid "……\\!い…\\!いつの間に…？"
msgstr "……\\!什…\\!什么时候…？"

#. ID 12, Page 2, Line 190, Pos (12,0)
msgid ""
"そんな大した事じゃないよ。\n"
"所詮はケダモノ、簡単だよ"
msgstr "没那么了不起啦。终究是畜生，很简单"

#. ID 12, Page 2, Line 196, Pos (12,0)
#. ID 12, Page 3, Line 207, Pos (12,0)
msgid ""
"いい子にしてれば受け入れてくれるって\n"
"ご主人様がいってくれたんだ。\n"
"言うことを何でも聞いて忠実にしてれば\n"
"愛してくれるって…"
msgstr ""
"主人说只要乖乖的就会被接纳。只要什么都听、\n"
"忠心耿耿就会被爱…"

#. ID 12, Page 2, Line 200, Pos (12,0)
msgid ""
"生まれた時から周りから嫌悪され、\n"
"疎外されて、迫害されて…\n"
"父親も分からず、母親からも捨てられた私\n"
"を愛してくれるんだよ…"
msgstr ""
"从出生起就被周围厌恶、排斥、迫害…\n"
"连父亲都不知道，被母亲抛弃的我，他愿意爱我…"

#. ID 12, Page 2, Line 205, Pos (12,0)
msgid "だったら…\\!私は…"
msgstr "既然如此…\\!我…"

#. ID 12, Page 2, Line 210, Pos (12,0)
msgid ""
"……\\!この子も、貴女も、そこの子も…\n"
"いや…あの村の住人全部がまともな生物\n"
"じゃない…\\!そんなのがまともに受け入れ\n"
"られるとしたら、こういう形でしかないよ"
msgstr ""
"……\\!这个孩子也好，你也好，那边的孩子也好…不…\n"
"那个村子的居民全都不是正常的生物…\n"
"\\!这样的存在要被正常接纳的话，\n"
"就只能以这种形式了"

#. ID 12, Page 2, Line 214, Pos (12,0)
msgid ""
"どこにも受け入れられない異端者が集まっ\n"
"た所で、結局孤独からは逃れられない。\n"
"だからせめて支配されるという形で真っ当\n"
"な人や社会とつながればいいんだよ。"
msgstr ""
"无处可去的异端者聚集在一起，终究逃不过孤独。\n"
"所以至少以被支配的形式与正常的人和社会联系起来\n"
"就好了。"

#. ID 12, Page 2, Line 222, Pos (12,0)
#. ID 12, Page 3, Line 195, Pos (12,0)
#. ID 24, Page 2, Line 43, Pos (13,0)
msgid "…………"
msgstr "…………"

#. ID 12, Page 2, Line 227, Pos (12,0)
msgid ""
"と…\\!とりあえずこの厄介なドラゴンが\n"
"いなくなったら、もう狩り放題じゃない。\n"
"い…いやハーフドラゴン2匹も確保ってだけ\n"
"でもう、一財産作れるわ。"
msgstr ""
"总…\\!总之这麻烦的龙不在了的话，\n"
"就又能随便猎了。不…不对，\n"
"光是确保两只半龙就已经能发一笔财了。"

#. ID 12, Page 2, Line 235, Pos (12,0)
msgid ""
"喜ぶのはちょっと速いかな…？\n"
"姉さん、まだもう一匹残ってる。"
msgstr "高兴得有点早吧…？姐姐，还有一只没解决呢。"

#. ID 12, Page 2, Line 241, Pos (12,0)
msgid "\\n[\\v[6]]さん…"
msgstr "\\n[\\v[6]]小姐…"

#. ID 12, Page 2, Line 246, Pos (12,0)
msgid "…………\\!逃げて…村のみんなを…"
msgstr "…………\\!快逃…带村里的人们…"

#. ID 12, Page 2, Line 251, Pos (12,0)
msgid "ほら！\\!早くそいつも捕まえちゃってよ!!"
msgstr "喂！\\!快点把那家伙也抓住啊！！"

#. ID 12, Page 2, Line 256, Pos (12,0)
msgid ""
"……\\!友達なんでしょ？\n"
"貴方達の本当の幸せを分かってもらおう。"
msgstr "……\\!是朋友吧？让她们明白你们真正的幸福吧。"

#. ID 12, Page 2, Line 264, Pos (12,0)
msgid "……はい…\\!行きます！！"
msgstr "……是…\\!我去！！"

#. ID 12, Page 3, Line 10, Pos (12,0)
msgid ""
"さあ、追い詰めたッス！！\n"
"もう覚悟するッスよ！"
msgstr "来吧，已经逼到绝路了！！快觉悟吧！"

#. ID 12, Page 3, Line 16, Pos (12,0)
msgid "村長さん…"
msgstr "村长…"

#. ID 12, Page 3, Line 105, Pos (12,0)
msgid "仕方ないなあ…\\!…なすーん、これを…"
msgstr "没办法了…\\!…娜丝恩，这个给你…"

#. ID 12, Page 3, Line 120, Pos (12,0)
msgid ""
"密猟者の1人がなすーんに何か持たせた…\n"
"\\!あれは…？\\!危ない！！"
msgstr ""
"盗猎者中的一人让娜丝恩拿了什么东西…\\!那是…？\n"
"\\!危险！！"

#. ID 12, Page 3, Line 142, Pos (12,0)
msgid ""
"なすーんの持ってたナイフを思いっきり\n"
"弾いた！！"
msgstr "把娜丝恩拿着的刀狠狠弹飞了！！"

#. ID 12, Page 3, Line 148, Pos (12,0)
msgid "……\\n[\\v[6]]さん！？"
msgstr "……\\n[\\v[6]]小姐！？"

#. ID 12, Page 3, Line 153, Pos (12,0)
msgid "あ……"
msgstr "啊……"

#. ID 12, Page 3, Line 158, Pos (12,0)
msgid "おっと、この流れは……"
msgstr "哦哟，这个走向是……"

#. ID 12, Page 3, Line 165, Pos (12,0)
msgid "え…？なに…どうしたの？"
msgstr "诶…？什么…怎么了？"

#. ID 12, Page 3, Line 170, Pos (12,0)
msgid "！！"
msgstr "！！"

#. ID 12, Page 3, Line 178, Pos (12,0)
msgid "あ…"
msgstr "啊…"

#. ID 12, Page 3, Line 188, Pos (12,0)
msgid ""
"もう1人は…逃げたッスか…\n"
"\\n[\\v[6]]さん、助けてくれてあり\n"
"がとうっス…"
msgstr "另一个人…逃走了吗…\\n[\\v[6]]小姐，谢谢你救了我…"

#. ID 12, Page 3, Line 202, Pos (12,0)
msgid "なすーんさん…\\!どうして…"
msgstr "娜丝恩小姐…\\!为什么…"

#. ID 12, Page 3, Line 211, Pos (12,0)
msgid ""
"生まれた時から周りから嫌悪され、\n"
"疎外されて、迫害されて…\n"
"父親も分からず、母親からも捨てられた私\n"
"を愛してくれるって…"
msgstr ""
"从出生起就被周围厌恶、排斥、迫害…\n"
"连父亲都不知道，被母亲抛弃的我，他愿意爱我…"

#. ID 12, Page 3, Line 216, Pos (12,0)
msgid "だから…\\!私は…"
msgstr "所以…\\!我…"

#. ID 12, Page 3, Line 221, Pos (12,0)
msgid ""
"でも…\\!どうせあいつらは…そんな事して\n"
"くれないっスよ…！！\n"
"\\!最終的にはなすーんさんもどこかに売り\n"
"飛ばされて仕舞いになったはずっス"
msgstr ""
"但是…\\!反正那些家伙是…不会做这种事的啊…！！\n"
"\\!最终娜丝恩小姐也会被卖到什么地方去的"

#. ID 12, Page 3, Line 225, Pos (12,0)
#. ID 24, Page 2, Line 52, Pos (13,0)
msgid "所詮、まやかしっスよ…"
msgstr "终究，都是虚假的…"

#. ID 12, Page 3, Line 230, Pos (12,0)
#. ID 24, Page 2, Line 57, Pos (13,0)
msgid ""
"……\\!それで…\\!私をどうしますか？\n"
"村長さん。お好きなようにしてください。"
msgstr "……\\!那么…\\!你要怎么处置我？村长。请随你喜欢。"

#. ID 12, Page 3, Line 236, Pos (12,0)
#. ID 24, Page 2, Line 63, Pos (13,0)
msgid ""
"別に…\\!どうもしないっスよ。\n"
"むしろなすーんさんがお好きなようにして\n"
"くださいっス。\\!村を出て行くなり、今迄\n"
"のように過ごすなりね。"
msgstr ""
"也没什么…\\!不会怎么样的。\n"
"反倒是娜丝恩小姐请随你喜欢吧。\\!离开村子也好，\n"
"像之前一样生活也好。"

#. ID 12, Page 3, Line 241, Pos (12,0)
#. ID 24, Page 2, Line 68, Pos (13,0)
msgid ""
"ただ…\\!村長として今後貴女に対し\n"
"それなりの警戒をするつもりっスけどね。"
msgstr "只是…\\!作为村长，今后我会对你保持相应的警惕。"

#. ID 12, Page 3, Line 247, Pos (12,0)
#. ID 24, Page 2, Line 74, Pos (13,0)
msgid ""
"………\\!わかりました…ではもう少しだけ\n"
"全て整理し終わったら出て行きますから…\n"
"\\!\\n[\\v[6]]さんにもご迷惑をおかけします\n"
"けど…\\!許してください…"
msgstr ""
"………\\!我明白了…那么等我把所有事情整理完就离开…\n"
"\\!\\n[\\v[6]]小姐也给您添麻烦了…\\!请原谅我…"

#. ID 12, Page 3, Line 255, Pos (12,0)
#. ID 24, Page 2, Line 82, Pos (13,0)
msgid ""
"それじゃ…\\!みんなを助けて村に帰ると\n"
"するっスか…\\!今後の事も考えないといけ\n"
"ないっスからね。"
msgstr ""
"那么…\\!就去救大家回村吧…\n"
"\\!也得考虑今后的打算呢。"

#. ID 18, Page 2, Line 3, Pos (16,3)
#. ID 19, Page 2, Line 3, Pos (11,3)
#. ID 20, Page 2, Line 3, Pos (9,12)
#. ID 22, Page 2, Line 3, Pos (18,8)
msgid "すでに事切れている"
msgstr "已经断气了"

#. ID 24, Page 2, Line 7, Pos (13,0)
msgid ""
"これ以上は無理ね…逃げるしかないわ。\n"
"…これじゃあ大損よ"
msgstr "这样下去不行了…只能逃了。…这样可亏大了"

#. ID 24, Page 2, Line 32, Pos (13,0)
msgid ""
"うう…\n"
"\\n[\\v[6]]さん、助けてくれてあり\n"
"がとうっス…"
msgstr "呜呜…\\n[\\v[6]]小姐，谢谢你救了我…"

#. ID 24, Page 2, Line 35, Pos (13,0)
msgid ""
"オレなら大丈夫ッス。\n"
"少し休めば動けるようになると思うッス"
msgstr "我没事的。休息一会儿应该就能动了"

#. ID 24, Page 2, Line 37, Pos (13,0)
msgid ""
"逃げた連中が懲りてればいいんスが…\n"
"しばらくは要警戒ッスね"
msgstr ""
"逃走的那些家伙要是能吸取教训就好了…\n"
"暂时得保持警惕呢"

#. ID 24, Page 2, Line 48, Pos (13,0)
msgid ""
"なすーんさん…\\!どうせあいつらは…\n"
"愛するなんてしてくれないっスよ…！！\n"
"\\!最終的にはなすーんさんもどこかに売り\n"
"飛ばされて仕舞いになったはずっス"
msgstr ""
"娜丝恩小姐…\\!反正那些家伙是…不会爱你的啊…！！\n"
"\\!最终娜丝恩小姐也会被卖到什么地方去的"

#. ID 25, Page 2, Line 3, Pos (13,29)
msgid "なすーんと村長を放っておくわけにはいかない！"
msgstr "不能放着娜丝恩和村长不管！"
