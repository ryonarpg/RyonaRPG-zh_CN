#. ID 34, Page 2, Line 3, Pos (10,16)
#. Contains choice at line 2 (2 options)
msgid "ここで釣りができそうだ。"
msgstr "这里似乎可以钓鱼。"

#. ID 34, Page 2, Line 10, Pos (10,16)
#. Choice (2 options, embedded in a message)
msgid ""
"釣りをする\n"
"そんな場合ではない！"
msgstr ""
"钓鱼\n"
"现在不是做这种事的时候！"

#. ID 34, Page 2, Line 29, Pos (10,16)
msgid "釣り竿を装備していない。"
msgstr "没有装备钓竿。"

#. ID 34, Page 2, Line 39, Pos (10,16)
msgid "釣りを始めた。"
msgstr "开始钓鱼了。"

#. ID 36, Page 2, Line 3, Pos (31,5)
msgid "クリスタルのかけらを手に入れた。"
msgstr "获得了水晶碎片。"

#. ID 37, Page 2, Line 3, Pos (28,39)
msgid "巨大魚の鱗を手に入れた。"
msgstr "获得了巨鱼鳞。"

#. ID 38, Page 2, Line 3, Pos (44,13)
msgid "毒消しを３個手に入れた。"
msgstr "获得了3个解毒剂。"

#. ID 39, Page 2, Line 3, Pos (32,6)
#. Choice (2 options)
msgid ""
"飛び降りる\n"
"やめておく"
msgstr ""
"跳下去\n"
"算了"

#. ID 57, Page 2, Line 4, Pos (41,6)
msgid ""
"森の小道　→\n"
"街道へ　　↓"
msgstr "森林小路　→通往街道　　↓"

#. ID 58, Page 2, Line 3, Pos (37,13)
msgid "この先の屋敷にいくのかい……？"
msgstr "你要去前面的宅邸吗……？"

#. ID 58, Page 2, Line 4, Pos (37,13)
msgid "オバケ相手に普通の武器や魔法は役に立たないよ……"
msgstr "对付幽灵，普通的武器和魔法可不管用哦……"

#. ID 60, Page 2, Line 4, Pos (5,12)
#. ID 61, Page 2, Line 4, Pos (4,12)
msgid "文字がかすれていて読めない"
msgstr "文字模糊得看不清"
