#. ID 38, Page 2, Line 4, Pos (30,32)
#. ID 48, Page 2, Line 4, Pos (28,32)
#. ID 59, Page 2, Line 4, Pos (35,32)
#. ID 60, Page 2, Line 4, Pos (37,32)
msgid "………"
msgstr "………"

#. ID 38, Page 2, Line 8, Pos (30,32)
#. ID 48, Page 2, Line 8, Pos (28,32)
#. ID 59, Page 2, Line 8, Pos (35,32)
#. ID 60, Page 2, Line 8, Pos (37,32)
msgid ""
"＊自動人形のようだが\n"
"　眠っているようにピクりとも動かない"
msgstr "＊看起来是自动人偶　但像睡着了一样纹丝不动"

#. ID 78, Page 2, Line 3, Pos (7,29)
msgid "＊古びた書物だ……"
msgstr "＊是陈旧的书……"

#. ID 78, Page 2, Line 4, Pos (7,29)
msgid ""
"＊紙はボロボロだが、辛うじて文字は読めるようだ\n"
"　適当に１冊取り、目を走らせる。"
msgstr ""
"＊纸张已破破烂烂，\n"
"　但文字勉强还能读　随手拿起1册，快速浏览。"

#. ID 78, Page 2, Line 10, Pos (7,29)
#. ID 78, Page 2, Line 28, Pos (7,29)
msgid "＊…………"
msgstr "＊…………"

#. ID 78, Page 2, Line 15, Pos (7,29)
msgid "＊「我々の祖国は、もう消えてしまったのだ」"
msgstr "＊「我们的祖国，已经消失了」"

#. ID 78, Page 2, Line 16, Pos (7,29)
msgid ""
"＊「今となっては、もう大地に戻り、\n"
"　　かつての祖国の復興は望むことはできない\n"
"　　君の祖国も、あなたの祖国もだ」"
msgstr ""
"＊「事到如今，已经回到大地，\n"
"　　无法指望复兴曾经的祖国了\n"
"　　你的祖国也好、您的祖国也好」"

#. ID 78, Page 2, Line 19, Pos (7,29)
msgid ""
"＊「もはや人種もかつての国家も関係ない、\n"
"　　手を取り、この新天地を……\n"
"　　理想郷にしていこうではないか！」"
msgstr ""
"＊「如今已无关人种，也无关昔日的国家，\n"
"　　携手吧，把这个新天地……\n"
"　　变成理想乡吧！」"

#. ID 78, Page 2, Line 22, Pos (7,29)
msgid ""
"＊………年……日\n"
"　初代にして最後の指導者　ヴォルテールの演説"
msgstr ""
"＊………年……\n"
"　日　初代且最后的指导者　沃尔泰尔的演说"
