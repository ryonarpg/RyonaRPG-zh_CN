#. ID 14, Page 2, Line 3, Pos (5,12)
#. ID 19, Page 2, Line 3, Pos (6,5)
msgid "…"
msgstr "…"

#. ID 15, Page 2, Line 3, Pos (17,15)
msgid "ぅぐっ……ん゛っ、ぶっ……げひっ……"
msgstr "唔咕……嗯゛、噗……呃嘿……"

#. ID 15, Page 2, Line 4, Pos (17,15)
msgid "じゅ……はぁ……ぴちゃ……"
msgstr "啾……哈啊……啪嗒……"

#. ID 16, Page 2, Line 3, Pos (18,15)
msgid ""
"ほらほらぁ、どうしたのかなぁ？\n"
"全然物足んないよぉぉん？？"
msgstr ""
"来吧来吧，怎么了呀？\n"
"完全不够满足哦哦？？"

#. ID 16, Page 2, Line 5, Pos (18,15)
msgid ""
"また便器やりたいのかなぁ？？\n"
"そんなに糞の味が気に入ったかよ？\n"
"いくらでも食わせてあげますよぉ？？？"
msgstr ""
"又想当便器了吗？？\n"
"就那么喜欢粪的味道吗？\n"
"要多少我都让你吃哦？？？"

#. ID 17, Page 2, Line 3, Pos (3,13)
msgid "…意識を失っているようだ。"
msgstr "…似乎失去了意识。"

#. ID 20, Page 2, Line 2, Pos (3,5)
msgid "そうね…\\.…\\.…\\.例えば……"
msgstr "是啊…\\.…\\.…\\.比如说……"

#. ID 20, Page 2, Line 4, Pos (3,5)
msgid ""
"高級娼婦には、娼婦としての能力以前に、\n"
"女としての魅力も強く求められるわ。"
msgstr ""
"对高级娼妇来说，在作为娼妇的能力之前，\n"
"也会被强烈要求具备作为女人的魅力。"

#. ID 20, Page 2, Line 6, Pos (3,5)
msgid "自分を磨くのもいいんじゃないかしら？"
msgstr "打磨一下自己也不错吧？"

#. ID 20, Page 2, Line 10, Pos (3,5)
msgid ""
"一流の娼婦に求められるのは、美しさと、\n"
"何よりも淫らさなの。"
msgstr ""
"一流娼妇被要求的是美丽，以及，\n"
"比什么都重要的是淫荡。"

#. ID 20, Page 2, Line 12, Pos (3,5)
msgid ""
"エッチが好きで好きでたまらない、\n"
"いやらしい心とカラダを持った\n"
"女の子だけが、高級娼婦になれるのよ。"
msgstr ""
"喜欢做爱喜欢得不得了、\n"
"拥有淫荡的心和身体\n"
"只有女孩子才能成为高级娼妇哦。"

#. ID 20, Page 2, Line 15, Pos (3,5)
msgid ""
"あなたは、娼婦としては、まだ\n"
"少し清らかすぎるのね。"
msgstr ""
"你作为娼妇，还\n"
"稍微太过清纯了呢。"

#. ID 20, Page 2, Line 20, Pos (3,5)
msgid ""
"寄付金自体は、どんな手段で稼いできても\n"
"いいのだけど…"
msgstr ""
"捐款本身，不管用什么手段赚来\n"
"都可以，不过……"

#. ID 20, Page 2, Line 22, Pos (3,5)
msgid ""
"お客さんの評価って言うものは\n"
"実際にお仕事をしないと\n"
"得られないものだからね…"
msgstr ""
"所谓客人的评价\n"
"如果不实际工作\n"
"是得不到的嘛……"

#. ID 20, Page 2, Line 25, Pos (3,5)
msgid ""
"お仕事をして、要求の厳しいお客さんに\n"
"認めてもらうことも、\n"
"昇級には必要なことよ。"
msgstr ""
"工作之后，被要求严格的客人\n"
"认可，也是\n"
"升级所必需的哦。"

#. ID 20, Page 2, Line 31, Pos (3,5)
msgid "お仕事の経験がまだ少し足りないかしら。"
msgstr "工作经验还稍微有点不足吧。"

#. ID 20, Page 2, Line 32, Pos (3,5)
msgid ""
"もっと頑張って、色んなお客さんから\n"
"可愛がってもらわないとね？"
msgstr ""
"再努力一点，从各种客人那里\n"
"得让他们疼爱你才行呢？"

#. ID 20, Page 3, Line 4, Pos (3,5)
#. ID 20, Page 4, Line 4, Pos (3,5)
msgid "あらあら…かわいいお客さん。"
msgstr "哎呀哎呀……可爱的小客人。"

#. ID 20, Page 3, Line 5, Pos (3,5)
#. ID 20, Page 4, Line 5, Pos (3,5)
msgid "どうしたの？迷子にでもなったのかしら？"
msgstr "怎么了？难道是迷路了吗？"

#. ID 20, Page 4, Line 8, Pos (3,5)
#. ID 20, Page 4, Line 24, Pos (3,5)
#. ID 20, Page 4, Line 124, Pos (3,5)
msgid "…噂を聞いてきたですって？"
msgstr "……听说是听到传闻来的？"

#. ID 20, Page 4, Line 9, Pos (3,5)
msgid "\\.うぅん…\\."
msgstr "\\.唔嗯……\\."

#. ID 20, Page 4, Line 11, Pos (3,5)
msgid ""
"駄目、駄目よ。どんなに\n"
"素質があったって、そんな気持ち悪いの\n"
"身体につけてるような子は駄目！"
msgstr ""
"不行，不行哦。不管多么\n"
"有素质，那种恶心的东西\n"
"弄在身上的孩子也不行！"

#. ID 20, Page 4, Line 14, Pos (3,5)
msgid ""
"他のお客さんの迷惑にもなるし、\n"
"帰ってちょうだい。"
msgstr ""
"也会给其他客人添麻烦，\n"
"请回去吧。"

#. ID 20, Page 4, Line 26, Pos (3,5)
msgid ""
"\\.ふぅん…\\.なるほどね、いいでしょう。\n"
"素質はあるみたいだから。"
msgstr ""
"\\.呼嗯……\\.原来如此，好吧。\n"
"看来是有素质的。"

#. ID 20, Page 4, Line 28, Pos (3,5)
msgid ""
"とはいっても、組合もボランティアで\n"
"やってる訳じゃないのよね。"
msgstr ""
"话虽如此，公会也不是靠志愿者\n"
"运作的嘛。"

#. ID 20, Page 4, Line 30, Pos (3,5)
msgid ""
"加入には寄付金500Ｇ\\$が必要なんだけど、\n"
"大丈夫かしら？"
msgstr ""
"加入需要捐款500G\\$，不过，\n"
"没问题吧？"

#. ID 20, Page 4, Line 36, Pos (3,5)
msgid ""
"駄目みたいね。ま、お金のない子も\n"
"沢山いるからね。\n"
"貸しってことにしてあげるわ。"
msgstr ""
"好像不行呢。嘛，没钱的孩子也\n"
"有很多嘛。\n"
"就当作是借给你的吧。"

#. ID 20, Page 4, Line 40, Pos (3,5)
msgid ""
"でも、500Ｇちゃんと払うまでは、\n"
"娼婦としては最底辺の等級のままだから、\n"
"頑張って返してね？"
msgstr ""
"但是，在好好付清500G之前，\n"
"作为娼妇仍是最低等级，所以，\n"
"努力还钱哦？"

#. ID 20, Page 4, Line 47, Pos (3,5)
#. ID 20, Page 4, Line 81, Pos (3,5)
msgid ""
"じゃあ、これを渡すから。\n"
"大事に持っているのよ？"
msgstr ""
"那么，这个就交给你。\n"
"要好好保管哦？"

#. ID 20, Page 4, Line 53, Pos (3,5)
#. ID 20, Page 4, Line 87, Pos (3,5)
msgid ""
"\n"
"娼婦の鑑札を手に入れた。"
msgstr ""
"\n"
"获得了娼妇的执照。"

#. ID 20, Page 4, Line 58, Pos (3,5)
msgid "あなたの娼婦としての等級は最底辺の黒。"
msgstr "你作为娼妇的等级是最低级的黑。"

#. ID 20, Page 4, Line 59, Pos (3,5)
#. ID 20, Page 4, Line 94, Pos (3,5)
msgid ""
"裏通りでしか娼婦として活動できないし、\n"
"お仕事自体も\n"
"一日に４回しか許されないわ。"
msgstr ""
"只能在后巷作为娼妇活动，\n"
"工作本身也\n"
"一天只允许4次。"

#. ID 20, Page 4, Line 63, Pos (3,5)
msgid ""
"それに、黒等級の子がお客さんに\n"
"どんなに酷いことをされたとしても、\n"
"私たち組合員は何もしないわ。"
msgstr ""
"而且，黑等级的孩子被客人\n"
"无论被做了多么过分的事，\n"
"我们公会成员什么都不会做。"

#. ID 20, Page 4, Line 66, Pos (3,5)
msgid ""
"お客さんもそれを理解しているし、\n"
"酷い要求もされるでしょうから、\n"
"十分に気をつけてね？"
msgstr ""
"客人也明白这一点，\n"
"所以也会被提出过分的要求，\n"
"要十分小心哦？"

#. ID 20, Page 4, Line 69, Pos (3,5)
#. ID 20, Page 4, Line 97, Pos (3,5)
msgid ""
"それに、許可されていない場所…\n"
"例えばレイオンの表通りとか…"
msgstr ""
"还有，未被允许的场所……\n"
"比如雷昂的大街之类……"

#. ID 20, Page 4, Line 71, Pos (3,5)
#. ID 20, Page 4, Line 99, Pos (3,5)
msgid ""
"そういった場所でお仕事をしてしまったら、\n"
"当然制裁があるから。\n"
"注意してお仕事してね？"
msgstr ""
"如果在那样的地方工作了，\n"
"当然会有制裁。\n"
"工作时要小心哦？"

#. ID 20, Page 4, Line 92, Pos (3,5)
msgid ""
"あなたの娼婦としての等級は\n"
"最低から２番目の錫。"
msgstr ""
"你作为娼妇的等级是\n"
"从最低数第二的锡。"

#. ID 20, Page 4, Line 105, Pos (3,5)
msgid ""
"あと、お仕事で稼いだお金の２割は、\n"
"組合の方に納めてもらうことになるわ。"
msgstr ""
"另外，工作中赚到的钱的2成，\n"
"要上交给公会。"

#. ID 20, Page 4, Line 107, Pos (3,5)
msgid ""
"苦しいかもしれないけれど、\n"
"組織を運営するためには必要なお金なの。\n"
"理解してもらえるわね？"
msgstr ""
"可能会有些辛苦，\n"
"但这是运营组织所需的钱。\n"
"你能理解吧？"

#. ID 20, Page 4, Line 111, Pos (3,5)
msgid ""
"じゃ、これからは\n"
"ご同業ということになるわね。\n"
"どうぞよろしくね……"
msgstr ""
"那么，从今以后\n"
"我们就是同行了呢。\n"
"请多关照……"

#. ID 20, Page 4, Line 125, Pos (3,5)
msgid "\\.ふぅん…\\.でも、駄目ね。"
msgstr "\\.呼嗯……\\.但是，不行呢。"

#. ID 20, Page 4, Line 127, Pos (3,5)
msgid ""
"あなた、娼婦としては華がないわ…\n"
"組合の評判にも関わるから、駄目な子は\n"
"入れられないのよね。"
msgstr ""
"你作为娼妇没有光彩……\n"
"也关系到公会的名声，所以不行的孩子\n"
"不能收进来呢。"

#. ID 20, Page 4, Line 131, Pos (3,5)
msgid ""
"ごめんなさいね。\n"
"でも、貴方にはもっと\n"
"相応しいお仕事があるはずだわ。"
msgstr ""
"对不起哦。\n"
"但是，你会有更\n"
"适合的工作吧。"

#. ID 20, Page 4, Line 134, Pos (3,5)
msgid ""
"じゃあ、さようなら。\\.酒場には\n"
"悪いお客さんもいらっしゃるから、\n"
"気をつけて帰ってね。"
msgstr ""
"那么，再见。\\.酒馆里\n"
"也有坏客人，所以，\n"
"回去时小心哦。"

#. ID 20, Page 5, Line 5, Pos (3,5)
msgid ""
"あら、\\N[\\V[6]]じゃない。\n"
"ごきげんよう。調子はいかが？"
msgstr ""
"哎呀，不是\\N[\\V[6]]吗。\n"
"你好。身体怎么样？"

#. ID 20, Page 5, Line 9, Pos (3,5)
msgid ""
"あら…ごきげんよう。\n"
"調子はいかが？"
msgstr ""
"哎呀……你好。\n"
"身体怎么样？"

#. ID 20, Page 5, Line 14, Pos (3,5)
#. Choice (4 options)
msgid ""
"お話する\n"
"組合に寄付する\n"
"現在の状態\n"
"昇級審査"
msgstr ""
"交谈\n"
"向公会捐款\n"
"当前状态\n"
"升级审查"

#. ID 20, Page 5, Line 16, Pos (3,5)
#. Choice (2 options)
msgid ""
"アドバイス\n"
"他愛も無い話"
msgstr ""
"建议\n"
"闲聊"

#. ID 20, Page 5, Line 20, Pos (3,5)
msgid ""
"当然のことだけど、着ている服や\n"
"アクセサリーによって、あなたの魅力は\n"
"変化するわ。"
msgstr ""
"当然，根据你穿的衣服和饰品，\n"
"你的魅力会发生变化哦。"

#. ID 20, Page 5, Line 23, Pos (3,5)
msgid ""
"女としての魅力が高いほど、お客さんの\n"
"評価も高くなるから、自分を磨くのも\n"
"娼婦には大切なことよ。"
msgstr ""
"作为女性的魅力越高，客人的评价也会越高，\n"
"所以打磨自己对娼妇来说也很重要哦。"

#. ID 20, Page 5, Line 29, Pos (3,5)
msgid ""
"お客さんが娼婦にすごく満足すると、\n"
"時々プレゼントをくれるの。"
msgstr "客人对娼妇非常满意时，有时会送礼物哦。"

#. ID 20, Page 5, Line 31, Pos (3,5)
msgid ""
"プレゼントの種類はお客さんによって\n"
"当然違うから、"
msgstr "礼物的种类当然会因客人而异，所以"

#. ID 20, Page 5, Line 33, Pos (3,5)
msgid ""
"欲しいものをくれる人がいたら、\n"
"その人にい～っぱい\n"
"可愛がってもらうといいわ。"
msgstr ""
"如果有人愿意给你想要的东西，\n"
"就让他多多疼爱你吧。"

#. ID 20, Page 5, Line 39, Pos (3,5)
msgid ""
"お客さんたちは、基本的に\n"
"不感症の女は嫌いなの。"
msgstr "客人们基本上讨厌性冷淡的女人。"

#. ID 20, Page 5, Line 41, Pos (3,5)
msgid ""
"お客さんが１回出す間に、何回も\n"
"イっちゃうようないやらしい女の子\n"
"じゃないと、娼婦は難しいかもね？"
msgstr ""
"如果不是那种在客人射一次期间能高潮好几次的淫荡\n"
"女孩，做娼妇可能很难哦？"

#. ID 20, Page 5, Line 48, Pos (3,5)
#. ID 20, Page 6, Line 8, Pos (3,5)
msgid "うふふ。"
msgstr "呵呵。"

#. ID 20, Page 5, Line 51, Pos (3,5)
msgid "しばし談笑した。"
msgstr "闲聊了一会儿。"

#. ID 20, Page 5, Line 61, Pos (3,5)
msgid ""
"\n"
"\\$いくら寄付しますか？"
msgstr "\\$你要捐多少钱？"

#. ID 20, Page 5, Line 73, Pos (3,5)
msgid "ありがとう。助かるわ。"
msgstr "谢谢。帮大忙了。"

#. ID 20, Page 5, Line 74, Pos (3,5)
msgid ""
"\n"
"現在の寄付額　\\V[1174]Ｇ"
msgstr "当前捐款额　\\V[1174]G"

#. ID 20, Page 5, Line 78, Pos (3,5)
msgid ""
"ん、おめでとう。500Ｇ確かに頂いたわ。\n"
"これであなたも正式な組合員ね。"
msgstr ""
"嗯，恭喜。500G确实收到了。\n"
"这样你也是正式会员了。"

#. ID 20, Page 5, Line 80, Pos (3,5)
msgid "改めて、よろしくね？"
msgstr "再次请多关照哦？"

#. ID 20, Page 5, Line 85, Pos (3,5)
msgid ""
"\n"
"娼婦等級が黒から錫になった。"
msgstr "娼妇等级从黑变成了锡。"

#. ID 20, Page 5, Line 90, Pos (3,5)
msgid ""
"とはいっても、組合員として認められる\n"
"ぎりぎりのラインでしかないから、\n"
"お客さんも\n"
"あまり気を使ってはくれないけどね。"
msgstr ""
"话虽如此，这只是被认可为会员的最低线，\n"
"所以客人也不会太客气哦。"

#. ID 20, Page 5, Line 94, Pos (3,5)
msgid ""
"一日にお仕事できる回数が\n"
"４回に増えたから、頑張ってお仕事して\n"
"早く等級を上げてね？"
msgstr ""
"一天能工作的次数增加到4次了，所以要努力工作，\n"
"尽快提升等级哦？"

#. ID 20, Page 5, Line 105, Pos (3,5)
msgid ""
"あらあら、よく頑張ったわね。\n"
"おめでとう。\n"
"5000Ｇも集めるのは大変だったでしょう？"
msgstr ""
"哎呀哎呀，你很努力呢。恭喜。\n"
"攒到5000G也很不容易吧？"

#. ID 20, Page 5, Line 108, Pos (3,5)
msgid ""
"後は娼婦としての能力を磨いて、\n"
"審査を受けるだけね。頑張ってね♪"
msgstr ""
"接下来只要磨练作为娼妇的能力，\n"
"接受审查就可以了。加油哦♪"

#. ID 20, Page 5, Line 120, Pos (3,5)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "黒"
msgstr "黑"

#. ID 20, Page 5, Line 125, Pos (3,5)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "錫"
msgstr "锡"

#. ID 20, Page 5, Line 130, Pos (3,5)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "銅"
msgstr "铜"

#. ID 20, Page 5, Line 135, Pos (3,5)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "銀"
msgstr "银"

#. ID 20, Page 5, Line 139, Pos (3,5)
msgid ""
"娼婦等級　　　\\N[101]\n"
"売春可能回数　\\V[1176]/\\V[1177]\n"
"最低報酬額　　\\V[1164]Ｇ"
msgstr ""
"娼妇等级　　　\\N[101]可卖淫次数　\\V[1176]/\\V[1177]\n"
"最低报酬额　　\\V[1164]G"

#. ID 20, Page 5, Line 143, Pos (3,5)
msgid "レイオンの裏通りでのみ売春可能。"
msgstr "仅可在雷翁的后巷卖淫。"

#. ID 20, Page 5, Line 147, Pos (3,5)
msgid "レイオン全域で売春可能。"
msgstr "可在雷翁全境卖淫。"

#. ID 20, Page 5, Line 151, Pos (3,5)
msgid "西大陸のほぼ全域で売春可能。"
msgstr "可在西大陆几乎全境卖淫。"

#. ID 20, Page 5, Line 159, Pos (3,5)
msgid ""
"…まずは500Ｇ納めてからね。\n"
"それからじゃないと、お話にならないわ。"
msgstr "…首先得先交500G。不先交的话，可没法谈哦。"

#. ID 20, Page 5, Line 170, Pos (3,5)
msgid ""
"うーん…\\.…\\.いいでしょう。\n"
"あなたの事は、\n"
"影で調べさせてもらったわ。"
msgstr "嗯…\\.…\\.好吧。你的事，我已经让人暗中调查过了。"

#. ID 20, Page 5, Line 175, Pos (3,5)
msgid ""
"銅等級の娼婦としての条件を\n"
"満たしていると評価するわ。\n"
"おめでとう♪"
msgstr "我评价你满足铜等级娼妇的条件。恭喜♪"

#. ID 20, Page 5, Line 178, Pos (3,5)
msgid ""
"これで、あなたも銅等級。\n"
"一人前の娼婦の仲間入りね。"
msgstr ""
"这样你也是铜等级了。\n"
"算是加入独当一面的娼妇行列了。"

#. ID 20, Page 5, Line 184, Pos (3,5)
msgid ""
"\n"
"娼婦等級が錫から銅になった。"
msgstr "娼妇等级从锡变成了铜。"

#. ID 20, Page 5, Line 189, Pos (3,5)
msgid ""
"これからは、レイオンの表通りでも\n"
"お仕事ができるようになるわよ。"
msgstr "今后也可以在雷翁的表街工作了哦。"

#. ID 20, Page 5, Line 191, Pos (3,5)
msgid ""
"それに、一日にお仕事できる回数も\n"
"５回に増えるわ。\n"
"生活も楽になるんじゃないかしら？"
msgstr ""
"而且，一天能工作的次数也增加到5次了。\n"
"生活也会变得轻松吧？"

#. ID 20, Page 5, Line 194, Pos (3,5)
msgid ""
"表通りにも、\n"
"面白いお客さんがいっぱいいるから、\n"
"楽しんでお仕事してきてね♪"
msgstr ""
"表街上也有很多有趣的客人，\n"
"所以要开心地去工作哦♪"

#. ID 20, Page 5, Line 210, Pos (3,5)
#. ID 20, Page 5, Line 281, Pos (3,5)
#. ID 20, Page 5, Line 359, Pos (3,5)
msgid ""
"寄付額が足りないわね。\n"
"もうちょっとだけ、\n"
"頑張って稼いできてね♪"
msgstr "捐款额不够呢。再加把劲多赚一点来吧♪"

#. ID 20, Page 5, Line 217, Pos (3,5)
#. ID 20, Page 5, Line 288, Pos (3,5)
msgid ""
"うーん…\\.…\\.ちょっと、駄目ねぇ。\n"
"あなたの事は、\n"
"影で調べさせてもらったけど……"
msgstr ""
"嗯…\\.…\\.有点不行呢。你的事，\n"
"我虽然让人暗中调查过了……"

#. ID 20, Page 5, Line 221, Pos (3,5)
msgid ""
"銅等級の娼婦としては、難しいわね。\n"
"残念ね。"
msgstr "作为铜等级娼妇，有些困难呢。真遗憾。"

#. ID 20, Page 5, Line 223, Pos (3,5)
#. ID 20, Page 5, Line 302, Pos (3,5)
msgid ""
"寄付額の条件は満たしているから、\n"
"娼婦としてのお仕事をもっと頑張って、\n"
"実力をつけるしかないわね。"
msgstr ""
"捐款额的条件已经满足了，\n"
"所以只能更努力地做娼妇工作，提升实力了呢。"

#. ID 20, Page 5, Line 241, Pos (3,5)
msgid ""
"うーん…\\.…\\.そうね。いいでしょう。\n"
"あなたの事は、\n"
"影で調べさせてもらったわ。"
msgstr ""
"嗯…\\.…\\.是啊。好吧。你的事，\n"
"我已经让人暗中调查过了。"

#. ID 20, Page 5, Line 246, Pos (3,5)
msgid ""
"銀等級の娼婦としての条件を\n"
"満たしていると評価するわ。\n"
"おめでとう♪"
msgstr "我评价你满足银等级娼妇的条件。恭喜♪"

#. ID 20, Page 5, Line 249, Pos (3,5)
msgid ""
"これで、あなたも銀等級。\n"
"つまり、高級娼婦の仲間入りね。"
msgstr ""
"这样你也是银等级了。也就是说，\n"
"加入高级娼妇的行列了。"

#. ID 20, Page 5, Line 255, Pos (3,5)
msgid ""
"\n"
"娼婦等級が銅から銀になった。"
msgstr "娼妇等级从铜变成了银。"

#. ID 20, Page 5, Line 260, Pos (3,5)
msgid ""
"これからは、都市部…\n"
"アバロソやメルベルでも\n"
"お仕事ができるようになるわよ。"
msgstr ""
"今后在城市地区……\n"
"阿巴罗索和梅尔贝尔也能工作了哦。"

#. ID 20, Page 5, Line 263, Pos (3,5)
msgid ""
"あなたは、レイオンから外に出しても\n"
"恥ずかしくない…"
msgstr "你就算从雷翁走出去也不会丢脸……"

#. ID 20, Page 5, Line 265, Pos (3,5)
msgid ""
"立派な一人前の娼婦として\n"
"認められたということよ。\n"
"本当におめでとう。"
msgstr ""
"也就是说，\n"
"你被认可为一名出色的独当一面的娼妇了。\n"
"真的恭喜你。"

#. ID 20, Page 5, Line 292, Pos (3,5)
msgid ""
"銀等級の娼婦としては、難しいわね。\n"
"残念ね。"
msgstr "作为银等级娼妇，有些困难呢。真遗憾。"

#. ID 20, Page 5, Line 295, Pos (3,5)
msgid ""
"銀等級から、いわゆる高級娼婦のラインに\n"
"入るの。"
msgstr "从银等级开始，就进入所谓高级娼妇的行列了。"

#. ID 20, Page 5, Line 297, Pos (3,5)
msgid ""
"それだけ審査も厳しくなるから、\n"
"ほとんどの子は\n"
"銅止まりで満足しちゃうわ。"
msgstr ""
"相应地审查也会更严格，\n"
"所以大多数女孩到铜等级就满足了。"

#. ID 20, Page 5, Line 300, Pos (3,5)
msgid ""
"でも、あなた、審査を受けるってことは、\n"
"銅では満足していないんでしょ？"
msgstr "但是，你会接受审查，说明你不满足于铜等级吧？"

#. ID 20, Page 5, Line 320, Pos (3,5)
msgid ""
"うーん…\\.…\\.素晴らしいわ……\n"
"よくここまで頑張ったわね…"
msgstr "嗯…\\.…\\.太出色了……你能努力到这里真了不起…"

#. ID 20, Page 5, Line 324, Pos (3,5)
msgid ""
"おめでとう♪\n"
"金等級の娼婦としての条件を\n"
"満たしていると評価するわ。"
msgstr "恭喜♪我评价你满足金等级娼妇的条件。"

#. ID 20, Page 5, Line 327, Pos (3,5)
msgid ""
"これで、あなたは誰からも認められる\n"
"本物の高級娼婦になったということよ。"
msgstr "这样，你就成了任何人都认可的真正的高级娼妇。"

#. ID 20, Page 5, Line 333, Pos (3,5)
msgid ""
"\n"
"娼婦等級が銀から金になった。"
msgstr "娼妇等级从银变成了金。"

#. ID 20, Page 5, Line 338, Pos (3,5)
msgid ""
"金等級は、自分の望む限り、\n"
"どんな場所でもお仕事ができるわ…"
msgstr "金等级的话，只要自己愿意，在任何地方都能工作……"

#. ID 20, Page 5, Line 340, Pos (3,5)
msgid ""
"あなたは、もう組合を代表する\n"
"とても優秀で、\n"
"とても大切な娼婦。"
msgstr "你已经是代表公会的非常优秀、非常重要的娼妇。"

#. ID 20, Page 5, Line 343, Pos (3,5)
msgid ""
"組合も、あなたのことを\n"
"全力で保護するわ。\n"
"うふふ。もう生活は安泰ね？"
msgstr "公会也会全力保护你。呵呵。生活已经安稳了吧？"

#. ID 20, Page 5, Line 366, Pos (3,5)
msgid ""
"うーん…\\.…\\.残念ね。金としての資格は\n"
"認められないわ。"
msgstr "嗯…\\.…\\.真遗憾。不能认可你作为金的资格。"

#. ID 20, Page 5, Line 369, Pos (3,5)
msgid ""
"金等級の審査は、とても厳しいの。\n"
"この広い西大陸でも、年に十数人しか\n"
"金等級には上がれないわ。"
msgstr ""
"金等级的审查非常严格。在这广阔的西大陆上，\n"
"一年也只有十几个人能升到金等级。"

#. ID 20, Page 5, Line 372, Pos (3,5)
msgid ""
"銀等級でも、生活していくには十分だし、\n"
"あなたのことを贔屓にしてくれる\n"
"常連さんだってもういっぱい\n"
"いるんでしょう？"
msgstr ""
"银等级也足够生活了，\n"
"而且已经有好多常客偏爱你了吧？"

#. ID 20, Page 5, Line 377, Pos (3,5)
msgid ""
"……でも、あなた、\n"
"やっぱりそれじゃ駄目なのね。"
msgstr "……但是，你果然还是不满足于此呢。"

#. ID 20, Page 5, Line 379, Pos (3,5)
msgid ""
"うふふ、組合としても、\n"
"金等級の優秀な娼婦が\n"
"増えることに不満はないわ。"
msgstr "呵呵，公会也不介意增加优秀的金等级娼妇哦。"

#. ID 20, Page 5, Line 382, Pos (3,5)
msgid ""
"私としても、出来る限り\n"
"アドバイスはするから、もっともっと\n"
"頑張って、早く金に上がってね♪"
msgstr ""
"我也会尽可能给你建议，所以要更加更加努力，\n"
"早日升到金等级哦♪"

#. ID 20, Page 6, Line 4, Pos (3,5)
msgid ""
"あらあら…奴隷の子が\n"
"こんな所に何のご用かしら？"
msgstr "哎呀哎呀……奴隶的孩子来这种地方有什么事呢？"

#. ID 20, Page 6, Line 9, Pos (3,5)
msgid ""
"ごきげんよう。\\N[\\V[6]]。\n"
"お痛しちゃったみたいね？"
msgstr "你好。\\N[\\V[6]]。好像被弄疼了呢？"

#. ID 20, Page 6, Line 11, Pos (3,5)
#. ID 20, Page 6, Line 124, Pos (3,5)
msgid ""
"それとも、自分から進んで\n"
"そうなったのかしら？\n"
"うふふ。"
msgstr "还是说，是你自己主动变成这样的呢？呵呵。"

#. ID 20, Page 6, Line 14, Pos (3,5)
#. Choice (2 options)
msgid ""
"冗談がきつい…\n"
"実はそうなんです…\\c[11]$k"
msgstr ""
"玩笑开得太过了…\n"
"其实是这样…\\c[11]$k"

#. ID 20, Page 6, Line 17, Pos (3,5)
msgid ""
"あらあら、ごめんなさい。\n"
"本当に困っていたのね。"
msgstr "哎呀哎呀，对不起。你真的遇到困难了呢。"

#. ID 20, Page 6, Line 20, Pos (3,5)
msgid ""
"そうね…あなたはそれなりに価値のある\n"
"娼婦だし、首輪を外してあげることも\n"
"できるわ。"
msgstr ""
"是啊…你算是相当有价值的娼妇，\n"
"我也可以帮你把项圈取下来哦。"

#. ID 20, Page 6, Line 23, Pos (3,5)
msgid ""
"首輪には、組合も関わって\n"
"いるものね？"
msgstr "项圈的事，公会也有参与吧？"

#. ID 20, Page 6, Line 25, Pos (3,5)
msgid ""
"とは言っても、タダというのは\n"
"流石に無理なの。外すのはそれなりに\n"
"コストがかかるから。"
msgstr ""
"话虽如此，免费果然还是不行。\n"
"取下来也是要花相应成本的。"

#. ID 20, Page 6, Line 29, Pos (3,5)
msgid ""
"というわけで、5000Ｇ\n"
"用意してちょうだい。授業料みたいな\n"
"ものよ。"
msgstr "所以，请准备好5000G。就当是学费吧。"

#. ID 20, Page 6, Line 33, Pos (3,5)
msgid ""
"5000Ｇぽっちで外せるなら\n"
"安いものよね？他の奴隷の子たちが\n"
"かわいそうになるわ…うふふふ。"
msgstr ""
"要是区区5000G就能取下来，那可真便宜呢？\n"
"其他奴隶孩子可就可怜了…呵呵呵呵。"

#. ID 20, Page 6, Line 36, Pos (3,5)
#. Choice (2 options)
msgid ""
"外す\n"
"いいえ"
msgstr ""
"取下\n"
"不"

#. ID 20, Page 6, Line 40, Pos (3,5)
msgid "あらあら、お金が足りないわ。"
msgstr "哎呀哎呀，钱不够呢。"

#. ID 20, Page 6, Line 42, Pos (3,5)
msgid ""
"うふふ、困ったわね？これじゃ\n"
"首輪が外せないわ？一生、汚い奴隷の\n"
"ままかもね…？"
msgstr ""
"呵呵，为难了吧？这样可摘不下项圈哦？\n"
"也许一辈子都要当肮脏的奴隶了呢…？"

#. ID 20, Page 6, Line 45, Pos (3,5)
msgid "うふふふふふ…"
msgstr "呵呵呵呵呵呵…"

#. ID 20, Page 6, Line 51, Pos (3,5)
msgid ""
"はい、確かに5000Ｇあるわね。\n"
"じゃ、首輪を外してあげる…"
msgstr "好，确实有5000G呢。那么，我就帮你把项圈取下来…"

#. ID 20, Page 6, Line 60, Pos (3,5)
msgid ""
"呪いの首輪は、今までの苦労は\n"
"何だったと思うくらい、あっけなく外れた。"
msgstr ""
"诅咒项圈让人不禁觉得以前的辛苦究竟算什么，\n"
"就那么轻易地取了下来。"

#. ID 20, Page 6, Line 62, Pos (3,5)
msgid ""
"首の開放感と共に、\\n[\\v[6]]は\n"
"自分がようやく自由になれたことを実感した。"
msgstr ""
"伴随着脖子上的解放感，\n"
"\\n[\\v[6]]切实感受到自己终于获得了自由。"

#. ID 20, Page 6, Line 86, Pos (3,5)
msgid ""
"首輪は回収しておくわね。\n"
"後でまた使うから。"
msgstr "项圈我就回收了。因为之后还会再用。"

#. ID 20, Page 6, Line 90, Pos (3,5)
msgid "首輪を渡した。"
msgstr "交出了项圈。"

#. ID 20, Page 6, Line 94, Pos (3,5)
msgid ""
"じゃ、首輪も外れたことだし、\n"
"早くお仕事に戻ってきてね？\n"
"待ってるわ…♪"
msgstr ""
"那么，项圈也取下来了，快点回来工作哦？\n"
"我等着你…♪"

#. ID 20, Page 6, Line 102, Pos (3,5)
msgid "じゃ、頑張って、お金を貯めてきてね…"
msgstr "那么，加油，去攒钱吧…"

#. ID 20, Page 6, Line 108, Pos (3,5)
msgid "まぁ。業が深いわね…"
msgstr "哎呀。真是罪孽深重呢…"

#. ID 20, Page 6, Line 109, Pos (3,5)
msgid ""
"でも、火遊びもほどほどにしないと、\n"
"いつか破滅しちゃうわよ？"
msgstr ""
"不过，玩火也要适可而止，\n"
"不然总有一天会毁灭的哦？"

#. ID 20, Page 6, Line 112, Pos (3,5)
msgid ""
"って、もうとっくに破滅してるかしら？\n"
"うふふ…"
msgstr "说起来，也许早就已经毁灭了吧？呵呵…"

#. ID 20, Page 6, Line 114, Pos (3,5)
msgid ""
"ま、お遊びに飽きたら、いつでも\n"
"相談に乗るわ？じゃ、またね…"
msgstr ""
"嘛，玩腻了的话，随时都可以来找我商量哦？那么，\n"
"再见…"

#. ID 20, Page 6, Line 122, Pos (3,5)
msgid "…もう、お痛しちゃったみたいね？"
msgstr "…看来已经吃了不少苦头呢？"

#. ID 20, Page 6, Line 128, Pos (3,5)
msgid ""
"ま、どちらにせよ、組合としては\n"
"何もしてあげることはできないわ。"
msgstr "嘛，不管怎样，作为公会，我什么也帮不了你。"

#. ID 20, Page 6, Line 130, Pos (3,5)
msgid ""
"錫や銅程度の娼婦のために、わざわざ\n"
"首輪を外してあげるなんて、割りに\n"
"合わないものね。"
msgstr ""
"为了锡级或铜级程度的娼妇，特地帮你取下项圈，\n"
"可不划算呢。"

#. ID 20, Page 6, Line 134, Pos (3,5)
msgid ""
"…そうね、どうしても\n"
"首輪を外したいって言うなら…"
msgstr "…是啊，如果你无论如何都想取下项圈的话…"

#. ID 20, Page 6, Line 136, Pos (3,5)
msgid ""
"レイオン表通りの教会にいるシスターに\n"
"相談してみなさい。"
msgstr "去雷昂表街的教会找修女商量看看吧。"

#. ID 20, Page 6, Line 139, Pos (3,5)
msgid ""
"ま、外せるかどうかは\n"
"わからないけどね…"
msgstr "嘛，不过能不能取下来就不知道了…"

#. ID 21, Page 2, Line 3, Pos (15,10)
msgid ""
"やはりこの街は……コワイ……\n"
"来るたびに命の危険を感じる…よ。"
msgstr ""
"果然这座城市……好可怕……每次来都感到有生命危险…\n"
"啊。"

#. ID 21, Page 3, Line 3, Pos (15,10)
msgid "…君は娼婦なのかい？"
msgstr "…你是娼妇吗？"

#. ID 21, Page 3, Line 4, Pos (15,10)
msgid "いや、いいんだ。私は間に合っているから。"
msgstr "不，不用了。我已经够了。"

#. ID 21, Page 3, Line 5, Pos (15,10)
msgid ""
"しかし、君達も大変だね。こんな\n"
"地獄のような環境で客を取ることから\n"
"スタートだなんて…"
msgstr ""
"不过，你们也很不容易啊。\n"
"居然要从在这种地狱般的环境里接客开始…"

#. ID 21, Page 3, Line 8, Pos (15,10)
msgid ""
"私だったら、とてもじゃないが、\n"
"こんな場所では生きていけそうにもないよ。"
msgstr "要是我的话，实在没法在这种地方活下去啊。"

#. ID 21, Page 4, Line 3, Pos (15,10)
msgid ""
"下級娼婦たちが、裏通り以外での\n"
"仕事を禁じられているのは、監視をしやすくする\n"
"という意味もあるらしいね。"
msgstr ""
"下级娼妇们被禁止在后巷以外的地方工作，\n"
"据说也有便于监视的意味呢。"

#. ID 21, Page 4, Line 6, Pos (15,10)
msgid ""
"娼婦たちは常に…という訳でもないが、\n"
"定期的に監視され、評価される。"
msgstr ""
"娼妇们并不是说总是…不过，\n"
"会定期受到监视和评价。"

#. ID 21, Page 4, Line 8, Pos (15,10)
msgid ""
"組合に忠実で優秀な娼婦だけが、\n"
"昇級を許されるんだそうだ。"
msgstr "据说只有对公会忠诚且优秀的娼妇才被允许升级。"

#. ID 21, Page 4, Line 10, Pos (15,10)
msgid ""
"性奴隷が相手なら、タダでいくらでも\n"
"欲求を満たせる世の中だ。\n"
"そこまでしないと、娼婦はやっていけないのかもね。"
msgstr ""
"如果对象是性奴隶，这世道可以免费任意满足欲望。\n"
"不做到那种地步，娼妇也许就干不下去吧。"

#. ID 22, Page 2, Line 3, Pos (2,7)
msgid ""
"お嬢ちゃん……\n"
"こんな所に一人で来るなんて、\n"
"命…\\.はともかく貞操は惜しくないのかい？"
msgstr ""
"小姑娘……一个人来这种地方，性命…\\.姑且不论，\n"
"贞操就不珍惜吗？"

#. ID 22, Page 3, Line 3, Pos (2,7)
#. ID 22, Page 4, Line 3, Pos (2,7)
msgid ""
"お嬢ちゃん……\n"
"やっぱり貞操は惜しくなかったんだね。"
msgstr "小姑娘……果然还是并不珍惜贞操呢。"

#. ID 22, Page 3, Line 5, Pos (2,7)
msgid ""
"下級娼婦は人間扱いなんかされないからさ、\n"
"はやいとこ足洗った方がいいよ？"
msgstr ""
"下级娼妇根本不会被当人看待，\n"
"所以还是早点洗手不干比较好哦？"

#. ID 22, Page 5, Line 3, Pos (2,7)
msgid ""
"焔さんは何だかんだで怖い人だよねぇ。\n"
"ま、そこがいいんだけどさ。"
msgstr ""
"焰小姐说到底是个可怕的人呢。嘛，\n"
"不过那也正是她的好处啦。"

#. ID 23, Page 2, Line 3, Pos (6,7)
#. ID 28, Page 2, Line 3, Pos (8,4)
#. ID 28, Page 3, Line 3, Pos (8,4)
msgid "……"
msgstr "……"

#. ID 23, Page 3, Line 3, Pos (6,7)
msgid "……ふむ…"
msgstr "……嗯…"

#. ID 23, Page 3, Line 39, Pos (6,7)
msgid ""
"……おお！すばらしい！まさに理想だ！\n"
"君のようなコを捜していたんだよ。\n"
"いやぁ…裏通りも捨てたものじゃないね。"
msgstr ""
"……哦哦！太棒了！正是理想型！\n"
"我一直在找像你这样的女孩啊。哎呀…\n"
"后巷也不是没有可取之处呢。"

#. ID 23, Page 3, Line 42, Pos (6,7)
#. ID 23, Page 3, Line 50, Pos (6,7)
msgid ""
"どうかね？金はそれなりに用意した\n"
"つもりだが…"
msgstr "怎么样？我自认为准备了相应的钱…"

#. ID 23, Page 3, Line 47, Pos (6,7)
msgid ""
"おおっ？うん、うん、いいね。その美しさ、\n"
"いやらしさ。そして匂い立つマゾの香り。\n"
"君のようなコを捜していたんだ。"
msgstr ""
"哦哦？嗯，嗯，不错。那份美丽、那种淫荡。\n"
"还有散发出来的受虐狂气息。\n"
"我一直在找像你这样的女孩。"

#. ID 23, Page 3, Line 55, Pos (6,7)
msgid ""
"うむ、及第点といった所か…\n"
"君は娼婦だろう？どうかね、私と一晩\n"
"過ごしてみる気はないかな？"
msgstr ""
"嗯，算是及格水平吧…你是娼妇吧？怎么样，\n"
"要不要和我共度一晚？"

#. ID 23, Page 3, Line 61, Pos (6,7)
msgid ""
"そうだな、ちょうど溜まっていた所だし…\n"
"安い買い物だ、いいだろう。"
msgstr "是啊，正好也憋了一阵子…算是便宜的买卖，好吧。"

#. ID 23, Page 3, Line 63, Pos (6,7)
msgid ""
"君は娼婦だろう？どうかね、私と一晩\n"
"過ごしてみる気はないかな？"
msgstr "你是娼妇吧？怎么样，要不要和我共度一晚？"

#. ID 23, Page 3, Line 74, Pos (6,7)
#. ID 25, Page 3, Line 82, Pos (14,13)
#. ID 25, Page 4, Line 81, Pos (14,13)
#. ID 26, Page 3, Line 81, Pos (15,14)
#. ID 26, Page 4, Line 87, Pos (15,14)
#. ID 26, Page 5, Line 79, Pos (15,14)
msgid ""
"\n"
"今日はこれ以上お仕事はできない…\n"
"\\N[\\V[6]]は誘いを断った。"
msgstr ""
"今天已经无法再接更多工作了…\n"
"\\N[\\V[6]]拒绝了邀请。"

#. ID 23, Page 3, Line 80, Pos (6,7)
#. Choice (2 options)
#. ID 25, Page 3, Line 88, Pos (14,13)
#. Choice (2 options)
#. ID 25, Page 4, Line 87, Pos (14,13)
#. Choice (2 options)
#. ID 26, Page 3, Line 87, Pos (15,14)
#. Choice (2 options)
#. ID 26, Page 4, Line 93, Pos (15,14)
#. Choice (2 options)
#. ID 26, Page 5, Line 85, Pos (15,14)
#. Choice (2 options)
msgid ""
"春を買ってもらう\n"
"この客はやめておこう"
msgstr ""
"让人买春\n"
"还是不要接这个客人了"

#. ID 23, Page 3, Line 84, Pos (6,7)
msgid ""
"おおっ！？そうか、そうか。\n"
"では、私に付いてきてくれ。"
msgstr "哦哦！？是吗，是吗。那么，跟我来吧。"

#. ID 23, Page 3, Line 88, Pos (6,7)
msgid "案内するよ。こっちにおいで。"
msgstr "我来带路。到这边来。"

#. ID 23, Page 3, Line 98, Pos (6,7)
msgid "そ、そうか……？うぅむ…"
msgstr "是、是吗……？嗯…"

#. ID 23, Page 3, Line 103, Pos (6,7)
msgid "ん？そうか…まぁ、いいか。"
msgstr "嗯？是吗…嘛，也行吧。"

#. ID 24, Page 2, Line 3, Pos (16,7)
msgid "……乳臭ェナぁ…"
msgstr "……一股奶臭味啊…"

#. ID 25, Page 2, Line 3, Pos (14,13)
msgid ""
"……最近は迷い込んでくる馬鹿も減ったしなァ…\n"
"また外からさらってくるか？"
msgstr ""
"……最近误闯进来的笨蛋也少了啊…\n"
"要再从外面拐些回来吗？"

#. ID 25, Page 3, Line 3, Pos (14,13)
msgid ""
"相方と違って、俺は少しは金持ってるが…\n"
"黒ねぇ…ふぅん…"
msgstr "和搭档不同，我多少是有点钱的…不过黑啊…嗯…"

#. ID 25, Page 3, Line 6, Pos (14,13)
#. ID 25, Page 4, Line 6, Pos (14,13)
#. ID 26, Page 3, Line 5, Pos (15,14)
#. ID 26, Page 4, Line 11, Pos (15,14)
msgid ""
"その、身体についてる妙なモンは何なんだよ？\n"
"気色悪ィ…"
msgstr "那个，你身上戴着的怪东西是什么？真恶心…"

#. ID 25, Page 3, Line 13, Pos (14,13)
#. ID 25, Page 4, Line 13, Pos (14,13)
#. ID 26, Page 3, Line 12, Pos (15,14)
#. ID 26, Page 4, Line 18, Pos (15,14)
msgid ""
"何だよ、貞操帯つけてんのかよ？\n"
"客舐めてんのか？外してから商売しやがれ！"
msgstr ""
"搞什么啊，你戴着贞操带吗？瞧不起客人吗？\n"
"给我摘了再做买卖！"

#. ID 25, Page 3, Line 20, Pos (14,13)
#. ID 25, Page 4, Line 20, Pos (14,13)
#. ID 26, Page 3, Line 19, Pos (15,14)
#. ID 26, Page 4, Line 25, Pos (15,14)
msgid ""
"その変な服、脱いでから商売しろよ。\n"
"あ？脱げない？馬鹿じゃねーの！？"
msgstr ""
"把那身怪衣服脱了再做买卖啊。啊？脱不下来？\n"
"你是白痴吗！？"

#. ID 25, Page 3, Line 38, Pos (14,13)
#. ID 25, Page 4, Line 38, Pos (14,13)
#. ID 25, Page 5, Line 47, Pos (14,13)
#. ID 25, Page 6, Line 58, Pos (14,13)
msgid ""
"おお？妊婦ねえ！孕んだ女ってのは\n"
"たまんねえ色気があるよなぁ？"
msgstr ""
"哦哦？孕妇啊！\n"
"怀孕的女人有种让人受不了的色气吧？"

#. ID 25, Page 3, Line 44, Pos (14,13)
#. ID 25, Page 4, Line 44, Pos (14,13)
msgid ""
"全っ然趣味じゃねえわ…やっぱ穴はもっと熟れた\n"
"むちむちの姉ーちゃんじゃねえとなぁー"
msgstr ""
"完全不合我口味啊…果然穴还是得找更熟、\n"
"肉感十足的姐姐才行啊——"

#. ID 25, Page 3, Line 50, Pos (14,13)
#. ID 25, Page 4, Line 50, Pos (14,13)
msgid ""
"うぉぉっ！？よく見たらすっげえ好みじゃねえか！\n"
"いくらだよ？出来るだけ払いは多くするから頼むよ！"
msgstr ""
"哇哦！？仔细一看不是超合我口味吗！多少钱？\n"
"我会尽量多付钱的，拜托了！"

#. ID 25, Page 3, Line 56, Pos (14,13)
msgid ""
"おおっ？なんだよいい女じゃねえか～！\n"
"拉致っちまいたいくらいだよ？\n"
"いくらだ？"
msgstr ""
"哦哦？什么嘛，不是个好女人吗～！\n"
"简直想把你绑走呢？多少钱？"

#. ID 25, Page 3, Line 63, Pos (14,13)
msgid ""
"ん～？まぁこんなもんか。\n"
"ゴミみたいなギャラでもいいなら、\n"
"買ってやってもいいぜ？"
msgstr ""
"嗯～？嘛，也就这样吧。如果垃圾一样的报酬也行，\n"
"我倒是可以买下你哦？"

#. ID 25, Page 3, Line 69, Pos (14,13)
msgid ""
"へっ、まぁ黒に期待するもんじゃねえな。\n"
"買って欲しいか？"
msgstr ""
"呵，不过对黑本来就不该抱什么期待啊。\n"
"想让我买你吗？"

#. ID 25, Page 3, Line 71, Pos (14,13)
msgid ""
"でもよー、たっぷりサービスしてもらわないとな、\n"
"釣り合わねえぞ？"
msgstr "不过啊——得让你好好服务我才行，不然可不划算啊？"

#. ID 25, Page 3, Line 92, Pos (14,13)
#. ID 25, Page 4, Line 91, Pos (14,13)
#. ID 25, Page 5, Line 92, Pos (14,13)
#. ID 25, Page 6, Line 98, Pos (14,13)
msgid ""
"へへ、いいぜぇ、子宮の奥まで\n"
"ぶち込んで、ガキにぶちまけてやるよ！"
msgstr ""
"嘿嘿，好啊，我直接捅进子宫深处，\n"
"全灌给你这小鬼！"

#. ID 25, Page 3, Line 98, Pos (14,13)
#. ID 25, Page 4, Line 97, Pos (14,13)
#. ID 25, Page 5, Line 98, Pos (14,13)
msgid ""
"おおっ！？へへっ、いいぜ、いいぜ！\n"
"出来るだけいい場所にしてやるからさ、\n"
"たっぷり楽しもうぜ？"
msgstr ""
"哦哦！？嘿嘿，好啊，好啊！\n"
"我会尽量给你找个好地方，咱们好好享受吧？"

#. ID 25, Page 3, Line 105, Pos (14,13)
#. ID 25, Page 4, Line 104, Pos (14,13)
#. ID 25, Page 5, Line 105, Pos (14,13)
msgid ""
"へへっ、じゅるっ…そうか、そうか。\n"
"いい部屋にしてやるからよ、じっくり\n"
"楽しませてくれよ？"
msgstr ""
"嘿嘿，吸溜……是吗，是吗。我会给你安排个好房间，\n"
"你可得让我慢慢享受啊？"

#. ID 25, Page 3, Line 111, Pos (14,13)
#. ID 25, Page 4, Line 110, Pos (14,13)
#. ID 25, Page 5, Line 111, Pos (14,13)
#. ID 25, Page 6, Line 112, Pos (14,13)
msgid ""
"へへへ、じゃ、行くか。\n"
"あんまいい場所じゃねえけどよ、\n"
"まぁ、青姦には慣れてるだろ？"
msgstr ""
"嘿嘿嘿，那就走吧。地方不怎么样，不过嘛，\n"
"野外做爱你应该习惯了吧？"

#. ID 25, Page 3, Line 129, Pos (14,13)
#. ID 25, Page 4, Line 128, Pos (14,13)
msgid ""
"ええっ？おいおい、頼むよ、めちゃくちゃ\n"
"好みなんだよ、ギャラは払うからさぁ、\n"
"頼むぜー"
msgstr ""
"诶？喂喂，拜托了，你太合我口味了，钱我会付的，\n"
"求你了——"

#. ID 25, Page 3, Line 136, Pos (14,13)
#. ID 25, Page 4, Line 135, Pos (14,13)
msgid ""
"あ～ん？客を選ぶなんざいいご身分だな？\n"
"ま、俺はいいけどよー"
msgstr ""
"啊～？还挑客人，架子可真大啊？算了，\n"
"我倒是无所谓啦——"

#. ID 25, Page 4, Line 3, Pos (14,13)
msgid ""
"相方と違って、俺は少しは金持ってるが…\n"
"そんなに払えねぇぞ？"
msgstr ""
"和同伴不一样，我多少还是有点钱的……\n"
"但可付不了那么多啊？"

#. ID 25, Page 4, Line 55, Pos (14,13)
msgid ""
"おおっ？なんだよいい女じゃねえか～！\n"
"俺の嫁になんねえか？なんてな！\n"
"いくらだ？"
msgstr ""
"哦哦？什么嘛，这不是个好女人吗～！\n"
"要不要做我老婆？开玩笑的！多少钱？"

#. ID 25, Page 4, Line 61, Pos (14,13)
msgid ""
"へへ、なかなかいい乳してやがんじゃねーか。\n"
"ろくに払えねーが、それでもいいなら、\n"
"買ってやってもいいぜ？"
msgstr ""
"嘿嘿，你这奶子还挺不错的嘛。我付不了多少钱，\n"
"不过你要是愿意，我也可以买你哦？"

#. ID 25, Page 4, Line 67, Pos (14,13)
msgid ""
"んー、ちっと貧相な体だなぁ。\n"
"あんまそそらねえけどよ、安くても\n"
"いいんなら買うぜ～？"
msgstr ""
"嗯——身子有点贫弱啊。虽然不太让人起劲，\n"
"不过便宜点的话我就买你哦～？"

#. ID 25, Page 4, Line 70, Pos (14,13)
msgid ""
"でもよー、たっぷりサービスしてもらわないとな、\n"
"ちょっち釣り合わねえな？"
msgstr ""
"不过啊——得让你好好服务我才行，\n"
"不然有点不划算吧？"

#. ID 25, Page 5, Line 3, Pos (14,13)
#. Contains choice at line 3 (2 options)
msgid ""
"相方と違って、俺は少しは金持ってるが…\n"
"ちょっとあんたは俺には高すぎるなぁ…"
msgstr ""
"和同伴不同，我多少有点钱……\n"
"不过你对我来说还是太贵了啊……"

#. ID 25, Page 5, Line 5, Pos (14,13)
#. Choice (2 options, embedded in a message)
#. ID 26, Page 5, Line 5, Pos (15,14)
#. Choice (2 options, embedded in a message)
msgid ""
"残念……\n"
"タダでしてもいいよ……\\c[11]$k"
msgstr ""
"真遗憾……\n"
"免费也可以哦……\\c[11]$k"

#. ID 25, Page 5, Line 13, Pos (14,13)
msgid ""
"その、身体についてる妙なモンは何なんだよ？\n"
"気色悪ィ…タダでもやりたくねえよ…"
msgstr ""
"那个，你身上戴的奇怪玩意儿是什么啊？真恶心……\n"
"就算是免费我也不想干啊……"

#. ID 25, Page 5, Line 20, Pos (14,13)
msgid ""
"何だよ、貞操帯つけてんのかよ？\n"
"馬鹿にしてんのか？"
msgstr "搞什么啊，你戴着贞操带吗？是在耍我吗？"

#. ID 25, Page 5, Line 27, Pos (14,13)
msgid ""
"その変な服、脱いでからにしろよ。\n"
"あ？脱げない？じゃあいいや…"
msgstr ""
"把那身奇怪的衣服脱了再说。啊？脱不下来？\n"
"那就算了……"

#. ID 25, Page 5, Line 33, Pos (14,13)
msgid ""
"マジかよ！？やっぱ、高級になると\n"
"飢えて飢えて仕事だけじゃ物足りないのかね？"
msgstr ""
"真的吗！？果然到了高级别，\n"
"就饥渴得光靠工作满足不了了吗？"

#. ID 25, Page 5, Line 53, Pos (14,13)
#. ID 25, Page 6, Line 64, Pos (14,13)
msgid ""
"あーでも全っ然趣味じゃねえな…\n"
"やっぱ穴はもっと熟れた\n"
"むちむちの姉ーちゃんじゃねえとなぁー"
msgstr ""
"啊——不过完全不合我口味啊……\n"
"洞还是得是更成熟肉感的大姐姐才行啊——"

#. ID 25, Page 5, Line 60, Pos (14,13)
msgid ""
"うぉぉっ！？マジかよ？\n"
"よく見たらすっげえ好みじゃねえか！\n"
"本当にタダでいいのかよ！？"
msgstr ""
"哇哦！？真的吗？仔细一看这不是超级合我口味吗！\n"
"真的免费就行吗！？"

#. ID 25, Page 5, Line 66, Pos (14,13)
msgid ""
"マジかよ、こんなにいい女がタダたぁ！\n"
"俺に惚れたかよ？なんてな！"
msgstr ""
"真的吗，这么好的女人居然免费！你是迷上我了吗？\n"
"开玩笑的！"

#. ID 25, Page 5, Line 71, Pos (14,13)
msgid ""
"へへ、なかなかやらしい体してやがんじゃねーか。\n"
"やっぱ飢えてんのか？仕事だけじゃ\n"
"物足りねえって？"
msgstr ""
"嘿嘿，你这身子还挺骚的嘛。果然是饥渴了吗？\n"
"光工作满足不了你？"

#. ID 25, Page 5, Line 77, Pos (14,13)
msgid ""
"んー、ちっと物足りねぇ体だが、\n"
"タダなら文句はねえや。"
msgstr "嗯——身子有点不够看，不过免费的话我也没意见。"

#. ID 25, Page 5, Line 87, Pos (14,13)
#. Choice (2 options)
msgid ""
"この客と楽しむ\n"
"やっぱりやめる♪"
msgstr ""
"跟这位客人玩\n"
"果然还是算了♪"

#. ID 25, Page 5, Line 129, Pos (14,13)
msgid ""
"ええっ？おいおい、頼むよ、めちゃくちゃ\n"
"好みなんだよ、やめろよ、そういう\n"
"期待させて突き落とすようなことはよ！"
msgstr ""
"诶？喂喂，拜托了，你太合我口味了，别这样啊，\n"
"别干这种让人期待又把人推下去的事啊！"

#. ID 25, Page 5, Line 136, Pos (14,13)
msgid "あ～ん？ちっ、笑えねえ冗談だぜ…"
msgstr "啊～？啧，这玩笑可不好笑啊……"

#. ID 25, Page 6, Line 4, Pos (14,13)
#. Contains choice at line 3 (2 options)
msgid ""
"ああ？何だぁ？娼婦なのか、奴隷なのか、\n"
"はっきりしろよ…扱いに困るだろ？"
msgstr ""
"啊？什么啊？到底是娼妇还是奴隶，说清楚啊……\n"
"不然很难处理吧？"

#. ID 25, Page 6, Line 6, Pos (14,13)
#. Choice (2 options, embedded in a message)
msgid ""
"娼婦です\\c[11]$k\n"
"奴隷です\\c[11]$k"
msgstr ""
"是娼妇\\c[11]$k\n"
"是奴隶\\c[11]$k"

#. ID 25, Page 6, Line 8, Pos (14,13)
msgid ""
"ああ、そうかい、そうかい。\n"
"じゃ、とっとと首輪外してもらってこいよ。\n"
"紛らわしいだろ？"
msgstr ""
"啊啊，是吗，是吗。那赶紧去让人把项圈摘了再来。\n"
"太容易混淆了吧？"

#. ID 25, Page 6, Line 15, Pos (14,13)
msgid ""
"へぇ…そうかい？じゃ、お望みどおり奴隷として\n"
"扱ってやるよ…"
msgstr "呵……是吗？那我就如你所愿，把你当奴隶对待吧……"

#. ID 25, Page 6, Line 21, Pos (14,13)
msgid "ああ？奴隷じゃねーか、奴隷は飽きたんだがな…"
msgstr "啊？不是奴隶吗，奴隶我已经腻了啊……"

#. ID 25, Page 6, Line 25, Pos (14,13)
msgid ""
"何か身体についてんな…\n"
"気色悪ィ…"
msgstr "身上好像戴着什么东西……真恶心……"

#. ID 25, Page 6, Line 32, Pos (14,13)
msgid ""
"何だよ、貞操帯つけてんのかよ？\n"
"面倒くせぇな…"
msgstr "搞什么啊，你戴着贞操带吗？真麻烦啊……"

#. ID 25, Page 6, Line 39, Pos (14,13)
msgid ""
"何だその変な服？脱げない？\n"
"めんどくせえな…"
msgstr "那身奇怪的衣服是什么？脱不下来？真麻烦啊……"

#. ID 25, Page 6, Line 55, Pos (14,13)
msgid "どうすっかな～～？"
msgstr "怎么办呢～～？"

#. ID 25, Page 6, Line 71, Pos (14,13)
msgid ""
"うぉぉっ！？マジかよ？\n"
"よく見たらすっげえ好みじゃねえか！\n"
"こりゃツイてるぜ…"
msgstr ""
"哇哦！？真的吗？仔细一看这不是超级合我口味吗！\n"
"这可真走运啊……"

#. ID 25, Page 6, Line 77, Pos (14,13)
msgid ""
"マジかよ、こんなにいい女が奴隷たぁ！\n"
"モノにするしかねえな…"
msgstr ""
"真的吗，这么好的女人居然是奴隶！\n"
"只能弄到手了啊……"

#. ID 25, Page 6, Line 82, Pos (14,13)
msgid ""
"へへ、なかなかやらしい体してやがんじゃねーか。\n"
"可愛がってやるぜ？"
msgstr "嘿嘿，你这身子还挺骚的嘛。我会好好疼你的哦？"

#. ID 25, Page 6, Line 87, Pos (14,13)
msgid ""
"んー、貧相なナリしてんな…\n"
"まぁ、いいか、タダだし。"
msgstr ""
"嗯——长得有点寒酸啊……算了，也行吧，\n"
"反正是免费的。"

#. ID 25, Page 6, Line 104, Pos (14,13)
msgid ""
"へへっ、いいぜ、いいぜ！\n"
"可愛がってやるからよぉ、\n"
"たっぷり楽しもうぜ？"
msgstr ""
"嘿嘿，好啊，好啊！我会好好疼你的，\n"
"咱们尽情享受吧？"

#. ID 26, Page 2, Line 3, Pos (15,14)
msgid "ああん？何ぃ？"
msgstr "啊？什么？"

#. ID 26, Page 3, Line 3, Pos (15,14)
msgid "ああん？何ぃ？ほほぉん…"
msgstr "啊？什么？哦～……"

#. ID 26, Page 3, Line 37, Pos (15,14)
#. ID 26, Page 4, Line 43, Pos (15,14)
msgid ""
"おいおい、妊婦かよぉ。ボテ腹はなぁ、\n"
"趣味じゃねえんだよなぁ。"
msgstr "喂喂，是孕妇啊。孕肚这东西啊，可不合我口味啊。"

#. ID 26, Page 3, Line 43, Pos (15,14)
#. ID 26, Page 4, Line 49, Pos (15,14)
msgid "あーん、全然そそられねえや。"
msgstr "啊——完全提不起劲啊。"

#. ID 26, Page 3, Line 44, Pos (15,14)
#. ID 26, Page 4, Line 50, Pos (15,14)
#. ID 26, Page 5, Line 55, Pos (15,14)
msgid ""
"俺はな、もっとスレンダーでちっぱいで\n"
"それでいていぢめがいのあるコじゃないと\n"
"駄目なんよ。"
msgstr ""
"我啊，得是那种更苗条、平胸，\n"
"而且还让人有欺负欲望的才行。"

#. ID 26, Page 3, Line 51, Pos (15,14)
#. ID 26, Page 4, Line 57, Pos (15,14)
msgid ""
"ほぉぉ～～～っ、いいねぇ、いいなぁ…\n"
"まさに理想って感じだ、惚れたぜ……"
msgstr ""
"哦哦～～～，不错啊，好啊……简直正是理想型，\n"
"我迷上你了……"

#. ID 26, Page 3, Line 56, Pos (15,14)
#. ID 26, Page 4, Line 62, Pos (15,14)
msgid ""
"おおっ？いいねぇ、カワイイな、たまらんな。\n"
"天使現るって感じだな？"
msgstr ""
"哦哦？不错啊，好可爱，真让人受不了。\n"
"简直就是天使降临啊？"

#. ID 26, Page 3, Line 58, Pos (15,14)
msgid ""
"黒っつうのは安くてもいいんだよな？\n"
"上の方に行っちまう前に是非お相手したいねえ。"
msgstr ""
"黑的话就算便宜也无所谓吧？\n"
"趁你还没被弄到上面去之前，务必想跟你做一次啊。"

#. ID 26, Page 3, Line 63, Pos (15,14)
msgid ""
"んん、普通にかわいいな。うん。\n"
"ま、いいぜ、安くても構わないんだろ？"
msgstr ""
"嗯嗯，普通地挺可爱嘛。嗯。算了，也行，\n"
"便宜点也没关系吧？"

#. ID 26, Page 3, Line 68, Pos (15,14)
msgid ""
"黒だしなぁ、こんなもんか？\n"
"ま、買ってやるよ。"
msgstr "毕竟是黑嘛，也就这样吧？算了，我买你就是了。"

#. ID 26, Page 3, Line 70, Pos (15,14)
#. ID 26, Page 4, Line 76, Pos (15,14)
msgid ""
"へへ、でもよー、たっぷりサービスして\n"
"もらわないとな？"
msgstr "嘿嘿，不过啊——得让你好好服务我才行吧？"

#. ID 26, Page 3, Line 91, Pos (15,14)
#. ID 26, Page 4, Line 97, Pos (15,14)
msgid ""
"妊婦は趣味じゃねー筈なんだけどな、\n"
"よっぽど溜まってんのかなぁ、俺…"
msgstr ""
"孕妇本来应该不合我口味才对啊，\n"
"我这是憋得有多厉害啊……"

#. ID 26, Page 3, Line 97, Pos (15,14)
msgid ""
"おおっ！？やった！へへっ、じゃ、俺が\n"
"いいとこ連れてやるからさ、楽しもうぜ～～"
msgstr ""
"哦哦！？太好了！嘿嘿，那我会带你去个好地方，\n"
"咱们享受吧～～"

#. ID 26, Page 3, Line 102, Pos (15,14)
#. ID 26, Page 4, Line 108, Pos (15,14)
#. ID 26, Page 5, Line 102, Pos (15,14)
msgid ""
"へへへ、じゃ、しっぽりする場所を探しますか。\n"
"青姦になっちまうけどさ、ま、慣れてるだろ？"
msgstr ""
"嘿嘿嘿，那就找个能好好缠绵的地方吧。\n"
"虽然会变成野外做爱，不过嘛，你习惯了吧？"

#. ID 26, Page 3, Line 119, Pos (15,14)
#. ID 26, Page 4, Line 125, Pos (15,14)
msgid ""
"ええっ？……ちょっと、ショックだわぁー\n"
"できるだけ金は払うからさ、頼むよぉ\n"
"すごい好みなんだよぉ"
msgstr ""
"诶？……等等，有点受冲击啊——我会尽量付钱的，\n"
"求你了嘛，你真的很合我口味啊。"

#. ID 26, Page 3, Line 126, Pos (15,14)
msgid ""
"へっ、黒が客を選んでちゃいけねーぜ？\n"
"俺はそんなに危ない奴じゃないんだけどなー…"
msgstr ""
"呵，黑可不能挑客人啊？\n"
"我可不是什么危险的家伙啊——"

#. ID 26, Page 4, Line 4, Pos (15,14)
msgid "よぉ、\\N[\\V[6]]。調子はどうだ？"
msgstr "哟，\\N[\\V[6]]。状态怎么样？"

#. ID 26, Page 4, Line 7, Pos (15,14)
msgid "ああん？何ぃ？新しく入った子か？"
msgstr "啊嗯？什么？新来的孩子吗？"

#. ID 26, Page 4, Line 64, Pos (15,14)
msgid ""
"あんたはもっと上の方に行っちまうかもしれねえな。\n"
"今が買い時ってやつなんだろうな。"
msgstr ""
"你说不定会爬到更高的地方去啊。\n"
"现在正是该买的时候吧。"

#. ID 26, Page 4, Line 69, Pos (15,14)
msgid ""
"んん、普通にかわいいな。うん。\n"
"ま、いいぜ、金なんて後で稼ぎゃいいんだし。"
msgstr ""
"嗯嗯，普通地可爱啊。嗯。嘛，行吧，\n"
"钱什么的之后再赚就行了。"

#. ID 26, Page 4, Line 74, Pos (15,14)
msgid ""
"うーん、あんまそそられねえけどなぁ…\n"
"ま、買ってやるよ。"
msgstr "嗯——虽然不太勾起我兴趣……嘛，我买了吧。"

#. ID 26, Page 4, Line 103, Pos (15,14)
msgid ""
"おおっ！？やった！へへっ、じゃ、俺が\n"
"いいとこ連れてってやるからさ、楽しもうぜ～～"
msgstr ""
"哦哦！？太好了！嘿嘿，那我会带你去好地方的，\n"
"好好享受吧～～"

#. ID 26, Page 4, Line 132, Pos (15,14)
msgid ""
"ええ、俺は正娼婦にお痛するほどイカれてねえぜ？\n"
"単純に好みじゃないとか？ショックだわ…"
msgstr ""
"诶，我还没疯到会对正经娼妇心疼的地步吧？\n"
"单纯就是不合口味？真受打击……"

#. ID 26, Page 5, Line 3, Pos (15,14)
#. Contains choice at line 3 (2 options)
msgid ""
"よぉ、\\N[\\V[6]]。お前もお高くなっちまったよなぁ。\n"
"俺にはもう手が出ねえや……"
msgstr "哟，\\N[\\V[6]]。你也变贵了啊。我已经买不起了……"

#. ID 26, Page 5, Line 13, Pos (15,14)
msgid ""
"その、身体についてる妙なモンは何なんだよ？\n"
"悪いけど…タダでもやりたくねえよ…"
msgstr ""
"那个，你身上戴着的奇怪东西是什么啊？不好意思……\n"
"就算是免费我也不想做……"

#. ID 26, Page 5, Line 20, Pos (15,14)
msgid ""
"貞操帯つけてんのかよ？\n"
"できねえじゃねえか、アホか～"
msgstr "你戴着贞操带吗？这不是做不了嘛，傻了吧～"

#. ID 26, Page 5, Line 27, Pos (15,14)
msgid ""
"その変な服、脱いでから商売しろよ。\n"
"あ？脱げない？じゃあいいわ…"
msgstr ""
"先把那身怪衣服脱了再做生意啊。啊？脱不下来？\n"
"那算了……"

#. ID 26, Page 5, Line 33, Pos (15,14)
msgid ""
"マジか！？ありがてえな、ちょうど金が\n"
"無くて溜まってたところなんだよ。"
msgstr "真的吗！？太感谢了，正好我没钱憋着呢。"

#. ID 26, Page 5, Line 47, Pos (15,14)
msgid ""
"おいおい、妊娠しちまってるじゃねえかよ。\n"
"誰の子だよ？ボテ腹は趣味じゃねえし、\n"
"あ～～～"
msgstr ""
"喂喂，这不是怀孕了吗。谁的孩子啊？\n"
"孕肚不合我口味，啊～～～"

#. ID 26, Page 5, Line 54, Pos (15,14)
msgid "あーん、駄目だ、全然そそられねえや。"
msgstr "啊——不行，完全提不起兴趣。"

#. ID 26, Page 5, Line 62, Pos (15,14)
msgid ""
"ほぉぉ～～～っ、やっぱいいねぇ、いいなぁ…\n"
"まさに理想って感じだ、やっぱ\\N[\\V[6]]は\n"
"女神だなぁ。もう結婚してくれよ…"
msgstr ""
"哦哦～～～，果然好啊，真好啊……\n"
"简直是理想的感觉，不愧是\\N[\\V[6]]，是女神啊。\n"
"干脆和我结婚吧……"

#. ID 26, Page 5, Line 68, Pos (15,14)
msgid ""
"おおっ？やっぱいいねぇ、カワイイな、たまらんな。\n"
"さすが\\N[\\V[6]]は俺の天使だぜ！"
msgstr ""
"哦哦？果然好啊，真可爱，让人受不了。\n"
"不愧是\\N[\\V[6]]，我的天使！"

#. ID 26, Page 5, Line 72, Pos (15,14)
msgid ""
"んん、やっぱ\\N[\\V[6]]はかわいいなぁ。\n"
"その上タダでさせてくれるなんて女神だわ。"
msgstr ""
"嗯嗯，果然\\N[\\V[6]]真可爱啊。\n"
"而且还免费让我做，真是女神啊。"

#. ID 26, Page 5, Line 90, Pos (15,14)
msgid ""
"誰の子だか気になるなぁ…たっぷり\n"
"時間かけて聞いてやるからな、\\N[\\V[6]]？"
msgstr ""
"真在意是谁的孩子啊……我会花足够的时间问你的，\n"
"\\N[\\V[6]]？"

#. ID 26, Page 5, Line 96, Pos (15,14)
msgid ""
"おおっ！？やった！\\N[\\V[6]]、愛してるぜ！\n"
"へへっ、じゃ、俺が\n"
"いつものとこに連れてってやるからさ、楽しもうぜ～～"
msgstr ""
"哦哦！？太好了！\\N[\\V[6]]，我爱你！嘿嘿，\n"
"那我会带你去老地方的，好好享受吧～～"

#. ID 26, Page 5, Line 119, Pos (15,14)
msgid ""
"ええっ？……ちょっと、ショックだわぁー\n"
"やめてくれよそういう冗談、マジで。\n"
"\\N[\\V[6]]とできなくて最近俺、辛いんだからさー"
msgstr ""
"诶？……等等，真是打击啊——别开这种玩笑，说真的。\n"
"最近不能和\\N[\\V[6]]做，我很难受啊——"

#. ID 26, Page 5, Line 126, Pos (15,14)
msgid "ええ、そういう冗談はやめてくれよ～～"
msgstr "诶，别开这种玩笑啊～～"

#. ID 26, Page 6, Line 4, Pos (15,14)
msgid ""
"ん～？あれ、奴隷になっちゃったの？\n"
"困ったな、奴隷でも娼婦だと色々あるんだよね…"
msgstr ""
"嗯～？哎呀，你变成奴隶了吗？真麻烦啊，\n"
"就算是奴隶，如果是娼妇的话会有各种情况呢……"

#. ID 26, Page 6, Line 8, Pos (15,14)
msgid ""
"ああ？奴隷か？奴隷なぁ、奴隷なんて\n"
"ダッチワイフと変わんねぇよな、つまんねぇよ…"
msgstr ""
"啊？奴隶吗？奴隶啊，奴隶跟充气娃娃没两样嘛，\n"
"真无聊……"

#. ID 27, Page 2, Line 3, Pos (17,10)
msgid ""
"ん？　何かね？\n"
"私は旅の行商人さ。"
msgstr "嗯？有什么事吗？我是旅行商人。"

#. ID 27, Page 2, Line 5, Pos (17,10)
msgid ""
"この街特産の名物を買い取りに来てるんだ。\n"
"……どんなモノかって？　それは秘密だ。"
msgstr ""
"我是来收购这条街特产的名物的。……是什么东西？\n"
"那是秘密。"

#. ID 27, Page 3, Line 3, Pos (17,10)
msgid "…君も娼婦なのかな？"
msgstr "……你也是娼妇吗？"

#. ID 27, Page 3, Line 4, Pos (17,10)
msgid ""
"我々は娼婦向けの品も扱ってるんだ。\n"
"どうだい？見ていかないか？"
msgstr "我们也经营面向娼妇的商品。怎么样？不去看看吗？"

#. ID 28, Page 2, Line 4, Pos (8,4)
msgid ""
"……うっさいねぇ。\n"
"目障りだよ。とっとと消えな。"
msgstr "……真吵啊。碍眼。赶紧消失吧。"

#. ID 28, Page 3, Line 4, Pos (8,4)
msgid "……なんか用かい？"
msgstr "……有什么事吗？"

#. ID 29, Page 2, Line 3, Pos (11,10)
msgid "それでね、ふふふ…"
msgstr "然后呢，呵呵呵……"

#. ID 30, Page 2, Line 3, Pos (10,11)
msgid "クスクス…"
msgstr "咯咯……"

#. ID 31, Page 2, Line 3, Pos (15,17)
msgid ""
"………………………………………………………………\n"
"………………………………………………………………\n"
"……………………………おくすり、いる？"
msgstr ""
"…………………………………………………………………………………………………………………………\n"
"…………………………………药，要吗？"

#. ID 31, Page 2, Line 8, Pos (15,17)
msgid ""
"えへへへへへへへへへへへへぇ\n"
"金だ\n"
"金だ"
msgstr "嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿，钱，钱"

#. ID 31, Page 2, Line 13, Pos (15,17)
msgid ""
"………ひやかし\n"
"…ひやかしは、死ね\\.、死ね\\.、死ね、死ね\\.、\n"
"死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね\n"
"死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね死ね"
msgstr ""
"………光看不买…光看不买的，去死\\.、去死\\.、去死、\n"
"去死\\.、\n"
"去死去死去死去死去死去死去死去死去死去死去死去\n"
"死去死去死去死去死去死去死去死去死去死去死去死\n"
"去死去死去死去死去死去死去死去死"

#. ID 32, Page 2, Line 3, Pos (9,16)
#. ID 32, Page 5, Line 3, Pos (9,16)
msgid "うふふ…なぁにぃ？"
msgstr "呵呵呵…什么呀？"

#. ID 32, Page 3, Line 3, Pos (9,16)
msgid "あら、黒の子？大変だねぇ。"
msgstr "哎呀，黑之子？真不容易啊。"

#. ID 32, Page 3, Line 4, Pos (9,16)
msgid ""
"稼ぎが少ないからって、一日に\n"
"お仕事していい回数をごまかしちゃ\n"
"だめだよー？"
msgstr "就算赚得少，也不能虚报一天可以工作的次数哦——？"

#. ID 32, Page 3, Line 7, Pos (9,16)
msgid ""
"すぐにバレちゃうからね。\n"
"制裁はこわいよぉ～"
msgstr "马上就会露馅的。制裁很可怕的哦～"

#. ID 32, Page 4, Line 3, Pos (9,16)
msgid "ごきげんよー！"
msgstr "贵安——！"

#. ID 32, Page 4, Line 4, Pos (9,16)
#. Contains choice at line 3 (2 options)
msgid ""
"いいこと教えてあげようか？\n"
"聞きたい？聞きたい？"
msgstr "要不要告诉你件好事？想听吗？想听吗？"

#. ID 32, Page 4, Line 6, Pos (9,16)
#. Choice (2 options, embedded in a message)
msgid ""
"聞きたい！\n"
"いいえ"
msgstr ""
"想听！\n"
"不"

#. ID 32, Page 4, Line 8, Pos (9,16)
msgid ""
"カウンターの前にいる人はね、\n"
"お金持ちだよ！"
msgstr "柜台前的那个人啊，很有钱哦！"

#. ID 32, Page 4, Line 10, Pos (9,16)
msgid ""
"いわゆる“まにあ”な人で、好みが\n"
"裏通りのなんでもＯＫなお客さんたちより\n"
"厳しいんだって。"
msgstr ""
"也就是所谓的「狂热者」，\n"
"听说他的口味比后巷那些什么都OK的客人还要挑剔。"

#. ID 32, Page 4, Line 13, Pos (9,16)
msgid ""
"お金も、それなりに持ってるから、\n"
"気に入られれば、いっぱい稼げちゃうかも？"
msgstr ""
"钱也相应地有不少，所以要是被他看上，\n"
"说不定能赚很多？"

#. ID 32, Page 4, Line 15, Pos (9,16)
msgid ""
"ボク？ボクはね、お外にお得意さんが\n"
"いるから…まにあな人はキミに譲ってあげるよ。"
msgstr ""
"我？我啊，在外面有老主顾……\n"
"所以「狂热者」就让给你吧。"

#. ID 32, Page 4, Line 17, Pos (9,16)
msgid ""
"あの人はね…確かー…\n"
"“まぞ”で“びっち”な人が\n"
"好みなんだってさ。"
msgstr ""
"那个人啊……\n"
"我记得——他喜欢又「受虐狂」又「婊子」的人。"

#. ID 32, Page 4, Line 22, Pos (9,16)
msgid "えー、いい話なのになー。"
msgstr "诶——明明是好事来着——"

#. ID 32, Page 5, Line 5, Pos (9,16)
msgid "あれ、奴隷にされちゃったの？"
msgstr "哎呀，你被变成奴隶了吗？"

#. ID 32, Page 5, Line 6, Pos (9,16)
msgid ""
"よくあるんだよね、そういうこと。\n"
"銀以上なら、\n"
"焔さんが簡単に外してくれるんだけど…"
msgstr ""
"这种事很常见呢。如果是银以上，\n"
"焰小姐就能轻松帮你取下来……"

#. ID 32, Page 5, Line 10, Pos (9,16)
msgid ""
"キミはそうじゃないよね…\n"
"困ったね…お侍さんにでも頼んでみる？"
msgstr ""
"你并不是那样吧……真麻烦……\n"
"要不要试着拜托武士先生？"

#. ID 32, Page 5, Line 12, Pos (9,16)
msgid "無事にすむかわからないけど…"
msgstr "不知道能不能平安了事……"

#. ID 33, Page 2, Line 3, Pos (11,16)
#. ID 33, Page 3, Line 3, Pos (11,16)
#. ID 33, Page 4, Line 3, Pos (11,16)
#. ID 33, Page 5, Line 3, Pos (11,16)
msgid "……………………………"
msgstr "……………………………"

#. ID 33, Page 3, Line 4, Pos (11,16)
msgid ""
"……………………………\n"
"……………………がんばって…ね。"
msgstr "…………………………………………………加油……哦。"

#. ID 33, Page 4, Line 4, Pos (11,16)
msgid ""
"……………………………\n"
"………………ごきげんよう。"
msgstr "……………………………………………贵安。"

#. ID 33, Page 5, Line 4, Pos (11,16)
msgid ""
"……………………………\n"
"………………首輪は…嫌……"
msgstr "……………………………………………项圈是……不要……"

#. ID 33, Page 5, Line 6, Pos (11,16)
msgid ""
"……嫌……嫌……嫌……嫌……\n"
"……嫌……嫌……嫌……嫌……\n"
"\\.……やだ…\\.やだ…\\.やだ…\\.やだよぉ……"
msgstr ""
"……不要……不要……不要……不要…………不要……不要……不要……\n"
"不要……\\.……讨厌…\\.讨厌…\\.讨厌…\\.讨厌啊……"

#. ID 34, Page 2, Line 3, Pos (16,13)
msgid "くそ、金が、金がねえよぉー"
msgstr "可恶，钱，没钱啊——"

#. ID 34, Page 2, Line 4, Pos (16,13)
msgid ""
"金さえありゃよ、娼婦さんがたとやり放題だってのに\n"
"畜生がぁ～～もう便所で済ますの飽きたってんだよ！"
msgstr ""
"只要有钱，就能和娼妇们随便做，\n"
"可畜生啊～～我已经受够在厕所里解决了！"

#. ID 34, Page 3, Line 3, Pos (16,13)
msgid "あぁ？あんだぁ？"
msgstr "啊？什么啊？"

#. ID 34, Page 3, Line 5, Pos (16,13)
#. ID 34, Page 4, Line 5, Pos (16,13)
msgid ""
"なんだぁ？ガキ？\n"
"なんでガキがこんな所に？\n"
"ガキは趣味じゃねーっての！"
msgstr ""
"什么啊？小鬼？为什么小鬼在这种地方？\n"
"小鬼不合我口味！"

#. ID 34, Page 3, Line 10, Pos (16,13)
msgid "なに、君、娼婦？違うの？"
msgstr "什么，你是娼妇？不是吗？"

#. ID 34, Page 3, Line 11, Pos (16,13)
msgid ""
"へぇ～、そうなんだ。\n"
"…ジュルリ…"
msgstr "哦～，这样啊。……舔嘴……"

#. ID 34, Page 4, Line 11, Pos (16,13)
msgid ""
"やめてよぉ、今金が無いんだからさ。\n"
"むらむらする格好でうろつかないでよぉ…"
msgstr ""
"别这样啊，我现在没钱啊。\n"
"别穿得让人欲火中烧地晃来晃去啊……"

#. ID 34, Page 4, Line 13, Pos (16,13)
msgid ""
"ちんぽに悪いでしょ…俺のちんぽは\n"
"きかん棒なのよ…困るよほんとに、ほんともう"
msgstr ""
"这样对鸡巴不好吧…我的鸡巴可是旗杆啊…\n"
"真困扰啊真的，真是的"

#. ID 34, Page 4, Line 17, Pos (16,13)
msgid "ああ？駄目、今金がないの。一文もないの！"
msgstr "啊？不行，现在没钱。一文也没有！"

#. ID 34, Page 4, Line 18, Pos (16,13)
msgid ""
"だから、そんな悩ましい声出しても駄目だから、\n"
"やめて！"
msgstr "所以说，发出那么撩人的声音也不行，住手！"

#. ID 34, Page 5, Line 4, Pos (16,13)
msgid "…へへへ…"
msgstr "…嘿嘿嘿…"

#. ID 36, Page 2, Line 3, Pos (5,13)
msgid ""
"……こいつももう駄目かなぁ～…\n"
"そろそろシュライク送りかな？"
msgstr ""
"……这家伙也已经不行了吗～…\n"
"差不多该送去施莱克那儿了吗？"

#. ID 36, Page 2, Line 5, Pos (5,13)
msgid ""
"えぇ？そんなことない？もっと頑張る？\n"
"そぉ？でもなぁ、もうどこもがばがばなんだよねぇ…"
msgstr ""
"诶？没那回事？我会更努力？是吗？可是啊，\n"
"已经到处都松垮垮了啊…"

#. ID 37, Page 2, Line 3, Pos (13,15)
msgid ""
"ああ？へへ、駄目だよお嬢ちゃん。\n"
"こんなとこきちゃ。\n"
"襲われちゃうよ？"
msgstr ""
"啊？嘿嘿，不行哦小姑娘。来这种地方。\n"
"会被袭击哦？"

#. ID 37, Page 3, Line 3, Pos (13,15)
msgid ""
"ああ？へへ、お嬢ちゃん黒の子？\n"
"駄目だよぉ、黒の子はちゃーんとお客さん\n"
"選ばないと、殺されちゃったりするよ？"
msgstr ""
"啊？嘿嘿，小姑娘是黑之女？不行哦，\n"
"黑之女要好好挑选客人，不然会被杀掉哦？"

#. ID 37, Page 3, Line 6, Pos (13,15)
msgid ""
"おじさんは危ない人だよぉー？\n"
"だから、\\.\\.とっとと失せろ、ゴミクズが！！"
msgstr ""
"大叔可是危险人物哦～？所以，\\.\\.赶紧滚开，\n"
"垃圾！！"

#. ID 37, Page 4, Line 3, Pos (13,15)
msgid ""
"ああ？へへ、お嬢ちゃん、どうしたの？\n"
"お客を探してるの？"
msgstr "啊？嘿嘿，小姑娘，怎么了？在找客人吗？"

#. ID 37, Page 4, Line 5, Pos (13,15)
msgid "でも駄目だよ、おじさんは変態だからね。"
msgstr "但是不行哦，大叔是变态呢。"

#. ID 38, Page 2, Line 3, Pos (9,10)
msgid "きゃはは、やだぁ"
msgstr "呀哈哈，不要啦"

#. ID 39, Page 3, Line 54, Pos (3,19)
msgid "目ぇ覚めた？おはよう！"
msgstr "醒了吗？早上好！"

#. ID 39, Page 3, Line 56, Pos (3,19)
msgid ""
"は！裸でうろついてるってことはよ、\n"
"期待してたんだろ？"
msgstr "哈！光着身子到处晃，就是说你在期待吧？"

#. ID 39, Page 3, Line 58, Pos (3,19)
msgid ""
"お望み通り犯しまくってやるよ、ボロボロに\n"
"なるまでな？"
msgstr "就按你希望的把你干个够，直到破破烂烂，知道吗？"

#. ID 39, Page 3, Line 63, Pos (3,19)
msgid ""
"これから、君をぉ、\n"
"ぼろぼろに犯しちゃいまーす！"
msgstr "接下来，我要把你～干得破破烂烂～！"

#. ID 39, Page 3, Line 65, Pos (3,19)
msgid "じゃ、頑張って、おまんこで奉仕してね？"
msgstr "那么，加油，用小穴来服务哦？"

#. ID 39, Page 3, Line 66, Pos (3,19)
msgid ""
"へへへ、さぁ、かわいいお便器ちゃ～ん\n"
"脱ぎ脱ぎしましょうねぇ～"
msgstr "嘿嘿嘿，来吧，可爱的小便器酱～脱掉脱掉吧～"

#. ID 39, Page 3, Line 73, Pos (3,19)
msgid ""
"ちっ！脱げねえのか！\n"
"まあいい、口でご奉仕しろよ！"
msgstr "啧！脱不掉吗！算了，用嘴来服务吧！"

#. ID 39, Page 3, Line 81, Pos (3,19)
msgid ""
"ヘへへへ…\n"
"じゃ、楽しませてもらうぜ？"
msgstr "嘿嘿嘿嘿…那么，让我享受一下吧？"

#. ID 39, Page 3, Line 113, Pos (3,19)
msgid ""
"はぁ～～～～～すっきりした。\n"
"ありがとよ、お便器ちゃん♪"
msgstr "哈～～～～～舒服了。谢啦，小便器酱♪"

#. ID 39, Page 3, Line 115, Pos (3,19)
msgid ""
"また催したら使ってやるからよ、\n"
"よろしくね～ん？"
msgstr "等我又想尿了会再用你的，请多关照～？"

#. ID 46, Page 2, Line 3, Pos (1,16)
msgid "ニク…"
msgstr "肉…"
