#. ID 43, Page 2, Line 4, Pos (8,9)
msgid ""
"名前：魔界兵・赤\n"
"種族：人男"
msgstr "名字：魔界兵·红种族：人男"

#. ID 43, Page 2, Line 6, Pos (8,9)
msgid ""
"魔界の兵士\n"
"炎の化身"
msgstr "魔界士兵火之化身"

#. ID 43, Page 2, Line 16, Pos (8,9)
msgid ""
"魔界の兵士\\!\n"
"炎の熱から作られたモンスター\\!\n"
"その性質故に氷属性に弱く、\n"
"若干攻撃力が高い"
msgstr ""
"魔界士兵\\!由火焰热量制成的怪物\\!因此性质上怕冰\n"
"属性，攻击力略高"

#. ID 43, Page 2, Line 20, Pos (8,9)
msgid ""
"強い連帯感を持っており、\n"
"仲間のために命をかけて戦う"
msgstr "拥有强烈连带感，为同伴拼死战斗"

#. ID 44, Page 2, Line 4, Pos (9,9)
msgid ""
"名前：魔界兵・青\n"
"種族：人男"
msgstr "名字：魔界兵·蓝种族：人男"

#. ID 44, Page 2, Line 6, Pos (9,9)
msgid ""
"魔界の兵士\n"
"水の化身"
