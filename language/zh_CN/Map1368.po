msgstr "\\C[9]黑暗枪手\\C[0]掉落\\C[2]\\N[101]\\C[0]"

#. ID 45, Page 2, Line 45, Pos (10,9)
msgid ""
"\\C[11]デスガンナー\\C[0]は\n"
"\\C[2]\\N[101]\\C[0]を落とす"
msgstr "\\C[11]死亡枪手\\C[0]掉落\\C[2]\\N[101]\\C[0]"

