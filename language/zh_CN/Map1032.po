#. ID 48, Page 2, Line 3, Pos (22,27)
msgid ""
"アラクネ\n"
"「繭になったニンゲンはじきに\n"
"　私たちの仲間になるの。\\.\\.\n"
"　きちんとお世話してあげないとね。"
msgstr ""
"阿剌克涅\n"
"「变成茧的人类很快就会　成为我们的同伴。\n"
"　\\.\\.　得好好照顾才行呢。"

#. ID 49, Page 2, Line 3, Pos (44,28)
msgid ""
"アラクネ\n"
"「一緒に女王様のために働きましょう。"
msgstr "阿剌克涅「一起为女王陛下工作吧。"

#. ID 57, Page 2, Line 3, Pos (33,25)
msgid ""
"アラクネ\n"
"「あなたがいればこの群れはもっと大きくなるわ。"
msgstr "阿剌克涅「有你在，这个群体会变得更大。"

#. ID 60, Page 2, Line 3, Pos (27,12)
msgid ""
"アラクネ\n"
"「ふふふっ…すっかりアラクネらしくなったわね"
msgstr "阿剌克涅「呵呵呵…完全变成阿剌克涅的样子了呢"

#. ID 61, Page 2, Line 3, Pos (42,9)
msgid ""
"アラクネ\n"
"「岩山の蟲は私たちにも襲い掛かってくるの。\\.\\.\n"
"　知能が低いから敵味方の区別もつかないのよね。"
msgstr ""
"阿剌克涅「岩山的虫也会袭击我们。\n"
"\\.\\.　因为智能低，连敌我都区分不了呢。"

#. ID 62, Page 2, Line 3, Pos (7,25)
msgid ""
"アラクネ\n"
"「zzz"
msgstr "阿剌克涅「zzz"

#. ID 63, Page 2, Line 3, Pos (38,41)
msgid ""
"アラクネ\n"
"「……これ？洞窟の中で捕らえたニンゲンよ。"
msgstr "阿剌克涅「……这个？是在洞窟里捕获的人类哦。"

#. ID 63, Page 2, Line 5, Pos (38,41)
msgid ""
"アラクネ\n"
"「生まれ変わる前の私と\n"
"　知り合いだったらしいのだけど\n"
"　全然憶えてないのよね。"
msgstr ""
"阿剌克涅\n"
"「听说是我转生之前认识的人　可是我完全不记得呢\n"
"　。"

#. ID 63, Page 2, Line 14, Pos (38,41)
msgid ""
"アラクネ\n"
"「安心して？\n"
"　あなたもすぐに私たちのようになれるから…♪"
msgstr "阿剌克涅「放心吧？　你也会很快变得像我们一样…♪"

#. ID 63, Page 2, Line 21, Pos (38,41)
msgid ""
"\n"
"「うう・・・いやぁ・・・・"
msgstr "「呜呜…不要啊……"

#. ID 64, Page 2, Line 3, Pos (38,42)
msgid "「うそ・・・こんなのうそよ・・・・。"
msgstr "「骗人…这种事是骗人的……。"
