#. ID 2, Page 10, Line 4, Pos (9,10)
msgid ""
"？？？\n"
"「そちか、久方ぶりじゃの。」"
msgstr "？？？「是你啊，好久不见了。」"

#. ID 2, Page 10, Line 13, Pos (9,10)
msgid ""
"？？？\n"
"「そうじゃ。わらわの袖の中に\n"
"　いつの間にかこんなものがあっての。」"
msgstr ""
"？？？「没错。\n"
"我的袖子里　不知什么时候有了这种东西。」"

#. ID 2, Page 10, Line 20, Pos (9,10)
msgid ""
"？？？\n"
"「宝石じゃ。魂みたいに美しいじゃろ？」"
msgstr "？？？「是宝石。像灵魂一样美丽吧？」"

#. ID 2, Page 10, Line 23, Pos (9,10)
msgid ""
"？？？\n"
"「まあ魂みたいとはいえ、所詮偽物じゃがな。\n"
"　わらわは本物にしか興味はござらん。」"
msgstr ""
"？？？「虽说像灵魂，但终究是假货。\n"
"　我只对真货感兴趣。」"

#. ID 2, Page 10, Line 27, Pos (9,10)
msgid ""
"\n"
"「この宝石、とってもきれい♪」"
msgstr "「这颗宝石，非常漂亮♪」"

#. ID 2, Page 10, Line 29, Pos (9,10)
msgid ""
"？？？\n"
"「なんじゃ、そち。\n"
"　まさかこの宝石が欲しいと申すか？」"
msgstr "？？？「什么啊，你。　难道说想要这颗宝石吗？」"

#. ID 2, Page 10, Line 32, Pos (9,10)
msgid ""
"？？？\n"
"「まあよい。どうせわらわには無用の長物じゃ。\n"
"　そちが持っていくのがよっぽどよかろう。」"
msgstr ""
"？？？「也罢。反正对我来说是毫无用处的东西。\n"
"　你拿走反而更好吧。」"

#. ID 2, Page 10, Line 36, Pos (9,10)
#. ID 3, Page 1, Line 609, Pos (8,21)
msgid ""
"\n"
"「やった♪」"
msgstr "「太好了♪」"

#. ID 2, Page 10, Line 44, Pos (9,10)
msgid ""
"？？？\n"
"「ところで、何か聞きたいことでもあるかの？」"
msgstr "？？？「话说回来，你有什么想问的吗？」"

#. ID 2, Page 10, Line 49, Pos (9,10)
#. Choice (4 options)
msgid ""
"あなたについて。\n"
"そこの彼について。\n"
"この場所について。\n"
"帰りたい。"
msgstr ""
"关于你。\n"
"关于那边的他。\n"
"关于这个地方。\n"
"我想回去。"

#. ID 2, Page 10, Line 51, Pos (9,10)
msgid ""
"？？？\n"
"「わらわの事、か。」"
msgstr "？？？「我的事，吗。」"

#. ID 2, Page 10, Line 53, Pos (9,10)
msgid ""
"？？？\n"
"「わらわはここで、こやつらをまとめておる。\n"
"　まあ、長のようなものじゃの。」"
msgstr ""
"？？？「我在这里统率着这些家伙。　嗯，\n"
"算是头领一样的存在吧。」"

#. ID 2, Page 10, Line 60, Pos (9,10)
#. ID 2, Page 10, Line 76, Pos (9,10)
msgid ""
"\n"
"「えっ、それだけ？」"
msgstr "「诶，就这些？」"

#. ID 2, Page 10, Line 62, Pos (9,10)
msgid ""
"？？？\n"
"「それだけじゃ。\n"
"　自身の事など、とうに忘れてしまったしのう。」"
msgstr ""
"？？？「就这些。　自己的事什么的，早就忘光了。\n"
"」"

#. ID 2, Page 10, Line 68, Pos (9,10)
msgid ""
"？？？\n"
"「今回の件、あやつが企てたようなのでな。\n"
"　わらわの気が晴れるまで、\n"
"　存分にこき使う事にしたのじゃ。」"
msgstr ""
"？？？「这次的事，好像是那家伙策划的。\n"
"　所以直到我心情舒畅为止，　我决定尽情使唤他。\n"
"　」"

#. ID 2, Page 10, Line 78, Pos (9,10)
msgid ""
"？？？\n"
"「それだけじゃ。\n"
"　あやつ自身の事なら、当人に聞けばよいじゃろ？」"
msgstr ""
"？？？「就这些。　那家伙自己的事，\n"
"直接问本人不就好了？」"

#. ID 2, Page 10, Line 84, Pos (9,10)
msgid ""
"？？？\n"
"「この場所か。\n"
"　………んー。」"
msgstr "？？？「这个地方吗。　………嗯——。」"

#. ID 2, Page 10, Line 88, Pos (9,10)
msgid ""
"？？？\n"
"「はて、何という名じゃったかのう。」"
msgstr "？？？「唔，叫什么名字来着。」"

#. ID 2, Page 10, Line 90, Pos (9,10)
msgid ""
"\n"
"「覚えてないのね。」"
msgstr "「你不记得了啊。」"

#. ID 2, Page 10, Line 92, Pos (9,10)
msgid ""
"？？？\n"
"「そうじゃの。\n"
"　忘れてしまったようじゃ。」"
msgstr "？？？「是啊。　好像已经忘了。」"

#. ID 2, Page 10, Line 95, Pos (9,10)
msgid ""
"？？？\n"
"「ただ、わらわがここにいる事には\n"
"　意味があったはずなんじゃ。」"
msgstr ""
"？？？「不过，我待在这里这件事，\n"
"　应该是有什么意义的。」"

#. ID 2, Page 10, Line 101, Pos (9,10)
msgid ""
"？？？\n"
"「そうかそうか。\n"
"　では地上まで送り届けようぞ。」"
msgstr "？？？「是吗是吗。　那我就送你到地面上吧。」"

#. ID 2, Page 10, Line 104, Pos (9,10)
#. ID 3, Page 1, Line 621, Pos (8,21)
msgid ""
"\\>？？？\n"
"\\>「さらばじゃ！！」\\<\\|\\^"
msgstr ""
"\\>？？？\n"
"\\>「再见啦！！」\\<\\|\\^"

#. ID 2, Page 10, Line 126, Pos (9,10)
msgid ""
"？？？\n"
"「ゆるりと過ごされよ。」"
msgstr "？？？「请悠闲地度过吧。」"

#. ID 3, Page 1, Line 9, Pos (8,21)
msgid ""
"\n"
"（さっきの声はこの人っぽい？）"
msgstr "（刚才的声音好像就是这个人？）"

#. ID 3, Page 1, Line 17, Pos (8,21)
msgid ""
"？？？\n"
"「ふぁわぁぁ～～～\n"
"　よく寝たのう……」"
msgstr "？？？「哈啊～～～　睡得真好啊……」"

#. ID 3, Page 1, Line 20, Pos (8,21)
msgid ""
"\n"
"（……何だろう、この雰囲気。）"
msgstr "（……怎么回事，这种氛围。）"

#. ID 3, Page 1, Line 26, Pos (8,21)
msgid ""
"？？？\n"
"「んー」"
msgstr "？？？「嗯——」"

#. ID 3, Page 1, Line 34, Pos (8,21)
msgid ""
"？？？\n"
"「おい、誰かおらぬのか。」"
msgstr "？？？「喂，没人在吗。」"

#. ID 3, Page 1, Line 54, Pos (8,21)
msgid ""
"\n"
"！！！"
msgstr ""
"\n"
"！！！"

#. ID 3, Page 1, Line 62, Pos (8,21)
msgid ""
"\n"
"（……何だろう？　怯えてる？）"
msgstr "（……怎么回事？　在害怕吗？）"

#. ID 3, Page 1, Line 69, Pos (8,21)
msgid ""
"？？？\n"
"「わらわが呼んだら、すぐに出てこぬか！！」"
msgstr "？？？「吾一呼唤，还不赶紧出来！！」"

#. ID 3, Page 1, Line 85, Pos (8,21)
msgid ""
"？？？\n"
"「まったく……怠けすぎじゃ。」"
msgstr "？？？「真是的……太懒散了。」"

#. ID 3, Page 1, Line 101, Pos (8,21)
msgid ""
"？？？\n"
"「ほれ、とっととせぬか。」"
msgstr "？？？「喂，还不快点做。」"

#. ID 3, Page 1, Line 113, Pos (8,21)
msgid ""
"\n"
"（器用に肩もんでる……）"
msgstr "（灵巧地揉着肩……）"

#. ID 3, Page 1, Line 119, Pos (8,21)
msgid ""
"？？？\n"
"「それにしても何じゃ？\n"
"　わらわの眠っておった間に、随分な荒れ様じゃ。」"
msgstr ""
"？？？「话说回来，怎么回事？　吾睡着的时候，\n"
"这里竟变得如此荒凉。」"

#. ID 3, Page 1, Line 127, Pos (8,21)
msgid ""
"？？？\n"
"「ほう……\n"
"　最近、外の者達が……のう？」"
msgstr "？？？「嚯……　最近，外面的人……是吧？」"

#. ID 3, Page 1, Line 139, Pos (8,21)
msgid ""
"\n"
"（あ、目が合っちゃった……）"
msgstr "（啊，对上视线了……）"

#. ID 3, Page 1, Line 141, Pos (8,21)
msgid ""
"？？？\n"
"「そういえば、そちは外の者じゃったな。」"
msgstr "？？？「说起来，你是外面的人来着。」"

#. ID 3, Page 1, Line 143, Pos (8,21)
msgid ""
"\n"
"「えーっと……」"
msgstr "「呃……」"

#. ID 3, Page 1, Line 145, Pos (8,21)
msgid ""
"？？？\n"
"「案ずるな。\n"
"　そちに危害を加える事はせぬぞ。」"
msgstr "？？？「不必担心。　吾不会加害于你。」"

#. ID 3, Page 1, Line 148, Pos (8,21)
msgid ""
"？？？\n"
"「そちはあの忌々しい封を\n"
"　解いてくれたのじゃからな。」"
msgstr "？？？「你可是解开了那个可恶的封印　所以啊。」"

#. ID 3, Page 1, Line 151, Pos (8,21)
msgid ""
"？？？\n"
"「礼を言うのが遅れたのう。　堪忍じゃ。\n"
"　そちには心から感謝しておるぞ。」"
msgstr ""
"？？？「道谢迟了呢。　请见谅。\n"
"　吾衷心地感谢你。」"

#. ID 3, Page 1, Line 155, Pos (8,21)
msgid ""
"？？？\n"
"「おかげでこの馬鹿どもに、\n"
"　これからたっぷりと仕置きができるのじゃからな。」"
msgstr ""
"？？？「多亏了你，这些笨蛋，\n"
"　吾接下来可以好好惩罚他们了。」"

#. ID 3, Page 1, Line 163, Pos (8,21)
msgid ""
"\n"
"（何となくだけど……\n"
"　凄く泣いてる気がする。）"
msgstr "（虽然只是感觉……　她好像哭得很厉害。）"

#. ID 3, Page 1, Line 166, Pos (8,21)
msgid ""
"\n"
"「えっと、何がどうなって……？」"
msgstr "「那个，到底是怎么回事……？」"

#. ID 3, Page 1, Line 168, Pos (8,21)
msgid ""
"？？？\n"
"「簡単な話じゃて。\n"
"　わらわはこやつらの事を\n"
"　大層可愛がっておったのじゃが……」"
msgstr ""
"？？？「说来简单。\n"
"　吾曾经非常疼爱这些家伙　可是……」"

#. ID 3, Page 1, Line 172, Pos (8,21)
msgid ""
"？？？\n"
"「こやつらときたら事もあろうに、\n"
"　わらわの昼寝中に封を施して\n"
"　閉じ込めおったのじゃ。」"
msgstr ""
"？？？「这些家伙啊，竟然趁吾午睡时施加封印，\n"
"　把吾关了起来。」"

#. ID 3, Page 1, Line 176, Pos (8,21)
msgid ""
"？？？\n"
"「こやつらにそんな芸なぞ\n"
"　できないはずなんじゃがの。」"
msgstr "？？？「这些家伙不该有那种本事　可是啊。」"

#. ID 3, Page 1, Line 179, Pos (8,21)
msgid ""
"？？？\n"
"「まったく、どこのどいつが企ておったのか。\n"
"　ふ、ふふ、ふふ……\n"
"　見つけたら永遠にこき使ってやろうぞ……？」"
msgstr ""
"？？？「真是的，到底是哪里的谁策划的。　呵、\n"
"呵呵、呵呵……　找到的话，吾要永远使唤他……？」"

#. ID 3, Page 1, Line 188, Pos (8,21)
msgid ""
"\n"
"（……………\\c[1]$d\\c[0]）"
msgstr ""
"\n"
"（……………\\c[1]$d\\c[0]）"

#. ID 3, Page 1, Line 195, Pos (8,21)
msgid ""
"？？？\n"
"「さてと……」"
msgstr "？？？「那么……」"

#. ID 3, Page 1, Line 202, Pos (8,21)
msgid ""
"？？？\n"
"「そちよ。」"
msgstr "？？？「你呀。」"

#. ID 3, Page 1, Line 204, Pos (8,21)
#. Contains choice at line 3 (2 options)
msgid ""
"？？？\n"
"「さくっと死んで、わらわに仕える気はないか？」\\!"
msgstr "？？？「干脆死掉，来侍奉吾，如何？」\\!"

#. ID 3, Page 1, Line 206, Pos (8,21)
#. Choice (2 options, embedded in a message)
msgid ""
"\\C[5]はい\n"
"\\C[0]………はい？"
msgstr ""
"\\C[5]是\n"
"\\C[0]………是？"

#. ID 3, Page 1, Line 208, Pos (8,21)
#. Contains choice at line 3 (2 options)
#. ID 3, Page 1, Line 433, Pos (8,21)
#. Contains choice at line 3 (2 options)
msgid ""
"\\c[5]？？？\n"
"「死んだら元には戻れぬが……別に構わんな？」\\!"
msgstr ""
"\\c[5]？？？「死了可就回不来了……你不介意吧？」\n"
"\\!"

#. ID 3, Page 1, Line 210, Pos (8,21)
#. Choice (2 options, embedded in a message)
#. ID 3, Page 1, Line 435, Pos (8,21)
#. Choice (2 options, embedded in a message)
msgid ""
"\\C[0]……やっぱり死にたくない！\n"
"\\C[5]はい、死なせてください"
msgstr ""
"\\C[0]……果然还是不想死！\n"
"\\C[5]是，请让我死吧"

#. ID 3, Page 1, Line 218, Pos (8,21)
msgid ""
"？？？\n"
"「そうかそうか。\n"
"　では早速、さくっとな。」"
msgstr ""
"？？？「这样啊这样啊。　那么赶紧，干脆地来吧。\n"
"」"

#. ID 3, Page 1, Line 242, Pos (8,21)
msgid ""
"\n"
"（あれ……？）"
msgstr "（咦……？）"

#. ID 3, Page 1, Line 244, Pos (8,21)
msgid ""
"？？？\n"
"「気分はどうじゃ？」"
msgstr "？？？「感觉如何？」"

#. ID 3, Page 1, Line 246, Pos (8,21)
msgid ""
"\n"
"「気分はって……」"
msgstr "「感觉如何……？」"

#. ID 3, Page 1, Line 253, Pos (8,21)
msgid ""
"\n"
"「はっ！？　体が透けてる！？」"
msgstr "「哈！？　身体变透明了！？」"

#. ID 3, Page 1, Line 255, Pos (8,21)
msgid ""
"？？？\n"
"「そりゃ、そうじゃろ。\n"
"　そちは器から抜け出たんじゃからな。」"
msgstr "？？？「那当然。　因为你从容器里出来了嘛。」"

#. ID 3, Page 1, Line 264, Pos (8,21)
msgid ""
"\n"
"「ていうか、そこにあるの、わたし！？」"
msgstr "「话说，那里躺着的，是我！？」"

#. ID 3, Page 1, Line 266, Pos (8,21)
msgid ""
"？？？\n"
"「そうじゃった。\n"
"　もう器は要らぬのう。」"
msgstr "？？？「是啊。　已经不需要容器了。」"

#. ID 3, Page 1, Line 269, Pos (8,21)
msgid ""
"？？？\n"
"「ほれ、お前達。\n"
"　後始末を始めんか。」"
msgstr "？？？「喂，你们。　还不开始收拾善后。」"

#. ID 3, Page 1, Line 281, Pos (8,21)
msgid ""
"\n"
"「えっ！　あっ！　ちょっと！！」"
msgstr "「诶！　啊！　等一下！！」"

#. ID 3, Page 1, Line 289, Pos (8,21)
msgid ""
"？？？\n"
"「そち、あまり見ぬ方が良いぞ？」"
msgstr "？？？「你最好别看比较好哦？」"

#. ID 3, Page 1, Line 299, Pos (8,21)
msgid ""
"？？？\n"
"「元いた器が朽ちていく様を見るのは、\n"
"　そちには少々きつかろうて。」"
msgstr ""
"？？？「看着原本的容器逐渐腐朽，\n"
"　对你来说有点难受吧。」"

#. ID 3, Page 1, Line 310, Pos (8,21)
msgid ""
"\n"
"「へ……うそ……\n"
"　肌が……髪が……」"
msgstr "「诶……骗人……　皮肤……头发……」"

#. ID 3, Page 1, Line 320, Pos (8,21)
msgid ""
"？？？\n"
"「やはり器は醜いものよのう。」"
msgstr "？？？「果然容器是丑陋的东西啊。」"

#. ID 3, Page 1, Line 327, Pos (8,21)
msgid ""
"\n"
"「あああ…………」"
msgstr "「啊啊啊…………」"

#. ID 3, Page 1, Line 338, Pos (8,21)
msgid ""
"\n"
"\\>「ぎゃああああああ！！\n"
"\\>　わたしがああああ！！」"
msgstr ""
"\\>「呀啊啊啊啊啊！！\n"
"\\>　我啊啊啊啊！！」"

#. ID 3, Page 1, Line 343, Pos (8,21)
msgid ""
"？？？\n"
"「ぎゃあぎゃあ喚くな。\n"
"　あれは最早ただの肉塊じゃ。」"
msgstr "？？？「别哇哇大叫。　那已经只是一块肉块了。」"

#. ID 3, Page 1, Line 352, Pos (8,21)
msgid ""
"？？？\n"
"「そんなに嘆かずとも、\n"
"　そちの魂はとても綺麗じゃ。」"
msgstr "？？？「不必那么悲伤，　你的灵魂非常美丽。」"

#. ID 3, Page 1, Line 355, Pos (8,21)
msgid ""
"？？？\n"
"「いずれは朽ち、醜く果てる器のことなぞ、\n"
"　とっとと忘れ去るのじゃ。」"
msgstr ""
"？？？「那种迟早会腐朽、丑陋地终结的容器，\n"
"　赶紧忘掉吧。」"

#. ID 3, Page 1, Line 366, Pos (8,21)
msgid ""
"\n"
"「うううう……」"
msgstr "「呜呜呜呜……」"

#. ID 3, Page 1, Line 368, Pos (8,21)
msgid ""
"？？？\n"
"「さてと、器の処分も終えた事じゃし、\n"
"　そちには足を揉んでもらおうかの。」"
msgstr ""
"？？？「那么，容器的处理也结束了，\n"
"　就让你来给吾揉脚吧。」"

#. ID 3, Page 1, Line 371, Pos (8,21)
msgid ""
"\n"
"「ううう……」\n"
"（早まったかもしれない……）"
msgstr "「呜呜呜……」（或许操之过急了……）"

#. ID 3, Page 1, Line 379, Pos (8,21)
msgid ""
"\n"
"こうして、霊体となった\\N[\\V[6]]は、\n"
"永遠にこき使われるハメになったとさ。\\.\\.\n"
"\\>　　　　　　　　　　　　　　　　　　　\\<\\s[20]おしまい。"
msgstr ""
"就这样，成为灵体的\\N[\\V[6]]，\n"
"落得永远被使唤的下场。\n"
"\\.\\.\\>　　　　　　　　　　　　　　　　　　　\\<\n"
"\\s[20]完。"

#. ID 3, Page 1, Line 387, Pos (8,21)
msgid ""
"\\>？？？\n"
"\\>「ほれ、とっとと始めんか！！」\\<\\|\\^"
msgstr ""
"\\>？？？\n"
"\\>「喂，还不快点开始！！」\\<\\|\\^"

#. ID 3, Page 1, Line 396, Pos (8,21)
msgid ""
"？？？\n"
"「そうかそうか。　では早速……」"
msgstr "？？？「这样啊这样啊。　那么赶紧……」"

#. ID 3, Page 1, Line 399, Pos (8,21)
msgid ""
"？？？\n"
"「\\>いやいやいやいやいやいや、\n"
"　ちょっと待って！」"
msgstr "？？？「\\>不不不不不不，　等一下！」"

#. ID 3, Page 1, Line 403, Pos (8,21)
msgid ""
"？？？\n"
"「ん？　なんじゃ？」"
msgstr "？？？「嗯？　怎么了？」"

#. ID 3, Page 1, Line 405, Pos (8,21)
msgid ""
"\n"
"「いきなり死ぬ気はあるかと言われても……」"
msgstr "「就算你突然问我有没有赴死的打算……」"

#. ID 3, Page 1, Line 408, Pos (8,21)
msgid ""
"？？？\n"
"「躊躇っておるのかの？\n"
"　なら安心せい、そちの魂を直接引き抜くだけじゃ。\n"
"　痛くも痒くもないぞ。」"
msgstr ""
"？？？「你在犹豫吗？　那就放心吧，\n"
"吾只是直接抽出你的灵魂。　既不痛也不痒哦。」"

#. ID 3, Page 1, Line 412, Pos (8,21)
msgid ""
"\n"
"「いやいやいや、痛いとかそういう事じゃ……\n"
"　まぁ、痛いのはヤだけど。」"
msgstr ""
"「不不不，不是痛不痛那种问题……　嘛，\n"
"痛的话还是算了。」"

#. ID 3, Page 1, Line 415, Pos (8,21)
msgid ""
"？？？\n"
"「それに今死ねば、\n"
"　永遠に若い姿のままでおられるのじゃぞ？」"
msgstr ""
"？？？「而且如果现在死掉，\n"
"　就能永远保持年轻的样子哦？」"

#. ID 3, Page 1, Line 418, Pos (8,21)
msgid ""
"\n"
"「う……\n"
"　それはちょっと惹かれなくも……」"
msgstr "「唔……　那确实有点让人心动……」"

#. ID 3, Page 1, Line 422, Pos (8,21)
msgid ""
"？？？\n"
"「そうじゃろ、そうじゃろ。\n"
"　ほれほれ、とっとと死を選んでしまえ。」"
msgstr "？？？「对吧，对吧。　来来，赶紧选择死亡吧。」"

#. ID 3, Page 1, Line 429, Pos (8,21)
#. Contains choice at line 3 (2 options)
msgid ""
"\n"
"死んでみますか？\\!"
msgstr "要试着死一下吗？\\!"

#. ID 3, Page 1, Line 431, Pos (8,21)
#. Choice (2 options, embedded in a message)
msgid ""
"\\C[5]はい\\C[0]\n"
"やめとく"
msgstr ""
"\\C[5]是\\C[0]\n"
"算了"

#. ID 3, Page 1, Line 446, Pos (8,21)
msgid ""
"？？？\n"
"「そうかそうか。\n"
"　では、さくっとな。」"
msgstr "？？？「这样啊这样啊。　那么，干脆地来吧。」"

#. ID 3, Page 1, Line 460, Pos (8,21)
msgid ""
"？？？\n"
"「ふむ……気に召さんか。\n"
"　そちに贈る、最上の礼のつもりじゃったが。」"
msgstr ""
"？？？「唔姆……不合心意吗。\n"
"　吾本打算作为送给你的最高谢礼。」"

#. ID 3, Page 1, Line 467, Pos (8,21)
msgid ""
"\n"
"（お礼が殺人って……）\n"
"「えっと、別にお礼とか要らないから、出口を……」"
msgstr ""
"（谢礼是杀人……）「那个，我不需要什么谢礼，\n"
"所以出口……」"

#. ID 3, Page 1, Line 470, Pos (8,21)
msgid ""
"？？？\n"
"「そちを地上へ送るなど、たやすい事じゃ。」"
msgstr "？？？「送你回地上这种事，轻而易举。」"

#. ID 3, Page 1, Line 479, Pos (8,21)
msgid ""
"？？？\n"
"「じゃがのう……\n"
"　そちに何の礼もせず帰すなぞ、\n"
"　わらわの矜持に反するのう……」"
msgstr ""
"？？？「但是呢……　让你什么谢礼都不给就回去，\n"
"　有违吾的矜持啊……」"

#. ID 3, Page 1, Line 483, Pos (8,21)
msgid ""
"\n"
"「そんな、気にしなくても……」"
msgstr "「那个，不用在意……」"

#. ID 3, Page 1, Line 493, Pos (8,21)
msgid ""
"？？？\n"
"「おお、そうじゃ。」"
msgstr "？？？「哦哦，对了。」"

#. ID 3, Page 1, Line 496, Pos (8,21)
msgid ""
"\n"
"（な、なんだろう……）"
msgstr "（怎、怎么回事……）"

#. ID 3, Page 1, Line 498, Pos (8,21)
msgid ""
"？？？\n"
"「確か以前、迷い込んだ外の者達が\n"
"　残していった物がいくつかあったのう。」"
msgstr ""
"？？？「记得以前，\n"
"迷路进来的外来者　留下了几样东西来着。」"

#. ID 3, Page 1, Line 501, Pos (8,21)
msgid ""
"？？？\n"
"「その中から１つをそちに与えよう。\n"
"　それでどうじゃ？」"
msgstr "？？？「就从里面拿一个给你吧。　这样如何？」"

#. ID 3, Page 1, Line 504, Pos (8,21)
msgid ""
"\n"
"「じゃあ、それで。」"
msgstr "「那就这样吧。」"

#. ID 3, Page 1, Line 506, Pos (8,21)
msgid ""
"？？？\n"
"「そうかそうか。\n"
"　では、どれか１つを選ぶのじゃ。」"
msgstr ""
"？？？「原来如此原来如此。　那么，\n"
"就从中选一个吧。」"

#. ID 3, Page 1, Line 513, Pos (8,21)
#. Choice (4 options)
msgid ""
"ソウルポット8ｘ１\n"
"ステータス増加系(ランダム)\n"
"お金\n"
"妖蝶のドレス(清楚・マゾ＋)"
msgstr ""
"灵魂壶8x1\n"
"状态提升类(随机)\n"
"金钱\n"
"妖蝶礼服(清纯・受虐＋)"

#. ID 3, Page 1, Line 532, Pos (8,21)
#. Choice (3 options)
msgid ""
"ソウルポット16ｘ２\n"
"プライムブルーｘ１\n"
"クリスタルのかけらｘ１"
msgstr ""
"灵魂壶16x2\n"
"原初蓝x1\n"
"水晶碎片x1"

#. ID 3, Page 1, Line 548, Pos (8,21)
#. Contains choice at line 3 (2 options)
msgid ""
"？？？\n"
"「本当にそれで良いんじゃな？」"
msgstr "？？？「真的这样就可以了吗？」"

#. ID 3, Page 1, Line 550, Pos (8,21)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"違うのにする"
msgstr ""
"是\n"
"换别的"

#. ID 3, Page 1, Line 554, Pos (8,21)
msgid ""
"？？？\n"
"「そうかそうか。\n"
"　では、選びなおすのじゃ。」"
msgstr ""
"？？？「原来如此原来如此。　那么，\n"
"重新选一次吧。」"

#. ID 3, Page 1, Line 568, Pos (8,21)
msgid ""
"\n"
"\\N[101]\\N[102]\\N[103]\\N[104]を\\V[786]個手に入れた。"
msgstr "\\N[101]\\N[102]\\N[103]\\N[104]获得了\\V[786]个。"

#. ID 3, Page 1, Line 573, Pos (8,21)
msgid ""
"\n"
"所持金が\\V[786]増えた。"
msgstr "所持金钱增加了\\V[786]。"

#. ID 3, Page 1, Line 582, Pos (8,21)
msgid ""
"？？？\n"
"「それではそちを地上へ送り届けようぞ。」"
msgstr "？？？「那么，就送你到地面上吧。」"

#. ID 3, Page 1, Line 589, Pos (8,21)
msgid ""
"？？？\n"
"「さらばじゃ……」"
msgstr "？？？「就此别过……」"

#. ID 3, Page 1, Line 591, Pos (8,21)
msgid ""
"？？？\n"
"「……んっ？　袖の中がなんかモゾモゾするぞ。\n"
"　なんじゃこりゃ。」"
msgstr ""
"？？？「……嗯？　袖子里好像有什么东西在蠕动。\n"
"　这是啥玩意儿。」"

#. ID 3, Page 1, Line 599, Pos (8,21)
msgid ""
"？？？\n"
"「これは魂！　……ではなさそうじゃの。\n"
"　なんじゃ。ただの宝石か……。」"
msgstr ""
"？？？「这是灵魂！　……似乎并不是啊。　什么呀。\n"
"只是宝石吗……。」"

#. ID 3, Page 1, Line 602, Pos (8,21)
msgid ""
"\n"
"「宝石のほうが、嬉しいような……」"
msgstr "「宝石反而更让人高兴……」"

#. ID 3, Page 1, Line 605, Pos (8,21)
msgid ""
"？？？\n"
"「なんと！　それなら、この魂……いや宝石も\n"
"　そちに差し上げよう。ほれ、遠慮は要らぬ。」"
msgstr ""
"？？？「什么！　那样的话，这个灵魂……不，\n"
"宝石也　送给你吧。喏，不必客气。」"

#. ID 3, Page 1, Line 616, Pos (8,21)
msgid ""
"？？？\n"
"「では今度こそ……」"
msgstr "？？？「那么，这次可真的……」"

#. ID 82, Page 2, Line 3, Pos (5,14)
msgid ""
"？？？\n"
"「やあ、君かい。」"
msgstr "？？？「哟，是你啊。」"

#. ID 82, Page 2, Line 5, Pos (5,14)
msgid ""
"？？？\n"
"「まったく、君のおかげで散々な目にあったよ！」"
msgstr "？？？「真是的，托你的福，我可吃尽了苦头！」"

#. ID 82, Page 2, Line 7, Pos (5,14)
msgid ""
"？？？\n"
"「本当は今すぐにでも呪ってやりたいけど、\n"
"　君に手を出したら今度は何をされるか……」"
msgstr ""
"？？？「其实我现在就想诅咒你，\n"
"　但要是对你出手，这次不知道会被怎样……」"

#. ID 82, Page 2, Line 10, Pos (5,14)
msgid ""
"？？？\n"
"「くっそーーー！！」"
msgstr "？？？「可恶———！！」"

#. ID 82, Page 2, Line 17, Pos (5,14)
msgid ""
"？？？\n"
"「あっ、ちょっと！！\n"
"　まだ愚痴足りないんだけど！！」"
msgstr "？？？「啊，等等！！　我还没抱怨够呢！！」"

#. ID 82, Page 2, Line 20, Pos (5,14)
msgid ""
"\n"
"（……放っておこう。）"
msgstr "（……随他去吧。）"
