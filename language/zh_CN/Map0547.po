#. ID 2, Page 2, Line 102, Pos (0,1)
#. ID 7, Page 2, Line 86, Pos (15,7)
msgid ""
"よくやった！試験は合格だ。\n"
"今後は３階への通行が可能となる。\n"
"これからもがんばりなさい。"
msgstr ""
"干得好！考试合格。今后可以通往3楼。\n"
"以后也要努力。"

#. ID 2, Page 2, Line 110, Pos (0,1)
#. ID 7, Page 2, Line 94, Pos (15,7)
msgid "なんだもう限界か…情けない"
msgstr "什么啊已经到极限了吗……真丢人"

#. ID 2, Page 2, Line 112, Pos (0,1)
#. ID 2, Page 2, Line 132, Pos (0,1)
#. ID 7, Page 2, Line 96, Pos (15,7)
#. ID 7, Page 2, Line 115, Pos (15,7)
msgid "残念だが不合格だ次でがんばりなさい"
msgstr "很遗憾不合格，下次努力"

#. ID 2, Page 2, Line 131, Pos (0,1)
#. ID 7, Page 2, Line 114, Pos (15,7)
msgid "タイムアップだ"
msgstr "时间到了"

#. ID 10, Page 1, Line 8, Pos (9,7)
msgid ""
"教師「ふふふふふふ。\n"
"　　　つぐみ君。\\!\n"
"　　　君は本当にどうしようもないメスブタだな！」"
msgstr ""
"老师「呵呵呵呵呵呵。\n"
"　　　鸫同学。\\!\n"
"　　　你真是个无可救药的母猪啊！」"

#. ID 10, Page 1, Line 24, Pos (9,7)
msgid ""
"あはあああああ！！\\!\n"
"ごめんなさいいぃぃっ！！"
msgstr "啊哈啊啊啊啊啊！！\\!对不起呀呀呀！！"

#. ID 10, Page 1, Line 33, Pos (9,7)
msgid ""
"教師「その歳で！\\!　その身体で！\\!\n"
"　　　自ら男を誘い！\\!　むさぼるように腰を振る！」"
msgstr ""
"老师「以那个年纪！\\!　用那副身体！\\!\n"
"　　　主动引诱男人！\\!　像贪婪一样扭腰！」"

#. ID 10, Page 1, Line 45, Pos (9,7)
msgid ""
"ひやあああぁぁっ！！\\!\n"
"だめぇ、だめらのおぉっ！！"
msgstr "呀啊啊啊啊啊！！\\!不行、不行的啊！！"

#. ID 10, Page 1, Line 50, Pos (9,7)
msgid ""
"教師「しかもムチを振れば滴るのは\n"
"　　　愛液ときたもんだ。\\!\n"
"　　　随分な淫乱っぷりだなあ？」"
msgstr ""
"老师「而且一挥鞭就滴下来的竟然是\n"
"　　　爱液。\\!\n"
"　　　相当淫乱啊？」"

#. ID 10, Page 1, Line 60, Pos (9,7)
msgid ""
"ああはああぁっ！\\!\n"
"……はあっ、はあっ。\n"
"だってぇ、わたし\n"
"そういうふうにされたからぁ……"
msgstr ""
"啊啊哈啊啊！\\!……哈啊、哈啊。因为、\n"
"我被那样对待了嘛……"

#. ID 10, Page 1, Line 70, Pos (9,7)
msgid "ひひゃあああぁぁぁっ！？！？"
msgstr "嘻呀啊啊啊啊啊啊！？！？"

#. ID 10, Page 1, Line 81, Pos (9,7)
msgid ""
"教師「ふふふ。\\!\n"
"　　　確か○リーパーさまに\n"
"　　　初めてをすべて捧げたんだったか」"
msgstr ""
"老师「呵呵呵。\\!\n"
"　　　我记得确实把所有的第一次都献给了○梦貘人\n"
"　　　大人了吧」"

#. ID 10, Page 1, Line 88, Pos (9,7)
msgid ""
"はいぃ。\n"
"キスも、前の穴も、後の穴も、全部ですぅ。"
msgstr "是的。吻、前面的洞、后面的洞，全部都是。"

#. ID 10, Page 1, Line 100, Pos (9,7)
msgid ""
"教師「そうかそうか。\n"
"　　　うむ、確かに君は優秀な生徒だな。\\!\n"
"　　　これなら接待のほうも期待できるな」"
msgstr ""
"老师「是吗是吗。\n"
"　　　嗯，你确实是优秀的学生啊。\\!\n"
"　　　这样的话招待方面也可以期待了」"

#. ID 10, Page 1, Line 107, Pos (9,7)
msgid ""
"はいぃ。\n"
"ありがとうございまふぅ。"
msgstr "是的。谢谢您。"

#. ID 10, Page 1, Line 119, Pos (9,7)
msgid ""
"教師「ろれつがまわってないな。\n"
"　　　イキたいか？」"
msgstr ""
"老师「口齿都不清了。\n"
"　　　想高潮吗？」"

#. ID 10, Page 1, Line 124, Pos (9,7)
msgid ""
"はいっ、イカせて下さい……。\\!\n"
"先生のでたくさん突いて、\n"
"つぐみの中にたくさん下さいいぃぃ！"
msgstr ""
"是的、请让我高潮……。\\!请用老师的多多地顶、\n"
"请多多地给鸫里面呀呀呀！"

#. ID 10, Page 1, Line 137, Pos (9,7)
msgid ""
"教師「ぐうううっ……！！\\!\n"
"　　　ほれ！　褒美だメスブタ！！！！」"
msgstr ""
"老师「咕呜呜呜……！！\\!\n"
"　　　来！　这是奖赏，母猪！！！！」"

#. ID 10, Page 1, Line 146, Pos (9,7)
msgid ""
"イクッ……！！！\\!\n"
"んはああああああああああ\n"
"あああああああはあああああぁぁっっ！！！"
msgstr ""
"要去了……！！！\n"
"\\!嗯哈啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊哈啊\n"
"啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！！"

#. ID 10, Page 1, Line 166, Pos (9,7)
msgid ""
"あはあぁっ……。\\!\n"
"つぐみのなか、せいしでいっぱいぃ……。"
msgstr "啊哈啊……。\\!鸫的里面，精液满满的……。"

#. ID 10, Page 1, Line 182, Pos (9,7)
#. ID 11, Page 1, Line 222, Pos (50,9)
msgid "……つぐみ……。"
msgstr "……鸫……。"

#. ID 11, Page 1, Line 9, Pos (50,9)
msgid ""
"兵士１「おああああっ、すげえ締まりだ……！！\\!\n"
"　　　　おい、この女マジでスゲエよ！\n"
"　　　　ガキのくせにテクまでありやがるぜ！」"
msgstr ""
"士兵1「哦啊啊啊啊，好紧啊……！！\\!\n"
"　　　　喂，这女的真的超厉害啊！\n"
"　　　　明明是个小鬼，技术居然这么好啊！」"

#. ID 11, Page 1, Line 23, Pos (50,9)
msgid ""
"あはあああああ！！\\!\n"
"いいっ！！\n"
"お兄さんのつぐみの奥まできてるのおぉ！！」"
msgstr ""
"啊哈啊啊啊啊啊！！\\!好棒！！\n"
"大哥哥的那个都到鸫的深处了哦！！」"

#. ID 11, Page 1, Line 37, Pos (50,9)
msgid ""
"兵士２「ぬおおおおい！\n"
"　　　　さっさと変わって欲しいであります！」"
msgstr ""
"士兵2「唔哦哦哦哦！\n"
"　　　　快点换我上啊！」"

#. ID 11, Page 1, Line 39, Pos (50,9)
msgid ""
"兵士３「てめえさっきはロリに興味ないとか\n"
"　　　　言ってたじゃねーか！\\!\n"
"　　　　俺が先だ！！」"
msgstr ""
"士兵3「你这家伙刚才不是说对萝莉没兴趣吗！\n"
"　　　　\\!　　　　我先来！！」"

#. ID 11, Page 1, Line 42, Pos (50,9)
msgid ""
"兵士２「むぐぐ！\n"
"　　　　ああ、失敗であります！！」"
msgstr ""
"士兵2「唔咕咕！\n"
"　　　　啊，失策了！！」"

#. ID 11, Page 1, Line 53, Pos (50,9)
msgid ""
"んっっ、ああんっ！\\!\n"
"そんなに焦らなくても、あんっ……！\n"
"大丈夫だ、よっ。"
msgstr ""
"嗯嗯、啊嗯！\\!不用那么着急，啊嗯……！没关系的，\n"
"哟。"

#. ID 11, Page 1, Line 57, Pos (50,9)
msgid "兵士１２３「ああん？」"
msgstr "士兵123「啊嗯？」"

#. ID 11, Page 1, Line 69, Pos (50,9)
msgid ""
"だってわたし、んうっ、前の穴も\\!\n"
"上のお口も、あはんっ！\\!\n"
"あっ、お尻の穴も、ぜんぶ大丈夫だからっ"
msgstr ""
"因为我呀，嗯唔，前面的洞也\\!上面的嘴也，\n"
"啊哈嗯！\\!啊，屁股的洞也，全都没问题的"

#. ID 11, Page 1, Line 77, Pos (50,9)
msgid ""
"兵士１２３「マ、マジかよ。\n"
"　　　　　　こんなガキが……」"
msgstr ""
"士兵123「真、真的假的。\n"
"　　　　　　这样的小鬼……」"

#. ID 11, Page 1, Line 84, Pos (50,9)
msgid ""
"ふふっ……、ん、はんっ！\\!\n"
"だから、誰も待たなくていいんですよ？"
msgstr "呵呵……、嗯、哈嗯！\\!所以说，谁都不用等哦？"

#. ID 11, Page 1, Line 90, Pos (50,9)
msgid ""
"その言葉を皮切りに、理性が崩壊した男達は\n"
"乱暴につぐみの身体へと、己のモノを捻じ込んだ"
msgstr ""
"以那句话为开端，\n"
"理性崩溃的男人们粗暴地将自己的东西塞进了鸫的身\n"
"体"

#. ID 11, Page 1, Line 103, Pos (50,9)
msgid ""
"んっ！　ちゅぱっ！　ぢゅぱっ\\!\n"
"んむううっ！　あ、はんっ　ぢゅるっ\\!\n"
"じゅぷっ　ぐぷっ　にちゃ　ずぢゅるうっ"
msgstr ""
"嗯！　啾啪！　啾啪！\\!嗯唔唔唔！　啊、\n"
"哈嗯　啾噜！\\!啾噗　咕噗　黏糊　滋啾噜噜"

#. ID 11, Page 1, Line 116, Pos (50,9)
msgid ""
"聞こえる音は、肉棒がつぐみをかき回す音\\!\n"
"４人の荒々しい息遣い\\!\n"
"小さな身体に見合わぬモノを咥え込んでいるからか、\n"
"つぐみは苦痛とも快楽ともいえぬ顔をしていた"
msgstr ""
"能听到的声音，\n"
"是肉棒搅动鸫的声音\\!四个男人粗重的喘息\\!也许是\n"
"因为含着与小小身体不相称的东西，\n"
"鸫露出了不知是痛苦还是快乐的表情"

#. ID 11, Page 1, Line 131, Pos (50,9)
msgid ""
"兵士１２３「うあっ！！　ああっ！　いくぞっ！\\!\n"
"　　　　　　そのまま中でいいんだろ！！？\n"
"#{    ああああっ！　イクッ！！」"
msgstr ""
"士兵123「呜啊！！　啊啊！　要射了！\\!\n"
"　　　　　　就这样射在里面可以吧！！？#{\n"
"啊啊啊啊！　要去了！！」"

#. ID 11, Page 1, Line 143, Pos (50,9)
msgid ""
"兵士達は同時に限界を迎えるらしい\\!\n"
"仲良し３人組だな\\!\n"
"あのまま生で中出しするようだ\\!\n"
"フェラで答えないつぐみの瞳には嫌悪の色は無かった"
msgstr ""
"士兵们似乎同时迎来了极限\\!真是关系好的三人组啊\\!\n"
"　看样子就那样无套内射了\\!因口交而无法回应的鸫，\n"
"　眼中没有厌恶之色"

#. ID 11, Page 1, Line 148, Pos (50,9)
msgid ""
"んううううううううっ！！\\!\n"
"んむうううううぅぅぅっ！！！！"
msgstr ""
"嗯呜呜呜呜呜呜呜！！\\!嗯唔呜呜呜呜呜呜呜！！！\n"
"！"

#. ID 11, Page 1, Line 177, Pos (50,9)
msgid ""
"ん……こくっ\\!\n"
"どうやら口に出された白濁液は飲み込んだようだった\\!\n"
"逆にいまごろ下の二つの穴では\n"
"白濁液の逆流が始まっていそうだ"
msgstr ""
"嗯……咕咚！\n"
"\\!看来被射在嘴里的白浊液已经咽下去了\\!相反，\n"
"现在下面两个洞里，白浊液似乎开始逆流了"

#. ID 11, Page 1, Line 187, Pos (50,9)
msgid "キレイキレイにしますね……？"
msgstr "我会清理得干干净净哦……？"

#. ID 11, Page 1, Line 191, Pos (50,9)
msgid ""
"そう言ってつぐみは３人の肉棒を掃除していく\\!\n"
"もちろん口を使ってだ\\!\n"
"随分たまっていたのか、それともつぐみの魅力なのか\n"
"再びそれらはそそりたっていた"
msgstr ""
"这么说着，\n"
"鸫开始清理三个人的肉棒\\!当然是用嘴\\!是积攒了相\n"
"当多吗，还是因为鸫的魅力，那些东西再次挺立起来"

#. ID 11, Page 1, Line 200, Pos (50,9)
msgid ""
"あはぁ……。\n"
"またおっきくなってるぅ……。"
msgstr "啊哈……。又变得这么大……。"

#. ID 11, Page 1, Line 202, Pos (50,9)
msgid ""
"わたし、男の人に気持ち良くなって\n"
"もらうの好きなんです。\\!\n"
"つぐみにまた、いっぱい出して下さいね？\\!\n"
"精子いっぱい欲しいんです……。"
