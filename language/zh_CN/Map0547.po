#. ID 2, Page 1, Line 88, Pos (0,1)
#. ID 7, Page 1, Line 79, Pos (15,7)
msgid "そこまで！"
msgstr "到此为止！"

#. ID 2, Page 1, Line 89, Pos (0,1)
#. ID 7, Page 1, Line 80, Pos (15,7)
msgid "さて試験の結果だが…"
msgstr "那么考试的结果是……"

#. ID 2, Page 1, Line 91, Pos (0,1)
#. ID 7, Page 1, Line 82, Pos (15,7)
msgid ""
"\\v[1202]点で合格だ！\n"
"おめでとう！"
msgstr "\\v[1202]分合格！恭喜！"

#. ID 2, Page 1, Line 93, Pos (0,1)
#. ID 7, Page 1, Line 84, Pos (15,7)
msgid ""
"今後は２階への通行が許可される\n"
"がんばりなさい…"
msgstr "今后允许通往2楼，请继续努力……"

#. ID 2, Page 1, Line 98, Pos (0,1)
#. ID 7, Page 1, Line 89, Pos (15,7)
msgid ""
"\\v[1202]点で不合格だ…\n"
"残念だが…次でがんばってくれたまえ"
msgstr "\\v[1202]分不合格……很遗憾……下次请努力"

#. ID 2, Page 1, Line 101, Pos (0,1)
#. ID 2, Page 2, Line 114, Pos (0,1)
#. ID 2, Page 2, Line 134, Pos (0,1)
#. ID 7, Page 1, Line 92, Pos (15,7)
#. ID 7, Page 2, Line 98, Pos (15,7)
#. ID 7, Page 2, Line 117, Pos (15,7)
msgid ""
"と…思ったが…\n"
"君はあまりにも出来が悪すぎる。\n"
"君ではス○ーパー様のめがねにかなわぬだろう…"
msgstr ""
"我……本来这么想……但你实在太差劲了。\n"
"你恐怕无法让斯○帕大人看上吧……"

#. ID 2, Page 1, Line 104, Pos (0,1)
#. ID 2, Page 2, Line 117, Pos (0,1)
#. ID 2, Page 2, Line 137, Pos (0,1)
#. ID 7, Page 1, Line 95, Pos (15,7)
#. ID 7, Page 2, Line 101, Pos (15,7)
#. ID 7, Page 2, Line 120, Pos (15,7)
msgid ""
"しかたない…\n"
"君は今後はトイレ委員だ…\n"
"せめて少しでも役に立ちたまえ"
msgstr "没办法……你今后是厕所委员……至少尽量有点用吧"

#. ID 2, Page 2, Line 4, Pos (0,1)
#. ID 7, Page 2, Line 2, Pos (15,7)
msgid "では、２次試験を始める。"
msgstr "那么、开始2次考试。"

#. ID 2, Page 2, Line 5, Pos (0,1)
#. ID 7, Page 2, Line 3, Pos (15,7)
msgid ""
"２次試験はマゾヒズムだ\n"
"簡単に根をあげるようでは真のマゾとはいえない\n"
"君にはこれから、私の責めに耐えてもらう"
msgstr ""
"2次考试是受虐狂。\n"
"轻易投降的话可不能说是真正的受虐狂。\n"
"你接下来要忍受我的责罚。"

#. ID 2, Page 2, Line 8, Pos (0,1)
#. ID 7, Page 2, Line 6, Pos (15,7)
msgid ""
"耐え切れなければ不合格だ。\n"
"わかりやすいだろう…？"
msgstr "如果无法忍受就是不合格。很容易理解吧……？"

#. ID 2, Page 2, Line 16, Pos (0,1)
#. ID 7, Page 2, Line 11, Pos (15,7)
msgid ""
"＊説明\n"
"表示される数字と同じ数字を選択する\n"
"正解すればダメージは1ですむ。それだけ"
msgstr ""
"＊说明选择与显示数字相同的数字。\n"
"答对的话伤害只需1。仅此而已"

#. ID 2, Page 2, Line 19, Pos (0,1)
#. ID 7, Page 2, Line 14, Pos (15,7)
msgid ""
"＊説明\n"
"ただし、３回失敗する、又は時間内に10回回答できなか\n"
"った場合不合格になります"
msgstr ""
"＊说明但是，失败3次，\n"
"或在时间内未能回答10次的话就会不合格"

#. ID 2, Page 2, Line 25, Pos (0,1)
#. ID 7, Page 2, Line 18, Pos (15,7)
msgid "では始めるぞ…"
msgstr "那么开始吧……"

#. ID 2, Page 2, Line 37, Pos (0,1)
#. ID 7, Page 2, Line 27, Pos (15,7)
msgid "\\v[1203]"
msgstr "\\v[1203]"

