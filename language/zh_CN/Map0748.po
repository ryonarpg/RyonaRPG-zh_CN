#. ID 44, Page 2, Line 8, Pos (9,24)
#. ChangeHeroName (Actor 115)
msgctxt "actors.name"
msgid "end:ミュロンド"
msgstr "end:米隆德"

#. ID 44, Page 3, Line 3, Pos (9,24)
msgid "＊扉は固く閉ざされている。"
msgstr "＊门紧紧地关闭着。"

#. ID 46, Page 1, Line 4, Pos (13,23)
msgid "＊………"
msgstr "＊………"

#. ID 46, Page 1, Line 8, Pos (13,23)
msgid "＊ミュロンド死霊館13代目領主　モルドバ"
msgstr "＊米隆德死灵馆第13代领主　莫尔多瓦"

#. ID 46, Page 1, Line 11, Pos (13,23)
msgid ""
"＊……この肖像画の女性が、\n"
"　この洋館の最後の主だったようだ。"
msgstr ""
"＊……这幅肖像画中的女性，\n"
"　似乎是这座洋馆最后的主人。"

#. ID 57, Page 2, Line 3, Pos (15,29)
msgid ""
"＊大分古い日記帳だ。\\.\\.\n"
"　花柄とウサギのイラストが表紙に描かれている。\\.\\.\\.\n"
"　名前欄には「モルドバ」と書かれていた。"
msgstr ""
"＊相当古老的日记本。\n"
"　\\.\\.　封面上画着花纹和兔子的插图。\n"
"　\\.\\.\\.　名字栏里写着「莫尔多瓦」。"

#. ID 57, Page 2, Line 12, Pos (15,29)
msgid ""
"＊今日も雨が降る…\\.\\.雨の日は憂鬱だ。\\.\\.\n"
"　地面がぬかるんで服に泥が跳ねる。"
msgstr ""
"＊今天也下雨…\\.\\.雨天令人忧郁。\n"
"　\\.\\.　地面泥泞，泥巴溅到衣服上。"

#. ID 57, Page 2, Line 14, Pos (15,29)
msgid ""
"＊……でも、\\.\\.泥くらいは関係ないか。\\.\\.\n"
"　私を訪ねてくる人なんていないんだから。\\.\\.\\.\n"
"　汚れていても問題ない。\\.\n"
"　いっそ裸で過ごしたって構わないかもしれない。"
msgstr ""
"＊……不过，\\.\\.泥巴之类无所谓吧。\n"
"　\\.\\.　反正没人会来拜访我。\n"
"　\\.\\.\\.　弄脏了也没关系。\n"
"　\\.　干脆光着身子过日子说不定也没关系。"

#. ID 57, Page 2, Line 24, Pos (15,29)
#. ID 57, Page 2, Line 37, Pos (15,29)
msgid "＊今日も誰も来ない。"
msgstr "＊今天也没有人来。"

#. ID 57, Page 2, Line 25, Pos (15,29)
msgid ""
"＊雑草はまだ大分残っている。\\.\\.\\.\n"
"　そろそろ鎌を研ぎなおさないと…\\.\\.…\\.\\.\\.\n"
"　切れ味が悪くなってきた"
msgstr ""
"＊杂草还剩下相当多。\n"
"　\\.\\.\\.　差不多得重新磨镰刀了…\\.\\.…\n"
"　\\.\\.\\.　刀刃变钝了"

#. ID 57, Page 2, Line 28, Pos (15,29)
msgid ""
"＊誰かが手伝ってくれれば…\\.\\.…\\.\\.\\.\n"
"　父様がまだご存命なら、\n"
"　こんなこと苦でもなんでもないのに。"
msgstr ""
"＊要是有人能来帮忙就好了…\\.\\.…\n"
"　\\.\\.\\.　要是父亲大人还活着，\n"
"　这种事根本不算什么苦。"

#. ID 57, Page 2, Line 38, Pos (15,29)
msgid ""
"＊最近からだの具合が悪い。\\.\\.\\.\n"
"　風邪でも引いてしまったのかも…\\.\\.…\\.\\.\\.\n"
"　早く治さないと、\\.\\.草むしりは待ってくれない"
msgstr ""
"＊最近身体不太舒服。\\.\\.\\.　也许是感冒了…\\.\\.…\n"
"　\\.\\.\\.　不早点治好可不行，\\.\\.除草可不会等我"

#. ID 57, Page 2, Line 47, Pos (15,29)
msgid ""
"＊熱が引かない…\\.\\.…\\.\\.\\.\n"
"　ただの風邪じゃないのかしら\\.\\.\\.\n"
"　身体がだるい…\\.…\\.\\.頭がぼーっとする。"
msgstr ""
"＊烧一直不退…\\.\\.…\n"
"　\\.\\.\\.　难道不是普通感冒吗\\.\\.\\.　身体乏力…\\.…\n"
"　\\.\\.脑袋昏昏沉沉的。"

#. ID 57, Page 2, Line 50, Pos (15,29)
msgid ""
"＊それでも\\.\\.お墓に花だけはあげないと…\\.\\.…\\.\\.\\.\n"
"　確か、庭で育てていた鬼灯がそろそろ見頃のはずだ。"
msgstr ""
"＊即便如此\\.\\.至少得给坟墓献花…\\.\\.…\n"
"　\\.\\.\\.　记得院子里种的酸浆差不多该到观赏期了。"

#. ID 57, Page 2, Line 58, Pos (15,29)
msgid ""
"＊もう\\.\\.身体が動かせない…\\.\\.…\\.\\.\\.\n"
"　私は　\\|死んで\\.\\.\\.しまうのかしら"
msgstr ""
"＊已经\\.\\.身体动不了了…\\.\\.…\n"
"　\\.\\.\\.　我　\\|会死\\.\\.\\.去吗"

#. ID 57, Page 2, Line 60, Pos (15,29)
msgid ""
"＊後悔は　　　\\|もちろんある\\.\\.\\.、けど\\.\\.\n"
"　だれかが　\\.\\.\\.お墓の世話をしないと\\.\\.\\.\n"
"　いけなかった"
msgstr ""
"＊后悔是　　　\\|当然有的\\.\\.\\.，\n"
"　不过\\.\\.　必须有人　\\.\\.\\.来照看坟墓\\.\\.\\.　才\n"
"　行"

#. ID 57, Page 2, Line 63, Pos (15,29)
msgid ""
"＊それが　わたしだったから\\.\\.\\.\n"
"　しかたない\\|\n"
"　でも\\.\\.誰かと　\\|\\.\\.恋とか\\.\\.したか\\.　た"
msgstr ""
"＊因为那个人就是我\\.\\.\\.　没办法\\|　但是\\.\\.我\n"
"　也想和谁　\\|\\.\\.谈一场恋爱\\.　啊"

#. ID 57, Page 2, Line 83, Pos (15,29)
msgid ""
"＊この　日記をもし　よんだひと\\.\\.\\.\n"
"　どうか　\\.\\.わたしのからだを\\|\n"
"　にわに\\|うめて　ください"
msgstr ""
"＊如果　有人读到了　这本日记\\.\\.\\.　请务必　\\.\n"
"　\\.把我的身体\\|　埋进院子\\|里　拜托"

#. ID 57, Page 2, Line 92, Pos (15,29)
msgid ""
"＊残りのページは………\\.\\.\\.\n"
"　涙の痕がついているだけだ。"
msgstr "＊剩下的书页………\\.\\.\\.　只有泪痕。"
