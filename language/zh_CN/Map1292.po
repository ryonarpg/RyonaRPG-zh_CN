#. ID 31, Page 2, Line 4, Pos (17,4)
msgid ""
"名前：盗賊\n"
"種族：人男"
msgstr "名字：盗贼 种族：人男"

#. ID 31, Page 2, Line 6, Pos (17,4)
#. ID 31, Page 2, Line 15, Pos (17,4)
msgid "盗みを働くタイプの悪い奴"
msgstr "会干偷盗勾当的那种坏家伙"

#. ID 31, Page 2, Line 7, Pos (17,4)
#. Contains choice at line 3 (2 options)
msgid ""
"\\$600Gで攻略情報を聞くことができます\n"
"聞きますか？"
msgstr "用\\$600G可以打听攻略情报。要打听吗？"

#. ID 31, Page 2, Line 9, Pos (17,4)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"はい"
msgstr ""
"否\n"
"是"

#. ID 31, Page 2, Line 16, Pos (17,4)
msgid ""
"触れるとポーションとかお金とか\n"
"盗まれるぞ\\!\n"
"しかも、たまに服とか剥ぎ取ってくる"
msgstr ""
"一碰就会偷走药水、金钱之类的东西\\!而且，\n"
"偶尔还会把衣服之类剥走"

#. ID 31, Page 2, Line 19, Pos (17,4)
msgid ""
"奪われたアイテムは5秒以内に叩けば\n"
"取り返せるぞ"
msgstr "被夺走的物品，只要在5秒内敲击就能夺回"

#. ID 31, Page 2, Line 21, Pos (17,4)
msgid ""
"仮に取り返せなくても、\n"
"再度購入できる場所があるらしい\\!\n"
"東方大陸のヒドゥンという街に…？"
msgstr ""
"就算夺不回来，\n"
"据说也有可以再次购买的地方\\!在东方大陆一个叫希\n"
"顿的城镇里……？"

#. ID 31, Page 2, Line 24, Pos (17,4)
msgid "ルックスもイケメンだ"
msgstr "长相也很帅"
