#. ID 58, Page 2, Line 33, Pos (29,1)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "胸元に飛びつ"
msgstr "朝胸口扑"

#. ID 58, Page 2, Line 28, Pos (29,1)
#. ChangeHeroName (Actor 102)
msgctxt "actors.name"
msgid "いてきた！"
msgstr "了过来！"

#. ID 58, Page 2, Line 34, Pos (29,1)
#. ChangeHeroName (Actor 102)
msgctxt "actors.name"
msgid "き、衣服の中"
msgstr "然后，衣服里面"

#. ID 58, Page 2, Line 35, Pos (29,1)
#. ChangeHeroName (Actor 103)
msgctxt "actors.name"
msgid "に入り込んで"
msgstr "钻进去"

#. ID 58, Page 2, Line 36, Pos (29,1)
#. ChangeHeroName (Actor 104)
msgctxt "actors.name"
msgid "くる！"
msgstr "来了！"

#. ID 58, Page 2, Line 39, Pos (29,1)
#. Contains choice at line 3 (2 options)
msgid "\\n[101]\\n[102]\\n[103]\\n[104]\n"
msgstr ""
"\\n[101]\\n[102]\\n[103]\\n[104]\n"
""

