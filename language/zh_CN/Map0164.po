#. Choice (2 options, embedded in a message)
msgid ""
"様子を見る\n"
"払い落す"
msgstr ""
"查看情况\n"
"拂落"

#. ID 58, Page 2, Line 64, Pos (29,1)
msgid "……\\!……。"
msgstr "……\\!……。"

#. ID 58, Page 2, Line 82, Pos (29,1)
msgid ""
"乳首を探していたように見えた。\\!\n"
"もしかしたらこの仔が…？"
msgstr "看起来像是在找乳头。\\!难道说这只幼崽是……？"

#. ID 58, Page 2, Line 86, Pos (29,1)
msgid "……\\!……！"
msgstr "……\\!……！"

#. ID 58, Page 2, Line 106, Pos (29,1)
msgid ""
"おっぱいが欲しいようだ。\\!\n"
"もしかしたらこの仔が…？"
msgstr "好像是想要吃奶。\\!难道说这只幼崽是……？"

#. ID 58, Page 2, Line 112, Pos (29,1)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "おっぱいを吸"
msgstr "吃奶"

#. ID 58, Page 2, Line 113, Pos (29,1)
#. ChangeHeroName (Actor 102)
msgctxt "actors.name"
msgid "わせる"
msgstr "让它吃"

#. ID 58, Page 2, Line 114, Pos (29,1)
#. ChangeHeroName (Actor 103)
msgctxt "actors.name"
msgid "何もしない"
msgstr "什么都不做"

#. ID 58, Page 2, Line 117, Pos (29,1)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "このまま吸わ"
msgstr "就这样吸"

#. ID 58, Page 2, Line 118, Pos (29,1)
#. ChangeHeroName (Actor 102)
msgctxt "actors.name"
msgid "せる"
msgstr "让它"

#. ID 58, Page 2, Line 119, Pos (29,1)
#. ChangeHeroName (Actor 103)
msgctxt "actors.name"
msgid "そっと剥がす"
msgstr "轻轻拉开"

#. ID 58, Page 2, Line 123, Pos (29,1)
#. Contains choice at line 2 (3 options)
#. ID 58, Page 3, Line 40, Pos (29,1)
#. Contains choice at line 2 (3 options)
