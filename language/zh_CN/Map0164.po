#. ID 12, Page 2, Line 3, Pos (10,22)
#. ID 16, Page 2, Line 3, Pos (9,22)
#. ID 17, Page 2, Line 3, Pos (8,22)
msgid "遺骨を手に入れた。"
msgstr "获得了遗骨。"

#. ID 18, Page 2, Line 3, Pos (18,3)
msgid "処女一番搾りを手に入れた。"
msgstr "获得了处女初榨。"

#. ID 57, Page 3, Line 7, Pos (29,0)
#. Contains choice at line 3 (2 options)
msgid "……\\!この群れの中に産んだ仔がいるかもしれない。\n"
msgstr "……\\!也许这个群体里有它生下的幼崽。"

#. ID 57, Page 3, Line 9, Pos (29,0)
#. Choice (2 options, embedded in a message)
msgid ""
"\\>武装を解いて仔を探す\n"
"\\>構うものか"
msgstr ""
"\\>解除武装去寻找幼崽\n"
"\\>管他呢"

#. ID 57, Page 3, Line 12, Pos (29,0)
msgid "この状態で探すのは困難だろう。"
msgstr "以这种状态寻找会很困难吧。"

#. ID 57, Page 3, Line 18, Pos (29,0)
msgid ""
"もしランドレイの成体に組み敷かれたら、\n"
"抵抗することさえできないだろう。"
msgstr ""
"如果被兰德雷的成体压在身下，\n"
"恐怕连抵抗都做不到吧。"

#. ID 57, Page 3, Line 20, Pos (29,0)
#. Contains choice at line 3 (2 options)
msgid "それでも？\n"
msgstr "即便如此？"

#. ID 57, Page 3, Line 22, Pos (29,0)
#. Choice (2 options, embedded in a message)
msgid ""
"\\>…仔を探す\n"
"\\>やめておこう"
msgstr ""
"\\>…寻找幼崽\n"
"\\>还是算了吧"

#. ID 57, Page 3, Line 28, Pos (29,0)
msgid "……\\!行こう。"
msgstr "……\\!走吧。"

#. ID 57, Page 3, Line 38, Pos (29,0)
msgid "気の迷いだ。\\!魔物に情など……。"
msgstr "只是一时糊涂。\\!对魔物动什么感情……。"

#. ID 57, Page 4, Line 8, Pos (29,0)
#. ID 57, Page 7, Line 2, Pos (29,0)
msgid ""
"この状態ではランドレイたちを刺激してしまう。\\!\n"
"引き返そう。"
msgstr "在这种状态下会刺激到兰德雷们。\\!回去吧。"

#. ID 57, Page 4, Line 20, Pos (29,0)
#. ID 58, Page 2, Line 276, Pos (29,1)
#. ID 58, Page 3, Line 267, Pos (29,1)
msgid "…………。"
msgstr "…………。"

#. ID 57, Page 4, Line 26, Pos (29,0)
msgid "……行こう。"
msgstr "……走吧。"

#. ID 57, Page 4, Line 29, Pos (29,0)
msgid ""
"ランドレイの成体に気をつけて、\n"
"通り過ぎればいい。"
msgstr "小心兰德雷的成体，穿过去就好。"

#. ID 57, Page 5, Line 3, Pos (29,0)
#. ID 58, Page 6, Line 3, Pos (29,1)
msgid "デバッグがんばれ～。"
msgstr "调试加油～。"

#. ID 58, Page 2, Line 5, Pos (29,1)
#. ID 58, Page 3, Line 5, Pos (29,1)
msgid "……\\!……！！"
msgstr "……\\!……！！"

