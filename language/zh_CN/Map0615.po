#. ID 4, Page 2, Line 2, Pos (18,17)
#. ID 5, Page 2, Line 2, Pos (19,17)
msgid "鍵がかかっている。"
msgstr "上锁了。"

#. ID 6, Page 1, Line 2, Pos (18,30)
#. Contains choice at line 2 (2 options)
#. ID 6, Page 3, Line 2, Pos (18,30)
#. Contains choice at line 2 (2 options)
#. ID 7, Page 1, Line 2, Pos (19,30)
#. Contains choice at line 2 (2 options)
msgid "戻りますか？"
msgstr "要回去吗？"

#. ID 6, Page 1, Line 3, Pos (18,30)
#. Choice (2 options, embedded in a message)
#. ID 6, Page 3, Line 3, Pos (18,30)
#. Choice (2 options, embedded in a message)
#. ID 7, Page 1, Line 3, Pos (19,30)
#. Choice (2 options, embedded in a message)
#. ID 20, Page 1, Line 17, Pos (38,4)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 6, Page 2, Line 1, Pos (18,30)
#. ID 7, Page 2, Line 1, Pos (19,30)
msgid "もう後には退けない。"
msgstr "已经无法后退了。"

#. ID 10, Page 2, Line 2, Pos (32,4)
msgid "ヒヒ……ここは見張り台だよ。"
msgstr "嘻嘻……这里是瞭望台哦。"

#. ID 10, Page 3, Line 2, Pos (32,4)
msgid ""
"盗人……？\n"
"いや、気づかなかったねぇ……"
msgstr "盗贼……？不，我没注意到呢……"

#. ID 10, Page 4, Line 1, Pos (32,4)
msgid ""
"むぅ………\n"
"やはりあいつらが…………"
msgstr "唔………果然是那帮家伙…………"

#. ID 10, Page 5, Line 2, Pos (32,4)
msgid ""
"デイジーの方は\n"
"どうするつもりなのかねぇ…"
msgstr "黛西那边打算怎么办啊……"

#. ID 10, Page 6, Line 2, Pos (32,4)
msgid ""
"敵襲……？\n"
"いや、見なかったけどね……"
msgstr "敌袭……？不，我没看见呢……"

#. ID 10, Page 6, Line 6, Pos (32,4)
msgid "……………いい気味さ。"
msgstr "……………活该。"

#. ID 10, Page 7, Line 2, Pos (32,4)
msgid "料理長、謹慎になったんだって？"
msgstr "厨师长，听说被处分禁闭了？"

#. ID 10, Page 7, Line 5, Pos (32,4)
msgid ""
"まいったね。あいつの料理の腕は認めてた\n"
"んだよお？"
msgstr "真头疼啊。我可是一直认可那家伙的厨艺哦？"

#. ID 10, Page 8, Line 2, Pos (32,4)
msgid "なにやら嵐の予感だね。"
msgstr "总觉得有种暴风雨将至的预感呢。"

#. ID 10, Page 10, Line 1, Pos (32,4)
msgid "……………………"
msgstr "……………………"

#. ID 11, Page 1, Line 2, Pos (2,4)
msgid "今日も異常なしっと。"
msgstr "今天也没有异常。"

#. ID 11, Page 2, Line 2, Pos (2,4)
msgid ""
"度重なる賊の狼藉………\n"
"私は知っている。これは内部の者による\n"
"犯行だ。\n"
"見張りの私に落ち度はなかったはずだ……"
msgstr ""
"接连不断的贼人暴行………我知道。\n"
"这是内部之人所为。负责看守的我应该没有过失……"

#. ID 11, Page 3, Line 2, Pos (2,4)
msgid ""
"確かにエルフたちなら犯行は可能だろう…\n"
"しかし、わざわざ日を空けたのは何故だ？\n"
"リスクを考えるなら、一度にやった方が\n"
"失敗は少ないだろう……"
msgstr ""
"确实，如果是那些精灵的话，作案是可能的……但是，\n"
"为什么特意隔了几天？考虑到风险，\n"
"一次做完失败会更少吧……"

#. ID 11, Page 3, Line 7, Pos (2,4)
msgid ""
"逃げるための手はずとして、内部に仲間が\n"
"残っていないと成り立たないとか……"
msgstr ""
"作为逃跑的安排，\n"
"如果内部没有留下同伴就不成立之类的……"

#. ID 11, Page 3, Line 10, Pos (2,4)
msgid ""
"じゃあ…\n"
"あの妹が犯行に及ぶのはもう不可能か……"
msgstr "那么……那个妹妹再作案已经不可能了吗……"

#. ID 11, Page 3, Line 13, Pos (2,4)
msgid ""
"いや……まだ１人いるな……彼女と親しい\n"
"人間……"
msgstr "不……还有一个人吧……和她亲近的人……"

#. ID 11, Page 4, Line 2, Pos (2,4)
msgid "金庫破りに続いて敵との遭遇か…………"
msgstr "继撬金库之后又遭遇敌人吗…………"

#. ID 11, Page 4, Line 3, Pos (2,4)
msgid "こりゃ、なんだか事件の予感だね……"
msgstr "这可真是，总觉得有案件的预感呢……"

#. ID 11, Page 5, Line 2, Pos (2,4)
msgid ""
"相次ぐ事件。\n"
"そのどれについても、見張りの私は\n"
"気づけなかった……"
msgstr ""
"接连发生的事件。无论哪一件，\n"
"负责看守的我都未能察觉……"

#. ID 11, Page 5, Line 5, Pos (2,4)
msgid "私も……次はないと思わないと……"
msgstr "我也……必须认为没有下次了……"

#. ID 11, Page 6, Line 2, Pos (2,4)
msgid ""
"なんか最近落ち着かないね。\n"
"こういう時こそ、普段通りに役割を果たす\n"
"のが大切なんだよ。"
msgstr ""
"最近总觉得心神不宁呢。正是这种时候，\n"
"像平时一样履行好职责才重要。"

#. ID 11, Page 6, Line 6, Pos (2,4)
msgid ""
"でも……\n"
"見張りやってるけど敵襲も金庫破りも\n"
"気づかなかった……"
msgstr "可是……虽然我在看守，却没察觉到敌袭和金库被撬……"

#. ID 11, Page 6, Line 9, Pos (2,4)
msgid ""
"減給された。職務怠慢という警告だろう。\n"
"ブライへの信頼を汚してしまった。\n"
"もう…次はない……"
msgstr ""
"被减薪了。这大概是对玩忽职守的警告吧。\n"
"我玷污了布莱对我的信任。已经……没有下次了……"

#. ID 11, Page 8, Line 1, Pos (2,4)
msgid "わっ！？"
msgstr "哇！？"

#. ID 11, Page 8, Line 3, Pos (2,4)
msgid ""
"夜の見張りは正直恐い。\n"
"おばけじゃなく、奇襲の発見が勝敗に直結するからだ。"
msgstr ""
"夜里看守老实说很可怕。不是因为妖怪，\n"
"而是因为发现奇袭会直接关系到胜败。"

#. ID 11, Page 8, Line 6, Pos (2,4)
msgid "断じておばけが恐いわけではない。"
msgstr "绝对不是怕妖怪。"

#. ID 11, Page 10, Line 2, Pos (2,4)
msgid ""
"私たちが釈放されて戻って来た時には、\n"
"所々傷んでいた他は特に変わったところは\n"
"なかった。"
msgstr ""
"当我们被释放回来时，除了各处有些损坏之外，\n"
"没有特别变化的地方。"

#. ID 11, Page 10, Line 5, Pos (2,4)
msgid ""
"ただ、\n"
"血の臭いは完全に拭えてはいなかった。"
msgstr "只是，血腥味并没有完全被擦掉。"

#. ID 11, Page 10, Line 7, Pos (2,4)
msgid ""
"残っていたはずの者はほとんど転属に\n"
"なっていた。\n"
"ここから導かれる結論は……"
msgstr "本应留下的人几乎都被调走了。由此得出的结论是……"

#. ID 12, Page 1, Line 2, Pos (31,19)
#. ID 12, Page 2, Line 2, Pos (31,19)
msgid ""
"堀にあるあの渦は、水を循環させるための\n"
"ものよ。\n"
"あのまま下水まで落ちていくの。"
msgstr ""
"护城河里的那个漩涡，是为了让水循环的哦。\n"
"会就那样一直落进下水道。"

#. ID 12, Page 2, Line 6, Pos (31,19)
msgid ""
"あそこから中に侵入……\\!\n"
"ダメね。できたとしても出られないわ。"
msgstr ""
"从那里侵入内部……\\!不行呢。\n"
"就算做得到也出不来哦。"

#. ID 12, Page 3, Line 2, Pos (31,19)
msgid "…………私、何も見てないもん。"
msgstr "…………我什么都没看见嘛。"

#. ID 12, Page 3, Line 3, Pos (31,19)
msgid ""
"犯人はエルフに決まってるのに動かない\n"
"人が悪いのよ。"
msgstr "犯人明明肯定是精灵，是那些不行动的人不好哦。"

#. ID 12, Page 4, Line 2, Pos (31,19)
msgid ""
"昨夜、敵が現れたそうです。\n"
"遭遇した私たちの兵士が応戦し、\n"
"重症を負ったものの、\n"
"なんとか撃退したとのことです。"
msgstr ""
"听说昨晚出现了敌人。遭遇的我们的士兵应战，\n"
"虽然身负重伤，但总算击退了。"

#. ID 12, Page 5, Line 2, Pos (31,19)
msgid ""
"ブライは確かに名門ですが、\n"
"ブライの誰かが世界一強いなどとは思って\n"
"いませんよ。"
msgstr ""
"布莱确实是名门，\n"
"但我并不认为布莱中的某个人是世界上最强的哦。"

#. ID 12, Page 5, Line 5, Pos (31,19)
msgid ""
"名門でなくとも腕の立つ人はいます。\n"
"例えば教官……教官とうちの師範……\n"
"一体どっちが強いのか……"
msgstr ""
"即使不是名门，也有身手高强的人。比如教官……\n"
"教官和我们师父……到底哪个更强呢……"

#. ID 12, Page 5, Line 9, Pos (31,19)
msgid ""
"遠征と聞いて、ふとそんな考えが頭を\n"
"過ぎりました。"
msgstr "听到远征，这种念头忽然从我脑中闪过。"

#. ID 12, Page 6, Line 1, Pos (31,19)
msgid ""
"ちょっとちょっと……\n"
"ブライさんたちが罷免って……\n"
"これって大丈夫なの……？"
msgstr "等等等等……布莱他们被罢免……这没问题吗……？"

#. ID 12, Page 8, Line 5, Pos (31,19)
msgid "いや……あたま……真っ白になる…………"
msgstr "不……脑子……变得一片空白…………"

#. ID 12, Page 9, Line 2, Pos (31,19)
msgid ""
"明らかに襲われた形跡があるのですが……\n"
"決して口外するな、と。"
msgstr "明明有被袭击的明显痕迹……却说要绝对保密。"

#. ID 13, Page 2, Line 10, Pos (0,9)
msgid ""
"大丈夫かい？傭兵さんともあろう人が、\n"
"そんな無茶な飲み方しちゃダメだよ？"
msgstr "没事吧？像佣兵这样的人，可不能那样乱喝哦？"

#. ID 13, Page 2, Line 13, Pos (0,9)
msgid ""
"辛いことがあったら、食堂に来なよ。\n"
"おいしい料理くらいなら出してあげられる\n"
"と思うからさ？"
msgstr ""
"如果有难受的事，就来食堂吧。\n"
"至少美味的料理我还是能给你端出来的？"

#. ID 13, Page 2, Line 22, Pos (0,9)
msgid "どうだい？少しは落ちついたかい？"
msgstr "怎么样？稍微冷静下来了吗？"

#. ID 13, Page 2, Line 25, Pos (0,9)
#. Contains choice at line 2 (2 options)
msgid "頃合いだろう……"
msgstr "差不多是时候了吧……"

#. ID 13, Page 2, Line 27, Pos (0,9)
#. Choice (2 options, embedded in a message)
msgid ""
"口を封じつつ鳩尾一発！\n"
"いや、後ろから羽交い締めだ！"
msgstr ""
"一边封住嘴一边朝心窝一拳！\n"
"不，从后面反剪双臂制住！"

#. ID 13, Page 2, Line 35, Pos (0,9)
msgid "顔色悪いけど、大丈夫そう……"
msgstr "脸色很差，但看起来没事……"

#. ID 13, Page 2, Line 39, Pos (0,9)
msgid ""
"ん…………！？\n"
"\n"
"………ん…………"
msgstr "嗯…………！？………嗯…………"

#. ID 13, Page 2, Line 50, Pos (0,9)
msgid "…………！！"
msgstr "…………！！"

#. ID 13, Page 2, Line 57, Pos (0,9)
#. ID 13, Page 2, Line 119, Pos (0,9)
msgid "よし、あとは担ぎ出すだけだ。"
msgstr "好，接下来只要扛出去就行了。"

#. ID 13, Page 2, Line 76, Pos (0,9)
msgid "うん、なんとか大丈夫そうだね。"
msgstr "嗯，总算看起来没事呢。"

#. ID 13, Page 2, Line 78, Pos (0,9)
msgid ""
"じゃあ、私はもう行くけど、傭兵さんは\n"
"しばらくここで涼んでいるといいよ。"
msgstr "那么，我要走了，佣兵就在这里凉快一会儿吧。"

#. ID 13, Page 2, Line 89, Pos (0,9)
msgid "……………！！"
msgstr "……………！！"

#. ID 13, Page 2, Line 91, Pos (0,9)
msgid "んん………んんん！！！"
msgstr "嗯嗯………嗯嗯嗯！！！"

#. ID 13, Page 2, Line 97, Pos (0,9)
msgid ""
"ん………\n"
"　　　　　　　　んん…………！！！"
msgstr ""
"嗯………\n"
"　　　　　　　　嗯嗯…………！！！"

#. ID 13, Page 2, Line 104, Pos (0,9)
msgid ""
"ん………\n"
"\n"
"………ん"
msgstr "嗯………………嗯"

#. ID 13, Page 2, Line 112, Pos (0,9)
msgid "\\s[2]・・・・・・・・・・・・・・・"
msgstr "\\s[2]・・・・・・・・・・・・・・・"

#. ID 13, Page 2, Line 131, Pos (0,9)
msgid "もう後には退けない！"
msgstr "已经无法后退了！"

#. ID 14, Page 1, Line 2, Pos (39,18)
#. ID 15, Page 1, Line 106, Pos (38,18)
msgid "お姉ちゃんたちは……やってないもん……"
msgstr "姐姐她们……没有做嘛……"

#. ID 15, Page 1, Line 5, Pos (38,18)
msgid ""
"おい、とぼけんなよ。\\!\n"
"おめえの姉ちゃんたちがやったんだろ？"
msgstr "喂，别装傻啊。\\!是你姐姐她们干的吧？"

#. ID 15, Page 1, Line 10, Pos (38,18)
msgid ""
"ち……違います！\n"
"お姉ちゃんたちは……やってない！！"
msgstr "不……不是的！姐姐她们……没有做！！"

#. ID 15, Page 1, Line 14, Pos (38,18)
msgid ""
"「ち……違います！\n"
"　お姉ちゃんたちは……やってない！！」\\!\n"
"\n"
"だってさあ？"
msgstr ""
"「不……不是的！　姐姐她们……没有做！！」\n"
"　\\!她是这么说的哦？"

#. ID 15, Page 1, Line 19, Pos (38,18)
msgid ""
"悪いことした人は、皆そう言うよねえ……\\!\n"
"じゃあ……\n"
"なんで君のお姉ちゃんは消えたのさ？"
msgstr ""
"做了坏事的人，都会这么说呢……\\!那么……\n"
"为什么你的姐姐会不见呢？"

#. ID 15, Page 1, Line 24, Pos (38,18)
msgid "そ……それは…………"
msgstr "那……那个…………"

#. ID 15, Page 1, Line 27, Pos (38,18)
msgid ""
"プッ……\n"
"あれれ～？答えられないんだあ？\\!\n"
"それは嘘でも何か用意しとかないと\n"
"不味かったんじゃないのお？"
msgstr ""
"噗……哎呀呀～？答不上来了呀？\\!就算是撒谎，\n"
"不事先准备点什么可就不妙了吧？"

#. ID 15, Page 1, Line 32, Pos (38,18)
msgid ""
"そんな必要ないです！\n"
"お姉ちゃんたちはやってない。\n"
"私は信じてる！"
msgstr "没有那个必要！姐姐她们没有做。我相信！"

#. ID 15, Page 1, Line 37, Pos (38,18)
msgid ""
"信じてる！\\!\n"
"で、まかり通れば世話ないって。\n"
"どこからくるのかな、その自信？"
msgstr ""
"相信！\\!可是要是这都能混过去，那可就真没辙了。\n"
"那份自信到底是从哪来的呢？"

#. ID 15, Page 1, Line 41, Pos (38,18)
msgid "ああ、ひょっとしてあれかな？"
msgstr "啊，莫非是那个吗？"

#. ID 15, Page 1, Line 42, Pos (38,18)
msgid ""
"本当は君が犯人で、お姉ちゃんたちに罪を\n"
"擦り付けるためにどっかに埋めちゃって、\n"
"ほとぼりが冷めたら\n"
"自分もとんずらするつもりとか……"
msgstr ""
"其实你才是犯人，\n"
"为了把罪嫁祸给姐姐她们就把她们埋到什么地方，\n"
"等风声过了自己也打算溜之大吉之类的……"

#. ID 15, Page 1, Line 48, Pos (38,18)
msgid ""
"君、とんだ悪女だねえ！\n"
"姉たちすら利用するんだ。"
msgstr "你真是个不得了的恶女呢！连姐姐们都要利用。"

#. ID 15, Page 1, Line 52, Pos (38,18)
msgid "そんなことしてません！！！"
msgstr "我没有做那种事！！！"

#. ID 15, Page 1, Line 55, Pos (38,18)
msgid ""
"キヒヒ…口ではなんとでも言えるよねえ…\n"
"まあ、それは私にも言えることだけど。"
msgstr ""
"嘻嘻嘻……嘴上怎么说都行呢……不过，\n"
"这话对我也一样适用。"

#. ID 15, Page 1, Line 58, Pos (38,18)
msgid ""
"もう荷物まとめて出て行った方が\n"
"いいんじゃないの～？\n"
"立場ないんじゃない？"
msgstr ""
"你还是赶紧收拾行李走人比较好吧～？\n"
"你待着也没立场了吧？"

#. ID 15, Page 1, Line 63, Pos (38,18)
msgid ""
"私は逃げません！！\n"
"お姉ちゃんたちが戻って来たとき、\n"
"私がいなかったらガッカリするわ！！"
msgstr ""
"我不会逃的！！姐姐她们回来的时候，要是我不在，\n"
"她们会失望的！！"

#. ID 15, Page 1, Line 68, Pos (38,18)
msgid ""
"こいつは傑作だわ！\n"
"まだ、お姉ちゃんたちが戻って来ると\n"
"思っているなんてね！！"
msgstr "这可真是杰作！居然还以为姐姐她们会回来呢！！"

#. ID 15, Page 1, Line 73, Pos (38,18)
msgid ""
"残念だけど、現実は非情なの。\n"
"君、そんなんだからお姉ちゃんたちに\n"
"置いていかれたのかもね？"
msgstr ""
"很遗憾，现实是无情的。你呀，\n"
"说不定就是因为这样才被姐姐她们抛下的哦？"

#. ID 15, Page 1, Line 78, Pos (38,18)
msgid ""
"お姉ちゃんは\n"
"やってないって言ってるでしょ！！"
msgstr "我都说了姐姐没有做！！"

#. ID 15, Page 1, Line 82, Pos (38,18)
msgid ""
"やれやれ……\n"
"君はさっきからずっとそうね。"
msgstr "哎呀呀……你从刚才起就一直这么说呢。"

#. ID 15, Page 1, Line 86, Pos (38,18)
msgid "＊おい、そっちにいるのか？"
msgstr "＊喂，你在那边吗？"

#. ID 15, Page 1, Line 92, Pos (38,18)
msgid "まずいね、料理長だよ。"
msgstr "不妙，是厨师长。"

#. ID 15, Page 1, Line 98, Pos (38,18)
msgid ""
"じゃあ、あんたもちゃんと\n"
"身の振り方考えとくんだよお……"
msgstr "那么，你也好好考虑一下自己的打算吧……"

#. ID 15, Page 1, Line 120, Pos (38,18)
msgid "なんだい、今取り込み中だよ。"
msgstr "什么事啊，我现在正忙着呢。"

#. ID 16, Page 2, Line 1, Pos (14,19)
msgid ""
"ふああ……\n"
"おっといけない。急な出番で眠気が……"
msgstr "哈啊……哎呀，不好。突然轮到我出场，困意都……"

#. ID 17, Page 1, Line 2, Pos (4,19)
msgid ""
"甘ったるい臭いが立ちこめている。\\!\n"
"なんだか変な気分になってきた。"
msgstr "甜腻的气味弥漫着。\\!总觉得变得奇怪起来了。"

#. ID 17, Page 1, Line 6, Pos (4,19)
msgid "よし、ここでいいだろう。"
msgstr "好，这里应该可以吧。"

#. ID 17, Page 1, Line 18, Pos (4,19)
msgid "あまり長居しない方がよさそうだ……"
msgstr "最好不要待太久……"

#. ID 18, Page 1, Line 1, Pos (22,5)
msgid "最初は、事務だって聞いて来たのに！"
msgstr "我一开始听说只是事务工作才来的！"

#. ID 20, Page 1, Line 3, Pos (38,4)
msgid ""
"彼女は行ったのだろうか……はは…………\n"
"もう……何も見えないや…………"
msgstr "她走了吗……哈哈…………已经……什么都看不见了…………"

#. ID 20, Page 1, Line 7, Pos (38,4)
msgid ""
"風が気持ちいいなぁ………\n"
"でも、硝煙と血の臭いで台無しだよ………"
msgstr "风真舒服啊………但是，被硝烟和血腥味给糟蹋了………"

#. ID 20, Page 1, Line 11, Pos (38,4)
msgid ""
"………………ちくしょう。\n"
"私は…………\n"
"こんなところで……独りで…………"
msgstr "………………可恶。我…………在这种地方……独自一人…………"

#. ID 20, Page 1, Line 16, Pos (38,4)
#. Contains choice at line 2 (2 options)
msgid "抱いてやろうか…"
msgstr "要我抱你吗…"

#. ID 20, Page 1, Line 22, Pos (38,4)
msgid ""
"え？\n"
"………君、まだ行ってなかったのか。"
msgstr "诶？………你还没走吗。"

#. ID 20, Page 1, Line 26, Pos (38,4)
msgid ""
"…………ごめん。最期だってのに、こんな\n"
"弱気なところ見せちゃって……"
msgstr ""
"…………抱歉。明明都到最后了，\n"
"还让你看到我这么软弱的样子……"

#. ID 20, Page 1, Line 30, Pos (38,4)
msgid "君、あったかいなぁ…………"
msgstr "你，真温暖啊…………"

#. ID 20, Page 1, Line 33, Pos (38,4)
msgid "…………………………"
msgstr "…………………………"

#. ID 20, Page 1, Line 42, Pos (38,4)
msgid "返事がない。ただのしかばねのようだ。"
msgstr "没有回应。只是一具尸体罢了。"

#. ID 20, Page 1, Line 46, Pos (38,4)
msgid ""
"おお！！\n"
"君は……無事だったのか！！"
msgstr "哦哦！！你……平安无事吗！！"

#. ID 20, Page 1, Line 50, Pos (38,4)
msgid ""
"いきなり大軍が攻めてきて…\n"
"全く勝負にならなかったよ。"
msgstr "突然大军攻过来……完全没法对抗啊。"

#. ID 20, Page 1, Line 52, Pos (38,4)
msgid "なんだか身体が疼いて力が出ないし………"
msgstr "总觉得身体疼，使不上力气………"

#. ID 20, Page 1, Line 55, Pos (38,4)
msgid ""
"もうここはダメだ。君は……逃げるんだ。\n"
"私は……ダメだ……もう長くない………"
msgstr ""
"这里已经不行了。你……快逃吧。我……不行了……\n"
"已经撑不了多久了………"

#. ID 20, Page 1, Line 59, Pos (38,4)
msgid ""
"せめて……君は…………\\!\n"
"そうだ、隊長が王子を非難させると言って\n"
"いた。どこかに抜け道があるのかも………"
msgstr ""
"至少……你…………\\!对了，队长说过要让王子避难。\n"
"说不定哪里有暗道………"

#. ID 20, Page 2, Line 1, Pos (38,4)
msgid "すでに息絶えている。"
msgstr "已经断气了。"

#. ID 22, Page 1, Line 1, Pos (37,1)
msgid "喉元を深々と斬られ絶命している。"
msgstr "喉咙被深深地砍中，已经毙命。"

#. ID 64, Page 1, Line 2, Pos (30,26)
#. ID 65, Page 1, Line 2, Pos (31,25)
#. ID 66, Page 1, Line 2, Pos (30,24)
#. ID 67, Page 1, Line 2, Pos (29,25)
msgid "渦がある。飛び込もう。"
msgstr "有漩涡。跳进去吧。"
