msgid ""
"　　　コッチニ…………\n"
"　　オマエ………モ……………"
msgstr ""
"　　　到这边来…………\n"
"　　你………也……………"

#. ID 57, Page 2, Line 3, Pos (16,6)
msgid "亡者に連れ去られた者の遺品だろう。"
msgstr "是被亡灵带走之人的遗物吧。"

#. ID 57, Page 2, Line 4, Pos (16,6)
#. Contains choice at line 2 (2 options)
#. ID 58, Page 2, Line 4, Pos (17,5)
#. Contains choice at line 2 (2 options)
msgid "いただきますか？"
msgstr "要收下吗？"

#. ID 57, Page 2, Line 5, Pos (16,6)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"罰当たりだ！"
msgstr ""
"是\n"
"会遭报应的！"

#. ID 57, Page 2, Line 10, Pos (16,6)
msgid "みずしぶきのふくを手に入れた"
msgstr "获得了水花服"

#. ID 58, Page 2, Line 3, Pos (17,5)
msgid "亡者に食われた者の遺品だろう。"
msgstr "是被亡灵吃掉之人的遗物吧。"

#. ID 58, Page 2, Line 5, Pos (17,5)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"バチ当たりだ！"
msgstr ""
"是\n"
"会遭报应的！"

#. ID 58, Page 2, Line 10, Pos (17,5)
msgid "光のローブを手に入れた"
msgstr "获得了光之长袍"

#. ID 59, Page 2, Line 3, Pos (10,10)
msgid ""
"サムイ…………\n"
"ココ………ハ…………"
msgstr "好冷…………这里………是…………"

#. ID 59, Page 2, Line 5, Pos (10,10)
msgid ""
"オマエ………\n"
"　　　　アタタカイ………\n"
"　　イッショニ……　　　　コイ…………"
msgstr ""
"你………　　　　好暖和………　　一起……　　　　来吧……\n"
"　　　　……"

#. ID 64, Page 2, Line 3, Pos (10,11)
msgid ""
"オンナ………\n"
"　　　オンナ………！"
msgstr ""
"女人………\n"
"　　　女人………！"

#. ID 66, Page 2, Line 3, Pos (1,4)
msgid ""
"上級魔導師\n"
"「さ……触るな亡者共！！\n"
"　この私が……お……お前らなんかにぃ！！"
msgstr ""
"上级魔导师「住……别碰我，亡灵们！！　我……\n"
"我怎么能被你们这种家伙……！！"

#. ID 66, Page 2, Line 6, Pos (1,4)
msgid ""
"上級魔導師\n"
"「来るな……来るなああああああああっ！！"
msgstr "上级魔导师「别过来……别过来啊啊啊啊啊啊啊！！"

#. ID 69, Page 2, Line 3, Pos (1,5)
msgid ""
"カワク……\n"
"　　ノドガ………タマシ……イ……\n"
"　　　　オンナ………"
msgstr ""
"好渴……\n"
"　　喉咙………干………\n"
"　　　　女人………"
