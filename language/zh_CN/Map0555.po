#. ID 42, Page 2, Line 3, Pos (9,11)
msgid ""
"女エルフ\n"
"\\s[2]「おばけさんにぃ……\\c[11]$k\\c[0]\\c[11]$k\\c[0]\\c[11]$k\\c[0]\n"
"　中にいっぱい出されちゃってぇ……\\c[11]$k\\c[0]\\c[11]$k"
msgstr ""
"女精灵\\s[2]「被妖怪……\n"
"\\c[11]$k\\c[0]\\c[11]$k\\c[0]\\c[11]$k\\c[0]　被灌\n"
"　了好多在里面……\\c[11]$k\\c[0]\\c[11]$k"

#. ID 42, Page 2, Line 6, Pos (9,11)
msgid ""
"女エルフ\n"
"\\s[2]「何かぁ……だいじなものぉ………\n"
"持ってかれちゃったぁ……\\c[11]$k"
msgstr ""
"女精灵\\s[2]「好像……什么重要的东西……被拿走了……\n"
"\\c[11]$k"

#. ID 42, Page 2, Line 9, Pos (9,11)
msgid ""
"女エルフ\n"
"\\s[2]「あたまもぉ……からだのなかもぉ……\\c[11]$k\\c[0]\n"
"　とろとろにされちゃったあ\\c[11]$k\\c[0]\\c[11]$k"
msgstr ""
"女精灵\\s[2]「脑袋也……身体里面也……\n"
"\\c[11]$k\\c[0]　被弄得融化般软绵绵的……\n"
"　\\c[11]$k\\c[0]\\c[11]$k"

#. ID 42, Page 2, Line 12, Pos (9,11)
msgid ""
"女エルフ\n"
"\\s[2]「あは……\\c[11]$k\\c[0]あはははは\\c[11]$k"
msgstr ""
"女精灵\\s[2]「啊哈……\n"
"\\c[11]$k\\c[0]啊哈哈哈哈\\c[11]$k"

#. ID 43, Page 2, Line 3, Pos (10,9)
msgid ""
"魔女\n"
"「ええい、何をする亡者共！\n"
"　ワシに触るでない！！"
msgstr "魔女「可恶，你们这些亡者想干什么！　别碰我！！"

#. ID 43, Page 2, Line 6, Pos (10,9)
msgid ""
"魔女\n"
"「放せええええ！！\n"
"　ワシはまだ逝きとうない！！！"
msgstr "魔女「放开我啊啊啊啊！！　我还不想死！！！"

#. ID 45, Page 2, Line 3, Pos (7,14)
msgid ""
"らハーピィ\n"
"「羽根……持っていかれちゃった……\n"
"　もう………飛べないよぉ……"
msgstr "哈比「羽毛……被拿走了……　已经………飞不了了啊……"

#. ID 46, Page 2, Line 3, Pos (9,9)
msgid ""
"ニク…………\n"
"　　　　ニク………イキタ………\n"
"　　　ニク………"
msgstr ""
"肉…………\n"
"　　　　肉………活………了………\n"
"　　　肉………"

#. ID 47, Page 2, Line 3, Pos (4,11)
msgid ""
"僧侶\n"
"「……死せる者の魂が………\n"
"　冥府から私を…………攫いに……"
msgstr "僧侣「……死者的灵魂………　从冥府…………来把我掳走……"

#. ID 47, Page 2, Line 6, Pos (4,11)
msgid ""
"僧侶\n"
"「\\s[2]神よ………お助けください……\\!\n"
"　たす……け…て…\\s[3]おかあ……さ……"
msgstr ""
"僧侣「\\s[2]神啊………请救救我……\\!　救……救…我…\n"
"\\s[3]妈妈……妈……"

#. ID 48, Page 2, Line 3, Pos (10,16)
msgid "瀕死の少女が横たわり道を塞いでいる。"
msgstr "濒死的少女躺在地上，挡住了道路。"

#. ID 48, Page 2, Line 8, Pos (10,16)
msgid ""
"倒れている少女\n"
"\\s[2]「う……いや……わたし……\n"
"　こんなところ……で……………"
msgstr ""
"倒在地上的少女\\s[2]「呜……不……我……　在这种地方…\n"
"……"

#. ID 48, Page 2, Line 11, Pos (10,16)
#. Contains choice at line 3 (2 options)
msgid ""
"倒れている少女\n"
"\\s[3]「だれか……助け………"
msgstr "倒在地上的少女\\s[3]「有人……救救………"

#. ID 48, Page 2, Line 17, Pos (10,16)
#. Choice (2 options, embedded in a message)
msgid ""
"邪魔だし片づける\n"
"放っておく"
msgstr ""
"碍事，清理掉\n"
"放着不管"

#. ID 48, Page 2, Line 24, Pos (10,16)
msgid ""
"倒れている少女\n"
"「\\s[2]え……ひょっとして助け………"
msgstr "倒在地上的少女「\\s[2]诶……难道说救我………"

#. ID 48, Page 2, Line 31, Pos (10,16)
msgid ""
"倒れている少女\n"
"「ひっ！？"
msgstr "倒在地上的少女「咿！？"

#. ID 48, Page 2, Line 42, Pos (10,16)
msgid "これでよし。"
msgstr "这样就行了。"

#. ID 49, Page 2, Line 3, Pos (11,9)
