#. ID 13, Page 2, Line 69, Pos (13,3)
msgid ""
"汝に問う。\n"
"\\c[4]\\n[102]\\c[0]にあるものは何か？"
msgstr "我问你。\\c[4]\\n[102]\\c[0]里有什么？"

#. ID 13, Page 2, Line 72, Pos (13,3)
#. Choice (4 options)
msgid ""
"\\>「動かぬもの以外の４文字」\n"
"\\>「角を持つ獣」\n"
"\\>「鏡合わせ」\n"
"\\>＞＞次の選択肢"
msgstr ""
"\\>「不动之物以外的4个字」\n"
"\\>「有角之兽」\n"
"\\>「镜像」\n"
"\\>＞＞下一个选项"

#. ID 13, Page 2, Line 87, Pos (13,3)
#. Choice (4 options)
msgid ""
"\\>「解を背負う虫」\n"
"\\>「猛獣」\n"
"\\>「乙女」\n"
"\\>＞＞次の選択肢"
msgstr ""
"\\>「背负解答之虫」\n"
"\\>「猛兽」\n"
"\\>「少女」\n"
"\\>＞＞下一个选项"

#. ID 13, Page 2, Line 102, Pos (13,3)
#. Choice (4 options)
msgid ""
"\\>「正義」\n"
"\\>「毒」\n"
"\\>「狩人」\n"
"\\>＞＞次の選択肢"
msgstr ""
"\\>「正义」\n"
"\\>「毒」\n"
"\\>「猎人」\n"
"\\>＞＞下一个选项"

#. ID 13, Page 2, Line 117, Pos (13,3)
#. Choice (4 options)
msgid ""
"\\>「生贄」\n"
"\\>「水」\n"
"\\>「泳ぐもの」\n"
"\\>＞＞次の選択肢"
msgstr ""
"\\>「祭品」\n"
"\\>「水」\n"
"\\>「游水之物」\n"
"\\>＞＞下一个选项"

#. ID 13, Page 2, Line 128, Pos (13,3)
#. Choice (4 options)
msgid ""
"\\>「毒牙を操るもの」\n"
"\\>「動くもの以外の５文字」\n"
"\\>もう一度問題を聞く\n"
"\\>＜＜最初の選択肢"
msgstr ""
"\\>「操毒牙者」\n"
"\\>「动之物以外的5个字」\n"
"\\>再听一次问题\n"
"\\>＜＜最初的选项"

#. ID 13, Page 2, Line 162, Pos (13,3)
msgid "汝、刻は人の身に於いて悠久ならぬことを悟るべし"
msgstr "你应当领悟：刻于人身并不永恒。"

#. ID 13, Page 2, Line 195, Pos (13,3)
