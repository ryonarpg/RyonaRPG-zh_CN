#. ID 413, Line 791
#. ID 471, Line 283
msgid ""
"\\.しかたなく卵を蕾から離し、\n"
"他の箇所に宛がうのだった…"
msgstr "\\.只好将卵从花蕾上移开，抵到其他部位……"

#. ID 413, Line 839
#. ID 471, Line 328
msgid ""
"\\.馴れた手つきで秘所に宛がうと、振動を限界まで強め\n"
"\\.\\n[\\v[6]]は淫らな官能の波にその身を任せた…\\.\\.\\.\\^"
msgstr ""
"\\.用熟练的手法抵到私处，\n"
"把振动增强到极限\\.\\n[\\v[6]]将身体交给淫靡的官\n"
"能波浪……\\.\\.\\.\\^"

#. ID 413, Line 845
#. ID 471, Line 334
msgid ""
"\\.おそるおそる秘所に宛がうと、それが放つ振動に\n"
"\\.\\n[\\v[6]]は未成熟な身体をびくんと震わせた。\\.\\.\\.\\^"
msgstr ""
"\\.战战兢兢地抵到私处，\n"
"被它释放的振动\\.\\n[\\v[6]]让未成熟的身体猛地一\n"
"颤。\\.\\.\\.\\^"

#. ID 413, Line 849
#. ID 471, Line 338
msgid ""
"\\.おそるおそる秘所に宛がうと、それは悩ましい振動で\n"
"\\.\\n[\\v[6]]の可憐な蕾を責め始めた…\\.\\.\\.\\^"
msgstr ""
