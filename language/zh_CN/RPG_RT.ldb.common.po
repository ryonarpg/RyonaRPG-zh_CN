#. ID 466, Line 384
msgid "\\n[\\v[6]]は、スライムの子を孕んでしまった！\\|\\.\\^"
msgstr "\\n[\\v[6]]怀上了史莱姆的孩子！\\|\\.\\^"

#. ID 466, Line 439
msgid ""
"\\n[\\v[6]]の子宮は、度重なる種付けによって、\n"
"異形の仔を宿してしまった！\\|\\.\\^"
msgstr ""
"\\n[\\v[6]]的子宫由于反复配种，怀上了异形之子！\n"
"\\|\\.\\^"

#. ID 466, Line 441
msgid "\\n[\\v[6]]は、卵を産みつけられてしまった！\\|\\.\\^"
msgstr "\\n[\\v[6]]被产卵了！\\|\\.\\^"

#. ID 466, Line 488
#. ID 467, Line 109
