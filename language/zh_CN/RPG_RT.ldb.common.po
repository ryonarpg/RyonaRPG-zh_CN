#. ID 467, Line 302
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]赤ちゃん…私の赤ちゃん…"
msgstr ""
"\\>【\\n[\\v[6]]】\\S[2]\n"
"宝宝…我的宝宝…"

#. ID 467, Line 306
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]赤ちゃん…あたしの赤ちゃん…"
msgstr ""
"\\>【\\n[\\v[6]]】\\S[2]\n"
"宝宝…我的宝宝…"

#. ID 467, Line 311
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]どうしましょう…つれていけませんわ……\n"
"赤ちゃん…つれてけない………"
