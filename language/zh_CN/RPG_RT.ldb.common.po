#. ID 1901, Line 5
msgid ""
"宝石を一個プレゼント！\\!\n"
"好きな宝石を選んでね！"
msgstr "赠送一颗宝石！\\!选一颗你喜欢的宝石吧！"

#. ID 1903, Line 11
msgid "呪符が剥がれた！"
msgstr "咒符剥落了！"

#. ID 1904, Line 10
msgid ""
"\\C[2]強制全裸の呪符\\C[0]は\n"
"\\C[2]金銭搾取の呪符\\C[0]に変化した"
msgstr "\\C[2]强制全裸咒符\\C[0]变成了\\C[2]金钱榨取咒符\\C[0]"

#. ID 1905, Line 7
msgid "\\C[2]\\V[1556]\\C[0]G手に入れた！"
msgstr "\\C[2]\\V[1556]\\C[0]G到手了！"

#. ID 1906, Line 87
msgid ""
"\\n[\\v[6]]はマジカルなポーズをとり\n"
"オリジナルの呪文を唱えながら\n"
"ステキステッキを振ってみた！"
msgstr ""
"\\n[\\v[6]]摆出魔法般的姿势，\n"
"一边念着原创咒文一边试着挥动美妙手杖！"

#. ID 1906, Line 90
#. ID 1906, Line 112
msgid "しかし何も起こらなかった。"
msgstr "但是什么也没有发生。"

#. ID 1906, Line 92
msgid ""
"\\n[\\v[6]]はえへへとはにかみながら\n"
"ステキステッキをしまった。"
msgstr ""
"\\n[\\v[6]]一边嘿嘿害羞笑着，\n"
"一边收起了美妙手杖。"

#. ID 1906, Line 96
msgid ""
"\\n[\\v[6]]は顔をひどく赤らめて\n"
"急いでステキステッキをしまった。"
msgstr "\\n[\\v[6]]脸涨得通红，急忙收起了美妙手杖。"

#. ID 1906, Line 109
msgid ""
"幼女になってしまった\\n[\\v[6]]は\n"
"元に戻りたい一心で\n"
"ステキステッキを振り回した！"
msgstr ""
"变成了幼女的\\n[\\v[6]]一心想要恢复原状，\n"
"挥舞起了美妙手杖！"

#. ID 1906, Line 113
msgid ""
"たしか\\c[4]ピラミッド\\c[0]でおかしな魔法にかかって\n"
"こんな姿にされたんだっけ…。元に戻す魔法がないか、\n"
"もう一度ピラミッドを探索してみよう。"
msgstr ""
"记得好像是在\\c[4]金字塔\\c[0]中了奇怪的魔法才变\n"
"成这副样子的…。再探索一次金字塔，\n"
"看看有没有能恢复原样的魔法吧。"

#. ID 1906, Line 126
msgid ""
"闇子ちゃんからもらった「ステキステッキ」で\n"
"どんな装備を着ているかに関係なく\n"
"\\c[4]好きな衣装\\c[0]にステキにチェンジできます。"
msgstr ""
"用从暗子酱那里得到的「美妙手杖」，\n"
"无论穿着什么装备，\n"
"都能美妙地换装成\\c[4]喜欢的服装\\c[0]。"

#. ID 1906, Line 129
msgid ""
"いろんな衣装を手に入れて\n"
"ステキな着せ替えライフを楽しみましょう！"
msgstr "获得各种服装，享受美妙的换装生活吧！"

#. ID 1906, Line 155
msgid ""
"\\c[2]注意！\\c[0]\n"
"装備が裸、またはボロボロな服のときは\n"
"衣装を設定しても見た目は変わりません。\n"
"ご了承ください。"
msgstr ""
"\\c[2]注意！\\c[0]当装备为裸体，\n"
"或破破烂烂的衣服时，即使设置了服装，\n"
"外观也不会改变。敬请谅解。"

