msgstr "\\n[\\v[6]]战战兢兢地拿起「魔兽之卵」……\\.\\.\\.\\^"

#. ID 413, Line 784
#. ID 471, Line 279
msgid ""
"\\.しかし、卵を秘所に宛がおうとしたが、\n"
