#. ID 482, Line 673
msgid "寄生虫の尻尾が\\n[\\v[6]]の体に向けられる………\\.\\.\\.\\^"
msgstr "寄生虫的尾巴对准了\\n[\\v[6]]的身体………\\.\\.\\.\\^"

#. ID 482, Line 688
#. ID 537, Line 668
