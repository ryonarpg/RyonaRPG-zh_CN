msgid ""
"\\n[\\v[6]]は突如襲ってきた下腹部の違和感により\n"
"目を覚ました。\\|\\.\\^"
msgstr ""
"\\n[\\v[6]]因下腹部突然袭来的不适感醒了过来。\n"
"\\|\\.\\^"

#. ID 467, Line 156
msgid ""
"人間の子供を宿した\\n[\\v[6]]の腹は、\n"
"すでに大きく膨らみ出産を目前に控えていた。\\|\\.\\^"
msgstr ""
"怀了人类孩子的\\n[\\v[6]]的肚子已经高高鼓起，\n"
"临产在即。\\|\\.\\^"

#. ID 467, Line 169
msgid ""
"………\\!この時が来た。\\!\n"
"\n"
"意を決した\\n[\\v[6]]は、汚い犬小屋で\n"
"出産の準備に取り掛かった。"
msgstr ""
"………\\!这一刻来了。\n"
"\\!下定决心的\\n[\\v[6]]在脏兮兮的狗窝里开始准备\n"
"分娩。"

#. ID 467, Line 175
msgid ""
"………\\!この時が来た。\\!\n"
"\n"
"意を決した\\n[\\v[6]]は、出産のための\n"
"準備に取り掛かった。"
msgstr ""
"………\\!这一刻来了。\n"
"\\!下定决心的\\n[\\v[6]]开始为分娩做准备。"

#. ID 467, Line 191
msgid ""
"\\n[\\v[6]]は体を横たえ、\n"
"股を開き準備に取り掛かった。"
msgstr "\\n[\\v[6]]躺下身体，张开双腿，开始准备。"

#. ID 467, Line 195
msgid ""
"\\n[\\v[6]]は静かに下着を脱ぎ、体を\n"
"横たえ、股を開き準備に取り掛かった。"
msgstr ""
"\\n[\\v[6]]静静脱下内裤，躺下身体，张开双腿，\n"
"开始准备。"

#. ID 467, Line 201
#. ID 467, Line 495
#. ID 467, Line 870
#. ID 467, Line 1265
msgid ""
"\\S[2]苦しそうに息を吐きながら、\\n[\\v[6]]は\n"
"両手を秘部にそえて、そのまま掻き分ける様に開く。"
msgstr ""
"\\S[2]一边痛苦地吐着气，\n"
"\\n[\\v[6]]把双手放在私处，\n"
"就那样像扒开一样打开。"

#. ID 467, Line 211
#. ID 467, Line 512
#. ID 467, Line 546
#. ID 467, Line 887
#. ID 467, Line 1282
msgid ""
"\\S[2]苦しそうな表情を浮かべた\\n[\\v[6]]は、\n"
"下腹部に力を入れる"
msgstr "\\S[2]浮现出痛苦表情的\\n[\\v[6]]向下腹部用力"

#. ID 467, Line 219
msgid ""
"\\S[2]下腹部から秘部にかけておなかを圧迫し、\n"
"少しずつ出てくるのを感じる。"
msgstr ""
"\\S[2]从下腹部到私处压迫肚子，\n"
"感觉到一点点出来。"

#. ID 467, Line 230
#. ID 467, Line 564
#. ID 467, Line 914
#. ID 467, Line 1302
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]んんっ！……中で擦れて……\n"
"で、出てきてますわ……"
msgstr ""
"\\>【\\n[\\v[6]]】\\S[2]\n"
"嗯嗯！……在里面摩擦着……正、\n"
