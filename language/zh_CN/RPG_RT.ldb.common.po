#. ID 466, Line 495
msgid "\\n[\\v[6]]は、ランドレイの仔を孕んでしまった！\\.\\.\\.\\^"
msgstr "\\n[\\v[6]]怀上了兰德雷的幼崽！\\.\\.\\.\\^"

#. ID 467, Line 15
msgid ""
"蛙の姿になった\\n[\\v[6]]は、\n"
"不意に、自分の下腹部に異様な圧迫感を覚えた。"
msgstr ""
"变成青蛙模样的\\n[\\v[6]]忽然感到自己的下腹部有\n"
"一种异样的压迫感。"

#. ID 467, Line 25
msgid ""
"………！！\n"
"な、何か来る……いや、何か出る！！"
msgstr "………！！有、有什么来了……不，有什么要出来了！！"

#. ID 467, Line 27
msgid "あ、ああああああぁぁぁああ……！？"
msgstr "啊、啊啊啊啊啊啊啊啊……！？"

#. ID 467, Line 50
msgid ""
"\\n[\\v[6]]は\n"
"無精状態の卵を産卵してしまった……"
msgstr "\\n[\\v[6]]产下了未受精状态的卵……"

#. ID 467, Line 53
msgid "蛙の卵を手に入れた。"
msgstr "获得了蛙卵。"

#. ID 467, Line 58
msgid ""
"うう……自分の身体のみならず……\n"
"いつか可愛い赤ちゃんになるはずの\n"
"私の卵子までこんな姿になってしまうなんて……"
msgstr ""
"呜呜……不只是我自己的身体……\n"
"连我将来本应变成可爱宝宝的卵子都变成这副样子……"

#. ID 467, Line 65
msgid ""
"\\n[\\v[6]]は\n"
"胸の底から湧き上がる言いようのない悲哀に\n"
"一人打ちひしがれるのだった……"
msgstr ""
"\\n[\\v[6]]独自被从心底涌起的无以言表的悲哀击垮\n"
"了……"

#. ID 467, Line 114
msgid ""
"\\n[\\v[6]]の子宮は、度重なる種付けによって、\n"
"異形の仔を宿していたようだ…！\\|\\.\\^^"
msgstr ""
"\\n[\\v[6]]的子宫似乎因反复配种，怀上了异形之子…\n"
"！\\|\\.\\^^"

#. ID 467, Line 116
msgid "\\n[\\v[6]]は、ランドレイの仔を孕んでしまった！\\|\\.\\^"
msgstr "\\n[\\v[6]]怀上了兰德雷的幼崽！\\|\\.\\^"

