#. ID 381, Line 188
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「……あ……わ、わた、し……の……体……」"
msgstr "\\n[\\v[6]]\\S[2]「……啊……我、我的……身体……」"

#. ID 381, Line 197
msgid ""
"\\n[\\v[6]]\n"
"\\S[2]「ガガ……ガガガガガガガ……！\n"
"機体破損……機体破損……」"
msgstr ""
"\\n[\\v[6]]\\S[2]「嘎嘎……嘎嘎嘎嘎嘎嘎嘎……！\n"
"机体破损……机体破损……」"

#. ID 381, Line 212
msgid ""
"\\n[\\v[6]]\n"
"\\S[10]「キタイ　ハソン　コウドウ　フノウ……\n"
"キタイ　ハソン……　コウ　ドウ……　フノ……ウ……\n"
"…………ガガ　ガガガガガガ…………"
msgstr ""
"\\n[\\v[6]]\\S[10]「机体　破损　行动　不能……\n"
"机体　破损……　行　动……　不……能………………\n"
"嘎嘎　嘎嘎嘎嘎嘎嘎…………"

#. ID 381, Line 227
msgid ""
"\\n[\\v[6]]\n"
"\\S[10]「……………………"
msgstr ""
"\\n[\\v[6]]\n"
"\\S[10]「……………………"

#. ID 381, Line 236
msgid ""
"＊破損した\\n[\\v[6]]はガラクタとなり、\n"
"修理されることもなくその場にうち捨てられた。"
msgstr ""
"＊损坏的\\n[\\v[6]]成了废品，没有被修理，\n"
"就那样被丢弃在了原地。"

#. ID 381, Line 238
msgid ""
"＊転がった鉄クズが\\n[\\v[6]]だとは\n"
"誰にも分かるわけもなく、\n"
"救出する者も現れなかった。"
msgstr ""
"＊谁也不可能知道滚落在地上的废铁就是\\n[\\v[6]]，\n"
"也没有人前来救出。"

#. ID 382, Line 15
msgid ""
"あぁん？こいつ、組合の娼婦じゃねえか。\n"
"何でこんな所でぶっ倒れてんだ？"
msgstr ""
"啊？这家伙，不是公会的娼妇吗？\n"
"为什么在这种地方晕倒了？"

#. ID 382, Line 17
msgid "ま、とりあえず運んどくか…"
msgstr "嘛，总之先把她搬走吧…"

#. ID 382, Line 22
msgid ""
"気が付くと、\\n[\\v[6]]は\n"
"レイオンの宿屋で介抱されていた…"
msgstr "回过神来，\\n[\\v[6]]正在莱昂的旅馆里被照料着…"

