#. ID 330, Line 421
msgid "\\n[102]び、びっくりした…。\\n[103]\\n[104]\\^"
msgstr "\\n[102]吓、吓我一跳……。\\n[103]\\n[104]\\^"

#. ID 330, Line 425
msgid "\\n[102]っ……うん、まだ大丈夫。\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔……嗯，还没问题。\\n[103]\\n[104]\\^"

#. ID 330, Line 429
msgid "\\n[102]まだまだ、これくらい！　\\n[103]\\n[104]\\^"
msgstr ""
"\\n[102]还早着呢，就这点程度！\n"
"　\\n[103]\\n[104]\\^"

#. ID 330, Line 433
msgid "\\n[102]あん！\\n[103]\\n[104]\\^"
msgstr "\\n[102]啊嗯！\\n[103]\\n[104]\\^"

#. ID 330, Line 437
msgid "\\n[102]いたた…\\n[103]\\n[104]\\^"
msgstr "\\n[102]好痛痛……\\n[103]\\n[104]\\^"

#. ID 330, Line 441
msgid "\\n[102]つ…よくも！\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔……竟敢！\\n[103]\\n[104]\\^"

#. ID 330, Line 445
msgid "\\n[102]やったな！\\n[103]\\n[104]\\^"
msgstr "\\n[102]你竟敢！\\n[103]\\n[104]\\^"

#. ID 330, Line 449
msgid "\\n[102]…このぉ！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]……你这混蛋！！\\n[103]\\n[104]\\^"

#. ID 330, Line 453
msgid "\\n[102]私を怒らせたわね！\\n[103]\\n[104]\\^"
msgstr "\\n[102]你把我惹怒了！\\n[103]\\n[104]\\^"

#. ID 330, Line 457
msgid "\\n[102]これくらいで！\\n[103]\\n[104]\\^"
msgstr "\\n[102]就这点程度！\\n[103]\\n[104]\\^"

#. ID 330, Line 461
msgid "\\n[102]それで終わり？\\n[103]\\n[104]\\^"
msgstr "\\n[102]这样就完了？\\n[103]\\n[104]\\^"

#. ID 330, Line 465
msgid "\\n[102]弱い相手…。\\n[103]\\n[104]\\^"
msgstr "\\n[102]弱小的对手……。\\n[103]\\n[104]\\^"

#. ID 330, Line 469
msgid "\\n[102]ひっ！……あ、あれ？\\n[103]\\n[104]\\^"
msgstr "\\n[102]咿！……啊、咦？\\n[103]\\n[104]\\^"

#. ID 330, Line 473
msgid "\\n[102]避けるまでもない！\\n[103]\\n[104]\\^"
msgstr "\\n[102]根本没必要躲！\\n[103]\\n[104]\\^"

#. ID 330, Line 477
msgid "\\n[102]軽い！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]太轻了！！\\n[103]\\n[104]\\^"

#. ID 330, Line 481
msgid "\\n[102]わわっ！？\\n[103]\\n[104]\\^"
msgstr "\\n[102]哇哇！？\\n[103]\\n[104]\\^"

#. ID 330, Line 485
msgid "\\n[102]覚悟はできてるんでしょうね！\\n[103]\\n[104]\\^"
msgstr "\\n[102]你已经做好觉悟了吧！\\n[103]\\n[104]\\^"

#. ID 330, Line 489
msgid "\\n[102]負けません！\\n[103]\\n[104]\\^"
msgstr "\\n[102]我不会输！\\n[103]\\n[104]\\^"

#. ID 330, Line 493
msgid "\\n[102]い、痛くないよ！\\n[103]\\n[104]\\^"
msgstr "\\n[102]不、不痛哦！\\n[103]\\n[104]\\^"

#. ID 330, Line 497
msgid "\\n[102]これくらい、なんともないんだから！\\n[103]\\n[104]\\^"
msgstr ""
"\\n[102]这点程度，根本不算什么！\n"
"\\n[103]\\n[104]\\^"

#. ID 330, Line 501
msgid "\\n[102]痛くない、痛くない…。\\n[103]\\n[104]\\^"
msgstr "\\n[102]不痛、不痛……。\\n[103]\\n[104]\\^"

#. ID 330, Line 505
msgid "\\n[102]避けられなかった？\\n[103]\\n[104]\\^"
msgstr "\\n[102]没能躲开？\\n[103]\\n[104]\\^"

#. ID 330, Line 509
msgid "\\n[102]掠ったか。\\n[103]\\n[104]\\^"
msgstr "\\n[102]擦到了啊。\\n[103]\\n[104]\\^"

#. ID 330, Line 513
msgid "\\n[102]まだ、かすり傷！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]只是擦伤！！\\n[103]\\n[104]\\^"

#. ID 330, Line 517
msgid "\\n[102]ﾌﾝ…それで？\\n[103]\\n[104]\\^"
msgstr "\\n[102]哼…然后呢？\\n[103]\\n[104]\\^"

#. ID 330, Line 521
msgid "\\n[102]全然平気！\\n[103]\\n[104]\\^"
msgstr "\\n[102]完全没事！\\n[103]\\n[104]\\^"

#. ID 330, Line 525
msgid "\\n[102]今の、痛かったんだからね！\\n[103]\\n[104]\\^"
msgstr ""
"\\n[102]刚才那下，很痛的好不好！\n"
"\\n[103]\\n[104]\\^"

#. ID 330, Line 529
msgid "\\n[102]…なってないね！\\n[103]\\n[104]\\^"
msgstr "\\n[102]…还差得远呢！\\n[103]\\n[104]\\^"

#. ID 330, Line 533
msgid "\\n[102]て、手加減されてる？\\n[103]\\n[104]\\^"
msgstr "\\n[102]你、你在让着我吗？\\n[103]\\n[104]\\^"

#. ID 330, Line 537
msgid "\\n[102]諦めなさい！\\n[103]\\n[104]\\^"
msgstr "\\n[102]放弃吧！\\n[103]\\n[104]\\^"

#. ID 330, Line 541
msgid "\\n[102]きゃん！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]呀啊！！\\n[103]\\n[104]\\^"

#. ID 330, Line 545
msgid "\\n[102]ま、負けないよ！\\n[103]\\n[104]\\^"
msgstr "\\n[102]我、我不会输的！\\n[103]\\n[104]\\^"

#. ID 330, Line 549
msgid "\\n[102]後で薬飲まないと…。\\n[103]\\n[104]\\^"
msgstr "\\n[102]之后得吃药才行…。\\n[103]\\n[104]\\^"

#. ID 330, Line 553
msgid "\\n[102]見掛け倒し…。\\n[103]\\n[104]\\^"
msgstr "\\n[102]虚有其表…。\\n[103]\\n[104]\\^"

#. ID 330, Line 557
msgid "\\n[102]ひん！　…効きません！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]咿！　…根本不奏效！！\\n[103]\\n[104]\\^"

#. ID 330, Line 561
msgid "\\n[102]こんなの！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]就这！！\\n[103]\\n[104]\\^"

#. ID 330, Line 565
msgid "\\n[102]っ！…やったね！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔！…成功了！！\\n[103]\\n[104]\\^"

#. ID 330, Line 569
msgid "\\n[102]許さないよ！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]我不会原谅你！！\\n[103]\\n[104]\\^"

#. ID 330, Line 573
msgid "\\n[102]っ…馬鹿にしないで！\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔…别小看我！\\n[103]\\n[104]\\^"

#. ID 330, Line 577
msgid "\\n[102]良かった。ぜんぜん痛くない…。\\n[103]\\n[104]\\^"
msgstr "\\n[102]太好了。完全不痛…。\\n[103]\\n[104]\\^"

#. ID 330, Line 581
msgid "\\n[102]いっ…ん、まだまだ！\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔…嗯，还早着呢！\\n[103]\\n[104]\\^"

#. ID 330, Line 585
msgid "\\n[102]ふぎゅ！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]呜咕！！\\n[103]\\n[104]\\^"

#. ID 330, Line 589
msgid "\\n[102]う…やりますね。\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔…挺能干的嘛。\\n[103]\\n[104]\\^"

#. ID 330, Line 593
msgid "\\n[102]この程度では！\\n[103]\\n[104]\\^"
msgstr "\\n[102]就凭这种程度！\\n[103]\\n[104]\\^"

#. ID 330, Line 597
msgid "\\n[102]つっ…お返しはさせて貰いますよ！\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔…我会还击的！\\n[103]\\n[104]\\^"

#. ID 330, Line 601
msgid "\\n[102]痛っ…ま、まだ行けます！\\n[103]\\n[104]\\^"
msgstr "\\n[102]好痛…我、我还能行！\\n[103]\\n[104]\\^"

#. ID 330, Line 605
msgid "\\n[102]掠っただけです！\\n[103]\\n[104]\\^"
msgstr "\\n[102]只是擦到了而已！\\n[103]\\n[104]\\^"

#. ID 330, Line 609
msgid "\\n[102]っ…次は私の番ですよ！\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔…接下来轮到我了！\\n[103]\\n[104]\\^"

#. ID 330, Line 613
msgid "\\n[102]く！…油断はしません！\\n[103]\\n[104]\\^"
msgstr "\\n[102]唔！…我不会大意的！\\n[103]\\n[104]\\^"

#. ID 330, Line 617
msgid "\\n[102]手を抜いているのですか！\\n[103]\\n[104]\\^"
msgstr "\\n[102]你是在手下留情吗！\\n[103]\\n[104]\\^"

#. ID 330, Line 621
msgid "\\n[102]こんな攻撃ではっ！\\n[103]\\n[104]\\^"
msgstr "\\n[102]这种攻击算什么！\\n[103]\\n[104]\\^"

#. ID 330, Line 625
msgid "\\n[102]よ、避けられなかった？\\n[103]\\n[104]\\^"
msgstr "\\n[102]我、我没能躲开？\\n[103]\\n[104]\\^"

#. ID 330, Line 893
msgid "\\n[102]あれ…な、に…？\\n[103]\\n[104]\\^"
msgstr "\\n[102]咦…什、什么…？\\n[103]\\n[104]\\^"

