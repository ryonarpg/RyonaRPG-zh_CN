#. ID 467, Line 235
#. ID 467, Line 569
#. ID 467, Line 919
#. ID 467, Line 1307
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]んんっ！……で、出てきてる……\n"
"中で擦れちゃうよぉ……"
msgstr ""
"\\>【\\n[\\v[6]]】\\S[2]\n"
"嗯嗯！……出、出来了……\n"
"在里面摩擦起来了啦……"

#. ID 467, Line 242
#. ID 467, Line 574
#. ID 467, Line 924
#. ID 467, Line 1312
msgid "\\S[2]\\n[\\v[6]]は、さらに下腹部に力を入れる"
msgstr "\\S[2]\\n[\\v[6]]更加用力向下腹部使劲"

#. ID 467, Line 259
msgid ""
"\\>【\\n[\\v[6]]】\n"
"\\S[2]く、くるしい！…う、産まれる……も、もう少し……"
msgstr ""
"\\>【\\n[\\v[6]]】\\S[2]好、好难受！…呜、要生了……\n"
"再、再稍微……"

#. ID 467, Line 274
msgid "ひぎぃぃぃぃぃぃぃ！！！！！！"
msgstr "咿呀啊啊啊啊啊啊啊啊！！！！！！"

#. ID 467, Line 292
msgid "\\S[2]…ぜぇ…ぜぇ…"
msgstr "\\S[2]…呼…呼…"

