#. ID 972, Line 11
msgid ""
"客は\\N[\\V[6]]の服を脱がせようとしたが、\n"
"呪われていて外せなかった…"
msgstr ""
"客人试图脱掉\\N[\\V[6]]的衣服，但衣服被诅咒了，\n"
"脱不下来…"

#. ID 972, Line 13
#. ID 972, Line 44
msgid "客はあからさまに落胆している…"
msgstr "客人明显很失望…"

#. ID 972, Line 20
msgid ""
"客に言われるままに、\\N[\\V[6]]は\n"
"衣服を脱ぎ捨て、美しい裸身を晒した…"
msgstr ""
"按照客人的吩咐，\\N[\\V[6]]脱掉衣服，\n"
"露出了美丽的裸体…"

#. ID 972, Line 25
msgid ""
"客の要求に答え、\\N[\\V[6]]は\n"
"衣服を脱ぎ捨てた。"
msgstr "回应客人的要求，\\N[\\V[6]]脱掉了衣服。"

#. ID 972, Line 27
msgid ""
"裸身をいやらしく舐め回す客の視線に\n"
"\\N[\\V[6]]は激しい羞恥を感じ、小さく震えた。"
msgstr ""
"在客人下流地来回舔舐裸体的视线下，\n"
"\\N[\\V[6]]感到强烈的羞耻，微微颤抖。"

#. ID 972, Line 32
msgid ""
"\\N[\\V[6]]は客に身体をまさぐられながら、\n"
"ゆっくりと衣服を脱がされていった…"
msgstr ""
"\\N[\\V[6]]一边被客人抚摸着身体，\n"
"一边被慢慢地脱去了衣服…"

#. ID 972, Line 41
msgid ""
"客が用意した衣装を着てほしいと\n"
"せがんできたが、装備が呪われていて\n"
"外せなかった…"
msgstr ""
"客人缠着希望穿上他准备的服装，但装备被诅咒了，\n"
"脱不下来…"

#. ID 972, Line 49
msgid ""
"客が、用意した衣装を着てほしいと\n"
"せがんできた…"
msgstr "客人缠着希望穿上他准备的服装…"

#. ID 972, Line 57
msgid ""
"客に言われるままに、\\N[\\V[6]]は\n"
"衣服を脱ぎ捨て、美しい裸身に、淫らな\n"
"小さなシールを貼り付けた。"
msgstr ""
"按照客人的吩咐，\\N[\\V[6]]脱掉衣服，\n"
"在美丽的裸体上贴上了淫靡的小贴纸。"

#. ID 972, Line 66
msgid ""
"\\N[\\V[6]]は、あぶない水着に\n"
"着替えさせられた。"
msgstr "\\N[\\V[6]]被换上了危险泳装。"

#. ID 972, Line 68
msgid ""
"劣情を煽る卑猥なデザインの水着に包まれた\n"
"\\N[\\V[6]]の身体に、客の欲情に満ちた視線が\n"
"突き刺さる…"
msgstr ""
"\\N[\\V[6]]的身体被设计淫猥、\n"
"煽起劣情的泳装包裹着，\n"
"客人充满欲情的视线刺了过来…"

#. ID 972, Line 82
msgid ""
"\\N[\\V[6]]は客に言われるままに、\n"
"衣服を脱ぎ捨て、用意された、ごくごく\n"
"小さな布地面積しかないビキニに着替えた。"
msgstr ""
"按照客人的吩咐，\\N[\\V[6]]脱掉衣服，\n"
"换上了准备好的、布料面积非常非常小的比基尼。"

#. ID 972, Line 85
msgid ""
"\\N[\\V[6]]のかわいらしい乳輪は、\n"
"今にもビキニからはみ出しそうだ。\n"
"客の手が\\N[\\V[6]]に伸びていく…"
msgstr ""
"\\N[\\V[6]]可爱的乳晕眼看就要从比基尼里溢出来。\n"
"客人的手朝\\N[\\V[6]]伸了过去…"

#. ID 972, Line 94
msgid ""
"\\N[\\V[6]]は、極薄のレオタードに\n"
"着替えさせられた。"
msgstr "\\N[\\V[6]]被换上了极薄的连体紧身衣。"

#. ID 972, Line 96
msgid ""
"薄すぎる布地の表面に、\\N[\\V[6]]の\n"
"恥ずかしい部分の色とカタチが、くっきりと\n"
"浮かび上がってしまっている…"
msgstr ""
"在过薄的布料表面，\n"
"\\N[\\V[6]]羞耻部位的颜色和形状清晰地浮现了出来…"

#. ID 972, Line 110
msgid ""
"\\N[\\V[6]]は客に言われるままに\n"
"衣服を脱ぎ捨て、用意された、淫らな\n"
"ボンテージ衣装に着替えた。"
msgstr ""
"按照客人的吩咐，\\N[\\V[6]]脱掉衣服，\n"
"换上了准备好的淫靡束缚装。"

#. ID 972, Line 113
msgid ""
"\\N[\\V[6]]の形の良い乳房と、柔らかそうな\n"
"秘唇は完全に露になってしまっている。\n"
"ギチギチした拘束感が\\N[\\V[6]]の精神を苛んでいく…"
msgstr ""
"\\N[\\V[6]]形状姣好的乳房和看似柔软的秘唇完全暴\n"
"露了出来。紧绷的束缚感折磨着\\N[\\V[6]]的精神…"

#. ID 972, Line 122
msgid ""
"\\N[\\V[6]]は、性奴隷を調教するための\n"
"淫らな拘束衣に着替えさせられた。"
msgstr "\\N[\\V[6]]被换上了用于调教性奴隶的淫靡拘束衣。"

#. ID 972, Line 124
msgid ""
"身動きの取れない\\N[\\V[6]]の\n"
"恥ずかしい部分は剥き出しにされており、\n"
"客の思うがままに嬲ることができるのだ…"
msgstr ""
"无法动弹的\\N[\\V[6]]，其羞耻部位被暴露在外，\n"
"客人可以随心所欲地玩弄…"

#. ID 992, Line 100
msgid "\\N[101]\\N[102]\\N[103]\\N[104]を\\V[2]個食われた！"
msgstr "\\N[101]\\N[102]\\N[103]\\N[104]被吃掉了\\V[2]个！"

#. ID 994, Line 11
msgid ""
"バックパックの口が\n"
"粘液で固まってしまった！"
msgstr "背包的口被黏液封住了！"

