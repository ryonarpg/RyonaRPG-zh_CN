#. ID 65, Page 2, Line 6, Pos (37,6)
msgid "十字架の鍵を使って扉を開けた。"
msgstr "使用十字架钥匙打开了门。"

#. ID 65, Page 2, Line 22, Pos (37,6)
#. ID 79, Page 2, Line 22, Pos (6,6)
#. ID 81, Page 2, Line 25, Pos (21,6)
#. ID 83, Page 2, Line 22, Pos (1,27)
msgid "扉には鍵がかかっている！！"
msgstr "门上锁了！！"

#. ID 75, Page 2, Line 4, Pos (38,28)
msgid "ミスリルソードを手に入れた。"
msgstr "获得了秘银剑。"

#. ID 79, Page 2, Line 6, Pos (6,6)
#. ID 83, Page 2, Line 6, Pos (1,27)
msgid "黒十字の鍵を使って扉を開けた。"
msgstr "使用黑十字钥匙打开了门。"

#. ID 81, Page 2, Line 3, Pos (21,6)
msgid "＊………"
msgstr "＊………"

#. ID 81, Page 2, Line 4, Pos (21,6)
#. Contains choice at line 2 (2 options)
msgid "＊なんだか焦げ臭い……"
msgstr "＊总觉得有股焦臭味……"

#. ID 81, Page 2, Line 5, Pos (21,6)
#. Choice (2 options, embedded in a message)
msgid ""
"開ける\n"
"止めておく"
msgstr ""
"打开\n"
"先不打开"

#. ID 86, Page 2, Line 3, Pos (7,28)
#. Contains choice at line 2 (2 options)
msgid "＊故障しているようだ。"
msgstr "＊好像出故障了。"

#. ID 86, Page 2, Line 4, Pos (7,28)
#. Choice (2 options, embedded in a message)
msgid ""
"もぎ取る\n"
"いいえ"
msgstr ""
"强行夺取\n"
"不"

#. ID 86, Page 2, Line 7, Pos (7,28)
msgid "＊\\N[\\V[6]]は、素手で槍をもぎ取った。"
msgstr "＊\\N[\\V[6]]徒手夺下了长枪。"

#. ID 86, Page 2, Line 12, Pos (7,28)
msgid ""
"＊バールライクを使って\n"
"　槍をもぎ取った。"
msgstr "＊使用撬棍　夺下了长枪。"

#. ID 86, Page 2, Line 20, Pos (7,28)
msgid "ギルティランスを手に入れた。"
msgstr "获得了罪恶长枪。"

#. ID 86, Page 2, Line 24, Pos (7,28)
msgid ""
"＊しかし、かよわい\\N[\\V[6]]の力では\n"
"　装置を破壊することはできなかった。"
msgstr ""
"＊但是，\n"
"　以柔弱的\\N[\\V[6]]的力量　无法破坏装置。"
