#. ID 34, Page 2, Line 3, Pos (26,48)
#. ID 35, Page 2, Line 3, Pos (33,14)
msgid ""
"古びたランタンがある。\n"
"オイルは切れているようだ…"
msgstr "有一盏陈旧的提灯。油似乎已经用完了……"

#. ID 34, Page 2, Line 6, Pos (26,48)
#. ID 35, Page 2, Line 6, Pos (33,14)
msgid "ランタンにオイルを注ぎ足した。"
msgstr "给提灯补充了油。"

#. ID 34, Page 2, Line 8, Pos (26,48)
#. ID 35, Page 2, Line 8, Pos (33,14)
msgid "ランタンを手に入れた。"
msgstr "获得了提灯。"

#. ID 47, Page 2, Line 5, Pos (0,27)
msgid "地震だ！"
msgstr "地震了！"

#. ID 47, Page 2, Line 12, Pos (0,27)
msgid ""
"地震だ！\n"
"\\.震源が近づいているような気がする…"
msgstr "地震了！\\.感觉震源正在靠近……"

#. ID 49, Page 2, Line 3, Pos (8,1)
#. ID 57, Page 2, Line 3, Pos (9,1)
msgid "遺骨を手に入れた。"
msgstr "获得了遗骨。"
