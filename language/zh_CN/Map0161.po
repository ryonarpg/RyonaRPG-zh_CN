#. ID 13, Page 2, Line 3, Pos (33,10)
msgid "＊………"
msgstr "＊………"

#. ID 13, Page 2, Line 18, Pos (33,10)
msgid "＊………………"
msgstr "＊………………"

#. ID 13, Page 2, Line 19, Pos (33,10)
msgid "＊ここから先には進まない方がよさそうだ…"
msgstr "＊最好还是不要从这里往前走了…"

#. ID 17, Page 2, Line 7, Pos (7,7)
msgid ""
"「チッ　スライムってのはしぶとくていけねぇな\n"
"\\n[\\v[6]]、俺にいい考えがある！\n"
"おまえが囮になり、スライムを引きつけるんだ!」"
msgstr ""
"「啧　史莱姆这玩意儿又顽固又难缠啊\\n[\\v[6]]，\n"
"我有个好主意！你去当诱饵，把史莱姆引过来！」"

#. ID 17, Page 2, Line 14, Pos (7,7)
msgid ""
"「…そんな　許してください\n"
"お願いです」"
msgstr "「…别这样　请饶了我吧，求你了」"

#. ID 17, Page 2, Line 19, Pos (7,7)
msgid ""
"「心配するな　仕事がすんだら後で回収してやる\n"
"せいぜい散々犯されたり寄生されたり\n"
"孕まされたりするだけだ　奴隷なら日常茶飯事だろ」"
msgstr ""
"「别担心　等事情办完了之后我会去回收你的，\n"
"顶多也就是被反复侵犯、寄生、\n"
"搞大肚子而已　奴隶的话这种事是家常便饭吧」"

#. ID 17, Page 2, Line 22, Pos (7,7)
msgid "「そら行けっ！」"
msgstr "「嘿，去吧！」"

#. ID 17, Page 2, Line 32, Pos (7,7)
msgid ""
"「嫌ッ　嫌ッ　助けてー！\n"
"置いていかないでっ！！」　"
msgstr "「不要！　不要！救救我——！别丢下我！！」"

#. ID 17, Page 2, Line 40, Pos (7,7)
msgid "「いやぁっ！　ス、スライムが！」　"
msgstr "「呀啊！　史、史莱姆来了！」"

#. ID 17, Page 2, Line 47, Pos (7,7)
msgid "「よし、今のうちに……」"
msgstr "「好，趁现在……」"

#. ID 17, Page 2, Line 185, Pos (7,7)
msgid "「おい、仕事は済んだぞ！　ずらかるぜ！」　"
msgstr "「喂，活儿干完了！　快溜吧！」"

#. ID 17, Page 2, Line 190, Pos (7,7)
msgid ""
"おとりとしてスライムに凌辱され続けた後、\n"
"\\n[\\v[6]]は仕事を終えた雇い主に救出された…"
msgstr ""
"作为诱饵被史莱姆持续凌辱后，\n"
"\\n[\\v[6]]被完成工作的雇主救出…"

#. ID 17, Page 2, Line 195, Pos (7,7)
msgid "報酬として200G貰った"
msgstr "作为报酬拿到了200G"
