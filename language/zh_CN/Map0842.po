#. ID 58, Page 1, Line 3, Pos (29,28)
#. Contains choice at line 3 (2 options)
msgid ""
"\n"
"ネコミミが置いてある。"
msgstr "这里放着猫耳。"

#. ID 58, Page 1, Line 5, Pos (29,28)
#. Choice (2 options, embedded in a message)
msgid ""
"着けてみる\n"
"何もしない"
msgstr ""
"试着戴上\n"
"什么都不做"

#. ID 58, Page 1, Line 9, Pos (29,28)
msgid ""
"\n"
"しかし、今の姿には似合わないと感じたのか\n"
"着けるのをやめてしまった。"
msgstr ""
"但是，也许是觉得和现在的样子不搭，\n"
"便放弃戴上了。"

#. ID 58, Page 1, Line 14, Pos (29,28)
msgid ""
"\n"
"耳が邪魔で着けられない。"
msgstr "耳朵碍事，戴不上。"

#. ID 58, Page 1, Line 34, Pos (29,28)
msgid ""
"\n"
"鏡が無いから分からないけど、\n"
"激カワイイわたしが映るはずだ。"
msgstr ""
"虽然没有镜子所以不知道，\n"
"但照出来的应该是超可爱的我。"

#. ID 58, Page 1, Line 40, Pos (29,28)
msgid ""
"\n"
"鏡が無いから分からないけど、\n"
"似合っているのは間違い無いだろう。"
msgstr "虽然没有镜子所以不知道，但肯定很适合吧。"

#. ID 58, Page 1, Line 45, Pos (29,28)
msgid ""
"\n"
"鏡が無いから、\n"
"似合っているかは分からないなぁ。"
msgstr "因为没有镜子，所以不知道适不适合啊。"

#. ID 58, Page 1, Line 60, Pos (29,28)
msgid ""
"\n"
"\\.…\\.…\\.何だろう、今の感覚。"
msgstr "\\.…\\.…\\.是什么呢，刚才的感觉。"

#. ID 58, Page 1, Line 68, Pos (29,28)
msgid ""
"\n"
"何か、頭がムズムズするような\\.…\\.…\\.\\.\n"
"とりあえず外して\\.…\\.…"
msgstr ""
"总觉得，脑袋有点发痒似的\\.…\\.…\n"
"\\.\\.总之先摘下来\\.…\\.…"

#. ID 58, Page 1, Line 82, Pos (29,28)
msgid ""
"\n"
"\\>「いたっ！？\\<\\.\\.　…\\.…\\.えっ？」\\|\\^"
msgstr "\\>「好痛！？\\<\\.\\.　…\\.…\\.诶？」\\|\\^"

#. ID 58, Page 1, Line 102, Pos (29,28)
msgid ""
"\n"
"\\>「うそっ！？\\<\\.\\.\\>　取れない！？」\\<\\|\\^"
msgstr "\\>「不会吧！？\\<\\.\\.\\>　摘不下来！？」\\<\\|\\^"

#. ID 58, Page 1, Line 131, Pos (29,28)
msgid ""
"\n"
"「痛い\\.…\\.…\\.\\.\n"
"　そんな\\.…\\.…\\.どうして取れないの\\.…\\.…\\.？」\\|\\^"
msgstr ""
"「好痛\\.…\\.…\\.\\.　怎么会\\.…\\.…\n"
"\\.为什么摘不下来\\.…\\.…\\.？」\\|\\^"

#. ID 58, Page 1, Line 142, Pos (29,28)
msgid ""
"\n"
"「あっ、\\.\\.また\\.…\\.…\\.」\\|\\^"
msgstr "「啊，\\.\\.又来了\\.…\\.…\\.」\\|\\^"

#. ID 58, Page 1, Line 152, Pos (29,28)
msgid ""
"\n"
"「今度はなに\\.…\\.…\\.？」\\|\\^"
msgstr "「这次又是什么\\.…\\.…\\.？」\\|\\^"

#. ID 58, Page 1, Line 162, Pos (29,28)
msgid ""
"\n"
"「えっ？\\.\\.　お尻がムズムズして\\.…\\.…\\.？」\\|\\^"
msgstr "「诶？\\.\\.　屁股痒痒的\\.…\\.…\\.？」\\|\\^"

#. ID 58, Page 1, Line 185, Pos (29,28)
msgid ""
"\n"
"「な、\\.何か、\\.\\.出ちゃうっ！」\\|\\^"
msgstr "「什、\\.什么东西，\\.\\.要出来了！」\\|\\^"

#. ID 58, Page 1, Line 205, Pos (29,28)
msgid ""
"\n"
"\\>！！！！！\\<\\|\\^"
msgstr ""
"\n"
"\\>！！！！！\\<\\|\\^"

#. ID 58, Page 1, Line 257, Pos (29,28)
msgid ""
"\n"
"\\.…\\.…\\.\\n[\\v[6]]は猫になってしまった。\\|\\^"
msgstr "\\.…\\.…\\.\\n[\\v[6]]变成了猫。\\|\\^"

#. ID 58, Page 1, Line 281, Pos (29,28)
msgid ""
"\n"
"「はぁ\\.…\\.…\\.、はぁ\\.…\\.…\\.」\\|\\^"
msgstr "「哈啊\\.…\\.…\\.、哈啊\\.…\\.…\\.」\\|\\^"

#. ID 58, Page 1, Line 289, Pos (29,28)
msgid ""
"\n"
"「これは\\.…\\.…\\.しっぽ？\\.\\.\n"
"　そんな\\.…\\.…\\.こんなのって\\.…\\.…\\.」\\|\\^"
msgstr ""
"「这是\\.…\\.…\\.尾巴？\\.\\.　怎么会\\.…\\.…\n"
"\\.竟然会这样\\.…\\.…\\.」\\|\\^"

#. ID 65, Page 1, Line 17, Pos (29,31)
msgid ""
"\n"
"宝箱の中から何かが飛び出し、\n"
"\\n[\\v[6]]の身体に巻きついてきた！"
msgstr ""
"有什么东西从宝箱里飞了出来，\n"
"\\n[\\v[6]]的身体被它缠上了！"

#. ID 65, Page 1, Line 33, Pos (29,31)
msgid ""
"\n"
"だが次の瞬間には、\n"
"箱から飛び出してきた何かはバラバラになっていた。"
msgstr ""
"但下一瞬间，\n"
"从箱子里飞出来的那个东西已经支离破碎了。"

#. ID 65, Page 1, Line 42, Pos (29,31)
msgid ""
"\n"
"\\n[\\v[6]]は縄のような物に\n"
"絡みつかれてしまった！"
msgstr "\\n[\\v[6]]被像绳子一样的东西缠住了！"

#. ID 66, Page 1, Line 12, Pos (28,32)
msgid ""
"\n"
"（あれ？\\.\\.　何ともない？）"
msgstr "（咦？\\.\\.　没什么事？）"

#. ID 110, Page 1, Line 3, Pos (8,7)
msgid ""
"\n"
"水晶玉が飾ってある。\\.\\.\n"
"その表面には誰かの後ろ姿が映っている。"
msgstr "装饰着一颗水晶球。\\.\\.其表面映出某人的背影。"

#. ID 110, Page 1, Line 12, Pos (8,7)
msgid ""
"\n"
"「これって、わたし\\.…\\.…\\.だよね？」"
msgstr "「这个，是我\\.…\\.…\\.吧？」"

#. ID 110, Page 1, Line 23, Pos (8,7)
msgid ""
"\n"
"「かすかに人の気配が残ってる\\.…\\.…\\.」"
msgstr "「还残留着微弱的人的气息\\.…\\.…\\.」"

#. ID 110, Page 1, Line 33, Pos (8,7)
msgid ""
"\n"
"「ずっと見られてた\\.…\\.…\\.？」"
msgstr "「一直被看着\\.…\\.…\\.？」"

#. ID 110, Page 2, Line 3, Pos (8,7)
msgid ""
"\n"
"水晶玉が飾ってある。\\.\\.\n"
"その表面には\\n[\\v[6]]の後ろ姿が映っている。"
msgstr ""
"装饰着一颗水晶球。\n"
"\\.\\.其表面映着\\n[\\v[6]]的背影。"
