#. ID 25, Page 2, Line 5, Pos (5,16)
msgid "おじちゃんはだれ？"
msgstr "叔叔，你是谁？"

#. ID 25, Page 2, Line 10, Pos (5,16)
msgid "……君はこんなところで暮らしているのかい？"
msgstr "……你就住在这样的地方吗？"

#. ID 25, Page 2, Line 15, Pos (5,16)
msgid "うん"
msgstr "嗯"

#. ID 25, Page 2, Line 20, Pos (5,16)
msgid "ママとパパは？"
msgstr "妈妈和爸爸呢？"

#. ID 25, Page 2, Line 25, Pos (5,16)
msgid "ずっと昔に遠くに行っちゃった"
msgstr "很久以前去了很远的地方"

#. ID 25, Page 2, Line 26, Pos (5,16)
msgid ""
"エヴァ へいきだよ\\!\n"
"エヴァ すごい魔法がつかえるの"
msgstr "艾娃 没事的哦\\!艾娃 会使用很厉害的魔法"

#. ID 25, Page 2, Line 28, Pos (5,16)
msgid ""
"でも みんなエヴァのこと怖がるの\n"
"パパもママもどこかに行っちゃった"
msgstr ""
"但是 大家都害怕艾娃，\n"
"爸爸和妈妈也都去了某个地方"

#. ID 25, Page 2, Line 30, Pos (5,16)
msgid "だから、ここでひとりで暮らしてるの"
msgstr "所以，我才一个人住在这里"

#. ID 25, Page 2, Line 35, Pos (5,16)
msgid "むぅ……"
msgstr "唔……"

#. ID 25, Page 2, Line 40, Pos (5,16)
msgid "おじちゃん？"
msgstr "叔叔？"

#. ID 25, Page 2, Line 45, Pos (5,16)
msgid "おじちゃん どうしてかなしそうなの？"
msgstr "叔叔 为什么看起来很难过？"

#. ID 25, Page 2, Line 50, Pos (5,16)
msgid "…………"
msgstr "…………"

#. ID 25, Page 2, Line 55, Pos (5,16)
msgid ""
"エヴァ\\!\n"
"付いてきなさい"
msgstr "艾娃\\!跟我来"

#. ID 48, Page 1, Line 3, Pos (1,3)
msgid "（ぷるぷる）"
msgstr "（抖抖）"

#. ID 48, Page 1, Line 4, Pos (1,3)
msgid ""
"（こんにちは\n"
"　ぼく黒ゴマくん）"
msgstr "（你好　我是黑芝麻君）"

#. ID 48, Page 1, Line 6, Pos (1,3)
msgid ""
"（10000年前に生まれたドラキュラの息子で\n"
"　あのアルカードの弟なの）"
msgstr ""
"（我是10000年前出生的德古拉之子　那个阿鲁卡多\n"
"　的弟弟）"

#. ID 48, Page 1, Line 8, Pos (1,3)
msgid "（今から魔王ガラモスを倒しに行くんだよ）"
msgstr "（现在开始要去打倒魔王加拉莫斯哦）"

#. ID 48, Page 1, Line 9, Pos (1,3)
msgid ""
"（いや嘘ですよ\n"
"　そんな物いませんからね？）"
msgstr "（不，骗你的啦　那种东西不存在的哦？）"

#. ID 48, Page 1, Line 11, Pos (1,3)
msgid "（この愚か者めが）"
msgstr "（你这蠢货）"
