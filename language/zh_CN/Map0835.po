#. ID 39, Page 2, Line 4, Pos (4,33)
msgid "\\S[2][セキュリティを確認しています....]"
msgstr "\\S[2][正在确认安全系统....]"

#. ID 39, Page 2, Line 7, Pos (4,33)
msgid "\\S[2][機密ドアは開いています]"
msgstr "\\S[2][机密门已打开]"

#. ID 39, Page 2, Line 10, Pos (4,33)
msgid "\\S[2][機密ドアは開いていません]"
msgstr "\\S[2][机密门未打开]"

#. ID 39, Page 2, Line 14, Pos (4,33)
msgid "\\S[2][101号室は開いています]"
msgstr "\\S[2][101号室已打开]"

#. ID 39, Page 2, Line 17, Pos (4,33)
msgid "\\S[2][101号室は開いていません]"
msgstr "\\S[2][101号室未打开]"

#. ID 40, Page 2, Line 5, Pos (19,4)
#. Choice (3 options)
msgid ""
"３Ｆ 資料保管室\n"
"８Ｆ 奴隷貞操帯整備室\n"
"やめておく"
msgstr ""
"3F 资料保管室\n"
"8F 奴隶贞操带整备室\n"
"算了"

#. ID 41, Page 2, Line 4, Pos (3,8)
msgid ""
"特別開発室とルビが降られた扉がある。\n"
"いろいろ試したが扉が開く気配はない。"
msgstr ""
"有特别开发室和一扇带有红宝石装饰的门。\n"
"各种方法都试过了，但门没有要打开的迹象。"

#. ID 41, Page 2, Line 16, Pos (3,8)
#. ChangeHeroName (Actor 115)
msgctxt "actors.name"
msgid "end:無し"
msgstr "end:无"

#. ID 42, Page 2, Line 3, Pos (30,17)
#. ID 43, Page 2, Line 3, Pos (9,17)
#. ID 44, Page 2, Line 3, Pos (31,17)
#. ID 45, Page 2, Line 3, Pos (10,17)
msgid ""
"＊開かない。\n"
"　遠隔操作で開閉できるドアのようだ。"
msgstr "＊打不开。　看来是可以通过远程操作开关的门。"

#. ID 46, Page 2, Line 5, Pos (32,29)
msgid ""
"\\S[2][範囲内に貞操帯を探知\n"
"起動します.......]"
msgstr "\\S[2][在范围内探测到贞操带并启动.......]"

#. ID 46, Page 2, Line 9, Pos (32,29)
msgid "！！"
msgstr "！！"

#. ID 46, Page 2, Line 10, Pos (32,29)
msgid ""
"スリープモードにしていた奴隷の貞操帯が\n"
"動き出し始めた……！"
msgstr "设为睡眠模式的奴隶贞操带开始动起来了……！"

#. ID 46, Page 2, Line 17, Pos (32,29)
msgid "\\S[2][貞操帯起動　　Y/N.......]"
msgstr "\\S[2][贞操带启动　　Y/N.......]"

#. ID 47, Page 2, Line 4, Pos (27,5)
msgid "\\S[2][女性生徒拘束衣強化装置]"
msgstr "\\S[2][女学生拘束衣强化装置]"

#. ID 47, Page 3, Line 4, Pos (27,5)
msgid ""
"\\S[2][範囲内に貞操帯を探知\n"
"アップグレードが可能です.......]"
msgstr ""
"\\S[2][在范围内探测到贞操带，\n"
"可以进行升级.......]"

#. ID 47, Page 3, Line 7, Pos (27,5)
msgid ""
"\\S[2][アップグレードすることで\n"
"現在の奴隷の貞操帯の強化を行うことが可能です]"
msgstr "\\S[2][通过升级，可以强化当前奴隶的贞操带]"

#. ID 47, Page 3, Line 10, Pos (27,5)
#. ID 47, Page 4, Line 4, Pos (27,5)
msgid ""
"\\S[2][強化された貞操帯は\n"
"一生を性奴として利用されることになった\n"
"性奴隷に対し用いられる装置です]"
msgstr ""
"\\S[2][强化后的贞操带，\n"
"是用于那些注定一生被当作性奴使用的性奴隶的装置\n"
"]"

#. ID 47, Page 3, Line 14, Pos (27,5)
#. ID 47, Page 4, Line 7, Pos (27,5)
msgid ""
"\\S[2][機能面でも強化されていますが、\n"
"耐久性が特に向上しており、\n"
"もはや既存の装置では取り外しは出来ません]"
msgstr ""
"\\S[2][功能方面也得到了强化，耐久性尤其提升，\n"
"已经无法用现有装置取下]"

#. ID 47, Page 3, Line 18, Pos (27,5)
msgid "\\S[2][そのため、装着は熟考の上行ってください]"
msgstr "\\S[2][因此，请深思熟虑后再进行佩戴]"

#. ID 47, Page 3, Line 24, Pos (27,5)
#. Contains choice at line 2 (2 options)
msgid "\\S[2][アップグレードしますか？]"
msgstr "\\S[2][要升级吗？]"

#. ID 47, Page 3, Line 27, Pos (27,5)
#. Choice (2 options, embedded in a message)
msgid ""
"は、はい……\n"
"そんなことしません！"
msgstr ""
"是、是的……\n"
"我才不会做那种事！"

#. ID 47, Page 3, Line 32, Pos (27,5)
msgid ""
"\\S[2][.............了解しました。\n"
"アップグレードを開始します。]"
msgstr "\\S[2][.............了解。开始升级。]"

#. ID 47, Page 3, Line 56, Pos (27,5)
msgid ""
"\\S[2][アップグレードが完了しました。\n"
"もう後戻りは出来ません。\n"
"ごゆっくりお楽しみください。]"
msgstr ""
"\\S[2][升级已完成。已经无法回头了。请慢慢享受。\n"
"]"

#. ID 47, Page 3, Line 63, Pos (27,5)
msgid ""
"＊……身に着けていた奴隷のていそうたいが\n"
"　さらに重厚になっていた。"
msgstr "＊……身上佩戴的奴隶的贞操带变得更加厚重了。"

#. ID 47, Page 3, Line 65, Pos (27,5)
msgid "＊もはや、これを取り外す手段はない……"
msgstr "＊已经，没有取下它的手段了……"

#. ID 47, Page 3, Line 66, Pos (27,5)
msgid ""
"＊取り返しのつかない事に、\n"
"　背徳と、マゾヒズムな快楽を感じる。"
msgstr "＊对无法挽回之事，感受到背德与受虐的快乐。"

#. ID 47, Page 3, Line 71, Pos (27,5)
msgid "＊[性奴のていそうたい]を手に入れた"
msgstr "＊获得了[性奴的贞操带]"

#. ID 47, Page 4, Line 10, Pos (27,5)
msgid "\\S[2][そのため、装着には細心の注意を]"
msgstr "\\S[2][因此，佩戴时请务必小心谨慎]"

#. ID 59, Page 2, Line 4, Pos (30,10)
#. ID 59, Page 2, Line 16, Pos (30,10)
msgid ""
"＊＊＊\n"
"「ひいっ！？\\|い、\\.今頑張って作ってますから…！"
msgstr "＊＊＊「噫！？\\|我、\\.我现在正努力制作呢……！"

#. ID 59, Page 2, Line 6, Pos (30,10)
msgid ""
"＊＊＊\n"
"「ま、\\.また貴女ですか……！\\!\n"
"　も、\\.もう私に用事はないですよね！\n"
"　話しかけないでください！"
msgstr ""
"＊＊＊「又、\\.又是你吗……！\\!　已、\n"
"\\.已经没有我的事了吧！　请不要跟我说话！"

#. ID 59, Page 2, Line 10, Pos (30,10)
msgid ""
"＊＊＊\n"
"「え？\\|追加された機能の説明？\\!\n"
"　6階のデータバンクに行けば見れると思いますよ！\\!\n"
"　ほらさっさといったいった！"
msgstr ""
"＊＊＊「诶？\\|追加功能的说明？\n"
"\\!　去6楼的数据银行应该就能看到哦！\n"
"　\\!　好啦快点去吧去吧！"

#. ID 59, Page 2, Line 18, Pos (30,10)
msgid ""
"＊＊＊\n"
"「って貴女誰ですか……？\\|\n"
"　ここの研究員とかではないみたいですけど……"
msgstr ""
"＊＊＊「我说，你谁啊……？\n"
"\\|　好像不是这里的研究员之类的……"

#. ID 59, Page 2, Line 21, Pos (30,10)
msgid ""
"＊＊＊\n"
"「いまはとても大事な作業中なので、\n"
"　話しかけないでほしいです！"
msgstr ""
"＊＊＊「现在正在做非常重要的工作，\n"
"　希望你不要跟我说话！"

#. ID 59, Page 2, Line 25, Pos (30,10)
msgid ""
"＊＊＊\n"
"「え？\\|リモコンの改造をしてほしい？"
msgstr "＊＊＊「诶？\\|想让我改造遥控器？"

#. ID 59, Page 2, Line 27, Pos (30,10)
msgid ""
"＊＊＊\n"
"「わ、\\,わかりましたよぉ。\\|\n"
"　手早く済ませますから早く貸してください！"
msgstr ""
"＊＊＊「知、\\,知道了啦。\\|　我会尽快弄完的，\n"
"快点借给我吧！"

#. ID 59, Page 2, Line 44, Pos (30,10)
msgid ""
"＊＊＊\n"
"「ほ、\\,ほらこれでいいですよね？\\|\n"
"　もうここに用はないでしょ？またね！"
msgstr ""
"＊＊＊「喏、\\,喏，这样就行了吧？\n"
"\\|　已经不用再来这里了吧？再见！"

#. ID 59, Page 2, Line 49, Pos (30,10)
msgid "リモートコントローラーが強化された……"
msgstr "遥控器被强化了……"

#. ID 60, Page 2, Line 3, Pos (8,10)
msgid ""
"＊＊＊\n"
"「データベースのチェックは完了…と。\n"
"　あとはルミナスさんからOKが出れば…"
msgstr ""
"＊＊＊「数据库的检查完成了……。\n"
"　剩下只要露米娜丝小姐给出OK的话……"

#. ID 62, Page 2, Line 3, Pos (18,28)
msgid ""
"＊＊＊\n"
"「ううっ、\\.気持ち悪いなぁ…\\|いくら命令とはいえ、\n"
"　こんなのルミナスさん以外、開発できっこないよ。"
msgstr ""
"＊＊＊「呜呜，\\.真恶心啊……\\|就算是命令，\n"
"　这种东西除了露米娜丝小姐，\n"
"　不可能开发得出来啊。"

#. ID 63, Page 2, Line 3, Pos (25,35)
msgid ""
"＊＊＊\n"
"「ええい、\\.使えない天使共だ。\\|早く開発を進めなければ\n"
"　アバロソに先を行かれるではないか！"
msgstr ""
"＊＊＊「可恶，\\.真是些派不上用场的天使。\n"
"\\|不快点推进开发的话　不就会被阿巴罗索抢先了吗\n"
"　！"

#. ID 63, Page 2, Line 6, Pos (25,35)
msgid ""
"＊＊＊\n"
"「あの特別開発室の女の部下だというから、\n"
"　多少は使えると思ったんだが買い被りだったな。"
msgstr ""
"＊＊＊「听说你是那个特别开发室女人的部下，\n"
"　还以为多少有点用，看来是我高估了。"

#. ID 63, Page 2, Line 9, Pos (25,35)
msgid ""
"＊＊＊\n"
"「グラドスは何故こいつらにそんなに執着する…\n"
"　私には理解に苦しむね。"
msgstr ""
"＊＊＊「格拉多斯为什么对这些家伙如此执着……\n"
"　我实在难以理解。"

#. ID 65, Page 2, Line 3, Pos (20,31)
msgid ""
"＊＊＊\n"
"「一歩間違えば自分が襲われるものを、\n"
"　進んで開発しようという小天使はここにはいません。"
msgstr ""
"＊＊＊「对于一步走错就会反过来袭击自己的东西，\n"
"　这里可没有会主动去开发的小天使。"

#. ID 65, Page 2, Line 6, Pos (20,31)
msgid ""
"＊＊＊\n"
"「ですからここにいる研究者たちからの\n"
"　怒りは募るばかり。\\|肩身の狭い思いですね。"
msgstr ""
"＊＊＊「所以这里的研究员们　怒气只增不减。\n"
"\\|真是让人抬不起头啊。"

#. ID 65, Page 2, Line 9, Pos (20,31)
msgid ""
"＊＊＊\n"
"「ルミナス技師は特別開発室に軟禁されて以降、\n"
"　開発も進んでないと聞きますし困りましたね。"
msgstr ""
"＊＊＊\n"
"「听说露米娜丝技师被软禁在特别开发室之后，\n"
"　开发也没有进展，真头疼啊。"

#. ID 66, Page 2, Line 3, Pos (10,29)
msgid ""
"＊＊＊\n"
"「開発資材が底をついてますね…\\|\n"
"　今の開発体制では仕方のないことですけどこれでは…"
msgstr ""
"＊＊＊「开发资材已经见底了呢……\n"
"\\|　以现在的开发体制虽然也是没办法的事，\n"
"　但这样下去的话……"

#. ID 67, Page 2, Line 3, Pos (4,9)
msgid ""
"＊＊＊\n"
"「この奥は特別開発室です。\\|\n"
"　ルミナス技師はこの奥にいますよ。"
msgstr ""
"＊＊＊「这后面是特别开发室。\n"
"\\|　露米娜丝技师就在这后面哦。"

#. ID 67, Page 2, Line 6, Pos (4,9)
msgid ""
"＊＊＊\n"
"「まぁ特別開発室という名の監獄ともいえますけど…"
msgstr ""
"＊＊＊「不过嘛，\n"
"也可以说是名为特别开发室的监狱……"
