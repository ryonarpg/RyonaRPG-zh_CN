#. ID 40, Page 2, Line 4, Pos (18,4)
msgid ""
"名前：デブータ\n"
"種族：獣人"
msgstr "名字：德布塔 种族：兽人"

#. ID 40, Page 2, Line 6, Pos (18,4)
msgid "豚の獣人"
msgstr "猪兽人"

#. ID 40, Page 2, Line 7, Pos (18,4)
#. Contains choice at line 3 (2 options)
msgid ""
"\\$10Gで攻略情報を聞くことができます\n"
"聞きますか？"
msgstr "用\\$10G可以打听攻略情报。要打听吗？"

#. ID 40, Page 2, Line 9, Pos (18,4)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"はい"
msgstr ""
"否\n"
"是"

#. ID 40, Page 2, Line 15, Pos (18,4)
msgid ""
"近くによると 「ブー!」と \n"
"石を投げてくる。\n"
"「ブー!」「ブー!」と うっとおしい。"
msgstr ""
"一靠近，就会「布—！」地扔石头过来。「布—！」\n"
"「布—！」地，真烦人。"

#. ID 40, Page 2, Line 18, Pos (18,4)
msgid ""
"ブーブー!\n"
" ブーブーブー!"
msgstr "哼哼—！ 哼哼哼—！"

#. ID 40, Page 2, Line 20, Pos (18,4)
msgid "特に弱点はない！"
msgstr "没有特别弱点！"

#. ID 40, Page 2, Line 21, Pos (18,4)
msgid ""
"稀に\\C[2]オーククラブ\\C[0]を\n"
"落とす"
msgstr "偶尔会掉落\\C[2]兽人棍棒\\C[0]"
