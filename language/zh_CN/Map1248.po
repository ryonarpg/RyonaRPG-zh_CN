#. ID 11, Page 2, Line 3, Pos (11,7)
msgid "妖蟲の卵を手に入れた。"
msgstr "获得了妖虫卵。"

#. ID 12, Page 2, Line 3, Pos (13,7)
msgid "大蛙を手に入れた。"
msgstr "获得了巨蛙。"

#. ID 13, Page 2, Line 3, Pos (14,7)
msgid "ラはーぴーの羽根を手に入れた。"
msgstr "获得了拉哈比羽毛。"

#. ID 14, Page 2, Line 3, Pos (15,7)
msgid "巨大魚の鱗を手に入れた。"
msgstr "获得了巨鱼鳞。"

#. ID 17, Page 2, Line 3, Pos (4,9)
#. Contains choice at line 2 (2 options)
msgid "＊魔力溜まりがある。"
msgstr "＊有魔力池。"

#. ID 17, Page 2, Line 4, Pos (4,9)
#. Choice (2 options, embedded in a message)
msgid ""
"魔力を回復する\n"
"いいえ"
msgstr ""
"恢复魔力\n"
"否"

#. ID 23, Page 2, Line 3, Pos (7,7)
#. ID 24, Page 2, Line 3, Pos (8,7)
msgid "遺骨を手に入れた。"
msgstr "获得了遗骨。"

#. ID 25, Page 2, Line 3, Pos (9,7)
msgid "遺品を手に入れた。"
msgstr "获得了遗物。"

#. ID 26, Page 2, Line 3, Pos (10,7)
msgid "ゲリデルバーの実を手に入れた。"
msgstr "获得了盖里德尔巴果实。"

#. ID 27, Page 2, Line 3, Pos (16,7)
msgid "ガマの油を手に入れた。"
msgstr "获得了蟾蜍油。"

#. ID 28, Page 2, Line 3, Pos (12,7)
msgid "海サボテンを手に入れた。"
msgstr "获得了海仙人掌。"

#. ID 39, Page 2, Line 3, Pos (17,7)
msgid "蛙の卵を手に入れた。"
msgstr "获得了蛙卵。"

#. ID 40, Page 2, Line 4, Pos (13,11)
msgid ""
"名前：酒呑童子\n"
"種族：爬虫類"
msgstr "名字：酒吞童子种族：爬虫类"

#. ID 40, Page 2, Line 6, Pos (13,11)
msgid ""
"大酒飲みの妖怪の一種\n"
"ヤマタノオロチという妖怪の親戚らしい"
msgstr "一种嗜酒妖怪，似乎是名叫八岐大蛇的妖怪的亲戚"

#. ID 40, Page 2, Line 8, Pos (13,11)
#. Contains choice at line 3 (2 options)
msgid ""
"\\$1000Gで攻略情報を聞くことができます\n"
"聞きますか？"
msgstr "可以用\\$1000G听取攻略信息要听吗？"

#. ID 40, Page 2, Line 10, Pos (13,11)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"はい"
msgstr ""
"否\n"
"是"

#. ID 40, Page 2, Line 16, Pos (13,11)
msgid ""
"外見とは裏腹に爬虫類である\\!\n"
"それ故に氷属性の攻撃が有効打となる"
msgstr "与外表相反是爬虫类！因此冰属性攻击成为有效打击"
