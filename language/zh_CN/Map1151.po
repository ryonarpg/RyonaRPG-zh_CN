#. ID 1, Page 1, Line 3, Pos (120,67)
#. Contains choice at line 2 (2 options)
msgid "街の外に出ますか？"
msgstr "要出城吗？"

#. ID 1, Page 1, Line 4, Pos (120,67)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 7, Page 1, Line 3, Pos (38,71)
msgid "砂浜で拾ったアイテムをシュゥゥゥゥ！！"
msgstr "把在沙滩上捡到的道具咻ゥゥゥゥ！！"

#. ID 7, Page 1, Line 8, Pos (38,71)
msgid "超ゥ！エキサイティンッッッ！！"
msgstr "超ゥ！太刺激了ッッッ！！"

#. ID 8, Page 1, Line 3, Pos (34,70)
msgid "あそこでテンションあがってる子…ウチの妹なんだが"
msgstr "在那边情绪高涨的那孩子…是我妹妹。"

#. ID 8, Page 1, Line 4, Pos (34,70)
msgid ""
"やってる事が家の近くで水遊びしてる時と\n"
"まったく変わらないんだ"
msgstr "她做的事和在自家附近玩水的时候完全一样。"

#. ID 8, Page 1, Line 6, Pos (34,70)
msgid ""
"わざわざ遠くから海に来たのに、と思う反面\n"
"妹が楽しいならそれでいいかとも思う"
msgstr ""
"虽然觉得特地大老远来到海边，\n"
"但另一方面又觉得如果妹妹开心的话那样也好。"

#. ID 8, Page 1, Line 8, Pos (34,70)
msgid "でもやっぱ海に来た意味あるのか？"
msgstr "不过果然还是会想，来海边到底有意义吗？"

#. ID 9, Page 1, Line 3, Pos (37,67)
msgid ""
"あそこで遊んでいるあの子たちは\n"
"望んで産んだ子ではありませんでした…"
msgstr ""
"在那边玩耍的那些孩子们，\n"
"并不是我自愿生下来的孩子……"

#. ID 9, Page 1, Line 5, Pos (37,67)
msgid ""
"でも娘たちが楽しんでいる姿を見ると\n"
"この子たちを産んでよかったと思います。"
msgstr ""
"但是看到女儿们开心的样子，\n"
"我就觉得生下这些孩子真是太好了。"

#. ID 10, Page 1, Line 3, Pos (63,61)
msgid "OU…ダイナマイぃ…"
msgstr "OU…太劲爆了…"

#. ID 11, Page 1, Line 3, Pos (60,72)
msgid "気のせいかしら…さっきから妙な視線を感じるのよね～"
msgstr "是错觉吗…从刚才开始就感觉到奇怪的视线呢～"

#. ID 12, Page 1, Line 3, Pos (28,65)
msgid ""
"ああ…ワタシ…いま…ジュージツしてるって\n"
"心の底からそう思う"
msgstr "啊…我…现在…发自内心地觉得非常充实。"

#. ID 13, Page 1, Line 3, Pos (78,68)
#. ID 14, Page 1, Line 3, Pos (77,68)
#. ID 15, Page 1, Line 3, Pos (76,68)
#. ID 16, Page 1, Line 3, Pos (75,68)
#. ID 17, Page 1, Line 3, Pos (74,68)
#. ID 18, Page 1, Line 3, Pos (73,68)
msgid ""
"\n"
"おそらく海辺にきて妙にテンションが上がった男集…\n"
"そんな所だろう…"
msgstr "大概是来到海边后异常兴奋的一群男人…就是那样吧…"

#. ID 19, Page 1, Line 3, Pos (69,65)
#. ID 37, Page 1, Line 3, Pos (67,65)
msgid ""
"\n"
"遊び疲れて眠っているようだ…"
msgstr "似乎玩累了睡着了…"

#. ID 20, Page 1, Line 3, Pos (33,42)
#. ID 26, Page 1, Line 3, Pos (34,42)
msgid ""
"\\>\n"
"\\>海鳴港\n"
"\\>"
msgstr ""
"\\>\n"
"\\>海鸣港\n"
"\\>"

#. ID 21, Page 1, Line 3, Pos (36,63)
#. ID 39, Page 1, Line 3, Pos (35,63)
msgid ""
"\n"
"聞きほれているようだ…"
msgstr "似乎听得入迷了…"

#. ID 22, Page 1, Line 3, Pos (13,66)
msgid "よ…よーし…飛び込むわよッ！"
msgstr "好…好——！我要跳下去了哦！"

#. ID 22, Page 1, Line 4, Pos (13,66)
msgid "………よ、よし！覚悟完了！"
msgstr "………好、好了！心理准备完毕！"

#. ID 22, Page 1, Line 5, Pos (13,66)
msgid "………いくわよ！"
msgstr "………我要跳了哦！"

#. ID 22, Page 1, Line 6, Pos (13,66)
#. Contains choice at line 2 (2 options)
msgid "………の前に深呼吸"
msgstr "………不过在那之前先深呼吸"

#. ID 22, Page 1, Line 7, Pos (13,66)
#. Choice (2 options, embedded in a message)
msgid ""
"押す\n"
"このままながめてるのもいいか"
msgstr ""
"按下\n"
"就这么继续看着也不错"

#. ID 23, Page 1, Line 3, Pos (100,62)
msgid ""
"あら、人魚がこんな所にいるのは不思議？\n"
"安心なさい、ライフセーバーのバイトだから"
msgstr ""
"哎呀，人鱼会待在这种地方真是不可思议？放心吧，\n"
"我是兼职救生员"

#. ID 24, Page 1, Line 3, Pos (76,65)
msgid "みてみて！おかあさん！へんなおどり～"
msgstr "快看快看！妈妈！奇怪的舞蹈～"

#. ID 25, Page 1, Line 3, Pos (76,64)
msgid ""
"ああコラ、みちゃいけません\n"
"男の人達が可哀想でしょ？"
msgstr "喂喂，不可以看哦，男人们会可怜的吧？"

#. ID 27, Page 1, Line 3, Pos (44,66)
msgid ""
"海で泳ぐにしても\n"
"この帽子だけは外せないねぇ"
msgstr "就算在海里游泳，也只有这顶帽子不能摘呢"

#. ID 28, Page 1, Line 3, Pos (21,67)
msgid "ううぅ…こんな子供っぽい水着で来るんじゃなかった"
msgstr "呜呜……真不该穿这么孩子气的泳衣来"

#. ID 29, Page 1, Line 3, Pos (7,21)
msgid ""
"\\>今後の予定\n"
"\\>・依頼攻略によるミニシナリオの完成\n"
"\\>・上記に伴う依頼関連の充実\n"
"\\>・別マップでヌーディストビーチ＆エロス"
msgstr ""
"\\>今后的预定\n"
"\\>・通过攻略委托完成迷你剧本\n"
"\\>・伴随上述内容充实委托相关\n"
"\\>・在其他地图裸体海滩＆情色"

#. ID 30, Page 1, Line 3, Pos (50,70)
msgid "いっちに…さん…しー…"
msgstr "一、二……三……四……"

#. ID 31, Page 1, Line 3, Pos (51,70)
msgid "準備運動はしっかりしないとダメなんだからね！"
msgstr "准备运动不好好做可不行哦！"

#. ID 32, Page 1, Line 3, Pos (38,60)
#. ID 34, Page 1, Line 3, Pos (40,60)
#. ID 35, Page 1, Line 3, Pos (36,60)
msgid "う～み～わ～　ひろい～な～　お～っき～な～♪"
msgstr "大～海～呀～　真宽广～啊～　真大～啊～♪"

#. ID 32, Page 1, Line 4, Pos (38,60)
#. ID 34, Page 1, Line 4, Pos (40,60)
#. ID 35, Page 1, Line 4, Pos (36,60)
msgid "つ～き～が～のぼる～し　ひがし～ず～む～♪"
msgstr "月～亮～升～起～来　太阳～西～沉～♪"

#. ID 32, Page 1, Line 5, Pos (38,60)
#. ID 34, Page 1, Line 5, Pos (40,60)
#. ID 35, Page 1, Line 5, Pos (36,60)
msgid "この曲、日が上るが先に来て、月は沈むだと思います"
msgstr "我觉得这首歌是太阳升起先出现，月亮下沉吧"

#. ID 33, Page 1, Line 3, Pos (47,59)
msgid ""
"小さい子供達を見てると癒されるわ～\n"
"あぁ～…尊いんじゃぁ～…"
msgstr "看着小孩子们真的很治愈呢～啊～……太尊贵了～……"

#. ID 36, Page 1, Line 3, Pos (88,66)
msgid "イイ男との出会いを期待してたんだけど…ねぇ？"
msgstr "本来还期待能遇到好男人的……对吧？"

#. ID 36, Page 1, Line 4, Pos (88,66)
msgid ""
"あそこにいる連中見てそんな気もなくなったわ\n"
"時代はやっぱり男よりカワイイ女の子よね♪\n"
"\n"
"　　　　　　 　　　　　　　　　　　　　　　　\\>ｼﾞｭﾙﾘ"
msgstr ""
"看到那边的那些家伙后，那种心情也没了。\n"
"时代果然比起男人还是可爱女孩子♪　　　　　　 　\n"
"　　　　　　　　　　　　　　　\\>吸溜"

#. ID 38, Page 1, Line 3, Pos (38,63)
msgid "フトモモ…グンバツだぜぇ"
msgstr "大腿……真棒啊"

#. ID 40, Page 1, Line 3, Pos (18,54)
msgid ""
"ここで商売してると目が肥えていけないよ\n"
"いやー眼福眼福"
msgstr ""
"在这里做生意，眼光都养刁了可真受不了。\n"
"哎呀～眼福眼福"

#. ID 41, Page 1, Line 3, Pos (41,63)
msgid "ふううむ…よい歌と踊りじゃ…"
msgstr "唔嗯……好歌好舞啊……"

#. ID 42, Page 1, Line 3, Pos (83,38)
msgid ""
"繁盛するのは結構だけど\n"
"こうも毎日忙しいと…ちょっとアレだねぇ"
msgstr "生意兴隆是好事，但每天都这么忙的话……有点那个呢"

#. ID 43, Page 1, Line 3, Pos (93,43)
msgid "わたしね！おてつだいちゅうなの！"
msgstr "我呀！正在帮忙哦！"

#. ID 44, Page 1, Line 3, Pos (49,39)
msgid "みんな泳ぎにいっちゃった…ボク泳げないのに…"
msgstr "大家都去游泳了……我明明不会游泳……"

#. ID 45, Page 1, Line 3, Pos (9,57)
msgid "おふねさんみえないな～"
msgstr "看不见小船小姐呢～"

#. ID 46, Page 1, Line 3, Pos (57,67)
msgid ""
"\n"
"熱さででダウンしたようだ…"
msgstr "好像因为太热而倒下了……"

#. ID 47, Page 1, Line 3, Pos (109,25)
msgid ""
"お宿はお決まりですか？\n"
"まだらなぜひ当店にてご宿泊を"
msgstr "您决定好住处了吗？如果还没定，请务必在本店住宿"

#. ID 48, Page 1, Line 3, Pos (41,20)
msgid "えっと…次の依頼は…"
msgstr "呃……下一个委托是……"

#. ID 49, Page 1, Line 3, Pos (46,18)
msgid ""
"ここはトラベラーズ組合…\n"
"気になるなら寄って行くがいい"
msgstr "这里是旅行者公会……如果在意的话，去看看也无妨"

#. ID 50, Page 1, Line 3, Pos (37,35)
msgid "買出しもラクじゃないわ"
msgstr "采购也不轻松呢"

#. ID 51, Page 1, Line 3, Pos (32,44)
msgid "本日、到着予定の定期船および交易船はありません"
msgstr "今天没有预定到达的定期船和交易船"

#. ID 51, Page 1, Line 4, Pos (32,44)
msgid ""
"個人所有の船を入港する場合は\n"
"中で申請をお願いします"
msgstr "个人所有的船只入港时，请在里面办理申请"

#. ID 52, Page 1, Line 3, Pos (14,53)
msgid ""
"交易船も定期船も来ないんじゃ\n"
"やる事なんてほとんど無いよ"
msgstr "交易船和定期船都不来，几乎没什么事可做哦"

#. ID 53, Page 1, Line 3, Pos (35,35)
msgid "イラッシャーイ、シャッチョッサン"
msgstr "欢迎光临～，社长"

#. ID 54, Page 1, Line 3, Pos (43,18)
msgid "ここはトラベラーズ組合だ"
msgstr "这里是旅行者公会"

#. ID 55, Page 1, Line 3, Pos (50,24)
msgid ""
"大きい建物でしょ？\n"
"これでもトラベラーズ協会\"支部\"なんだって！"
msgstr "很大的建筑吧？听说这还只是旅行者协会的「支部」！"

#. ID 55, Page 1, Line 5, Pos (50,24)
msgid "本部の大きさって一体どれくらい大きいんだろ…"
msgstr "总部到底有多大呢……"

#. ID 56, Page 1, Line 3, Pos (54,62)
msgid "さぁ～泳ぐわよ！"
msgstr "好啦～去游泳吧！"

#. ID 57, Page 1, Line 3, Pos (33,49)
msgid "観光地すぎてアイテムちゃんと確保できるのかしら？"
msgstr "太像观光地了，不知道能不能好好确保道具呢？"

#. ID 58, Page 1, Line 3, Pos (31,49)
msgid ""
"なんでもいいが…まず宿を探さないか？\n"
"\n"
"\n"
"　　　　　　　　　　　　　　　　　　　　　　　 \\>ｱﾂｲ"
msgstr ""
"什么都行……不过先找住处吧？\n"
"　　　　　　　　　　　　　　　　　　　　　　　\n"
" \\>好热"

#. ID 65, Page 1, Line 3, Pos (59,22)
msgid "…アンタも大変だねぇ"
msgstr "……你也真不容易啊"

#. ID 66, Page 1, Line 3, Pos (68,6)
msgid "ん？ここは冒険者向けの物品は置いてないよ"
msgstr "嗯？这里不放面向冒险者的物品哦"

#. ID 67, Page 1, Line 3, Pos (66,18)
msgid "この子はウチの飼い猫なの、カワイイでしょ！"
msgstr "这孩子是我家养的猫，可爱吧！"

#. ID 67, Page 1, Line 4, Pos (66,18)
msgid "ちょっと…鳴き声がヘンだけどね"
msgstr "不过……叫声有点怪就是了"

#. ID 68, Page 1, Line 3, Pos (108,64)
#. Contains choice at line 3 (2 options)
msgid ""
"村の安全のため夜間の入出は禁じておる\n"
"スマヌが朝まで待たれるか、出直して欲しいでゴザル"
msgstr ""
"为了村子的安全，夜间禁止进出。很抱歉，\n"
"希望您等到早上，或者改日再来"

#. ID 68, Page 1, Line 5, Pos (108,64)
#. Choice (2 options, embedded in a message)
msgid ""
"朝まで待つ\n"
"出直す"
msgstr ""
"等到早上\n"
"改日再来"

#. ID 69, Page 1, Line 4, Pos (66,19)
msgid ""
"\n"
"にゃぁン"
msgstr "喵～嗯"

#. ID 70, Page 1, Line 3, Pos (69,42)
msgid ""
"この村に海目的で来る人は多いけど\n"
"実はネコ目的で来る人も多いんだよ！"
msgstr ""
"来这个村子的人很多是为了海，\n"
"但其实为了猫来的人也很多哦！"

#. ID 71, Page 1, Line 3, Pos (106,64)
msgid ""
"ここは海鳴村だ\n"
"どこから来たかわからんが道中お疲れ様\n"
"ゆっくり休んでいってくれ"
msgstr ""
"这里是海鸣村。虽然不知道你从哪里来，\n"
"一路辛苦了，好好休息再走吧"

#. ID 72, Page 1, Line 3, Pos (105,48)
msgid "うう…熱い…はやく宿屋見つけて…海にダイブしたい"
msgstr "呜呜……好热……快点找到旅馆……想跳进海里"

#. ID 72, Page 1, Line 4, Pos (105,48)
msgid "でも…ネコちゃん…かわいいなぁ…"
msgstr "但是……小猫……好可爱啊……"

#. ID 73, Page 1, Line 3, Pos (56,34)
msgid "いい風の吹く町ね…\\|町じゃない？\\.村？"
msgstr "风吹得很舒服的城镇呢…\\|不是城镇？\\.村子？"

#. ID 73, Page 1, Line 4, Pos (56,34)
msgid "いっ…\\|いい風が吹いてるってトコが重要なのッ！"
msgstr "呃……\\|吹着舒服的风这一点才重要！"

#. ID 76, Page 1, Line 3, Pos (94,37)
#. ID 77, Page 1, Line 3, Pos (78,21)
#. ID 78, Page 1, Line 3, Pos (73,32)
#. ID 79, Page 1, Line 3, Pos (97,2)
#. ID 80, Page 1, Line 3, Pos (91,21)
msgid ""
"\n"
"ただの民家に断りも無く入るのはいかがなモノか…\n"
msgstr "未经允许就进普通民宅，是不是不太好啊……"

#. ID 81, Page 1, Line 3, Pos (101,37)
msgid ""
"アンタも観光で来たか？\n"
"ここはいい場所だよ、ゆっくりしてきな"
msgstr "你也是来观光的吗？这里是个好地方哦，慢慢玩吧"

#. ID 82, Page 1, Line 3, Pos (97,23)
msgid ""
"おねーちゃんもボーケンシャー？\n"
"あたしもボーケンしたいなぁー\n"
"つれてってくれない？ダメ？"
msgstr ""
"姐姐也是冒险者吗？我也想冒险呀～能带我去吗？\n"
"不行吗？"

#. ID 83, Page 1, Line 3, Pos (87,27)
msgid ""
"正直、ここまで大きいと村と言うより町なんだけど\n"
"「海鳴町」って呼ぶと違和感すごいのよね"
msgstr ""
"老实说，大到这个程度，\n"
"与其说是村子不如说是城镇，\n"
"但叫「海鸣町」的话违和感超强的呢"

#. ID 83, Page 1, Line 5, Pos (87,27)
msgid ""
"で、結局今でも海鳴村って呼ばれてるの\n"
"そっちの方が呼びやすいし"
msgstr ""
"所以，结果现在也还是被叫作海鸣村，\n"
"因为那样叫起来更方便"

#. ID 84, Page 1, Line 3, Pos (30,55)
msgid "ボク、この村に生まれてよかった…"
msgstr "我，能生在这个村子真是太好了……"

#. ID 84, Page 1, Line 4, Pos (30,55)
msgid ""
"乳ぃ！尻ぃ！フトモモぉ！全部見放題！\n"
"ラインクッキリのピチピチギャル！\n"
"ぬれてスケスケの白シャツ！"
msgstr ""
"奶子！屁股！大腿！全都随便看！\n"
"曲线分明的水灵辣妹！湿透后透透的白衬衫！"

#. ID 84, Page 1, Line 7, Pos (30,55)
msgid "思い出しただけで…\\|うッ！"
msgstr "光是回想起来……\\|呜！"

#. ID 84, Page 1, Line 10, Pos (30,55)
msgid "……………ふう"
msgstr "……………呼"

#. ID 85, Page 1, Line 3, Pos (114,30)
msgid ""
"トラベラーズ支部が出来てから\n"
"この村は大きくなったわ、魔物も退治してくれるし\n"
"村の困りごとも解決してくれる"
msgstr ""
"自从旅行者支部建立之后，这个村子变大了，\n"
"他们会消灭魔物，也会解决村子的困扰"

#. ID 85, Page 1, Line 6, Pos (114,30)
msgid ""
"アバロソやメルベルの役人より\n"
"よっぽど村の為に働いてくれてるわ"
msgstr ""
"比起阿巴洛索和梅尔贝尔的官员，\n"
"他们为村子工作得多得多了"

#. ID 86, Page 1, Line 3, Pos (114,50)
msgid ""
"ここで村を守る仕事をするだけでも\n"
"最低限生活していくだけのお金が入るんだもの\n"
"ほんと協会様様ね"
msgstr ""
"只要在这里做保护村子的工作，\n"
"就能得到足够维持最低生活的钱，\n"
"真的得感谢协会大人呢"

#. ID 87, Page 1, Line 3, Pos (93,6)
msgid ""
"ここでの暮らしはラクなモンですわ\n"
"やっぱ人間、地に足つけて生きるモンですわ"
msgstr ""
"在这里的生活很轻松哦。\n"
"果然人还是要脚踏实地地活着啊"

#. ID 88, Page 1, Line 3, Pos (89,2)
msgid "らっしゃい、冒険者用のアイテムそろえてるよ"
msgstr "欢迎光临，我这儿备有冒险者用的道具哦"

#. ID 89, Page 1, Line 3, Pos (79,9)
msgid "ここはいい村だ、流れ者の私にもよくしてくれる"
msgstr "这里是个好村子，对我这种流浪者也很好"

#. ID 89, Page 1, Line 4, Pos (79,9)
msgid "何か裏があるんじゃないかって思う位にわね"
msgstr "好到让人怀疑是不是有什么内情呢"

#. ID 100, Page 1, Line 3, Pos (54,24)
#. ID 101, Page 1, Line 3, Pos (55,24)
msgid ""
"\\>\n"
"\\>トラベラーズ　海鳴支部　\n"
"\\>"
msgstr ""
"\\>\n"
"\\>旅行者　海鸣支部　\n"
"\\>"

#. ID 102, Page 1, Line 3, Pos (57,62)
#. ID 103, Page 1, Line 3, Pos (58,62)
msgid ""
"\\>\n"
