#. ID 16, Page 3, Line 10, Pos (0,14)
msgid "………？"
msgstr "………？"

#. ID 16, Page 3, Line 11, Pos (0,14)
#. ID 16, Page 3, Line 36, Pos (0,14)
msgid ""
"………\n"
"\\.\\.………！！"
msgstr ""
"………\n"
"\\.\\.………！！"

#. ID 16, Page 3, Line 22, Pos (0,14)
msgid ""
"汚水の中の何かが\\n[\\v[6]]の肛門に張り付き、\n"
"腸内に侵入した！"
msgstr ""
"污水中的某种东西\\n[\\v[6]]的肛门上附着，\n"
"侵入了肠道！"

#. ID 16, Page 3, Line 30, Pos (0,14)
#. ID 16, Page 3, Line 55, Pos (0,14)
msgid "\\n[\\v[6]]は寄生されてしまった！"
msgstr "\\n[\\v[6]]被寄生了！"

#. ID 16, Page 3, Line 47, Pos (0,14)
msgid ""
"汚水の中から新たな寄生虫が\\n[\\v[6]]の\n"
"腸内へ潜り込む！"
msgstr "从污水中新的寄生虫\\n[\\v[6]]的肠道内潜入！"

#. ID 16, Page 3, Line 78, Pos (0,14)
#. ID 16, Page 3, Line 99, Pos (0,14)
msgid "………"
msgstr "………"

#. ID 16, Page 3, Line 79, Pos (0,14)
msgid ""
"…気分がすぐれない。\\!\n"
"どうやらウィルスが傷口から感染してしまったようだ。"
msgstr "…感觉不舒服。\\!看来病毒从伤口感染了。"

#. ID 16, Page 3, Line 100, Pos (0,14)
msgid ""
"…体が熱い。\\!\n"
"どうやらウィルスが傷口から感染してしまったようだ。"
msgstr "…身体发热。\\!看来病毒从伤口感染了。"

#. ID 83, Page 2, Line 3, Pos (20,16)
#. Contains choice at line 2 (2 options)
msgid "*カビに覆われたノートがある。"
msgstr "*有一本被霉菌覆盖的笔记本。"

#. ID 83, Page 2, Line 4, Pos (20,16)
#. Choice (2 options, embedded in a message)
msgid ""
"読む\n"
"いいえ"
msgstr ""
"阅读\n"
"否"

#. ID 83, Page 2, Line 12, Pos (20,16)
msgid ""
"*ノートはボロボロに腐食していたため、\n"
"\\n[\\v[6]]は断片的な情報しか得られなかった。"
msgstr ""
"*因为笔记本已经破烂不堪地腐蚀了，\n"
"\\n[\\v[6]]只得到了片段的信息。"

#. ID 83, Page 2, Line 14, Pos (20,16)
msgid ""
"…調査の結果、ノースレイの\n"
"異様な生態系は…"
msgstr "…调查的结果，诺斯雷的异常生态系统是…"

#. ID 83, Page 2, Line 16, Pos (20,16)
msgid ""
"…精霊力の枯渇…\n"
"繭状の生命体…寄生生物の氾濫は…\n"
"…に対する異様なまでの執着は魔力の量によるものか？"
msgstr ""
"…精灵力的枯竭…茧状的生命体…寄生生物的泛滥……\n"
"对于……的异常执着是因为魔力的量吗？"

#. ID 83, Page 2, Line 19, Pos (20,16)
msgid ""
"森林部に比べ、沼地の生命の不毛さは何だ…\n"
"森には…沼…寄生生物も…"
msgstr ""
"与森林部分相比，沼泽地生命的贫瘠是怎么回事…\n"
"森林里有…沼泽…寄生生物也…"

#. ID 83, Page 2, Line 21, Pos (20,16)
msgid ""
"…第一調査団の遺骸を発見する。\n"
"焼き尽くされて…"
msgstr "…发现第一调查团的遗骸。被烧尽了…"

#. ID 83, Page 2, Line 23, Pos (20,16)
msgid ""
"…過去にも、皇国から調査団が…\n"
"かつては美しい自然が…\n"
"全て失われている。"
msgstr ""
"…过去也有，来自皇国的调查团…曾经美丽的自然…\n"
"全部失去了。"

#. ID 83, Page 2, Line 26, Pos (20,16)
msgid ""
"…腐海の水の色…精霊力が…\n"
"灰色に近づく。"
msgstr "…腐海的水的颜色…精灵力…接近灰色。"

#. ID 83, Page 2, Line 28, Pos (20,16)
msgid "おそらくは何者かが…"
msgstr "恐怕是什么人…"

#. ID 83, Page 2, Line 29, Pos (20,16)
msgid ""
"大地から最も生命力の失われた場所…\n"
"そこが腐海の中心に違いない。"
msgstr ""
"从大地上生命力丧失最多的地方…\n"
"那里必定是腐海的中心。"
