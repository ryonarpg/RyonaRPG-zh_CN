#. ID 57, Page 2, Line 3, Pos (6,25)
#. ID 58, Page 2, Line 3, Pos (8,17)
#. ID 59, Page 2, Line 3, Pos (6,13)
#. ID 64, Page 2, Line 3, Pos (8,7)
msgid "＊返事がない……ただの屍のようだ。"
msgstr "＊没有回应……简直就像一具尸体。"

#. ID 60, Page 2, Line 5, Pos (7,23)
#. ID 63, Page 2, Line 4, Pos (9,4)
msgid "＊捨てられた奴隷が書き残したメモのようだ"
msgstr "＊像是被抛弃的奴隶留下的笔记"

#. ID 60, Page 2, Line 10, Pos (7,23)
msgid ""
"＊たすけて\n"
"\n"
"　　　まま"
msgstr "＊救救我　　　妈妈"

#. ID 61, Page 2, Line 5, Pos (9,27)
msgid ""
"＊汚い文字で書かれている\n"
"　何かの報告書のようだ"
msgstr "＊用潦草的字迹写着　像是某种报告书"

#. ID 61, Page 2, Line 11, Pos (9,27)
msgid ""
"＊命令の通り旧研究所に彼らを閉じ込めた\n"
"　表の舞台に出てくることはもうないだろう"
msgstr ""
"＊按照命令把他们关进了旧研究所　他们再也不会出\n"
"　现在公开舞台上了吧"

#. ID 62, Page 2, Line 6, Pos (14,6)
msgid ""
"＊エレベーターの点検記録\n"
"　整備状況……良好"
msgstr "＊电梯的检修记录　维护状况……良好"

#. ID 63, Page 2, Line 9, Pos (9,4)
msgid ""
"＊我々が此処に閉じ込められて何年になるのだろうか\n"
"　だがどれだけ月日が流れようと\n"
"　それは我々にとって大した問題ではなくなっている"
msgstr ""
"＊我们被关在这里已经几年了呢　但是无论流逝多少\n"
"　岁月　那对我们来说都已不再是什么大问题"

#. ID 63, Page 2, Line 12, Pos (9,4)
msgid "＊我々はまだ生きている"
msgstr "＊我们还活着"

#. ID 64, Page 2, Line 4, Pos (8,7)
msgid ""
"＊……下半身に、金属の下着の様な物を身に着けていた\n"
"　取り外そうとしたのか、傷がついている。\n"
"　引っかいたのか、手の爪が割れていた。"
msgstr ""
"＊……\n"
"　下半身穿着像金属内裤一样的东西\n"
"　大概是试图取下，上面有划痕。　也许是抓挠过，\n"
"　手指甲裂开了。"

#. ID 65, Page 2, Line 5, Pos (9,7)
msgid "＊……すぐ側で倒れた奴隷が書き残したメモのようだ"
msgstr "＊……像是倒在旁边的奴隶留下的笔记"

#. ID 65, Page 2, Line 10, Pos (9,7)
msgid "＊きんぞくの　スライムにちかづいては　だめ"
msgstr "＊金属的　史莱姆　不可以靠近"

#. ID 65, Page 2, Line 11, Pos (9,7)
msgid "＊きが　くるい"
msgstr "＊脑子　会发疯"

#. ID 65, Page 2, Line 16, Pos (9,7)
msgid "＊……後は、筆跡が酷く乱れ読むことができない。"
msgstr "＊……之后的部分，笔迹极其凌乱，无法阅读。"
