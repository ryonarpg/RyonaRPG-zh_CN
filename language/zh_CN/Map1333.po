#. ID 27, Page 2, Line 4, Pos (14,3)
msgid ""
"名前：ムー\n"
"種族：特殊装甲"
msgstr "名字：姆 种族：特殊装甲"

#. ID 27, Page 2, Line 6, Pos (14,3)
msgid "茶色の顔面岩"
msgstr "茶色颜面岩"

