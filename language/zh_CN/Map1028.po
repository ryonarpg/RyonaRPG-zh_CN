#. ID 12, Page 1, Line 3, Pos (1,0)
#. ChangeHeroName (Actor 115)
msgctxt "actors.name"
msgid "end:ピラミッド審判"
msgstr "end:金字塔审判"

#. ID 13, Page 1, Line 4, Pos (2,0)
#. ID 13, Page 1, Line 78, Pos (2,0)
msgid "うがー……"
msgstr "呜嘎——……"

#. ID 13, Page 1, Line 90, Pos (2,0)
msgid ""
"来る日も来る日も\n"
"\\N[\\V[6]]はミイラ達の慰み者にされ続け――"
msgstr "日复一日，\\N[\\V[6]]持续被木乃伊们当作玩物——"

#. ID 13, Page 1, Line 92, Pos (2,0)
msgid ""
"王によって施された不死と転生の秘術により、\n"
"死ぬことすらできず――"
msgstr "由于王施下的不死与转生秘术，连死都做不到——"

#. ID 13, Page 1, Line 94, Pos (2,0)
msgid ""
"そのうちに――\\N[\\V[6]]の心は\n"
"壊れて砕けて溶けて消えた……"
msgstr ""
"在此期间——\\N[\\V[6]]的心坏掉、碎裂、融化、\n"
"消失了……"

#. ID 13, Page 1, Line 105, Pos (2,0)
msgid "The End...?"
msgstr "The End...?"

#. ID 15, Page 2, Line 13, Pos (10,16)
msgid "鉄扉は固く施錠されている！！"
msgstr "铁门被牢牢锁上了！！"

#. ID 23, Page 2, Line 3, Pos (18,6)
msgid ""
"用を足す為の桶だ……\n"
"こんなものを使わなければならないなんて……\n"
"屈辱だ……"
msgstr ""
"这是用来解手的桶……竟然不得不用这种东西……\n"
"真是屈辱……"
