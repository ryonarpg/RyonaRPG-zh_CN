#. ID 2, Page 4, Line 16, Pos (0,1)
msgid ""
"？？？\n"
"「んぎゃ！！」"
msgstr "？？？「呜哇！！」"

#. ID 3, Page 1, Line 6, Pos (1,0)
msgid ""
"？？？\n"
"「侵入者か！\n"
"　ここを通すわけにはいかん！！」"
msgstr "？？？「是入侵者吗！　可不能让你通过这里！！」"

#. ID 3, Page 1, Line 9, Pos (1,0)
msgid ""
"？？？\n"
"「この最強魔法で\n"
"　一撃で仕留めてやる！！」"
msgstr "？？？「用这最强魔法　一击解决你！！」"

#. ID 3, Page 2, Line 4, Pos (1,0)
msgid ""
"\\>？？？\n"
"\\>「覚悟するがいい！！」\\<\\|\\^"
msgstr "\\>？？？\\>「做好觉悟吧！！」\\<\\|\\^"

#. ID 3, Page 2, Line 19, Pos (1,0)
msgid ""
"\\>？？？\n"
"\\>「これが！！」\\<\\.\\.\\^"
msgstr "\\>？？？\\>「这就是！！」\\<\\.\\.\\^"

#. ID 3, Page 2, Line 34, Pos (1,0)
msgid ""
"\\>？？？\n"
"\\>「最強の！！」\\<\\.\\.\\^"
msgstr "\\>？？？\\>「最强的！！」\\<\\.\\.\\^"

#. ID 3, Page 2, Line 49, Pos (1,0)
msgid ""
"\\>？？？\n"
"\\>「魔法！！」\\<\\.\\.\\^"
msgstr "\\>？？？\\>「魔法！！」\\<\\.\\.\\^"

#. ID 3, Page 3, Line 14, Pos (1,0)
msgid ""
"\n"
"\\N[\\V[6]]は塵も残さず消滅した。"
msgstr "\\N[\\V[6]]连一点尘埃都没留下，消灭了。"

#. ID 4, Page 1, Line 12, Pos (2,0)
msgid ""
"\\>？？？\n"
"\\>「うおっ！　まぶし！」\\<\\.\\.\\^"
msgstr "\\>？？？\\>「哇哦！　好刺眼！」\\<\\.\\.\\^"

#. ID 12, Page 2, Line 4, Pos (9,26)
msgid ""
"\n"
"（今戻っても意味が無いよね。）"
msgstr "（现在回去也没有意义吧。）"

#. ID 13, Page 2, Line 12, Pos (1,1)
msgid ""
"\n"
"！！！！！\\|\\^"
msgstr ""
"\n"
"！！！！！\\|\\^"

#. ID 13, Page 2, Line 19, Pos (1,1)
msgid ""
"\n"
"\\N[\\V[6]]の中に、何かが入ってくる。\\|\\^"
msgstr "有什么东西进入\\N[\\V[6]]之中。\\|\\^"

#. ID 13, Page 2, Line 34, Pos (1,1)
msgid ""
"？？？\n"
"「元気出たかい？」"
msgstr "？？？「打起精神了吗？」"

#. ID 13, Page 3, Line 5, Pos (1,1)
msgid ""
"？？？\n"
"「痛いじゃないか！！　なにをする！！」"
msgstr "？？？「很痛啊！！　你干什么！！」"

#. ID 13, Page 3, Line 11, Pos (1,1)
msgid ""
"\n"
"「あんたがいきなり仕掛けてきたんでしょ！！」"
msgstr "「是你突然先动手的吧！！」"

#. ID 13, Page 3, Line 17, Pos (1,1)
msgid ""
"？？？\n"
"「侵入者に攻撃するのは当然じゃないか！！」"
msgstr "？？？「攻击入侵者不是理所当然的吗！！」"

#. ID 13, Page 3, Line 19, Pos (1,1)
msgid ""
"？？？\n"
"「大体、魔法の途中で殴るんじゃない！！\n"
"　不発に終わってしまったじゃないか！！」"
msgstr ""
"？？？「说起来，别在魔法途中打人啊！！\n"
"　结果不是没发动吗！！」"

#. ID 13, Page 3, Line 26, Pos (1,1)
msgid ""
"\n"
"「何もしないで、攻撃を受けろって？」"
msgstr "「你是说让我什么都不做，就挨攻击？」"

#. ID 13, Page 3, Line 31, Pos (1,1)
msgid ""
"？？？\n"
"「うむ、それが礼儀というもので……」"
msgstr "？？？「嗯，那才是所谓的礼仪……」"

#. ID 13, Page 3, Line 35, Pos (1,1)
msgid ""
"\n"
"「もう一発、殴っていい？」"
msgstr "「我可以再打一拳吗？」"

#. ID 13, Page 3, Line 41, Pos (1,1)
msgid ""
"？？？\n"
"「すみませんでした。」"
msgstr "？？？「对不起。」"

#. ID 13, Page 3, Line 43, Pos (1,1)
msgid ""
"\n"
"「よろしい。\n"
"　で、あんた。　出口とか知らない？」"
msgstr "「很好。　那么，你。　不知道出口之类的吗？」"

#. ID 13, Page 3, Line 46, Pos (1,1)
msgid ""
"？？？\n"
"「知らん。」"
msgstr "？？？「不知道。」"

#. ID 13, Page 3, Line 54, Pos (1,1)
msgid ""
"？？？\n"
"「いや、待てまてマテ。\n"
"　無いんだって、出口なんてものは。」"
msgstr ""
"？？？「不，等等等等。　都说了没有，\n"
"出口那种东西。」"

#. ID 13, Page 3, Line 57, Pos (1,1)
msgid ""
"\n"
"「言っとくけど、\n"
"　嘘ついたらどうなるか……分かってるよね？」"
msgstr "「先说好，　要是撒谎会怎样……你明白的吧？」"

#. ID 13, Page 3, Line 60, Pos (1,1)
msgid ""
"？？？\n"
"「いや、脅されても無いもんは無いし、\n"
"　殴られるのもうコリゴリだし、\n"
"　嘘なんてつかないよ。」"
msgstr ""
"？？？「不，就算你威胁我，没有的东西就是没有，\n"
"　而且挨打我也受够了，　我才不会撒谎呢。」"

#. ID 13, Page 3, Line 68, Pos (1,1)
msgid ""
"\n"
"「ホントに無いの？」"
msgstr "「真的没有吗？」"

#. ID 13, Page 3, Line 70, Pos (1,1)
msgid ""
"？？？\n"
"「うん、無い。\n"
"　だから諦めて上に戻るといいよ。」"
msgstr ""
"？？？「嗯，没有。　所以死心吧，\n"
"回到上面去就好。」"

#. ID 13, Page 3, Line 77, Pos (1,1)
msgid ""
"\n"
"「……なんか引っかかる言い方だなぁ。」"
msgstr "「……总觉得这说法有点让人在意啊。」"

#. ID 13, Page 3, Line 83, Pos (1,1)
msgid ""
"？？？\n"
"「そ、そんなことないよー」"
msgstr "？？？「哪、哪有那种事啦——」"

#. ID 13, Page 3, Line 89, Pos (1,1)
msgid ""
"\n"
"（上に戻って欲しいということは……）"
msgstr "（想让我回到上面，也就是说……）"

#. ID 13, Page 4, Line 7, Pos (1,1)
msgid ""
"？？？\n"
"「君が死んだらどんな色の魂になるかなー？」"
msgstr "？？？「你死后会变成什么颜色的灵魂呢——？」"

#. ID 13, Page 4, Line 11, Pos (1,1)
msgid ""
"？？？\n"
"「この先は行き止まりだから、\n"
"　行っても無駄だよー」"
msgstr "？？？「前面是死路，　所以去了也没用哦——」"

#. ID 13, Page 4, Line 23, Pos (1,1)
msgid ""
"\n"
"「あのさ、あの奥の事なんだけど……」"
msgstr "「我说，关于那里面的事……」"

#. ID 13, Page 4, Line 25, Pos (1,1)
msgid ""
"？？？\n"
"「行き止まりだって言っただろー」"
msgstr "？？？「我都说是死路了吧——」"

#. ID 13, Page 4, Line 31, Pos (1,1)
msgid ""
"\n"
"「教えて♪」"
msgstr "「告诉我♪」"

#. ID 13, Page 4, Line 37, Pos (1,1)
msgid ""
"？？？\n"
"「いや、だから行き止……」"
msgstr "？？？「不，所以说是死……」"

#. ID 13, Page 4, Line 40, Pos (1,1)
msgid ""
"\n"
"「え？　息止まりたい？」"
msgstr "「诶？　你想断气？」"

#. ID 13, Page 4, Line 43, Pos (1,1)
msgid ""
"？？？\n"
"「すみませんでしたーーー」"
msgstr "？？？「对不起——」"

#. ID 13, Page 4, Line 45, Pos (1,1)
msgid ""
"\n"
"「よろしい。\n"
"　で、どうやって進むの？」"
msgstr "「很好。　那么，要怎么前进？」"

#. ID 13, Page 4, Line 48, Pos (1,1)
msgid ""
"？？？\n"
"「壁の中にいる人魂を刺激してやれば、\n"
"　道が出来る仕組みになっているのさ。」"
msgstr ""
"？？？「只要刺激待在墙里的灵魂之火，\n"
"　就会形成道路，是这么设计的。」"

#. ID 13, Page 4, Line 55, Pos (1,1)
msgid ""
"\n"
"「壁の中……？\n"
"　そんなのどうやって……？」"
msgstr "「墙里……？　那种事要怎么做……？」"

#. ID 13, Page 4, Line 59, Pos (1,1)
msgid ""
"？？？\n"
"「ふっ、君は持っているはずさ。\n"
"　色々試してみるといい。」"
msgstr ""
"？？？「呵，你应该有才对。\n"
"　各种方法都试试看吧。」"

#. ID 13, Page 4, Line 64, Pos (1,1)
msgid ""
"？？？\n"
"「こういう時、\n"
"　まだ探していない場所を見てみるのが、\n"
"　お約束ってやつさ。」"
msgstr ""
"？？？「这种时候，　去看看还没找过的地方，\n"
"　才是惯例嘛。」"

#. ID 13, Page 5, Line 7, Pos (1,1)
#. ID 13, Page 6, Line 6, Pos (1,1)
msgid ""
"？？？\n"
"「何か疲れてるみたいだね。」"
msgstr "？？？「你好像有点累呢。」"

#. ID 13, Page 5, Line 13, Pos (1,1)
#. ID 13, Page 6, Line 12, Pos (1,1)
msgid ""
"？？？\n"
"「それにしても君は元気だねー」"
msgstr "？？？「话说回来，你可真有精神啊——」"

#. ID 13, Page 5, Line 20, Pos (1,1)
msgid ""
"？？？\n"
"「それにしても君みたいな乱……\n"
"\\>　いや、何でもないよ！！」"
msgstr ""
"？？？「话说回来，像你这样的乱……\\>　不，\n"
"没什么啦！！」"

#. ID 13, Page 5, Line 25, Pos (1,1)
msgid ""
"？？？\n"
"「先に進んでも何も無いよー？」"
msgstr "？？？「就算继续往前走也什么都没有哦——？」"

#. ID 13, Page 5, Line 39, Pos (1,1)
msgid ""
"\n"
"「♪」"
msgstr ""
"\n"
"「♪」"

#. ID 13, Page 5, Line 45, Pos (1,1)
msgid ""
"？？？\n"
"「あー、うん、来ると思ってたよ。」"
msgstr "？？？「啊——，嗯，我就知道你会来。」"

#. ID 13, Page 5, Line 47, Pos (1,1)
msgid ""
"\n"
"「で？　あれは何なの？」"
msgstr "「所以？　那是什么？」"

#. ID 13, Page 5, Line 49, Pos (1,1)
msgid ""
"？？？\n"
"「あれは封印を兼ねた防衛システムさ。\n"
"　侵入者を排除するためのね。」"
msgstr ""
"？？？「那是兼作封印的防卫系统。\n"
"　是用来排除入侵者的。」"

#. ID 13, Page 5, Line 56, Pos (1,1)
msgid ""
"\n"
"「封印？」"
msgstr "「封印？」"

#. ID 13, Page 5, Line 59, Pos (1,1)
msgid ""
"？？？\n"
"「あの下には凶悪な魔王が封じ込められているんだ。\n"
"　暴虐の限りを尽くした、とても恐ろしい魔王がね。」"
msgstr ""
"？？？「那下面封印着凶恶的魔王。\n"
"　一个极尽暴虐、非常可怕的魔王。」"

#. ID 13, Page 5, Line 62, Pos (1,1)
#. Contains choice at line 3 (2 options)
#. ID 13, Page 5, Line 82, Pos (1,1)
#. Contains choice at line 3 (2 options)
msgid ""
"\n"
"「ふぅん……"
msgstr "「哦……"

#. ID 13, Page 5, Line 64, Pos (1,1)
#. Choice (2 options, embedded in a message)
msgid ""
"どうやったら封印を解けるの？」\n"
"魔王ってどんなヤツ？」"
msgstr ""
"要怎么做才能解开封印？」\n"
"魔王是什么样的家伙？」"

#. ID 13, Page 5, Line 67, Pos (1,1)
msgid ""
"？？？\n"
"「言えるわけないだろー！！\n"
"　あいつが復活したら、どうなることか……」"
msgstr ""
"？？？「我怎么可能说啊——！！\n"
"　要是那家伙复活了，会变成什么样……」"

#. ID 13, Page 5, Line 72, Pos (1,1)
msgid ""
"？？？\n"
"「言葉でなんか言い表せないよ！！\n"
"　あいつの悪行の数々にはね！！」"
msgstr ""
"？？？「用语言根本表达不出来啊！！\n"
"　那家伙的种种恶行啊！！」"

#. ID 13, Page 5, Line 84, Pos (1,1)
#. Choice (2 options, embedded in a message)
msgid ""
"じゃあやっちゃいけない事は？」\n"
"じゃあ仕組みだけでも教えて。」"
msgstr ""
"那么不能做的事是？」\n"
"那么至少告诉我机制吧。」"

#. ID 13, Page 5, Line 86, Pos (1,1)
msgid ""
"？？？\n"
"「そうだなぁ……\n"
"　全部まとめて一気に倒しちゃったり、\n"
"　システムの限界まで倒し続けたりとかかなぁ？」"
msgstr ""
"？？？「这个嘛……\n"
"　比如把它们全部一起一口气打倒，\n"
"　或者一直打到系统的极限之类的吧？」"

#. ID 13, Page 5, Line 92, Pos (1,1)
msgid ""
"？？？\n"
"「ふふっ、興味あるのかい？\n"
"　あの防衛システムはだね、\n"
"　１匹でも残っていれば修復できるのさ。"
msgstr ""
"？？？「呵呵，你有兴趣吗？　那个防卫系统啊，\n"
"　只要还剩1只就能修复哦。"

#. ID 13, Page 5, Line 96, Pos (1,1)
msgid ""
"\n"
"　まぁ修復できる数に限界があるのが難点だけど。\n"
"　それでも少し休息させれば回復するんだよ。」"
msgstr ""
"　不过嘛，能修复的数量有限这一点算是难点。\n"
"　但就算这样，\n"
"　只要让它们稍微休息一下就会恢复哦。」"

#. ID 13, Page 5, Line 102, Pos (1,1)
msgid ""
"\n"
"「そっか、ありがと。」"
msgstr "「这样啊，谢谢。」"

#. ID 13, Page 5, Line 105, Pos (1,1)
msgid ""
"？？？\n"
"「どういたしまして♪」"
msgstr "？？？「不客气♪」"

#. ID 13, Page 6, Line 18, Pos (1,1)
msgid ""
"？？？\n"
"「あれ……？\n"
"　何か言っちゃいけなかった気がするような……」"
msgstr ""
"？？？「咦……？　总觉得好像说了什么不该说的话……\n"
"」"
