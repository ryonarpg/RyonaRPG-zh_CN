msgctxt "actors.name"
msgid "スペード"
msgstr "黑桃"

#. ID 7, Page 1, Line 54, Pos (8,11)
msgid "\\N[101] の \\V[246] ﾆﾀﾞ。"
msgstr "\\N[101] 的 \\V[246] 尼塔。"

#. ID 7, Page 1, Line 90, Pos (8,11)
msgid "もうカードが残ってないﾆﾀﾞ。"
msgstr "已经没有剩下的牌了尼塔。"

#. ID 7, Page 1, Line 93, Pos (8,11)
#. ID 7, Page 1, Line 196, Pos (8,11)
#. ID 7, Page 1, Line 199, Pos (8,11)
#. ID 7, Page 1, Line 201, Pos (8,11)
#. ID 7, Page 1, Line 203, Pos (8,11)
#. ID 7, Page 1, Line 219, Pos (8,11)
#. ID 7, Page 1, Line 221, Pos (8,11)
