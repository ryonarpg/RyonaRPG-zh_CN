#. ID 7, Page 5, Line 84, Pos (8,11)
msgid "・・・・・。"
msgstr "・・・・・。"

#. ID 7, Page 1, Line 94, Pos (8,11)
msgid "あれ？"
msgstr "咦？"

#. ID 7, Page 1, Line 96, Pos (8,11)
msgid ""
"おかしいﾆﾀﾞ！\n"
"まだ全部のカードを出してないﾆﾀﾞ！\n"
"まだ\\v[242]枚しか出てないﾆﾀﾞ！"
msgstr ""
"奇怪尼塔！还没有把全部的牌都发出来尼塔！\n"
"现在才出了\\v[242]张尼塔！"

#. ID 7, Page 1, Line 99, Pos (8,11)
msgid "これはイカサマﾆﾀﾞ！"
msgstr "这是出千尼塔！"

#. ID 7, Page 1, Line 114, Pos (8,11)
#. Contains choice at line 3 (2 options)
msgid ""
"現在の掛け金 \\v[241]G　\\v[242] 回目\n"
"ハイ & ロー？"
msgstr "当前的赌注 \\v[241]G　第 \\v[242] 次猜高低？"

#. ID 7, Page 1, Line 116, Pos (8,11)
#. Choice (2 options, embedded in a message)
msgid ""
"ハイ\n"
"ロー"
msgstr ""
"高\n"
"低"

#. ID 7, Page 1, Line 125, Pos (8,11)
#. Contains choice at line 2 (2 options)
msgid "やめちゃうﾆｶ？"
msgstr "要退出吗？"

#. ID 7, Page 1, Line 126, Pos (8,11)
#. Choice (2 options, embedded in a message)
