#. ID 32, Page 3, Line 3, Pos (15,14)
#. ID 78, Page 3, Line 3, Pos (14,15)
#. ID 90, Page 3, Line 3, Pos (16,15)
msgid ""
"くっ……\n"
"宝に目が眩んだばかりに、\n"
"こんな事になるだなんて……"
msgstr "唔……只因为被财宝迷了眼，竟然会变成这样……"

#. ID 95, Page 2, Line 9, Pos (15,21)
msgid "こ、これは……！！"
msgstr "这、这是……！！"

#. ID 96, Page 1, Line 4, Pos (1,2)
msgid ""
"とてつもない量の……\n"
"それこそ『宝の山』という形容そのままの光景が\n"
"\\N[\\V[6]]の目の前にある。"
msgstr ""
"难以估量的数量……简直正如‘宝山’这一形容的光景，\n"
"就在\\N[\\V[6]]的眼前。"

#. ID 96, Page 1, Line 7, Pos (1,2)
msgid ""
"この量なら、領地が爵位付きで買える……\n"
"いや、それどころか、\n"
"小国なら余裕でまるごと買えてしまうだろう。"
msgstr ""
"这个量的话，连带着爵位买下领地都买得起……不，\n"
"岂止如此，若是小国，轻轻松松就能整个买下来吧。"

#. ID 96, Page 1, Line 16, Pos (1,2)
msgid ""
"だが、同時にこの宝からは、なんだか嫌な雰囲気……\n"
"得体の知れない、言いようのない妙な予感？\n"
"のようなものも感じる……・"
msgstr ""
"但是，同时从这些财宝上，\n"
"也感受到某种讨厌的气息……一种来历不明、\n"
"难以言喻的怪异预感？似的东西……・"

#. ID 96, Page 1, Line 19, Pos (1,2)
msgid ""
"………。\n"
"……どうしよう？"
msgstr "………。……怎么办？"

#. ID 98, Page 1, Line 6, Pos (2,2)
msgid "もうひとつくらい……いいかな？"
msgstr "再拿一个……可以吗？"

#. ID 98, Page 1, Line 9, Pos (2,2)
msgid ""
"……どうしよう？\n"
"ちょっとくらいなら、いいかな？"
msgstr "……怎么办？只拿一点点的话，可以吧？"

#. ID 98, Page 1, Line 13, Pos (2,2)
#. Contains choice at line 2 (2 options)
msgid "\\N[\\V[6]]はこの宝を――"
msgstr "\\N[\\V[6]]要把这些财宝――"

#. ID 98, Page 1, Line 14, Pos (2,2)
#. Choice (2 options, embedded in a message)
msgid ""
"持っていく\n"
"持っていかない"
msgstr ""
"带走\n"
"不带走"

#. ID 98, Page 1, Line 17, Pos (2,2)
msgid ""
"……うん、\n"
"これだけあるんだし、もうひとつくらいいいだろう。"
msgstr "……嗯，有这么多，再拿一个也没关系吧。"

#. ID 98, Page 1, Line 21, Pos (2,2)
msgid "……うん、ひとつくらいならいいだろう。"
msgstr "……嗯，一个的话没关系吧。"

#. ID 98, Page 1, Line 75, Pos (2,2)
msgid "もうひとつだけ……いやでも……"
msgstr "再就一个……不，可是……"

#. ID 98, Page 1, Line 82, Pos (2,2)
msgid ""
"………。\n"
"ここまできたら……1個も10個も同じだ！"
msgstr "………。都到这一步了……一个和十个都一样！"

#. ID 98, Page 1, Line 91, Pos (2,2)
msgid ""
"\\N[\\V[6]]は、なかば飛び込むようにして\n"
"宝の山に駆け入ると、山と積まれた宝を\n"
"手当たり次第に道具袋に詰め込んでいく！"
msgstr ""
"\\N[\\V[6]]几乎像扑进去一样冲入宝山，\n"
"把堆积如山的财宝随手塞进道具袋！"

#. ID 98, Page 1, Line 117, Pos (2,2)
msgid ""
"金銀宝石、武具に羅紗、\n"
"珊瑚に真珠、絹布(けんぷ)に反物、\n"
"磁器、陶器、漆器、香木に彫刻！"
msgstr ""
"金银宝石、武器防具与罗纱、珊瑚与珍珠、\n"
"绢布与布匹、瓷器、陶器、漆器、香木与雕刻！"

#. ID 98, Page 1, Line 120, Pos (2,2)
msgid ""
"全部……\n"
"ここにある宝は、全部全部、私のものだ！！"
msgstr "全部……这里的财宝，全部全部，都是我的！！"

#. ID 98, Page 1, Line 128, Pos (2,2)
msgid ""
"\\N[\\V[6]]は\n"
"金貨の山を両手ですくい上げ、\n"
"そのまま頭上に放り投げる。"
msgstr "\\N[\\V[6]]双手捧起金币堆，就那样朝头顶抛去。"

#. ID 98, Page 1, Line 138, Pos (2,2)
msgid ""
"降り注ぐコインのシャワーを髪や肩で受け止め、\n"
"\\N[\\V[6]]は恍惚とともに高らかに笑う。"
msgstr ""
"用头发和肩膀承接倾泻而下的金币之雨，\n"
"\\N[\\V[6]]陶醉地高声大笑。"

#. ID 98, Page 1, Line 140, Pos (2,2)
msgid ""
"普段の\\N[\\V[6]]なら\n"
"決してしないような笑いかたで――"
msgstr "以平时的\\N[\\V[6]]绝不会有的笑法――"

#. ID 98, Page 1, Line 142, Pos (2,2)
msgid ""
"――私は今、数多(あまた)の人間が夢見て、\n"
"そしてついぞ果たせずして死んでいった光景を\n"
"現実のものにしたのだ！"
msgstr ""
"――我现在，把众多人类梦见过、\n"
"却终究未能实现便死去的景象变成了现实！"

#. ID 98, Page 1, Line 145, Pos (2,2)
msgid ""
"ふふふ……\n"
"はっはっはっはっは！！"
msgstr "呵呵呵……哈啊哈哈哈哈！！"

#. ID 98, Page 1, Line 157, Pos (2,2)
msgid ""
"不意に、\n"
"満悦に浸っていた\\N[\\V[6]]を、\n"
"抗い難い眠気が襲った。"
msgstr ""
"突然，\n"
"无法抗拒的睡意袭向沉浸在满足中的\\N[\\V[6]]。"

#. ID 98, Page 1, Line 160, Pos (2,2)
msgid ""
"ありったけの物欲を見たし、\n"
"いい気分に浸っていた\\N[\\V[6]]は、\n"
"そのまま睡魔に身を任せてしまった……"
msgstr ""
"已尽情满足物欲、心情正好的\\N[\\V[6]]，\n"
"就那样任由睡魔摆布……"

#. ID 98, Page 1, Line 172, Pos (2,2)
msgid ""
"\\N[\\V[6]]\n"
"「ZZZ………」"
msgstr ""
"\\N[\\V[6]]\n"
"「ZZZ………」"

#. ID 98, Page 1, Line 178, Pos (2,2)
msgid ""
"宝の山に抱かれたまま、\n"
"\\N[\\V[6]]は\n"
"無防備に眠りこける……"
msgstr "被宝山环抱着，\\N[\\V[6]]毫无防备地熟睡过去……"

#. ID 98, Page 1, Line 192, Pos (2,2)
msgid ""
"やがて……\n"
"眠り続ける\\N[\\V[6]]の身体に、\n"
"異変が起こった。"
msgstr "不久……持续沉睡的\\N[\\V[6]]的身体发生了异变。"

#. ID 98, Page 1, Line 208, Pos (2,2)
msgid ""
"皮膚が硬質化し……\n"
"歯や爪が鋭く伸びていき……"
msgstr "皮肤硬化……牙齿和爪子变得尖锐并伸长……"

#. ID 98, Page 1, Line 211, Pos (2,2)
msgid ""
"額や背中、尻から\n"
"今まで存在しなかった器官が飛び出す……"
msgstr "从额头、背部、臀部，长出了至今不存在的器官……"

#. ID 98, Page 1, Line 215, Pos (2,2)
msgid ""
"額や背中、尻から\n"
"今まで存在しなかった器官が服を破って飛び出す……"
msgstr ""
"从额头、背部、臀部，\n"
"至今不存在的器官冲破衣服长了出来……"

#. ID 98, Page 1, Line 232, Pos (2,2)
msgid "眠る\\N[\\V[6]]の変化は止まらない。"
msgstr "沉睡中的\\N[\\V[6]]的变化没有停止。"

#. ID 98, Page 1, Line 233, Pos (2,2)
msgid ""
"体積は膨張し、筋肉やそれを支える骨格は\n"
"強靭なものに置き換わっていく。"
msgstr ""
"体积膨胀，\n"
"肌肉以及支撑它的骨骼逐渐被替换成强韧之物。"

#. ID 98, Page 1, Line 235, Pos (2,2)
msgid ""
"額から飛び出た異形の部位は『角』となり……\n"
"背から飛び出た異形の部位は『翼』となり……\n"
"尻から飛び出た異形の部位は『尾』となる……"
msgstr ""
"从额头突出的异形部位变成了「角」……\n"
"从背部突出的异形部位变成了「翼」……\n"
"从臀部突出的异形部位变成了「尾」……"

#. ID 98, Page 1, Line 258, Pos (2,2)
msgid ""
"そうして――\n"
"\\N[\\V[6]]の変身は完了した……"
msgstr "就这样――\\N[\\V[6]]的变身完成了……"

#. ID 98, Page 1, Line 267, Pos (2,2)
msgid ""
"欲深い竜の執念が\n"
"呪いとなって染みついていた宝に抱かれて眠った\n"
"\\N[\\V[6]]は、同じ竜の姿になってしまった！！"
msgstr ""
"被贪婪之龙的执念化为诅咒、\n"
"深深浸染的财宝拥抱着入睡的\\N[\\V[6]]，\n"
"竟然变成了同样的龙之姿！！"

#. ID 98, Page 1, Line 277, Pos (2,2)
msgid ""
"ことここに至り\n"
"ようやく目を覚ました\\N[\\V[6]]は\n"
"激しく狼狽するものの、時すでに遅し。"
msgstr ""
"事已至此才终于醒来的\\N[\\V[6]]虽然极为惊慌，\n"
"但为时已晚。"

#. ID 98, Page 1, Line 280, Pos (2,2)
msgid ""
"変わり果てた自分の姿を検め\n"
"悲鳴を上げようとするが、その喉から出るのは\n"
"最早人間の悲鳴ではなく、竜の吠声でしかない。"
msgstr ""
"检视自己面目全非的模样，想要发出惨叫，\n"
"但从那喉咙里发出的已不再是人类的惨叫，\n"
"而只能是龙的吼声。"

#. ID 98, Page 1, Line 287, Pos (2,2)
msgid "ど、どうしよう、どうすれば……！？"
msgstr "怎、怎么办，该怎么办……！？"

#. ID 98, Page 1, Line 297, Pos (2,2)
msgid ""
"とにかく、いったんここを出て、\n"
"呪いを解く方法を探さなければ！！"
msgstr "总之，先离开这里，必须去找解除诅咒的方法！！"

#. ID 98, Page 1, Line 310, Pos (2,2)
msgid ""
"……やはりなんとなく嫌な予感がする。\n"
"宝は惜しいが、\n"
"これはこのままここに置いていこう……"
msgstr ""
"……果然还是总觉得有种不祥的预感。财宝虽可惜，\n"
"但这个还是就这样留在这里吧……"

#. ID 100, Page 2, Line 6, Pos (15,19)
msgid "(宝を守らなければ！！)"
msgstr "（必须保护财宝！！）"

#. ID 100, Page 2, Line 22, Pos (15,19)
msgid ""
"……何を考えているんだ私は？\n"
"さすがに今は\n"
"そんなことを気にしている場合じゃない！！"
msgstr "……我在想什么啊？现在可不是在意那种事的时候！！"

#. ID 100, Page 3, Line 6, Pos (15,19)
msgid "(しかし宝を守らなければ！！)"
msgstr "（但是必须保护财宝！！）"

#. ID 100, Page 3, Line 22, Pos (15,19)
msgid "……だから、そんな場合では！！"
msgstr "……所以说，不是那种时候！！"

#. ID 100, Page 4, Line 6, Pos (15,19)
msgid "(宝を置いていけない！！)"
msgstr "（不能把财宝留在这里！！）"

#. ID 100, Page 4, Line 22, Pos (15,19)
msgid ""
"……？\n"
"…………っ！？"
msgstr "……？…………唔！？"

#. ID 100, Page 4, Line 24, Pos (15,19)
msgid ""
"宝から距離を取ると強烈な執着心が励起されてしまい\n"
"この場を離れることができない！！"
msgstr ""
"一旦与财宝拉开距离，强烈的执念就会被激起，\n"
"无法离开这个地方！！"

#. ID 100, Page 4, Line 26, Pos (15,19)
msgid ""
"そんな……これも呪いの一環なのか？\n"
"とにかくなんとしてでもここから離れなければ！！"
msgstr ""
"怎么会……这也是诅咒的一部分吗？\n"
"总之无论如何都必须离开这里！！"

#. ID 100, Page 5, Line 20, Pos (15,19)
msgid "いつの間にか出現した黒い竜がこちらを見ている。"
msgstr "不知何时出现的黑龙正看着这边。"

#. ID 100, Page 5, Line 21, Pos (15,19)
msgid ""
"巨(おお)きい……遠目でざっと見積もっても、\n"
"今の\\N[\\V[6]]のふたまわり以上はあるだろう。\n"
"体重は倍あるかもしれない……"
msgstr ""
"好大……远远粗略估计，\n"
"也比现在的\\N[\\V[6]]还要大两圈以上吧。\n"
"体重可能有两倍……"

#. ID 100, Page 5, Line 24, Pos (15,19)
msgid ""
"そして……これも雌としての直感なのだろうか、\n"
"\\N[\\V[6]]は理解してしまった。"
msgstr ""
"而且……这大概也是作为雌性的直觉吧，\n"
"\\N[\\V[6]]已经明白了。"

#. ID 100, Page 5, Line 26, Pos (15,19)
msgid ""
"――あの竜は雄だ。\n"
"しかも、自分に欲情している……"
msgstr "――那条龙是雄性。而且，正对自己发情……"

#. ID 100, Page 5, Line 28, Pos (15,19)
msgid ""
"こちらにその気はない――だとか、\n"
"自分は竜じゃなく、人間だ――だとか、\n"
"そんな意思表明に意味がないことは明白だ。"
msgstr ""
"自己并无那种意愿――之类的，\n"
"自己不是龙而是人类――之类的，\n"
"这种意思表示毫无意义，这一点很清楚。"

#. ID 100, Page 5, Line 31, Pos (15,19)
msgid ""
"\\N[\\V[6]]は吠えたり、唸ったりして\n"
"精一杯相手を威嚇しようと試みる――が。"
msgstr "\\N[\\V[6]]吠叫、低吼，拼命试图威吓对方――然而。"

#. ID 100, Page 5, Line 42, Pos (15,19)
msgid ""
"体格差に加え、慣れない竜の身は思うように動かず、\n"
"\\N[\\V[6]]は\n"
"雄竜に容易く組み敷かれてしまった！"
msgstr ""
"除了体格差距之外，\n"
"不习惯的龙身也无法随心所欲地行动，\n"
"\\N[\\V[6]]轻易地被雄性龙按倒在地！"

#. ID 100, Page 5, Line 54, Pos (15,19)
msgid ""
"そのまま\\N[\\V[6]]は\n"
"なすすべもなく雄竜に犯されてしまう……"
msgstr "就这样，\\N[\\V[6]]毫无办法地被雄性龙侵犯了……"

#. ID 100, Page 5, Line 97, Pos (15,19)
msgid ""
"一通り交尾が済むと、\n"
"\\N[\\V[6]]を襲った黒竜はいずこともなく\n"
"去って行った。"
msgstr ""
"一番交尾结束后，\n"
"袭击\\N[\\V[6]]的黑龙不知去向地离开了。"

#. ID 100, Page 5, Line 100, Pos (15,19)
msgid ""
"この時\n"
"\\N[\\V[6]]の中に放たれた黒竜の精は\n"
"ただしく\\N[\\V[6]]の胎(はら)で実を結び――"
msgstr ""
"这时被射入\\N[\\V[6]]体内的黑龙精液，\n"
"确实在\\N[\\V[6]]的胎中结出了果实――"

#. ID 100, Page 5, Line 103, Pos (15,19)
msgid ""
"\\N[\\V[6]]は、\n"
"竜として竜の仔を孕んだ。"
msgstr "\\N[\\V[6]]作为龙，怀上了龙的幼崽。"

#. ID 100, Page 5, Line 105, Pos (15,19)
msgid ""
"\\N[\\V[6]]は\n"
"宝の間を脱出するすべを見つけることもできないまま、\n"
"時折部屋に迷い込んでくる小動物や亜竜を捕食し、"
msgstr ""
"\\N[\\V[6]]始终未能找到逃出宝物间的办法，\n"
"只能捕食偶尔误入房间的小动物和亚龙，"

#. ID 100, Page 5, Line 108, Pos (15,19)
msgid "胎の中で子が育つまま、時が流れていく。"
msgstr "胎儿在腹中成长，时光流逝。"

#. ID 100, Page 5, Line 113, Pos (15,19)
msgid "そして、やがて――"
msgstr "然后，终于――"

#. ID 100, Page 5, Line 121, Pos (15,19)
msgid ""
"\\N[\\V[6]]は\n"
"己が卵(こ)を産んだ。"
msgstr "\\N[\\V[6]]产下了自己的卵。"

#. ID 100, Page 5, Line 123, Pos (15,19)
msgid ""
"ことここに至り、\\N[\\V[6]]は、\n"
"仔竜の保護者として、また宝物の守護者として、\n"
"残りの生を捧げることを決めるのだった――"
msgstr ""
"事已至此，\\N[\\V[6]]决定作为幼龙的保护者，\n"
"同时也作为宝物的守护者，奉献自己余下的生命――"

#. ID 100, Page 5, Line 130, Pos (15,19)
msgid ""
"\n"
"The End...."
msgstr ""
"\n"
"The End...."
