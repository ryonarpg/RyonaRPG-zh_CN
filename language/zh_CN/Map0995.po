#. ID 32, Page 2, Line 3, Pos (16,32)
msgid "扉は固く閉ざされている……。"
msgstr "门紧闭着……。"

#. ID 35, Page 1, Line 11, Pos (2,3)
#. ID 35, Page 2, Line 11, Pos (2,3)
msgid ""
"うっひょーようじょ！\n"
"ようじょキタコレひょっほーい！！"
msgstr "呜嘻——幼女！幼女来啦，呜嘻嘻——！！"

#. ID 35, Page 1, Line 27, Pos (2,3)
msgid ""
"………\n"
"……女か。\n"
"しかし……年を取り過ぎている……"
msgstr "……………女人吗。但是……年纪太大了……"

#. ID 35, Page 1, Line 30, Pos (2,3)
msgid ""
"………\n"
"……私好みの女に変えてやろう。"
msgstr "……………让我把你变成我喜欢的女人吧。"

#. ID 35, Page 2, Line 27, Pos (2,3)
msgid ""
"………\n"
"……女か。\n"
"ふむ……悪くはないが……"
msgstr "……………女人吗。嗯……倒也不坏，不过……"

#. ID 35, Page 2, Line 30, Pos (2,3)
msgid ""
"………\n"
"……さらに私好みの女に変えてやろう。"
msgstr "……………再把你变成更合我喜好的女人吧。"

#. ID 43, Page 2, Line 3, Pos (15,14)
msgid ""
"どの本も全ページを\n"
"呪文や魔法陣が埋め尽くしている。"
msgstr "每本书的所有页面都被咒文和魔法阵填满了。"

#. ID 45, Page 2, Line 3, Pos (21,14)
#. ID 106, Page 2, Line 3, Pos (19,14)
msgid ""
"絵柄は古いが……\n"
"どうやら幼い少女を題材にしたポルノのようだ。"
msgstr "图样很古老……但看来是以年幼少女为题材的色情书。"

#. ID 46, Page 2, Line 3, Pos (13,14)
msgid ""
"\\N[\\V[6]]では\n"
"価値観が違いすぎて内容を推測すらできない……\n"
"そんな分厚い本が並んでいる。"
msgstr ""
"\\N[\\V[6]]因为价值观相差太大，连内容都无法推测…\n"
"…排列着那样厚重的书。"

#. ID 47, Page 2, Line 3, Pos (14,14)
msgid "魔導書の他、医学書や哲学書もあるようだ。"
msgstr "除了魔导书，似乎还有医学书和哲学书。"

#. ID 57, Page 2, Line 3, Pos (18,14)
msgid ""
"この棚には論文やらレポートやらが\n"
"ファイリングされているようだ。"
msgstr "这个架子上似乎归档着论文和报告。"

#. ID 62, Page 2, Line 3, Pos (13,17)
msgid ""
"裸身の幼女の人形だ……\n"
"恐ろしく精巧に作りこまれている。\n"
"細部まで、それこそ産毛まで再現されているようだ。"
msgstr ""
"是裸体幼女的人偶……制作得惊人的精巧。连细节，\n"
"甚至胎毛都似乎被再现出来。"

#. ID 62, Page 2, Line 6, Pos (13,17)
msgid ""
"何やら製作者の執念めいたものが伝わってきて、\n"
"\\N[\\V[6]]は吐き気を覚えた。"
msgstr ""
"某种仿佛制作者执念的东西传达过来，\n"
"\\N[\\V[6]]感到恶心。"

#. ID 63, Page 2, Line 3, Pos (22,21)
#. ID 64, Page 2, Line 3, Pos (21,21)
#. ID 65, Page 2, Line 3, Pos (23,21)
#. ID 80, Page 2, Line 3, Pos (21,22)
#. ID 81, Page 2, Line 4, Pos (22,22)
#. ID 82, Page 2, Line 3, Pos (23,22)
msgid "何に使う機材だろう……想像もできない。"
msgstr "是用来做什么的器材呢……无法想象。"

#. ID 63, Page 2, Line 4, Pos (22,21)
#. ID 64, Page 2, Line 4, Pos (21,21)
#. ID 65, Page 2, Line 4, Pos (23,21)
#. ID 80, Page 2, Line 4, Pos (21,22)
#. ID 81, Page 2, Line 5, Pos (22,22)
#. ID 82, Page 2, Line 4, Pos (23,22)
msgid ""
"……一つわかるのは、\n"
"おそらく現在の技術レベルを超えているということだ。"
msgstr "……我明白了一点，这恐怕超越了当前的技术水平。"

#. ID 79, Page 5, Line 12, Pos (3,3)
msgid ""
"\\N[\\V[6]]は脳年齢の退行に伴い、\n"
"それまでの日々の記憶を失ってしまった！"
msgstr ""
"随着脑年龄的倒退，\n"
"\\N[\\V[6]]失去了此前的日常记忆！"

#. ID 79, Page 5, Line 61, Pos (3,3)
msgid ""
"赤子の姿になった\\N[\\V[6]]は\n"
"ダンジョンを探索していた冒険者に保護された。"
msgstr ""
"变成婴儿的\\N[\\V[6]]被探索地下城的冒险者保护了\n"
"。"

#. ID 79, Page 5, Line 63, Pos (3,3)
msgid ""
"しかし、所詮行きがけの冒険者に\n"
"\\N[\\V[6]]の本来の年齢がわかるはずもなく、\n"
"彼女はそのままの姿で施設に預けられることになる。"
msgstr ""
"然而，路过的冒险者终究不可能知道\\N[\\V[6]]本来的年龄，\n"
"　于是她以那副模样被寄养在设施中。"

#. ID 79, Page 5, Line 67, Pos (3,3)
msgid ""
"その後――\\N[\\V[6]]が、\n"
"戦士としての技と自らの記憶を取り戻すまで、\n"
"十余年の月日を待つことになるのだった。"
msgstr ""
"在那之后――直到\\N[\\V[6]]恢复作为战士的技艺与自\n"
"身的记忆，需要等待十余年的岁月。"

#. ID 79, Page 5, Line 73, Pos (3,3)
msgid ""
"その後――\\N[\\V[6]]が、\n"
"魔法使いとしての技と自らの記憶を取り戻すまで、\n"
"十余年の月日を待つことになるのだった。"
msgstr ""
"在那之后――直到\\N[\\V[6]]恢复作为魔法师的技艺与\n"
"自身的记忆，需要等待十余年的岁月。"

#. ID 79, Page 5, Line 78, Pos (3,3)
msgid ""
"その後――\\N[\\V[6]]が、\n"
"冒険者としての技と自らの記憶を取り戻すまで、\n"
"十余年の月日を待つことになるのだった。"
msgstr ""
"在那之后――直到\\N[\\V[6]]恢复作为冒险者的技艺与\n"
"自身的记忆，需要等待十余年的岁月。"

#. ID 81, Page 3, Line 10, Pos (22,22)
#. Contains choice at line 2 (2 options)
msgid "……今、何か光ったような気がする。"
msgstr "……现在，感觉有什么闪了一下。"

#. ID 81, Page 3, Line 12, Pos (22,22)
#. Choice (2 options, embedded in a message)
#. ID 102, Page 2, Line 36, Pos (10,14)
#. Choice (2 options)
msgid ""
"調べてみる\n"
"やめる"
msgstr ""
"调查一下\n"
"算了"

#. ID 84, Page 2, Line 13, Pos (23,14)
msgid ""
"宝箱から噴き出した謎の気体の力によって、\n"
"\\N[\\V[6]]はさらに若返り\n"
"赤子の姿になってしまった！！"
msgstr ""
"因为从宝箱里喷出的神秘气体的力量，\n"
"\\N[\\V[6]]变得更加年轻，变成了婴儿的模样！！"

#. ID 84, Page 2, Line 16, Pos (23,14)
#. ID 85, Page 1, Line 44, Pos (0,3)
#. ID 104, Page 2, Line 53, Pos (0,5)
msgid ""
"\\S[5]焦燥と同時に……なんだか……\n"
"急速に脳内がぼんやりしていく……"
msgstr ""
"\\S[5]焦躁的同时……总觉得……脑内设定急速变得模糊…\n"
"…"

#. ID 84, Page 2, Line 18, Pos (23,14)
#. ID 85, Page 1, Line 46, Pos (0,3)
#. ID 104, Page 2, Line 55, Pos (0,5)
msgid ""
"\\S[5]まさか、あたまのなかまで……\n"
"あかんぼうになっているのか……？"
msgstr "\\S[5]难道，连脑袋里面也……变成婴儿了吗……？"

#. ID 84, Page 2, Line 20, Pos (23,14)
#. ID 85, Page 1, Line 48, Pos (0,3)
#. ID 104, Page 2, Line 57, Pos (0,5)
msgid ""
"\\S[5]はやくもとのすがたにもどらないと……\n"
"まずい……かも……。"
msgstr "\\S[5]不快点恢复原来的样子的话……可能……不妙……。"

#. ID 84, Page 2, Line 33, Pos (23,14)
msgid ""
"宝箱から噴き出した謎の気体の力によって、\n"
"\\N[\\V[6]]は若返り\n"
"子供の姿になってしまった！！"
msgstr ""
"由于从宝箱中喷出的神秘气体的力量，\n"
"\\N[\\V[6]]返老还童变成了小孩模样！！"

#. ID 85, Page 1, Line 5, Pos (0,3)
msgid "確かこの辺りがチカッと……"
msgstr "记得这附近有东西「唰」地闪了一下……"

#. ID 85, Page 1, Line 24, Pos (0,3)
msgid ""
"突如作動したマシンによって\n"
"\\N[\\V[6]]は手足を拘束されてしまった！！"
msgstr ""
"由于突然启动的机器，\n"
"\\N[\\V[6]]的手脚被束缚住了！！"

#. ID 85, Page 1, Line 41, Pos (0,3)
msgid ""
"謎の機械の力によって\n"
"\\N[\\V[6]]はさらに若返り\n"
"赤子の姿になってしまった！！"
msgstr ""
"由于神秘机器的力量，\n"
"\\N[\\V[6]]进一步返老还童变成了婴儿模样！！"

#. ID 85, Page 1, Line 67, Pos (0,3)
msgid ""
"謎の機械の力によって\n"
"\\N[\\V[6]]は若返り\n"
"子供の姿になってしまった！！"
msgstr ""
"由于神秘机器的力量，\n"
"\\N[\\V[6]]返老还童变成了小孩模样！！"

#. ID 92, Page 2, Line 4, Pos (16,20)
#. Contains choice at line 3 (2 options)
msgid ""
"日記のようだ。傍らの人骨の者だろうか。\n"
"読んでみますか？"
msgstr ""
"好像是日记。是旁边那具人骨的人写的吗。\n"
"要读读看吗？"

#. ID 92, Page 2, Line 6, Pos (16,20)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 92, Page 2, Line 14, Pos (16,20)
msgid ""
"偉大なる王の壮健と王権の盤石――\n"
"与えられた命題に、\n"
"我らは持てる叡智の全てを賭けた。"
msgstr ""
"伟大之王的康健与王权的稳固——对于赋予的命题，\n"
"我们赌上了所拥有的全部睿智。"

#. ID 92, Page 2, Line 17, Pos (16,20)
msgid ""
"神官団は精神というソフトウェアから、\n"
"対する我ら魔術師団は、肉体というハードウェアから\n"
"永劫を探求したのである。"
msgstr ""
"神官团从精神这一软件层面，\n"
"而我们魔术师团相对地从肉体这一硬件层面，\n"
"探求永恒。"

#. ID 92, Page 2, Line 20, Pos (16,20)
msgid ""
"外部からの技術提供もあり――\n"
"今にして思えば受け入れは間違いではあったのだが――\n"
"ともあれ研究は最終的に実用段階まで達した。"
msgstr ""
"也有来自外部的技术提供——现在想来接受它是错误的\n"
"——总之研究最终达到了实用阶段。"

#. ID 92, Page 2, Line 29, Pos (16,20)
msgid ""
"遺伝子中のテロメアに干渉することで、\n"
"動物を幼体に、植物を種子まで退行させることに\n"
"成功し……"
msgstr ""
"通过干涉基因中的端粒，成功使动物退行到幼体、\n"
"使植物退行到种子……"

#. ID 92, Page 2, Line 32, Pos (16,20)
msgid ""
"また、逆に老化させる実験にも成功した。\n"
"(こちらのほうは犯罪者へのペナルティに\n"
"転用させる計画を大臣から聞かされた)"
msgstr ""
"此外，也成功进行了相反地使其老化的实验。\n"
"（这方面我听大臣说有计划转用于对犯罪者的惩罚）"

#. ID 92, Page 2, Line 35, Pos (16,20)
msgid ""
"さらに、この魔術に再現性と汎用性をも求められた為、\n"
"特定の物品に魔力を封じる技術にも挑戦し、\n"
"そして試作品の創製にも見事成功した。"
msgstr ""
"而且，\n"
"由于这项魔术还被要求具备可再现性和通用性，\n"
"我们也挑战了将魔力封入特定物品的技术，\n"
"并且也出色地成功创制了试制品。"

#. ID 92, Page 2, Line 38, Pos (16,20)
msgid ""
"赤い飴玉には時を戻す効能を、\n"
"青い飴玉には逆に時を進める効能を持たせている。\n"
"(どちらも魔術師団本部に試作品を保管してある)"
msgstr ""
"红色糖果被赋予了倒流时间的功效，\n"
"蓝色糖果则相反被赋予了推进时间的功效。\n"
"（两者试制品都保管在魔术师团本部）"

#. ID 92, Page 2, Line 47, Pos (16,20)
msgid ""
"そうだ、確かに完成していたのだ。\n"
"長年に渡った我らの努力は。"
msgstr "没错，确实完成了。我们长年累月的努力。"

#. ID 92, Page 2, Line 49, Pos (16,20)
msgid ""
"それだけに――\n"
"我らの王国があのような末路を辿ったことは\n"
"無念としか言いようがない。"
msgstr ""
"正因为如此——我们的王国落得那种下场，\n"
"只能说是无比遗憾。"

#. ID 92, Page 2, Line 52, Pos (16,20)
msgid ""
"あと一歩……\n"
"そうだ、あと一歩で……"
msgstr "还差一步……没错，还差一步就……"

#. ID 92, Page 2, Line 60, Pos (16,20)
msgid ""
"○歳くらいに戻ったペドい妃殿下の御姿を\n"
"もう一度見ることができたのにwwwww"
msgstr ""
"明明还能再次见到变回约○岁的萝莉控妃殿下的尊容w\n"
"wwww"

#. ID 92, Page 2, Line 62, Pos (16,20)
msgid ""
"というかぶっちゃけ拙者ら王とかどうでもよくて\n"
"幼女いっぱいぺろぺろしたかっただけでござってwwwwww\n"
"フヒヒwwwwサーセンwwwwwww"
msgstr ""
"或者说坦白讲，在下等人对王什么的根本无所谓，\n"
"只是想舔很多幼女而已wwwwww嘻嘻嘻wwww抱歉wwwwww\n"
"w"

#. ID 92, Page 2, Line 69, Pos (16,20)
msgid ""
"\\N[\\V[6]]\n"
"「………」"
msgstr ""
"\\N[\\V[6]]\n"
"「………」"

#. ID 92, Page 2, Line 77, Pos (16,20)
msgid ""
"日記のようだが\n"
"\\N[\\V[6]]には解読できなかった。"
msgstr "好像是日记，但\\N[\\V[6]]无法解读。"

#. ID 102, Page 2, Line 4, Pos (10,14)
#. ID 102, Page 2, Line 14, Pos (10,14)
msgid ""
"姿見が置いてあるが、\n"
"横からだとよく見えない。\n"
"調べるのなら正面に回ろう。"
msgstr ""
"放置着一面穿衣镜，但从侧面看不清。\n"
"要调查的话就绕到正面吧。"

#. ID 102, Page 2, Line 23, Pos (10,14)
msgid ""
"姿見が置いてある……\n"
"良く見ると、縁取りには\n"
"複雑な意匠が刻まれているようだ……"
msgstr ""
"放置着一面穿衣镜……仔细看，\n"
"边框上似乎刻着复杂的图案……"

#. ID 102, Page 2, Line 33, Pos (10,14)
msgid "……今、鏡に何か違和感を感じた。"
msgstr "……刚才，感觉镜子里有什么不对劲。"

#. ID 104, Page 1, Line 6, Pos (0,5)
msgid ""
"……気のせいだったようだ。\n"
"何ということはない、見慣れた自分の姿が\n"
"映っているだけ――……え？"
msgstr ""
"……好像只是错觉。没什么特别的，\n"
"只是映着看惯了的自己的身影——……诶？"

#. ID 104, Page 1, Line 13, Pos (0,5)
msgid ""
"一瞬、鏡の表面が\n"
"水面のようにゆらめくと、\n"
"そこに映った馴染みの自分の姿は消えて――"
msgstr ""
"一瞬间，镜面像水面一样晃动起来，\n"
"映在其中的熟悉的自己的身影消失了——"

#. ID 104, Page 1, Line 17, Pos (0,5)
msgid ""
"代わりに現れたのは、どこか顔に見覚えのある、\n"
"肉付きの薄い未成熟な裸体を晒した\n"
"小さな女児――"
msgstr ""
"取而代之出现的是，面容似乎在哪儿见过、\n"
"露出瘦削未成熟裸体的小女孩——"

#. ID 104, Page 1, Line 23, Pos (0,5)
msgid ""
"代わりに現れたのは、どこか顔に見覚えのある、\n"
"明らかにサイズの合っていない\n"
"だぼだぼの服を着た小さな女児――"
msgstr ""
"取而代之出现的是，面容似乎在哪儿见过、\n"
"穿着明显不合身的宽松衣服的小女孩——"

#. ID 104, Page 1, Line 29, Pos (0,5)
msgid ""
"代わりに現れたのは、どこか顔に見覚えのある、\n"
"そして懐かしい制服をなぜか着ている女児――"
msgstr ""
"取而代之出现的是，面容似乎在哪儿见过、\n"
"而且不知为何穿着令人怀念的制服的小女孩——"

#. ID 104, Page 1, Line 41, Pos (0,5)
msgid ""
"不思議な鏡の魔力によって\n"
"\\N[\\V[6]]は若返り\n"
"子供の姿になってしまった！！"
msgstr ""
"由于神奇镜子的魔力，\n"
"\\N[\\V[6]]返老还童变成了小孩模样！！"

#. ID 104, Page 2, Line 4, Pos (0,5)
msgid ""
"\\N[\\V[6]]は自分の身体に起こった\n"
"異変をあらためる為、\n"
"姿見を覗き込んだ。"
msgstr ""
"\\N[\\V[6]]为了确认自己身体发生的异变，\n"
"朝穿衣镜里窥视。"

#. ID 104, Page 2, Line 11, Pos (0,5)
msgid ""
"そこに映っているのは、\n"
"やはり、見慣れた自分の姿ではなく――"
msgstr "映在那里的，果然不是看惯了的自己的身影——"

#. ID 104, Page 2, Line 13, Pos (0,5)
msgid ""
"おそらくは十歳にも満たないだろう、\n"
"驚愕と動揺の表情を浮かべた小さな女児――いや？"
msgstr ""
"恐怕连十岁都不到吧，\n"
"脸上浮现惊愕与动摇表情的小女孩——不？"

#. ID 104, Page 2, Line 21, Pos (0,5)
msgid ""
"一瞬、鏡の表面が\n"
"水面のようにゆらめくと、\n"
"そこに映った女児の姿は消えて――"
msgstr ""
"一瞬间，镜面像水面一样晃动起来，\n"
"映在那里的女孩身影消失了——"

#. ID 104, Page 2, Line 25, Pos (0,5)
#. ID 104, Page 2, Line 37, Pos (0,5)
msgid ""
"代わりに現れたのは、\n"
"十歳どころではない、おそらくは十月にも満たない、\n"
"最早男女の区別すら曖昧な赤ん坊――！！"
msgstr ""
"取而代之出现的是，何止十岁，\n"
"恐怕连十个月都不到，\n"
"早已连男女区别都模糊的婴儿——！！"

#. ID 104, Page 2, Line 31, Pos (0,5)
msgid ""
"代わりに現れたのは、\n"
"十歳どころではない、おそらくは十月にも満たない、\n"
"服の山に埋もれてもがく赤ん坊――！！"
msgstr ""
"取而代之出现的是，何止十岁，\n"
"恐怕连十个月都不到，埋在衣服堆里挣扎的婴儿——！\n"
"！"

#. ID 104, Page 2, Line 50, Pos (0,5)
msgid ""
"不思議な鏡の魔力によって\n"
"\\N[\\V[6]]はさらに若返り\n"
"赤子の姿になってしまった！！"
msgstr ""
"由于神奇镜子的魔力，\n"
"\\N[\\V[6]]进一步返老还童变成了婴儿模样！！"
