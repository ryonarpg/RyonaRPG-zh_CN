#. ID 30, Page 2, Line 4, Pos (8,3)
msgid ""
"名前：月のゴーレム\n"
"種族：魔生命"
msgstr "名字：月之魔像 种族：魔生命"

#. ID 30, Page 2, Line 6, Pos (8,3)
msgid "月の石でできたゴーレム"
msgstr "用月之石制成的魔像"

#. ID 30, Page 2, Line 7, Pos (8,3)
#. Contains choice at line 3 (2 options)
msgid ""
"\\$2000Gで攻略情報を聞くことができます\n"
"聞きますか？"
msgstr "花\\$2000G可以听取攻略情报。要听吗？"

#. ID 30, Page 2, Line 9, Pos (8,3)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"はい"
msgstr ""
"否\n"
"是"

#. ID 30, Page 2, Line 15, Pos (8,3)
msgid ""
"月の石でできたゴーレム\\!\n"
"動きが鈍重だがとても硬い！"
msgstr "用月之石制成的魔像\\!动作迟钝但非常坚硬！"

#. ID 30, Page 2, Line 17, Pos (8,3)
msgid ""
"雷属性が有効だ\\!\n"
"また、魔法がとても効きやすい！"
msgstr "雷属性有效！\\!另外，魔法非常容易生效！"

#. ID 30, Page 2, Line 19, Pos (8,3)
msgid "稀に\\C[2]星屑のマント\\C[0]を落とす"
msgstr "偶尔会掉落\\C[2]星屑斗篷\\C[0]"
