#. ID 13, Page 2, Line 3, Pos (11,23)
msgid "下水溝に続いているようだ"
msgstr "似乎通向下水沟"

#. ID 13, Page 2, Line 4, Pos (11,23)
#. Contains choice at line 2 (2 options)
msgid "跳びこみますか？"
msgstr "要跳进去吗？"

#. ID 13, Page 2, Line 5, Pos (11,23)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 14, Page 2, Line 9, Pos (2,29)
msgid ""
"たまらない臭いだ…\n"
"生き物の肉が腐敗し液状化してしまったものが\n"
"床を覆っている"
msgstr "臭得受不了……生物肉体腐败液化后的东西覆盖着地面"

#. ID 17, Page 2, Line 4, Pos (2,30)
msgid "うう……"
msgstr "呜呜……"

#. ID 17, Page 2, Line 5, Pos (2,30)
msgid "臭いが身体についてしまった気がする"
msgstr "感觉臭味沾到身上了"

#. ID 30, Page 2, Line 3, Pos (2,14)
#. Contains choice at line 2 (2 options)
msgid "＊魔力溜まりがある。"
msgstr "＊有魔力池。"

#. ID 30, Page 2, Line 4, Pos (2,14)
#. Choice (2 options, embedded in a message)
msgid ""
"魔力を回復する\n"
"いいえ"
msgstr ""
"恢复魔力\n"
"否"

#. ID 30, Page 2, Line 21, Pos (2,14)
msgid "魔力溜まりは汚染されていた"
msgstr "魔力池被污染了"
