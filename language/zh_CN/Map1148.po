#. ID 24, Page 3, Line 8, Pos (0,5)
msgid "・・・水が流れるような大きな音がした。"
msgstr "・・・传来了好像水流涌动般的巨大声响。"

#. ID 57, Page 2, Line 3, Pos (14,7)
#. ID 61, Page 2, Line 3, Pos (25,7)
#. ID 65, Page 2, Line 3, Pos (13,39)
#. ID 69, Page 2, Line 3, Pos (51,39)
msgid "棒は奥まで完全に押し込まれたようだ。"
msgstr "棒似乎已经被完全推到底了。"

#. ID 57, Page 3, Line 3, Pos (14,7)
#. ID 61, Page 3, Line 3, Pos (25,7)
#. ID 65, Page 3, Line 3, Pos (13,39)
#. ID 69, Page 3, Line 3, Pos (51,39)
