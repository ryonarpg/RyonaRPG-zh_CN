#. ID 2, Page 2, Line 2, Pos (19,29)
#. ID 3, Page 2, Line 2, Pos (20,29)
#. ID 17, Page 2, Line 2, Pos (16,0)
#. ID 17, Page 3, Line 2, Pos (16,0)
#. ID 17, Page 5, Line 2, Pos (16,0)
#. ID 18, Page 2, Line 2, Pos (17,0)
#. ID 18, Page 3, Line 2, Pos (17,0)
#. ID 18, Page 5, Line 2, Pos (17,0)
#. ID 19, Page 2, Line 2, Pos (18,0)
#. ID 19, Page 3, Line 2, Pos (18,0)
#. ID 19, Page 5, Line 2, Pos (18,0)
msgid "鍵がかかっている。"
msgstr "锁上了。"

#. ID 2, Page 4, Line 1, Pos (19,29)
#. ID 3, Page 4, Line 1, Pos (20,29)
msgid "もう退くことはできない。"
msgstr "已经无法后退了。"

#. ID 16, Page 1, Line 2, Pos (24,15)
msgid ""
"どうも、私です。\n"
"アジトにいた羊ですよ。"
msgstr "你好，是我。就是据点里的那只羊哦。"

#. ID 16, Page 1, Line 4, Pos (24,15)
msgid ""
"私もあなたと同じく\n"
"潜入工作を任され、\n"
"調査を行ってきました。"
msgstr "我也和你一样被委派了潜入工作，一直在进行调查。"

#. ID 16, Page 1, Line 7, Pos (24,15)
msgid ""
"あなたを出来る限りサポートします。\n"
"まぁ、実はあなたが私をサポートすると\n"
"言った方が正確なのですけど……"
msgstr ""
"我会尽可能支援你。不过，\n"
"其实说是你支援我才更准确……"

#. ID 16, Page 1, Line 12, Pos (24,15)
msgid ""
"当然でしょう？\n"
"私の方がずっと先輩ですし、\n"
"この砦の状況も把握しているんですから。"
msgstr ""
"那是当然的吧？我可是你的前辈，\n"
"而且对这个堡垒的情况也掌握得很清楚。"

#. ID 16, Page 1, Line 15, Pos (24,15)
msgid ""
"私が作戦の概要を伝えますので、あなたは\n"
"それに従って任務を遂行してください。\n"
"私は、あなたの仕事ぶりの監査員も兼ねて\n"
"いるのです。"
msgstr ""
"我会说明作战概要，你就按照那个执行任务。\n"
"我还兼任你工作表现的监察员。"

#. ID 16, Page 2, Line 2, Pos (24,15)
msgid ""
"まずは隊長に挨拶に行ってください。\n"
"傭兵として出願するのです。"
msgstr "首先去跟队长打个招呼吧。以佣兵的身份提出申请。"

#. ID 16, Page 2, Line 4, Pos (24,15)
msgid ""
"本来は難しいですがあなたなら認可される\n"
"でしょう。"
msgstr "本来很难，但你的话应该会被批准吧。"

#. ID 16, Page 2, Line 6, Pos (24,15)
msgid ""
"隊長は正面の「謁見の間」にいます。\n"
"\n"
"そう、「謁見の間」なのですよ……"
msgstr ""
"队长在正面的「谒见之间」。没错，就是\n"
"「谒见之间」哦……"

#. ID 16, Page 3, Line 3, Pos (24,15)
msgid "あなたも私たちの仲間入りですねえ……"
msgstr "你也加入我们的同伴行列了呢……"

#. ID 16, Page 3, Line 8, Pos (24,15)
msgid "おお、やりましたか！"
msgstr "哦哦，成功了吗！"

#. ID 16, Page 3, Line 11, Pos (24,15)
msgid ""
"では、そいつをアジトまで連れて行って\n"
"ください。入り口は開けておきますから。"
msgstr "那么，把那家伙带到据点去吧。我会把入口开着的。"

#. ID 16, Page 3, Line 18, Pos (24,15)
msgid ""
"事を運ぶのは夜ですよ……\n"
"羊が最も働く時間です。"
msgstr "行动要等到晚上哦……那是羊最能干活的时间。"

#. ID 16, Page 3, Line 23, Pos (24,15)
msgid "どうやら認可されたようですね。"
msgstr "看来已经获得批准了呢。"

#. ID 16, Page 3, Line 25, Pos (24,15)
msgid ""
"さっそく任務の話でもよいのですが、\n"
"まずは砦を見て回ってはどうでしょう？\n"
"その方が話も通じやすいでしょうから。"
msgstr ""
"马上谈任务也可以，不过先逛逛堡垒怎么样？\n"
"这样也更容易沟通。"

#. ID 16, Page 3, Line 28, Pos (24,15)
msgid "一通り回ったら私に声をかけてください。"
msgstr "逛完一圈后请来跟我说一声。"

#. ID 16, Page 3, Line 31, Pos (24,15)
#. Contains choice at line 2 (2 options)
msgid "任務に移りますか？"
msgstr "要开始执行任务吗？"

#. ID 16, Page 3, Line 32, Pos (24,15)
#. Choice (2 options, embedded in a message)
#. ID 16, Page 4, Line 46, Pos (24,15)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 16, Page 3, Line 35, Pos (24,15)
msgid ""
"では、今回の任務の内容ですが……\\!\n"
"誘拐です。"
msgstr "那么，这次任务的内容是……\\!绑架。"

#. ID 16, Page 3, Line 39, Pos (24,15)
msgid ""
"ターゲットはこのエルフです。\n"
"食堂で給仕をしています。"
msgstr "目标是这个精灵。她在食堂当侍者。"

#. ID 16, Page 3, Line 43, Pos (24,15)
msgid ""
"別の者が砦の資金を盗み、そのエルフに\n"
"罪を擦り付けるというわけです。"
msgstr ""
"就是由别人偷走堡垒的资金，\n"
"然后把罪名嫁祸给那个精灵。"

#. ID 16, Page 3, Line 45, Pos (24,15)
msgid ""
"それが成せない場合は、やむを得ません。\n"
"殺害し死体を隠蔽します。"
msgstr "如果做不到的话，也没办法。就杀掉她并藏匿尸体。"

#. ID 16, Page 3, Line 48, Pos (24,15)
msgid ""
"ドン引きしてますね。まぁそうでしょう、\n"
"突然そんな話をされても困りますよね。\n"
"私としても殺しはなるべく避けたい。\n"
"あなたの働き次第です。"
msgstr ""
"你被吓到了呢。嘛，也是吧，\n"
"突然被说这种事会困扰吧。我也尽可能想避免杀人。\n"
"就看你表现了。"

#. ID 16, Page 3, Line 53, Pos (24,15)
msgid ""
"で、具体的な方法ですが彼女は夜、食堂に\n"
"残り一人で後片付けをしています。\\!\n"
"そこを狙うのが最も可能性が高いかと思い\n"
"ます。"
msgstr ""
"那么，具体方法的话，\n"
"她晚上会留在食堂一个人收拾善后。\n"
"\\!我觉得瞄准那里最有可能。"

#. ID 16, Page 3, Line 57, Pos (24,15)
msgid ""
"夜になるまでは、自室で待機をしていると\n"
"いいでしょう。\n"
"\n"
"では、健闘を祈ります。"
msgstr ""
"到晚上之前，你在自己房间待命就好。那么，\n"
"祝你武运昌隆。"

#. ID 16, Page 4, Line 3, Pos (24,15)
msgid "あなたも悪が板についてきましたねえ……"
msgstr "你也越来越习惯作恶了呢……"

#. ID 16, Page 4, Line 8, Pos (24,15)
msgid ""
"見事な手際でした。\n"
"万事うまくいきましたよ。"
msgstr "干得真漂亮。一切都顺利成功了。"

#. ID 16, Page 4, Line 10, Pos (24,15)
#. ID 16, Page 4, Line 31, Pos (24,15)
msgid ""
"これは特別手当のようなものです。\n"
"受け取ってください。"
msgstr "这个就当是特别津贴吧。请收下。"

#. ID 16, Page 4, Line 15, Pos (24,15)
#. ID 16, Page 5, Line 24, Pos (24,15)
msgid "5000G手渡された。"
msgstr "被递给了5000G。"

#. ID 16, Page 4, Line 19, Pos (24,15)
msgid "次もその調子でお願いしますよ。"
msgstr "下次也请照这个样子继续。"

#. ID 16, Page 4, Line 25, Pos (24,15)
msgid "あなた、とちりましたね。"
msgstr "你，搞砸了呢。"

#. ID 16, Page 4, Line 27, Pos (24,15)
msgid ""
"ターゲットと2人で外に出たところを\n"
"高台の見張りに目撃されています。"
msgstr "和目标两人一起外出时，被高台上的瞭望者目击了。"

#. ID 16, Page 4, Line 29, Pos (24,15)
msgid ""
"まぁ、こちらでなんとかしのぎました。\n"
"次は気をつけてくださいね。"
msgstr "嘛，这边总算设法应付过去了。下次请小心点哦。"

#. ID 16, Page 4, Line 36, Pos (24,15)
msgid "3000G手渡された。"
msgstr "被交给了3000G。"

#. ID 16, Page 4, Line 40, Pos (24,15)
msgid "今後の活躍に期待しています。"
msgstr "期待你今后的活跃表现。"

#. ID 16, Page 4, Line 45, Pos (24,15)
#. Contains choice at line 2 (2 options)
msgid "次の任務に移りますか？"
msgstr "要转移到下一个任务吗？"

#. ID 16, Page 4, Line 49, Pos (24,15)
msgid ""
"今回の任務ですが……誘拐です。\\!\n"
"ええ、またです。"
msgstr "这次的任务是……绑架。\\!是的，又是这样。"

#. ID 16, Page 4, Line 52, Pos (24,15)
msgid ""
"今度のターゲットは事務の彼女です。\n"
"ちなみに、先日あなたが拉致したエルフの\n"
"妹です。\\!\n"
"妹の方が大きい。よくある話です。"
msgstr ""
"这次的目标是事务处的她。顺便一提，\n"
"是你前几天绑架的精灵的妹妹。\\!妹妹那边更大。\n"
"这是常有的事。"

#. ID 16, Page 4, Line 56, Pos (24,15)
msgid ""
"姉の濡れ衣を晴らしたい彼女は健気にも、\n"
"ろくに寝ずに事務室で怪しい出納を探して\n"
"います。"
msgstr ""
"想洗清姐姐冤屈的她也很坚强，\n"
"几乎不睡觉地在办公室查找可疑的收支记录。"

#. ID 16, Page 4, Line 60, Pos (24,15)
msgid ""
"ちょっと怪しいネタを与えれば\n"
"すぐに食いついてくるでしょう。\\!\n"
"決行はやはり夜をお勧めします。"
msgstr ""
"只要给她一点可疑的线索，她就会立刻上钩吧。\n"
"\\!行动还是建议在夜里进行。"

#. ID 16, Page 4, Line 72, Pos (24,15)
msgid "やりましたか。すごい手際ですねえ……"
msgstr "办成了吗？手段真厉害啊……"

#. ID 16, Page 4, Line 73, Pos (24,15)
msgid ""
"では、扉は開けておきますので、\n"
"前回同様お願いします。"
msgstr "那么，门我会开着，请像上次一样办吧。"

#. ID 16, Page 4, Line 79, Pos (24,15)
msgid "では、頼みましたよ！"
msgstr "那么，就拜托了！"

#. ID 16, Page 5, Line 3, Pos (24,15)
#. ID 16, Page 5, Line 19, Pos (24,15)
msgid ""
"ご苦労様でした。\n"
"これは今回の手当てです。"
msgstr "辛苦了。这是这次的报酬。"

#. ID 16, Page 5, Line 8, Pos (24,15)
msgid "10000G手渡された。"
msgstr "被交给了10000G。"

#. ID 16, Page 5, Line 12, Pos (24,15)
msgid ""
"いよいよ本格的に工作に移っていきます。\n"
"あなたにも存分に働いてもらいますよ。"
msgstr "终于要正式进入谋划工作了。也要让你尽情发挥哦。"

#. ID 16, Page 5, Line 28, Pos (24,15)
msgid ""
"本当はもっと高額でも良いのですがね……\n"
"私への慰謝料ということで引きました。"
msgstr ""
"其实本来可以再多给一些的……就当是给我的赔偿金，\n"
"我扣下了。"

#. ID 16, Page 5, Line 34, Pos (24,15)
msgid ""
"教官の遠征を待ちます。あんな\n"
"化け物と戦うなんて馬鹿げています。"
msgstr "等教官远征。和那种怪物战斗真是荒唐。"

#. ID 16, Page 5, Line 36, Pos (24,15)
msgid ""
"とはいえ、あの教官がいない間にカタを\n"
"つけないといけませんからね……\n"
"ただ待っているわけにもいきません。"
msgstr ""
"话虽如此，必须趁那个教官不在时做个了断……\n"
"也不能光等着。"

#. ID 16, Page 5, Line 39, Pos (24,15)
msgid ""
"かといって、大きく動けば異変ありという\n"
"ことで遠征を中止してしまうかも。\n"
"難しいところです。"
msgstr ""
"但话又说回来，如果动作太大，\n"
"可能会被当作有异变而中止远征。这很难办。"

#. ID 16, Page 5, Line 43, Pos (24,15)
msgid ""
"差し当たって、食堂のコックが問題です。\n"
"奴１人いるのといないのとでは、状況が\n"
"全く変わってしまいます。"
msgstr ""
"眼下食堂的厨师是个问题。那家伙在不在，\n"
"情况会完全不同。"

#. ID 16, Page 5, Line 47, Pos (24,15)
msgid ""
"ブライ一門との不仲を利用して……\\!\n"
"あわよくば……\\!\n"
"いえ、まだ計画段階です。"
msgstr ""
"利用与布莱一门的不和……\\!如果顺利的话……\\!不，\n"
"还在计划阶段。"

#. ID 16, Page 6, Line 3, Pos (24,15)
msgid ""
"どうです？\n"
"何か有益な情報でもありましたか？"
msgstr "怎么样？有什么有益的情报吗？"

#. ID 16, Page 6, Line 7, Pos (24,15)
msgid ""
"なるほど、エルフがいじめをねえ……\n"
"風紀が乱れるのは良いことです。\n"
"修道女は余計なことをしてくれますが……"
msgstr ""
"原来如此，精灵被欺负啊……风纪混乱是好事。\n"
"虽然修女会做些多余的事……"

#. ID 16, Page 6, Line 11, Pos (24,15)
msgid ""
"しかし、\n"
"考え方を変えればエルフの心が折れて\n"
"本当に逃げ出すのを防いでくれているとも\n"
"言えますね。"
msgstr ""
"不过，换个角度想，\n"
"也可以说这防止了精灵心灰意冷而真的逃走。"

#. ID 16, Page 6, Line 16, Pos (24,15)
msgid ""
"ところで、そのいじめのメンバーの中に\n"
"赤い兜を被った者はいませんでしたか？"
msgstr "话说，那些欺凌者里有戴红色头盔的人吗？"

#. ID 16, Page 6, Line 20, Pos (24,15)
msgid ""
"なるほど……\\!\n"
"これは使えるかもしれませんねえ……"
msgstr "原来如此……\\!这也许能派上用场……"

#. ID 16, Page 6, Line 24, Pos (24,15)
msgid ""
"穴だらけの作戦ですが、\n"
"やってみる価値はありそうです。"
msgstr "虽然是个漏洞百出的作战，但似乎值得一试。"

#. ID 16, Page 6, Line 26, Pos (24,15)
msgid ""
"あなたは、エルフの末っ子がいじめられて\n"
"いたことを料理長に告げ口しなさい。\\!\n"
"あとは、こっちでやっておきます。"
msgstr ""
"你去向厨师长告发精灵家最小的孩子被欺负的事。\n"
"\\!剩下的这边来做。"

#. ID 16, Page 6, Line 30, Pos (24,15)
msgid "それじゃあ、よろしく頼みますよ？"
msgstr "那么，就拜托你了哦？"

#. ID 16, Page 6, Line 35, Pos (24,15)
msgid ""
"悪いことではないと思いますよ。\n"
"ほら、気兼ねなく密告なさい。"
msgstr "我觉得这不算坏事。来，不必顾虑，去告密吧。"

#. ID 16, Page 7, Line 2, Pos (24,15)
msgid ""
"ふっふっふっ…………\n"
"まさかここまでうまくいくとは\n"
"思いませんでしたよ。"
msgstr "呵呵呵…………没想到会这么顺利。"

#. ID 16, Page 7, Line 5, Pos (24,15)
msgid ""
"料理長は料理長で相当鬱憤が溜まっていた\n"
"みたいですね。\n"
"ところで…………"
msgstr "厨师长那边似乎也积了不少怨气。话说…………"

#. ID 16, Page 7, Line 10, Pos (24,15)
msgid ""
"あなた、助かるために身体をなげうった\n"
"そうじゃないですか……\n"
"淫乱なんですねえ……"
msgstr "你听说为了获救不惜献出身体……真是淫乱呢……"

#. ID 16, Page 7, Line 16, Pos (24,15)
msgid ""
"あなた、身を挺してエルフたちを守った\n"
"らしいじゃないですか。彼女たちの信用は\n"
"得られたでしょうが、別にいらなかったと\n"
"思いますがね……"
msgstr ""
"听说你挺身保护了精灵们。\n"
"虽然应该获得了她们的信任，\n"
"不过我觉得其实没必要……"

#. ID 16, Page 8, Line 2, Pos (24,15)
msgid ""
"やりました……！！\n"
"ついにあのコックを退けることができた…"
msgstr "成功了……！！终于把那个厨师赶走了……"

#. ID 16, Page 8, Line 5, Pos (24,15)
msgid ""
"大きな憂いが一つ晴れました。\n"
"これからは、軍曹の遠征を待ちます。"
msgstr "一大忧患消除了。接下来等军曹远征。"

#. ID 16, Page 9, Line 3, Pos (24,15)
msgid ""
"さて………教官がいなくなったところで、\n"
"いよいよ………ブライをなんとかします。"
msgstr "那么………趁教官不在了，终于………要设法对付布莱了。"

#. ID 16, Page 9, Line 5, Pos (24,15)
msgid ""
"局長のブライへの不信感は\n"
"もう十分に植え付けました。それを利用\n"
"します。"
msgstr ""
"已经充分植入了局长对布莱的不信任。\n"
"要利用这一点。"

#. ID 16, Page 9, Line 8, Pos (24,15)
msgid ""
"まずは一旦アジトに戻ってDDからある物を\n"
"もらってきてください。この作戦の成功を\n"
"左右する大切な代物です。"
msgstr ""
"首先先回一趟据点，从DD那里拿某样东西来。\n"
"这是左右本次作战成败的重要物件。"

#. ID 16, Page 9, Line 11, Pos (24,15)
msgid "では、頼みましたよ。"
msgstr "那么，拜托了。"

#. ID 16, Page 9, Line 17, Pos (24,15)
msgid ""
"あれがどの程度効果を発揮するか……\n"
"できるのならそのまま決着といってほしい\n"
"のですけど……"
msgstr ""
"那东西能发挥多大效果……如果可以的话，\n"
"真希望就这样了结……"

#. ID 16, Page 9, Line 23, Pos (24,15)
msgid "おお、戻りましたか。"
msgstr "哦，回来了吗。"

#. ID 16, Page 9, Line 25, Pos (24,15)
msgid ""
"ちょっと拝見……\\!\n"
"\n"
"そうそう、これですよ。"
msgstr "让我看看……\\!对对，就是这个。"

#. ID 16, Page 9, Line 29, Pos (24,15)
msgid ""
"問題は…これがどうやって発見されるか、\n"
"ですね。最悪、私が見つけたことにして\n"
"王子に献上するだけでもかなりの効果が\n"
"見込めますが……"
msgstr ""
"问题是……这个要怎么被发现。最坏的情况，\n"
"就当是我发现的献给王子，也能期待相当的效果……"

#. ID 16, Page 9, Line 33, Pos (24,15)
msgid ""
"やはりブライの者から発見されるのが良い\n"
"でしょうね。"
msgstr "果然还是由布莱的人发现比较好。"

#. ID 16, Page 9, Line 36, Pos (24,15)
msgid ""
"内通者がいれば楽なんですが……\n"
"ストックしていた者は先日料理長に金玉を\n"
"潰されてリタイアしてしまいましたし……"
msgstr ""
"有内应就轻松了……\n"
"但储备的那个人前几天被厨师长捏碎蛋蛋，\n"
"已经退出了……"

#. ID 16, Page 9, Line 41, Pos (24,15)
msgid ""
"おや……アテがあるような顔つきですね…\\!\n"
"それなら、こんな作戦はどうでしょう……\n"
"あのじじいは実は酒好きの女好きで………"
msgstr ""
"哦呀……你的表情像是有人选啊……\\!那么，\n"
"这样的作战如何……那个老头其实嗜酒好色………"

#. ID 16, Page 9, Line 47, Pos (24,15)
msgid ""
"ともかく、お任せしました。\n"
"うまくいかなくとも、フォローを入れます\n"
"ので報告に来てください。"
msgstr ""
"总之，交给你了。就算不顺利，我也会支援，\n"
"请来报告。"

#. ID 16, Page 10, Line 3, Pos (24,15)
msgid ""
"まぁ失敗しても我々の正体がばれなければ\n"
"取り返せます。最悪、殺してでも\n"
"秘密は守ってください。"
msgstr ""
"嘛，就算失败，只要我们的身份没暴露就能挽回。\n"
"最坏情况下，杀掉也要守住秘密。"

#. ID 16, Page 10, Line 11, Pos (24,15)
msgid ""
"ちょっと様子を見てきてください。\n"
"食堂にいるはずです。"
msgstr "去看看情况。应该在食堂。"

#. ID 16, Page 10, Line 16, Pos (24,15)
msgid "決行は夜ですね。"
msgstr "行动是在夜里吧。"

#. ID 16, Page 10, Line 25, Pos (24,15)
msgid ""
"見届けましたか……\n"
"では、後はこちらに任せてお休みなさい。\n"
"いよいよ勝負に出るのです。\n"
"ゆっくり休むのですよ。"
msgstr ""
"见证了吗……那么，之后就交给我，你休息吧。\n"
"终于要一决胜负了。好好休息吧。"

#. ID 16, Page 11, Line 2, Pos (24,15)
msgid ""
"さて……どうなるか……\n"
"ここが正念場、油断せずいきましょう。"
msgstr ""
"那么……会怎样呢……这里是关键时刻，\n"
"不要大意地来吧。"

#. ID 16, Page 11, Line 5, Pos (24,15)
msgid ""
"ああ、\n"
"ちなみに彼女は脱走しようとしていたので\n"
"こちらで始末しておきました。"
msgstr ""
"啊，顺便一提，她正想逃跑，\n"
"所以我这边已经处理掉了。"

#. ID 16, Page 12, Line 3, Pos (24,15)
msgid ""
"ブライ一門の一掃に成功しました……\n"
"ふふふ……これで……この砦を攻め落とす\n"
"ことができるでしょう。"
msgstr ""
"成功扫清了布莱一门……呵呵呵……这样一来……\n"
"应该就能攻下这座堡垒了。"

#. ID 16, Page 12, Line 6, Pos (24,15)
msgid ""
"あまり時間はありませんが、\n"
"ここはDDの指示を仰ぐことにしましょう。"
msgstr "虽然时间不多，这里还是请示DD的指示吧。"

#. ID 16, Page 12, Line 12, Pos (24,15)
msgid "どうでした？"
msgstr "怎么样？"

#. ID 16, Page 12, Line 14, Pos (24,15)
msgid ""
"デイジーを誘拐してこいと……？\n"
"DDがですか……？"
msgstr "叫我去把黛西绑架来……？DD说的吗……？"

#. ID 16, Page 12, Line 17, Pos (24,15)
msgid ""
"なるほど。どうやら彼女も腹を括った\n"
"ようですね。いいでしょう、さくっと\n"
"やってしまいましょう。"
msgstr ""
"原来如此。看来她也下定决心了。好吧，\n"
"利落地解决掉吧。"

#. ID 16, Page 12, Line 21, Pos (24,15)
msgid ""
"呼び出すならば、\n"
"深夜の食堂がいいでしょう。"
msgstr "要叫她出来的话，深夜的食堂比较好吧。"

#. ID 16, Page 12, Line 23, Pos (24,15)
msgid ""
"彼女たちにとっては事件のあった場所です\n"
"から、ちょっとしたら断られるかも\n"
"しれませんがね。"
msgstr ""
"对她们来说是发生过事件的地方，\n"
"弄不好可能会被拒绝吧。"

#. ID 16, Page 12, Line 30, Pos (24,15)
msgid ""
"しかし……\n"
"これは面白くなってきましたねぇ……"
msgstr "不过……这变得有意思起来了呢……"

#. ID 16, Page 13, Line 2, Pos (24,15)
msgid ""
"彼女は…一応戦闘に出られるということに\n"
"なってはいますが、\n"
"あなたなら問題にならないでしょう。"
msgstr "她……姑且算是能参加战斗，不过你的话不成问题吧。"

#. ID 16, Page 13, Line 5, Pos (24,15)
msgid "さくっとやってきてください。"
msgstr "请利落地去办吧。"

#. ID 16, Page 14, Line 3, Pos (24,15)
#. ID 16, Page 14, Line 17, Pos (24,15)
msgid "DDも……喜ぶと思いますよ……？"
msgstr "我觉得DD也会……高兴的哦……？"

#. ID 16, Page 14, Line 7, Pos (24,15)
msgid "相変わらず見事な手際ですねえ……"
msgstr "还是那么漂亮的手法呢……"

#. ID 16, Page 14, Line 9, Pos (24,15)
msgid ""
"うん？\n"
"なにやら余計なものも付いてますが………"
msgstr "嗯？好像还附带了什么多余的东西……"

#. ID 16, Page 14, Line 12, Pos (24,15)
msgid ""
"見られたんですか？\n"
"まあいいでしょう。\n"
"早く連れていきなさい。"
msgstr "被看到了吗？算了。快点带走吧。"

#. ID 16, Page 15, Line 1, Pos (24,15)
msgid ""
"あれ？ここにいた羊どこ行ったんだ？\n"
"こんな夜更けに……"
msgstr "咦？本来在这里的羊去哪了？都这么深的夜了……"

#. ID 16, Page 15, Line 3, Pos (24,15)
msgid ""
"誰かが眠れなくって呼ばれたのかな？\n"
"……冗談だ。"
msgstr "是不是有谁睡不着把我叫来了？……开玩笑的。"

#. ID 16, Page 16, Line 1, Pos (24,15)
msgid ""
"うっ………こんな時に…………\n"
"頼む、俺をそっとしておいてくれ…………\n"
"女は目の毒だ……"
msgstr ""
"呃……这种时候……拜托，让我一个人待着……\n"
"女人是眼睛的毒……"

#. ID 16, Page 17, Line 3, Pos (24,15)
msgid "この惨状は……"
msgstr "这惨状是……"

#. ID 16, Page 17, Line 6, Pos (24,15)
msgid ""
"すまんがちょっと見てきてくれ。\n"
"気をつけてな。"
msgstr "抱歉，去看一下。小心点。"

#. ID 16, Page 17, Line 12, Pos (24,15)
msgid "む……これは少し込み入りそうだな。"
msgstr "唔……这似乎有点复杂啊。"

#. ID 16, Page 17, Line 13, Pos (24,15)
#. Contains choice at line 2 (2 options)
msgid "飛ばすか？"
msgstr "要跳过吗？"

#. ID 16, Page 17, Line 14, Pos (24,15)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"はい"
msgstr ""
"否\n"
"是"

#. ID 16, Page 17, Line 17, Pos (24,15)
msgid "そうか。"
msgstr "这样啊。"

#. ID 16, Page 17, Line 21, Pos (24,15)
#. Contains choice at line 2 (3 options)
msgid "お前のイベント後の立場を選べ。"
msgstr "选择你在此事件后的立场。"

#. ID 16, Page 17, Line 22, Pos (24,15)
#. Choice (3 options, embedded in a message)
msgid ""
"そのまま\n"
"逃げ出す\n"
"寝返る"
msgstr ""
"保持原样\n"
"逃跑\n"
"倒戈"

#. ID 16, Page 17, Line 40, Pos (24,15)
#. ID 16, Page 17, Line 73, Pos (24,15)
#. ID 16, Page 17, Line 822, Pos (24,15)
#. ID 16, Page 17, Line 960, Pos (24,15)
#. ID 25, Page 3, Line 19, Pos (21,11)
#. ID 26, Page 3, Line 21, Pos (13,11)
msgid "いくぞ！"
msgstr "走吧！"

#. ID 16, Page 17, Line 88, Pos (24,15)
msgid "所属不明の軍隊がすでに制圧していた…？"
msgstr "所属不明的军队已经镇压了……？"

#. ID 16, Page 17, Line 91, Pos (24,15)
msgid ""
"……どうやら、依頼主は\n"
"我々以上の下衆野郎だったらしいな。"
msgstr "……看来，委托人是个比我们更下贱的混蛋啊。"

#. ID 16, Page 17, Line 96, Pos (24,15)
msgid "お褒めにあずかり光栄ですよ。"
msgstr "承蒙夸奖，深感荣幸。"

#. ID 16, Page 17, Line 109, Pos (24,15)
msgid ""
"今までご苦労様でした。おかげで、ご覧の通り\n"
"この砦を陥落させることができましたよ。\n"
"ここの隊長も、この通りです。"
msgstr ""
"一直以来辛苦了。多亏了你，如你所见，\n"
"我们才能攻陷这座要塞。这里的队长也成了这样。"

#. ID 16, Page 17, Line 116, Pos (24,15)
msgid "あ……ああ！！"
msgstr "啊……啊啊！！"

#. ID 16, Page 17, Line 119, Pos (24,15)
msgid ""
"後は王子の居場所を聞き出したいのですが……\n"
"なかなか頑固でしてねえ……"
msgstr "接下来想问出王子的下落……但他相当顽固呢……"

#. ID 16, Page 17, Line 123, Pos (24,15)
msgid ""
"へ……へへ…………\n"
"もう……どこか遠くに行ってしまったよ。"
msgstr "嘿……嘿嘿……已经……去了很远的地方了。"

#. ID 16, Page 17, Line 129, Pos (24,15)
msgid "いぎっ……"
msgstr "呃啊……"

#. ID 16, Page 17, Line 132, Pos (24,15)
msgid ""
"どういうことですかな？ミニマム伯爵。\n"
"我々は\n"
"ここの制圧まで請け負うはずでしたが……"
msgstr ""
"这是怎么回事，米尼玛姆伯爵？\n"
"我们本应负责镇压这里才对……"

#. ID 16, Page 17, Line 135, Pos (24,15)
msgid ""
"これはそちらの独断だ。ちゃんと報酬は\n"
"払っていただけるのでしょうな？"
msgstr "这是你们的独断。报酬会好好支付吧？"

#. ID 16, Page 17, Line 139, Pos (24,15)
msgid ""
"なんとも白々しい。\n"
"もうわかっているのでしょう？元々、ここを潰すのは\n"
"こちらがやる予定だったのですよ。"
msgstr ""
"真是装糊涂。你们已经明白了吧？原本，\n"
"摧毁这里是由我们负责的。"

#. ID 16, Page 17, Line 143, Pos (24,15)
msgid ""
"お前らが失敗してこっちにまで火の粉が飛んで来ちゃ\n"
"かなわんからな。"
msgstr "要是你们失败，火星子飞到我这边来可受不了。"

#. ID 16, Page 17, Line 146, Pos (24,15)
msgid ""
"そりゃそうだろう？お前らのような弱小勢力がここを\n"
"潰せるかどうかに賭けるなど馬鹿げている。\n"
"お前たちは、ここにやってきて俺たちの罪を被って\n"
"くれりゃそれでいいんだよ。"
msgstr ""
"那当然吧？赌你们这种弱小势力能不能攻下这里，\n"
"简直愚蠢。你们只要来这里替我们顶罪就行了。"

#. ID 16, Page 17, Line 153, Pos (24,15)
msgid "おいおい、そりゃどういうことだよ！？"
msgstr "喂喂，那是什么意思啊！？"

#. ID 16, Page 17, Line 156, Pos (24,15)
msgid "悪党のくせに智恵の回らん奴だな。"
msgstr "明明是恶党，脑子却不灵光。"

#. ID 16, Page 17, Line 157, Pos (24,15)
msgid ""
"ゲスラ砦は夜盗に襲われまさかの全滅、そこに忠義の士\n"
"である俺が駆けつけ悪党を成敗、砦を暫定的に守護する\n"
"べく駐屯というわけだよ。"
msgstr ""
"盖斯拉要塞遭夜盗袭击，竟至全灭；\n"
"忠义之士的我赶到，击败恶党，\n"
"为暂时代为守护要塞而驻屯——就是这么回事。"

#. ID 16, Page 17, Line 162, Pos (24,15)
msgid "え……？つまり…………"
msgstr "诶……？也就是说……"

#. ID 16, Page 17, Line 164, Pos (24,15)
msgid ""
"……伯爵はここで我々を消すつもりだって\n"
"ことだ。全ての罪をなすりつけてな。"
msgstr ""
"……也就是说，伯爵打算在这里把我们灭口，\n"
"把全部罪名都推到我们头上。"

#. ID 16, Page 17, Line 167, Pos (24,15)
msgid "マジかよ！？"
msgstr "真的假的！？"

#. ID 16, Page 17, Line 170, Pos (24,15)
msgid "マジだ。お前らにはここで死んでもらう。"
msgstr "真的。你们就死在这里吧。"

#. ID 16, Page 17, Line 173, Pos (24,15)
msgid ""
"くそっ！なんでだ、\n"
"なんでこう示し合わせたように鉢合わせ\n"
"しちまったんだよ……"
msgstr ""
"可恶！为什么，\n"
"为什么会像事先串通好一样撞到一起啊……"

#. ID 16, Page 17, Line 177, Pos (24,15)
msgid "本当に鈍いですねえ……"
msgstr "真是迟钝呢……"

#. ID 16, Page 17, Line 182, Pos (24,15)
msgid ""
"初めからその気なら、内通者がいるに\n"
"決まっているじゃないですか。"
msgstr "如果一开始就有那个打算，那肯定有内应啊。"

#. ID 16, Page 17, Line 185, Pos (24,15)
msgid ""
"あっ！？\n"
"羊、てめえ……"
msgstr "啊！？羊，你这家伙……"

#. ID 16, Page 17, Line 188, Pos (24,15)
msgid ""
"もっとも、私の主は元々この方だったの\n"
"です。\n"
"裏切るというのはちょっと違いますよ。"
msgstr "不过，我的主人原本就是这位。说背叛有点不对哦。"

#. ID 16, Page 17, Line 192, Pos (24,15)
msgid ""
"あなた達はどうです？ここで協力するなら\n"
"命だけは\n"
"助けてもらえるかもしれませんよ？"
msgstr ""
"你们怎么样？如果在这里合作，\n"
"也许至少能保住性命哦？"

#. ID 16, Page 17, Line 211, Pos (24,15)
msgid "てめえら……よくもまぁ………"
msgstr "你们这些家伙……竟敢……"

#. ID 16, Page 17, Line 214, Pos (24,15)
msgid "なんでだ……なんでこんなことを…………"
msgstr "为什么……为什么要做这种事……"

#. ID 16, Page 17, Line 216, Pos (24,15)
msgid ""
"その疑問を抱くのは大分遅いですねえ。\n"
"それは、表向きには……"
msgstr "抱有这个疑问已经太迟了。那，表面上是……"

#. ID 16, Page 17, Line 220, Pos (24,15)
msgid "いたぜ！"
msgstr "找到了！"

#. ID 16, Page 17, Line 227, Pos (24,15)
msgid "う……ぬう………"
msgstr "呜……唔……"

#. ID 16, Page 17, Line 229, Pos (24,15)
msgid ""
"所長……？\n"
"どうして……\n"
"逃げなかったんですか………"
msgstr "所长……？为什么……不逃呢……"

#. ID 16, Page 17, Line 233, Pos (24,15)
msgid ""
"ふ……ふん！お前と同じよ………\n"
"この砦は…………なんとしても死守せねば\n"
"ならんのだ……"
msgstr ""
"哼……哼！和你一样……这座要塞……\n"
"无论如何都必须死守……"

#. ID 16, Page 17, Line 238, Pos (24,15)
msgid "王子様、お元気そうで何よりです。"
msgstr "王子殿下，看来您精神不错，真是太好了。"

#. ID 16, Page 17, Line 240, Pos (24,15)
msgid "ミニマム伯爵……よくもまあ抜け抜けと…"
msgstr "米尼玛姆伯爵……竟能如此厚颜无耻……"

#. ID 16, Page 17, Line 242, Pos (24,15)
msgid ""
"王子、ご覧のとおり勝負は決まりました。\n"
"つきましては…「魔神」の封印されている\n"
"場所を教えていただきたい……"
msgstr ""
"王子，如您所见胜负已分。因此……\n"
"希望您告诉我们「魔神」被封印的地点……"

#. ID 16, Page 17, Line 247, Pos (24,15)
msgid ""
"…………やはりか。\n"
"貴様、どこでそのことを知った？"
msgstr "……果然吗。你这家伙，在哪里知道那件事的？"

#. ID 16, Page 17, Line 256, Pos (24,15)
msgid "がっ………"
msgstr "呃……"

#. ID 16, Page 17, Line 259, Pos (24,15)
msgid ""
"わかってねえなぁ。\n"
"質問してんのはこっちなんだよ。"
msgstr "你还没明白啊。提问的是我们这边。"

#. ID 16, Page 17, Line 263, Pos (24,15)
msgid ""
"し……知らんなぁ………\n"
"例え知っていたとしても、貴様らには……\n"
"いや、誰にだろうと死んでも教えんよ。"
msgstr ""
"不……不知道啊……就算知道，也绝不会告诉你们……不，\n"
"不管是谁，死也不会说。"

#. ID 16, Page 17, Line 273, Pos (24,15)
msgid "おう……"
msgstr "哦……"

#. ID 16, Page 17, Line 276, Pos (24,15)
msgid "さっさと吐いて楽になっちまいなよ………"
msgstr "快点吐出来轻松点吧……"

#. ID 16, Page 17, Line 279, Pos (24,15)
msgid "き……貴様らに語る舌など持たんわ………"
msgstr "我……没有向你们这种家伙开口的舌头……"

#. ID 16, Page 17, Line 281, Pos (24,15)
msgid "強情だねえ…！！"
msgstr "真顽固啊…！！"

#. ID 16, Page 17, Line 290, Pos (24,15)
msgid ""
"ぐふ……\n"
"な……なんてことないなぁ"
msgstr "咕呼……没……没什么大不了的。"

#. ID 16, Page 17, Line 294, Pos (24,15)
msgid ""
"呆れたもんだね。この期に及んで\n"
"意地張っちゃってさ。"
msgstr "真让人无语。都到这时候还嘴硬。"

#. ID 16, Page 17, Line 298, Pos (24,15)
msgid ""
"いいさ。そいつの頑固っぷりは\n"
"王宮でも有名だからな。"
msgstr "算了。那家伙的顽固在王宫里也很有名。"

#. ID 16, Page 17, Line 300, Pos (24,15)
msgid ""
"仕方ない。\n"
"王子に口を割ってもらうのは諦めるとしよう。\n"
"探すのは面倒だが……まぁ時間はあるしな。"
msgstr ""
"没办法。让王子开口的事就放弃吧。找他虽然麻烦……\n"
"不过反正有时间。"

#. ID 16, Page 17, Line 304, Pos (24,15)
msgid ""
"とりあえず一応の義理を果たしておこうか。\n"
"第二王子のご依頼通り……第三王子のお命を頂戴すると\n"
"しよう。"
msgstr ""
"总之先尽一下形式上的情义吧。\n"
"按照第二王子的委托……取第三王子的性命吧。"

#. ID 16, Page 17, Line 309, Pos (24,15)
msgid "や……やめて………！！！"
msgstr "住……住手……！！！"

#. ID 16, Page 17, Line 312, Pos (24,15)
msgid "やれ。"
msgstr "动手。"

#. ID 16, Page 17, Line 315, Pos (24,15)
msgid "了解！！"
msgstr "明白！！"

#. ID 16, Page 17, Line 319, Pos (24,15)
msgid "ぎゃあっ！！"
msgstr "呀啊——！！"

#. ID 16, Page 17, Line 324, Pos (24,15)
msgid "所長……うぅ…………"
msgstr "所长……呜呜……"

#. ID 16, Page 17, Line 330, Pos (24,15)
msgid ""
"どうするのさ。\n"
"そこの女にでも訊いてみるかい？"
msgstr "怎么办？要不要问问那边的女人？"

#. ID 16, Page 17, Line 334, Pos (24,15)
msgid "いや……まずは賊の討伐といこうか。"
msgstr "不……先讨伐贼吧。"

#. ID 16, Page 17, Line 346, Pos (24,15)
msgid ""
"ハッ！\n"
"やってやろうじゃないか。\n"
"タダじゃ死なねえ、貴様らも道連れだ。"
msgstr "哈！那就来吧。我可不会白死，你们也一起陪葬。"

#. ID 16, Page 17, Line 354, Pos (24,15)
msgid ""
"旦那様、お待ち下さい。男はともかく\n"
"DDやあの女は厄介です。まともに戦えば\n"
"手痛い代償を受けるやもしれません。"
msgstr ""
"老爷，请等一下。男人暂且不论，\n"
"DD和那个女人很棘手。若正面交战，\n"
"可能会付出惨痛代价。"

#. ID 16, Page 17, Line 358, Pos (24,15)
msgid "………………………………"
msgstr "………………………………"

#. ID 16, Page 17, Line 361, Pos (24,15)
msgid "ふふん……それで？"
msgstr "哼哼……所以呢？"

#. ID 16, Page 17, Line 364, Pos (24,15)
msgid ""
"すでに策は用意してございます。\n"
"\n"
"…………おい。"
msgstr "已经准备好了计策。……喂。"

#. ID 16, Page 17, Line 369, Pos (24,15)
msgid "＊：へい。"
msgstr "＊：是。"

#. ID 16, Page 17, Line 376, Pos (24,15)
msgid "痛……これは………いったい…………"
msgstr "痛……这是……到底……"

#. ID 16, Page 17, Line 379, Pos (24,15)
msgid ""
"獄長、てめえもか。\n"
"いや、それより………あいつは……"
msgstr "狱长，你也是吗。不，比起那个………那家伙是……"

#. ID 16, Page 17, Line 382, Pos (24,15)
msgid ""
"デイジー……\n"
"この畜生が………………"
msgstr "黛西……这个畜生………………"

#. ID 16, Page 17, Line 388, Pos (24,15)
msgid "彼女に向かって攻撃するのです。"
msgstr "朝她攻击。"

#. ID 16, Page 17, Line 390, Pos (24,15)
msgid "はあ！？なんで…あいつ関係ねえじゃん！"
msgstr "哈！？为什么…那家伙没关系吧！"

#. ID 16, Page 17, Line 397, Pos (24,15)
msgid "よくわかんねえけど……"
msgstr "虽然搞不太懂……"

#. ID 16, Page 17, Line 403, Pos (24,15)
msgid "やってみようか。"
msgstr "那就试试看吧。"

#. ID 16, Page 17, Line 406, Pos (24,15)
msgid ""
"おいおい、やめろよ…\n"
"そいつは関係ねえだろうが…"
msgstr "喂喂，住手啊…那家伙没关系吧…"

#. ID 16, Page 17, Line 410, Pos (24,15)
msgid "そいつはやってみりゃわかるさ！！"
msgstr "那家伙试试看就知道了！！"

#. ID 16, Page 17, Line 426, Pos (24,15)
msgid "わっ！"
msgstr "哇！"

#. ID 16, Page 17, Line 429, Pos (24,15)
msgid "＊：ぎゃあ！！"
msgstr "＊：呀啊！！"

#. ID 16, Page 17, Line 433, Pos (24,15)
msgid ""
"おっといけねえ。\n"
"あいつは本当に関係なかったな。"
msgstr "哎呀糟了。那家伙真的没关系啊。"

#. ID 16, Page 17, Line 440, Pos (24,15)
msgid ""
"獄長！！\n"
"………と、DD！？\n"
"なんで……"
msgstr "狱长！！………还有，DD！？为什么……"

#. ID 16, Page 17, Line 451, Pos (24,15)
msgid "ほう……"
msgstr "嚯……"

#. ID 16, Page 17, Line 454, Pos (24,15)
msgid "……やってくれる…………"
msgstr "……真敢干啊…………"

#. ID 16, Page 17, Line 457, Pos (24,15)
msgid ""
"えっ……？\n"
"どうして…………"
msgstr "诶……？为什么…………"

#. ID 16, Page 17, Line 461, Pos (24,15)
msgid ""
"どうして、ですか。\n"
"…ククク、まだ言ってなかったんですか。"
msgstr "为什么，吗。…呵呵呵，还没说吗。"

#. ID 16, Page 17, Line 464, Pos (24,15)
msgid "な…なにを？"
msgstr "什…什么？"

#. ID 16, Page 17, Line 466, Pos (24,15)
msgid "まあ、たいしたことでもありませんよ。"
msgstr "嘛，也不是什么大不了的事。"

#. ID 16, Page 17, Line 470, Pos (24,15)
msgid ""
"私の初めてを奪ったこの人が……\n"
"私を庇って……今度は……今度は何が目的\n"
"なの…………？"
msgstr ""
"夺走我第一次的这个人……却护着我……这次是……\n"
"这次又是什么目的…………？"

#. ID 16, Page 17, Line 475, Pos (24,15)
msgid ""
"フフフ……\n"
"さあ……て……ね…………"
msgstr "呵呵呵……谁知道呢……然后……呢…………"

#. ID 16, Page 17, Line 478, Pos (24,15)
msgid ""
"わかんないよ！！\n"
"あなた……敵なんでしょう！？\n"
"私を……奪ったり……守ったり……………"
msgstr ""
"我不懂啊！！你……是敌人吧！？却……夺走我……\n"
"又保护我……………"

#. ID 16, Page 17, Line 481, Pos (24,15)
msgid ""
"私の居場所……こんなにして………\n"
"また……奪って…………"
msgstr "我的容身之处……弄成这样………又……夺走…………"

#. ID 16, Page 17, Line 483, Pos (24,15)
msgid "あなた……一体なんなの………"
msgstr "你……到底是什么啊………"

#. ID 16, Page 17, Line 486, Pos (24,15)
msgid ""
"何を悩んでいるのやら……\n"
"敵だよ……憎い憎いお前の仇さ…………"
msgstr ""
"有什么好烦恼的……我是敌人啊……\n"
"是你无比憎恨的仇人…………"

#. ID 16, Page 17, Line 490, Pos (24,15)
msgid ""
"嘘よ！！\n"
"じゃあ……あなたはなんでそんなに\n"
"血まみれなの？"
msgstr "骗人！！那……你为什么浑身是血？"

#. ID 16, Page 17, Line 495, Pos (24,15)
msgid ""
"そんな疑問を持つなよ……これは……\n"
"……………お前の望んだことじゃないか。"
msgstr "别问那种问题……这是…………………不就是你所希望的吗？"

#. ID 16, Page 17, Line 498, Pos (24,15)
msgid "何言ってるの！？こんなこと……"
msgstr "你在说什么啊！？这种事……"

#. ID 16, Page 17, Line 500, Pos (24,15)
#. ID 16, Page 17, Line 507, Pos (24,15)
msgid "…………………………"
msgstr "…………………………"

#. ID 16, Page 17, Line 503, Pos (24,15)
msgid ""
"ご覧の通りです。あの青服の方を狙えば\n"
"確実にDDに当たります。顔立ちは似てます\n"
"から、お間違いのないように……"
msgstr ""
"如您所见。只要瞄准那个穿蓝衣服的，\n"
"就一定能击中DD。因为面容相似，请别弄错……"

#. ID 16, Page 17, Line 510, Pos (24,15)
msgid "あのクソ野郎……！！"
msgstr "那个混蛋……！！"

#. ID 16, Page 17, Line 517, Pos (24,15)
msgid "おっと、先に死にたいのかしら？"
msgstr "哎呀，想先死吗？"

#. ID 16, Page 17, Line 524, Pos (24,15)
msgid ""
"よくわからんけど、あのひょろい方を\n"
"狙えばいいんだな？"
msgstr "虽然不太明白，瞄准那个瘦弱的人就行了吧？"

#. ID 16, Page 17, Line 544, Pos (24,15)
msgid ""
"本当だ、全く避けねえ！！！\n"
"こりゃいいぜ！！！"
msgstr "真的诶，完全不会躲！！！这可太爽了！！！"

#. ID 16, Page 17, Line 563, Pos (24,15)
#. ID 16, Page 17, Line 676, Pos (24,15)
msgid "くっ……"
msgstr "唔……"

#. ID 16, Page 17, Line 565, Pos (24,15)
msgid ""
"もうやめて！！\n"
"死んじゃうよ！！！"
msgstr "快住手！！会死的啊！！！"

#. ID 16, Page 17, Line 577, Pos (24,15)
msgid ""
"あははははははははははははは！！\n"
"どうした！よけらんねえのかよ！！！！\n"
"愛って奴は最高だな！！！"
msgstr ""
"啊哈哈哈哈哈哈哈哈哈哈哈！！怎么了！躲不开吗！\n"
"！！！所谓爱真是太棒了！！！"

#. ID 16, Page 17, Line 605, Pos (24,15)
msgid "あ……かは…………"
msgstr "啊……喀哈…………"

#. ID 16, Page 17, Line 608, Pos (24,15)
msgid ""
"どうして……あなた……\n"
"……どうしてそこまで…………"
msgstr "为什么……你…………为什么要做到这种地步…………"

#. ID 16, Page 17, Line 612, Pos (24,15)
msgid "デイジー……そんな悲しい顔するなよ……"
msgstr "黛西……别露出那么悲伤的表情啊……"

#. ID 16, Page 17, Line 614, Pos (24,15)
msgid "えっ？"
msgstr "诶？"

#. ID 16, Page 17, Line 616, Pos (24,15)
msgid ""
"お前の……仇が…………お前の親を殺し…\n"
"……お前を……弄んだ仇が………今まさに\n"
"死のうとしているんだ………"
msgstr ""
"你的……仇人…………杀了你父母………玩弄了你的仇人………\n"
"现在正要死了………"

#. ID 16, Page 17, Line 620, Pos (24,15)
msgid ""
"もっと……喜べよ……\n"
"……そんな顔するなって………"
msgstr "再多……高兴点啊…………别露出那种表情啊………"

#. ID 16, Page 17, Line 624, Pos (24,15)
msgid ""
"違う……こんなの………\n"
"こんなの違うよ！！！"
msgstr "不对……这种事………这种事不对啊！！！"

#. ID 16, Page 17, Line 628, Pos (24,15)
msgid ""
"デイジー……やっぱり………お前は………\n"
"仇討ちなんて……向かないよ……"
msgstr "黛西……果然………你………不适合……复仇啊……"

#. ID 16, Page 17, Line 632, Pos (24,15)
msgid ""
"どこかで……平和に………\n"
"健やかに………暮らせばよかったんだ……"
msgstr "要是在哪里……平静地………健康地………生活就好了……"

#. ID 16, Page 17, Line 635, Pos (24,15)
msgid ""
"ごめんよ………\n"
"…こんなことになっちまって………"
msgstr "对不起啊…………事情变成这样………"

#. ID 16, Page 17, Line 638, Pos (24,15)
msgid ""
"なに言ってるの………\n"
"あなた………なんで謝るのよ………？"
msgstr "你在说什么啊………你………为什么要道歉啊………？"

#. ID 16, Page 17, Line 641, Pos (24,15)
msgid ""
"ダメだよ……よくわからないけど……\n"
"私のために………死ぬなんて……\n"
"生きてよ………！！！"
msgstr ""
"不行啊……虽然不太明白……但为了我………去死什么的……\n"
"活下去啊………！！！"

#. ID 16, Page 17, Line 646, Pos (24,15)
msgid ""
"よく粘ったけど、これでトドメだ！！\n"
"死ね！！！"
msgstr "你还挺能撑的，但就这样结束了！！去死吧！！！"

#. ID 16, Page 17, Line 650, Pos (24,15)
msgid "させ………ない！！"
msgstr "不会让你………得逞的！！"

#. ID 16, Page 17, Line 655, Pos (24,15)
msgid "ぎゃっ！"
msgstr "呀啊！"

#. ID 16, Page 17, Line 662, Pos (24,15)
msgid "ありゃりゃ…死体が一つ増えちまったな。"
msgstr "哎呀呀…尸体又多了一具啊。"

#. ID 16, Page 17, Line 667, Pos (24,15)
msgid "こいつ、まだそんな力が……！！"
msgstr "这家伙，还有那种力气……！！"

#. ID 16, Page 17, Line 679, Pos (24,15)
msgid ""
"どうやらとっとと死にたいらしいな……\n"
"オイ！お前ら、もう十分だ。\n"
"皆殺しにしちまえ！！！"
msgstr ""
"看来是想赶快死啊……喂！你们，已经够了。\n"
"把他们都杀光！！！"

#. ID 16, Page 17, Line 685, Pos (24,15)
msgid "なんだい、随分と物騒な声が聞こえるねぇ"
msgstr "怎么回事，听到了相当危险的声音啊。"

#. ID 16, Page 17, Line 695, Pos (24,15)
msgid ""
"大丈夫かいDD？\n"
"君ともあろう者がなんて姿だ。"
msgstr "你没事吧，DD？像你这样的人怎么会弄成这副样子。"

#. ID 16, Page 17, Line 699, Pos (24,15)
msgid "その声……みどりさん？"
msgstr "那个声音……绿小姐？"

#. ID 16, Page 17, Line 701, Pos (24,15)
msgid ""
"見えてないのかい？\n"
"まぁ、退けないのもわかるけどさ……\n"
"あんたならどうとでもなったろう？"
msgstr ""
"看不见吗？嘛，我明白你不肯退……但要是你的话，\n"
"怎么都能应付吧？"

#. ID 16, Page 17, Line 706, Pos (24,15)
msgid "あなた……この人のこと知ってるの！？"
msgstr "你……认识这个人吗！？"

#. ID 16, Page 17, Line 709, Pos (24,15)
msgid ""
"ん？この人って……？\n"
"…ああ、まあ同じ釜の飯を食った仲さね。"
msgstr ""
"嗯？这个人……？…啊，嘛，\n"
"算是同吃过一锅饭的同伴吧。"

#. ID 16, Page 17, Line 711, Pos (24,15)
msgid "しっかしあんたも強情だねえ。"
msgstr "不过你也真是固执啊。"

#. ID 16, Page 17, Line 713, Pos (24,15)
msgid ""
"フ…フフフ……よりドラマチックな展開を\n"
"求めていただけですよ……"
msgstr "呵…呵呵呵……只是想要更戏剧性的发展而已啊……"

#. ID 16, Page 17, Line 716, Pos (24,15)
msgid ""
"あんたが軽口叩くのは切羽詰まってる時の\n"
"癖だねえ……\n"
"下がってなよ。"
msgstr "你爱耍嘴皮子，是走投无路时的习惯啊……退下吧。"

#. ID 16, Page 17, Line 731, Pos (24,15)
msgid "あなたはそちらに付くのですか……"
msgstr "你要站在那边吗……"

#. ID 16, Page 17, Line 734, Pos (24,15)
msgid ""
"どっちも何もないね。\n"
"妹分や職場を好き勝手してくれちゃって…"
msgstr ""
"两边都没什么区别。\n"
"竟敢对我的妹妹和职场为所欲为……"

#. ID 16, Page 17, Line 738, Pos (24,15)
msgid ""
"しかし、のこのこ帰って来てあなたに\n"
"何ができるというのですか。すでに………\n"
"全てが手遅れですよ……"
msgstr ""
"可是，你这么厚着脸皮回来，又能做什么呢。已经……\n"
"…一切都太迟了啊……"

#. ID 16, Page 17, Line 743, Pos (24,15)
msgid ""
"プププ……\n"
"スパイの羊さん、\n"
"そりゃお互い様なんじゃないかい？"
msgstr "噗噗噗……间谍羊，那彼此彼此吧？"

#. ID 16, Page 17, Line 748, Pos (24,15)
msgid "………何を言っているんです？"
msgstr "………你在说什么？"

#. ID 16, Page 17, Line 750, Pos (24,15)
msgid ""
"私が都から帰って来るの、\n"
"ちょっと早すぎるとは思わないかい？"
msgstr "你不觉得我从都城回来得有点太早了吗？"

#. ID 16, Page 17, Line 754, Pos (24,15)
msgid "まさか……"
msgstr "难道说……"

#. ID 16, Page 17, Line 756, Pos (24,15)
msgid ""
"密告してやったよ\n"
"軍曹、もうじき戻って来る。料理長もね。"
msgstr "我去告密了哦，军曹，他快回来了。厨师长也是。"

#. ID 16, Page 17, Line 759, Pos (24,15)
msgid "このアマ……！！！"
msgstr "这臭女人……！！！"

#. ID 16, Page 17, Line 761, Pos (24,15)
msgid ""
"人間様を舐めるからそうなるのさ！！\n"
"いい気味だ！！！"
msgstr "就是因为小看人类大人才会这样！！活该！！！"

#. ID 16, Page 17, Line 765, Pos (24,15)
msgid ""
"くそ……その兵士は絶対に殺せ！！！\n"
"皆殺しだ！！！"
msgstr "可恶……那个士兵绝对要杀掉！！！全部杀光！！！"

#. ID 16, Page 17, Line 771, Pos (24,15)
msgid ""
"あんたたち！！\n"
"こいつらは私が引き受けるから、とっとと\n"
"ずらかんな！！！"
msgstr "你们！！这些家伙我来对付，赶快给我溜！！！"

#. ID 16, Page 17, Line 775, Pos (24,15)
msgid "！！！"
msgstr "！！！"

#. ID 16, Page 17, Line 777, Pos (24,15)
#. Contains choice at line 2 (3 options)
msgid "どうする？"
msgstr "怎么办？"

#. ID 16, Page 17, Line 778, Pos (24,15)
#. Choice (3 options, embedded in a message)
msgid ""
"ここで伯爵をぶちのめす\n"
"言うとおり逃げる\n"
"敵に寝返る"
msgstr ""
"在此痛扁伯爵\n"
"按他说的逃跑\n"
"倒戈投敌"

#. ID 16, Page 17, Line 784, Pos (24,15)
msgid "おい、あんた、逃げなって…………"
msgstr "喂，你，快逃啊…………"

#. ID 16, Page 17, Line 790, Pos (24,15)
msgid ""
"加勢するぜ。\n"
"飛び入りや古株にばっかりいい顔させらん\n"
"ねえって。"
msgstr "我来帮忙。总不能只让新来的和老资格的出风头吧。"

#. ID 16, Page 17, Line 795, Pos (24,15)
msgid "おうおう、坊やまで……"
msgstr "哦哦，连小鬼也来了……"

#. ID 16, Page 17, Line 798, Pos (24,15)
msgid ""
"わかったよ……ここで幕引きにしてやろう\n"
"じゃないのさ。"
msgstr "知道了……就在这里落幕吧。"

#. ID 16, Page 17, Line 802, Pos (24,15)
msgid "手っ取り早いね。"
msgstr "真直截了当啊。"

#. ID 16, Page 17, Line 804, Pos (24,15)
msgid ""
"おもしれえ……\n"
"返り討ちにしてやんよ！！"
msgstr "有意思……我要反杀你们！！"

#. ID 16, Page 17, Line 831, Pos (24,15)
msgid "覚えていやがれ！"
msgstr "给我记住了！"

#. ID 16, Page 17, Line 842, Pos (24,15)
#. Contains choice at line 2 (2 options)
msgid "置き土産に血祭りにあげますか？"
msgstr "要作为临别礼物把他们血祭掉吗？"

#. ID 16, Page 17, Line 843, Pos (24,15)
#. Choice (2 options, embedded in a message)
msgid ""
"血祭りだ\n"
"そんな暇はない"
msgstr ""
"血祭\n"
"没那个闲工夫"

#. ID 16, Page 17, Line 846, Pos (24,15)
msgid "ぎゃっ！？"
msgstr "呀啊！？"

#. ID 16, Page 17, Line 862, Pos (24,15)
msgid "しかし３対１……勝てるとお思いですか？"
msgstr "但是3对1……您觉得能赢吗？"

#. ID 16, Page 17, Line 865, Pos (24,15)
msgid "どうだろうねえ……"
msgstr "难说呢……"

#. ID 16, Page 17, Line 868, Pos (24,15)
msgid "ふん……見え見えのハッタリだね。"
msgstr "哼……这种虚张声势也太明显了。"

#. ID 16, Page 17, Line 871, Pos (24,15)
msgid ""
"レイプだレイプ！\n"
"一方的にズタボロにしてやんよ！！"
msgstr "强奸啊强奸！我要单方面把你们打得稀巴烂！！"

#. ID 16, Page 17, Line 879, Pos (24,15)
msgid ""
"さっさと片付けろ。\n"
"大丈夫、奴らが来る前に魔神を見つければいいんだ。\n"
"あいつらはその後でどうにでもできる。"
msgstr ""
"赶紧解决掉。没关系，\n"
"只要在他们来之前找到魔神就行了。\n"
"那些家伙之后怎样都行。"

#. ID 16, Page 17, Line 884, Pos (24,15)
msgid ""
"……のらりくらりが信条の私が、\n"
"ヤキが回ったもんだねえ…………"
msgstr ""
"……像我这种以圆滑敷衍为信条的人，\n"
"也真是老糊涂了呢…………"

#. ID 16, Page 17, Line 906, Pos (24,15)
#. ID 20, Page 1, Line 45, Pos (0,2)
msgid "がっ……"
msgstr "呃……"

#. ID 16, Page 17, Line 914, Pos (24,15)
msgid ""
"あんたはそっちに付くのかい……\n"
"６対１か……厳しいかもねえ。\n"
"昔観た寸劇の怪人だって５対１だったよ。"
msgstr ""
"你也要站到那边吗……6对1啊……也许会很艰难呢。\n"
"以前看过的短剧里的怪人也是5对1哦。"

#. ID 16, Page 17, Line 921, Pos (24,15)
msgid ""
"みどりさん１人を\n"
"残していけませんよ……"
msgstr "不能把绿小姐一个人留下啊……"

#. ID 16, Page 17, Line 928, Pos (24,15)
msgid ""
"ご加護を失ったとはいえ、私は僧侶です。\n"
"ここで退くことなんてできません………！"
msgstr ""
"就算失去了庇佑，我也仍是僧侣。\n"
"我不可能在这里退缩………！"

#. ID 16, Page 17, Line 938, Pos (24,15)
msgid "私だって……まだ戦える…………"
msgstr "我也……还能战斗…………"

#. ID 16, Page 17, Line 941, Pos (24,15)
msgid "あんたたち……"
msgstr "你们……"

#. ID 16, Page 17, Line 943, Pos (24,15)
msgid ""
"わかったよ…\n"
"やろうじゃないか！！"
msgstr "明白了……那就干吧！！"

#. ID 20, Page 1, Line 4, Pos (0,2)
#. Contains choice at line 3 (2 options)
msgid ""
"どうしたのですか？\n"
"こんなところで……"
msgstr "怎么了？在这种地方……"

#. ID 20, Page 1, Line 7, Pos (0,2)
#. Choice (2 options, embedded in a message)
msgid ""
"お前が犯人だ！\n"
"もう逃げられないぞ！"
msgstr ""
"你就是犯人！\n"
"你已经逃不掉了！"

#. ID 20, Page 1, Line 14, Pos (0,2)
msgid "な……何を言って……！？"
msgstr "什……你在说什么……！？"

#. ID 20, Page 1, Line 16, Pos (0,2)
msgid "その通りだ。"
msgstr "没错。"

#. ID 20, Page 1, Line 24, Pos (0,2)
msgid ""
"お前が金庫を漁るのを\n"
"こいつが見ていたんだ。\n"
"私に教えてくれたよ。"
msgstr "你翻找金库的时候，这家伙看见了。他告诉了我。"

#. ID 20, Page 1, Line 28, Pos (0,2)
msgid ""
"そんな、わ……私は…………\n"
"こうなったら……"
msgstr "怎么会，我……我…………事到如今……"

#. ID 20, Page 1, Line 31, Pos (0,2)
msgid "さあ、神妙にしな！！"
msgstr "来吧，老老实实伏法吧！！"

#. ID 20, Page 1, Line 35, Pos (0,2)
msgid "ぐぅ……この…………"
msgstr "咕……你这…………"

#. ID 20, Page 1, Line 38, Pos (0,2)
msgid "今だ。"
msgstr "就是现在。"

#. ID 20, Page 1, Line 54, Pos (0,2)
msgid ""
"ふう……寿命が縮まりましたよ。\\!\n"
"こういうことは前もって言っておいて\n"
"ください……"
msgstr "呼……我都要折寿了。\\!这种事请事先跟我说一声……"

#. ID 20, Page 1, Line 58, Pos (0,2)
msgid ""
"ともあれ、見事なお手並みでした。\n"
"こいつも姉のように、\n"
"よろしくお願いします。"
msgstr "总之，干得漂亮。这家伙也像姐姐一样，请多关照。"

#. ID 25, Page 1, Line 1, Pos (21,11)
msgid "どうなってやがる…"
msgstr "这到底是怎么回事……"

#. ID 25, Page 3, Line 2, Pos (21,11)
msgid ""
"おやおや、あんな奴にも助けに来てくれる\n"
"人がいるんだねえ…"
msgstr "哎呀哎呀，那种家伙居然也有人来救他啊……"

#. ID 26, Page 1, Line 1, Pos (13,11)
msgid "これは……"
msgstr "这是……"

#. ID 26, Page 3, Line 2, Pos (13,11)
msgid "なんだお前、あいつらの仲間か？"
msgstr "你是什么人，是那帮家伙的同伙吗？"

#. ID 26, Page 3, Line 4, Pos (13,11)
msgid ""
"いいぜ？\n"
"相手になってやるよリベンジ野郎！"
msgstr "好啊？我就来会会你，复仇小子！"

#. ID 27, Page 1, Line 2, Pos (27,15)
msgid "これって、もう勝負決まってねえか？"
msgstr "这胜负不已经分出来了吗？"

#. ID 61, Page 1, Line 2, Pos (3,25)
msgid ""
"どんな敵が来ようが我らブライが粉砕して\n"
"くれようぞ！"
msgstr "不管什么样的敌人来，我们布莱一门都会将其粉碎！"

#. ID 62, Page 1, Line 4, Pos (3,24)
#. ID 63, Page 1, Line 4, Pos (3,26)
#. ID 64, Page 1, Line 4, Pos (3,27)
msgid "この先は清掃中だ。"
msgstr "前方正在清扫。"

#. ID 66, Page 1, Line 2, Pos (9,24)
msgid "……みどりさん。"
msgstr "……绿小姐。"
