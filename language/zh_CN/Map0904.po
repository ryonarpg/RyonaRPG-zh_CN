#. ID 78, Page 2, Line 21, Pos (0,14)
msgid "へへへ…じゃぁ、楽しませてもらうぜ？"
msgstr "嘿嘿嘿…那么，让我享受一下吧？"

#. ID 78, Page 2, Line 26, Pos (0,14)
msgid "へへ…じゃ、よろしく頼むぜ？"
msgstr "嘿嘿…那么，拜托了？"

#. ID 78, Page 2, Line 31, Pos (0,14)
msgid "ふふふ…じゃあ、始めようか？"
msgstr "呵呵呵…那么，开始吧？"

#. ID 78, Page 2, Line 101, Pos (0,14)
msgid ""
"ぜはぁーっ\\.、ぜはぁーっ\\.、くぅぅ～～\\.、\n"
"は、はぁ、すげぇ…、良すぎる、だろ…？"
msgstr ""
"呼哈—\\.，呼哈—\\.，唔～\\.，哈、哈啊，太厉害了…，舒服\n"
"　过头了吧…？"

#. ID 78, Page 2, Line 103, Pos (0,14)
msgid "も、もう、出ねえや……へへ……"
msgstr "已、已经，出不来了……嘿嘿……"

#. ID 78, Page 2, Line 105, Pos (0,14)
msgid ""
"金があったら、また、頼むわ…はぁ…\n"
"ちょっと、休ませてくれ…"
msgstr "有钱的话，还会再拜托你…哈啊…让我稍微休息一下…"

#. ID 78, Page 2, Line 113, Pos (0,14)
msgid ""
"はぁ～～～～～～…、えがったぁ……\n"
"\\.最高に具合いいわ、お前のまんこ……"
msgstr ""
"哈啊～～～～～～…，真爽啊……\\.最舒服了，\n"
"你的小穴……"

#. ID 78, Page 2, Line 116, Pos (0,14)
msgid ""
"金があったら、また、頼むよ…へへ…\n"
"よかったぜ、お前…"
msgstr "有钱的话，还会拜托你…嘿嘿…真不错啊，你…"

#. ID 78, Page 2, Line 120, Pos (0,14)
msgid ""
"また気が向いたらよ、頼むよ…へへ…\n"
"よかったぜ、お前…"
msgstr "等我有心情了，还会拜托你…嘿嘿…真不错啊，你…"

#. ID 78, Page 2, Line 128, Pos (0,14)
msgid ""
"ふぅ～～～～……すっきりしたぜ。\n"
"\\.なかなか良かったぜ？お前の中よぉ…"
msgstr "呼～～～～……爽了。\\.还挺不错的哦？你的里面啊…"

#. ID 78, Page 2, Line 131, Pos (0,14)
msgid ""
"じゃ、またな。\n"
"金ができたら、また頼むかもしれねぇなぁ。\n"
"よろしくな？"
msgstr ""
"那么，再见。等有钱了，可能还会再拜托你。\n"
"多关照哦？"

#. ID 78, Page 2, Line 136, Pos (0,14)
#. ID 78, Page 2, Line 204, Pos (0,14)
msgid "じゃ、また。気が向いたらよろしくな……"
msgstr "那么，再见。有心情的话就拜托了……"

#. ID 78, Page 2, Line 143, Pos (0,14)
msgid ""
"ふぅ……ま、こんなもんか？\n"
"\\.いまいち乗れなかったが、まぁ、いいか…"
msgstr "呼……嘛，就这样吧？\\.不太尽兴，不过，算了…"

#. ID 78, Page 2, Line 146, Pos (0,14)
msgid ""
"じゃあな、ま、大して良くなかったから\n"
"ギャラはこんなもんだな…"
msgstr "那就这样吧，嘛，因为也没多好，报酬就这么多吧…"

#. ID 78, Page 2, Line 153, Pos (0,14)
msgid "はぁ…まぁ出すもんは出したけどよぉ……"
msgstr "哈啊…嘛，该出的也出了……"

#. ID 78, Page 2, Line 156, Pos (0,14)
msgid "これで金取んのかぁ？詐欺だぞ、おい。"
msgstr "这样还收钱吗？这是诈骗啊，喂。"

#. ID 78, Page 2, Line 159, Pos (0,14)
msgid ""
"こんなんじゃ、金は払えねえな。\n"
"ほれ、とっとと失せろよ。便所にされねぇだけ、\n"
"マシだと思いやがれ。"
msgstr ""
"这样的话，我可付不了钱。喏，赶紧滚开。\n"
"没被当成厕所用，你就该觉得走运了。"

#. ID 78, Page 2, Line 170, Pos (0,14)
msgid ""
"はぁーっ\\.、はぁーっ\\.、もうだめだ\\.、\n"
"もう、出ねえ……"
msgstr ""
"哈啊—\\.，哈啊—\\.，已经不行了\\.，已经，\n"
"出不来了……"

#. ID 78, Page 2, Line 172, Pos (0,14)
msgid ""
"一滴残らず、絞り尽くされたわぁ…\n"
"はーーっ、良かった……"
msgstr "一滴不剩，被榨干了…哈——，真舒服……"

#. ID 78, Page 2, Line 175, Pos (0,14)
msgid ""
"金があったら、また、頼むわ……\n"
"うぅ、ちょっと、休ませてくれ…"
msgstr "有钱的话，还会拜托你……呜呜，让我稍微休息一下…"

#. ID 78, Page 2, Line 183, Pos (0,14)
msgid ""
"はぁ～～～～～～…、えがったぁ……\n"
"\\.最高だわ、すげえ良かった……"
msgstr ""
"哈啊～～～～～～…，真爽啊……\\.最棒了，太舒服了…\n"
"…"

#. ID 78, Page 2, Line 185, Pos (0,14)
msgid "満足だわ……"
msgstr "满足了……"

#. ID 78, Page 2, Line 187, Pos (0,14)
msgid "金があったら、また、頼むよ…"
msgstr "有钱的话，还会拜托你…"

#. ID 78, Page 2, Line 190, Pos (0,14)
msgid "また気が向いたらさ、頼むよ…"
msgstr "等我有心情了，再拜托你…"

#. ID 78, Page 2, Line 197, Pos (0,14)
msgid ""
"ふぅ……\n"
"\\.良かったぜぇ、やっぱ貧乳はいいわ…"
msgstr "呼……\\.真不错啊，果然贫乳就是好…"

#. ID 78, Page 2, Line 200, Pos (0,14)
msgid ""
"金ができたら、また頼むわ…\n"
"じゃ、またな。"
msgstr "等有钱了，还会拜托你…那么，再见。"

#. ID 78, Page 2, Line 211, Pos (0,14)
msgid ""
"ふぅ……ま、良かったよ。\n"
"\\.あんま乱れないよな？でも、やっぱ\n"
"めちゃくちゃに感じてくれた方が男は嬉しいぜ。"
msgstr ""
"呼……嘛，不错啊。\\.不太放得开吧？不过，\n"
"果然还是疯狂感受到高潮的话男人更开心。"

#. ID 78, Page 2, Line 215, Pos (0,14)
msgid ""
"客のためにも、もっといやらしい女に\n"
"なってくれよ…じゃなー。"
msgstr "为了客人，也变成更淫荡的女人吧…再见—。"

#. ID 78, Page 2, Line 219, Pos (0,14)
msgid "…俺が下手な訳じゃねーよな？"
msgstr "…不是我技术差吧？"

#. ID 78, Page 2, Line 225, Pos (0,14)
msgid ""
"ふぅ……あー、うーん、まぁ…なんだ…\n"
"もっとやる気出せよ…"
msgstr "呼……啊—，嗯，嘛…那个…再多点干劲啊…"

#. ID 78, Page 2, Line 229, Pos (0,14)
msgid ""
"これで金取んのはなぁ…ボッタクリって\n"
"もんだぜ…"
msgstr "这样还收钱啊…这是宰客啊…"

#. ID 78, Page 2, Line 233, Pos (0,14)
msgid ""
"まぁ、黒なんかこんなもんか？\n"
"あーあ、期待して損したぜ…"
msgstr "嘛，黑之女也就这样吧？啊—啊，白期待了…"

#. ID 78, Page 2, Line 243, Pos (0,14)
msgid ""
"ぐ\\.、ふぅっ…\\.、ふぅっ…\\.、はぁ…\\.、\n"
"素晴らしい、これは、最高の、\n"
"掘り出し物だ…"
msgstr ""
"唔\\.，呼…\\.，呼…\\.，哈啊…\\.，太棒了，这是，\n"
"最棒的，意外收获…"

#. ID 78, Page 2, Line 246, Pos (0,14)
msgid ""
"裏通りの、奥まで…理想のコ、を、\n"
"捜しにきた甲斐があったよ…"
msgstr "到小巷的，深处…来找理想的女孩，真是没白来…"

#. ID 78, Page 2, Line 248, Pos (0,14)
msgid ""
"今度も是非、またお願いする……\n"
"\\.あぁ…、疲れた…\n"
"少し、休ませてくれ…"
msgstr ""
"下次也务必，再拜托你……\\.啊啊…，累了…让我稍微，\n"
"休息一下…"

#. ID 78, Page 2, Line 255, Pos (0,14)
msgid ""
"はぁ、はぁ…ふぅ、素晴らしい……\n"
"\\.とても、良かったよ……"
msgstr "哈啊，哈啊…呼，太棒了……\\.非常，好哦……"

#. ID 78, Page 2, Line 257, Pos (0,14)
msgid ""
"やはり、表に出て、いないからといって…\n"
"不良品とは、限らない、な…"
msgstr "果然，没出现在台面上…也不一定就是，次品啊…"

#. ID 78, Page 2, Line 259, Pos (0,14)
msgid "良ければ、またお願いしたいな…"
msgstr "可以的话，还想再拜托你…"

#. ID 78, Page 2, Line 264, Pos (0,14)
msgid ""
"ふぅ……\n"
"\\.良かったよ、君の、中は…"
msgstr "呼……\\.真不错啊，你的，里面…"

#. ID 78, Page 2, Line 266, Pos (0,14)
msgid ""
"ふぅ…機会があれば、また\n"
"お願いする…"
msgstr "呼…有机会的话，还会再拜托你…"

#. ID 78, Page 2, Line 272, Pos (0,14)
msgid ""
"ふぅ……\n"
"\\.まぁ、こんなものか…"
msgstr "呼……\\.嘛，就这样吧…"

#. ID 78, Page 2, Line 274, Pos (0,14)
msgid ""
"では…私はこれで失礼するよ…\n"
"機会があれば、また頼むこともあるだろう…"
msgstr ""
"那么…我就此告辞了…有机会的话，\n"
"可能还会再拜托你…"

#. ID 78, Page 2, Line 279, Pos (0,14)
msgid "ふぅ……うぅむ…"
msgstr "呼……唔嗯…"

#. ID 78, Page 2, Line 280, Pos (0,14)
msgid "では…私はこれで失礼する…"
msgstr "那么…我就此告辞了…"

#. ID 78, Page 2, Line 324, Pos (0,14)
msgid ""
"\n"
"お金を払って貰えなかった…"
msgstr "没能收到金钱…"

#. ID 78, Page 2, Line 339, Pos (0,14)
msgid ""
"\n"
"\\V[1164]Ｇ稼いだ。"
msgstr "\\V[1164]G赚到了。"

#. ID 78, Page 2, Line 348, Pos (0,14)
msgid ""
"\n"
"今日はもうこれ以上お仕事はできないようだ…"
msgstr "今天好像已经不能再继续工作了…"

#. ID 78, Page 2, Line 357, Pos (0,14)
msgid "行為の後、お客がプレゼントをくれた。"
msgstr "行为之后，客人送了我礼物。"

#. ID 78, Page 2, Line 363, Pos (0,14)
msgid "\\N[101]\\N[102]\\N[103]\\N[104]を手に入れた。"
msgstr "\\N[101]\\N[102]\\N[103]\\N[104]到手了。"
