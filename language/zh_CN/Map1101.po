#. ID 56, Page 2, Line 185, Pos (15,6)
msgid "住む場所に困ってるようだ……どうしよう？"
msgstr "好像正为住处发愁……怎么办？"

#. ID 56, Page 2, Line 191, Pos (15,6)
#. Choice (3 options)
msgid ""
"フェリスの町について教える\n"
"首輪を外してから町を教える\n"
"そのまま別れる"
msgstr ""
"告诉关于费利斯镇的事\n"
"摘下项圈后再告诉镇的事\n"
"就此分别"

#. ID 56, Page 2, Line 195, Pos (15,6)
#. ID 56, Page 2, Line 224, Pos (15,6)
msgid "\\N[\\V[6]]はフェリスの町のことを話した……"
msgstr "\\N[\\V[6]]讲了费利斯镇的事……"

#. ID 56, Page 2, Line 201, Pos (15,6)
msgid ""
"\\N[\\V[6]]は相手の首輪を外しつつ、\n"
"フェリスの町のことを話した……"
msgstr ""
"\\N[\\V[6]]一边解开对方的项圈，\n"
"一边讲了费利斯镇的事……"

#. ID 56, Page 2, Line 209, Pos (15,6)
msgid "首輪を外してあげたくても、鍵を持っていない。"
msgstr "即使想替对方解开项圈，也没有钥匙。"

#. ID 56, Page 2, Line 220, Pos (15,6)
#. Choice (2 options)
msgid ""
"フェリスの町について教える\n"
"そのまま別れる"
msgstr ""
"告诉关于费利斯镇的事\n"
"就此分别"

#. ID 57, Page 1, Line 4, Pos (14,5)
msgid ""
"スティライ\n"
"「エリア移動する？"
msgstr "斯蒂莱「要移动区域吗？"

#. ID 57, Page 1, Line 6, Pos (14,5)
#. Choice (3 options)
msgid ""
"宿へ戻る\n"
"このエリアへもう一度入りなおす\n"
"なんでもない"
msgstr ""
"回旅馆\n"
"再次进入这个区域\n"
"没什么"

#. ID 58, Page 1, Line 4, Pos (16,5)
msgid ""
"フェリス\n"
"「ここは移民の町を作る際の住民たちを\n"
"　集めた場所だ。各グラフィックの確認や\n"
"　加入イベントの作成に使う。"
msgstr ""
"费利斯「这里是制作移民城镇时把居民们　聚集起来\n"
"　的地方。用于确认各图像以及　制作加入事件。"

#. ID 58, Page 1, Line 9, Pos (16,5)
msgid ""
"フェリス\n"
"「私のことは気にするな。ここではお前の\n"
"　作業の見物人でしかないからな。"
msgstr ""
"费利斯「不用在意我。\n"
"在这里我不过是你　工作的旁观者罢了。"

#. ID 58, Page 1, Line 13, Pos (16,5)
msgid ""
"フェリス\n"
"「ただそうだな、データのロストには\n"
"　十分気を付けるがいい。\n"
"　起きてからでは取り返しがつかん。"
msgstr ""
"费利斯「不过说起来，\n"
"对于数据的丢失要　十分小心。\n"
"　等醒来之后就无可挽回了。"
