msgid "５００００Ｇ寄付してくれましたら考えてもいいですよ"
msgstr "如果您捐款50000G，我可以考虑一下哦"

#. ID 16, Page 5, Line 54, Pos (2,10)
#. ID 16, Page 6, Line 53, Pos (2,10)
msgid ""
