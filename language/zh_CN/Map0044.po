#. ID 13, Page 2, Line 4, Pos (8,0)
msgid "＊\\.………引き返している暇はない！"
msgstr "＊\\.………没时间折返了！"

#. ID 29, Page 5, Line 22, Pos (17,0)
msgid "\\.…\\.…\\.…どうやら追いつかれてしまったようだ…"
msgstr "\\.…\\.…\\.…看来还是被追上了…"

#. ID 29, Page 5, Line 25, Pos (17,0)
msgid "…周囲から怪しい気配を感じる…！"
msgstr "…从周围感觉到可疑的气息…！"

#. ID 29, Page 7, Line 24, Pos (17,0)
msgid "＊………"
msgstr "＊………"

#. ID 29, Page 7, Line 31, Pos (17,0)
msgid ""
"＊\\.………駄目だ……\n"
"　蟲が、また集まり始めている。"
msgstr "＊\\.………不行……　虫又开始聚集起来了。"

#. ID 29, Page 7, Line 33, Pos (17,0)
msgid ""
"＊また大きな群れになってしまう前に、\n"
"　早く、ここから離れなければ……"
msgstr "＊在再次变成一大群之前，　必须快点离开这里……"
