#. ID 11, Page 2, Line 3, Pos (10,4)
msgid "せめて、私に理性があるうちに……頼む！"
msgstr "至少，趁我还有理智……拜托了！"

#. ID 40, Page 2, Line 3, Pos (11,28)
msgid "＊女性奴隷拘束衣着脱装置"
msgstr "＊女性奴隶拘束衣穿脱装置"

#. ID 41, Page 2, Line 3, Pos (8,24)
msgid "…………"
msgstr "…………"

#. ID 41, Page 2, Line 4, Pos (8,24)
msgid ""
"＊研究員は\\n[\\v[6]]の下半身に付けられた、\n"
"　貞操帯とその装置を指差した。"
msgstr ""
"＊研究员指了指戴在\\n[\\v[6]]下半身上的、\n"
"　贞操带和那个装置。"

#. ID 41, Page 2, Line 6, Pos (8,24)
msgid ""
"奴隷調教用のスライムに……やられたんだね……\n"
"その装置は……特殊な電子キーがないと外せない……"
msgstr ""
"是被奴隶调教用的史莱姆……弄成这样的吧……\n"
"那个装置……没有特殊的电子钥匙就取不下来……"

#. ID 41, Page 2, Line 8, Pos (8,24)
msgid ""
"この機械を使えば外してあげられるが……\n"
"どうする……？"
msgstr "用这台机器的话可以帮你取下来……要怎么做……？"

#. ID 41, Page 2, Line 11, Pos (8,24)
msgid ""
"おや……\n"
"リモートコントローラを……持っているね"
msgstr "哦呀……你带着……遥控器呢"

#. ID 41, Page 2, Line 13, Pos (8,24)
msgid ""
"外すよりも遥かに省エネルギーで……\n"
"バッテリーを……充電できるけど…するかい？"
msgstr "比取下来要节能得多……可以给电池……充电……要做吗？"

#. ID 41, Page 2, Line 15, Pos (8,24)
#. Choice (3 options)
msgid ""
"充電する\n"
"貞操帯を外してもらう\n"
"無言で立ち去る"
msgstr ""
"充电\n"
"请人取下贞操带\n"
"默默离开"

#. ID 41, Page 2, Line 17, Pos (8,24)
#. ID 41, Page 2, Line 100, Pos (8,24)
#. ID 41, Page 3, Line 14, Pos (8,24)
msgid "ではいくよ……"
msgstr "那么，开始了哦……"

#. ID 41, Page 2, Line 30, Pos (8,24)
#. ID 41, Page 3, Line 27, Pos (8,24)
msgid ""
"これで…充電は完了したよ\n"
"また……バッテリーが切れたら……\n"
"ここにくれば……充電できるよ……"
msgstr ""
"这样……充电就完成了哦。还有……电池没电的时候……\n"
"来这里……就能充电哦……"

#. ID 41, Page 2, Line 33, Pos (8,24)
#. ID 41, Page 2, Line 175, Pos (8,24)
#. ID 41, Page 3, Line 30, Pos (8,24)
msgid "それじゃあ……ね"
msgstr "那么……再见"

#. ID 41, Page 2, Line 39, Pos (8,24)
#. Contains choice at line 2 (2 options)
#. ID 41, Page 2, Line 70, Pos (8,24)
#. Contains choice at line 2 (2 options)
msgid "股用の貞操帯はご主人様に管理されていないが…"
msgstr "股用贞操带虽然没有被主人管理……"

#. ID 41, Page 2, Line 40, Pos (8,24)
#. Choice (2 options, embedded in a message)
#. ID 41, Page 2, Line 71, Pos (8,24)
#. Choice (2 options, embedded in a message)
msgid ""
"外す\n"
"外さない"
msgstr ""
"取下\n"
"不取下"

#. ID 41, Page 2, Line 50, Pos (8,24)
#. ID 41, Page 2, Line 81, Pos (8,24)
msgid "ご主人様の許可なしに貞操帯を外したくない！"
msgstr "不想未经主人允许就取下贞操带！"

#. ID 41, Page 2, Line 57, Pos (8,24)
msgid "そう……外すんだね……"
msgstr "这样啊……要取下呢……"

#. ID 41, Page 2, Line 66, Pos (8,24)
#. Choice (2 options)
msgid ""
"外してもらう\n"
"無言で立ち去る"
msgstr ""
"请人取下\n"
"默默离开"

#. ID 41, Page 2, Line 90, Pos (8,24)
msgid ""
"ではいくよ……\n"
"\n"
"……あれ？"
msgstr "那么，开始了哦…………咦？"

#. ID 41, Page 2, Line 94, Pos (8,24)
msgid ""
"何だ……？この貞操帯……\n"
"改造されて……いるのかい……？\n"
"これははずせない……"
msgstr ""
"什么……？这条贞操带……被改造过……吗……？\n"
"这个取不下来……"

#. ID 41, Page 2, Line 156, Pos (8,24)
msgid ""
"これで……装置は外れたよ\n"
"ただ貞操帯も一緒に外してしまったから……\n"
"気を付けて……"
msgstr ""
"这样……装置取下来了哦。\n"
"不过贞操带也一起取下来了……要小心……"

#. ID 41, Page 2, Line 161, Pos (8,24)
msgid ""
"あと充分なエネルギーが……なくなったから……\n"
"スライムには……くれぐれも気をつけて……"
msgstr ""
"还有，足够的能量……没有了……所以对史莱姆……\n"
"千万要小心……"

#. ID 41, Page 2, Line 165, Pos (8,24)
msgid ""
"あとバッテリー残量が……少ないから……\n"
"スライムには……くれぐれも気をつけて……"
msgstr ""
"还有电池余量……不多了……所以对史莱姆……\n"
"千万要小心……"

#. ID 41, Page 2, Line 171, Pos (8,24)
msgid ""
"また……スライムにやられてしまったら……\n"
"ここに来れば……はずしてあげられるよ……"
msgstr ""
"如果又……被史莱姆弄成那样的话……来这里……\n"
"我就能帮你取下来哦……"

#. ID 41, Page 3, Line 3, Pos (8,24)
msgid "＊　バッテリー切れで……機械が動かない……"
msgstr "＊　电池没电了……机器动不了……"

#. ID 41, Page 3, Line 9, Pos (8,24)
msgid ""
"もう……外すことはできないけど……\n"
"リモートコントローラの充電ならまだできるよ\n"
"……するかい？"
msgstr ""
"已经……没法取下来了……不过遥控器的话还能充电哦……\n"
"要做吗？"

#. ID 41, Page 3, Line 12, Pos (8,24)
#. Choice (2 options)
msgid ""
"充電する\n"
"充電しない"
msgstr ""
"充电\n"
"不充电"

#. ID 41, Page 3, Line 37, Pos (8,24)
msgid ""
"もう……外せないよ……\n"
"すまないね……"
msgstr "已经……取不下来了……抱歉啊……"

#. ID 42, Page 2, Line 3, Pos (24,36)
#. ID 44, Page 2, Line 3, Pos (29,37)
msgid "＊返事がない……ただの屍のようだ。"
msgstr "＊没有回应……简直像一具尸体。"

#. ID 43, Page 2, Line 3, Pos (31,35)
msgid ""
"ようこそ……我が……\n"
"生命科学……研究所へ"
msgstr "欢迎……来到我的……生命科学……研究所"

#. ID 43, Page 2, Line 5, Pos (31,35)
msgid "あなたを……お待ちしておりました"
msgstr "我一直在……等着您"

#. ID 43, Page 2, Line 6, Pos (31,35)
msgid "さ……どうぞ"
msgstr "来吧……请进"

#. ID 45, Page 2, Line 3, Pos (10,34)
#. ID 48, Page 2, Line 3, Pos (27,30)
msgid ""
"＊何かの記録簿のようだ。\n"
"　古びており、読める部分は一部分しかない。"
msgstr ""
"＊好像是某种记录簿。　已经陈旧，\n"
"　能读的部分只有一部分。"

#. ID 45, Page 2, Line 5, Pos (10,34)
#. Contains choice at line 2 (2 options)
#. ID 48, Page 2, Line 5, Pos (27,30)
#. Contains choice at line 2 (2 options)
msgid "＊読んでみますか？"
msgstr "＊要读读看吗？"

#. ID 45, Page 2, Line 6, Pos (10,34)
#. Choice (2 options, embedded in a message)
#. ID 48, Page 2, Line 6, Pos (27,30)
#. Choice (2 options, embedded in a message)
#. ID 61, Page 2, Line 143, Pos (10,31)
#. Choice (2 options, embedded in a message)
#. ID 64, Page 2, Line 25, Pos (15,33)
#. Choice (2 options)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 45, Page 2, Line 8, Pos (10,34)
#. ID 48, Page 2, Line 8, Pos (27,30)
msgid "＊………"
msgstr "＊………"

#. ID 45, Page 2, Line 11, Pos (10,34)
msgid ""
"一部モンスターの変身能力について、\n"
"さらに詳しい研究が必要。"
msgstr "关于一部分怪物的变身能力，需要进一步详细研究。"

#. ID 45, Page 2, Line 13, Pos (10,34)
msgid ""
"件のサンプル……\n"
"通称“ドッペルゲンガー”で研究を続けるように。"
msgstr "关于该样本……请继续以通称「二重身」推进研究。"

#. ID 45, Page 2, Line 15, Pos (10,34)
msgid ""
"例えサンプルに別の目的があったとしても\n"
"研究に支障はないはずである。"
msgstr "即使该样本另有目的，也应该不会妨碍研究。"

#. ID 45, Page 2, Line 17, Pos (10,34)
msgid ""
"近日のアバロソにて組織された、\n"
"警察まがいの機関についても、同様。"
msgstr ""
"关于近日在阿巴罗索组织的、类似警察的机关，\n"
"也同样。"

#. ID 45, Page 2, Line 19, Pos (10,34)
msgid "いらぬ心配は、捨て置くように。"
msgstr "不必要的担心，就搁置一旁吧。"

#. ID 45, Page 2, Line 24, Pos (10,34)
#. ID 48, Page 2, Line 25, Pos (27,30)
msgid "＊……その他の部分は、字が滲んで読めない。"
msgstr "＊……其他部分字迹晕开，无法阅读。"

#. ID 48, Page 2, Line 11, Pos (27,30)
msgid "「事故報告書」"
msgstr "「事故报告书」"

#. ID 48, Page 2, Line 12, Pos (27,30)
msgid ""
"女性奴隷を拘束するために、\n"
"アバロソの支持より開発されたスライム\n"
"MET-2583が脱走。"
msgstr ""
"为拘束女性奴隶，\n"
"经阿巴罗索支持而开发的史莱姆MET-2583逃走了。"

#. ID 48, Page 2, Line 15, Pos (27,30)
msgid ""
"自立意思を持ち、女性を発見した場合\n"
"下半身に纏わりつき、貞操帯状に変形する。"
msgstr ""
"拥有自主意识，发现女性时会缠上下半身，\n"
"并变形为贞操带状。"

#. ID 48, Page 2, Line 17, Pos (27,30)
msgid ""
"その後断続的に振動を行い、性器を刺激。\n"
"強い性感により対象から思考力と移動力を奪う。"
msgstr ""
"之后断断续续地振动，刺激性器。\n"
"以强烈的性感剥夺对象的思考力与移动力。"

#. ID 48, Page 2, Line 19, Pos (27,30)
msgid ""
"自身の身体を鋼鉄のごとく硬化させるため、\n"
"専用の機構を使わなければ取り外しはできない。"
msgstr ""
"由于会让自己的身体硬化如钢铁，\n"
"不使用专用机构就无法取下。"

#. ID 49, Page 2, Line 3, Pos (25,18)
msgid ""
"この……身体の方が……\n"
"楽なの……さ。"
msgstr "这个……身体……更轻松……啊。"

#. ID 57, Page 2, Line 6, Pos (9,28)
msgid ""
"＊……扉が錆びついている様だ\n"
"　開けることができない"
msgstr "＊……门好像生锈了　打不开"

#. ID 58, Page 2, Line 5, Pos (12,32)
msgid "＊研究所所長の日記のようだ"
msgstr "＊好像是研究所所长的日记"

#. ID 58, Page 2, Line 10, Pos (12,32)
msgid ""
"＊アバロソから人体実験の命令が下ったが\n"
"　それは研究員の人体を使用せよ、というものだった"
msgstr ""
"＊阿巴罗索下达了人体实验的命令，\n"
"　不过那是要求使用研究员人体的命令"

#. ID 58, Page 2, Line 12, Pos (12,32)
msgid ""
"＊希望者を集うことになるが、\n"
"　人数が満たない場合は強制徴用になるだろう。"
msgstr ""
"＊会召集自愿者，\n"
"　但人数不够的话就会强制征用吧。"

#. ID 59, Page 2, Line 5, Pos (15,36)
msgid "＊研究員の手記のようだ"
msgstr "＊好像是研究员的笔记"

#. ID 59, Page 2, Line 10, Pos (15,36)
msgid ""
"＊当研究所は研究員ごと閉鎖するようだ\n"
"　人体実験の現状を国民に知られるのはまずいと\n"
"　判断したのだろう"
msgstr ""
"＊本研究所似乎要连同研究员一起关闭　大概是判断\n"
"　了让人体实验的现状被国民知道会很不妙吧"

#. ID 59, Page 2, Line 13, Pos (15,36)
msgid ""
"＊今後は奴隷を秘密裏に集め実験台にするらしい\n"
"　研究員の犠牲は無駄ではない、と文面では\n"
"　書かれていた"
msgstr ""
"＊听说今后会秘密收集奴隶作为实验体　文面上　写\n"
"　着研究员的牺牲并非徒劳"

#. ID 61, Page 2, Line 7, Pos (10,31)
msgid ""
"「終わりだ……もう……\n"
"　すべては……闇に葬られる……"
msgstr "「结束了……已经……　一切都会……被葬入黑暗……"

#. ID 61, Page 2, Line 13, Pos (10,31)
msgid "「君は……？ここの……研究員では……ないね……。"
msgstr "「你是……？不是这里的……研究员吧……。"

#. ID 61, Page 2, Line 14, Pos (10,31)
msgid ""
"「旅人……？\\|ここは……自身すら……実験材料にする\n"
"　研究員たちの……巣窟だというのに……。"
msgstr ""
"「旅人……？\\|这里可是……连自身都……\n"
"　当作实验材料的　研究员们的……巢穴啊……。"

#. ID 61, Page 2, Line 20, Pos (10,31)
msgid ""
"「何……？ルミナス……？\n"
"　生体金属……拡張電子パネル……？"
msgstr ""
"「什么……？鲁米纳斯……？　生体金属……\n"
"　扩展电子面板……？"

#. ID 61, Page 2, Line 26, Pos (10,31)
msgid ""
"「たしかに……ここの……奴隷調教用の……\n"
"　スライムは……生体金属と……電子パネルで……\n"
"　作られているが……。"
msgstr ""
"「确实……这里的……奴隶调教用的……　史莱姆……\n"
"　是用生体金属和……电子面板……　制作而成的，\n"
"　不过……。"

#. ID 61, Page 2, Line 29, Pos (10,31)
msgid ""
"「そうか……この奴隷調教用スライムは……\n"
"　外から持ち込まれた……技術とは聞いていたが……\n"
"　そのルミナスという……研究員が開発したのか……。"
msgstr ""
"「这样啊……这个奴隶调教用史莱姆……\n"
"　我听说过它是从外部带来的……技术……\n"
"　但那是那个叫鲁米纳斯的……研究员开发的吗……。"

#. ID 61, Page 2, Line 37, Pos (10,31)
msgid ""
"「生体金属と……拡張電子パネルは……\n"
"　あることにはある……。"
msgstr "「生体金属和……扩展电子面板……　有倒是有……。"

#. ID 61, Page 2, Line 39, Pos (10,31)
msgid ""
"「だが……肉体を失ったとはいえ……これらの……\n"
"　素材は……貴重であることに……変わりはない……。"
msgstr ""
"「但是……虽说已经失去了肉体……这些……素材……依然……\n"
"　十分珍贵……这一点……没有改变……。"

#. ID 61, Page 2, Line 41, Pos (10,31)
msgid ""
"「だから……この二つが欲しいのなら……\n"
"　それなりの対価が……必要だ……。"
msgstr ""
"「所以……如果你想要这两样东西……就需要……\n"
"　付出相应的代价……。"

#. ID 61, Page 2, Line 48, Pos (10,31)
msgid ""
"「対価は……お前の生命力……\n"
"　それか……民間人の……生命力……\n"
"　それを……頂くことになるが……いいのか……？"
msgstr ""
"「代价是……你的生命力……或者……平民的……生命力……\n"
"　我要……收下……这些……可以吗……？"

#. ID 61, Page 2, Line 53, Pos (10,31)
msgid ""
"どうしようか…？\n"
"※自身が生命力を捧げる場合最大HPが50下がります※"
msgstr "怎么办…？※若献出自身生命力，最大HP会降低50※"

#. ID 61, Page 2, Line 55, Pos (10,31)
#. Choice (3 options)
msgid ""
"民間人の生命力を捧げる\n"
"自分の生命力を捧げる\n"
"やっぱりやめておく"
msgstr ""
"献出平民的生命力\n"
"献出自己的生命力\n"
"还是算了吧"

#. ID 61, Page 2, Line 59, Pos (10,31)
#. Contains choice at line 3 (2 options)
msgid ""
"「……民間人は……君のように……頑丈じゃない……\n"
"　生命力を頂くと……死んでしまうが……いいのかい？"
msgstr ""
"「……平民可不像你……那么结实……收下生命力的话……\n"
"　会死的……这样可以吗？"

#. ID 61, Page 2, Line 61, Pos (10,31)
#. Choice (2 options, embedded in a message)
msgid ""
"それでもいい\n"
"やっぱりやめておく"
msgstr ""
"即便如此也可以\n"
"还是算了吧"

#. ID 61, Page 2, Line 65, Pos (10,31)
#. ID 61, Page 2, Line 157, Pos (10,31)
msgid "「……わかった……取り消しは……きかないぞ……。"
msgstr "「……我知道了……可无法……反悔了……。"

#. ID 61, Page 2, Line 70, Pos (10,31)
msgid ""
"「研究員が民間人の体に触れると、\n"
"　物凄い勢いでその人の血の気が引いていく！"
msgstr ""
"「研究员一碰到平民的身体，\n"
"　那个人的血色便以惊人的速度褪去！"

#. ID 61, Page 2, Line 76, Pos (10,31)
msgid "「うぁああ……あううぅ……どう……して……"
msgstr "「呜啊啊……啊呜呜……为……什么……"

#. ID 61, Page 2, Line 81, Pos (10,31)
msgid "「ひぃいいい……やあああぁああ……"
msgstr "「咿咿咿……呀啊啊啊啊……"

#. ID 61, Page 2, Line 86, Pos (10,31)
msgid "「あぁぁぁぁ……あぅぅ……"
msgstr "「啊啊啊啊……啊呜呜……"

#. ID 61, Page 2, Line 91, Pos (10,31)
msgid "「…………。"
msgstr "「…………。"

#. ID 61, Page 2, Line 96, Pos (10,31)
msgid "「………………。"
msgstr "「………………。"

#. ID 61, Page 2, Line 100, Pos (10,31)
msgid ""
"「民間人は顔を青ざめたまま、\n"
"　息絶えてしまった……。"
msgstr "「平民脸色苍白，就那样断了气……。"

#. ID 61, Page 2, Line 107, Pos (10,31)
#. ID 61, Page 2, Line 192, Pos (10,31)
msgid ""
"「……ありがとう。\n"
"　……これで俺も……少しは浮かばれる……。"
msgstr "「……谢谢。……这样一来我也……多少能安息了……。"

#. ID 61, Page 2, Line 109, Pos (10,31)
#. ID 61, Page 2, Line 194, Pos (10,31)
msgid ""
"「約束のアイテムだ……。\n"
"　持っていくといい……。"
msgstr "「这是约定好的道具……。拿走吧……。"

#. ID 61, Page 2, Line 116, Pos (10,31)
#. ID 61, Page 2, Line 201, Pos (10,31)
msgid "生体金属と電子拡張パネルを手に入れた。"
msgstr "获得了生体金属与电子扩展面板。"

#. ID 61, Page 2, Line 136, Pos (10,31)
msgid ""
"「対価は……お前の生命力……\n"
"　それを……頂くことになるが……いいのか……？"
msgstr ""
"「代价是……你的生命力……我要……收下这些……可以吗……\n"
"　？"

#. ID 61, Page 2, Line 141, Pos (10,31)
#. Contains choice at line 3 (2 options)
msgid ""
"生命力を研究員に捧げる？\n"
"※自分の最大HPが50下がります※"
msgstr "要将生命力献给研究员吗？※自己的最大HP会降低50※"

#. ID 61, Page 2, Line 149, Pos (10,31)
msgid ""
"「……今の君では……体力が……足りないな……。\n"
"　出直してくれ……。"
msgstr ""
"「……以你现在的状态……体力……不够啊……。\n"
"　改日再来吧……。"

#. ID 61, Page 2, Line 161, Pos (10,31)
msgid ""
"「研究員が体に触れると、\n"
"　物凄い勢いで血の気が引いていく！"
msgstr "「研究员一碰到身体，血色便以惊人的速度褪去！"

#. ID 61, Page 2, Line 209, Pos (10,31)
msgid "「……そうか……無理強いは……しない……。"
msgstr "「……是吗……我不会……强迫你……。"

#. ID 61, Page 3, Line 3, Pos (10,31)
msgid "「ありがとう……。"
msgstr "「谢谢……。"

#. ID 64, Page 2, Line 4, Pos (15,33)
msgid "\\S[2]* 女性奴隷拘束衣管理者登録"
msgstr "\\S[2]* 女性奴隶拘束衣管理者登记"

#. ID 64, Page 2, Line 6, Pos (15,33)
msgid ""
"\\S[2][初期または反抗的女奴隷に対し\n"
"断続的な性刺激を与えることで\n"
"立場を実感させ、従順性を上げる装置]"
msgstr ""
"\\S[2][通过对初始或反抗性女奴隶施加间歇性性刺激，使\n"
"　其体会到自身立场，从而提高顺从性的装置]"

#. ID 64, Page 2, Line 10, Pos (15,33)
msgid ""
"\\S[2][通称「奴隷の貞操帯」のリモートコントローラの\n"
" 管理者登録をここで行うことができます]"
msgstr ""
"\\S[2][在此可进行通称「奴隶贞操带」\n"
" 的遥控器管理者登记]"

#. ID 64, Page 2, Line 13, Pos (15,33)
msgid ""
"\\S[2][管理者登録には当日有効の臨時パスワードが、\n"
" その都度必要です。また、装着済みの奴隷貞操帯が\n"
" 別途必要となります]"
msgstr ""
"\\S[2][管理者登记每次都需要当日有效的临时密码。\n"
" 此外，还需要已佩戴的奴隶贞操带]"

#. ID 64, Page 2, Line 20, Pos (15,33)
msgid ""
"\\S[2][管理者登録を行いますか？]\n"
"[\\c[11]※警告※入力が一致しない場合、パスワードを変更\n"
" すると共に特殊電波を放出します！\\c[0]]"
msgstr ""
"\\S[2][是否进行管理者登记？\n"
"][\\c[11]※警告※若输入不一致，\n"
" 将更改密码并释放特殊电波！\\c[0]]"

#. ID 64, Page 2, Line 30, Pos (15,33)
msgid ""
"\\S[2][管理者登録を行います、\n"
" 本日の臨時パスワードを入力してください...]\n"
"[※全て0でパスワード入力をキャンセルします※]"
msgstr ""
"\\S[2][将进行管理者登记，\n"
" 请输入本日的临时密码...][※输入全0可取消密码输\n"
"入※]"

#. ID 64, Page 2, Line 35, Pos (15,33)
msgid "\\S[2][管理者登録をキャンセルしました]"
msgstr "\\S[2][已取消管理者登记]"

#. ID 64, Page 2, Line 41, Pos (15,33)
msgid ""
"\\S[2][パスワードの一致を確認……\n"
"　被管理者名「\\n[\\v[6]]」\n"
"　管理貞操帯ナンバー「\\v[1498]」を登録します……]"
msgstr ""
"\\S[2][确认密码一致……　将登记被管理者名\n"
"　「\\n[\\v[6]]」　管理贞操带编号「\\v[1498]」……]"

#. ID 64, Page 2, Line 63, Pos (15,33)
msgid ""
"\\S[2][complete…………//////\n"
"　登録が完了いたしました……]"
msgstr "\\S[2][complete…………//////　登记已完成……]"

#. ID 64, Page 2, Line 69, Pos (15,33)
msgid ""
"\\S[2][警告！警告！\n"
" 登録先のリモコンの階級が正しくありません！\n"
" クリアランス違反は反逆行為です！]"
msgstr ""
"\\S[2][警告！警告！\n"
" 登记目标的遥控器阶级不正确！\n"
" 权限违规属于反叛行为！]"

#. ID 64, Page 2, Line 83, Pos (15,33)
msgid ""
"\\S[2][ERROR!!!!パスワードが違います!\n"
" 安全のため日替わりパスワードを変更するとともに、\n"
" 周囲に特殊電波を放出します]"
msgstr ""
"\\S[2][ERROR!!!!密码错误! 为安全起见，\n"
" 将更改每日更换的密码，同时向周围释放特殊电波]"

#. ID 64, Page 2, Line 101, Pos (15,33)
msgid "手元にまだリモートコントローラがない……"
msgstr "手边还没有遥控器……"

#. ID 64, Page 2, Line 108, Pos (15,33)
msgid "今は登録の必要はなさそうだ。"
msgstr "现在似乎没有必要登记。"

#. ID 65, Page 2, Line 3, Pos (12,25)
#. ID 65, Page 3, Line 3, Pos (12,25)
msgid ""
"＊＊＊\n"
"「失われた技工…失われた知識…失われた人材…\n"
"　失われた生贄…失われた施設…失われた人格……。"
msgstr ""
"＊＊＊「失去的技工…失去的知识…失去的人才…\n"
"　失去的祭品…失去的设施…失去的人格……。"

#. ID 65, Page 2, Line 6, Pos (12,25)
#. ID 65, Page 3, Line 6, Pos (12,25)
msgid ""
"＊＊＊\n"
"「ここは……人々はおろか……世界からも\n"
"　消された場所……私は……かつてここで……\n"
"　技工小天使として……働いていた天使……。"
msgstr ""
"＊＊＊「这里是……别说人们……\n"
"就连世界也将之　抹消的地方……我……曾经在这里……\n"
"　作为技工小天使……工作过的天使……。"

#. ID 65, Page 2, Line 10, Pos (12,25)
#. ID 65, Page 3, Line 10, Pos (12,25)
msgid ""
"＊＊＊\n"
"「貴女は……どうしてここに……？\n"
"　一体……何をしに来たの……？"
msgstr ""
"＊＊＊「你……为什么在这里……？　究竟……来做什么……\n"
"？"

#. ID 65, Page 3, Line 13, Pos (12,25)
msgid ""
"＊＊＊\n"
"「……貴女から……感じる……\n"
"　私の……敬愛する上司の……気配を……。"
msgstr ""
"＊＊＊「……从你身上……感觉到了……　我……\n"
"敬爱的上司的……气息……。"

#. ID 65, Page 3, Line 16, Pos (12,25)
msgid ""
"＊＊＊\n"
"「ルミナス様……私は……ここにいます……\n"
"　まだ……技工技師としての使命を……続けてます……"
msgstr ""
"＊＊＊「鲁米纳斯大人……我……在这里……　仍然……\n"
"继续着……作为技工技师的使命……"

#. ID 65, Page 3, Line 19, Pos (12,25)
msgid ""
"＊＊＊\n"
"「どうして……こんなことに……愚かな研究員め……\n"
"　私たちの苦労も知らず……"
msgstr ""
"＊＊＊「为什么……会变成这样……愚蠢的研究员……\n"
"　根本不知道我们的辛苦……"

#. ID 65, Page 3, Line 22, Pos (12,25)
msgid ""
"＊＊＊\n"
"「……なに……？この機械が何なのだって……？\n"
"　貴女も見たでしょう……あの蠢く銀色の粘液を……。"
msgstr ""
"＊＊＊「……什么……？这个机械是什么……？\n"
"　你也看见了吧……那蠕动的银色黏液……。"

#. ID 65, Page 3, Line 25, Pos (12,25)
msgid ""
"＊＊＊\n"
"「あれは貴女を狙うもの……貴女だけじゃない……\n"
"　生命あるものを……無機質な悪意で責めるもの……"
msgstr ""
"＊＊＊「那是瞄准你的东西……不止是你……\n"
"　用无机质的恶意折磨有生命之物……"

#. ID 65, Page 3, Line 28, Pos (12,25)
msgid ""
"＊＊＊\n"
"「ルミナス様の傑作……『奴隷の貞操帯』……\n"
"　数多の研究員に重用され……数多の奴隷を……\n"
"　意のままにする……生体金属製品……"
msgstr ""
"＊＊＊「鲁米纳斯大人的杰作……『奴隶贞操带』……\n"
"　被众多研究员重用……将众多奴隶……\n"
"　随心所欲地操控……生体金属制品……"

#. ID 65, Page 3, Line 32, Pos (12,25)
msgid ""
"＊＊＊\n"
"「それに囚われたものを解放する装置……\n"
"　それがこの部屋の機械……"
msgstr ""
"＊＊＊「解放被它囚禁之人的装置……\n"
"　那就是这个房间里的机械……"

#. ID 65, Page 3, Line 35, Pos (12,25)
msgid ""
"＊＊＊\n"
"「でも……この機械は……まだ不完全……\n"
"　エネルギーが切れたら……使い物にならない……"
msgstr ""
"＊＊＊「但是……这个机械……还不完整……\n"
"　能量耗尽的话……就没法用了……"

#. ID 65, Page 3, Line 38, Pos (12,25)
msgid ""
"＊＊＊\n"
"「……もし……かつての同期に会えたら……\n"
"　なんとかなるかもしれない……。"
msgstr ""
"＊＊＊「……如果……能见到以前的同期的话……\n"
"　也许总会有办法的……。"

#. ID 65, Page 4, Line 3, Pos (12,25)
msgid ""
"＊＊＊\n"
"「かつての同期なら……この機械を……\n"
"　どうにかできる……かもしれない……。"
msgstr ""
"＊＊＊「如果是以前的同期……也许能……\n"
"　想办法搞定……这个机械……。"

#. ID 65, Page 4, Line 6, Pos (12,25)
msgid ""
"＊＊＊\n"
"「私にはもう……どうすることもできない……。\n"
"　貴女なら……かつての同期に……会ってくれる……？"
msgstr ""
"＊＊＊「我已经……无能为力了……。　如果是你的话……\n"
"能去见见……以前的同期吗……？"

#. ID 65, Page 5, Line 3, Pos (12,25)
msgid ""
"＊＊＊\n"
"「それは……なに……？\n"
"　貴方は……何をもってきたの……？"
msgstr "＊＊＊「那是……什么……？　你……带来了什么……？"

#. ID 65, Page 5, Line 8, Pos (12,25)
#. Contains choice at line 2 (2 options)
#. ID 65, Page 6, Line 10, Pos (12,25)
#. Contains choice at line 2 (2 options)
msgid "虚ろな技工天使にエネルギーボトルを渡す？"
msgstr "要把能量瓶交给空洞的技工天使吗？"

#. ID 65, Page 5, Line 9, Pos (12,25)
#. Choice (2 options, embedded in a message)
#. ID 65, Page 6, Line 11, Pos (12,25)
#. Choice (2 options, embedded in a message)
msgid ""
"エネルギーボトルを渡す\n"
"やっぱりやめる"
msgstr ""
"交出能量瓶\n"
"还是算了"

#. ID 65, Page 5, Line 12, Pos (12,25)
#. ID 65, Page 6, Line 14, Pos (12,25)
msgid "エネルギーボトルを虚ろな技工天使に渡した。"
msgstr "把能量瓶交给了空洞的技工天使。"

#. ID 65, Page 5, Line 15, Pos (12,25)
msgid ""
"＊＊＊\n"
"「これは……！機械のエネルギーボトル……\n"
"　こんな貴重なものを……どこから……？"
msgstr ""
"＊＊＊「这是……！机械的能量瓶……\n"
"　这么贵重的东西……从哪里……？"

#. ID 65, Page 5, Line 18, Pos (12,25)
msgid ""
"＊＊＊\n"
"「そう……皆に会ったんだ……それなら……\n"
"　これを持ってくるのも理解できる……"
msgstr ""
"＊＊＊「这样啊……你见过大家了……那样的话……\n"
"　能带来这个也就可以理解了……"

#. ID 65, Page 5, Line 21, Pos (12,25)
msgid ""
"＊＊＊\n"
"「……なるほど……機械自体は変えられないけど……\n"
"　これなら……ちょっとまって……。"
msgstr ""
"＊＊＊「……原来如此……机械本身虽然无法改变……\n"
"　但这样的话……稍等一下……。"

#. ID 65, Page 5, Line 42, Pos (12,25)
#. ID 65, Page 6, Line 37, Pos (12,25)
msgid ""
"＊＊＊\n"
"「機械再起動……エネルギー再充填完了……\n"
"　機能オンライン……各機器に異常なし……"
msgstr ""
"＊＊＊「机械重启……能量再填充完成……　功能在线……\n"
"各设备无异常……"

#. ID 65, Page 5, Line 45, Pos (12,25)
#. ID 65, Page 6, Line 40, Pos (12,25)
msgid ""
"＊＊＊\n"
"「これで……この機械を……また使える……\n"
"　でも……エネルギーに限りあるのは……変わらない。"
msgstr ""
"＊＊＊「这样……这个机械……又能使用了……　但是……\n"
"能量有限这一点……没有改变。"

#. ID 65, Page 5, Line 48, Pos (12,25)
#. ID 65, Page 6, Line 43, Pos (12,25)
msgid ""
"＊＊＊\n"
"「もし……エネルギーが切れて困ったなら……\n"
"　私の所に……同じものを持ってきて……"
msgstr ""
"＊＊＊「如果……能量耗尽遇到麻烦的话……\n"
"　就到我这来……带同样的东西来……"

#. ID 65, Page 5, Line 54, Pos (12,25)
#. ID 65, Page 6, Line 49, Pos (12,25)
msgid "貞操帯解除装置のエネルギーが満タンになった。"
msgstr "贞操带解除装置的能量已满。"

#. ID 65, Page 6, Line 4, Pos (12,25)
msgid ""
"＊＊＊\n"
"「また……エネルギーボトルを持ってきたね……\n"
"　貴女が望むなら……機械のエネルギーを……\n"
"　再充填するけど……どうする……？"
msgstr ""
"＊＊＊「你又……带来了能量瓶呢……\n"
"　如果你希望的话……我可以给机械……　再填充能量……\n"
"　要怎么做……？"

#. ID 65, Page 6, Line 17, Pos (12,25)
msgid ""
"＊＊＊\n"
"「わかった……ちょっとまって……。"
msgstr "＊＊＊「明白了……稍等一下……。"

#. ID 65, Page 6, Line 57, Pos (12,25)
msgid ""
"＊＊＊\n"
"「もし……機械のエネルギーが切れて困ったなら……\n"
"　私の所に……エネルギーボトルを持ってきて……"
msgstr ""
"＊＊＊「如果……能量耗尽遇到麻烦的话……\n"
"　就到我这来……带能量瓶来……"

#. ID 66, Page 2, Line 4, Pos (9,21)
msgid "\\S[2]* 女性奴隷拘束衣解除装置"
msgstr "\\S[2]* 女性奴隶拘束衣解除装置"

#. ID 66, Page 2, Line 9, Pos (9,21)
msgid "\\S[2][機能:オフライン 残存エネルギー:\\V[1515]]"
msgstr "\\S[2][功能:离线 剩余能量:\\V[1515]]"

#. ID 66, Page 2, Line 11, Pos (9,21)
msgid ""
"\\S[2][ERROR!!エネルギーが切れています!\n"
" 機械の使用にはエネルギーを再充填してください]"
msgstr ""
"\\S[2][ERROR!!能量已耗尽! 使用机械请重新填充能\n"
" 量]"

#. ID 66, Page 2, Line 16, Pos (9,21)
msgid "\\S[2][機能:オンライン 残存エネルギー:\\V[1515]]"
msgstr "\\S[2][功能:在线 剩余能量:\\V[1515]]"

#. ID 66, Page 2, Line 19, Pos (9,21)
msgid "\\S[2][警告!エネルギー残量が少なくなっています!]"
msgstr "\\S[2][警告!能量余量已不足!]"

#. ID 67, Page 2, Line 3, Pos (26,3)
#. ID 67, Page 3, Line 3, Pos (26,3)
msgid ""
"＊＊＊\n"
"\\S[2]「……。"
msgstr ""
"＊＊＊\n"
"\\S[2]「……。"

#. ID 67, Page 3, Line 5, Pos (26,3)
msgid ""
"＊＊＊\n"
"\\S[2]「……懐かしい気配……敬愛するルミナス様……\n"
"　ああ……このようなことに……力及ばず……"
msgstr ""
"＊＊＊\\S[2]「……怀念的气息……敬爱的鲁米纳斯大人…\n"
"…　啊啊……这种事……我力不能及……"

#. ID 67, Page 3, Line 8, Pos (26,3)
msgid ""
"＊＊＊\n"
"\\S[2]「……ここに得られるものはない……\n"
"　あるのは狂気と……血肉に狂った化け物だけ……"
msgstr ""
"＊＊＊\\S[2]「……这里没有能获得的东西……\n"
"　有的只是疯狂……和沉迷血肉的怪物……"

#. ID 67, Page 3, Line 11, Pos (26,3)
msgid ""
"＊＊＊\n"
"\\S[2]「かつての道も……封鎖されて久しい……\n"
"　ルミナス様……私はこのまま……\n"
"　ここで消滅するのでしょうか……"
msgstr ""
"＊＊＊\\S[2]「曾经的道路也……被封已久……\n"
"　鲁米纳斯大人……我就这样……　在这里消灭吗……"
