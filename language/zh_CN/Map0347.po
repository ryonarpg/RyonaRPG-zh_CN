#. ID 38, Page 1, Line 97, Pos (35,0)
msgid "………"
msgstr "………"

#. ID 38, Page 1, Line 102, Pos (35,0)
msgid "部屋の奥に…\\.\\.…人影があった。"
msgstr "房间深处…\\.\\.…有一个人影。"

#. ID 38, Page 1, Line 108, Pos (35,0)
msgid ""
"その姿をよく見ると…\\.\\.…\\.\\.\\.\n"
"それはまるで鏡に映したようにそっくりな、\n"
"\\n[\\v[6]]の姿をした人間だった。"
msgstr ""
"仔细一看那身影…\\.\\.…\n"
"\\.\\.\\.那是一个仿佛映照在镜中般一模一样、\n"
"\\n[\\v[6]]模样的人。"

#. ID 38, Page 1, Line 111, Pos (35,0)
msgid ""
"\\n[\\v[6]]の姿をしている人間は、\n"
"つま先から頭まで舐めるように\\n[\\v[6]]を\n"
"見回すと、ゆっくりと口を開いた。"
msgstr ""
"\\n[\\v[6]]模样的人，\n"
"像从脚尖到头顶舔遍一样\\n[\\v[6]]地打量了一番，\n"
"然后慢慢张开了口。"

#. ID 38, Page 1, Line 117, Pos (35,0)
msgid ""
"「初めまして…\\.…\\.\\.\\n[\\v[6]]。\\.\\.\\.\n"
"　私は“ドッペルゲンガー”…\\.…\\.\\.\\.\n"
"　この研究所で造られた被験者の一人です」"
msgstr ""
"「初次见面…\\.…\\.\\.\\n[\\v[6]]。\n"
"　\\.\\.\\.　我是「二重身」…\\.…\n"
"　\\.\\.\\.　是这个研究所制造出的受试者之一。」"

#. ID 38, Page 1, Line 120, Pos (35,0)
msgid ""
"「私は身体を自在に変化させることが出来る\\.\\.\\.\n"
"　\\n[\\v[6]]のことはさっき知ったけど\n"
"　そっくりでしょう？」"
msgstr ""
"「我能够自由自在地改变身体\\.\\.\\.　\\n[\\v[6]]的\n"
"　事我刚刚才知道，不过一模一样吧？」"

#. ID 38, Page 1, Line 123, Pos (35,0)
msgid ""
"「きっと誰もが私を\\n[\\v[6]]だと思うわ\\.\\.\\.\n"
"　友達も、\\.\\.\\.家族も、\\.\\.\\.恋人も…\\.\\.…」"
msgstr ""
"「大家一定都会以为我是\\n[\\v[6]]吧\\.\\.\\.　朋友\n"
"　也好、\\.\\.\\.家人也好、\\.\\.\\.恋人也罢…\\.…」"

#. ID 38, Page 1, Line 125, Pos (35,0)
msgid ""
"「\\n[\\v[6]]の記憶を奪って、\\.\\.そして…\\.\\.…\\!\n"
"　\\n[\\v[6]]さえ居なくなれば、\n"
"　きっとそうなるはずよ」"
msgstr ""
"「夺走\\n[\\v[6]]的记忆，\\.\\.然后…\\.\\.…\n"
"　\\!　只要\\n[\\v[6]]不在了，　就一定会变成那样。\n"
"　」"

#. ID 38, Page 1, Line 165, Pos (35,0)
msgid ""
"「\\n[\\v[6]]は私……\\.\\.あなたは偽物。\\.\\.\\.\n"
"　私が\\n[\\v[6]]としてこれから冒険をするの。\\.\\.\\.\n"
"　あなたは此処で朽ち果てると良い！」"
msgstr ""
"「\\n[\\v[6]]是我……\\.\\.你是冒牌货。\n"
"　\\.\\.\\.　从今以后由我作为\\n[\\v[6]]去冒险。\n"
"　\\.\\.\\.　你就留在这里腐朽而死吧！」"
