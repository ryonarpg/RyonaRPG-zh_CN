"200点"
msgstr "水晶200分"

#. ID 99, Page 1, Line 3, Pos (15,29)
msgid ""
"宝石（大）\n"
"300点"
msgstr "宝石（大）300分"

#. ID 130, Page 1, Line 3, Pos (4,37)
#. Contains choice at line 2 (2 options)
msgid "帰りたいのかい？"
msgstr "想回去吗？"

#. ID 130, Page 1, Line 4, Pos (4,37)
#. Choice (2 options, embedded in a message)
msgid ""
"帰る\n"
"まだ遊ぶ"
msgstr ""
"回去\n"
"还想玩"

#. ID 130, Page 1, Line 6, Pos (4,37)
msgid "よし、分かった。"
msgstr "好，明白了。"

#. ID 130, Page 1, Line 21, Pos (4,37)
msgid "そうかい。"
msgstr "这样啊。"
