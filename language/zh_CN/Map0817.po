#. ID 3, Page 2, Line 1, Pos (17,9)
msgid ""
"コモン効果をお試し。\n"
"呪い以外は脱がします。\n"
"+αでは奴隷なら鎖、雌犬なら尻尾を着けます。"
msgstr ""
"试试普通效果。除了诅咒以外都会脱掉。+α的话，\n"
"奴隶就戴上锁链，母狗就装上尾巴。"

#. ID 3, Page 2, Line 4, Pos (17,9)
msgid "やりますか？"
msgstr "要执行吗？"

#. ID 3, Page 2, Line 5, Pos (17,9)
#. Choice (4 options)
msgid ""
"武器だけ外し [変数000006]\n"
"武器とアクセ外し [変数020006]\n"
"全外し+α [変数123456]\n"
"キャンセル"
msgstr ""
"仅卸下武器 [変数000006]\n"
"卸下武器和饰品 [変数020006]\n"
"全部卸下+α [変数123456]\n"
"取消"

#. ID 3, Page 2, Line 20, Pos (17,9)
msgid "完了"
msgstr "完成"

#. ID 6, Page 1, Line 4, Pos (21,12)
msgid ""
"\n"
"ようこそ。ここは教会です。\n"
"ご用件ならシスターにどうぞ。"
msgstr "欢迎。这里是教会。有事的话请找修女小姐。"

#. ID 6, Page 2, Line 23, Pos (21,12)
msgid ""
"\n"
"こんにちわ。\n"
"なかなかの艶姿ですね。"
msgstr "你好呀。真是相当艳丽的姿色呢。"

#. ID 6, Page 2, Line 26, Pos (21,12)
msgid ""
"\n"
"シスターさんも喜びますよ。\n"
"ぜひ話してあげてください。"
msgstr "修女小姐也会高兴的。请务必和她聊聊。"

#. ID 8, Page 1, Line 3, Pos (30,10)
msgid "＊太い格子で閉ざされた入り口がある。"
msgstr "＊有一个被粗铁栅栏封住的入口。"

#. ID 8, Page 1, Line 4, Pos (30,10)
#. ID 8, Page 1, Line 5, Pos (30,10)
msgid "＊………"
msgstr "＊………"

#. ID 8, Page 1, Line 6, Pos (30,10)
msgid ""
"＊………奥でかすかにすすり泣くような声が\n"
"　したような気がしたが、きっと気のせいだろう……"
msgstr ""
"＊………里面好像隐约传来了抽泣般的声音，\n"
"　但一定是错觉吧……"

#. ID 10, Page 1, Line 6, Pos (13,10)
msgid ""
"\n"
"あ。ちょっと！\n"
"そっちはだめー。"
msgstr "啊。等一下！那边不行——。"

#. ID 11, Page 1, Line 7, Pos (25,15)
msgid ""
"\n"
"こんな町でも教会は人を寄越してくれる。\n"
"おかげで葬式には困らんわい。"
msgstr ""
"就算是这样的城镇，教会也会派人来。多亏如此，\n"
"葬礼才不用发愁啊。"

#. ID 11, Page 1, Line 13, Pos (25,15)
msgid ""
"\n"
"神か…。\n"
"おるのなら、腰痛でも直してくれんかのぅ。"
msgstr "神吗……如果存在的话，能不能也治治我的腰痛啊。"

#. ID 11, Page 1, Line 18, Pos (25,15)
msgid ""
"\n"
"この建物外だけ立派じゃが、\n"
"中はいまいち教会には見えんのぅ。"
msgstr "这建筑只有外面气派，里面怎么看都不太像教会啊。"

#. ID 12, Page 1, Line 9, Pos (16,15)
msgid ""
"\n"
"面白いシスターがいるとかいうから\n"
"来てみたけど…"
msgstr "听说有个有趣的修女小姐，所以来看看……"

#. ID 12, Page 1, Line 12, Pos (16,15)
msgid ""
"\n"
"まだガキじゃん…\n"
"あれじゃぁ、ソソらないのよ…"
msgstr "不还是个小鬼嘛……那样的话，可勾不起兴致啊……"

#. ID 12, Page 1, Line 19, Pos (16,15)
msgid ""
"\n"
"簡単に入れるのはいいけど、\n"
"ここもつまんないなぁ。"
msgstr "能轻易进来倒是好，不过这里也很无聊啊。"

#. ID 12, Page 1, Line 25, Pos (16,15)
msgid ""
"\n"
"貴女も私的にはアリだけど…"
msgstr "你对我来说也算可以接受，不过……"

#. ID 12, Page 1, Line 27, Pos (16,15)
msgid ""
"\n"
"コレばっかりは味見してみないと\n"
"何とも言えないわね。"
msgstr "这个不亲自尝尝的话，可不好说呢。"

#. ID 12, Page 2, Line 16, Pos (16,15)
msgid ""
"\n"
"あらあら。こんな手錠まで…。\n"
"抵抗したくてもできないのがイイの？"
msgstr ""
"哎呀哎呀。居然还戴着手铐……。想反抗也反抗不了，\n"
"这样才好吗？"

#. ID 12, Page 2, Line 24, Pos (16,15)
msgid ""
"\n"
"あら。\n"
"よさげなアクセサリーを持ってるじゃない"
msgstr "哎呀。你戴着看起来不错的饰品嘛"

#. ID 12, Page 2, Line 33, Pos (16,15)
msgid ""
"\n"
"隷嬢の鎖を着けられた!"
msgstr "被戴上了隶娘锁链！"

#. ID 12, Page 2, Line 43, Pos (16,15)
msgid ""
"\n"
"ここもこんなに濡らしちゃって…"
msgstr "这里也湿成这样……"

#. ID 12, Page 2, Line 45, Pos (16,15)
msgid ""
"\n"
"清楚なドレスの内側は\n"
"被虐願望でいっぱいなのね"
msgstr "清纯连衣裙的内侧，装满了受虐欲望呢"

#. ID 12, Page 2, Line 52, Pos (16,15)
msgid ""
"\n"
"下着もこんなにしちゃって…。\n"
"どんな期待をしてたの？とんだお姫様ね。"
msgstr ""
"连内衣都弄成这样……。你是在期待什么呀？\n"
"真是不得了的大小姐呢。"

#. ID 12, Page 2, Line 67, Pos (16,15)
msgid ""
"\n"
"この服…脱がせないわね。\n"
msgstr "这衣服……脱不下来呢。"

#. ID 12, Page 2, Line 71, Pos (16,15)
msgid ""
"\n"
"まぁ、着せたままってのも偶にはいいかも。"
msgstr "嘛，就穿着不脱，偶尔也不错。"

#. ID 12, Page 2, Line 78, Pos (16,15)
msgid ""
"\n"
"まずは上からちょっと味見。"
msgstr "先从上面稍微尝一尝。"

#. ID 12, Page 2, Line 82, Pos (16,15)
msgid ""
"\n"
"ってなにこれ。胸当てかと思ったけど、\n"
"外せないじゃない。"
msgstr "这什么呀。还以为是胸甲，结果脱不下来嘛。"

#. ID 12, Page 2, Line 93, Pos (16,15)
msgid ""
"\n"
"ブラジャーにしてはやたら硬いし……"
msgstr "作为胸罩来说也太硬了……"

#. ID 12, Page 2, Line 96, Pos (16,15)
msgid ""
"\n"
"まぁいいわ。\n"
"それならキスで済ましてあげる。"
msgstr "算了，无所谓。那就用亲吻将就一下吧。"

#. ID 12, Page 2, Line 132, Pos (16,15)
msgid ""
"\n"
"良い感度ね。\n"
"奴隷としての素質は十分ってとこかしら。"
msgstr "敏感度不错呢。作为奴隶的素质算是足够了吧。"

#. ID 12, Page 2, Line 136, Pos (16,15)
msgid ""
"\n"
"さぁて。\n"
"魔法でアレを生やして。と。"
msgstr "那么。用魔法让那个长出来。吧。"

#. ID 12, Page 2, Line 158, Pos (16,15)
msgid ""
"\n"
"さぁて。\n"
"下もよく味見させてね\\c[11]$k\\c[0]"
msgstr "那么。下面也让我好好尝一尝哦\\c[11]$k\\c[0]"

#. ID 12, Page 2, Line 186, Pos (16,15)
#. ID 12, Page 5, Line 780, Pos (16,15)
msgid ""
"\n"
"貴女の身体気に入ったわ。\n"
"また味見させてね\\c[11]$k\\c[0]"
msgstr ""
"我喜欢上你的身体了。\n"
"下次再让我尝尝哦\\c[11]$k\\c[0]"

#. ID 12, Page 2, Line 192, Pos (16,15)
#. ID 12, Page 5, Line 994, Pos (16,15)
msgid ""
"\n"
"なかなか淫乱でおいしい身体だったわ。\n"
"また味見させてね\\c[11]$k\\c[0]"
msgstr ""
"真是相当淫乱又美味的身体。\n"
"下次再让我尝尝哦\\c[11]$k\\c[0]"

#. ID 12, Page 3, Line 7, Pos (16,15)
msgid ""
"\n"
"…品がないわね。\n"
"中身が悪すぎて、装備が泣いてるわ。"
msgstr "……真没品呢。内在太差，装备都要哭了。"

#. ID 12, Page 3, Line 12, Pos (16,15)
msgid ""
"\n"
"うーん。\n"
"性奴隷ねぇ…。その首輪は見飽きたわ。"
msgstr "嗯……性奴隶啊……那个项圈我都看腻了。"

#. ID 12, Page 3, Line 17, Pos (16,15)
msgid ""
"\n"
"パスよ、パス。\n"
"しっしっ…。"
msgstr "跳过，跳过。去去……。"

#. ID 12, Page 4, Line 11, Pos (16,15)
msgid ""
"\n"
"あら。なかなか良いものが付いているわね\\c[11]$k\\c[0]\n"
msgstr "哎呀。戴着相当不错的东西呢\\c[11]$k\\c[0]"

#. ID 12, Page 4, Line 19, Pos (16,15)
msgid ""
"\n"
"可愛い顔にコレなんて。ますます私好み。\n"
"それでは遠慮なく。"
msgstr ""
"这么可爱的脸上居然戴着这个。越来越合我口味了。\n"
"那我就不客气了。"

#. ID 12, Page 4, Line 86, Pos (16,15)
#. ID 12, Page 4, Line 125, Pos (16,15)
#. ID 12, Page 4, Line 167, Pos (16,15)
#. ID 12, Page 4, Line 341, Pos (16,15)
#. ID 12, Page 4, Line 364, Pos (16,15)
#. ID 12, Page 5, Line 181, Pos (16,15)
msgid "\\n[102]………！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]………！！\\n[103]\\n[104]\\^"

#. ID 12, Page 4, Line 87, Pos (16,15)
#. ID 12, Page 4, Line 126, Pos (16,15)
#. ID 12, Page 4, Line 168, Pos (16,15)
#. ID 12, Page 4, Line 342, Pos (16,15)
#. ID 12, Page 4, Line 365, Pos (16,15)
#. ID 12, Page 5, Line 874, Pos (16,15)
#. ID 12, Page 5, Line 1140, Pos (16,15)
msgid "\\n[102]！！！！！！！！！！！！！！！\\n[103]\\n[104]\\^"
msgstr "\\n[102]！！！！！！！！！！！！！！！\\n[103]\\n[104]\\^"

#. ID 12, Page 4, Line 108, Pos (16,15)
msgid ""
"\n"
"痛い？でも頑張って。\n"
"オトコノコでしょ？"
msgstr "痛吗？但要加油哦。你是男孩子吧？"

#. ID 12, Page 4, Line 146, Pos (16,15)
msgid ""
"\n"
"ふふん。ダメダメ。\n"
"まだまだ射精は禁止よ。"
msgstr "哼哼。不行不行。还不能射精哦。"

#. ID 12, Page 4, Line 189, Pos (16,15)
msgid ""
"\n"
"ダメって言っているでしょ？\n"
"聞き分けのないコね。"
msgstr "我说了不行吧？真是个不听话的孩子呢。"

#. ID 12, Page 4, Line 201, Pos (16,15)
msgid ""
"\n"
"でも…そろそろ私も\n"
"貴女のナカで楽しませてもらおうかしら。"
msgstr "不过……差不多也让我在你的里面享受一下了吧。"

#. ID 12, Page 4, Line 212, Pos (16,15)
msgid ""
"\n"
"あら。出すのはだめよ。\n"
"出ないように押さえててあげるわね。"
msgstr ""
"哎呀。不准射出来哦。我会帮你按住，\n"
"不让你射出来的。"

#. ID 12, Page 4, Line 246, Pos (16,15)
msgid ""
"\n"
"いきそう？"
msgstr "快要射了吗？"

#. ID 12, Page 4, Line 250, Pos (16,15)
msgid ""
"\n"
"そういう時はこういう風に…"
msgstr "这种时候就要这样做……"

#. ID 12, Page 4, Line 260, Pos (16,15)
msgid ""
"\n"
"ほら、こうすれば…イケないでしょ。"
msgstr "看，这样做的话……就射不出来了吧。"

#. ID 12, Page 4, Line 262, Pos (16,15)
msgid ""
"\n"
"まだまだ楽しめるわね。"
msgstr "还能继续享受呢。"

#. ID 12, Page 4, Line 276, Pos (16,15)
msgid ""
"\n"
"また、いきそうなの？"
msgstr "又要射了吗？"

#. ID 12, Page 4, Line 287, Pos (16,15)
msgid ""
"\n"
"まだまだ、頑張りなさいよ…"
msgstr "还早呢，继续努力吧……"

#. ID 12, Page 4, Line 301, Pos (16,15)
msgid ""
"\n"
"そろそろ…、…いいわね…。"
msgstr "差不多……、……可以了吧……。"

#. ID 12, Page 4, Line 328, Pos (16,15)
msgid ""
"\n"
"一気に…いっちゃいなさい"
msgstr "一口气……射出来吧"

#. ID 12, Page 5, Line 18, Pos (16,15)
msgid ""
"\n"
"あら？下は貞操帯かぁ。"
msgstr "哎呀？下面是贞操带啊。"

#. ID 12, Page 5, Line 32, Pos (16,15)
msgid ""
"\n"
"ん？でも前の穴は綺麗に空いてるのねぇ。\n"
"中まで覗けちゃうじゃない\\c[11]$k\\c[0]"
msgstr ""
"嗯？不过前面的洞倒是开得很干净呢。\n"
"都能看到里面了不是吗\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 36, Pos (16,15)
#. ID 12, Page 5, Line 48, Pos (16,15)
#. ID 12, Page 5, Line 113, Pos (16,15)
msgid ""
"\n"
"それじゃ、遠慮なく頂きます\\c[11]$k\\c[0]"
msgstr "那么，我就不客气地享用了\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 44, Pos (16,15)
msgid ""
"\n"
"ん？でも後ろの穴は綺麗に空いてるのねぇ。\n"
"中まで覗けちゃうじゃない\\c[11]$k\\c[0]"
msgstr ""
"嗯？不过后面的洞倒是开得很干净呢。\n"
"都能看到里面了不是吗\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 61, Pos (16,15)
msgid ""
"\n"
"挿れる穴は無し。…変な貞操帯ね。\n"
"ちょっと残念。"
msgstr "没有可插入的洞。……奇怪的贞操带呢。有点遗憾。"

#. ID 12, Page 5, Line 82, Pos (16,15)
msgid ""
"\n"
"ん？これは排泄用の器具かしらね。\n"
msgstr "嗯？这是排泄用的器具吗。"

#. ID 12, Page 5, Line 97, Pos (16,15)
msgid ""
"\n"
"ちょっと～穴が狭すぎるわよ～。\n"
"これじゃ挿れられないじゃない。"
msgstr "喂～洞太窄了啦～。这样根本插不进去嘛。"

#. ID 12, Page 5, Line 110, Pos (16,15)
msgid ""
"\n"
"まぁ、穴が開くなら問題ないわね\\c[11]$k\\c[0]"
msgstr "嘛，只要能开洞就没问题吧\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 122, Pos (16,15)
msgid ""
"\n"
"んん？\\|なにこれ。\\!なにかで塞がれてる？\n"
"これじゃ挿れられないわね。"
msgstr ""
"嗯嗯？\\|这是什么。\\!被什么东西堵住了？\n"
"这样可插不进去呢。"

#. ID 12, Page 5, Line 138, Pos (16,15)
msgid ""
"\n"
"ん？何かしら？これ。\n"
"リモコン？"
msgstr "嗯？是什么呢？这个。遥控器？"

#. ID 12, Page 5, Line 158, Pos (16,15)
msgid ""
"\n"
"特に何も起きないわね…。\n"
"何かあるかと思ったんだけど。"
msgstr "什么也没发生呢……。我还以为会有什么反应。"

#. ID 12, Page 5, Line 191, Pos (16,15)
msgid ""
"\n"
"なるほど。\n"
"こういう仕組みなのね。"
msgstr "原来如此。是这种构造啊。"

#. ID 12, Page 5, Line 195, Pos (16,15)
msgid ""
"\n"
"こんなモノを仕込みながら\n"
"清楚に振る舞わせるなんて…。"
msgstr "居然一边藏着这种东西，一边装得那么清纯……"

#. ID 12, Page 5, Line 199, Pos (16,15)
msgid ""
"\n"
"貴女のご主人さまとは気が合いそうだわ。"
msgstr "看来我和你的主人会很合得来呢。"

#. ID 12, Page 5, Line 205, Pos (16,15)
msgid ""
"\n"
"ではこっちを押すとどうなるのかしら？"
msgstr "那么按这边的话，会变成什么样呢？"

#. ID 12, Page 5, Line 219, Pos (16,15)
#. ID 12, Page 5, Line 393, Pos (16,15)
#. ID 12, Page 5, Line 510, Pos (16,15)
#. ID 12, Page 5, Line 1003, Pos (16,15)
#. ID 12, Page 5, Line 1027, Pos (16,15)
msgid ""
"\n"
"あら？"
msgstr "哎呀？"

#. ID 12, Page 5, Line 229, Pos (16,15)
msgid ""
"\n"
"…何も起きないわね。\n"
"電池切れかしら？"
msgstr "…什么都没发生呢。是没电了吗？"

#. ID 12, Page 5, Line 254, Pos (16,15)
#. ID 12, Page 5, Line 307, Pos (16,15)
msgid ""
"\n"
"うん？\\|なにこれ。\\!排泄禁止中だから操作\n"
"できないって貴女随分ニッチねぇ。"
msgstr ""
"嗯？\\|这是什么。\n"
"\\!说因为正在禁止排泄所以无法操作，\n"
"你还真是相当小众呢。"

#. ID 12, Page 5, Line 267, Pos (16,15)
msgid ""
"\n"
"う～ん排泄用の穴なんでしょうけど、\n"
"小さすぎるわね。挿れるのは無理かぁ。"
msgstr ""
"嗯～应该是排泄用的孔吧，不过太小了呢。\n"
"要插进去是不行啊。"

#. ID 12, Page 5, Line 283, Pos (16,15)
#. ID 12, Page 5, Line 320, Pos (16,15)
#. ID 12, Page 5, Line 551, Pos (16,15)
msgid ""
"\n"
"あら？後ろが開いたわね。\n"
"こちらは排泄用かしら？"
msgstr "哎呀？后面打开了呀。这边是排泄用的吗？"

#. ID 12, Page 5, Line 287, Pos (16,15)
#. ID 12, Page 5, Line 324, Pos (16,15)
#. ID 12, Page 5, Line 555, Pos (16,15)
msgid ""
"\n"
"後ろとはいえ、せっかく開いたんだし。\n"
"使ってあげないと可哀想よね\\c[11]$k\\c[0]"
msgstr ""
"虽说是后面，但好不容易打开了。\n"
"不好好使用一下的话就太可怜了呢\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 343, Pos (16,15)
#. ID 12, Page 5, Line 458, Pos (16,15)
msgid ""
"\n"
"うん？\\|なにこれ。\\!ディルド挿入中だから\n"
"操作できない？"
msgstr ""
"嗯？\\|这是什么。\n"
"\\!因为正在插入假阳具所以无法操作？"

#. ID 12, Page 5, Line 347, Pos (16,15)
#. ID 12, Page 5, Line 462, Pos (16,15)
msgid ""
"\n"
"見た目に反して、中までおもちゃで塞いで\n"
"たなんて貴女相当好き者なのねぇ。\n"
"ますます気に入っちゃった\\c[11]$k\\c[0]"
msgstr ""
"与外表相反，里面竟然被玩具塞满了，\n"
"你还真是相当好色呢。\n"
"越来越喜欢你了\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 352, Pos (16,15)
#. ID 12, Page 5, Line 467, Pos (16,15)
msgid ""
"\n"
"それじゃあおもちゃはさっさと抜いてぇ\\c[11]$k\\c[0]"
msgstr "那么就快点把玩具拔出来吧\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 384, Pos (16,15)
#. ID 12, Page 5, Line 501, Pos (16,15)
msgid ""
"\n"
"はいご開帳～\\c[11]$k\\c[0]"
msgstr "好，开盖展示～\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 403, Pos (16,15)
#. ID 12, Page 5, Line 520, Pos (16,15)
msgid ""
"\n"
"…何も起きないわね。\n"
"電池切れかしら？\n"
"いいところだったのにぃ。"
msgstr ""
"…什么都没发生呢。是没电了吗？\n"
"明明正是关键时刻的说。"

#. ID 12, Page 5, Line 420, Pos (16,15)
#. ID 12, Page 5, Line 442, Pos (16,15)
#. ID 12, Page 5, Line 537, Pos (16,15)
msgid ""
"\n"
"それじゃ頂きま～す\\c[11]$k\\c[0]"
msgstr "那么我就不客气了～\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 434, Pos (16,15)
msgid ""
"\n"
"あら？前の穴が開いたわね。\n"
"中の壁と一番奥まで丸見えじゃない。"
msgstr ""
"哎呀？前面的孔打开了呀。\n"
"连里面的壁和最深处都看得一清二楚不是吗。"

#. ID 12, Page 5, Line 438, Pos (16,15)
msgid ""
"\n"
"これはもう使ってくださいと、\n"
"言ってるようなものね\\c[11]$k\\c[0]"
msgstr "这已经像是在说请使用我吧\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 589, Pos (16,15)
msgid ""
"\n"
"まぁ、いいわ。\n"
"穴はもう一個あるしね\\c[11]$k\\c[0]"
msgstr "嘛，算了。反正还有一个孔呢\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 621, Pos (16,15)
msgid ""
"\n"
"まぁ。\n"
"下がダメでも上のお口が開いてるし\\c[11]$k\\c[0]"
msgstr ""
"嘛。就算下面不行，\n"
"上面的嘴也开着呢\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 630, Pos (16,15)
msgid ""
"\n"
"おいしい?\n"
"しっかり味わいなさいよ。"
msgstr "好吃吗？好好品味吧。"

#. ID 12, Page 5, Line 679, Pos (16,15)
#. ID 12, Page 6, Line 76, Pos (16,15)
msgid ""
"\n"
"出すわ…。\n"
"零すんじゃないわよ。"
msgstr "要出来了……。可别洒出来哦。"

#. ID 12, Page 5, Line 737, Pos (16,15)
#. ID 12, Page 6, Line 134, Pos (16,15)
msgid ""
"\n"
"ふふ。口の中いっぱいみたいね。\n"
"飲むまで離さないわよ。"
msgstr "呵呵。好像嘴里满满的呀。不喝下去可不会放开哦。"

#. ID 12, Page 5, Line 777, Pos (16,15)
#. ID 12, Page 6, Line 172, Pos (16,15)
msgid ""
"\n"
"どう？おいしかった?"
msgstr "怎么样？好吃吗？"

#. ID 12, Page 5, Line 821, Pos (16,15)
#. ID 12, Page 5, Line 1087, Pos (16,15)
msgid ""
"\n"
"…ん。\n"
"絶頂を抑える装置が付いているみたいね。"
msgstr "…嗯。好像装有抑制高潮的装置呢。"

#. ID 12, Page 5, Line 824, Pos (16,15)
#. ID 12, Page 5, Line 1090, Pos (16,15)
msgid ""
"\n"
"自慰防止かしら？"
msgstr "是防止自慰的吗？"

#. ID 12, Page 5, Line 827, Pos (16,15)
#. ID 12, Page 5, Line 1093, Pos (16,15)
msgid ""
"\n"
"でも、コントローラがあるから。\n"
"タイミング良く使えば…"
msgstr "不过，有控制器在。只要在合适的时机使用的话…"

#. ID 12, Page 5, Line 843, Pos (16,15)
#. ID 12, Page 5, Line 1109, Pos (16,15)
msgid ""
"\n"
"よしよし。いけたわね。"
msgstr "好好好。高潮了呢。"

#. ID 12, Page 5, Line 898, Pos (16,15)
#. ID 12, Page 5, Line 1164, Pos (16,15)
msgid ""
"\n"
"ん…、そろそろ、ね…。"
msgstr "嗯……，差不多，该……了吧。"

#. ID 12, Page 5, Line 969, Pos (16,15)
msgid ""
"\n"
"ふう、それじゃあ出した穴にはちゃんと\n"
"栓をしてあげないとね。"
msgstr "呼，那么就得把出过的那个孔好好塞上才行呢。"

#. ID 12, Page 5, Line 991, Pos (16,15)
msgid ""
"\n"
"これでよしと\\c[11]$k\\c[0]"
msgstr "这样就 OK 了\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 1013, Pos (16,15)
msgid ""
"\n"
"ごめんね～。充電切れちゃったみたい\\c[11]$k\\c[0]"
msgstr "对不起啦～。好像没电了\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 1016, Pos (16,15)
#. ID 12, Page 5, Line 1041, Pos (16,15)
msgid ""
"\n"
"まぁぱっくり開いた前穴から、たらたら\n"
"垂れ流しっていうのも悪くないかも。"
msgstr ""
"嘛，从大开着的前孔里滴滴答答地流出来，\n"
"也许也不坏。"

#. ID 12, Page 5, Line 1037, Pos (16,15)
msgid ""
"\n"
"ごめんね～。いつの間にか、操作できなく\n"
"なっちゃったみたい\\c[11]$k\\c[0]"
msgstr ""
"对不起啦～。不知不觉间，\n"
"好像变得无法操作了\\c[11]$k\\c[0]"

#. ID 12, Page 5, Line 1234, Pos (16,15)
msgid "＊排出完了確認。自動閉鎖します…"
msgstr "＊排出完成确认。将自动关闭…"

#. ID 12, Page 5, Line 1242, Pos (16,15)
msgid ""
"\n"
"あら？\n"
"私の精液入ったまま閉鎖されちゃったわ。"
msgstr "哎呀？就这样把我的精液留在里面关闭了呢。"

#. ID 12, Page 5, Line 1246, Pos (16,15)
msgid ""
"\n"
"まぁいいわ。ナカに入ったままの感覚を\n"
"たっぷり楽しんでね。"
msgstr "嘛，算了。就好好享受留在里面的感觉吧。"

#. ID 12, Page 6, Line 13, Pos (16,15)
msgid ""
"\n"
"やっぱり下も脱げないか…。"
msgstr "果然下面也脱不掉吗……"

#. ID 12, Page 6, Line 18, Pos (16,15)
msgid ""
"\n"
"しょーがない。。\n"
"上のお口で我慢してあげるわ\\c[11]$k\\c[0]"
msgstr ""
"真没办法。\n"
"就用上面的嘴将就一下吧\\c[11]$k\\c[0]"

#. ID 12, Page 6, Line 27, Pos (16,15)
msgid ""
"\n"
"頑張って奉仕しなさいよ。\n"
msgstr "好好努力侍奉吧。"

#. ID 12, Page 7, Line 8, Pos (16,15)
msgid ""
"\n"
"でっかいロボットね…。"
msgstr "好大的机器人呢……。"

#. ID 12, Page 7, Line 11, Pos (16,15)
msgid ""
"\n"
"あら、この匂いは…\n"
msgstr "哎呀，这股味道是……"

#. ID 12, Page 7, Line 15, Pos (16,15)
msgid ""
"\n"
"ふぅん。\n"
"乗ってる人もタイヘンねぇ…。"
msgstr "呼嗯。上面乘坐的人也很辛苦呢……。"

#. ID 12, Page 7, Line 30, Pos (16,15)
msgid ""
"\n"
"分かってるわよ。\n"
"あんたの獲物を盗る気はないってば。"
msgstr "我知道啦。都说了我没打算抢你的猎物。"

#. ID 12, Page 7, Line 43, Pos (16,15)
msgid ""
"\n"
"しっしっ。なんで教会に犬が居んのよ。\n"
"躾がなっていわ。"
msgstr "去去去。为什么教堂里会有狗啊。真是缺乏管教。"

#. ID 12, Page 7, Line 69, Pos (16,15)
msgid ""
"\n"
"……！！"
msgstr ""
"\n"
"……！！"

#. ID 12, Page 7, Line 76, Pos (16,15)
msgid ""
"\n"
"おんもしろいのげっとぉー！！"
msgstr "拿到有趣的东西啦——！！"

#. ID 12, Page 7, Line 87, Pos (16,15)
msgid ""
"\n"
"貴女奴隷?\n"
"奴隷よね。こんな鎖付きの首輪だし。"
msgstr "你是奴隶？是奴隶吧。毕竟戴着这种带锁链的项圈。"

#. ID 12, Page 7, Line 91, Pos (16,15)
msgid ""
"\n"
"それでは遠慮なく\n"
"いただきまーす！！"
msgstr "那么我就不客气地收下啦——！！"

#. ID 13, Page 1, Line 40, Pos (23,13)
#. ID 13, Page 3, Line 61, Pos (23,13)
msgid ""
"\n"
"ん？\n"
"特になんともないですよー？"
msgstr "嗯？并没有什么特别的感觉哦——？"

#. ID 13, Page 1, Line 44, Pos (23,13)
msgid ""
"\n"
"呪われた装備なんて洒落になりませんから。\n"
"間違えても装備なんてしないで下さいね。"
msgstr ""
"被诅咒的装备可不是闹着玩的。\n"
"就算弄错了也请不要装备哦。"

#. ID 13, Page 1, Line 55, Pos (23,13)
#. ID 13, Page 3, Line 76, Pos (23,13)
msgid ""
"\n"
"う…。貴方の体から禍々しいニオイが…\n"
"コレは、お祓いしなくてはなりませんね。"
msgstr ""
"唔……。你的身体散发出不祥的气味……\n"
"这个必须进行驱邪才行呢。"

#. ID 13, Page 1, Line 66, Pos (23,13)
#. ID 13, Page 3, Line 87, Pos (23,13)
msgid ""
"\\n[\\v[6]]\n"
"「余計ナオセワダ。\n"
"ワタシハワタシノママデイイ。」"
msgstr "\\n[\\v[6]]「多管闲事。我保持我自己就好。」"

#. ID 13, Page 1, Line 73, Pos (23,13)
#. ID 13, Page 3, Line 94, Pos (23,13)
msgid ""
"\n"
"そ…、そうですか…。"
msgstr "这……，这样啊……。"

#. ID 13, Page 1, Line 81, Pos (23,13)
#. Choice (2 options, embedded in a message)
#. ID 13, Page 3, Line 102, Pos (23,13)
#. Choice (2 options, embedded in a message)
#. ID 15, Page 2, Line 4, Pos (29,15)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 13, Page 1, Line 84, Pos (23,13)
#. ID 13, Page 3, Line 105, Pos (23,13)
msgid ""
"\n"
"ちょっと目を閉じててくださいねっ。"
msgstr "请稍微闭上眼睛哦。"

#. ID 13, Page 1, Line 87, Pos (23,13)
msgid ""
"\n"
"では……\n"
msgstr "那么……"

#. ID 13, Page 1, Line 126, Pos (23,13)
#. ID 13, Page 3, Line 146, Pos (23,13)
msgid ""
"\n"
"もうちょっとですからねー。"
msgstr "还差一点点哦——。"

#. ID 13, Page 1, Line 163, Pos (23,13)
#. ID 13, Page 3, Line 182, Pos (23,13)
msgid ""
"\\n[\\v[6]]の期待も空しく、ロボットには\n"
"何も影響が現れなかった。"
msgstr ""
"\\n[\\v[6]]的期待也落空了，\n"
"机器人身上没有出现任何影响。"

#. ID 13, Page 1, Line 165, Pos (23,13)
#. ID 13, Page 3, Line 184, Pos (23,13)
msgid ""
"\\n[\\v[6]]\n"
"「ううぅ…"
msgstr "\\n[\\v[6]]「呜呜……"

#. ID 13, Page 1, Line 191, Pos (23,13)
#. ID 13, Page 3, Line 223, Pos (23,13)
msgid ""
"\n"
"おわりました。"
msgstr "结束了。"

#. ID 13, Page 1, Line 211, Pos (23,13)
#. ID 13, Page 3, Line 258, Pos (23,13)
msgid "あれ？"
msgstr "咦？"

#. ID 13, Page 1, Line 220, Pos (23,13)
#. ID 13, Page 1, Line 229, Pos (23,13)
#. ID 13, Page 1, Line 291, Pos (23,13)
#. ID 13, Page 1, Line 300, Pos (23,13)
#. ID 13, Page 1, Line 309, Pos (23,13)
#. ID 13, Page 3, Line 267, Pos (23,13)
#. ID 13, Page 3, Line 276, Pos (23,13)
#. ID 13, Page 3, Line 338, Pos (23,13)
#. ID 13, Page 3, Line 368, Pos (23,13)
#. ID 13, Page 3, Line 377, Pos (23,13)
msgid ""
"\\C[2]\\N[101]\\C[0]は呪いが強すぎて\n"
"解除できないみたいだよ。"
msgstr ""
"\\C[2]\\N[101]\\C[0]的诅咒太强了，\n"
"好像无法解除哦。"

#. ID 13, Page 1, Line 241, Pos (23,13)
#. ID 13, Page 1, Line 254, Pos (23,13)
#. ID 13, Page 3, Line 288, Pos (23,13)
#. ID 13, Page 3, Line 301, Pos (23,13)
msgid ""
"\n"
"あれ……？"
msgstr "咦……？"

#. ID 13, Page 1, Line 244, Pos (23,13)
#. ID 13, Page 1, Line 257, Pos (23,13)
#. ID 13, Page 3, Line 291, Pos (23,13)
#. ID 13, Page 3, Line 304, Pos (23,13)
msgid ""
"\n"
"（あ、金具が…なくなってる？）"
msgstr "（啊，金属件……不见了？）"

#. ID 13, Page 1, Line 247, Pos (23,13)
#. ID 13, Page 1, Line 260, Pos (23,13)
msgid ""
"\n"
"（だから外せなかったんだ…）"
msgstr "（所以之前才取不下来啊……）"

#. ID 13, Page 1, Line 273, Pos (23,13)
#. ID 13, Page 3, Line 320, Pos (23,13)
msgid ""
"\n"
"（この人の服…、服じゃないんだ…）"
msgstr "（这个人的衣服……，不是衣服啊……）"

#. ID 13, Page 1, Line 275, Pos (23,13)
#. ID 13, Page 3, Line 322, Pos (23,13)
msgid ""
"\n"
"（ずっとこんな格好のままなんて…）"
msgstr "（一直保持这种打扮什么的……）"

#. ID 13, Page 1, Line 278, Pos (23,13)
#. ID 13, Page 3, Line 228, Pos (23,13)
#. ID 13, Page 3, Line 325, Pos (23,13)
#. ID 13, Page 3, Line 348, Pos (23,13)
msgid ""
"\n"
"\\S[08]…………。\n"
"　"
msgstr ""
"\n"
"\\S[08]…………。\n"
"　"

#. ID 13, Page 1, Line 317, Pos (23,13)
msgid ""
"\n"
"こんな装備品\n"
"もう絶対に着けないでくださいね。"
msgstr "这样的装备品请绝对不要再穿戴了哦。"

#. ID 13, Page 1, Line 323, Pos (23,13)
msgid ""
"\n"
"ひょっとして、\n"
"呪い装備の被虐感にオオハマリですか?"
msgstr "难道是，深深迷上了诅咒装备的被虐感吗？"

#. ID 13, Page 2, Line 7, Pos (23,13)
msgid ""
"\n"
"それでは…始めます。"
msgstr "那么……开始了。"

#. ID 13, Page 2, Line 11, Pos (23,13)
msgid ""
"\n"
"「ひかりあれ」！"
msgstr "「光啊」！"

#. ID 13, Page 2, Line 35, Pos (23,13)
msgid ""
"\n"
"治りました?"
msgstr "治好了吗？"

#. ID 13, Page 3, Line 65, Pos (23,13)
msgid ""
"\n"
"もし、魔法のことを言ってるなら、\n"
"不自由なのはたぶん首輪のせいです。"
msgstr "如果你说的是魔法的事，那不方便大概是因为项圈。"

#. ID 13, Page 3, Line 108, Pos (23,13)
msgid ""
"\n"
"では……"
msgstr "那么……"

#. ID 13, Page 3, Line 232, Pos (23,13)
msgid ""
"\n"
"…あっ。"
msgstr "……啊。"

#. ID 13, Page 3, Line 235, Pos (23,13)
msgid ""
"\n"
"もう大丈夫です。\n"
"呪いは解けましたよ。"
msgstr "已经没事了。诅咒解除了哦。"

#. ID 13, Page 3, Line 294, Pos (23,13)
#. ID 13, Page 3, Line 307, Pos (23,13)
msgid ""
"\n"
"（これじゃ、外せないよ…）"
msgstr "（这样可取不下来啊……）"

#. ID 13, Page 3, Line 352, Pos (23,13)
msgid ""
"\n"
"(…外れてない。\n"
" やっぱりアレ、奴隷の首輪なんだ…。)"
msgstr "(……没取下来。 果然那个是奴隶项圈啊……。)"

#. ID 13, Page 3, Line 359, Pos (23,13)
msgid ""
"\n"
"外せないのは首輪だけで十分でしょ。\n"
"くれぐれも注意してくださいね。"
msgstr ""
"取不下来的东西有项圈一个就够了吧。\n"
"请务必多加注意哦。"

#. ID 13, Page 3, Line 387, Pos (23,13)
msgid ""
"\n"
"ひょっとして、\n"
"首輪だけじゃ拘束感がタリナイの?"
msgstr "难道是，只有项圈的话拘束感不够吗？"

#. ID 13, Page 4, Line 7, Pos (23,13)
#. Contains choice at line 2 (2 options)
msgid "何か御用ですか?"
msgstr "有什么事吗？"

#. ID 13, Page 4, Line 8, Pos (23,13)
#. Choice (2 options, embedded in a message)
msgid ""
"呪いを解く\n"
"状態異常の治療"
msgstr ""
"解除诅咒\n"
"状态异常的治疗"

#. ID 13, Page 4, Line 17, Pos (23,13)
msgid ""
"\n"
"用がないなら呼び止めないでください。"
msgstr "如果没有事的话请不要叫住我。"

#. ID 13, Page 5, Line 9, Pos (23,13)
msgid ""
"\n"
"…奴隷さんですか？"
msgstr "……是奴隶小姐吗？"

#. ID 13, Page 5, Line 13, Pos (23,13)
msgid ""
"\n"
"…奴隷さんですか…。"
msgstr "……是奴隶小姐吗……。"

#. ID 13, Page 5, Line 18, Pos (23,13)
msgid ""
"\n"
"困ったことがあれば相談してね。\n"
"力になるから。"
msgstr "如果有困难的话就来商量哦。我会帮你的。"

#. ID 13, Page 5, Line 22, Pos (23,13)
#. Choice (4 options)
#. ID 13, Page 7, Line 70, Pos (23,13)
#. Choice (4 options)
msgid ""
"呪いを解く\n"
"状態異常の治療\n"
"鎖を外す\n"
"首輪を…"
msgstr ""
"解除诅咒\n"
"状态异常的治疗\n"
"取下锁链\n"
"项圈…"

#. ID 13, Page 5, Line 32, Pos (23,13)
#. ID 13, Page 5, Line 106, Pos (23,13)
msgid ""
"\n"
"はい。\n"
"手を出してください。"
msgstr "好的。请把手伸出来。"

#. ID 13, Page 5, Line 38, Pos (23,13)
#. ID 13, Page 5, Line 112, Pos (23,13)
msgid ""
"\n"
"外してしまえばただの鉄の鎖です。\n"
"魔力が消えるから…"
msgstr ""
"只要取下来，就只是普通的铁锁链。\n"
"因为魔力会消失…"

#. ID 13, Page 5, Line 46, Pos (23,13)
#. ID 13, Page 5, Line 120, Pos (23,13)
msgid ""
"\n"
"うわー。\n"
"豪華な鎖ですね…。"
msgstr "哇——。真是豪华的锁链呢…。"

#. ID 13, Page 5, Line 50, Pos (23,13)
#. ID 13, Page 5, Line 124, Pos (23,13)
msgid ""
"\n"
"とにかく外しますね。"
msgstr "总之我先把它取下来吧。"

#. ID 13, Page 5, Line 57, Pos (23,13)
#. ID 13, Page 5, Line 131, Pos (23,13)
msgid ""
"\n"
"鎖なんてないですよ。"
msgstr "没有什么锁链哦。"

#. ID 13, Page 5, Line 60, Pos (23,13)
#. ID 13, Page 5, Line 134, Pos (23,13)
msgid ""
"\n"
"つけてほしいの?"
msgstr "你想戴上吗？"

#. ID 13, Page 5, Line 70, Pos (23,13)
#. ID 13, Page 5, Line 144, Pos (23,13)
msgid ""
"\n"
"あ…。"
msgstr "啊…。"

#. ID 13, Page 5, Line 73, Pos (23,13)
#. ID 13, Page 5, Line 147, Pos (23,13)
msgid ""
"\n"
"(酷い。鍵穴が念入りに壊されてる。)"
msgstr "（太过分了。锁孔被仔细地破坏掉了。）"

#. ID 13, Page 5, Line 75, Pos (23,13)
#. ID 13, Page 5, Line 149, Pos (23,13)
msgid ""
"\n"
"(あれではもう…鍵があっても…)"
msgstr "（那样的话已经…就算有钥匙也…）"

#. ID 13, Page 5, Line 78, Pos (23,13)
#. ID 13, Page 5, Line 152, Pos (23,13)
msgid ""
"\n"
"\\S[10]…………。"
msgstr ""
"\n"
"\\S[10]…………。"

#. ID 13, Page 5, Line 80, Pos (23,13)
#. ID 13, Page 5, Line 154, Pos (23,13)
msgid ""
"\n"
"(永久に…奴隷のままなんて……)"
msgstr "（永远…都只能是奴隶……）"

#. ID 13, Page 5, Line 85, Pos (23,13)
msgid ""
"\n"
"ごめんなさい。\n"
"その首輪は複雑すぎてムリなんです。"
msgstr "对不起。那个项圈太复杂了，我做不到。"

#. ID 13, Page 5, Line 96, Pos (23,13)
#. Choice (4 options)
msgid ""
"呪いを解く\n"
"状態異常の治療\n"
"鎖を外す\n"
"拘束具の鍵を…"
msgstr ""
"解除诅咒\n"
"状态异常的治疗\n"
"取下锁链\n"
"拘束具的钥匙…"

#. ID 13, Page 5, Line 159, Pos (23,13)
msgid ""
"\n"
"ごめんなさい。\n"
"その革帯服は複雑すぎてムリなんです。"
msgstr "对不起。那件皮革束缚服太复杂了，我做不到。"

#. ID 13, Page 6, Line 26, Pos (23,13)
#. ID 13, Page 7, Line 53, Pos (23,13)
msgid ""
"\n"
"（わぁ、すごい綺麗な人…）"
msgstr "（哇，好漂亮的人…）"

#. ID 13, Page 6, Line 29, Pos (23,13)
msgid ""
