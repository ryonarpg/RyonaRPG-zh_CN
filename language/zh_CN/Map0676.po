#. ID 35, Page 2, Line 9, Pos (46,3)
msgid ""
"時魔導士ジョアン\n"
"「待って！　やめて、置いていかないでッ！\n"
"　いやぁああっ！？」"
msgstr ""
"时魔导士乔安「等等！　住手，不要抛下我！\n"
"　不要啊啊啊！？」"

#. ID 58, Page 2, Line 3, Pos (31,23)
msgid "＊冒険者の死体のようだ"
msgstr "＊看来是冒险者的尸体"

#. ID 58, Page 2, Line 4, Pos (31,23)
msgid ""
"＊力ずくで強姦されたのか\n"
"　女性器は切り裂いたようにズタズタになっていた"
msgstr "＊是被强行强奸了吗　女阴被割裂得支离破碎"

#. ID 58, Page 2, Line 6, Pos (31,23)
msgid ""
"＊腹部も切り裂かれ……内臓に挿入されたようだ\n"
"　……これ以上は見るに耐えない"
msgstr ""
"＊腹部也被割开了……似乎被插进了内脏　……\n"
"　再往下实在不忍直视"

#. ID 61, Page 2, Line 4, Pos (28,23)
msgid ""
"時魔導士ジョアン\n"
"「お……お願い……\n"
"　助けてくれない……かな？」"
msgstr "时魔导士乔安「求……求求你……　能救救我吗……？」"

#. ID 61, Page 2, Line 8, Pos (28,23)
#. Contains choice at line 2 (2 options)
msgid "＊助けますか？"
msgstr "＊要救吗？"

#. ID 61, Page 2, Line 9, Pos (28,23)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 61, Page 2, Line 16, Pos (28,23)
msgid "＊拘束を解いた！"
msgstr "＊解开了束缚！"

#. ID 61, Page 2, Line 21, Pos (28,23)
msgid ""
"時魔導士ジョアン\n"
"「有難う、お陰で助かったの！」"
msgstr "时魔导士乔安「谢谢，多亏你我才得救！」"

#. ID 61, Page 2, Line 23, Pos (28,23)
msgid ""
"「もうちょっとで私が犯される所だった、かな\n"
"　……いえ、犯すというより……\n"
"　……殺されていたかな、けど」"
msgstr ""
"「再差一点我就要被强暴了，大概　……不，\n"
"　与其说是强暴……　……不如说是要被杀掉了，不过」"

#. ID 61, Page 2, Line 26, Pos (28,23)
msgid ""
"「こんなところもうこりごり……\n"
"　依頼は失敗だけど、大人しく帰る事にするかな」"
msgstr ""
"「这种地方我已经受够了……　虽然委托失败了，\n"
"　我还是乖乖回去好了」"

#. ID 61, Page 2, Line 33, Pos (28,23)
msgid ""
"「でも、私以外にも白魔や見習い、\n"
"　アイテム士が居るはずなんだけど……\n"
"　大丈夫、かな？」"
msgstr ""
"「不过，除了我以外，应该还有白魔、见习、\n"
"　道具士才对……　他们没事吧，大概？」"

#. ID 61, Page 2, Line 44, Pos (28,23)
msgid ""
"時魔導士ジョアン\n"
"「……えっ、うそ……\n"
"　何で、冗談言うの、かな？」"
msgstr ""
"时魔导士乔安「……诶，不会吧……　为什么，\n"
"要开这种玩笑，呢？」"

#. ID 61, Page 2, Line 52, Pos (28,23)
msgid ""
"＊ハンガーで拘束されている……\n"
"　拘束自体は簡単に外すことが出来るようだが\n"
"　それには敵を一掃する必要がありそうだ"
msgstr ""
"＊被吊架束缚着……\n"
"　束缚本身似乎能轻易解开　但为此似乎需要扫清敌\n"
"　人"

#. ID 64, Page 2, Line 3, Pos (14,34)
#. ID 71, Page 2, Line 3, Pos (18,34)
#. ID 74, Page 2, Line 3, Pos (19,34)
msgid "＊血で濡れた書物だ"
msgstr "＊是被血浸湿的书本"

#. ID 64, Page 2, Line 10, Pos (14,34)
msgid ""
"＊血の聖なるかな\n"
"　生誕の美しきかな\n"
"　運命の正しきかな\n"
"　死の聖なるかな"
msgstr "＊血之圣哉　生诞之美哉　命运之正哉　死亡之圣哉"

#. ID 65, Page 2, Line 3, Pos (39,21)
msgid "＊拷問用に飼育されている動物のようだ"
msgstr "＊像是为拷问而饲养的动物"

#. ID 67, Page 2, Line 3, Pos (32,24)
msgid ""
"＊女性器や肛門を拡張する器具のようだ\n"
"　無理矢理押し込んだのか血で汚れている"
msgstr ""
"＊像是扩张女阴和肛门的器具　是被硬塞进去的吗，\n"
"　沾满了血"

#. ID 68, Page 2, Line 3, Pos (27,24)
msgid ""
"＊怪しげな薬品だ……\n"
"　「幸せ薬」というラベルが貼られている"
msgstr "＊是可疑的药品……　上面贴着写着「幸福药」的标签"

#. ID 69, Page 2, Line 3, Pos (30,25)
msgid "＊「自白剤」というラベルの貼られた薬瓶だ"
msgstr "＊是贴着「自白剂」标签的药瓶"

#. ID 71, Page 2, Line 10, Pos (18,34)
msgid ""
"＊拷問執行モ　不法侵入者ノ目的\n"
"　未ダ　未明ナリシ\n"
"　“姫”ニ　判断ヲ　仰ギセシメン"
msgstr ""
"＊拷问执行记录　不法侵入者之目的　尚未　未明　\n"
"　将请「公主」　作出判断"

#. ID 74, Page 2, Line 10, Pos (19,34)
msgid ""
"＊本日　1人　拷問執行セシ\n"
"　死ニ到ル故　廃棄セシ"
msgstr "＊今日　1人　已执行拷问　因已死亡　故已废弃"

#. ID 74, Page 2, Line 12, Pos (19,34)
msgid ""
"＊目的ハ　不法侵入者ノ仲間ヲ\n"
"　助ケルモノト　供述セシ\n"
"　真偽ハ不明ナリ"
msgstr ""
"＊其供述称　目的乃　帮助不法侵入者之同伴　真伪\n"
"　不明"
