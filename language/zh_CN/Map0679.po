#. ID 36, Page 2, Line 26, Pos (17,11)
msgid ""
"見習い戦士アマンダ\n"
"「い、いや、お願い、出て行かないでッ！\n"
"　助けて……助けてください！　イヤぁあ！？」"
msgstr ""
"见习战士阿曼达「不、不要，求求你，别走！\n"
"　救救我……请救救我！　不要啊啊！？」"

#. ID 36, Page 2, Line 46, Pos (17,11)
#. ID 37, Page 2, Line 34, Pos (4,21)
#. ID 38, Page 2, Line 34, Pos (34,22)
#. ID 39, Page 2, Line 34, Pos (48,24)
#. ID 40, Page 2, Line 34, Pos (34,9)
#. ID 57, Page 2, Line 34, Pos (17,45)
#. ID 58, Page 2, Line 34, Pos (18,25)
msgid "＊鍵が掛かっている"
msgstr "＊锁着"

#. ID 46, Page 2, Line 3, Pos (22,4)
msgid ""
"見習い戦士アマンダ\n"
"「あ……あなた！　ちょうど良かったわ！\n"
"　この拘束を解いて頂戴！　簡単に出来るはずよ！」"
msgstr ""
"见习战士阿曼达「啊……是你！　来得正好！\n"
"　快帮我解开这个束缚！　应该很容易就能解开！」"

#. ID 46, Page 2, Line 6, Pos (22,4)
#. Contains choice at line 2 (2 options)
msgid "＊助けますか？"
msgstr "＊要救吗？"

#. ID 46, Page 2, Line 15, Pos (22,4)
msgid "＊拘束を解いた！"
msgstr "＊解开了束缚！"

#. ID 46, Page 2, Line 20, Pos (22,4)
msgid ""
"見習い戦士アマンダ\n"
"「は、ハァ……た、助かったわ……」"
msgstr "见习战士阿曼达「哈、哈啊……得、得救了……」"

#. ID 46, Page 2, Line 22, Pos (22,4)
msgid ""
"「こんなところに死ぬまで拘束する（ｷﾘｯ　\n"
"　とか変なお面野郎に言われて、\n"
"　本当に終わりだと思ったわ、まだ恋もしてないのに」"
msgstr ""
"「那个奇怪的面具混蛋\n"
"　（表情一凛\n"
"　跟我说什么要把我束缚在这种地方直到死，\n"
"　我真的以为完蛋了，明明我连恋爱都还没谈过」"

#. ID 46, Page 2, Line 25, Pos (22,4)
msgid ""
"「ほんと散々よ……\n"
"　さっさと帰って熱いお風呂に入りたい……」"
msgstr "「真是糟透了……　想赶紧回去泡个热水澡……」"

#. ID 46, Page 2, Line 32, Pos (22,4)
msgid ""
"「他にも仲間がいたんだけど……\n"
"　前線張ってた私を追いて逃げ出した挙句\n"
"　全員捕まるなんて、馬鹿じゃないの！？」"
msgstr ""
"「我还有其他同伴……\n"
"　他们丢下在前线撑着的我逃跑，结果全员被抓，\n"
"　这不是傻吗！？」"

#. ID 46, Page 2, Line 35, Pos (22,4)
msgid ""
"「まあ……もし見かけたら助けてあげて？\n"
"　私はもう知らないわ」"
msgstr ""
"「算了……如果你看到他们就帮帮他们？\n"
"　我已经不想管了」"

#. ID 46, Page 2, Line 44, Pos (22,4)
msgid ""
"見習い戦士アマンダ\n"
"「は……な、何言ってるのよ！\n"
"　助けなさいよ！　助けろッ！」"
msgstr ""
"见习战士阿曼达「哈……你、你在说什么啊！\n"
"　快救我啊！　救我！」"

#. ID 46, Page 2, Line 47, Pos (22,4)
#. Contains choice at line 2 (3 options)
msgid "助けますか？"
msgstr "要救吗？"

#. ID 46, Page 2, Line 48, Pos (22,4)
#. Choice (3 options, embedded in a message)
msgid ""
"はい\n"
"言葉の使い方が違うんじゃない？\n"
"無視する"
msgstr ""
"是\n"
"你的说法是不是不对？\n"
"无视"

#. ID 46, Page 2, Line 53, Pos (22,4)
msgid ""
"見習い戦士アマンダ\n"
"「はぁ…？あなた…何を？」"
msgstr "见习战士阿曼达「哈啊…？你…在说什么？」"

#. ID 46, Page 2, Line 57, Pos (22,4)
#. ID 46, Page 2, Line 74, Pos (22,4)
#. ID 46, Page 2, Line 91, Pos (22,4)
msgid ""
"見習い戦士アマンダ\n"
"「待って！行かないでぇっ！！」"
msgstr "见习战士阿曼达「等等！别走啊！！」"

#. ID 46, Page 2, Line 63, Pos (22,4)
#. Choice (3 options)
msgid ""
"冗談です\n"
"「はぁ？」じゃないでしょう？\n"
"無視する"
msgstr ""
"开玩笑的\n"
"不是该说「哈啊？」吧？\n"
"无视"

#. ID 46, Page 2, Line 68, Pos (22,4)
msgid ""
"見習い戦士アマンダ\n"
"「あ…」"
msgstr "见习战士阿曼达「啊…」"

#. ID 46, Page 2, Line 70, Pos (22,4)
msgid ""
"「お…お願いします…。\n"
"　私の拘束を解いて…ください」"
msgstr "「求…求求你了…。　请解开…我的束缚」"

#. ID 46, Page 2, Line 80, Pos (22,4)
#. Choice (3 options)
msgid ""
"よくできました\n"
"\\n[\\v[6]]様をつけなさい\n"
"無視する"
msgstr ""
"做得很好\n"
"要加上\\n[\\v[6]]大人这个称呼\n"
"无视"

#. ID 46, Page 2, Line 85, Pos (22,4)
msgid ""
"見習い戦士アマンダ\n"
"「お願い…します\n"
"　私の拘束を解いて…ください\n"
"　\\n[\\v[6]]様…ッ」"
msgstr ""
"见习战士阿曼达「求…求你了　请解开…\n"
"我的束缚　\\n[\\v[6]]大人…」"

#. ID 46, Page 2, Line 97, Pos (22,4)
#. Choice (2 options)
msgid ""
"フフフ…いい子ね\n"
"ダ～メ、助けてあげない♪"
msgstr ""
"呵呵呵…真乖\n"
"不～行，我才不救你♪"

#. ID 46, Page 2, Line 103, Pos (22,4)
msgid ""
"見習い戦士アマンダ\n"
"「えっ？！な…なんで？！」"
msgstr "见习战士阿曼达「诶？！为…为什么？！」"

#. ID 46, Page 2, Line 105, Pos (22,4)
msgid ""
"「あなたの言ったとおりにしたのに！\n"
"　なんでよ！何が不満なのよっ！\n"
"　グスッ…ウウッ…」"
msgstr ""
"「我明明都照你说的做了！　为什么啊！\n"
"　你有什么不满的！　抽噎…呜呜…」"

#. ID 46, Page 2, Line 112, Pos (22,4)
msgid ""
"強気そうな女の子の泣いている姿が\n"
"\\n[\\v[6]]の嗜虐心をくすぐる…"
msgstr ""
"看似要强的女孩哭泣的模样\\n[\\v[6]]的施虐心被挑\n"
"起了…"

#. ID 46, Page 2, Line 118, Pos (22,4)
msgid ""
"満足感を得た\\n[\\v[6]]は繋がれた女戦士\n"
"を助けてあげることにした"
msgstr "获得满足感的\\n[\\v[6]]决定救救被绑住的女战士"

#. ID 46, Page 3, Line 3, Pos (22,4)
msgid ""
"＊禁固刑ニ　処シタ　囚人　\n"
"　舌ヲ噛ミ　自殺ス"
msgstr "＊被处以禁锢刑的囚犯　　咬舌　自杀"

#. ID 46, Page 3, Line 5, Pos (22,4)
msgid ""
"＊関係者及ビ　担当看守ニハ\n"
"　訓告ノウエ　処罰ヲ　課ス"
msgstr "＊对相关人员及　负责看守　给予训告后　处以处罚"

#. ID 47, Page 2, Line 3, Pos (33,4)
#. ID 48, Page 2, Line 3, Pos (47,19)
#. ID 49, Page 2, Line 3, Pos (4,3)
msgid ""
"＊……腐敗した死体だ\n"
"　随分前に息絶えたのだろう"
msgstr "＊……是腐败的尸体　大概很久以前就断气了"

#. ID 57, Page 2, Line 4, Pos (17,45)
#. Contains choice at line 2 (2 options)
#. ID 58, Page 2, Line 4, Pos (18,25)
#. Contains choice at line 2 (2 options)
msgid "＊[地下牢獄の鍵]を使いますか？"
msgstr "＊要使用[地下牢狱钥匙]吗？"

#. ID 61, Page 2, Line 3, Pos (13,32)
msgid "＊冒険者のようだ"
msgstr "＊看来是冒险者"

#. ID 61, Page 2, Line 4, Pos (13,32)
msgid ""
"＊拷問されたのだろう……\n"
"　肌が裂け骨まで見えている"
msgstr "＊是被拷问过吧……　皮肤裂开，连骨头都露出来了"

#. ID 61, Page 2, Line 6, Pos (13,32)
msgid ""
"＊腹部も切り裂かれており\n"
"　腸が外へと飛び出ていた……\n"
"　かすかに息があるようだが、手の施しようがない"
msgstr ""
"＊腹部也被切开　肠子向外翻出……\n"
"　似乎还有微弱呼吸，但已无计可施"

#. ID 64, Page 2, Line 3, Pos (15,34)
msgid "＊血塗れのレンチやニッパーといった工具類だ"
msgstr "＊是沾满血的扳手、钳子之类的工具"

#. ID 66, Page 2, Line 3, Pos (20,31)
msgid "＊血で濡れた書類だ"
msgstr "＊是被血浸湿的文件"

#. ID 66, Page 2, Line 10, Pos (20,31)
msgid ""
"＊拷問執行ニヨリ　罪人死亡ス\n"
"　棺桶ノ庫出ヲ　願イタシ"
msgstr "＊因执行拷问　罪人死亡　恳请将棺材出库"
