msgid "………"
msgstr "………"

#. ID 41, Page 2, Line 8, Pos (5,24)
#. ID 61, Page 2, Line 8, Pos (7,24)
#. ID 62, Page 2, Line 8, Pos (9,24)
#. ID 63, Page 2, Line 8, Pos (11,24)
#. ID 64, Page 2, Line 8, Pos (13,24)
#. ID 83, Page 2, Line 8, Pos (18,24)
#. ID 84, Page 2, Line 8, Pos (20,24)
#. ID 85, Page 2, Line 8, Pos (22,24)
#. ID 86, Page 2, Line 8, Pos (24,24)
#. ID 87, Page 2, Line 8, Pos (26,24)
#. ID 88, Page 2, Line 8, Pos (28,24)
#. ID 98, Page 2, Line 8, Pos (5,30)
#. ID 99, Page 2, Line 8, Pos (7,30)
#. ID 100, Page 2, Line 8, Pos (9,30)
#. ID 101, Page 2, Line 8, Pos (13,15)
#. ID 105, Page 2, Line 8, Pos (15,14)
msgid ""
"＊自動人形のようだが\n"
"　眠っているようにピクりとも動かない"
msgstr "＊看起来是自动人偶　但像睡着了一样一动不动"

#. ID 109, Page 2, Line 6, Pos (14,15)
msgid "\\S[2]つかまえ　ました"
msgstr "\\S[2]抓　到了"

#. ID 109, Page 2, Line 7, Pos (14,15)
msgid ""
"\\S[2]あなたも　\n"
"永遠に生きられるように\n"
"自動人形に　します"
msgstr ""
"\\S[2]你也　为了能永远活下去，\n"
"我会把你变成自动人偶"

#. ID 109, Page 2, Line 13, Pos (14,15)
msgid ""
"\\n[\\v[6]]\n"
"い、いや！　やめてッ！"
msgstr "\\n[\\v[6]]不、不要！　住手！"

#. ID 109, Page 2, Line 23, Pos (14,15)
msgid ""
"\\n[\\v[6]]\n"
"ひ……ひぃっ………"
msgstr "\\n[\\v[6]]咿……咿呀……"

#. ID 109, Page 2, Line 29, Pos (14,15)
msgid ""
"\\S[2]＊あまりの恐怖におもらししてしまう\n"
"\\n[\\v[6]]だったが……自動人形達は意に介さなかった"
msgstr ""
"\\S[2]＊因为过度的恐惧而尿裤子了\\n[\\v[6]]但是……\n"
"自动人偶们并没有在意"

#. ID 109, Page 2, Line 39, Pos (14,15)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「いや……お願い、いや……やめて……」"
msgstr "\\S[2]\\n[\\v[6]]「不……求求你，不要……住手……」"

#. ID 109, Page 2, Line 50, Pos (14,15)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「いやぁぁぁ――――――――――！！」"
msgstr "\\S[2]\\n[\\v[6]]「不要啊啊啊啊――――――――――！！」"

#. ID 109, Page 2, Line 96, Pos (14,15)
msgid ""
"\\S[2]\n"
"もう　大分改造が　すすみましたね"
msgstr "\\S[2]已经　改造进展得相当多了呢"

#. ID 109, Page 2, Line 115, Pos (14,15)
msgid ""
"\\S[2]\n"
"では　最後に\n"
"あなたの記憶……メモリーを\n"
"自動人形に　書き換えます"
msgstr ""
"\\S[2]那么　最后将你的记忆……\n"
"记忆在自动人偶上　进行改写"

#. ID 109, Page 2, Line 119, Pos (14,15)
msgid ""
"\\S[2]\n"
"いまの　自分に　サヨウナラ\n"
"してください"
msgstr "\\S[2]请向现在的　自己　说再见吧"

#. ID 109, Page 2, Line 140, Pos (14,15)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「……………」"
msgstr ""
"\\S[2]\\n[\\v[6]]\n"
"「……………」"

#. ID 109, Page 2, Line 149, Pos (14,15)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「はじめまして　\n"
"　わたしは\\n[\\v[6]]　です"
msgstr "\\S[2]\\n[\\v[6]]「初次见面　　我是\\n[\\v[6]]　。"

#. ID 109, Page 2, Line 152, Pos (14,15)
msgid ""
"\\S[2]\\n[\\v[6]]\n"
"「これから　よろしく\n"
"　おねがい　します"
msgstr "\\S[2]\\n[\\v[6]]「从今往后　请多关照"

#. ID 110, Page 2, Line 5, Pos (0,7)
msgid "＊…………！"
msgstr "＊…………！"

#. ID 110, Page 2, Line 6, Pos (0,7)
msgid ""
"＊自動人形たちが目を覚ました！\n"
"　……急いで逃げ出さなければ！"
msgstr "＊自动人偶们醒来了！　……必须赶紧逃走！"

#. ID 126, Page 2, Line 3, Pos (31,37)
msgid ""
"＊薄汚い弁当箱だ\n"
"　中身はまるで洗ったように空っぽになっている"
msgstr "＊脏兮兮的便当盒　里面像被洗过一样空空如也"

#. ID 129, Page 2, Line 3, Pos (11,30)
msgid ""
"＊中身は空っぽだ\n"
"　……外に出た形跡がある"
msgstr "＊里面空空如也　……有到外面去过的痕迹"
