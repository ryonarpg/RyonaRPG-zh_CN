#. ID 36, Page 2, Line 4, Pos (14,3)
msgid ""
"名前：ムーンビースト\n"
"種族：獣人"
msgstr "名字：月兽 种族：兽人"

#. ID 36, Page 2, Line 6, Pos (14,3)
msgid ""
"月面を徘徊するモンスター\n"
"無重力でも生活できる"
msgstr "徘徊于月面的怪物，无重力下也能生活"

#. ID 36, Page 2, Line 8, Pos (14,3)
#. Contains choice at line 3 (2 options)
msgid ""
"\\$1000Gで攻略情報を聞くことができます\n"
"聞きますか？"
msgstr "用\\$1000G可以打听攻略情报。要听吗？"

#. ID 36, Page 2, Line 10, Pos (14,3)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"はい"
msgstr ""
"否\n"
"是"

#. ID 36, Page 2, Line 16, Pos (14,3)
msgid ""
"月に生息するモンスター\\!\n"
"頑丈な体の持ち主\\!\n"
"無酸素でも生きていける"
msgstr ""
"栖息在月球上的怪物\\!拥有结实的身体\\!没有氧气也\n"
"能生存"

#. ID 36, Page 2, Line 19, Pos (14,3)
msgid "雷属性に弱い"
msgstr "弱点是雷属性"

#. ID 36, Page 2, Line 20, Pos (14,3)
msgid ""
"そういえば雷耐性を2以上にすると、\n"
"水中で雷属性の武器を使っても、\n"
"自爆ダメージを受けないらしいっす"
msgstr ""
"说起来，听说把雷耐性提升到2以上后，\n"
"即使在水里使用雷属性武器，也不会受到自爆伤害。"

#. ID 36, Page 2, Line 23, Pos (14,3)
msgid "稀に\\C[2]ドラゴンの鎧\\C[0]を落とす"
msgstr "偶尔会掉落\\C[2]龙之铠\\C[0]"
