#. ID 38, Page 2, Line 3, Pos (4,11)
#. ID 39, Page 2, Line 3, Pos (5,11)
msgid "遺骨を手に入れた。"
msgstr "获得了遗骨。"

#. ID 40, Page 2, Line 3, Pos (6,11)
msgid "遺品を手に入れた。"
msgstr "获得了遗品。"

#. ID 59, Page 2, Line 3, Pos (7,11)
msgid "ゲリデルバーの実を手に入れた。"
msgstr "获得了盖里德尔巴果实。"

#. ID 60, Page 2, Line 3, Pos (8,11)
msgid "ラはーぴーの羽根を手に入れた。"
msgstr "获得了拉哈比羽毛。"

#. ID 61, Page 2, Line 3, Pos (9,11)
msgid "ガマの油を手に入れた。"
msgstr "获得了蟾蜍油。"

#. ID 62, Page 2, Line 3, Pos (11,11)
msgid "ソウルポット４を手に入れた。"
msgstr "获得了灵魂壶4。"

#. ID 63, Page 2, Line 4, Pos (12,11)
msgid ""
"名前：酒呑童子\n"
"種族：爬虫類"
msgstr "名字：酒吞童子 种族：爬虫类"

#. ID 63, Page 2, Line 6, Pos (12,11)
msgid ""
"大酒飲みの妖怪の一種\n"
"ヤマタノオロチという妖怪の親戚らしい"
msgstr "大酒饮妖怪的一种，据说是妖怪八岐大蛇的亲戚"

#. ID 63, Page 2, Line 8, Pos (12,11)
#. Contains choice at line 3 (2 options)
msgid ""
"\\$1000Gで攻略情報を聞くことができます\n"
"聞きますか？"
msgstr "\\$1000G可以听取攻略情报。要听吗？"

#. ID 63, Page 2, Line 10, Pos (12,11)
#. Choice (2 options, embedded in a message)
msgid ""
"いいえ\n"
"はい"
msgstr ""
"否\n"
"是"

#. ID 63, Page 2, Line 16, Pos (12,11)
msgid ""
"外見とは裏腹に爬虫類である\\!\n"
"それ故に氷属性の攻撃が有効打となる"
msgstr ""
"与外表相反，\n"
"实际上是爬虫类\\!因此冰属性攻击会成为有效打击"
