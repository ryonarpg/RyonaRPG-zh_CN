#. ID 199, Page 1, Line 3, Pos (23,11)
#. ID 200, Page 1, Line 3, Pos (32,13)
#. ID 217, Page 1, Line 3, Pos (10,17)
#. ID 219, Page 1, Line 3, Pos (7,17)
#. ID 220, Page 1, Line 3, Pos (12,25)
#. ID 238, Page 1, Line 3, Pos (12,12)
msgid ""
"\n"
"穴が空いている。\n"
"暗くて中は見えない…"
msgstr "开着一个洞。里面很暗，看不见……"

#. ID 217, Page 1, Line 10, Pos (10,17)
msgid ""
"\n"
"穴の底で光るものが…"
msgstr "洞底有发光的东西……"

#. ID 220, Page 1, Line 10, Pos (12,25)
msgid ""
"\n"
"穴の底になにかある…"
msgstr "洞底有什么东西……"

#. ID 244, Page 1, Line 3, Pos (28,11)
msgid ""
"\n"
"穴が空いて、中の構造が見えている。\n"
"…この建物には大きな地下室があるようだ"
msgstr ""
"开着一个洞，能看到内部结构。……\n"
"这栋建筑似乎有一个很大的地下室"

#. ID 278, Page 1, Line 9, Pos (72,4)
msgid ""
"\n"
"\\n[101]貴女、かわいいわね。\n"
"\\n[101]ちょっと鳴いてご覧なさい。\\n[102]"
msgstr ""
"\\n[101]你，真可爱呢。\n"
"\\n[101]稍微叫两声给我看看。\\n[102]"

#. ID 278, Page 1, Line 14, Pos (72,4)
msgid ""
"\n"
"\\n[101]ふふ、かーわいー。またね。\\n[102]"
msgstr "\\n[101]呵呵，好可爱。再见啦。\\n[102]"

#. ID 278, Page 1, Line 22, Pos (72,4)
msgid ""
"\n"
"\\n[101]聖女を謳う女か。\n"
"\\n[101]いいね。俺が躾けてやろう\\n[102]"
msgstr ""
"\\n[101]自称圣女的女人吗。\\n[101]不错。\n"
"让我来调教你吧\\n[102]"

#. ID 278, Page 1, Line 27, Pos (72,4)
msgid ""
"\n"
"\\n[101]お前は、性欲解消の道具なんだよ！\n"
"\\n[101]これで理解できただろう？\\n[102]"
msgstr ""
"\\n[101]你只是发泄性欲的工具！\n"
"\\n[101]这样你该明白了吧？\\n[102]"

#. ID 278, Page 1, Line 36, Pos (72,4)
msgid ""
"\n"
"\\n[101]おっ、お前は…、\n"
"\\n[101]なるほど。そういう趣向か。\\n[102]"
msgstr ""
"\\n[101]哦，你是……\\n[101]原来如此。\n"
"是这种爱好啊。\\n[102]"

#. ID 278, Page 1, Line 41, Pos (72,4)
msgid ""
"\n"
"\\n[101]なかなか良かったぜ、聖女サマ。\\n[102]"
msgstr "\\n[101]相当不错哦，圣女大人。\\n[102]"

#. ID 278, Page 1, Line 49, Pos (72,4)
msgid ""
"\n"
"\\n[101]いい趣味だ。\n"
"\\n[101]この娼館もよく分かってるじゃないか！\\n[102]"
msgstr ""
"\\n[101]好趣味。\\n[101]这家娼馆也很懂嘛！\n"
"\\n[102]"

#. ID 278, Page 1, Line 54, Pos (72,4)
msgid ""
"\n"
"\\n[101]もっと喘いでくれよ。\\n[101]\n"
"\\n[101]君はお客を楽しませる役目だろう？\\n[102]"
msgstr ""
"\\n[101]再多喘几声给我听。\n"
"\\n[101]\\n[101]你的职责就是让客人开心吧？\n"
"\\n[102]"

#. ID 278, Page 1, Line 63, Pos (72,4)
msgid ""
"\n"
"\\n[101]おっ、虐め甲斐のありそうな娘じゃないか！\\n[102]"
msgstr "\\n[101]哦，这不是个很值得欺负的姑娘吗！\\n[102]"

#. ID 278, Page 1, Line 67, Pos (72,4)
msgid ""
"\n"
"\\n[101]良かったぜ、嬢ちゃん。\n"
"\\n[101]次は客として相手させてやるよ。\\n[102]"
msgstr ""
"\\n[101]真不错，小姑娘。\n"
"\\n[101]下次我会作为客人来陪你。\\n[102]"

#. ID 278, Page 1, Line 76, Pos (72,4)
msgid ""
"\n"
"\\n[101]ふーん。見た目は令嬢なのね。\n"
"\\n[101]オモチャのいい練習台になりそうね。\\n[102]"
msgstr ""
"\\n[101]嗯哼。外表是位大小姐呢。\n"
"\\n[101]看来会是个很好的玩具练习台。\\n[102]"

#. ID 278, Page 1, Line 81, Pos (72,4)
msgid ""
"\n"
"\\n[101]次はもっと媚びなさい。奴隷ちゃん。\n"
"\\n[101]そうしたら可愛がってあげる。\\n[102]"
msgstr ""
"\\n[101]下次要更会讨好我。奴隶酱。\n"
"\\n[101]那样的话我会好好疼你。\\n[102]"

#. ID 278, Page 1, Line 90, Pos (72,4)
msgid ""
"\n"
"\\n[101]おや、美しいじゃないか。\n"
"\\n[101]儂はこういう娘を攻めるのが好きでのう。\\n[102]"
msgstr ""
"\\n[101]哦呀，很漂亮嘛。\n"
"\\n[101]老夫就喜欢攻这种姑娘呢。\\n[102]"

#. ID 278, Page 1, Line 95, Pos (72,4)
msgid ""
"\n"
"\\n[101]必死に抗う姿がいいのう。乙じゃった。\n"
"\\n[101]今日はツイてるのぅ。\\n[102]"
msgstr ""
"\\n[101]拼命抵抗的样子真不错啊。挺有韵味的。\n"
"\\n[101]今天运气真好啊。\\n[102]"

#. ID 278, Page 1, Line 104, Pos (72,4)
msgid ""
"\n"
"\\n[101]へぇ、こうなってしまえば、\n"
"\\n[101]聖女も形なし、って感じね。\\n[102]"
msgstr ""
"\\n[101]哎呀，变成这样的话，\n"
"\\n[101]感觉圣女也威名扫地了呢。\\n[102]"

#. ID 278, Page 1, Line 109, Pos (72,4)
msgid ""
"\n"
"\\n[101]褒め称えられたところで、所詮は娼婦ね。\n"
"\\n[101]喘ぎまくって、はしたなーい。\\n[102]"
msgstr ""
"\\n[101]就算被百般称赞，终究不过是个娼妇呢。\n"
"\\n[101]喘个不停，真不知羞耻——。\\n[102]"

#. ID 278, Page 1, Line 118, Pos (72,4)
msgid ""
"\n"
"\\n[101]聖女を騙る偽物め！\n"
"\\n[101]天罰を喰らわせてやる！\\n[102]"
msgstr ""
"\\n[101]冒充圣女的冒牌货！\\n[101]让你尝尝天罚！\n"
"\\n[102]"

#. ID 278, Page 1, Line 123, Pos (72,4)
msgid ""
"\n"
"\\n[101]どうだ。魔女め。\n"
"\\n[101]正義の怒りを思い知ったか！\\n[102]"
msgstr ""
"\\n[101]怎么样，魔女。\n"
"\\n[101]领教到正义的怒火了吗！\\n[102]"

#. ID 278, Page 1, Line 132, Pos (72,4)
msgid ""
"\n"
"\\n[101]おや、これも壁の花の一種かね？\n"
"\\n[101]ダンスに誘わねば失礼に当たるのぅ。\\n[102]"
msgstr ""
"\\n[101]哦呀，这也算壁花的一种吗？\n"
"\\n[101]不邀你共舞一曲可就是失礼了啊。\\n[102]"

#. ID 278, Page 1, Line 137, Pos (72,4)
msgid ""
"\n"
"\\n[101]やはり若いのはよいのぅ。\n"
"\\n[101]では、お嬢さん。またな。\\n[102]"
msgstr ""
"\\n[101]果然年轻就是好啊。\\n[101]那么，小姐。\n"
"回头见。\\n[102]"

#. ID 278, Page 1, Line 146, Pos (72,4)
msgid ""
"\n"
"\\n[101]貴女、噂の聖女でしょ？\n"
"\\n[101]これも子供のためかしら？\\n[102]"
msgstr ""
"\\n[101]你，就是传闻中的圣女吧？\n"
"\\n[101]这也是为了孩子们吗？\\n[102]"

#. ID 278, Page 1, Line 151, Pos (72,4)
msgid ""
"\n"
"\\n[101]いいわね。いじり甲斐がありそう。\n"
"\\n[101]覚えておくわね。\\n[102]"
msgstr ""
"\\n[101]真不错呢。看起来很有玩弄的价值。\n"
"\\n[101]我会记住你的哦。\\n[102]"

#. ID 278, Page 1, Line 160, Pos (72,4)
msgid ""
"\n"
"\\n[101]あら貴女様。奇遇ですわね。\n"
"\\n[101]少し付き合ってくださらない？\\n[102]"
msgstr ""
"\\n[101]哎呀，是您呢。真是巧遇啊。\n"
"\\n[101]能稍微陪我一下吗？\\n[102]"

#. ID 278, Page 1, Line 165, Pos (72,4)
msgid ""
"\n"
"\\n[101]とても楽しい時間でしたわ。\n"
"\\n[101]またお会いしましょうね。\\n[102]"
msgstr ""
"\\n[101]真是非常愉快的一段时光。\n"
"\\n[101]我们改日再见吧。\\n[102]"

#. ID 278, Page 1, Line 174, Pos (72,4)
msgid ""
"\n"
"\\n[101]隷嬢とは珍しい。\n"
"\\n[101]少し遊んでやろう。\\n[102]"
msgstr ""
"\\n[101]隶娘啊，倒是少见。\n"
"\\n[101]让我稍微玩玩吧。\\n[102]"

#. ID 278, Page 1, Line 179, Pos (72,4)
msgid ""
"\n"
"\\n[101]真似事にしては、様になってるなだ。\n"
"\\n[101]それとも、本当に元貴族だったかな？\\n[102]"
msgstr ""
"\\n[101]虽说是装模作样，倒还挺像那么回事的。\n"
"\\n[101]还是说，你真的是曾经的贵族？\\n[102]"

#. ID 278, Page 1, Line 188, Pos (72,4)
msgid ""
"\n"
"\\n[101]娼婦の試食会か？\n"
"\\n[101]僕も是非混ぜてもらおうか。\\n[102]"
msgstr ""
"\\n[101]娼妇的试吃会吗？\n"
"\\n[101]也让我务必加入一份吧。\\n[102]"

#. ID 278, Page 1, Line 193, Pos (72,4)
msgid ""
"\n"
"\\n[101]あんた、結構美人だな。\n"
"\\n[101]気が向けば、身請けに来てやるよ。\\n[102]"
msgstr ""
"\\n[101]你长得还挺漂亮的嘛。\n"
"\\n[101]要是心情来了，我就来给你赎身哦。\\n[102]"

#. ID 278, Page 1, Line 202, Pos (72,4)
msgid ""
"\n"
"\\n[101]隷嬢ってことは、貴族の端くれだろ？\n"
"\\n[101]今では娼婦か？ざまぁねぇな。\\n[102]"
msgstr ""
"\\n[101]既然是隶娘，也算是沾点贵族边吧？\n"
"\\n[101]如今却成了娼妇吗？真活该啊。\\n[102]"

#. ID 278, Page 1, Line 207, Pos (72,4)
msgid ""
"\n"
"\\n[101]思い知ったか？\n"
"\\n[101]これからは、皆に虐げられる立場なんだぜ。\\n[102]"
msgstr ""
"\\n[101]尝到厉害了吧？\\n[101]从今往后，\n"
"你就是被所有人欺凌的立场了。\\n[102]"

#. ID 278, Page 1, Line 216, Pos (72,4)
msgid ""
"\n"
"\\n[101]ねぇ、おねぇさん。\n"
"\\n[101]キミの値段って、いくら？\\n[102]"
msgstr ""
"\\n[101]呐，姐姐大人。\\n[101]你的价钱是多少？\n"
"\\n[102]"

#. ID 278, Page 1, Line 221, Pos (72,4)
msgid ""
"\n"
"\\n[101]ああ、買わないよ。ごめんねぇ。\n"
"\\n[101]聞いてみただけだよ。\\n[102]"
msgstr ""
"\\n[101]啊，我不会买啦。抱歉哦。\n"
"\\n[101]只是问问而已。\\n[102]"

#. ID 278, Page 1, Line 230, Pos (72,4)
msgid ""
"\n"
"\\n[101]おねえちゃん。\n"
"\\n[101]お仕事、手伝ってあげるね！\\n[102]"
msgstr "\\n[101]姐姐。\\n[101]我来帮你工作吧！\\n[102]"

#. ID 278, Page 1, Line 235, Pos (72,4)
msgid ""
"\n"
"\\n[101]どう、気持ちよかった？\n"
"\\n[101]思ったよりも、ずっと淫乱なのね。聖女様。\\n[102]"
msgstr ""
"\\n[101]怎么样，舒服吗？\n"
"\\n[101]比想象中要淫乱得多呢。圣女大人。\\n[102]"

#. ID 278, Page 1, Line 244, Pos (72,4)
msgid ""
"\n"
"\\n[101]じっとしててね。可愛いお嬢様。\n"
"\\n[101]気持ちよくさせてあげるわ。\\n[102]"
msgstr ""
"\\n[101]乖乖别动哦。可爱的小姐。\n"
"\\n[101]我会让你舒服的。\\n[102]"

#. ID 278, Page 1, Line 249, Pos (72,4)
msgid ""
"\n"
"\\n[101]あーあ。\n"
"\\n[101]お嬢様も、貴女くらい素直だったらなぁ。\\n[102]"
msgstr ""
"\\n[101]啊——啊。\n"
"\\n[101]要是大小姐也能像你这么坦率就好了。\n"
"\\n[102]"

#. ID 278, Page 3, Line 18, Pos (72,4)
msgid ""
"\n"
"突然、宙吊りにされ、、\n"
"恐ろしく、巨大な、逸物が背中に押し当てられる…！\\|\\^"
msgstr ""
"突然被吊到半空中，可怕的、巨大的、\n"
"阳物压在了背上…！\\|\\^"

#. ID 278, Page 3, Line 30, Pos (72,4)
msgid ""
"\n"
"背中の逸物に向けた蹴りは\\.\n"
"見事にヒットし…\\|\\^"
msgstr "朝背上的阳物踢去的那一脚\\.漂亮地命中了…\\|\\^"

#. ID 278, Page 3, Line 44, Pos (72,4)
msgid ""
"\n"
"…！\\|\n"
"首を掴まれ、宙吊りにされる…\\|\\^"
msgstr "…！\\|脖子被抓住，被吊在半空中…\\|\\^"

#. ID 278, Page 3, Line 76, Pos (72,4)
msgid ""
"\n"
"おとなしくなった\\n[\\v[6]]に\n"
"巨大な肉棒があてがわれ…\\|\\^"
msgstr "安静下来的\\n[\\v[6]]被巨大的肉棒抵住…\\|\\^"

#. ID 278, Page 3, Line 84, Pos (72,4)
msgid ""
"\n"
"宙吊りにされた\\n[\\v[6]]に\n"
"巨大な肉棒があてがわれ…\\|\\^"
msgstr "被吊在半空中的\\n[\\v[6]]被巨大的肉棒抵住…\\|\\^"

#. ID 278, Page 3, Line 110, Pos (72,4)
msgid ""
"\n"
"入るはずのないサイズの逸物に\n"
"内側から押し広げられ、全身が粟立つ\\|\\^"
msgstr ""
"被本不可能容纳的尺寸的阳物从内侧撑开，\n"
"全身起鸡皮疙瘩\\|\\^"

#. ID 278, Page 3, Line 140, Pos (72,4)
msgid ""
"\n"
"ありえない、注挿が、始まる…\\|\\^"
msgstr "难以置信的、注入式插入、开始了…\\|\\^"

#. ID 278, Page 3, Line 168, Pos (72,4)
msgid ""
"貞操帯が、膣内に再現するモノは\n"
"裂けない程度に加減されるようだが、\\|\n"
"それでも、襞がすべて伸ばされる程の大きさで…\\|\\^"
msgstr ""
"贞操带在阴道内再现出的东西，\n"
"似乎被调整到不会裂开的程度，\\|但即便如此，\n"
"也是足以把所有褶皱都撑开的尺寸…\\|\\^"

#. ID 278, Page 3, Line 171, Pos (72,4)
msgid ""
"\n"
"ピストン運動させられる度に、\n"
"全身が震え、汗が吹き出始める…\\|\\^"
msgstr ""
"每当被做活塞运动时，全身都会颤抖，\n"
"汗水开始喷出…\\|\\^"

#. ID 278, Page 4, Line 20, Pos (72,4)
msgid ""
"\n"
"細い何かが、足に絡みつき、\n"
"前の穴に潜り込んだ…！\\|\\^"
msgstr ""
"某个细长的东西缠上腿部，钻进了前面的穴里…！\n"
"\\|\\^"

#. ID 278, Page 4, Line 47, Pos (72,4)
msgid ""
"\n"
"髪を引っ張られ、\n"
"無理やり何かを飲まされた…！\\|\\^"
msgstr "头发被拉扯，被迫喝下了什么东西…！\\|\\^"

#. ID 278, Page 4, Line 85, Pos (72,4)
msgid ""
"\n"
"触手は、後ろの穴へも侵入し、\n"
"2つの穴を蹂躙し始める…！\\|\\^"
msgstr "触手也侵入了后面的穴，开始蹂躏两个穴…！\\|\\^"

#. ID 278, Page 4, Line 111, Pos (72,4)
msgid ""
"\n"
"触手が、全身に絡みついて…\\|\\^"
msgstr "触手缠绕上了全身…\\|\\^"

#. ID 278, Page 5, Line 21, Pos (72,4)
msgid ""
"\n"
"あら。おかえりなさい。"
msgstr "哎呀。欢迎回来。"

#. ID 278, Page 5, Line 32, Pos (72,4)
msgid ""
"\n"
"私がここに居る理由、\n"
"言う必要があるかしら？"
msgstr "我在这里的理由，有必要说吗？"

#. ID 278, Page 5, Line 44, Pos (72,4)
msgid ""
"\n"
"…気づかれないとでも思ったの？"
msgstr "…你以为不会被发现吗？"

#. ID 278, Page 5, Line 52, Pos (72,4)
msgid ""
"\n"
"…\\.\\.じゃ、何も言う必要はないわね。"
msgstr "…\\.\\.那么，就没有必要说什么了呢。"

#. ID 278, Page 5, Line 67, Pos (72,4)
msgid ""
"\n"
"隷嬢の貞操帯は、どうしたのかしら？"
msgstr "隶娘的贞操带，怎么样了呢？"

#. ID 278, Page 5, Line 71, Pos (72,4)
msgid ""
"\n"
"…\\.持っていないって？\\|\\^"
msgstr "…\\.你说没带？\\|\\^"

#. ID 278, Page 5, Line 74, Pos (72,4)
msgid ""
"\n"
"\\>…持っていないって？\n"
"ええ、もちろん、知っているわ。"
msgstr "\\>…你说没带？嗯，当然，我知道哦。"

#. ID 278, Page 5, Line 78, Pos (72,4)
msgid ""
"\n"
"ちゃんと、見つけて回収済みよ。\n"
"費用は15万G程かしらね。"
msgstr "我已经好好找到并回收了。费用大概是15万G吧。"

#. ID 278, Page 5, Line 82, Pos (72,4)
msgid ""
"\n"
"…ああ、手持ちの心配かしら？\n"
"安心しなさい。ツケにしてあげる。"
msgstr "…啊啊，是担心手头的钱吗？放心吧。我给你赊账。"

#. ID 278, Page 5, Line 90, Pos (72,4)
msgid ""
"\n"
"手持ちから引いておくわね。"
msgstr "我就从你手头的钱里扣掉哦。"

#. ID 278, Page 5, Line 102, Pos (72,4)
msgid ""
"\n"
"はい。\n"
"これで隷嬢の貞操帯は、戻ったわね。"
msgstr "好。这样一来，隶娘的贞操带就回来了呢。"

#. ID 278, Page 5, Line 112, Pos (72,4)
msgid ""
"\n"
"ただ、言いつけを破った奴隷には、\n"
"罰が必要よね？"
msgstr "不过，违反命令的奴隶需要惩罚吧？"

#. ID 278, Page 5, Line 119, Pos (72,4)
msgid ""
"\n"
"従順でない奴隷には、罰が必要よね？"
msgstr "不服从的奴隶需要惩罚吧？"

#. ID 278, Page 5, Line 161, Pos (72,4)
msgid ""
"\n"
"これで、隷嬢の貞操帯の再装着は完了よ。"
msgstr "这样，隶娘的贞操带就重新佩戴完成了哦。"

#. ID 278, Page 5, Line 183, Pos (72,4)
msgid ""
"\n"
"リングの方もちゃんと動くわね。"
msgstr "环的部分也正常运作了呢。"

#. ID 278, Page 5, Line 192, Pos (72,4)
msgid ""
"\n"
"あら、まだ下ろさないわよ？"
msgstr "哎呀，还不会把你放下来哦？"

#. ID 278, Page 5, Line 195, Pos (72,4)
msgid ""
"\n"
"再装着だけで終わるわけ無いでしょう。\n"
"貴女は、罰を受ける必要があるわ。"
msgstr "不可能只是重新佩戴就结束了吧。你需要接受惩罚。"

#. ID 278, Page 5, Line 208, Pos (72,4)
msgid ""
"\n"
"リングは貞操帯に固定したわ。\n"
"これで、前の穴も使って貰えるわね。"
msgstr ""
"环已经固定到贞操带上了。这样一来，\n"
"前面的穴也能用了呢。"

#. ID 278, Page 5, Line 219, Pos (72,4)
msgid ""
"\n"
"しばらく、そのままよ。\n"
"外の皆に可愛がってもらいなさい。"
msgstr "暂时就保持那样吧。去让外面的大家好好疼爱你吧。"

#. ID 278, Page 6, Line 55, Pos (72,4)
msgid ""
"\n"
"\\n[\\v[6]]は、\n"
"一晩中、鎖に繋がれたまま晒し者にされ…"
msgstr "\\n[\\v[6]]整晚都被锁链拴着示众…"

#. ID 279, Page 1, Line 3, Pos (56,53)
msgid ""
