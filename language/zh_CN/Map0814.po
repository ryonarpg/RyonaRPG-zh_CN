#. ID 114, Page 2, Line 83, Pos (74,4)
#. Contains choice at line 2 (2 options)
msgid "どうしようか？"
msgstr "该怎么办呢？"

#. ID 114, Page 2, Line 84, Pos (74,4)
#. Choice (2 options, embedded in a message)
msgid ""
"適当に依頼を選ぶ\n"
"やめる"
msgstr ""
"随便选个委托\n"
"放弃"

#. ID 114, Page 2, Line 99, Pos (74,4)
msgid ""
