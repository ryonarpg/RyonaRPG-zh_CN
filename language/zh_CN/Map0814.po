msgstr "\\n[\\v[6]]大人，谢谢你来看我！"

#. ID 14, Page 12, Line 64, Pos (80,0)
#. ID 14, Page 14, Line 269, Pos (80,0)
#. ID 14, Page 15, Line 82, Pos (80,0)
