#. ID 1, Page 1, Line 3, Pos (17,29)
#. Contains choice at line 2 (2 options)
msgid "このエリアから出ますか？"
msgstr "要离开这个区域吗？"

#. ID 1, Page 1, Line 4, Pos (17,29)
#. Choice (2 options, embedded in a message)
#. ID 3, Page 1, Line 75, Pos (23,25)
#. Choice (2 options, embedded in a message)
#. ID 3, Page 1, Line 91, Pos (23,25)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 2, Page 1, Line 5, Pos (11,25)
msgid ""
"スティライ\n"
"「さて今日はどんなご用件？"
msgstr "斯蒂莱「那么，今天有什么事？"

#. ID 2, Page 1, Line 10, Pos (11,25)
#. Choice (4 options)
msgid ""
"ここはなに？\n"
"今の住民居住数を教えて\n"
"町の開発をしたい\n"
"他の事を話す"
msgstr ""
"这里是什么？\n"
"告诉我现在的居民居住人数\n"
"我想开发城镇\n"
"谈其他事情"

#. ID 2, Page 1, Line 15, Pos (11,25)
msgid ""
"スティライ\n"
"「ここでは町の住民の人数確認と、\n"
"　町の開発ができるよ♪"
msgstr ""
"斯蒂莱「在这里可以确认城镇的居民人数，\n"
"　还可以进行城镇开发哦♪"

#. ID 2, Page 1, Line 19, Pos (11,25)
msgid ""
"スティライ\n"
"「町の開発をするとどんどん町が大きく\n"
"　なるから頑張って開発しようね。"
msgstr ""
"斯蒂莱「进行城镇开发的话，\n"
"城镇会不断变大　所以要努力开发哦。"

#. ID 2, Page 1, Line 23, Pos (11,25)
msgid ""
"スティライ\n"
"「町の開発をするには、まず住民がある\n"
"　程度いないとダメだよ。それと開発資金\n"
"　も必要だね。"
msgstr ""
"斯蒂莱「要进行城镇开发，\n"
"首先居民得达到一定　数量才行。\n"
"　而且开发资金　也是必要的呢。"

#. ID 2, Page 1, Line 28, Pos (11,25)
msgid ""
"スティライ\n"
"「条件が揃ったら、私のところに来てね♪\n"
"　街の開発をフェリスさんにお願い\n"
"　しておくから。"
msgstr ""
"斯蒂莱「条件齐备后，\n"
"就来我这里哦♪　我会先拜托菲莉丝小姐　进行城镇\n"
"　开发。"

#. ID 2, Page 1, Line 37, Pos (11,25)
msgid ""
"ポテチジャンキー\n"
"「すまぬの。住民増やすシステムはまだ\n"
"　開発中なのじゃ…。\n"
"　だからいくら聞いても0じゃよ。"
msgstr ""
"薯片狂热者「抱歉啦。\n"
"增加居民的系统还在　开发中…。\n"
"　所以不管问几次都是0哦。"

#. ID 2, Page 1, Line 50, Pos (11,25)
msgid ""
"スティライ\n"
"「今なら町を大きくできそうだよ！\n"
"　開発資金が10万かかるけどいい？"
msgstr ""
"斯蒂莱「现在的话应该能把城镇扩大哦！\n"
"　需要花费10万开发资金，可以吗？"

#. ID 2, Page 1, Line 58, Pos (11,25)
msgid ""
"スティライ\n"
"「今は町を発展させられそうにないよ。\\|\n"
"　もっと資金や人を集めないとね。"
msgstr ""
"斯蒂莱「现在似乎无法发展城镇。\n"
"\\|　必须收集更多资金和人手呢。"

#. ID 2, Page 1, Line 63, Pos (11,25)
#. Choice (4 options)
msgid ""
"雑談したい\n"
"開発資金の残り額を知りたい\n"
"他の事を話す\n"
"とくにない"
msgstr ""
"想闲聊\n"
"想知道开发资金的剩余额\n"
"谈其他事情\n"
"没什么特别的"

#. ID 2, Page 1, Line 79, Pos (11,25)
msgid ""
"スティライ\n"
"「開発資金の残りの金額は、\n"
"　\\v[1538]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]Gだよ。"
msgstr ""
"斯蒂莱「开发资金的剩余金额是，\n"
"　\\v[1538]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]\n"
"　G哦。"

#. ID 2, Page 1, Line 84, Pos (11,25)
msgid ""
"スティライ\n"
"「開発資金の残りの金額は、\n"
"　\\v[1539]Gだよ。"
msgstr "斯蒂莱「开发资金的剩余金额是，　\\v[1539]G哦。"

#. ID 2, Page 1, Line 97, Pos (11,25)
msgid ""
"スティライ\n"
"「そっか～。\n"
"　また用事ができたら呼んでね。"
msgstr "斯蒂莱「这样啊～。　有事的时候再叫我哦。"

#. ID 2, Page 2, Line 7, Pos (11,25)
msgid ""
"スティライ\n"
"「う～んいい天気だね。適度にディルネス\n"
"　と一緒に、お散歩行きたいな。"
msgstr ""
"斯蒂莱「嗯～天气真好呢。\n"
"真想适度和迪尔内斯　一起散散步啊。"

#. ID 2, Page 2, Line 14, Pos (11,25)
msgid ""
"スティライ\n"
"「フェリスは何を考えているんだろう…。\n"
"　あの子は町づくりなんて…。"
msgstr ""
"斯蒂莱「菲莉丝在想什么呢…。\n"
"　那孩子居然会做城镇建设什么的…。"

#. ID 2, Page 2, Line 18, Pos (11,25)
msgid ""
"スティライ\n"
"「でもそれで幸せなら…いいかな。"
msgstr "斯蒂莱「不过如果那样能幸福的话…就好了吧。"

#. ID 2, Page 2, Line 24, Pos (11,25)
msgid ""
"スティライ\n"
"「今でも絵画にいた頃のあの感じが、\n"
"　ふと蘇っちゃうことがあるんだよね。"
msgstr ""
"斯蒂莱「直到现在，在绘画里那段时间的那种感觉，\n"
"　有时会突然苏醒过来呢。"

#. ID 2, Page 2, Line 28, Pos (11,25)
msgid ""
"スティライ\n"
"「記憶も曖昧なままだし…\n"
"　せめて記憶さえ戻ればなぁ。"
msgstr ""
"斯蒂莱「记忆也依旧模糊…\n"
"　至少要是记忆能恢复就好了。"

#. ID 2, Page 2, Line 35, Pos (11,25)
msgid ""
"スティライ\n"
"「前まではディルネスと一緒に旅してたん\n"
"　だよねぇ。また行きたいな～。"
msgstr ""
"斯蒂莱「以前一直是和迪尔内斯一起旅行的　对吧。\n"
"还想再去旅行啊～。"

#. ID 2, Page 3, Line 7, Pos (11,25)
msgid ""
"スティライ\n"
"「みんなで頑張って、\n"
"　町を発展させましょうね♪"
msgstr "斯蒂莱「大家一起努力，　让城镇发展起来吧♪"

#. ID 2, Page 3, Line 14, Pos (11,25)
msgid ""
"スティライ\n"
"「うとうと……"
msgstr "斯蒂莱「迷迷糊糊……"

#. ID 2, Page 3, Line 17, Pos (11,25)
msgid ""
"スティライ\n"
"「はっ！！！"
msgstr "斯蒂莱「啊！！！"

#. ID 2, Page 3, Line 20, Pos (11,25)
msgid ""
"スティライ\n"
"「いけないいけない。仕事仕事。"
msgstr "斯蒂莱「不行不行。工作工作。"

#. ID 2, Page 3, Line 26, Pos (11,25)
msgid ""
"スティライ\n"
"「ブツブツ……"
msgstr "斯蒂莱「嘟嘟囔囔……"

#. ID 2, Page 3, Line 29, Pos (11,25)
msgid ""
"スティライ\n"
"「あっ！\\|ご、\\.ごめんなさい。\n"
"　ちょっと考え事してました。"
msgstr "斯蒂莱「啊！\\|对、\\.对不起。　我刚才在想事情。"

#. ID 3, Page 1, Line 4, Pos (23,25)
msgid ""
"ディルネス\n"
"「で、今日はどんな入用？"
msgstr "迪尔内斯「那么，今天有什么需要？"

#. ID 3, Page 1, Line 9, Pos (23,25)
#. Choice (4 options)
msgid ""
"ここはなに？\n"
"開発資金の寄付をしたい\n"
"開発資金の納付総額を知りたい\n"
"他の事を話す"
msgstr ""
"这里是什么？\n"
"我想捐赠开发资金\n"
"想知道开发资金的缴纳总额\n"
"谈其他事情"

#. ID 3, Page 1, Line 14, Pos (23,25)
msgid ""
"ディルネス\n"
"「ここでは開発資金の寄付と簡単なお店を\n"
"　覗けるわよ。基本は寄付だけどね。"
msgstr ""
"迪尔内斯「在这里可以捐赠开发资金，\n"
"还能顺便看看简陋的　小店哦。\n"
"　基本上还是以捐赠为主呢。"

#. ID 3, Page 1, Line 18, Pos (23,25)
msgid ""
"ディルネス\n"
"「町の開発には人手も必要だけど、\n"
"　何より必要なのはお金よ。\\|\n"
"　これだけは外せないわね。"
msgstr ""
"迪尔内斯「城镇开发也需要人手，\n"
"　但最需要的是金钱哦。\\|　这一点绝对不能少呢。"

#. ID 3, Page 1, Line 23, Pos (23,25)
msgid ""
"ディルネス\n"
"「私のところで渡された開発資金は、後で\n"
"　スティライのところで使われるわ。"
msgstr ""
"迪尔内斯「在我这里交来的开发资金，\n"
"之后　会在斯蒂莱那里使用。"

#. ID 3, Page 1, Line 27, Pos (23,25)
msgid ""
"ディルネス\n"
"「『総額』と『残り額』は意味が違うから\n"
"　気を付けてよね！開発資金は当然開発を\n"
"　すすめると無くなるから。"
msgstr ""
"迪尔内斯「『总额』和『剩余额』意思不同，\n"
"　要注意哦！\n"
"　开发资金当然会随着推进开发　而用完的。"

#. ID 3, Page 1, Line 32, Pos (23,25)
msgid ""
"ディルネス\n"
"「あとはお店だけど、これはほんとに簡素\n"
"　なものを売るためのお店よ。まぁ流通が\n"
"　進めばもうちょっとよくなるかも。"
msgstr ""
"迪尔内斯「剩下就是商店了，\n"
"这是用来卖真正简朴　东西的店哦。不过嘛，\n"
"　要是流通　发展起来，或许会稍微好一点。"

#. ID 3, Page 1, Line 37, Pos (23,25)
msgid ""
"ディルネス\n"
"「お金の使いすぎには気を付けることね！\n"
"　寄付したお金は戻ってこないから！"
msgstr ""
"迪尔内斯「要注意不要过度使用金钱哦！\n"
"　捐赠出去的金钱是不会回来的！"

#. ID 3, Page 1, Line 53, Pos (23,25)
msgid ""
"ディルネス\n"
"「開発資金の今の寄付総額は、\n"
"　\\v[1536]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]Gだよ。\n"
"　いくら寄付するの？"
msgstr ""
"迪尔内斯「开发资金现在的捐赠总额是，\n"
"　\\v[1536]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]\n"
"　G哦。　你要捐赠多少？"

#. ID 3, Page 1, Line 59, Pos (23,25)
msgid ""
"ディルネス\n"
"「開発資金の今の寄付総額は、\n"
"　\\v[1537]Gだよ。\n"
"　いくら寄付するの？"
msgstr ""
"迪尔内斯「开发资金现在的捐赠总额是，\n"
"　\\v[1537]G哦。　你要捐赠多少？"

#. ID 3, Page 1, Line 69, Pos (23,25)
msgid ""
"いくら寄付しようか？\n"
"(0Gで寄付をやめる)"
msgstr "要捐赠多少呢？(输入0G则停止捐赠)"

#. ID 3, Page 1, Line 74, Pos (23,25)
#. Contains choice at line 2 (2 options)
msgid "寄付するのをやめる？"
msgstr "要停止捐赠吗？"

#. ID 3, Page 1, Line 80, Pos (23,25)
msgid ""
"ディルネス\n"
"「寄付をやめるのね。\\|わかったわ。\\!\n"
"　また余裕があるときに来てね。"
msgstr ""
"迪尔内斯「要停止捐赠是吧。\\|我知道了。\n"
"\\!　等手头宽裕时再来哦。"

#. ID 3, Page 1, Line 90, Pos (23,25)
#. Contains choice at line 2 (2 options)
msgid "\\v[1515]G寄付でいい？"
msgstr "\\v[1515]G捐赠可以吗？"

#. ID 3, Page 1, Line 96, Pos (23,25)
msgid ""
"ディルネス\n"
"「\\v[1515]G寄付するのね。\n"
"　わかったわ！"
msgstr "迪尔内斯「要捐赠\\v[1515]G是吧。　我知道了！"

#. ID 3, Page 1, Line 121, Pos (23,25)
msgid ""
"ディルネス\n"
"「おっけ～。\\|たしかに預かったわ。\\!\n"
"　あとでフェリスに渡しておくわね。"
msgstr ""
"迪尔内斯「好～的。\\|确实收到了。\n"
"\\!　之后会转交给菲莉丝的。"

#. ID 3, Page 1, Line 127, Pos (23,25)
msgid ""
"ディルネス\n"
"「ってちょっと！\\|お金足りないじゃない！\n"
"　寄付するのはいいけど、\n"
"　程々にしなさいよね！"
msgstr ""
"迪尔内斯「等等！\\|金钱不够嘛！　捐赠是没关系，\n"
"　但也要适可而止哦！"

#. ID 3, Page 1, Line 153, Pos (23,25)
msgid ""
"ディルネス\n"
"「開発資金の今の寄付総額は、\n"
"　\\v[1536]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]Gだよ。"
msgstr ""
"迪尔内斯「开发资金现在的捐赠总额是，\n"
"　\\v[1536]\\v[771]\\v[772]\\v[773]\\v[774]\\v[775]\\v[776]\n"
"　G哦。"

#. ID 3, Page 1, Line 158, Pos (23,25)
msgid ""
"ディルネス\n"
"「開発資金の今の寄付総額は、\n"
"　\\v[1537]Gだよ。"
msgstr ""
"迪尔内斯「开发资金现在的捐赠总额是，\n"
"　\\v[1537]G哦。"

#. ID 3, Page 1, Line 165, Pos (23,25)
#. Choice (4 options)
msgid ""
"雑談したい\n"
"今の品ぞろえは？\n"
"ほかの事を話す\n"
"とくにない"
msgstr ""
"想闲聊\n"
"现在的商品种类有哪些？\n"
"谈其他事情\n"
"没什么特别的"

#. ID 3, Page 1, Line 173, Pos (23,25)
msgid ""
"ディルネス\n"
"「今の品ぞろえはこんな感じだよ。"
msgstr "迪尔内斯「现在的商品种类是这样的哦。"

#. ID 3, Page 1, Line 177, Pos (23,25)
msgid ""
"ディルネス\n"
"「まいど～も。\\!\n"
"　え、\\.ガラクタしかないって？"
msgstr "迪尔内斯「多谢惠顾～。\\!　哎，\\.净是些破烂？"

#. ID 3, Page 1, Line 181, Pos (23,25)
msgid ""
"ディルネス\n"
"「しょ～がないでしょ！\\|\n"
"　物流がまだ悪いの！"
msgstr "迪尔内斯「没办法吧！\\|　物流还不行啦！"

#. ID 3, Page 1, Line 192, Pos (23,25)
msgid ""
"ディルネス\n"
"「そっか。\\|じゃあまたね。"
msgstr "迪尔内斯「这样啊。\\|那再见啦。"

#. ID 3, Page 2, Line 7, Pos (23,25)
msgid ""
"ディルネス\n"
"「ここは静かなところね。\n"
"　他はもっと殺伐としてるから…。"
msgstr ""
"迪尔内斯「这里是个安静的地方呢。\n"
"　其他地方更加荒凉险恶，所以…。"

#. ID 3, Page 2, Line 14, Pos (23,25)
msgid ""
"ディルネス\n"
"「フェリスはいっつも何考えてるか\n"
"　分からないわ。スティライもだけど。"
msgstr ""
"迪尔内斯「菲莉丝总是不知道在想什么　呢。\n"
"斯蒂莱也是。"

#. ID 3, Page 2, Line 18, Pos (23,25)
msgid ""
"ディルネス\n"
"「でもどこか二人とも放っておけないの\n"
"　よね…。\\|なんでだろ。"
msgstr ""
"迪尔内斯\n"
"「不过总觉得她们两个人都让人放心不下　呢…。\n"
"　\\|为什么呢。"

#. ID 3, Page 2, Line 25, Pos (23,25)
msgid ""
"ディルネス\n"
"「フェリスとスティライとは長い付き合い\n"
"　なのは間違いないんだけど…。"
msgstr ""
"迪尔内斯「和菲莉丝、\n"
"斯蒂莱认识很久了　这一点肯定没错…。"

#. ID 3, Page 2, Line 29, Pos (23,25)
msgid ""
"ディルネス\n"
"「どうしてここに来るまでに、鏡の中に\n"
"　閉じ込められてたんだろ。\n"
"　ど～しても思い出せないのよねぇ。"
msgstr ""
"迪尔内斯「为什么在来这里之前，\n"
"会被关在镜子里　呢。　怎么都想不起来啊。"

#. ID 3, Page 2, Line 37, Pos (23,25)
msgid ""
"ディルネス\n"
"「元商売人としてはこういうことするの\n"
"　も悪くはないわね。"
msgstr "迪尔内斯「作为原商人，做这种事　也不坏呢。"

#. ID 3, Page 3, Line 7, Pos (23,25)
msgid ""
"ディルネス\n"
"「町づくりはいいけど、\n"
"　なんで私が財務係なんだろ…"
msgstr ""
"迪尔内斯「城镇建设倒是挺好，\n"
"　但为什么我非得当财务负责人呢……"

#. ID 3, Page 3, Line 11, Pos (23,25)
msgid ""
"ディルネス\n"
"「ちょっとぐらい拝借しても…"
msgstr "迪尔内斯「稍微借用一点应该也……"

#. ID 3, Page 3, Line 14, Pos (23,25)
msgid ""
"ディルネス\n"
"「いや、ダメダメダメ。\n"
"　なにされるかわかったものじゃない…！"
msgstr ""
"迪尔内斯「不，不行不行不行。\n"
"　谁知道会被怎么处置……！"

#. ID 3, Page 3, Line 21, Pos (23,25)
msgid ""
"ディルネス\n"
"「今日も一日頑張っていきますか！"
msgstr "迪尔内斯「今天也要努力干一天吗！"

#. ID 3, Page 3, Line 27, Pos (23,25)
msgid ""
"ディルネス\n"
"「ひぃ…ふぅ…みぃ…"
msgstr "迪尔内斯「一……二……三……"

#. ID 3, Page 3, Line 30, Pos (23,25)
msgid ""
"ディルネス\n"
"「はっ…！\n"
"　いるならいるっていいなさいよ！もう。"
msgstr "迪尔内斯「哈……！　在的话就说‘在’啊！真是的。"

#. ID 5, Page 1, Line 3, Pos (10,10)
msgid ""
"「ちょっと前まで危険な気配が漂ってたけど、\n"
"　いつの間にかきれいさっぱりなくなってるね。\n"
"　なにがあったのかな…。"
msgstr ""
"「直到刚才还飘着危险的气息，\n"
"　但不知不觉就彻底消失了呢。　发生了什么呢……。"

#. ID 6, Page 1, Line 2, Pos (17,18)
msgid ""
"スティライ？\n"
"「よく来たなオマエ…。\\|\n"
"　ここは私の経営する店だぞ。"
msgstr ""
"斯蒂莱？「你这家伙，来得挺好啊……。\n"
"\\|　这里是我经营的店哦。"

#. ID 6, Page 1, Line 6, Pos (17,18)
msgid ""
"スティライ？\n"
"「どうした？\\|何か心配事か？\\!\n"
"　安心しろ…取って喰ったり、\n"
"　身体を頂戴したりはしない…。"
msgstr ""
"斯蒂莱？「怎么了？\\|有什么心事吗？\\!　放心吧……\n"
"我不会把你抓来吃掉，　也不会夺走你的身体……。"

#. ID 6, Page 1, Line 11, Pos (17,18)
msgid ""
"スティライ？\n"
"「ここではいくらか強力な装備品を、\n"
"　取り扱っている。無論タダで譲るつもり\n"
"　はないぞ。"
msgstr ""
"斯蒂莱？「这里经营着一些强力的装备品，　当然，\n"
"我可没打算免费让给你哦。"

#. ID 6, Page 1, Line 15, Pos (17,18)
msgid ""
"スティライ？\n"
"「お金さえ出せば、強力な装備品をオマエ\n"
"　に提供してやる。\\|簡単だろう？"
msgstr ""
"斯蒂莱？「只要出钱，\n"
"我就会向你　提供强力的装备品。\\|很简单吧？"

#. ID 6, Page 1, Line 19, Pos (17,18)
msgid ""
"スティライ？\n"
"「スティライはどうしたのか、だと？"
msgstr "斯蒂莱？「你问斯蒂莱怎么了，是吧？"

#. ID 6, Page 1, Line 22, Pos (17,18)
msgid ""
"スティライ？\n"
"「それはオマエの知る必要のないことだ。"
msgstr "斯蒂莱？「那是你没有必要知道的事。"

#. ID 6, Page 1, Line 25, Pos (17,18)
msgid ""
"スティライ？\n"
"「しかしそうさな…気になるというのなら\n"
"　その時が来れば話してやるのも\n"
"　やぶさかではない。"
msgstr ""
"斯蒂莱？「不过嘛……如果你在意的话，\n"
"　等时候到了，我也不吝于告诉你。"

#. ID 6, Page 1, Line 30, Pos (17,18)
msgid ""
"スティライ？\n"
"「しかし忠告はしておく。\n"
"　余計な詮索は命を縮ませるとな。"
msgstr ""
"斯蒂莱？「不过我先忠告你。\n"
"　多管闲事会缩短寿命哦。"

#. ID 6, Page 1, Line 34, Pos (17,18)
msgid ""
"スティライ？\n"
"「さて前口上はここまでにして、\n"
"　注文を聞こうか…。"
msgstr ""
"斯蒂莱？「好了，开场白就到这里，\n"
"　来听听你的点单吧……。"

#. ID 7, Page 1, Line 2, Pos (18,18)
msgid ""
"ディルネス\n"
"「スティライもフェリスも考えてることは\n"
"　全然分からない…けど。"
msgstr ""
"迪尔内斯「斯蒂莱和菲莉丝在想什么，\n"
"　我完全不明白……不过。"

#. ID 7, Page 1, Line 6, Pos (18,18)
msgid ""
"ディルネス\n"
"「それでも…一緒に過ごしたあの時間は、\n"
"　とても有意義な時間だったのは間違い\n"
"　ないわ。"
msgstr ""
"迪尔内斯「即便如此……一起度过的那段时间，\n"
"　毫无疑问是非常有意义的。"

#. ID 7, Page 1, Line 11, Pos (18,18)
msgid ""
"ディルネス\n"
"「だから…"
msgstr "迪尔内斯「所以……"

#. ID 7, Page 1, Line 14, Pos (18,18)
msgid ""
"ディルネス\n"
"「私は…あんたを否定する！"
msgstr "迪尔内斯「我……要否定你！"

#. ID 7, Page 1, Line 17, Pos (18,18)
msgid ""
"ケルヴィ\n"
"「愚かな精霊だ。この二体の本体はあなた\n"
"　のような存在に手に負えるものではない\n"
"　というのに…。"
msgstr ""
"凯尔维「愚蠢的精灵啊。明明这两具的本体，\n"
"不是你这样的存在能应付得了的……。"

#. ID 7, Page 1, Line 22, Pos (18,18)
msgid ""
"ディルネス\n"
"「確かに二人を止めるのは私じゃ無理。\n"
"　だけど、今は一人じゃないから…。"
msgstr ""
"迪尔内斯「确实，凭我一个人阻止不了那两个人。\n"
"　但是，现在我不是一个人……。"

#. ID 7, Page 1, Line 26, Pos (18,18)
#. Contains choice at line 3 (1 options)
msgid ""
"ディルネス\n"
"「そうよね？（主人公）。"
msgstr "迪尔内斯「对吧？（主人公）。"

#. ID 7, Page 1, Line 28, Pos (18,18)
#. Choice (1 options, embedded in a message)
msgid "そうだね"
msgstr "是啊"

#. ID 7, Page 1, Line 33, Pos (18,18)
msgid ""
"ケルヴィ\n"
"「いいでしょう…。\n"
"　ならばその思いとともに消えるがいい！"
msgstr "凯尔维「好吧……。　那就带着那份念想消失吧！"

#. ID 7, Page 1, Line 37, Pos (18,18)
msgid ""
"スティライ\n"
"「ディルネス…ダメ…\n"
"　私から…離れて…！！！"
msgstr "斯蒂莱「迪尔内斯……不行……　离我……远一点……！！！"

#. ID 7, Page 1, Line 41, Pos (18,18)
msgid ""
"フェリス\n"
"「狂気の力を抑えられない…！\n"
"　このままじゃまた犠牲者が出る…！"
msgstr ""
"菲莉丝「抑制不住疯狂之力……！\n"
"　再这样下去又会出现牺牲者……！"

#. ID 7, Page 1, Line 45, Pos (18,18)
msgid ""
"ディルネス\n"
"「あ～あ。やっぱりこうなったか。\n"
"　ま…そんな気はしてたけどね。"
msgstr ""
"迪尔内斯「啊～啊。果然变成这样了。　嗯……\n"
"我也有那种预感呢。"

#. ID 7, Page 1, Line 49, Pos (18,18)
msgid ""
"ディルネス\n"
"「それでも、あいつの企みは阻止しないと\n"
"　ね。そうでしょ？"
msgstr ""
"迪尔内斯「即便如此，也必须阻止那家伙的企图呢。\n"
"对吧？"

#. ID 7, Page 1, Line 53, Pos (18,18)
msgid ""
"スティライ\n"
"「狂気の力をここに示そう…！\n"
"　我が力と彼の力を！"
msgstr ""
"斯蒂莱「就在这里展示疯狂之力吧……！\n"
"　我的力量和他的力量！"
