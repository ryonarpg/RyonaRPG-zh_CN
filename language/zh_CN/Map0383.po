#. ID 13, Page 5, Line 50, Pos (6,7)
#. ChangeHeroName (Actor 104)
msgctxt "actors.name"
msgid "満室　　　　　　　　　　"
msgstr "客满"

#. ID 13, Page 5, Line 55, Pos (6,7)
#. Choice (4 options)
msgid ""
"\\>\\$簡易寝台　　　　　　　　\\c[2]\\n[101]\\c[4]\\v[1201] \\c[0]G\n"
"\\>エコノミー　　　　　　　\\c[2]\\n[102]\\c[4]\\v[1202] \\c[0]G\n"
"\\>スイート　　　　　　　　\\c[2]\\n[103]\\c[4]\\v[1203] \\c[0]G\n"
"\\>ロイヤルスイート　　　　\\c[2]\\n[104]\\c[4]\\v[1204] \\c[0]G"
msgstr ""
"\\>\\$简易床铺　　　　　　　　\\c[2]\\n[101]\\c[4]\\v[1201] \\c[0]G\n"
"\\>经济房　　　　　　　\\c[2]\\n[102]\\c[4]\\v[1202] \\c[0]G\n"
"\\>套房　　　　　　　　\\c[2]\\n[103]\\c[4]\\v[1203] \\c[0]G\n"
"\\>皇家套房　　　　\\c[2]\\n[104]\\c[4]\\v[1204] \\c[0]G"

#. ID 13, Page 5, Line 185, Pos (6,7)
msgid ""
"○リーパー\n"
"「フヒヒ・・・ちゃんと来たんだな・・・\n"
"　やっぱり僕の催眠術は完璧なんだな"
msgstr ""
"○里帕「嘿嘿嘿……你果然来了啊……\n"
"　果然我的催眠术是完美的啊"

#. ID 13, Page 5, Line 188, Pos (6,7)
msgid "＊……………"
msgstr "＊……………"

#. ID 13, Page 5, Line 218, Pos (6,7)
msgid "＊…………"
msgstr "＊…………"

#. ID 13, Page 5, Line 294, Pos (6,7)
msgid ""
"○リーパー\n"
"「フヒッ・・・夜になってここに来るたびに\n"
"　お前は少しづつ二度と戻れない所に堕ちていくんだな"
msgstr ""
"○里帕「嘿嘿……\n"
"每当到了夜里来到这里　你就会一点点堕入再也无法\n"
"　回头的地方啊"

#. ID 13, Page 5, Line 297, Pos (6,7)
msgid ""
"○リーパー\n"
"「ほら・・・オナニーするんだな！\n"
"　僕を楽しませるんだな！"
msgstr "○里帕「看吧……自慰吧！　让我开心吧！"

#. ID 13, Page 5, Line 311, Pos (6,7)
msgid ""
"○リーパー\n"
"「フヒヒ・・・なかなか良かったんだな・・・"
msgstr "○里帕「嘿嘿嘿……相当不错啊……"

#. ID 13, Page 5, Line 315, Pos (6,7)
msgid ""
"そうだ、どうせだから・・・\n"
"こいつの催眠を深めて遊んでやるんだな！"
msgstr ""
"对了，反正都这样了……就加深这家伙的催眠，\n"
"好好玩弄一番吧！"

#. ID 13, Page 5, Line 317, Pos (6,7)
#. Contains choice at line 3 (2 options)
msgid ""
"たしかこいつは・・・おもらしが気持ちよくなる\n"
"催眠をかけていたんだったな？"
msgstr "记得这家伙……被施过让尿裤子变得舒服的催眠吧？"

#. ID 13, Page 5, Line 319, Pos (6,7)
#. Choice (2 options, embedded in a message)
msgid ""
"洗脳してやるんだな！\n"
"いや、やっぱやめるんだな・・・"
msgstr ""
"洗脑这家伙吧！\n"
"不，还是算了吧……"

#. ID 13, Page 5, Line 322, Pos (6,7)
msgid ""
"…よし、こいつは大好きなおもらしのこと\n"
"ばっかり考えるド変態にしてやるんだな！"
msgstr ""
"……好，\n"
"就把这家伙变成满脑子只想着最喜欢的尿裤子的超级\n"
"变态吧！"

#. ID 13, Page 5, Line 355, Pos (6,7)
msgid ""
"おまえは何よりもおもらしが\n"
"大好きになるんだな・・・"
msgstr "你会变得比什么都更喜欢尿裤子……"

#. ID 13, Page 5, Line 359, Pos (6,7)
msgid ""
"街中で、人前で、草むらで・・・\n"
"あらゆる所でおもらしをする事が\n"
"大好きになるんだな・・・"
msgstr ""
"在街上、在别人面前、在草丛里……\n"
"你会变得最喜欢在所有地方尿裤子……"

#. ID 13, Page 5, Line 364, Pos (6,7)
msgid ""
"人に見られていればいるほど快感を感じるし、\n"
"たくさんすればするほど気持ちよくなるんだな・・・"
msgstr ""
"越是被别人看到就越会感到快感，\n"
"做得越多就越舒服……"

#. ID 13, Page 5, Line 368, Pos (6,7)
msgid ""
"おまえはトイレの使い方が分からなくなるんだな・・・\n"
"おまえはおもらしすることが大好きだから、\n"
"それは当り前の事なんだな・・・"
msgstr ""
"你会变得不知道怎么使用厕所……\n"
"因为你最喜欢尿裤子，所以那是理所当然的事……"

#. ID 13, Page 5, Line 375, Pos (6,7)
msgid "・・・こんな所なんだな"
msgstr "……就是这些了啊"

#. ID 13, Page 5, Line 376, Pos (6,7)
msgid "・・・さて、確認なんだな・・・"
msgstr "……那么，来确认一下吧……"

#. ID 13, Page 5, Line 377, Pos (6,7)
msgid ""
"\\N[\\V[6]]、今かけられた催眠を\n"
"復唱してみるんだな・・・！"
msgstr "\\N[\\V[6]]，把现在对你施加的催眠复述一遍吧……！"

#. ID 13, Page 5, Line 383, Pos (6,7)
msgid "・・・わたしは、おもらしが大好きです。"
msgstr "……我，最喜欢尿裤子了。"

#. ID 13, Page 5, Line 385, Pos (6,7)
msgid ""
"・・・街中で・・・人前で・・・\n"
"・・・草むらで・・・\n"
"いろんな所でする・・・おもらしが・・・\n"
"・・・大好きです・・・。"
msgstr ""
"……在街上……在别人面前……在草丛里……\n"
"在各种地方尿裤子……最喜欢了……。"

#. ID 13, Page 5, Line 390, Pos (6,7)
msgid ""
"・・・たくさんの人に見られれば・・・\n"
"見られるほど・・・"
msgstr "……被越多的人看到……越被看到……"

#. ID 13, Page 5, Line 393, Pos (6,7)
msgid ""
"たくさん・・・おもらしすれば・・・するほど・・・\n"
"・・・きもちよく・・・なります・・・。"
msgstr "尿裤子……越多……就越……舒服……。"

#. ID 13, Page 5, Line 396, Pos (6,7)
msgid ""
"・・・わたしは・・・といれの使い方が・・・\n"
"わかりません・・・\n"
"でも、それはおかしくない・・・。"
msgstr ""
"……我……不知道怎么……使用厕所……但是，那并不奇怪……\n"
"。"

#. ID 13, Page 5, Line 400, Pos (6,7)
msgid ""
"・・・おもらし・・・キモチイイ・・・\n"
"おもらし・・・たくさん・・・\n"
"といれは・・・つかえない・・・\n"
"みんなに・・・みてもらう・・・。"
msgstr ""
"……尿裤子……好舒服……尿裤子……很多……厕所……不能用……\n"
"让大家……看着……。"

#. ID 13, Page 5, Line 405, Pos (6,7)
msgid ""
"・・・いつでもおもらししたい・・・\n"
"いつもおもらしのことをかんがえる・・・\n"
"おもらしすることは・・・なによりも・・・\n"
"すごく・・・きもちいい・・・"
msgstr ""
"……随时都想尿裤子……总是想着尿裤子的事……尿裤子……\n"
"比什么都……非常……舒服……"

#. ID 13, Page 5, Line 410, Pos (6,7)
msgid ""
"・・・おもらしはきもちいい・・・\n"
"・・・きもちいい・・・\n"
"・・・おもらし・・・\n"
"・・・・・・おもらし・・・・・・"
msgstr "……尿裤子好舒服……好舒服……尿裤子…………尿裤子……"

#. ID 13, Page 5, Line 418, Pos (6,7)
msgid ""
"…ちょっと効きすぎたかもしれないんだな…\n"
"…まあ、それだけこいつはド変態の素質が\n"
"有ったってことなんだな、フヒヒ！"
msgstr ""
"……可能效果有点太强了啊……不过，\n"
"这也说明这家伙有当超级变态的素质，嘿嘿嘿！"

#. ID 13, Page 5, Line 422, Pos (6,7)
msgid ""
"うーむ…だとしたらこいつに色々な催眠をかけて、\n"
"玩具にしてみるのも悪くないかもなんだな…。"
msgstr ""
"唔嗯……既然如此，给这家伙施加各种催眠，\n"
"把她当玩具玩玩或许也不错啊……。"

#. ID 13, Page 5, Line 430, Pos (6,7)
msgid ""
"・・・いや、でも万が一のこともあるんだな・・・\n"
"次の機会にしておくんだな・・・。"
msgstr "……不，但也可能有万一啊……还是留到下次机会吧……。"

#. ID 13, Page 5, Line 439, Pos (6,7)
msgid "　また夜に来るんだな！"
msgstr "　夜里再来吧！"

#. ID 13, Page 5, Line 449, Pos (6,7)
msgid ""
"・・・あれ・・・？\n"
"わたし・・・きのう・・・\n"
"なにをして・・・たんだっけ？"
msgstr "……咦……？我……昨天……做了什么……来着？"

#. ID 13, Page 5, Line 452, Pos (6,7)
msgid ""
"まぁ・・・いいか・・・\n"
"きもち・・・よかった・・・から・・・\n"
"ふふふ・・・"
msgstr "嘛……算了……因为……很舒服……所以……呵呵呵……"
