#. ID 23, Page 2, Line 396, Pos (45,8)
msgid ""
"な、なんっ？\n"
"なんでだ、だのだのっ？"
msgstr "什、什么？为什么、为什么的呀？"

#. ID 23, Page 2, Line 414, Pos (45,8)
msgid ""
"あ、あれあれれっ？\n"
"ぼ、僕のせい精子こいよ？　濃いよ？\n"
"なんでっ！？"
msgstr ""
"啊、哎哎哎？我、我的精精子很浓哦？　很浓哦？\n"
"为什么！？"

#. ID 26, Page 1, Line 3, Pos (52,3)
#. ID 27, Page 1, Line 3, Pos (53,3)
msgid ""
"先生「こ、ここは\"羞恥オホ、オナニー\"のじゅ、授業。\n"
"　　　受ける？　う、受けるよね？」"
msgstr ""
"老师「这、这里是\"羞耻呻吟、自慰\"的授、课。\n"
"　　　要接受吗？　嗯、会接受的吧？」"

#. ID 33, Page 1, Line 3, Pos (48,4)
msgid "男１「うおっ、奴隷でも無い子があんな……」"
msgstr "男1「哇哦、又不是奴隶的女孩竟然那样……」"

#. ID 33, Page 1, Line 4, Pos (48,4)
msgid "男２「はあっ、はあっ、はあっ……」"
msgstr "男2「哈啊、哈啊、哈啊……」"

#. ID 34, Page 1, Line 3, Pos (50,4)
msgid "男３「あの娘……カワイイな。　\\!犯してえ……」"
msgstr "男3「那女孩……好可爱啊。　\\!想侵犯她……」"

#. ID 34, Page 1, Line 4, Pos (50,4)
msgid "男２「はあっ、はあっ、はあっ……うっ！」"
msgstr "男2「哈啊、哈啊、哈啊……唔！」"

#. ID 35, Page 1, Line 3, Pos (55,4)
msgid ""
"女１「うわあ、本当にヘンタイだらけなの……。\\!\n"
"　　　音がここまで聞こえるじゃない……」"
msgstr ""
"女1「哇啊、真的全是变态啊……。\\!\n"
"　　　声音都传到这里来了不是吗……」"

#. ID 35, Page 1, Line 5, Pos (55,4)
msgid "男４「下手な娼婦よか、よっぽど興奮するのう！」"
msgstr "男4「比差劲的娼妇、还要让人兴奋得多呢！」"

#. ID 36, Page 1, Line 3, Pos (57,4)
msgid ""
"男１「たまんねえなコレ……。\n"
"　　　お願いしたら咥えてくれないかな……」"
msgstr ""
"男1「这真受不了啊……。\n"
"　　　如果求她的话会不会给我含呢……」"

#. ID 36, Page 1, Line 5, Pos (57,4)
msgid ""
"女１「うわ、あんな派手に……。\\!\n"
"　　　本当にはしたないヤツらねっ！」"
msgstr ""
"女1「哇、那么夸张地……。\\!\n"
"　　　真是些不要脸的家伙呢！」"
