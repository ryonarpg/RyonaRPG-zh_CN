#. ID 46, Page 3, Line 3, Pos (16,26)
#. ID 87, Page 3, Line 3, Pos (80,26)
msgid "固定されて元に戻らないようだ。"
msgstr "似乎被固定住了，无法复位。"

#. ID 91, Page 2, Line 3, Pos (48,22)
msgid "扉は固く閉ざされている……。"
msgstr "门紧紧关闭着……。"

#. ID 93, Page 2, Line 19, Pos (72,94)
msgid ""
"\\N[\\V[6]]は\n"
"太古の呪詛をその身に受けた。"
msgstr "\\N[\\V[6]]身负太古的诅咒。"

#. ID 94, Page 2, Line 15, Pos (73,94)
msgid "\\N[\\V[6]]の受けた呪詛は浄化された。"
msgstr "\\N[\\V[6]]所受的诅咒被净化了。"

#. ID 103, Page 2, Line 4, Pos (76,105)
msgid ""
"王家の……財を……荒らす者に……\n"
"災い……あれ……"
msgstr "愿灾祸……降临于……侵夺王家……财宝之人……"

#. ID 103, Page 2, Line 8, Pos (76,105)
msgid ""
"ﾖﾊxｯ&}Z溯祭*ｳs廳?……\n"
