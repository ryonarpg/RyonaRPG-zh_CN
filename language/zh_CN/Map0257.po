msgid "工事中なんダナ"
msgstr "正在施工哪。"

#. ID 76, Page 2, Line 3, Pos (20,34)
msgid "工事中じゃん"
msgstr "不是在施工嘛。"

#. ID 77, Page 2, Line 3, Pos (21,34)
msgid "だから工事中ですってば"
msgstr "说了在施工啦。"

#. ID 78, Page 2, Line 3, Pos (22,34)
msgid "工事中だぜ無茶ゴリラ"
msgstr "在施工啊，蛮干大猩猩。"

#. ID 79, Page 2, Line 3, Pos (62,34)
msgid "工事中なんだッシャ"
msgstr "正在施工啊。"

#. ID 80, Page 2, Line 3, Pos (63,34)
msgid "ブーン工事中なんだブーン"
msgstr "嗡嗡，在施工呢，嗡嗡。"

#. ID 81, Page 2, Line 3, Pos (64,34)
msgid "ダー工事中なんだぜ"
msgstr "哒——在施工呢。"

#. ID 82, Page 2, Line 3, Pos (65,34)
msgid "工事中でござるでしょう"
msgstr "在施工吧，是也。"
