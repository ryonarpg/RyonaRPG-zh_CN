#. ID 13, Page 2, Line 4, Pos (3,3)
msgid "銃使いを探しています。"
msgstr "正在寻找枪手。"

#. ID 13, Page 2, Line 10, Pos (3,3)
#. Contains choice at line 2 (3 options)
msgid "\\|何しに来たんですか？"
msgstr "\\|你来做什么？"

#. ID 13, Page 2, Line 11, Pos (3,3)
#. Choice (3 options, embedded in a message)
#. ID 13, Page 2, Line 28, Pos (3,3)
#. Choice (3 options, embedded in a message)
#. ID 13, Page 2, Line 48, Pos (3,3)
#. Choice (3 options, embedded in a message)
msgid ""
"\\>協力する\n"
"\\>さようなら\n"
"\\>くわしく"
msgstr ""
"\\>合作\n"
"\\>再见\n"
"\\>详情"

#. ID 13, Page 2, Line 19, Pos (3,3)
msgid "嫌です。"
msgstr "不愿意。"

#. ID 13, Page 2, Line 26, Pos (3,3)
msgid "\\|貴女ですか。"
msgstr "\\|是你吗？"

#. ID 13, Page 2, Line 27, Pos (3,3)
#. Contains choice at line 2 (3 options)
msgid "もしや、協力してくれるのですか？"
msgstr "莫非你愿意协助我吗？"

#. ID 13, Page 2, Line 42, Pos (3,3)
msgid "\\|貴女は銃使いですね？"
msgstr "\\|你是枪手吧？"

#. ID 13, Page 2, Line 45, Pos (3,3)
msgid "看板の文字が書き換わっていく。"
msgstr "招牌上的文字不断被改写。"

#. ID 13, Page 2, Line 47, Pos (3,3)
#. Contains choice at line 2 (3 options)
msgid "貴女に協力してもらいたいことがあります。"
msgstr "有件事想请你协助。"

#. ID 13, Page 2, Line 63, Pos (3,3)
msgid ""
"信用していいんですかね？\n"
"\\.\\.・\\.\\.・\\.\\.・\\.\\.桶の中のものを持って行ってください。"
msgstr ""
"可以信任你吗？\n"
"\\.\\.・\\.\\.・\\.\\.・\\.\\.请把桶里的东西拿走。"

#. ID 13, Page 2, Line 67, Pos (3,3)
msgid ""
"助かります。\n"
"\\.\\.・\\.\\.・\\.\\.・\\.\\.桶の中のものを持って行ってください。"
msgstr ""
"帮大忙了。\n"
"\\.\\.・\\.\\.・\\.\\.・\\.\\.请把桶里的东西拿走。"

#. ID 13, Page 2, Line 78, Pos (3,3)
msgid "つよい弾を6個もらった。"
msgstr "获得了6发强力子弹。"

#. ID 13, Page 2, Line 81, Pos (3,3)
msgid ""
"前金代わりに受け取ってください。\n"
"今後、物をやり取りするときはその桶を使用します。"
msgstr ""
"请把这个当作预付款收下。今后交接物品时，\n"
"将使用那个桶。"

#. ID 13, Page 2, Line 83, Pos (3,3)
msgid "それでは…いかがなさいますか？"
msgstr "那么……您要怎么做？"

#. ID 13, Page 2, Line 91, Pos (3,3)
msgid "冷やかしならもう来ないでくださいね！"
msgstr "如果是来捣乱的话，请不要再来了！"

#. ID 13, Page 2, Line 94, Pos (3,3)
#. ID 13, Page 12, Line 72, Pos (3,3)
msgid "さようなら…。"
msgstr "再见……。"

#. ID 13, Page 2, Line 103, Pos (3,3)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "\\>"
msgstr "\\>"

#. ID 13, Page 2, Line 109, Pos (3,3)
msgid ""
"\\n[101]私は銃器の開発や復元等を行っている者です。\n"
"\\n[101]銃使いにとって有用なアイテムも開発しています。"
msgstr ""
"\\n[101]我是从事枪械开发与复原等工作的人。\n"
"\\n[101]也在开发对枪手有用的物品。"

#. ID 13, Page 2, Line 111, Pos (3,3)
msgid ""
"\\n[101]しかし開発等に使用する物資が尽き、\n"
"\\n[101]それを集めるための資金も枯渇している状態です。"
msgstr ""
"\\n[101]但是用于开发等用途的物资已经耗尽，\n"
"\\n[101]用于收集这些物资的资金也已枯竭。"

#. ID 13, Page 2, Line 113, Pos (3,3)
msgid ""
"\\n[101]貴女にお願いしたいのは\n"
"\\n[101]主に物資、または資金の提供です。\n"
"\\n[101]物資の方は冒険者なら\n"
"\\n[101]手に入れやすいものが殆どだと思います。"
msgstr ""
"\\n[101]我想请你做的\\n[101]主要是提供物资或资金。\n"
"\\n[101]物资方面，\n"
"对冒险者来说\\n[101]大多是比较容易获得的东西。"

#. ID 13, Page 2, Line 117, Pos (3,3)
msgid ""
"\\n[101]報酬は完成した物を提供します。\n"
"\\n[101]複数お求めの場合は有償となりますが。"
msgstr ""
"\\n[101]报酬将提供完成品。\\n[101]如果需要多件，\n"
"则需付费。"

#. ID 13, Page 2, Line 120, Pos (3,3)
#. Contains choice at line 2 (3 options)
msgid "いかがでしょう、協力してくれますか？"
msgstr "怎么样，愿意协助我吗？"

#. ID 13, Page 2, Line 121, Pos (3,3)
#. Choice (3 options, embedded in a message)
msgid ""
"\\>協力する\n"
"\\>さようなら\n"
"\\>もう一度"
msgstr ""
"\\>合作\n"
"\\>再见\n"
"\\>再说一遍"

#. ID 13, Page 2, Line 130, Pos (3,3)
msgid "………………。"
msgstr "………………。"

#. ID 13, Page 2, Line 135, Pos (3,3)
msgid "わざとやってます？"
msgstr "你是故意的吗？"

#. ID 13, Page 2, Line 136, Pos (3,3)
#. Contains choice at line 2 (2 options)
msgid "もうこれ以上は言いたくないです。"
msgstr "我不想再多说了。"

#. ID 13, Page 2, Line 137, Pos (3,3)
#. Choice (2 options, embedded in a message)
msgid ""
"\\>協力する\n"
"\\>さようなら"
msgstr ""
"\\>合作\n"
"\\>再见"

#. ID 13, Page 3, Line 71, Pos (3,3)
msgid ""
"ご協力ありがとうございます。\n"
"現在、お願いしたい案件はありません。"
msgstr "感谢您的协助。目前没有想委托的案件。"

