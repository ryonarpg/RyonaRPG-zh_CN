#. ID 22, Page 2, Line 3, Pos (3,10)
msgid "んあっ　あひっ　んあああっ！"
msgstr "唔啊　啊嘻　唔啊啊啊！"

#. ID 23, Page 2, Line 3, Pos (2,11)
msgid ""
"やめ……てぇ……！\n"
"もう、種付け、やめ……ひぃぃぃっ！"
msgstr "住……手……！已经，别再配种了……咿啊啊啊！"

#. ID 24, Page 2, Line 3, Pos (2,8)
msgid ""
"あー………？\n"
"あぁ……？　ああ………"
msgstr "啊———？啊……？　啊啊………"

#. ID 25, Page 2, Line 3, Pos (16,10)
msgid ""
"痛い痛い！　\n"
"やめて！お腹が破れ…あがぁぁああああ゛！\n"
"どめ゛でええええ゛え゛！！"
msgstr ""
"好痛好痛！　住手！肚子要破……啊嘎啊啊啊啊啊゛！\n"
"住手゛啊゛啊啊啊啊゛啊゛！！"

#. ID 26, Page 2, Line 3, Pos (4,10)
msgid ""
"……ここの魔女を使って……仲間を増やそうと\n"
"……思いまして……"
msgstr "……我想利用这里的魔女……来增加同伴……"

#. ID 28, Page 2, Line 3, Pos (10,4)
msgid ""
"もっと犯してぇ……\\c[11]$k\\c[0]\n"
"もっと中に突っ込んでぇぇ……\\c[11]$k$k"
msgstr ""
"再多侵犯我……\\c[11]$k\\c[0]再往里面插啊啊……\n"
"\\c[11]$k$k"

#. ID 29, Page 2, Line 3, Pos (12,4)
msgid ""
"んはぁぁ……\\c[11]$k\\c[0]\n"
"きもひぃぃぃ\\c[11]$k$k\\c[0]　しょくしゅすきぃぃ\\c[11]$k$k"
msgstr ""
"嗯哈啊……\n"
"\\c[11]$k\\c[0]好舒服啊啊啊\\c[11]$k$k\\c[0]　好喜\n"
"欢触手啊啊\\c[11]$k$k"

#. ID 34, Page 2, Line 3, Pos (10,6)
msgid "虐めているんじゃないわよ？"
msgstr "我不是在欺负她们哦？"

#. ID 34, Page 2, Line 4, Pos (10,6)
msgid ""
"この娘たちはとっても可愛いから、\n"
"私の仲間にしてあげるの。"
msgstr "这些女孩非常可爱，所以我要让她们成为我的同伴。"

#. ID 34, Page 2, Line 6, Pos (10,6)
msgid ""
"ずっとずっと犯して……\n"
"子宮の中まで根っこを張って……\n"
"身体の中から、私たちと同じになるの。"
msgstr ""
"一直一直侵犯她们……让根扎进子宫里……从身体内部，\n"
"变得和我们一样。"
