#. ID 32, Page 1, Line 33, Pos (1,0)
msgid ""
"\\>\n"
"\\>　……………。\\<\\!\n"
"\\>　森の手前まで来た。"
msgstr ""
"\\>\n"
"\\>　……………。\\<\\!\n"
"\\>　来到了森林前。"

#. ID 32, Page 1, Line 36, Pos (1,0)
msgid ""
"\\>\n"
"\\>　辺りを見回してみるが人影は見当たらない。\\<\\!\n"
"\\>　どうやら野盗達は森の中に潜んでいるようだ。"
msgstr ""
"\\>\n"
"\\>　环顾四周，却看不到人影。\\<\\!\n"
"\\>　看来土匪们潜伏在森林里。"

#. ID 33, Page 3, Line 21, Pos (2,0)
msgid ""
"\\>\n"
"\\>野盗の毛を手に入れた！！\\<\\.\\.\\^"
msgstr ""
"\\>\n"
"\\>获得了盗贼毛！！\\<\\.\\.\\^"

#. ID 33, Page 3, Line 29, Pos (2,0)
msgid ""
"\\>\n"
"\\>野盗頭領の毛を手に入れた！！\\<\\.\\.\\^"
msgstr ""
"\\>\n"
"\\>获得了盗贼头目毛！！\\<\\.\\.\\^"

#. ID 37, Page 2, Line 3, Pos (59,43)
#. Contains choice at line 3 (2 options)
msgid ""
"\n"
"このダンジョンから出ますか？"
msgstr "要离开这个迷宫吗？"

#. ID 37, Page 2, Line 5, Pos (59,43)
#. Choice (2 options, embedded in a message)
msgid ""
"はい\n"
"いいえ"
msgstr ""
"是\n"
"否"

#. ID 41, Page 3, Line 3, Pos (12,34)
msgid ""
"\n"
"何も入っていない……"
msgstr "什么都没有……"

#. ID 42, Page 3, Line 3, Pos (48,43)
msgid ""
"エル\n"
"「何か聞きたい事とかあるのっ？」"
msgstr "艾露「有什么想打听的事吗？」"

#. ID 42, Page 3, Line 6, Pos (48,43)
#. Choice (4 options)
#. ID 42, Page 5, Line 79, Pos (48,43)
#. Choice (4 options)
msgid ""
"\\>君について\n"
"\\>頼み事について\n"
"\\>ペンダントについて\n"
"\\>次へ"
msgstr ""
"\\>关于你\n"
"\\>关于请求\n"
"\\>关于吊坠\n"
"\\>下一页"

#. ID 42, Page 3, Line 8, Pos (48,43)
msgid ""
"エル\n"
"「エルはエルだよっ！\n"
"　どこにでもいる、ふつーの女の子なのっ！」"
msgstr ""
"艾露「艾露就是艾露哦！　是随处可见的、\n"
"普通女孩子啦！」"

#. ID 42, Page 3, Line 14, Pos (48,43)
msgid ""
"エル\n"
"「エルが森の奥で落としちゃった、\n"
"　大事なペンダントを拾ってきて欲しいのっ！」"
msgstr ""
"艾露「我在森林深处弄丢了，\n"
"　希望你能帮我捡回重要的吊坠啦！」"

#. ID 42, Page 3, Line 20, Pos (48,43)
msgid ""
"エル\n"
"「大事なペンダントなのっ！」"
msgstr "艾露「是很重要的吊坠啦！」"

#. ID 42, Page 3, Line 28, Pos (48,43)
#. ID 42, Page 3, Line 58, Pos (48,43)
msgid ""
"エル\n"
"「それじゃ待ってるのっ！」"
msgstr "艾露「那么我等着你啦！」"

#. ID 42, Page 3, Line 35, Pos (48,43)
#. Choice (4 options)
#. ID 42, Page 5, Line 151, Pos (48,43)
#. Choice (4 options)
msgid ""
"\\>悪魔について\n"
"\\>森の奥について\n"
"\\>気をつける事は？\n"
"\\>前へ"
msgstr ""
"\\>关于恶魔\n"
"\\>关于森林深处\n"
"\\>要注意什么？\n"
"\\>上一页"

#. ID 42, Page 3, Line 37, Pos (48,43)
msgid ""
"エル\n"
"「ふわふわ浮いてて可愛いよねっ！\n"
"　でもエルには懐いてくれないのっ！」"
msgstr ""
"艾露「轻飘飘地浮着，很可爱吧！\n"
"　可是它们都不亲近艾露啦！」"

#. ID 42, Page 3, Line 43, Pos (48,43)
msgid ""
"エル\n"
"「森の奥には洞窟があるのっ！\n"
"　洞窟には悪魔がうじゃうじゃ～なのっ！」"
msgstr ""
"艾露「森林深处有个洞窟哦！\n"
"　洞窟里恶魔多得密密麻麻～啦！」"

#. ID 42, Page 3, Line 49, Pos (48,43)
msgid ""
"エル\n"
"「悪魔は魔法に強いのっ！\n"
"　魔法で倒すなら魔力を高くするといいのっ！」"
msgstr ""
"艾露「恶魔对魔法很强哦！\n"
"　如果想用魔法打倒它们，最好提高魔力啦！」"

#. ID 42, Page 4, Line 6, Pos (48,43)
msgid ""
"エル\n"
"「わ～、エルのお話聞いてくれるんだっ！\n"
"　エル、とっても嬉しいのっ！"
msgstr ""
"艾露「哇～，你愿意听艾露说话呀！\n"
"　艾露非常开心啦！"

#. ID 42, Page 4, Line 9, Pos (48,43)
#. ID 45, Page 2, Line 52, Pos (51,41)
msgid ""
"　あのねあのね、実はね～\\!\n"
"　エル、大事なペンダントを、\n"
"　森の奥で落としてきちゃったみたいなのっ！"
msgstr ""
"　那个那个，其实呀～\\!　艾露好像把重要的吊坠，\n"
"　在森林深处弄丢了啦！"

#. ID 42, Page 4, Line 12, Pos (48,43)
#. ID 45, Page 2, Line 55, Pos (51,41)
msgid ""
"\n"
"　おねぇちゃん、森の奥に行くんでしょ？\\!\n"
"　ついででいいから、拾ってきて欲しいのっ！"
msgstr ""
"　姐姐，你要去森林深处吧？\\!　顺便就好，\n"
"　希望你能帮我捡回来啦！"

#. ID 42, Page 4, Line 15, Pos (48,43)
msgid ""
"　拾ってきてくれたら、\n"
"　とっておきの良い物あげるからねっ！\\!\n"
"　よろしくお願いするのっ！"
msgstr ""
"　如果你帮我捡回来，　我会给你特别好的东西哦！\n"
"　\\!　拜托你啦！"

#. ID 42, Page 4, Line 20, Pos (48,43)
msgid ""
"\n"
"　それじゃ、\n"
"　エルはのんびりアリさんでも観察してるのっ！」"
msgstr "　那么，　艾露就悠闲地观察蚂蚁啦！」"

#. ID 42, Page 5, Line 26, Pos (48,43)
msgid ""
"エル\n"
"「アリさんが１５１匹～～\\!\n"
"　あ～しがもげて、大変だ～～」"
msgstr ""
"艾露「蚂蚁有151只～～\\!　腿～掉了，\n"
"不得了啦～～」"

#. ID 42, Page 5, Line 40, Pos (48,43)
msgid ""
"エル\n"
"「あれれ～？\n"
"　おねぇちゃん、もう戻ってきたのっ？"
msgstr "艾露「咦咦～？　姐姐，你已经回来了吗？"

#. ID 42, Page 5, Line 43, Pos (48,43)
msgid ""
"\n"
"　え？　エルに聞きたい事があるの～？\\!\n"
"　う～ん、その目は怪しんでる目だねっ！」"
msgstr ""
"　诶？　你有事想问艾露～？\\!　嗯～，\n"
"　那眼神是怀疑的眼神呢！」"

#. ID 42, Page 5, Line 52, Pos (48,43)
msgid ""
"エル\n"
"「うん、いいよ？\n"
"　聞きたい事があるなら聞いて。\\!\n"
"　教えてあげられるところまで、教えてあげるの。」"
msgstr ""
"艾露「嗯，可以哦？　有想问的事就问吧。\n"
"\\!　我能告诉你的范围内，就告诉你哦。」"

#. ID 42, Page 5, Line 68, Pos (48,43)
#. ChangeHeroName (Actor 101)
#. ID 42, Page 5, Line 115, Pos (48,43)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "エルシー"
msgstr "艾露希"

#. ID 42, Page 5, Line 71, Pos (48,43)
#. ChangeHeroName (Actor 101)
msgctxt "actors.name"
msgid "エル"
msgstr "艾露"

#. ID 42, Page 5, Line 76, Pos (48,43)
msgid ""
"\\n[101]\n"
"「何が聞きたいの？」"
msgstr "\\n[101]「你想问什么？」"

#. ID 42, Page 5, Line 82, Pos (48,43)
msgid ""
"\\n[101]\n"
"「エルはエルシーだよ。\n"
"　そこらにはいない、普通じゃない女の子なの。\\!\n"
"　……って、さっき言ったよ！"
msgstr ""
"\\n[101]「艾露就是艾露希哦。　不是随处可见的、\n"
"不普通的女孩。\\!　……这个，刚才说过了哦！"

#. ID 42, Page 5, Line 86, Pos (48,43)
msgid ""
"　ん～他には～、歳はひみつ。\n"
"　３サイズはいくつだろ？\n"
"　好きな物は面白い事、嫌いな物は～～\\!\n"
"　え～っと、ノーコメント！」"
msgstr ""
"　嗯～其他还有～，年龄是秘密。\n"
"　三围是多少来着？　喜欢的东西是有趣的事，\n"
"　讨厌的东西是～～\\!　呃～，无可奉告！"

#. ID 42, Page 5, Line 92, Pos (48,43)
msgid ""
"\\n[101]\n"
"「エルはエルだよっ！\n"
"　どこにでもいる、ふつーの女の子なのっ！」"
msgstr ""
"\\n[101]「艾露就是艾露哦！　是随处可见的、\n"
"普通的女孩子哦！」"

#. ID 42, Page 5, Line 101, Pos (48,43)
msgid ""
"\\n[101]\n"
"「あははっ、冗談なのっ！\\!\n"
"　おねぇちゃん、目が怖いのっ！」"
msgstr ""
"\\n[101]「啊哈哈，是开玩笑的！\\!　姐姐，\n"
"眼神好可怕哦！」"

#. ID 42, Page 5, Line 110, Pos (48,43)
msgid ""
"\\n[101]\n"
"「じゃ、冗談はおいといて。\\!\n"
"　エルはエルシーだよ。\n"
"　そこらにはいない、普通じゃない女の子なの。」"
msgstr ""
"\\n[101]「那么，玩笑先放一边。\n"
"\\!　艾露就是艾露希哦。　不是随处可见的、\n"
"　不普通的女孩。」"

#. ID 42, Page 5, Line 121, Pos (48,43)
msgid ""
"\\n[101]\n"
"「エルが森の奥にある洞窟で落としちゃった、\n"
"　大事なペンダントを取り戻してきて欲しいの。"
msgstr ""
"\\n[101]\n"
"「希望你去把艾露在森林深处的洞窟里弄丢的、\n"
"　重要吊坠取回来。"

#. ID 42, Page 5, Line 124, Pos (48,43)
msgid ""
"　多分\\c[11]あの娘\\c[0]が持ってると思う。\\!\n"
"　だから取り返す時は\n"
"　ぶっ飛ばしちゃっていいから！」"
msgstr ""
"　大概\\c[11]那个女孩\\c[0]拿着吧。\n"
"　\\!　所以取回来的时候　狠狠揍飞她也没关系！」"

#. ID 42, Page 5, Line 130, Pos (48,43)
msgid ""
"\\n[101]\n"
"「詳しくは言えないけど、\n"
"　あれがないとエル、とっても困るの。"
msgstr ""
"\\n[101]「虽然不能详细说，\n"
"　但没有那个的话艾露会非常困扰的。"

#. ID 42, Page 5, Line 133, Pos (48,43)
msgid ""
"　だけどエルが取り返しに行くと、\n"
"　ペンダントが重要な物だって感づかれちゃうでしょ？\\!\n"
"　それはそれで困るんだ～」"
msgstr ""
"　但要是艾露去取回来，\n"
"　就会被察觉到吊坠是很重要的东西吧？\n"
"　\\!　那也挺困扰的～」"

#. ID 42, Page 5, Line 142, Pos (48,43)
#. ID 42, Page 5, Line 195, Pos (48,43)
msgid ""
"エル\n"
"「それじゃ期待しているの。」"
msgstr "艾露「那么我就期待着了。」"

#. ID 42, Page 5, Line 153, Pos (48,43)
msgid ""
"\\n[101]\n"
"「森に出てきているのは\\c[11]使い魔\\c[0]達だよ。\n"
"　外へ出るのに、\n"
"　まずは偵察させているんじゃないかな？"
msgstr ""
"\\n[101]「出现在森林里的是\\c[11]使魔\\c[0]们哦。\n"
"　为了到外面去，　说不定是先让它们来侦察的吧？"

#. ID 42, Page 5, Line 157, Pos (48,43)
msgid ""
"　洞窟の中には上級の悪魔達がいるよ。\n"
"　みんな魔法に強いのが特徴かな？\\!\n"
"　まぁ魔法に弱いのは、\n"
"　生き残れなかっただけだけどね。"
msgstr ""
"　洞窟里有高级恶魔们哦。\n"
"　大家的特征都是擅长魔法吧？\\!　嘛，\n"
"　对魔法弱的那些，　只是没能活下来而已啦。"

#. ID 42, Page 5, Line 161, Pos (48,43)
msgid ""
"\n"
"　悪魔達のボスっていうか、\n"
"　おチビちゃんは特に魔法に強いから気をつけてね。」"
msgstr ""
"　与其说是恶魔们的首领，\n"
"　那个小不点特别擅长魔法，要小心哦。」"

#. ID 42, Page 5, Line 167, Pos (48,43)
msgid ""
"\\n[101]\n"
"「森の奥には悪魔達を封じていた洞窟があるの。\n"
"　まぁ今は封印が壊れちゃったけど。"
msgstr ""
"\\n[101]「森林深处有曾经封印着恶魔们的洞窟。\n"
"　不过现在封印已经坏掉了。"

#. ID 42, Page 5, Line 170, Pos (48,43)
msgid ""
"\n"
"　あと森の奥へ進むなら、\\c[11]銀縁眼鏡\\c[0]をかけると楽だよ。\n"
"　無ければ\\c[11]白いお花\\c[0]を目印にするといいの。」"
msgstr ""
"　还有，要往森林深处走的话，\n"
"　戴上\\c[11]银边眼镜\\c[0]会轻松哦。\n"
"　如果没有的话，\n"
"　把\\c[11]白色小花\\c[0]当作标记就好。」"

#. ID 42, Page 5, Line 176, Pos (48,43)
msgid ""
"\\n[101]\n"
"「悪魔達はみんな魔法に強いの。\n"
"　けれど物理には弱いんだよ。"
msgstr ""
"\\n[101]「恶魔们都很擅长魔法。\n"
"　不过对物理很弱哦。"

#. ID 42, Page 5, Line 179, Pos (48,43)
msgid ""
"\n"
"　魔法で押し切りたいなら、\n"
"　とにかく魔力を高くしないとダメかな？"
msgstr ""
"　想靠魔法强行压制的话，\n"
"　总之不提高魔力就不行吧？"

#. ID 42, Page 5, Line 182, Pos (48,43)
msgid ""
"　でも無理して魔法を使っても、\n"
"　\\c[11]聖属性\\c[0]や\\c[11]銀製\\c[0]の武器で殴った方が\n"
"　効果が上だったりすると悲しいかも！"
msgstr ""
"　但是就算勉强使用魔法，\n"
"　用\\c[11]圣属性\\c[0]或\\c[11]银制\\c[0]的武器\n"
"　殴打效果反而更好的话，可能会很悲伤哦！"

#. ID 42, Page 5, Line 185, Pos (48,43)
msgid ""
"　後はね、悪魔達は普通の魔法以外にも、\n"
"　精神的な攻撃を使ってくる事があるの。\\!\n"
"　呪われたり、ささやかれたり、ね。\n"
"　精神力を高くしておけば、ある程度は安心かも？」"
msgstr ""
"　还有呢，恶魔们除了普通魔法以外，\n"
"　有时还会使用精神攻击。\\!　比如被诅咒、\n"
"　被低语之类的。　只要提高精神力，\n"
"　某种程度上也许能安心？」"

#. ID 43, Page 2, Line 5, Pos (51,43)
#. ID 44, Page 2, Line 5, Pos (51,44)
msgid ""
"？？？？\n"
"「ちょっとそこ行くおねぇちゃんっ。\\!\n"
"　こっちに来て、エルのお話を聞いて欲しいのっ！」"
msgstr ""
"？？？？「那边走着的姐姐。\\!　过来这边，\n"
"听听艾露的话嘛！」"

#. ID 43, Page 3, Line 8, Pos (51,43)
msgid ""
"エル\n"
"「あっ、おねぇちゃんっ、\n"
"　ちょっと待ってなのっ！」"
msgstr "艾露「啊，姐姐，　等一下哦！」"

#. ID 43, Page 3, Line 19, Pos (51,43)
msgid ""
"エル\n"
"「10秒ほど目をつむってて欲しいのっ！」"
msgstr "艾露「希望你闭上眼睛大约10秒！」"

#. ID 43, Page 3, Line 27, Pos (51,43)
msgid ""
"エル\n"
"「いいからいいからっ！\n"
"　はいっ、目を瞑って、10秒数えて～～」"
msgstr "艾露「好啦好啦！　来，闭上眼睛，数10秒～～」"

#. ID 43, Page 3, Line 50, Pos (51,43)
msgid ""
"エル\n"
"「うん、もうだいじょうぶだよっ！\\!\n"
"　それじゃ、よろしくお願いするのっ！」"
msgstr ""
"艾露「嗯，已经没问题了哟！\\!　那么，\n"
"就拜托你了！」"

#. ID 45, Page 2, Line 46, Pos (51,41)
msgid ""
"エル\n"
"「わ～、おねぇちゃんがボロ雑巾みたいになったのっ！\\!\n"
"　生きてる～？　だいじょうぶ～？"
msgstr ""
"艾露「哇～，姐姐变得像破抹布一样了！\n"
"\\!　还活着吗～？　没事吧～？"

#. ID 45, Page 2, Line 49, Pos (51,41)
msgid ""
"\n"
"　とりあえず立ち止まってくれたみたいだし、\n"
"　エルのお話を聞いていくといいのっ！"
msgstr "　总之好像停下来了呢，　就听听艾露的话吧！"

#. ID 45, Page 2, Line 58, Pos (51,41)
msgid ""
"　拾ってきてくれたら、\n"
"　とっておきの良い物あげるからねっ！\\!\n"
"　よろしくお願いするのっ！」"
msgstr ""
"　如果你帮我捡来的话，\n"
"　我会给你特别好的东西哦！\\!　拜托了！」"

#. ID 45, Page 2, Line 67, Pos (51,41)
msgid ""
"エル\n"
"「およっ？」"
msgstr "艾露「哎呀？」"

#. ID 45, Page 2, Line 107, Pos (51,41)
msgid ""
"エル\n"
"「おねぇちゃん、虫の息なの～？\\!\n"
"　しょうがないなぁ～\n"
"　痛いのイタいの、飛んでけ～～」"
msgstr ""
"艾露「姐姐，已经奄奄一息了吗～？\n"
"\\!　真拿你没办法呀～　痛痛飞走吧～～」"

#. ID 45, Page 2, Line 127, Pos (51,41)
msgid ""
"エル\n"
"「おねぇちゃん、虫の息なの～？\\!\n"
"　しょうがないなぁ～\n"
"　エルが元気になるお薬塗ってあげるねっ！」"
msgstr ""
"艾露「姐姐，已经奄奄一息了吗～？\n"
"\\!　真拿你没办法呀～　艾露给你涂能恢复精神的药\n"
"　哦！」"

#. ID 45, Page 2, Line 247, Pos (51,41)
msgid ""
"エル\n"
"「うんうん、良い感度なのっ。\\!\n"
"　さてっ、おねぇちゃんも元気になった事だし～」"
msgstr ""
"艾露「嗯嗯，敏感度不错呢。\\!　那么，\n"
"姐姐也恢复精神了～」"

#. ID 45, Page 2, Line 256, Pos (51,41)
msgid ""
"エル\n"
"「さてっ、おねぇちゃんも元気になった事だし～」"
