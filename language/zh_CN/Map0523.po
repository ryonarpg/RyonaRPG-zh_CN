#. ID 2, Page 3, Line 5, Pos (9,5)
msgid "皇帝陛下……申し訳ありません。"
msgstr "皇帝陛下……非常抱歉。"

#. ID 2, Page 3, Line 10, Pos (9,5)
#. Contains choice at line 2 (3 options)
msgid "頼む……目を覚ましてくれ！"
msgstr "求你了……醒过来吧！"

#. ID 2, Page 3, Line 15, Pos (9,5)
#. Choice (3 options, embedded in a message)
msgid ""
"見逃す\n"
"トドメを刺す\n"
"考える"
msgstr ""
"放过\n"
"给予致命一击\n"
"思考"

#. ID 2, Page 3, Line 20, Pos (9,5)
msgid "そうか……もう手遅れなのか。"
msgstr "这样啊……已经太迟了吗。"

#. ID 2, Page 3, Line 21, Pos (9,5)
msgid ""
"道は開けさせる。\n"
"だから、皆の命は奪わないでくれ。"
msgstr "我会让人把路让开。所以，请不要夺走大家的性命。"

#. ID 2, Page 3, Line 39, Pos (9,5)
msgid "ぐあああああ！\\.\\.\\^"
msgstr "咕啊啊啊啊啊！\\.\\.\\^"

#. ID 3, Page 4, Line 4, Pos (7,4)
msgid "地獄に落ちろ。"
msgstr "下地狱吧。"

#. ID 3, Page 4, Line 14, Pos (7,4)
msgid "俺はお前を許さない。"
msgstr "我不会原谅你。"

#. ID 3, Page 4, Line 19, Pos (7,4)
msgid "くそ……！"
msgstr "可恶……！"

#. ID 4, Page 4, Line 4, Pos (11,4)
msgid "嫌だ……死にたくない！"
msgstr "不要……我不想死！"

#. ID 4, Page 4, Line 11, Pos (11,4)
msgid "ぎゃあああああ！\\.\\.\\^"
msgstr "呀啊啊啊啊啊！\\.\\.\\^"

#. ID 4, Page 4, Line 18, Pos (11,4)
msgid "助かったのか？"
msgstr "得救了吗？"

#. ID 4, Page 4, Line 23, Pos (11,4)
msgid "ああ……もうお終いだ。"
msgstr "啊啊……已经结束了。"

#. ID 5, Page 4, Line 4, Pos (5,4)
msgid "ああ……そんな……。"
msgstr "啊啊……怎么会……。"

#. ID 5, Page 4, Line 14, Pos (5,4)
msgid "こんな事は言いたくないが、感謝する。"
msgstr "虽然我不想说这种话，但我感谢你。"

#. ID 5, Page 4, Line 19, Pos (5,4)
msgid "お願いだ……兵長の命だけは……！"
msgstr "求你了……至少兵长的命……！"

#. ID 6, Page 4, Line 4, Pos (13,4)
msgid "はは……。"
msgstr "哈哈……。"

#. ID 6, Page 4, Line 14, Pos (13,4)
msgid "いっその事、殺してくれた方が……。"
msgstr "索性杀了我还更好……。"

#. ID 6, Page 4, Line 19, Pos (13,4)
msgid "何故こんな事に……。"
msgstr "为什么会变成这样……。"

#. ID 42, Page 3, Line 3, Pos (1,9)
msgid "無力だな……。"
msgstr "真是无力啊……。"

#. ID 43, Page 3, Line 3, Pos (18,5)
msgid "…………。"
msgstr "…………。"

#. ID 44, Page 3, Line 4, Pos (1,5)
msgid "もっと長生きしたかったねぇ……。"
msgstr "真想活得更久一点啊……。"

#. ID 44, Page 3, Line 12, Pos (1,5)
msgid "アバロソはどうなってしまうのかねぇ。"
msgstr "阿巴罗索会变成什么样呢。"

#. ID 45, Page 3, Line 4, Pos (18,9)
msgid "あの世で待っておるぞ。"
msgstr "我在那个世界等着你哦。"

#. ID 45, Page 3, Line 12, Pos (18,9)
msgid "アバロソの終わりを見ることになるとはのう……。"
msgstr "没想到会看到阿巴罗索的终结啊……。"

#. ID 46, Page 3, Line 4, Pos (9,1)
msgid "こ、こ、ここは通さない！"
msgstr "这、这、这里不会让你过去！"

#. ID 46, Page 3, Line 11, Pos (9,1)
msgid "うぎゃああああああ！\\.\\.\\^"
msgstr "呜呀啊啊啊啊啊啊！\\.\\.\\^"

#. ID 46, Page 3, Line 17, Pos (9,1)
msgid "ひいいいいいい！"
msgstr "咿咿咿咿咿咿！"

#. ID 46, Page 3, Line 22, Pos (9,1)
msgid "はぁ……。"
msgstr "哈啊……。"

#. ID 47, Page 3, Line 4, Pos (10,1)
msgid "お、お願い！帰って！"
msgstr "求、求你了！回去吧！"

#. ID 47, Page 3, Line 11, Pos (10,1)
msgid "きゃああああああ！\\.\\.\\^"
msgstr "呀啊啊啊啊啊啊！\\.\\.\\^"

#. ID 47, Page 3, Line 17, Pos (10,1)
#. ID 62, Page 2, Line 7, Pos (1,0)
msgid "うわああああああ！"
msgstr "哇啊啊啊啊啊啊！"

#. ID 47, Page 3, Line 22, Pos (10,1)
msgid "生きてたって……もう……。"
msgstr "就算活下来了……也已经……。"

#. ID 51, Page 2, Line 45, Pos (0,0)
msgid "そこまでだ！"
msgstr "到此为止！"

#. ID 51, Page 2, Line 162, Pos (0,0)
msgid "ここは通さない！"
msgstr "这里不会让你过去！"

#. ID 51, Page 2, Line 168, Pos (0,0)
msgid "先手はもらう。ラピッドストリーム！"
msgstr "我先出手了。快速激流！"

#. ID 51, Page 4, Line 7, Pos (0,0)
msgid "くっ……！"
msgstr "唔……！"

#. ID 51, Page 4, Line 10, Pos (0,0)
msgid "兵長様！ありったけの魔力を託します！"
msgstr "兵长大人！我把所有的魔力都托付给您！"

#. ID 51, Page 4, Line 55, Pos (0,0)
msgid "アバロソ兵長に\\c[1]クイック\\c[0]が付与された！"
msgstr "阿巴罗索兵长被赋予了\\c[1]快速\\c[0]！"

#. ID 51, Page 4, Line 59, Pos (0,0)
msgid ""
"恩に着る！\n"
"アバロソ軍は不屈！恐れず立ち向かうぞ！"
msgstr ""
"我领这份情！阿巴罗索军是不屈的！\n"
"我们会毫不畏惧地迎战！"

#. ID 51, Page 6, Line 113, Pos (0,0)
msgid "目を瞑れ。"
msgstr "闭上眼睛。"

#. ID 51, Page 6, Line 116, Pos (0,0)
msgid "すまない、しばらく眠ってくれ。"
msgstr "抱歉，暂时睡一会儿吧。"

#. ID 51, Page 7, Line 17, Pos (0,0)
msgid "ぐ……ぅ……。"
msgstr "唔……呜……。"

#. ID 60, Page 2, Line 3, Pos (9,14)
msgid "レイク様のために前に進もう。"
msgstr "为了雷克大人向前进吧。"
