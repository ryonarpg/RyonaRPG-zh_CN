#. ID 3, Page 1, Line 3, Pos (5,6)
msgid "あ、ちょうどいいところに来たわね\\c[11]$k"
msgstr "啊，来得正好呢\\c[11]$k"

#. ID 3, Page 1, Line 6, Pos (5,6)
msgid ""
"ご主人さまにお出しするメイドの聖水が足りないの。\n"
"ちょっと、あなたから絞らせて貰うわね\\c[11]$k"
msgstr ""
"要献给主人的女仆圣水不够了。\n"
"稍微让我从你身上榨一点吧\\c[11]$k"

#. ID 3, Page 1, Line 10, Pos (5,6)
msgid ""
"ご主人さまにお出しするメイドの母乳が足りないの。\n"
"ちょっと、あなたから絞らせて貰うわね\\c[11]$k"
msgstr ""
"要献给主人的女仆母乳不够了。\n"
"稍微让我从你身上挤一点吧\\c[11]$k"

#. ID 4, Page 1, Line 3, Pos (14,6)
msgid ""
"あなたもメイドさんになったのね……\n"
"ウフフ、逃げようとしても無駄よ\\c[11]$k"
msgstr "你也成为女仆了呢……呵呵，想逃也没用的哦\\c[11]$k"

#. ID 4, Page 1, Line 5, Pos (14,6)
msgid ""
"メイドさんはここで、\n"
"ずーっとずーっと奉仕しないといけないんだから\\c[11]$k"
msgstr "女仆必须在这里一直、一直服务才行呢\\c[11]$k"

#. ID 5, Page 2, Line 3, Pos (4,9)
msgid ""
"ほ～ら、\n"
"早くご主人さまに誠心誠意尽くしてこないと\\c[11]$k"
msgstr ""
"来～吧，\n"
"不快去对主人诚心诚意地侍奉可不行哦\\c[11]$k"

#. ID 6, Page 1, Line 3, Pos (11,9)
msgid "ほら、早くオーダーとってこないと。"
msgstr "喂，不快去接单可不行哦。"

#. ID 7, Page 1, Line 3, Pos (18,8)
msgid "ん……んぐっ……ンッ\\c[11]$k"
msgstr "嗯……唔咕……嗯\\c[11]$k"

#. ID 8, Page 1, Line 3, Pos (1,8)
msgid "血……血が飲みたい……"
msgstr "血……我想喝血……"

#. ID 8, Page 1, Line 8, Pos (1,8)
msgid "……お前、喰う。"
msgstr "……你，我要吃掉。"

#. ID 8, Page 1, Line 15, Pos (1,8)
msgid ""
"＊\\n[\\v[6]]の柔らかい肌に、\n"
"　魔物の持つ鎌が付き立てられた。"
msgstr ""
"＊\\n[\\v[6]]柔软的肌肤上，\n"
"　魔物所持的镰刀刺了进去。"

#. ID 8, Page 1, Line 17, Pos (1,8)
msgid ""
"＊\\n[\\v[6]]の身体がしっかりと固定され、\n"
"　身動きがとれないところに、魔物の牙が迫った。"
msgstr ""
"＊\\n[\\v[6]]的身体被牢牢固定，\n"
"　在无法动弹之时，魔物的獠牙逼近了。"

