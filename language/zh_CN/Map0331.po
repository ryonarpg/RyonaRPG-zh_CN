msgstr "\\S[2]已经……饶…了我…\\^"

#. ID 8, Page 1, Line 211, Pos (1,8)
msgid "………！！"
msgstr "………！！"

#. ID 8, Page 1, Line 212, Pos (1,8)
msgid ""
"＊……\\n[\\v[6]]は、すでに視るも無残な肉の塊と\n"
"　化していた。"
msgstr "＊……\\n[\\v[6]]已经化为惨不忍睹的肉块。"

#. ID 8, Page 1, Line 214, Pos (1,8)
msgid ""
"＊しかし、激痛を感じても発狂することもできず、\n"
"　意識を失うこともできない。\n"
"　強力な催眠術が理性を常に保たせ、\n"
"　それ故に苦痛を最後まで味わうことになった。"
msgstr ""
"＊然而，即使感受到剧痛也无法发狂，\n"
"　也无法失去意识。\n"
"　强力的催眠术让她始终保持着理性，\n"
"　因此她最终只能将痛苦品味到最后。"

#. ID 8, Page 1, Line 225, Pos (1,8)
msgid "＊魔物の爪が、\\n[\\v[6]]の胸に突き刺さった。"
msgstr "＊魔物的爪子，\\n[\\v[6]]的胸口被刺穿了。"

#. ID 8, Page 1, Line 226, Pos (1,8)
msgid ""
"＊\\n[\\v[6]]の乳房を抉り、それを美味そうに頬張ると\n"
"　さらに爪を奥へとつきさし……\n"
"　\\n[\\v[6]]の心臓へと、伸ばしてくる。"
msgstr ""
"＊\\n[\\v[6]]的乳房被挖开，\n"
"　那团肉被津津有味地大口塞进嘴里\n"
"　爪子更向深处刺入……　朝\\n[\\v[6]]的心脏伸来。"

#. ID 8, Page 1, Line 236, Pos (1,8)
msgid "＊血が噴き出す。"
msgstr "＊鲜血喷涌而出。"

#. ID 8, Page 1, Line 237, Pos (1,8)
msgid "＊命が失われるのを感じる。"
msgstr "＊感觉到生命正在流失。"

#. ID 8, Page 1, Line 256, Pos (1,8)
msgid ""
"＊\\n[\\v[6]]の胸から心臓が抜き取られた。\n"
"　冷静な思考なまま、その激痛と喪失感、\n"
"　そして……急速な意識の落下を味わった。"
msgstr ""
"＊\\n[\\v[6]]的心脏被从胸口取出。\n"
"　在保持冷静思考的状态下，\n"
"　她品味了那剧痛与丧失感，　以及……\n"
"意识急速坠落的感觉。"

#. ID 8, Page 1, Line 259, Pos (1,8)
msgid ""
"………\n"
"……\n"
"…"
msgstr ""
"………\n"
"……\n"
"…"

#. ID 9, Page 1, Line 3, Pos (1,11)
msgid "おっ、新入りか！"
msgstr "哦，新人吗！"

#. ID 9, Page 1, Line 6, Pos (1,11)
msgid ""
"ちょうどいい、\n"
"お前の公開オナニーショーを鑑賞させてもらおうか！"
msgstr "正好，就让我来欣赏你的公开自慰秀吧！"

#. ID 9, Page 1, Line 10, Pos (1,11)
msgid ""
"ちょうどいい、\n"
"お前の公開放尿ショーを鑑賞させてもらおうか！"
msgstr "正好，就让我来欣赏你的公开撒尿秀吧！"

#. ID 9, Page 1, Line 18, Pos (1,11)
msgid ""
"＊魔物が\\n[\\v[6]]に不埒な命令を下す……\n"
"　嫌悪感が\\n[\\v[6]]の心に沸きあがった。"
msgstr ""
"＊魔物对\\n[\\v[6]]下达了无耻的命令……\n"
"　厌恶感在\\n[\\v[6]]的心中涌起。"

#. ID 9, Page 1, Line 25, Pos (1,11)
msgid ""
"＊しかし次の瞬間、\n"
"　\\n[\\v[6]]の心から嫌悪感が消え去っていた。"
msgstr ""
"＊但是下一瞬间，\n"
"　厌恶感已从\\n[\\v[6]]的心中消失得一干二净。"

#. ID 9, Page 1, Line 31, Pos (1,11)
msgid ""
"＊むしろ、与えられた命令に対する義務感や使命感……　\n"
"　それ以上に欲望が\\n[\\v[6]]の心を支配していた。"
msgstr ""
"＊不如说，是对被下达命令的义务感与使命感……\n"
"　而在此之上，欲望支配着\\n[\\v[6]]的心。"

#. ID 9, Page 1, Line 40, Pos (1,11)
msgid ""
"いやらしくよがり狂いやがって……\n"
"最高な雌豚だな、ハハハハハッ！"
msgstr "淫荡地爽到发狂……真是头极品母猪啊，哈哈哈哈哈！"

#. ID 9, Page 1, Line 44, Pos (1,11)
msgid ""
"＊そして与えられた命令に従うため、\n"
"　\\n[\\v[6]]の手が勝手に下着をずりおろし、\n"
"　勝手に、腰が前へと突き出た。"
msgstr ""
"＊然后，为了遵从被下达的命令，\n"
"　\\n[\\v[6]]的手擅自把内裤往下扒，\n"
"　腰也擅自向前挺出。"

#. ID 9, Page 1, Line 47, Pos (1,11)
msgid "＊そして尿道の括約筋が、徐々に緩んでいく……"
msgstr "＊接着，尿道的括约肌逐渐松弛下来……"

#. ID 9, Page 1, Line 60, Pos (1,11)
msgid "………！？"
msgstr "………！？"

#. ID 9, Page 1, Line 61, Pos (1,11)
msgid ""
"＊たったいま、放尿を終えたばかりなのに……\n"
"　\\n[\\v[6]]の頭に、すぐに排泄欲が襲ってきた。"
msgstr ""
"＊明明刚刚才排完尿……\n"
"　排泄欲却立刻袭上\\n[\\v[6]]的脑海。"

#. ID 9, Page 1, Line 77, Pos (1,11)
msgid ""
"＊こうして、身体中の水分を絞られるほど、\n"
"　放尿をさせられた\\n[\\v[6]]は、\n"
"　ぐったりとしたまま意識を失った。"
msgstr ""
"＊就这样，被逼着排尿到仿佛全身水分都被榨干，\n"
"　\\n[\\v[6]]就那样瘫软着失去了意识。"

#. ID 10, Page 1, Line 3, Pos (5,11)
msgid ""
"ヘヘッ……待ってたぜ。\n"
"その尻に出したくてウズウズしてたんだ！"
msgstr ""
"嘿嘿……我可等很久了。\n"
"一直心痒难耐地想射在那屁股里！"

#. ID 10, Page 1, Line 98, Pos (5,11)
msgid "へへっ……中々いい尻孔じゃねーか。"
msgstr "嘿嘿……相当不错的屁眼嘛。"

#. ID 10, Page 1, Line 99, Pos (5,11)
msgid "こいつは開発し甲斐があるぜ……ヘヘヘッ！"
msgstr "这玩意儿很值得开发啊……嘿嘿嘿！"

#. ID 11, Page 1, Line 3, Pos (7,11)
msgid "おっ……ちょうどいいところに来たな！"
msgstr "哦……来得正是时候啊！"

#. ID 11, Page 1, Line 93, Pos (7,11)
msgid "へへっ……割といい孔してるじゃねーか。"
msgstr "嘿嘿……还挺不错的一个洞嘛。"

#. ID 11, Page 1, Line 94, Pos (7,11)
msgid "また可愛がってやるからな！"
msgstr "我还会再好好疼你的！"

#. ID 12, Page 1, Line 3, Pos (17,8)
msgid "＊接吻をしている。"
msgstr "＊正在接吻。"

#. ID 13, Page 1, Line 3, Pos (14,12)
#. ID 13, Page 1, Line 14, Pos (14,12)
#. ID 13, Page 1, Line 37, Pos (14,12)
#. ID 13, Page 1, Line 61, Pos (14,12)
msgid "01011・01001・01100・01100　！！"
msgstr "01011・01001・01100・01100　！！"

#. ID 13, Page 1, Line 79, Pos (14,12)
msgid "01101・01010・00100　？"
msgstr "01101・01010・00100　？"

#. ID 14, Page 1, Line 3, Pos (9,14)
msgid "………"
msgstr "………"

#. ID 14, Page 1, Line 11, Pos (9,14)
msgid ""
"外へ出ようとした\\n[\\v[6]]だったが、\n"
"突然頭の中に強い痛みが走った。"
msgstr ""
"正想往外走的\\n[\\v[6]]，\n"
"脑中却突然窜过一阵剧痛。"

#. ID 14, Page 1, Line 13, Pos (9,14)
msgid ""
"＊\\n[\\v[6]]\n"
"あ……ああ………？"
msgstr "＊\\n[\\v[6]]啊……啊啊………？"

#. ID 14, Page 1, Line 21, Pos (9,14)
msgid ""
"＊痛みはそのまま頭の奥底へと入り込んでいき……\n"
"　突然、\\n[\\v[6]]の性欲を強く刺激した。\n"
"　ムラムラとした欲情が心の底から吹き上がってくる。"
msgstr ""
"＊疼痛就那样钻入头脑深处……　突然，\n"
"　强烈地刺激了\\n[\\v[6]]的性欲。\n"
"　一股按捺不住的欲情从心底翻涌上来。"

#. ID 14, Page 1, Line 28, Pos (9,14)
msgid ""
"＊フヒヒ……\n"
"　逃げようとしても無駄なんだな！　フヒヒ！"
msgstr "＊嘿嘿嘿……　想逃也是没用的！　嘿嘿嘿！"

#. ID 14, Page 1, Line 34, Pos (9,14)
msgid ""
"＊\\n[\\v[6]]は踵を返し、\n"
"　フラフラと店の中へ歩み戻った。"
msgstr "＊\\n[\\v[6]]转过身，　摇摇晃晃地走回店里。"
