#. ID 12, Page 2, Line 3, Pos (33,5)
#. ID 12, Page 3, Line 3, Pos (33,5)
msgid "レバーがある。"
msgstr "有拉杆。"

#. ID 12, Page 2, Line 4, Pos (33,5)
#. Contains choice at line 2 (2 options)
#. ID 12, Page 3, Line 4, Pos (33,5)
#. Contains choice at line 2 (2 options)
msgid "引きますか？"
msgstr "要拉吗？"

#. ID 12, Page 2, Line 5, Pos (33,5)
#. Choice (2 options, embedded in a message)
#. ID 12, Page 3, Line 5, Pos (33,5)
#. Choice (2 options, embedded in a message)
#. ID 17, Page 2, Line 5, Pos (8,7)
#. Choice (2 options, embedded in a message)
#. ID 18, Page 2, Line 5, Pos (12,7)
#. Choice (2 options, embedded in a message)
#. ID 19, Page 2, Line 5, Pos (16,7)
#. Choice (2 options, embedded in a message)
#. ID 20, Page 2, Line 5, Pos (20,7)
